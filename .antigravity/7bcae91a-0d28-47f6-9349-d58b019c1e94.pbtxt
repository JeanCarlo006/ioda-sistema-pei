    end_line: 159
    content: "import React, { useState } from \'react\';\nimport { PEICompleto } from \'../types/pei\';\nimport { getIdentificadorConfidencial } from \'../data/initialCases\';\nimport {\n  Sparkles,\n  FileText,\n  Search,\n  BookOpen,\n  LayoutDashboard,\n  Printer,\n  UserPlus,\n  ArrowRight,\n  ShieldCheck,\n  CheckCircle2,\n  FolderOpen,\n  Info,\n  Layers,\n  GraduationCap,\n  Laptop,\n  Check,\n  HelpCircle,\n  Wrench,\n  BarChart3,\n  Lightbulb,\n} from \'lucide-react\';\n\ninterface ILovePeiHubProps {\n  activePei: PEICompleto;\n  allStudents: PEICompleto[];\n  onSelectStudent: (student: PEICompleto) => void;\n  onNavigate: (tabId: string) => void;\n  onOpenAddStudent: () => void;\n  onOpenSolutionBank: () => void;\n  onOpenCampusStats: () => void;\n  onPrint: () => void;\n}\n\nexport const ILovePeiHub: React.FC<ILovePeiHubProps> = ({\n  activePei,\n  allStudents,\n  onSelectStudent,\n  onNavigate,\n  onOpenAddStudent,\n  onOpenSolutionBank,\n  onOpenCampusStats,\n  onPrint,\n}) => {\n  const [activeCategory, setActiveCategory] = useState<string>(\'todas\');\n  const [showTemplateGuide, setShowTemplateGuide] = useState<boolean>(true);\n\n  // Simplified Categories focusing strictly on PEI\n  const categories = [\n    { id: \'todas\', label: \'Todos os Recursos do PEI\' },\n    { id: \'criacao\', label: \'Cria\303\247\303\243o do PEI\' },\n    { id: \'planejamento\', label: \'Planejamento & DUA 3.0\' },\n    { id: \'oficial\', label: \'Documento Oficial\' },\n    { id: \'acompanhamento\', label: \'Acompanhamento & Metas\' },\n  ];\n\n  // Essential tools focused exclusively on the PEI\n  const toolCards = [\n    {\n      id: \'novo_pei\',\n      category: \'criacao\',\n      title: \'Novo PEI com Ioda AI\',\n      description: \'Elaborar um novo Plano de Ensino Individualizado via assistente por etapas com DUA 3.0 e metas SMART.\',\n      iconBg: \'bg-emerald-600 text-white\',\n      badge: \'IA Integrada\',\n      icon: Sparkles,\n      action: onOpenAddStudent,\n    },\n    {\n      id: \'plano_pei\',\n      category: \'planejamento\',\n      title: \'Plano de Ensino (PEI & Metas)\',\n      description: \'Consultar flexibiliza\303\247\303\265es curriculares da ementa, metas de aprendizagem e estrat\303\251gias de laborat\303\263rio.\',\n      iconBg: \'bg-emerald-700 text-white\',\n      badge: null,\n      icon: FileText,\n      action: () => onNavigate(\'pei\'),\n    },\n    {\n      id: \'estudo_caso\',\n      category: \'planejamento\',\n      title: \'Estudo de Caso & Barreiras\',\n      description: \'An\303\241lise biopsicossocial do contexto escolar em 4 etapas (Art. 11 PNEEI): barreiras, potencialidades e TA.\',\n      iconBg: \'bg-teal-700 text-white\',\n      badge: \'Art. 11 PNEEI\',\n      icon: Search,\n      action: () => onNavigate(\'estudo_caso\'),\n    },\n    {\n      id: \'modelo_oficial\',\n      category: \'oficial\',\n      title: \'Modelo Oficial do PEI (IFTO)\',\n      description: \'Documento formal nos 8 blocos oficiais padronizados para homologa\303\247\303\243o pedag\303\263gica e processo SEI.\',\n      iconBg: \'bg-emerald-900 text-white\',\n      badge: \'Modelo IFTO\',\n      icon: BookOpen,\n      action: () => onNavigate(\'documento_oficial\'),\n    },\n    {\n      id: \'painel_metas\',\n      category: \'acompanhamento\',\n      title: \'Acompanhamento & Avalia\303\247\303\243o\',\n      description: \'Gerenciar ciclo de reavalia\303\247\303\243o cont\303\255nua, percentual de metas alcan\303\247adas e notas em post-its da equipe.\',\n      iconBg: \'bg-slate-900 text-white\',\n      badge: \'Avalia\303\247\303\243o Cont\303\255nua\',\n      icon: LayoutDashboard,\n      action: () => onNavigate(\'painel\'),\n    },\n    {\n      id: \'imprimir_exportar\',\n      category: \'oficial\',\n      title: \'Exportar / Imprimir PEI\',\n      description: \'Gerar vers\303\243o impressa oficial ou salvar em PDF para arquivamento no prontu\303\241rio escolar.\',\n      iconBg: \'bg-black text-white\',\n      badge: \'PDF / Impress\303\243o\',\n      icon: Printer,\n      action: onPrint,\n    },\n  ];\n\n  // Filter tool cards based on active pill\n  const filteredCards = toolCards.filter((card) => {\n    if (activeCategory === \'todas\') return true;\n    return card.category === activeCategory;\n  });\n\n  return (\n    <div className=\"space-y-8 animate-fadeIn\">\n      {/* 1. HERO SECTION (iLovePDF Style) */}\n      <div className=\"text-center pt-2 pb-2 max-w-4xl mx-auto px-4\">\n        <h1 className=\"text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight\">\n          Ol\303\241, Jean Carlo, vamos come\303\247ar\n        </h1>\n        <p className=\"mt-2.5 text-sm sm:text-base text-slate-600 font-normal max-w-2xl mx-auto leading-relaxed\">\n          Plataforma <strong>Ioda</strong> \302\267 Foco exclusivo na elabora\303\247\303\243o, flexibiliza\303\247\303\243o curricular (DUA 3.0) e acompanhamento do <strong>Plano de Ensino Individualizado (PEI)</strong>.\n        </p>\n      </div>\n\n      {/* 2. TEMPLATE DO PEI & SUGEST\303\225ES DE ELABORA\303\207\303\203O (Sem expor aluno espec\303\255fico na Home) */}\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"bg-white border border-slate-200 rounded-3xl p-6 sm:p-7 shadow-xs\">\n          <div className=\"flex flex-col lg:flex-row items-start justify-between gap-6\">\n            {/* Left: Estrutura do Template e Sugest\303\265es */}\n            <div className=\"flex-1 space-y-4\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-9 h-9 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-800 font-bold shrink-0\">\n                  <BookOpen className=\"w-5 h-5 text-emerald-800\" />\n                </div>\n                <div>\n                  <h2 className=\"text-base sm:text-lg font-bold text-slate-900\">\n                    Estrutura & Guia do Template Oficial do PEI\n                  </h2>\n                  <p className=\"text-xs text-slate-500\">\n                    Modelo institucional alinhado \303\240 Portaria MEC n\302\272 421/2026, Decreto n\302\272 12.686/2025 e DUA 3.0 (CAST 2024).\n                  </p>\n                </div>\n              </div>"
    num_lines: 418
    num_bytes: 19773
    line_range_bytes: 5777
  }
}
