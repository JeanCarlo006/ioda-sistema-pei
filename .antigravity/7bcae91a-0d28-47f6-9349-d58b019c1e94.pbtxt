            }
            lines {
              text: "        indicador_sucesso: \'O estudante agrupa corretamente cole\303\247\303\265es concretas (ex: 3 pacotes de 4 figurinhas) e seleciona na prancha num\303\251rica o c\303\241lculo correspondente (4 + 4 + 4 = 12 ou 3 x 4 = 12) em pelo menos 4 de 5 tentativas.\',"
