      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Anonymize student 2 in initialCases.ts to preserve privacy under LGPD\", \"EndLine\":297, \"Instruction\":\"Anonymize student 2 and remove personal identifiers\", \"ReplacementContent\":\"// 2. CASO ENSINO SUPERIOR EM TECNOLOGIA DA INFORMA\303\207\303\203O\\nexport const casoBeatrizSuperior: PEICompleto = {\\n  id: \'SUP-BSI-04\',\\n  cabecalho: {\\n    estudante: \'Estudante BSI-02 (Superior TI)\',\\n    codigo_matricula: \'2024.2.BSI.108\',\\n    idade: \'21 anos\',\\n    curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\',\\n    componente_curricular: \'Banco de Dados Relacional e Engenharia de Dados\',\\n    modulo_periodo: \'4\302\272 Semestre / Noturno\',\\n    data_elaboracao: \'2026-10-27\',\\n    docente_regente: \'Prof. Dr. Marcelo Albuquerque (Docente do Departamento de Computa\303\247\303\243o)\',\\n    docente_aee: \'Prof\302\252. Dra. Cl\303\241udia Fagundes (Especialista em Acessibilidade Universit\303\241ria / NAPNE)\',\\n    profissional_apoio: \'Monitor de Tecnologia Assistiva e Apoio Acad\303\252mico\',\\n    coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\\n  },\\n  historico_napne: {\\n    status_diagnostico: \'confirmado\',\\n    categoria_neurodivergencia: \'Defici\303\252ncia Visual (Baixa Vis\303\243o Severa)\',\\n    cid_ou_hipotese: \'Condi\303\247\303\243o visual acompanhada com uso de Tecnologia Assistiva\',\\n    breve_historico_clinico_familiar:\\n      \'Estudante universit\303\241rio de gradua\303\247\303\243o em Sistemas de Informa\303\247\303\243o no Campus Para\303\255so (integrante dos 14 estudantes acompanhados no Ensino Superior). Utiliza leitor de tela NVDA associado a amplia\303\247\303\243o de 300% com alto contraste invertido em monitores de 27 polegadas. Plenamente capacitado em tecnologias computacionais e linha de comando.\',\\n    descricao_condicao_especifica:\\n      \'Incapacidade de visualizar diagramas gr\303\241ficos de Modelo Entidade-Relacionamento (MER) apresentados em imagens rasterizadas (.png/.jpg) ou ferramentas visuais que carecem de suporte a leitores de tela. Em contrapartida, possui racioc\303\255nio abstrato de alto n\303\255vel, excelente compreens\303\243o de \303\241lgebra relacional e sintaxe SQL.\',\\n    informacoes_dos_pais:\\n      \'Estudante com autonomia acad\303\252mica universit\303\241ria em contato regular com o NAPNE e coordena\303\247\303\243o do curso para garantia de acessibilidade nos sistemas e laborat\303\263rios.\',\\n  },\\n  estudo_de_caso: {\\n    barreiras: [\\n      {\\n        id: \'B1\',\\n        categoria: \'metodologica\',\\n        descricao: \'Aulas te\303\263ricas e materiais de estudo baseados em slides com diagramas conceituais gr\303\241ficos de banco de dados sem descri\303\247\303\243o textual alternativa das tabelas e cardinalidades.\',\\n        impacto: \'O leitor de tela l\303\252 apenas o nome do arquivo de imagem, limitando o acesso aut\303\264nomo \303\240 estrutura das entidades.\',\\n        estrategia_enfrentamento: \'DUA 3.0: Disponibiliza\303\247\303\243o concomitante de representa\303\247\303\243o textual estruturada (formato DBML / Markdown descritivo / YAML) das entidades e relacionamentos.\',\\n      },\\n      {\\n        id: \'B2\',\\n        categoria: \'tecnologica\',\\n        descricao: \'Ferramentas de modelagem gr\303\241fica obrigat\303\263rias que n\303\243o possuem acessibilidade por teclado ou atalhos para leitores de tela.\',\\n        impacto: \'Impossibilita a realiza\303\247\303\243o de tarefas pr\303\241ticas nas ferramentas recomendadas pelo plano de curso tradicional.\',\\n        estrategia_enfrentamento: \'Aceite de ferramentas de modelagem textual (Code-First / DBML / scripts SQL DDL comentados) como equivalentes funcionais plenos.\',\\n      },\\n      {\\n        id: \'B3\',\\n        categoria: \'metodologica\',\\n        descricao: \'Provas escritas tradicionais em folhas de papel impressas com diagramas compactos para resolu\303\247\303\243o de queries complexas \303\240 m\303\243o.\',\\n        impacto: \'Totalmente inacess\303\255vel para a condi\303\247\303\243o de baixa vis\303\243o severa.\',\\n        estrategia_enfrentamento: \'Avalia\303\247\303\243o pr\303\241tica digital realizada no laborat\303\263rio com acesso a terminal SQL (PostgreSQL/SQLite) em ambiente de alto contraste e tempo estendido (+50%).\',\\n      },\\n      {\\n        id: \'B4\',\\n        categoria: \'atitudinal\',\\n        descricao: \'Concep\303\247\303\243o err\303\264nea de que a \303\241rea de banco de dados e computa\303\247\303\243o exige necessariamente a vis\303\243o gr\303\241fica tradicional para modelagem conceitual.\',\\n        impacto: \'D\303\272vidas infundadas sobre a aptid\303\243o do estudante para o mercado de TI em engenharia de dados.\',\\n        estrategia_enfrentamento: \'Esclarecimento pedag\303\263gico pelo NAPNE de que os maiores bancos de dados mundiais s\303\243o operados em ambientes CLI e scripts textuais, nos quais o estudante se destaca.\',\\n      },\\n    ],\", \"StartLine\":240, \"TargetContent\":\"// 2. CASO ENSINO SUPERIOR EM TECNOLOGIA DA INFORMA\303\207\303\203O\\nexport const casoBeatrizSuperior: PEICompleto = {\\n  id: \'SUP-BSI-04\',\\n  cabecalho: {\\n    estudante: \'Beatriz Santos Rocha\',\\n    codigo_matricula: \'2024.2.BSI.108\',\\n    idade: \'21 anos\',\\n    curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\',\\n    componente_curricular: \'Banco de Dados Relacional e Engenharia de Dados\',\\n    modulo_periodo: \'4\302\272 Semestre / Noturno\',\\n    data_elaboracao: \'2026-10-27\',\\n    docente_regente: \'Prof. Dr. Marcelo Albuquerque (Docente do Departamento de Computa\303\247\303\243o)\',\\n    docente_aee: \'Prof\302\252. Dra. Cl\303\241udia Fagundes (Especialista em Acessibilidade Universit\303\241ria / NAPNE)\',\\n    profissional_apoio: \'Juliana Prado (Bolsista de Tecnologia Assistiva e Monitoria Acad\303\252mica)\',\\n    coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\\n  },\\n  historico_napne: {\\n    status_diagnostico: \'confirmado\',\\n    categoria_neurodivergencia: \'Defici\303\252ncia Visual (Baixa Vis\303\243o Severa)\',\\n    cid_ou_hipotese: \'H54.1 (Baixa vis\303\243o em ambos os olhos por retinopatia cong\303\252nita)\',\\n    breve_historico_clinico_familiar:\\n      \'Estudante universit\303\241ria de gradua\303\247\303\243o em Sistemas de Informa\303\247\303\243o no Campus Para\303\255so (integrante dos 14 estudantes acompanhados no Ensino Superior). Ingressou pelo sistema de cotas para pessoas com defici\303\252ncia. Apresenta diagn\303\263stico oftalmol\303\263gico de Baixa Vis\303\243o Severa decorrente de retinopatia cong\303\252nita com acuidade visual inferior a 20/400 no melhor olho e perda de campo visual perif\303\251rico. Utiliza leitor de tela NVDA em ambiente Windows e Orca no Linux, associado a amplia\303\247\303\243o de 300% com alto contraste invertido em monitores de 27 polegadas. Plenamente alfabetizada em tecnologias computacionais e linha de comando.\',\\n    descricao_condicao_especifica:\\n      \'Incapacidade de visualizar diagramas gr\303\241ficos de Modelo Entidade-Relacionamento (MER) apresentados em imagens rasterizadas (.png/.jpg) ou ferramentas visuais do tipo MySQL Workbench/StarUML que carecem de suporte a leitores de tela. Em contrapartida, possui racioc\303\255nio abstrato de alto n\303\255vel, excelente compreens\303\243o de \303\241lgebra relacional, c\303\241lculo relacional e sintaxe SQL.\',\\n    informacoes_dos_pais:\\n      \'Estudante adulta e aut\303\264noma, reside na cidade do campus universit\303\241rio. Mant\303\251m contato regular com o NAPNE universit\303\241rio para garantia de acessibilidade nos sistemas acad\303\252micos e laborat\303\263rios.\',\\n  },\\n  estudo_de_caso: {\\n    barreiras: [\\n      {\\n        id: \'B1\',\\n        categoria: \'metodologica\',\\n        descricao: \'Aulas te\303\263ricas e materiais de estudo baseados em slides com diagramas conceituais gr\303\241ficos de banco de dados sem descri\303\247\303\243o textual alternativa das tabelas e cardinalidades.\',\\n        impacto: \'O leitor de tela l\303\252 apenas \\\"imagem_01.png\\\", deixando a estudante sem acesso \303\240 estrutura das entidades, atributos e chaves prim\303\241rias/estrangeiras.\',\\n        estrategia_enfrentamento: \'DUA 3.0: Disponibiliza\303\247\303\243o concomitante de representa\303\247\303\243o textual estruturada (formato DBML / Markdown descritivo / YAML) das entidades e relacionamentos, al\303\251m de diagramas t\303\241teis impressos em relevo para conceitos espaciais.\',\\n      },\\n      {\\n        id: \'B2\',\\n        categoria: \'tecnologica\',\\n        descricao: \'Ferramentas de modelagem gr\303\241fica obrigat\303\263rias que n\303\243o possuem acessibilidade por teclado ou atalhos para leitores de tela.\',\\n        impacto: \'Impossibilita a realiza\303\247\303\243o de tarefas pr\303\241ticas nas ferramentas recomendadas pelo plano de curso tradicional.\',\\n        estrategia_enfrentamento: \'Aceite de ferramentas de modelagem textual (Code-First / DBML / scripts SQL DDL comentados) como equivalentes funcionais plenos.\',\\n      },\\n      {\\n        id: \'B3\',\\n        categoria: \'metodologica\',\\n        descricao: \'Provas escritas tradicionais em folhas de papel impressas com diagramas compactos para resolu\303\247\303\243o de queries complexas \303\240 m\303\243o.\',\\n        impacto: \'Totalmente inacess\303\255vel para a condi\303\247\303\243o de baixa vis\303\243o severa.\',\\n        estrategia_enfrentamento: \'Avalia\303\247\303\243o pr\303\241tica digital realizada no laborat\303\263rio de acessibilidade, com acesso a terminal SQL (PostgreSQL/SQLite) em ambiente de alto contraste e tempo estendido (+50%).\',\\n      },\\n      {\\n        i