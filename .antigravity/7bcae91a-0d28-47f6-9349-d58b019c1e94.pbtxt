            }
            lines {
              text: "      avaliacaoAcessivel:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Avalia\303\247\303\243o baseada no cumprimento dos testes funcionais automatizados, liberando o estudante da necessidade de reescrever o c\303\263digo indefinidamente.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    guiaPratico: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      passo_a_passo_explicacao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Deixe claro desde o in\303\255cio qual \303\251 o crit\303\251rio exato de \"pronto\" (Definition of Done). Evite pedir \"fa\303\247a o melhor c\303\263digo poss\303\255vel\"; pe\303\247a \"fa\303\247a uma fun\303\247\303\243o que receba X e retorne Y passando nos 3 testes\".\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      divisao_tarefa_chunking: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 1: Escrever a vers\303\243o inicial funcional do c\303\263digo sem se preocupar com otimiza\303\247\303\243o est\303\251tica.\',"
