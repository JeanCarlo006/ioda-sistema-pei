        target_content: "            {onOpenCampusStats && (\n              <button\n                onClick={onOpenCampusStats}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-emerald-900 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n                title=\"Estat\303\255sticas e Neurodiverg\303\252ncias do Campus Para\303\255so\"\n              >\n                <BarChart2 className=\"w-3.5 h-3.5 text-emerald-700\" />\n                <span className=\"hidden sm:inline\">Censo Campus</span>\n                <span className=\"font-mono bg-emerald-200 text-emerald-950 px-1.5 py-0.2 rounded text-[10px]\">\n                  {stats.estudantes_geral}\n                </span>\n              </button>\n            )}\n\n            <button\n              onClick={onOpenSolutionBank}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              title=\"Banco de Solu\303\247\303\265es Pedag\303\263gicas para Condi\303\247\303\265es em TI\"\n            >\n              <Wrench className=\"w-3.5 h-3.5 text-slate-600\" />\n              <span className=\"hidden sm:inline\">Banco DUA</span>\n            </button>"
        replacement_content: "            {/* Menu de Suporte, Configura\303\247\303\243o & Diretrizes (unificando Censo, Banco DUA e Legisla\303\247\303\243o) */}\n            <div className=\"relative\">\n              <button\n                type=\"button\"\n                onClick={() => setIsSupportOpen(!isSupportOpen)}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n                title=\"Recursos de Suporte Pedag\303\263gico, Legisla\303\247\303\243o e Banco DUA\"\n              >\n                <HelpCircle className=\"w-3.5 h-3.5 text-emerald-700\" />\n                <span className=\"hidden sm:inline\">Suporte & Diretrizes</span>\n                <ChevronDown className=\"w-3 h-3 text-slate-500\" />\n              </button>\n\n              {isSupportOpen && (\n                <div className=\"absolute right-0 top-full mt-2 w-80 bg-white rounded-2xl shadow-xl border border-slate-200 z-50 p-2 space-y-1 animate-fadeIn\">\n                  <div className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3 py-1.5\">\n                    Recursos de Apoio Pedag\303\263gico\n                  </div>\n\n                  <button\n                    onClick={() => {\n                      onOpenSolutionBank();\n                      setIsSupportOpen(false);\n                    }}\n                    className=\"w-full text-left p-2.5 rounded-xl hover:bg-slate-50 text-xs transition-colors flex items-start gap-2.5 cursor-pointer\"\n                  >\n                    <div className=\"p-1.5 bg-emerald-100 text-emerald-800 rounded-lg shrink-0 mt-0.5\">\n                      <Wrench className=\"w-4 h-4\" />\n                    </div>\n                    <div>\n                      <div className=\"font-bold text-slate-900\">Banco de Solu\303\247\303\265es DUA 3.0</div>\n                      <div className=\"text-[11px] text-slate-500\">\n                        Cat\303\241logo de tecnologias assistivas e estrat\303\251gias para laborat\303\263rios de TI.\n                      </div>\n                    </div>\n                  </button>\n\n                  {onOpenCampusStats && (\n                    <button\n                      onClick={() => {\n                        onOpenCampusStats();\n                        setIsSupportOpen(false);\n                      }}\n                      className=\"w-full text-left p-2.5 rounded-xl hover:bg-slate-50 text-xs transition-colors flex items-start gap-2.5 cursor-pointer\"\n                    >\n                      <div className=\"p-1.5 bg-teal-100 text-teal-800 rounded-lg shrink-0 mt-0.5\">\n                        <BarChart2 className=\"w-4 h-4\" />\n                      </div>\n                      <div>\n                        <div className=\"font-bold text-slate-900 flex items-center gap-1.5\">\n                          <span>Censo Inclusivo Campus Para\303\255so</span>\n                          <span className=\"text-[10px] bg-teal-100 text-teal-900 font-mono font-bold px-1.5 py-0.2 rounded\">\n                            {stats.estudantes_geral}\n                          </span>\n                        </div>\n                        <div className=\"text-[11px] text-slate-500\">\n                          15 M\303\251dio T\303\251cnico \302\267 14 Superior TI \302\267 5 Sem Laudo (MEC 421)\n                        </div>\n                      </div>\n                    </button>\n                  )}\n\n                  <div className=\"p-2.5 bg-emerald-50/70 border border-emerald-100 rounded-xl text-[11px] text-slate-700 space-y-1\">\n                    <div className=\"font-bold text-emerald-950 flex items-center gap-1\">\n                      <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-700\" />\n                      <span>Garantia Sem Laudo (Portaria MEC 421/2026)</span>\n                    </div>\n                    <p className=\"text-[10px] text-emerald-900 leading-relaxed\">\n                      O PEI e o AEE s\303\243o assegurados com base na avalia\303\247\303\243o pedag\303\263gica das barreiras, sem exig\303\252ncia de diagn\303\263stico m\303\251dico pr\303\251vio.\n                    </p>\n                  </div>\n                </div>\n              )}\n            </div>"
        start_line: 154
