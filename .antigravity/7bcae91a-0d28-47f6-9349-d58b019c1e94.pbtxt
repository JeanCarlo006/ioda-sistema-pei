      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { PEICompleto } from \'../types/pei\';\\nimport { Printer, Edit3, Save, Check } from \'lucide-react\';\\n\\ninterface OfficialTemplateViewProps {\\n  pei: PEICompleto;\\n  onPrint: () => void;\\n  onUpdatePei?: (updatedPei: PEICompleto) => void;\\n}\\n\\nexport const OfficialTemplateView: React.FC<OfficialTemplateViewProps> = ({\\n  pei,\\n  onPrint,\\n  onUpdatePei,\\n}) => {\\n  const [isEditing, setIsEditing] = useState(false);\\n  const [editedPei, setEditedPei] = useState<PEICompleto>(pei);\\n\\n  // Sync if external pei changes and not currently editing\\n  React.useEffect(() => {\\n    if (!isEditing) {\\n      setEditedPei(pei);\\n    }\\n  }, [pei, isEditing]);\\n\\n  const handleSave = () => {\\n    if (onUpdatePei) {\\n      onUpdatePei(editedPei);\\n    }\\n    setIsEditing(false);\\n  };\\n\\n  const { cabecalho, historico_napne, planejamento_pei } = editedPei;\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Top Action Bar (hidden in print) */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 no-print\\\">\\n        <div>\\n          <span className=\\\"text-xs font-semibold text-emerald-800 uppercase tracking-wider block\\\">\\n            Documento Formal Institucional \302\267 Template NAPNE\\n          </span>\\n          <h2 className=\\\"text-base sm:text-lg font-bold text-slate-900 mt-0.5\\\">\\n            PEI - Plano de Ensino Individualizado\\n          </h2>\\n          <p className=\\\"text-xs text-slate-500\\\">\\n            Formato oficial para arquivo pedag\303\263gico, acompanhamento do colegiado e assinaturas\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2\\\">\\n          {isEditing ? (\\n            <button\\n              onClick={handleSave}\\n              className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg transition-colors cursor-pointer shadow-xs\\\"\\n            >\\n              <Save className=\\\"w-3.5 h-3.5\\\" />\\n              Salvar Altera\303\247\303\265es\\n            </button>\\n          ) : (\\n            <button\\n              onClick={() => setIsEditing(true)}\\n              className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors cursor-pointer\\\"\\n            >\\n              <Edit3 className=\\\"w-3.5 h-3.5\\\" />\\n              Editar Campos\\n            </button>\\n          )}\\n\\n          <button\\n            onClick={onPrint}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors cursor-pointer shadow-xs whitespace-nowrap\\\"\\n          >\\n            <Printer className=\\\"w-4 h-4\\\" />\\n            Imprimir / Salvar PDF\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* A4 Printable Document Container */}\\n      <div className=\\\"bg-white border border-slate-300 shadow-sm p-8 sm:p-12 max-w-4xl mx-auto rounded-none text-slate-900 font-sans print:border-none print:shadow-none print:p-0\\\">\\n        {/* Header */}\\n        <div className=\\\"border-b-2 border-slate-900 pb-4 mb-6\\\">\\n          <div className=\\\"flex items-start justify-between gap-4\\\">\\n            <div>\\n              <span className=\\\"text-xs font-mono uppercase tracking-widest text-slate-500 block\\\">\\n                MINIST\303\211RIO DA EDUCA\303\207\303\203O \302\267 DIRETORIA DE ENSINO \302\267 NAPNE\\n              </span>\\n              <h1 className=\\\"text-xl sm:text-2xl font-black tracking-tight text-slate-900 mt-1\\\">\\n                PEI - Plano de Ensino Individualizado\\n              </h1>\\n              <span className=\\\"text-xs text-slate-600 block mt-0.5\\\">\\n                N\303\272cleo de Atendimento \303\240s Pessoas com Necessidades Educacionais Espec\303\255ficas\\n              </span>\\n            </div>\\n\\n            {/* Photo / ID Stamp Box */}\\n            <div className=\\\"w-24 h-28 border-2 border-slate-400 bg-slate-50 rounded-sm flex flex-col items-center justify-center text-center p-1.5 shrink-0\\\">\\n              <span className=\\\"text-[10px] font-mono font-bold text-slate-600 uppercase leading-tight\\\">\\n                FOTO DO ESTUDANTE\\n              </span>\\n              <span className=\\\"text-xs font-bold text-slate-900 mt-1\\\">\\n                {cabecalho.estudante.split(\' \')[0]}\\n              </span>\\n              <span className=\\\"text-[9px] text-slate-400 font-mono mt-0.5\\\">\\n                {cabecalho.codigo_matricula}\\n              </span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Section 1: Identifica\303\247\303\243o */}\\n        <div className=\\\"mb-6\\\">\\n          <div className=\\\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\\\">\\n            Identifica\303\247\303\243o\\n          </div>\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-xs\\\">\\n            <div>\\n              <strong className=\\\"text-slate-600\\\">Docente:</strong>{\' \'}\\n              {isEditing ? (\\n                <input\\n                  type=\\\"text\\\"\\n                  value={cabecalho.docente_regente}\\n                  onChange={(e) =>\\n                    setEditedPei({\\n                      ...editedPei,\\n                      cabecalho: { ...cabecalho, docente_regente: e.target.value },\\n                    })\\n                  }\\n                  className=\\\"w-full p-1 border rounded mt-0.5 text-xs\\\"\\n                />\\n              ) : (\\n                <span className=\\\"font-semibold text-slate-900\\\">{cabecalho.docente_regente}</span>\\n              )}\\n            </div>\\n\\n            <div>\\n              <strong className=\\\"text-slate-600\\\">Nome do estudante:</strong>{\' \'}\\n              {isEditing ? (\\n                <input\\n                  type=\\\"text\\\"\\n                  value={cabecalho.estudante}\\n                  onChange={(e) =>\\n                    setEditedPei({\\n                      ...editedPei,\\n                      cabecalho: { ...cabecalho, estudante: e.target.value },\\n                    })\\n                  }\\n                  className=\\\"w-full p-1 border rounded mt-0.5 text-xs font-bold\\\"\\n                />\\n              ) : (\\n                <span className=\\\"font-bold text-slate-900\\\">{cabecalho.estudante}</span>\\n              )}\\n            </div>\\n\\n            <div>\\n              <strong className=\\\"text-slate-600\\\">Matr\303\255cula:</strong>{\' \'}\\n              <span className=\\\"font-mono text-slate-900\\\">{cabecalho.codigo_matricula}</span>\\n            </div>\\n\\n            <div>\\n              <strong className=\\\"text-slate-600\\\">Curso:</strong>{\' \'}\\n              {isEditing ? (\\n                <input\\n                  type=\\\"text\\\"\\n                  value={cabecalho.curso}\\n                  onChange={(e) =>\\n                    setEditedPei({\\n                      ...editedPei,\\n                      cabecalho: { ...cabecalho, curso: e.target.value },\\n                    })\\n                  }\\n                  className=\\\"w-full p-1 border rounded mt-0.5 text-xs\\\"\\n                />\\n              ) : (\\n                <span className=\\\"font-medium text-slate-900\\\">{cabecalho.curso}</span>\\n              )}\\n            </div>\\n\\n            <div>\\n              <strong className=\\\"text-slate-600\\\">Componente Curricular:</strong>{\' \'}\\n              {isEditing ? (\\n                <input\\n                  type=\\\"text\\\"\\n                  value={cabecalho.componente_curricular}\\n                  onChange={(e) =>\\n                    setEditedPei({\\n                      ...editedPei,\\n                      cabecalho: { ...cabecalho, componente_curricular: e.target.value },\\n                    })\\n                  }\\n                  className=\\\"w-full p-1 border rounded mt-0.5 text-xs font-semibold\\\"\\n                />\\n              ) : (\\n                <span className=\\\"font-semibold text-slate-900\\\">{cabecalho.componente_curricular}</span>\\n              )}\\n            </div>\\n\\n            <div>\\n              <strong className=\\\"text-slate-600\\\">Per\303\255odo / M\303\263dulo:</strong>{\' \'}\\n              <span className=\\\"font-medium text-slate-900\\\">{cabecalho.modulo_periodo}</span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Section 2: Hist\303\263ricos Cl\303\255nico e Familiar do Estudante */}\\n        <div className=\\\"mb-6\\\">\\n          <div className=\\\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\\\">\\n            Hist\303\263ricos Cl\303\255nico e Familiar do Estudante\\n          </div>\\n          <div className=\\\"space-y-3 text-xs leading-relaxed\\\">\\n            <div>\\n              <span className=\\\"font-bold text-slate-700 block mb-0.5\\\">\\n                Breve hist\303\263rico cl\303\255nico e familiar do estudante: (NAPNE)\\n              </span>\\n              {isEditing ? (\\n                <textarea\\n                  value={historico_napne.breve_historico_clinico_familiar}\\n                  onChange={(e) =>\\n                    setEditedPei({\\n                      ...editedPei,\\n                      historico_napne: {\\n                        ...historico_napne,\\n                        breve_historico_clinico_familiar: e.target.value,\\n                      },\\n                    })\\n                  }\\n                  rows={4}\\n                  className=\\\"w-full p-2 border rounded text-xs\\\"\\n                />\\n              ) : (\\n                <p className=\\\"text-slate-800 text-justify\\\">\\n                  {historico_napne.breve_historico_clinico_familiar}\\n                </p>\\n              )}\\n            </div>\\n\\n            <div>\\n              <span className=\\\"font-bold text-slate-700 block mb-0.5\\\">\\n                Breve descri\303\247\303\243o da condi\303\247\303\243o espec\303\255fica do estudante: (NAPNE)\\n              </span>\\n              {isEditing ? (\\n                <textarea\\n                  value={historico_napne.descricao_condicao_especifica}\\n                  onChange={(e) =>\\n                    setEditedPei({\\n                      ...editedPei,\\n                      historico_napne: {\\n                        ...historico_napne,\\n                        descricao_condicao_especifica: e.target.value,\\n                      },\\n                    })\\n                  }\\n                  rows={3}\\n                  className=\\\"w-full p-2 border rounded text-xs\\\"\\n                />\\n              ) : (\\n                <p className=\\\"text-slate-800 text-justify\\\">\\n                  {historico_napne.descricao_condicao_especifica}\\n                </p>\\n              )}\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Section 3: Informa\303\247\303\265es dos Pais */}\\n        <div className=\\\"mb-6\\\">\\n          <div className=\\\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\\\">\\n            Informa\303\247\303\265es dos Pais (NAPNE)\\n          </div>\\n          {isEditing ? (\\n            <textarea\\n              value={historico_napne.informacoes_dos_pais}\\n              onChange={(e) =>\\n                setEditedPei({\\n                  ...editedPei,\\n                  historico_napne: {\\n                    ...historico_napne,\\n                    informacoes_dos_pais: e.target.value,\\n                  },\\n                })\\n              }\\n              rows={3}\\n              className=\\\"w-full p-2 border rounded text-xs\\\"\\n            />\\n          ) : (\\n            <p className=\\\"text-xs text-slate-800 text-justify leading-relaxed\\\">\\n              {historico_napne.informacoes_dos_pais}\\n            </p>\\n          )}\\n        </div>\\n\\n        {/* Section 4: Planejamento do Componente Curricular */}\\n        <div className=\\\"mb-6\\\">\\n          <div className=\\\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\\\">\\n            Planejamento do Componente Curricular\\n          </div>\\n          <div className=\\\"space-y-3 text-xs leading-relaxed\\\">\\n            <div>\\n              <span className=\\\"font-bold text-slate-700 block mb-0.5\\\">Conte\303\272do (Ementa):</span>\\n              {isEditing ? (\\n                <textarea\\n                  value={planejamento_pei.conteudo_ementa_oficial}\\n                  onChange={(e) =>\\n                    setEditedPei({\\n                      ...editedPei,\\n                      planejamento_pei: {\\n                        ...planejamento_pei,\\n                        conteudo_ementa_oficial: e.target.value,\\n                      },\\n                    })\\n                  }\\n                  rows={3}\\n                  className=\\\"w-full p-2 border rounded text-xs\\\"\\n                />\\n              ) : (\\n                <p className=\\\"text-slate-800\\\">{planejamento_pei.conteudo_ementa_oficial}</p>\\n              )}\\n            </div>\\n\\n            <div>\\n              <span className=\\\"font-bold text-slate-700 block mb-0.5\\\">\\n                Compet\303\252ncias e Habilidades (Ementa):\\n              </span>\\n              {isEditing ? (\\n                <textarea\\n                  value={planejamento_pei.competencias_habilidades_ementa}\\n                  onChange={(e) =>\\n                    setEditedPei({\\n                      ...editedPei,\\n                      planejamento_pei: {\\n                        ...planejamento_pei,\\n                        competencias_habilidades_ementa: e.target.value,\\n                      },\\n                    })\\n                  }\\n                  rows={3}\\n                  className=\\\"w-full p-2 border rounded text-xs\\\"\\n                />\\n              ) : (\\n                <p className=\\\"text-slate-800\\\">{planejamento_pei.competencias_habilidades_ementa}</p>\\n              )}\\n            </div>\\n\\n            <div>\\n              <span className=\\\"font-bold text-slate-700 block mb-0.5\\\">\\n                Adapta\303\247\303\243o e Flexibiliza\303\247\303\243o Curricular: (descrever os conte\303\272dos aplicados/adaptados)\\n              </span>\\n              {isEditing ? (\\n                <textarea\\n                  value={planejamento_pei.adaptacao_flexibilizacao_curricular}\\n                  onChange={(e) =>\\n                    setEditedPei({\\n                      ...editedPei,\\n                      planejamento_pei: {\\n                        ...planejamento_pei,\\n                        adaptacao_flexibilizacao_curricular: e.target.value,\\n                      },\\n                    })\\n                  }\\n                  rows={3}\\n                  className=\\\"w-full p-2 border rounded text-xs\\\"\\n                />\\n              ) : (\\n                <p className=\\\"text-slate-800 text-justify\\\">\\n                  {planejamento_pei.adaptacao_flexibilizacao_curricular}\\n                </p>\\n              )}\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Section 5: Adapta\303\247\303\243o e Flexibiliza\303\247\303\243o Metodol\303\263gica */}\\n        <div className=\\\"mb-6\\\">\\n          <div className=\\\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\\\">\\n            Adapta\303\247\303\243o e Flexibiliza\303\247\303\243o Metodol\303\263gica (descrever as pr\303\241ticas pedag\303\263gicas aplicadas/adaptadas - DUA 3.0)\\n          </div>\\n          <div className=\\\"space-y-2 text-xs leading-relaxed\\\">\\n            <div>\\n              <strong className=\\\"text-slate-800\\\">Engajamento:</strong>{\' \'}\\n              <span className=\\\"text-slate-800\\\">\\n                {planejamento_pei.flexibilizacao_metodologica_dua.engajamento.join(\' \')}\\n              </span>\\n            </div>\\n            <div>\\n              <strong className=\\\"text-slate-800\\\">Representa\303\247\303\243o:</strong>{\' \'}\\n              <span className=\\\"text-slate-800\\\">\\n                {planejamento_pei.flexibilizacao_metodologica_dua.representacao.join(\' \')}\\n              </span>\\n            </div>\\n            <div>\\n              <strong className=\\\"text-slate-800\\\">A\303\247\303\243o e Express\303\243o:</strong>{\' \'}\\n              <span className=\\\"text-slate-800\\\">\\n                {planejamento_pei.flexibilizacao_metodologica_dua.acao_e_expressao.join(\' \')}\\n              </span>\\n            </div>\\n            <div>\\n              <strong className=\\\"text-slate-800\\\">Gest\303\243o e Apoio Semanal:</strong>{\' \'}\\n              <span className=\\\"text-slate-800\\\">\\n                {planejamento_pei.gestao_sala_de_aula.organizacao_espacial}{\' \'}\\n                {planejamento_pei.gestao_sala_de_aula.rotina_e_pausas}{\' \'}\\n                {planejamento_pei.gestao_sala_de_aula.suporte_docente_semanal}\\n              </span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Section 6: Avalia\303\247\303\243o */}\\n        <div className=\\\"mb-6\\\">\\n          <div className=\\\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\\\">\\n            Avalia\303\247\303\243o (onde estava; o quanto o estudante avan\303\247ou)\\n          </div>\\n          <div className=\\\"text-xs space-y-2 text-slate-800 leading-relaxed text-justify\\\">\\n            <p>\\n              <strong>Formato Acess\303\255vel:</strong> {planejamento_pei.estrategias_avaliacao.formato_acessivel}\\n            </p>\\n            <p>\\n              <strong>Crit\303\251rio de Sucesso:</strong> {planejamento_pei.estrategias_avaliacao.criterio_de_sucesso}\\n            </p>\\n            <p>\\n              <strong>Recursos Utilizados:</strong> {planejamento_pei.estrategias_avaliacao.recursos_utilizados.join(\', \')}.\\n            </p>\\n          </div>\\n        </div>\\n\\n        {/* Section 7: Observa\303\247\303\243o do Professor */}\\n        <div className=\\\"mb-8\\\">\\n          <div className=\\\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\\\">\\n            Observa\303\247\303\243o do Professor: Resultado e Objetivos Alcan\303\247ados\\n          </div>\\n          {isEditing ? (\\n            <textarea\\n              value={planejamento_pei.observacoes_docente}\\n              onChange={(e) =>\\n                setEditedPei({\\n                  ...editedPei,\\n                  planejamento_pei: {\\n                    ...planejamento_pei,\\n                    observacoes_docente: e.target.value,\\n                  },\\n                })\\n              }\\n              rows={4}\\n              className=\\\"w-full p-2 border rounded text-xs\\\"\\n            />\\n          ) : (\\n            <div className=\\\"text-xs text-slate-800 text-justify leading-relaxed p-3 bg-slate-50 border border-slate-200\\\">\\n              {planejamento_pei.observacoes_docente}\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Signatures Block */}\\n        <div className=\\\"mt-12 pt-6 border-t-2 border-slate-300\\\">\\n          <div className=\\\"grid grid-cols-2 gap-12 text-center text-xs\\\">\\n            <div>\\n              <div className=\\\"border-b border-slate-900 mb-1 pb-4\\\">\\n                <span className=\\\"font-semibold text-slate-900 block\\\">{cabecalho.docente_regente}</span>\\n              </div>\\n              <span className=\\\"text-slate-600 uppercase tracking-wider font-medium\\\">\\n                Docente\\n              </span>\\n            </div>\\n\\n            <div>\\n              <div className=\\\"border-b border-slate-900 mb-1 pb-4\\\">\\n                <span className=\\\"font-semibold text-slate-900 block\\\">{cabecalho.coordenacao_napne}</span>\\n              </div>\\n              <span className=\\\"text-slate-600 uppercase tracking-wider font-medium\\\">\\n                Coordenadora NAPNE\\n              </span>\\n            </div>\\n          </div>\\n        </div>\\n\\n        {/* Footer Reference */}\\n        <div className=\\\"mt-8 text-center text-[10px] text-slate-400 font-mono\\\">\\n          Documento elaborado nos termos da Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update OfficialTemplateView to match the exact template structure with inline editing and clean A4 printout\", \"Overwrite\":true, \"TargetFile\":\"/src/components/OfficialTemplateView.tsx\", \"toolAction\":\"Updating OfficialTemplateView\", \"toolSummary\":\"Update OfficialTemplateView component\"}"
      thinking_signature: "\022\217\n\n\214\n\001i\024}\023,\254\257^\200\023H\337\002\":CyC\241a\002e\271\213\247a\364\017\030NH\303\177\216\256\237\006\256{\356\006v-\367\273`\275\275\3475O\207\f\244\3352\355#\376\021y\300oAB\325Xi18t_\201\265{r\340\333\373\270n\270\237l\367\001I\343\343\nKu\036\355I\343\3634_\006\016\337\223\311\212\265\031\017&\235\347\241\035H\323\345\343O\201\344\005\213\324\024_S\226F7\341 \\\246\036\346p\252\v\373\277\236\2464d\342\004\'\266\3404\356a\265\271\220\223\253\006\225,5\225\345\321\340\326S\275\"\307y\032\325+\243\213\324{\302!\002\320aF\270UV\260\326\276\345\226Z\017\273\360\204I\3033\242\200Q\350\237E\020\024J\275\300 n\035\351\255T\326*\216\352yi \356/\357d\231*\353\31249+\260\370F\360\352Va\265\312\000\253\005\333v\026\240E\222\032\020\250\223\f\026m\323\035\020\202\351\033v[4\033\370\270\202\026\344t\3062\371\205#\233\n\005\255g\265I8&\351\250\317\253?w\227\265\314\354\372\340\261\375\\@v\366}\004~}\017/\262fEW\375(Z\302\n\002\026K\361\254P\245\324\226\254g\017\336\\\264\003\217\266VY\350C4G\225\276ok\201[\253\322_n@\031\221\211Ca\226\374\020\265d@\311\370:\256C\207#-r\310q\tF\311\215!\241\217q\200JH\235\017k\263\375\325I\020\217\v\360I\374\371\3242\236\206\216\213p\361m\255\252(w\a\354z\261\f4;r9wq\273\021\231=&\b-\375\231e\345\233\222\252\261Y4\356\027Y\\\370\374\366]\006\330\035\227d\001\310\'\325J1\235Mz\320N\356]\213\f\203[5Nrd \266\177!>\2152(\245G\262B\237\274\266\234\236\253\264J\230\353\344\365\3061\242\002\343N\027a\274<\222\301\320\035Y\205A\342\032\246\303\360\ah\020r\360\367\2242mO\333\243E!\030\177\273\303\235-\v8\374z\332\017 {\321\205\354\330\035\251\3011o\374\t\b\3768U\266\356\307\033\036nZ\036GJ/v\313.\267\223\r\023I\233\\\260`?\333c\246\002ES\2069\034Q\334:\"\204\332S\326Y\v\326\022\316\005h\2256\277\236\274\017X=\037\2144&\311\234\023\275\262}\210\244\364b\275\317\004x\323p\263r\354\370\204\314\344\261\262W\243\371\240\377\366\024\bb>\201\300\022\310\320\222`!\233\367Y\337\304S\202\316\241\341\002~6\230&\261\260M\335\235%\303\314e\302Sx\370tR\372\264\377&\260\361\257\262\020\232G\351\373W\305\364\230\361\3410j\355\337\310\271\v\253\376\037\204\263\324\216Dn\327\300\2353*nss\t\264s\307\354DR\0251\005\207\243f\027>\373B\307\215\306:\374\245\231\210\246\341luU;\362S\251\231\346o\352P\202B@\352\300\350\236o0U\306\n\327IO=\"\2552\020\233\016^\313R7\273E\271\026\n`\004\023\270\361\225\v\3263\301\v\250\315\303\226R\037\275[\211j\266q\324]\2102\233\026j\223\363\217Y\335\221\256\vB\177Z\020t\034Fr\3160\315|`\256~\220\215\275\272\034\373:X\264|+\346\257\352\024\325cAH\322SN\003\223d\310d\352\211?\252;\271\237\266e\211\357\236\244\342\375\377\f\343\275w`.\003\357\322O\017\241\355\261\353m\320\321\305J\312U\361\367\220]D\272\343,\273\201\020\307\344\304\361\2578\276K\317\032h\270s\277\304\245\253\027\326x\240#\000\006\373n[\360\366*l\177\3137\034\016\311v\354\351\215\224\230\t]][o(<\177\276\276\346^\260\201\312Fj\243\247\217n\207G\227c]\225\201&\242\372\005\277I\366=\026\277$\225L\225ssZ\324\035q\211n5\254\177\236\002\210\376(\341\3050\3627\3733\030\312\303\360\317\252\016h\206\'M%+\024#\237\262\300\202C0\231W\023zfg\034\363\241_\034\333\200Ji\233\316\022\222O\037\262\250E\237\002\201E\263G\337\003\272dBZy\203\205EB\365\347\a\343\226x\302{|\201\303\210A\226\021\334q\231\311*;a\276\340{\311\231\362\243\357\352\330\036u\306\330\364XzV\337\v\305\230\220\245\227LG\3300\016\024\373\020\021\026u\253=:U\213~\364$V\2137S.\303L\3465\232\376\252\352\220\177=\212\271l\240\023\363\366n\204\213\002\231\240\331\201?\273Y\367\305\257\247\004\213j\353\262\321\362T\001wF\314SHC\'\274\260x\0172I\037\341\366X\350\336x76\206\3275\335\024\027cc1\221[\a\207\306\364\311\363\"\243\266\b\220jR\331Yc\023\016T\275\216c\336Q\237\335\006\227:\2743"
