          replacement_content: "  const columns: {\n    key: PostItPainel[\'categoria\'];\n    title: string;\n  }[] = [\n    { key: \'objetivos\', title: \'Metas e Avan\303\247os\' },\n    { key: \'avaliacao\', title: \'Avalia\303\247\303\243o e Provas\' },\n    { key: \'rotina\', title: \'Rotina e Laborat\303\263rio\' },\n    { key: \'recursos_ta\', title: \'Tecnologia Assistiva\' },\n    { key: \'apoio\', title: \'Apoio e Parcerias\' },\n  ];\n\n  return (\n    <div className=\"space-y-8\">\n      {/* Header */}\n      <div className=\"bg-white border border-slate-200 rounded-2xl p-5 flex flex-col sm:flex-row sm:items-center justify-between gap-4\">\n        <div>\n          <h2 className=\"text-lg font-bold text-slate-900\">\n            Metas e Notas de Acompanhamento\n          </h2>\n          <p className=\"text-xs text-slate-500 mt-0.5\">\n            Registre observa\303\247\303\265es r\303\241pidas sobre o desenvolvimento de {pei.cabecalho.estudante}\n          </p>\n        </div>\n\n        <button\n          onClick={() => setIsModalOpen(true)}\n          className=\"inline-flex items-center gap-2 px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white rounded-xl text-xs font-bold transition-colors cursor-pointer shrink-0\"\n        >\n          <Plus className=\"w-4 h-4\" />\n          <span>+ Nova Anota\303\247\303\243o (Texto ou Voz)</span>\n        </button>\n      </div>\n\n      {/* Resumo de Evolu\303\247\303\243o e Parecer */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        <div className=\"bg-white border border-slate-200 rounded-2xl p-6 space-y-4\">\n          <h3 className=\"text-sm font-bold text-slate-900 flex items-center gap-2\">\n            <BarChart3 className=\"w-4 h-4 text-emerald-600\" />\n            <span>Indicadores do Per\303\255odo</span>\n          </h3>\n\n          <div className=\"space-y-3 pt-1\">\n            <div>\n              <div className=\"flex justify-between text-xs mb-1\">\n        