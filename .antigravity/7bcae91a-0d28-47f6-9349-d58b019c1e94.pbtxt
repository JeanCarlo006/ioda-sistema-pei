            }
            lines {
              text: "    descricaoProblema:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Dificuldade de sustenta\303\247\303\243o de aten\303\247\303\243o em longas sess\303\265es de codifica\303\247\303\243o nos laborat\303\263rios (LABIN), desorganiza\303\247\303\243o em projetos de software extensos com prazos distantes e bloqueio executivo na leitura de normas t\303\251cnicas densas (ex: ISO/IEC 25010, CMMI, MPS.BR).\',"
