  planner_response {
    thinking: "**Refining Interface Elements**\n\nI\'ve just cleaned up the `AddStudentModal.tsx` file. I\'ve taken out the overly descriptive text under the neurodivergence options in Step 3. I\'ve also swapped out the list for a much more streamlined set of \"Chip/Checkbox\" buttons. Now, these display only the checkbox and the name of the condition, like a clean, direct toggle. This should significantly improve user experience, as well as the appearance.\n\n\n"
    tool_calls {
      id: "call_214945"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { PEICompleto, EscalaFonte, ModoContraste } from \'../types/pei\';\\nimport {\\n  gerarNovoPeiCompleto,\\n  bancoDeSolucoesPedagogicas,\\n} from \'../data/initialCases\';\\nimport { VoiceDictationButton } from \'./SpeechControls\';\\nimport {\\n  UserPlus,\\n  X,\\n  Sparkles,\\n  GraduationCap,\\n  Loader2,\\n  CheckCircle,\\n  FileCheck2,\\n  HelpCircle,\\n  Laptop,\\n  ArrowRight,\\n  ArrowLeft,\\n  Type,\\n  Eye,\\n  Check,\\n  ChevronDown,\\n  ChevronUp,\\n} from \'lucide-react\';\\n\\ninterface AddStudentModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  onAddStudent: (newStudent: PEICompleto) => void;\\n  escalaFonteAtual?: EscalaFonte;\\n  onMudarFonte?: (escala: EscalaFonte) => void;\\n  modoContrasteAtual?: ModoContraste;\\n  onMudarContraste?: (modo: ModoContraste) => void;\\n}\\n\\nexport const AddStudentModal: React.FC<AddStudentModalProps> = ({\\n  isOpen,\\n  onClose,\\n  onAddStudent,\\n  escalaFonteAtual = \'normal\',\\n  onMudarFonte,\\n  modoContrasteAtual = \'padrao\',\\n  onMudarContraste,\\n}) => {\\n  const [currentStep, setCurrentStep] = useState<1 | 2 | 3 | 4>(1);\\n\\n  const [perfilModalidade, setPerfilModalidade] = useState<\'medio_tecnico\' | \'superior_ti\'>(\'medio_tecnico\');\\n  const [statusDiagnostico, setStatusDiagnostico] = useState<\'confirmado\' | \'em_investigacao_hipotese\'>(\'confirmado\');\\n  const [categoriaNeurodivergencia, setCategoriaNeurodivergencia] = useState(\\n    \'Transtorno do D\303\251ficit de Aten\303\247\303\243o com Hiperatividade (TDAH)\'\\n  );\\n  const [mostrarOutrasCondicoes, setMostrarOutrasCondicoes] = useState(false);\\n  const [verResumoTecnico, setVerResumoTecnico] = useState(false);\\n\\n  const [nome, setNome] = useState(\'\');\\n  const [matricula, setMatricula] = useState(\'\');\\n  const [idade, setIdade] = useState(\'17 anos\');\\n  const [curso, setCurso] = useState(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\\n  const [disciplina, setDisciplina] = useState(\'Programa\303\247\303\243o Web e Algoritmos\');\\n  const [modulo, setModulo] = useState(\'2\302\272 Ano / Diurno\');\\n  const [condicao, setCondicao] = useState(\'\');\\n  const [potencialidades, setPotentialidades] = useState(\'\');\\n  const [assistiveTech, setAssistiveTech] = useState(\'\');\\n  const [selectedSolucoes, setSelectedSolucoes] = useState<string[]>([\'sol-tdah\']);\\n  const [docenteRegente, setDocenteRegente] = useState(\'Prof. Docente da Disciplina\');\\n  const [docenteAee] = useState(\'Prof\302\252. Renata Cavalcanti (NAPNE \302\267 Campus Para\303\255so)\');\\n\\n  const [isGenerating, setIsGenerating] = useState(false);\\n  const [stepMessage, setStepMessage] = useState(\'\');\\n\\n  if (!isOpen) return null;\\n\\n  const presetsPpcEPlano = [\\n    {\\n      id: \'preset-eng-soft-2\',\\n      tag: \'Superior TI\',\\n      titulo: \'BAC.0406 - Engenharia de Software II\',\\n      curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\',\\n      modulo: \'4\302\272 Per\303\255odo / Noturno\',\\n      docente: \'Prof. Alexandre Santos\',\\n      perfil: \'superior_ti\' as const,\\n      idade: \'21 anos\',\\n    },\\n    {\\n      id: \'preset-bd-sql\',\\n      tag: \'Superior TI\',\\n      titulo: \'Banco de Dados Relacional e SQL\',\\n      curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\',\\n      modulo: \'3\302\272 Per\303\255odo / Noturno\',\\n      docente: \'Prof. Docente de Banco de Dados\',\\n      perfil: \'superior_ti\' as const,\\n      idade: \'20 anos\',\\n    },\\n    {\\n      id: \'preset-algoritmos-bsi\',\\n      tag: \'Superior TI\',\\n      titulo: \'Algoritmos e L\303\263gica de Programa\303\247\303\243o\',\\n      curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\',\\n      modulo: \'1\302\272 Per\303\255odo / Noturno\',\\n      docente: \'Prof. Docente de L\303\263gica e Algoritmos\',\\n      perfil: \'superior_ti\' as const,\\n      idade: \'19 anos\',\\n    },\\n    {\\n      id: \'preset-tecnico-web\',\\n      tag: \'M\303\251dio T\303\251cnico\',\\n      titulo: \'Programa\303\247\303\243o Web e Algoritmos\',\\n      curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\\n      modulo: \'2\302\272 Ano / Diurno\',\\n      docente: \'Prof. Docente de Desenvolvimento Web\',\\n      perfil: \'medio_tecnico\' as const,\\n      idade: \'16 anos\',\\n    },\\n    {\\n      id: \'preset-tecnico-redes\',\\n      tag: \'M\303\251dio T\303\251cnico\',\\n      titulo: \'Fundamentos de Redes de Computadores e Hardware\',\\n      curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\\n      modulo: \'1\302\272 Ano / Diurno\',\\n      docente: \'Prof. Gilberto Mendes\',\\n      perfil: \'medio_tecnico\' as const,\\n      idade: \'15 anos\',\\n    },\\n  ];\\n\\n  const handleApplyCoursePreset = (preset: typeof presetsPpcEPlano[0]) => {\\n    setCurso(preset.curso);\\n    setDisciplina(preset.titulo);\\n    setModulo(preset.modulo);\\n    setDocenteRegente(preset.docente);\\n    setIdade(preset.idade);\\n    setPerfilModalidade(preset.perfil);\\n  };\\n\\n  const handleSelectProfile = (perfil: \'medio_tecnico\' | \'superior_ti\') => {\\n    setPerfilModalidade(perfil);\\n\\n    if (perfil === \'superior_ti\') {\\n      setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\');\\n      setModulo(\'4\302\272 Per\303\255odo / Noturno\');\\n      setDisciplina(\'BAC.0406 - Engenharia de Software II\');\\n      setDocenteRegente(\'Prof. Alexandre Santos\');\\n      setIdade(\'21 anos\');\\n      syncSelectedConditions([\'sol-tdah\'], \'BAC.0406 - Engenharia de Software II\');\\n    } else {\\n      setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\\n      setModulo(\'2\302\272 Ano / Diurno\');\\n      setDisciplina(\'Programa\303\247\303\243o Web e Algoritmos\');\\n      setDocenteRegente(\'Prof. Docente da Disciplina\');\\n      setIdade(\'17 anos\');\\n      syncSelectedConditions([\'sol-tea\'], \'Programa\303\247\303\243o Web e Algoritmos\');\\n    }\\n  };\\n\\n  const syncSelectedConditions = (ids: string[], discOverride?: string) => {\\n    const finalIds = ids.length > 0 ? ids : [\'sol-tdah\'];\\n    setSelectedSolucoes(finalIds);\\n\\n    const solucoesObjs = finalIds\\n      .map((sid) => bancoDeSolucoesPedagogicas.find((s) => s.id === sid))\\n      .filter(Boolean);\\n\\n    if (solucoesObjs.length > 0) {\\n      const titulosCombinados = solucoesObjs.map((s) => s!.titulo).join(\' + \');\\n      setCategoriaNeurodivergencia(titulosCombinados);\\n\\n      const currentDisc = discOverride ?? disciplina;\\n      const isEngSoft =\\n        currentDisc.toLowerCase().includes(\'engenharia de software\') ||\\n        currentDisc.includes(\'BAC.0406\');\\n\\n      const descricoesCombinadas = solucoesObjs\\n        .map((s) => `\342\200\242 ${s!.titulo}: ${s!.descricaoProblema}`)\\n        .join(\'\\\\n\');\\n\\n      let customCondicao = descricoesCombinadas;\\n      if (isEngSoft) {\\n        customCondicao += `\\\\n\\\\n[Contextualiza\303\247\303\243o na disciplina BAC.0406 - Engenharia de Software II: acomoda\303\247\303\265es integradas para testes unit\303\241rios TDD em JUnit/Selenium e relat\303\263rios no Jira].`;\\n      }\\n      setCondicao(customCondicao);\\n\\n      const taUnificada = Array.from(\\n        new Set(solucoesObjs.flatMap((s) => s!.remediosSugeridos.recursosTA))\\n      );\\n      setAssistiveTech(taUnificada.join(\', \'));\\n\\n      const mapPotencial: Record<string, string> = {\\n        \'sol-tdah\':\\n          \'Racioc\303\255nio \303\241gil, resolu\303\247\303\243o criativa de bugs l\303\263gicos e foco em desafios pr\303\241ticos de codifica\303\247\303\243o quando divididos em etapas curtas\',\\n        \'sol-tea\':\\n          \'Aten\303\247\303\243o meticulosa aos detalhes, racioc\303\255nio l\303\263gico estruturado e facilidade para identificar padr\303\265es em c\303\263digo e testes\',\\n        \'sol-ansiedade\':\\n          \'Comprometimento com entregas de qualidade e \303\263timo desempenho em projetos pr\303\241ticos desenvolvidos no pr\303\263prio ritmo\',\\n        \'sol-aprendizagem\':\\n          \'Pensamento computacional visual, vis\303\243o pr\303\241tica de sistemas e bom racioc\303\255nio algor\303\255tmico\',\\n        \'sol-def-intelectual\':\\n          \'Dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o, colabora\303\247\303\243o em duplas e boa reten\303\247\303\243o com instru\303\247\303\265es objetivas\',\\n        \'sol-toc\':\\n          \'Elevada precis\303\243o t\303\251cnica, cuidado na cobertura de testes e organiza\303\247\303\243o de c\303\263digo\',\\n        \'sol-misto-ansioso-depressivo\':\\n          \'Comprometimento com projetos significativos quando apoiado por metas graduais\',\\n        \'sol-depressao\':\\n          \'Capacidade anal\303\255tica e engajamento construtivo em projetos pr\303\241ticos em ambiente acolhedor\',\\n        \'sol-epilepsia\':\\n          \'Racioc\303\255nio l\303\263gico estruturado e consist\303\252ncia t\303\251cnica em laborat\303\263rio visualmente seguro\',\\n      };\\n\\n      const potList = finalIds.map(\\n        (id) =>\\n          mapPotencial[id] ||\\n          \'Dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o, racioc\303\255nio l\303\263gico e colabora\303\247\303\243o t\303\251cnica\'\\n      );\\n      setPotentialidades(Array.from(new Set(potList)).join(\'; \') + \'.\');\\n\\n      if (finalIds.includes(\'sol-hipotese-sem-laudo\')) {\\n        setStatusDiagnostico(\'em_investigacao_hipotese\');\\n      }\\n    }\\n  };\\n\\n  const handleTogglePredefinedSolution = (id: string) => {\\n    const exists = selectedSolucoes.includes(id);\\n    let nextIds: string[];\\n    if (exists) {\\n      nextIds = selectedSolucoes.length > 1 ? selectedSolucoes.filter((item) => item !== id) : [id];\\n    } else {\\n      nextIds = [...selectedSolucoes, id];\\n    }\\n    syncSelectedConditions(nextIds);\\n  };\\n\\n  const isStep2Valid = nome.trim().length > 0 && disciplina.trim().length > 0;\\n\\n  const handleFinalSubmit = async () => {\\n    if (!nome.trim() || !disciplina.trim()) {\\n      setCurrentStep(2);\\n      return;\\n    }\\n\\n    setIsGenerating(true);\\n    const modalidadeDesc = perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\';\\n    setStepMessage(`Gerando estrat\303\251gias pr\303\241ticas de sala de aula para ${modalidadeDesc}...`);\\n\\n    try {\\n      let finalPei: PEICompleto | null = null;\\n      const localTemplate = gerarNovoPeiCompleto({\\n        nome: nome.trim(),\\n        matricula: matricula.trim(),\\n        idade: idade.trim(),\\n        curso: curso.trim(),\\n        disciplina: disciplina.trim(),\\n        modulo: modulo.trim(),\\n        condicao: condicao.trim() || \'Barreiras observadas no laborat\303\263rio de inform\303\241tica.\',\\n        docenteRegente: docenteRegente.trim(),\\n        docenteAee: docenteAee.trim(),\\n        solucaoBaseId: selectedSolucoes[0] || \'sol-tdah\',\\n        solucaoBaseIds: selectedSolucoes,\\n        statusDiagnostico,\\n        categoriaNeurodivergencia,\\n      });\\n\\n      try {\\n        const timeoutPromise = new Promise((_, reject) =>\\n          setTimeout(() => reject(new Error(\'Timeout\')), 7000)\\n        );\\n\\n        const fetchPromise = fetch(\'/api/gemini/generate-pei\', {\\n          method: \'POST\',\\n          headers: {\\n            \'Content-Type\': \'application/json\',\\n            Accept: \'application/json\',\\n          },\\n          body: JSON.stringify({\\n            studentName: nome.trim(),\\n            grade: modulo.trim(),\\n            course: curso.trim(),\\n            subject: disciplina.trim(),\\n            barriers: condicao.trim(),\\n            potentialities: potencialidades.trim(),\\n            assistiveTech: assistiveTech.trim(),\\n            docenteRegente: docenteRegente.trim(),\\n            docenteAee: docenteAee.trim(),\\n            age: idade.trim(),\\n            perfilModalidade,\\n            statusDiagnostico,\\n            campus: \'Campus Para\303\255so\',\\n            selectedIds: selectedSolucoes,\\n            selectedNeurodivergences: selectedSolucoes\\n              .map((sid) => bancoDeSolucoesPedagogicas.find((s) => s.id === sid)?.titulo)\\n              .filter(Boolean),\\n          }),\\n        });\\n\\n        const response: any = await Promise.race([fetchPromise, timeoutPromise]);\\n        const contentType = response.headers?.get(\'content-type\') || \'\';\\n\\n        if (contentType.includes(\'application/json\')) {\\n          const resData = await response.json();\\n          if (resData.success && resData.data) {\\n            const gen = resData.data;\\n\\n            finalPei = {\\n              ...localTemplate,\\n              id: `PEI-${Date.now().toString().slice(-4)}`,\\n              cabecalho: {\\n                ...localTemplate.cabecalho,\\n                estudante: gen.cabecalho?.estudante || nome.trim(),\\n                codigo_matricula:\\n                  gen.cabecalho?.codigo_matricula ||\\n                  matricula.trim() ||\\n                  localTemplate.cabecalho.codigo_matricula,\\n                curso: gen.cabecalho?.curso || curso.trim(),\\n                componente_curricular: gen.cabecalho?.componente_curricular || disciplina.trim(),\\n                modulo_periodo: gen.cabecalho?.modulo_periodo || modulo.trim(),\\n              },\\n              planejamento_pei: {\\n                ...localTemplate.planejamento_pei,\\n                conteudo_ementa_oficial:\\n                  gen.planejamento_pedagogico_pei?.conteudo_ementa_oficial ||\\n                  localTemplate.planejamento_pei.conteudo_ementa_oficial,\\n                competencias_habilidades_ementa:\\n                  gen.planejamento_pedagogico_pei?.competencias_habilidades_ementa ||\\n                  localTemplate.planejamento_pei.competencias_habilidades_ementa,\\n                adaptacao_flexibilizacao_curricular:\\n                  gen.planejamento_pedagogico_pei?.adaptacao_flexibilizacao_curricular ||\\n                  localTemplate.planejamento_pei.adaptacao_flexibilizacao_curricular,\\n                objetivos_e_metas:\\n                  Array.isArray(gen.planejamento_pedagogico_pei?.objetivos_e_metas_adaptadas) &&\\n                  gen.planejamento_pedagogico_pei.objetivos_e_metas_adaptadas.length > 0\\n                    ? gen.planejamento_pedagogico_pei.objetivos_e_metas_adaptadas.map((m: any) => ({\\n                        id_meta: m.id_meta || \'M1\',\\n                        descricao_meta: m.descricao_meta,\\n                        prazo: m.prazo || \'Mensal (4 semanas)\',\\n                        indicador_sucesso: m.indicador_sucesso,\\n                        progresso_percentual: 50,\\n                        status: \'em_andamento\',\\n                      }))\\n                    : localTemplate.planejamento_pei.objetivos_e_metas,\\n                flexibilizacao_metodologica_dua: {\\n                  engajamento:\\n                    gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.engajamento ||\\n                    localTemplate.planejamento_pei.flexibilizacao_metodologica_dua.engajamento,\\n                  representacao:\\n                    gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.representacao ||\\n                    localTemplate.planejamento_pei.flexibilizacao_metodologica_dua.representacao,\\n                  acao_e_expressao:\\n                    gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.acao_e_expressao ||\\n                    localTemplate.planejamento_pei.flexibilizacao_metodologica_dua.acao_e_expressao,\\n                },\\n                guia_pratico_sala_de_aula:\\n                  gen.planejamento_pedagogico_pei?.guia_pratico_sala_de_aula ||\\n                  localTemplate.planejamento_pei.guia_pratico_sala_de_aula,\\n              },\\n            };\\n          }\\n        }\\n      } catch {\\n        // Fallback to localTemplate\\n      }\\n\\n      onAddStudent(finalPei || localTemplate);\\n      onClose();\\n    } finally {\\n      setIsGenerating(false);\\n      setStepMessage(\'\');\\n    }\\n  };\\n\\n  // Clean Chip / Checkbox list for the 9 primary neurodivergences\\n  const chipsNeurodivergencias = [\\n    { id: \'sol-tdah\', label: \'TDAH (D\303\251ficit de Aten\303\247\303\243o e Hiperatividade)\' },\\n    { id: \'sol-tea\', label: \'TEA (Espectro Autista)\' },\\n    { id: \'sol-ansiedade\', label: \'Transtornos de Ansiedade\' },\\n    { id: \'sol-aprendizagem\', label: \'Dislexia / Disgrafia / Discalculia\' },\\n    { id: \'sol-def-intelectual\', label: \'Defici\303\252ncia Intelectual\' },\\n    { id: \'sol-toc\', label: \'TOC (Obsessivo-Compulsivo)\' },\\n    { id: \'sol-misto-ansioso-depressivo\', label: \'Misto Ansioso e Depressivo\' },\\n    { id: \'sol-depressao\', label: \'Transtornos Depressivos\' },\\n    { id: \'sol-epilepsia\', label: \'Epilepsia e Crises Convulsivas\' },\\n  ];\\n\\n  const outrasCondicoesChips = [\\n    { id: \'sol-baixa-visao\', label: \'Baixa Vis\303\243o / Cegueira\' },\\n    { id: \'sol-motora\', label: \'Defici\303\252ncia F\303\255sica / Motora\' },\\n    { id: \'sol-auditiva\', label: \'Surdez / Defici\303\252ncia Auditiva\' },\\n    { id: \'sol-hipotese-sem-laudo\', label: \'Em Investiga\303\247\303\243o (Sem Laudo)\' },\\n  ];\\n\\n  const solucoesSelecionadasObjs = selectedSolucoes\\n    .map((id) => bancoDeSolucoesPedagogicas.find((s) => s.id === id))\\n    .filter(Boolean);\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto\\\">\\n      <div className=\\\"bg-white rounded-2xl max-w-2xl w-full p-5 sm:p-6 shadow-2xl border border-slate-200 my-4 max-h-[92vh] flex flex-col overflow-hidden\\\">\\n        {/* Clean Header */}\\n        <div className=\\\"flex items-center justify-between pb-4 border-b border-slate-100 shrink-0\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-9 h-9 rounded-xl bg-emerald-600 flex items-center justify-center text-white\\\">\\n              <UserPlus className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <h3 className=\\\"text-base sm:text-lg font-bold text-slate-900\\\">\\n                Novo Plano de Aula (PEI)\\n              </h3>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                Passo {currentStep} de 4 \342\200\224 Preenchimento r\303\241pido e simplificado\\n              </p>\\n            </div>\\n          </div>\\n\\n          <div className=\\\"flex items-center gap-2\\\">\\n            {onMudarFonte && onMudarContraste && (\\n              <div className=\\\"hidden sm:flex items-center gap-1 bg-slate-100 p-1 rounded-lg border border-slate-200\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() =>\\n                    onMudarFonte(\\n                      escalaFonteAtual === \'normal\'\\n                        ? \'ampliada\'\\n                        : escalaFonteAtual === \'ampliada\'\\n                        ? \'grande\'\\n                        : \'normal\'\\n                    )\\n                  }\\n                  className=\\\"px-2 py-1 text-xs font-bold text-slate-700 hover:bg-white rounded transition-colors\\\"\\n                  title=\\\"Tamanho da fonte\\\"\\n                >\\n                  <Type className=\\\"w-3.5 h-3.5 inline mr-0.5\\\" />\\n                  {escalaFonteAtual === \'normal\' ? \'A\' : escalaFonteAtual === \'ampliada\' ? \'A+\' : \'A++\'}\\n                </button>\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() =>\\n                    onMudarContraste(\\n                      modoContrasteAtual === \'padrao\'\\n                        ? \'conforto\'\\n                        : modoContrasteAtual === \'conforto\'\\n                        ? \'alto-contraste\'\\n                        : \'padrao\'\\n                    )\\n                  }\\n                  className=\\\"px-2 py-1 text-xs font-medium text-slate-700 hover:bg-white rounded transition-colors\\\"\\n                  title=\\\"Contraste visual\\\"\\n                >\\n                  <Eye className=\\\"w-3.5 h-3.5 inline mr-1 text-emerald-700\\\" />\\n                  Contraste\\n                </button>\\n              </div>\\n            )}\\n\\n            <button\\n              onClick={onClose}\\n              disabled={isGenerating}\\n              className=\\\"p-1.5 text-slate-400 hover:text-slate-600 rounded-lg cursor-pointer\\\"\\n              title=\\\"Fechar\\\"\\n            >\\n              <X className=\\\"w-5 h-5\\\" />\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Clean Stepper Bar */}\\n        <div className=\\\"py-3 border-b border-slate-100 shrink-0\\\">\\n          <div className=\\\"grid grid-cols-4 gap-2\\\">\\n            {[\\n              { step: 1, label: \'1. Modalidade\' },\\n              { step: 2, label: \'2. Aluno & Aula\' },\\n              { step: 3, label: \'3. Condi\303\247\303\265es\' },\\n              { step: 4, label: \'4. Gerar PEI\' },\\n            ].map((item) => {\\n              const isCurrent = currentStep === item.step;\\n              const isDone = currentStep > item.step;\\n              const canClick = item.step <= 2 || isStep2Valid;\\n              return (\\n                <button\\n                  key={item.step}\\n                  type=\\\"button\\\"\\n                  disabled={!canClick || isGenerating}\\n                  onClick={() => canClick && setCurrentStep(item.step as 1 | 2 | 3 | 4)}\\n                  className={`py-2 px-2 rounded-xl text-xs font-bold transition-all flex items-center justify-center gap-1.5 ${\\n                    isCurrent\\n                      ? \'bg-emerald-700 text-white shadow-xs\'\\n                      : isDone\\n                      ? \'bg-emerald-50 text-emerald-900 border border-emerald-200\'\\n                      : \'bg-slate-50 text-slate-500 border border-slate-200\'\\n                  } ${!canClick ? \'opacity-50 cursor-not-allowed\' : \'cursor-pointer\'}`}\\n                >\\n                  {isDone && <Check className=\\\"w-3.5 h-3.5 text-emerald-700 shrink-0\\\" />}\\n                  <span className=\\\"truncate\\\">{item.label}</span>\\n                </button>\\n              );\\n            })}\\n          </div>\\n        </div>\\n\\n        {/* Step Content Body */}\\n        <div className=\\\"flex-1 overflow-y-auto py-5 px-1 space-y-5\\\">\\n          {/* PASSO 1: MODALIDADE */}\\n          {currentStep === 1 && (\\n            <div className=\\\"space-y-4\\\">\\n              <p className=\\\"text-sm text-slate-600\\\">\\n                Escolha o n\303\255vel de ensino do estudante para calibrar os exemplos pr\303\241ticos:\\n              </p>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => handleSelectProfile(\'medio_tecnico\')}\\n                  className={`p-5 rounded-2xl border-2 text-left transition-all cursor-pointer ${\\n                    perfilModalidade === \'medio_tecnico\'\\n                      ? \'bg-emerald-50/70 border-emerald-600\'\\n                      : \'bg-white border-slate-200 hover:border-slate-300\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-center justify-between mb-3\\\">\\n                    <div\\n                      className={`p-2.5 rounded-xl ${\\n                        perfilModalidade === \'medio_tecnico\'\\n                          ? \'bg-emerald-600 text-white\'\\n                          : \'bg-slate-100 text-slate-600\'\\n                      }`}\\n                    >\\n                      <Laptop className=\\\"w-5 h-5\\\" />\\n                    </div>\\n                    {perfilModalidade === \'medio_tecnico\' && (\\n                      <CheckCircle className=\\\"w-5 h-5 text-emerald-600\\\" />\\n                    )}\\n                  </div>\\n                  <h4 className=\\\"font-bold text-slate-900 text-base\\\">M\303\251dio T\303\251cnico em TI</h4>\\n                  <p className=\\\"text-xs text-slate-600 mt-1 leading-relaxed\\\">\\n                    Curso T\303\251cnico Integrado ao Ensino M\303\251dio. Foco em atividades guiadas, duplas no laborat\303\263rio e roteiros passo a passo.\\n                  </p>\\n                </button>\\n\\n                <button\\n                  type=\\\"button\\\"\\n                  onClick={() => handleSelectProfile(\'superior_ti\')}\\n                  className={`p-5 rounded-2xl border-2 text-left transition-all cursor-pointer ${\\n                    perfilModalidade === \'superior_ti\'\\n                      ? \'bg-emerald-50/70 border-emerald-600\'\\n                      : \'bg-white border-slate-200 hover:border-slate-300\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-center justify-between mb-3\\\">\\n                    <div\\n                      className={`p-2.5 rounded-xl ${\\n                        perfilModalidade === \'superior_ti\'\\n                          ? \'bg-emerald-600 text-white\'\\n                          : \'bg-slate-100 text-slate-600\'\\n                      }`}\\n                    >\\n                      <GraduationCap className=\\\"w-5 h-5\\\" />\\n                    </div>\\n                    {perfilModalidade === \'superior_ti\' && (\\n                      <CheckCircle className=\\\"w-5 h-5 text-emerald-600\\\" />\\n                    )}\\n                  </div>\\n                  <h4 className=\\\"font-bold text-slate-900 text-base\\\">Superior em TI</h4>\\n                  <p className=\\\"text-xs text-slate-600 mt-1 leading-relaxed\\\">\\n                    Sistemas de Informa\303\247\303\243o e Gradua\303\247\303\243o. Foco em autonomia acad\303\252mica, projetos em etapas (sprints) e engenharia de software.\\n                  </p>\\n                </button>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* PASSO 2: IDENTIFICA\303\207\303\203O DO ALUNO E DISCIPLINA */}\\n          {currentStep === 2 && (\\n            <div className=\\\"space-y-5\\\">\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-4\\\">\\n                <div className=\\\"sm:col-span-2\\\">\\n                  <label className=\\\"block text-xs font-bold text-slate-800 mb-1.5\\\">\\n                    Nome do Estudante <span className=\\\"text-red-500\\\">*</span>\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={nome}\\n                    onChange={(e) => setNome(e.target.value)}\\n                    placeholder=\\\"Digite o nome completo do aluno\\\"\\n                    className=\\\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm\\\"\\n                    required\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-bold text-slate-800 mb-1.5\\\">\\n                    Idade\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={idade}\\n                    onChange={(e) => setIdade(e.target.value)}\\n                    className=\\\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div>\\n                <span className=\\\"block text-xs font-bold text-slate-700 mb-2\\\">\\n                  Atalhos R\303\241pidos de Disciplinas (Opcional):\\n                </span>\\n                <div className=\\\"flex flex-wrap gap-2\\\">\\n                  {presetsPpcEPlano.map((p) => {\\n                    const isCurrent = disciplina === p.titulo;\\n                    return (\\n                      <button\\n                        key={p.id}\\n                        type=\\\"button\\\"\\n                        onClick={() => handleApplyCoursePreset(p)}\\n                        className={`px-3 py-1.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer ${\\n                          isCurrent\\n                            ? \'bg-emerald-700 text-white border-emerald-700\'\\n                            : \'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100\'\\n                        }`}\\n                      >\\n                        {p.titulo}\\n                      </button>\\n                    );\\n                  })}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-bold text-slate-800 mb-1.5\\\">\\n                    Disciplina <span className=\\\"text-red-500\\\">*</span>\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={disciplina}\\n                    onChange={(e) => setDisciplina(e.target.value)}\\n                    className=\\\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm\\\"\\n                    required\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-bold text-slate-800 mb-1.5\\\">\\n                    Professor(a) Respons\303\241vel\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={docenteRegente}\\n                    onChange={(e) => setDocenteRegente(e.target.value)}\\n                    className=\\\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm\\\"\\n                  />\\n                </div>\\n              </div>\\n\\n              <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n                <div>\\n                  <label className=\\\"block text-xs font-bold text-slate-800 mb-1.5\\\">\\n                    Curso\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={curso}\\n                    onChange={(e) => setCurso(e.target.value)}\\n                    className=\\\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <label className=\\\"block text-xs font-bold text-slate-800 mb-1.5\\\">\\n                    Per\303\255odo / Turma\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={modulo}\\n                    onChange={(e) => setModulo(e.target.value)}\\n                    className=\\\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-sm\\\"\\n                  />\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* PASSO 3: SELE\303\207\303\203O LIMPA DE NEURODIVERG\303\212NCIAS (CHIPS / CHECKBOXES) */}\\n          {currentStep === 3 && (\\n            <div className=\\\"space-y-5\\\">\\n              {/* Situa\303\247\303\243o do Laudo */}\\n              <div>\\n                <label className=\\\"text-xs font-bold text-slate-800 block mb-2\\\">\\n                  Situa\303\247\303\243o do Diagn\303\263stico:\\n                </label>\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setStatusDiagnostico(\'confirmado\')}\\n                    className={`p-3 rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer ${\\n                      statusDiagnostico === \'confirmado\'\\n                        ? \'bg-emerald-700 text-white border-emerald-700\'\\n                        : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-50\'\\n                    }`}\\n                  >\\n                    <FileCheck2 className=\\\"w-4 h-4\\\" />\\n                    <span>Com Laudo Confirmado</span>\\n                  </button>\\n\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setStatusDiagnostico(\'em_investigacao_hipotese\')}\\n                    className={`p-3 rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all cursor-pointer ${\\n                      statusDiagnostico === \'em_investigacao_hipotese\'\\n                        ? \'bg-amber-600 text-white border-amber-600\'\\n                        : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-50\'\\n                    }`}\\n                  >\\n                    <HelpCircle className=\\\"w-4 h-4\\\" />\\n                    <span>Sem Laudo (Em Observa\303\247\303\243o)</span>\\n                  </button>\\n                </div>\\n              </div>\\n\\n              {/* Chips / Checkboxes de Neurodiverg\303\252ncias (LIMPOS, SEM TEXTOS LONGOS) */}\\n              <div className=\\\"space-y-3\\\">\\n                <div className=\\\"flex items-center justify-between\\\">\\n                  <label className=\\\"text-xs font-bold text-slate-800\\\">\\n                    Selecione uma ou mais condi\303\247\303\265es do estudante:\\n                  </label>\\n                  <span className=\\\"text-xs font-semibold text-emerald-700\\\">\\n                    {selectedSolucoes.length} selecionada(s)\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\\\">\\n                  {chipsNeurodivergencias.map((item) => {\\n                    const isSelected = selectedSolucoes.includes(item.id);\\n                    return (\\n                      <button\\n                        key={item.id}\\n                        type=\\\"button\\\"\\n                        onClick={() => handleTogglePredefinedSolution(item.id)}\\n                        className={`px-3.5 py-3 rounded-xl border text-left text-xs font-semibold flex items-center gap-3 transition-all cursor-pointer ${\\n                          isSelected\\n                            ? \'bg-emerald-50 border-emerald-600 text-emerald-950 ring-1 ring-emerald-600\'\\n                            : \'bg-white border-slate-200 text-slate-800 hover:border-slate-300 hover:bg-slate-50\'\\n                        }`}\\n                      >\\n                        <div\\n                          className={`w-5 h-5 rounded-md flex items-center justify-center border shrink-0 transition-colors ${\\n                            isSelected\\n                              ? \'bg-emerald-600 border-emerald-600 text-white\'\\n                              : \'border-slate-300 bg-white\'\\n                          }`}\\n                        >\\n                          {isSelected && <Check className=\\\"w-3.5 h-3.5 stroke-[3]\\\" />}\\n                        </div>\\n                        <span className=\\\"leading-snug\\\">{item.label}</span>\\n                      </button>\\n                    );\\n                  })}\\n                </div>\\n\\n                {/* Bot\303\243o discreto para outras condi\303\247\303\265es */}\\n                <div className=\\\"flex flex-wrap items-center justify-between gap-2 pt-1\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setMostrarOutrasCondicoes(!mostrarOutrasCondicoes)}\\n                    className=\\\"text-xs font-semibold text-slate-600 hover:text-emerald-700 flex items-center gap-1 cursor-pointer\\\"\\n                  >\\n                    {mostrarOutrasCondicoes ? (\\n                      <>\\n                        <ChevronUp className=\\\"w-3.5 h-3.5\\\" />\\n                        <span>Ocultar condi\303\247\303\265es visuais/motoras/auditivas</span>\\n                      </>\\n                    ) : (\\n                      <>\\n                        <ChevronDown className=\\\"w-3.5 h-3.5\\\" />\\n                        <span>Mais condi\303\247\303\265es (Visual, Motora, Surdez)</span>\\n                      </>\\n                    )}\\n                  </button>\\n\\n                  {/* Bot\303\243o discreto \\\"Ver resumo\\\" fechado por padr\303\243o */}\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setVerResumoTecnico(!verResumoTecnico)}\\n                    className=\\\"text-xs font-semibold text-emerald-700 hover:text-emerald-900 flex items-center gap-1 cursor-pointer\\\"\\n                  >\\n                    {verResumoTecnico ? (\\n                      <>\\n                        <ChevronUp className=\\\"w-3.5 h-3.5\\\" />\\n                        <span>Ocultar resumo</span>\\n                      </>\\n                    ) : (\\n                      <>\\n                        <ChevronDown className=\\\"w-3.5 h-3.5\\\" />\\n                        <span>Ver resumo das condi\303\247\303\265es selecionadas</span>\\n                      </>\\n                    )}\\n                  </button>\\n                </div>\\n\\n                {mostrarOutrasCondicoes && (\\n                  <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2.5 pt-1\\\">\\n                    {outrasCondicoesChips.map((item) => {\\n                      const isSelected = selectedSolucoes.includes(item.id);\\n                      return (\\n                        <button\\n                          key={item.id}\\n                          type=\\\"button\\\"\\n                          onClick={() => handleTogglePredefinedSolution(item.id)}\\n                          className={`px-3.5 py-2.5 rounded-xl border text-left text-xs font-semibold flex items-center gap-3 transition-all cursor-pointer ${\\n                            isSelected\\n                              ? \'bg-emerald-50 border-emerald-600 text-emerald-950 ring-1 ring-emerald-600\'\\n                              : \'bg-white border-slate-200 text-slate-700 hover:border-slate-300\'\\n                          }`}\\n                        >\\n                          <div\\n                            className={`w-5 h-5 rounded-md flex items-center justify-center border shrink-0 ${\\n                              isSelected\\n                                ? \'bg-emerald-600 border-emerald-600 text-white\'\\n                                : \'border-slate-300 bg-white\'\\n                            }`}\\n                          >\\n                            {isSelected && <Check className=\\\"w-3.5 h-3.5 stroke-[3]\\\" />}\\n                          </div>\\n                          <span>{item.label}</span>\\n                        </button>\\n                      );\\n                    })}\\n                  </div>\\n                )}\\n\\n                {verResumoTecnico && solucoesSelecionadasObjs.length > 0 && (\\n                  <div className=\\\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2 text-xs text-slate-700\\\">\\n                    {solucoesSelecionadasObjs.map((s) => (\\n                      <div key={s!.id}>\\n                        <strong className=\\\"text-slate-900\\\">{s!.titulo}:</strong>{\' \'}\\n                        <span>{s!.remediosSugeridos.acaoExpressao}</span>\\n                      </div>\\n                    ))}\\n                  </div>\\n                )}\\n              </div>\\n\\n              {/* Observa\303\247\303\265es e Potencialidades com Ditado por Voz */}\\n              <div className=\\\"space-y-4 pt-2 border-t border-slate-100\\\">\\n                <div>\\n                  <div className=\\\"flex items-center justify-between mb-1.5\\\">\\n                    <label className=\\\"text-xs font-bold text-slate-800\\\">\\n                      Dificuldades / Barreiras Observadas em Aula\\n                    </label>\\n                    <VoiceDictationButton\\n                      label=\\\"Ditar por Voz\\\"\\n                      onTranscript={(spoken) =>\\n                        setCondicao((prev) => (prev ? `${prev} ${spoken}` : spoken))\\n                      }\\n                    />\\n                  </div>\\n                  <textarea\\n                    value={condicao}\\n                    onChange={(e) => setCondicao(e.target.value)}\\n                    rows={2}\\n                    placeholder=\\\"Voc\303\252 pode digitar ou clicar em \'Ditar por Voz\' para falar...\\\"\\n                    className=\\\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-xs\\\"\\n                  />\\n                </div>\\n\\n                <div>\\n                  <div className=\\\"flex items-center justify-between mb-1.5\\\">\\n                    <label className=\\\"text-xs font-bold text-slate-800\\\">\\n                      Interesses e Pontos Fortes do Estudante\\n                    </label>\\n                    <VoiceDictationButton\\n                      label=\\\"Ditar por Voz\\\"\\n                      onTranscript={(spoken) =>\\n                        setPotentialidades((prev) => (prev ? `${prev} ${spoken}` : spoken))\\n                      }\\n                    />\\n                  </div>\\n                  <textarea\\n                    value={potencialidades}\\n                    onChange={(e) => setPotentialidades(e.target.value)}\\n                    rows={2}\\n                    placeholder=\\\"Ex: Gosta de jogos, visual, aprende r\303\241pido com exemplos pr\303\241ticos...\\\"\\n                    className=\\\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-xs\\\"\\n                  />\\n                </div>\\n              </div>\\n            </div>\\n          )}\\n\\n          {/* PASSO 4: REVIS\303\203O SIMPLES */}\\n          {currentStep === 4 && (\\n            <div className=\\\"space-y-4\\\">\\n              <div className=\\\"bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-3\\\">\\n                <div className=\\\"flex items-center justify-between border-b border-slate-200 pb-3\\\">\\n                  <div>\\n                    <h4 className=\\\"text-base font-bold text-slate-900\\\">{nome || \'Estudante\'}</h4>\\n                    <p className=\\\"text-xs text-slate-500\\\">{curso} \302\267 {modulo}</p>\\n                  </div>\\n                  <span className=\\\"text-xs font-bold bg-emerald-100 text-emerald-900 px-3 py-1 rounded-full\\\">\\n                    {perfilModalidade === \'superior_ti\' ? \'Superior TI\' : \'M\303\251dio T\303\251cnico\'}\\n                  </span>\\n                </div>\\n\\n                <div className=\\\"space-y-2 text-xs\\\">\\n                  <div>\\n                    <span className=\\\"text-slate-500 font-semibold\\\">Disciplina: </span>\\n                    <span className=\\\"text-slate-900 font-bold\\\">{disciplina}</span>\\n                  </div>\\n                  <div>\\n                    <span className=\\\"text-slate-500 font-semibold\\\">Professor(a): </span>\\n                    <span className=\\\"text-slate-800\\\">{docenteRegente}</span>\\n                  </div>\\n                  <div>\\n                    <span className=\\\"text-slate-500 font-semibold\\\">Condi\303\247\303\265es Selecionadas: </span>\\n                    <span className=\\\"text-emerald-800 font-bold\\\">{categoriaNeurodivergencia}</span>\\n                  </div>\\n                </div>\\n              </div>\\n\\n              {isGenerating && (\\n                <div className=\\\"p-4 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center gap-3\\\">\\n                  <Loader2 className=\\\"w-5 h-5 text-emerald-700 animate-spin shrink-0\\\" />\\n                  <span className=\\\"text-xs font-semibold text-emerald-950\\\">{stepMessage}</span>\\n                </div>\\n              )}\\n            </div>\\n          )}\\n        </div>\\n\\n        {/* Footer Actions */}\\n        <div className=\\\"pt-4 border-t border-slate-100 flex items-center justify-between shrink-0 bg-white\\\">\\n          <div>\\n            {currentStep > 1 ? (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => setCurrentStep((prev) => (prev > 1 ? ((prev - 1) as any) : prev))}\\n                disabled={isGenerating}\\n                className=\\\"inline-flex items-center gap-1.5 px-4 py-2.5 border border-slate-300 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 text-xs cursor-pointer\\\"\\n              >\\n                <ArrowLeft className=\\\"w-4 h-4\\\" />\\n                <span>Voltar</span>\\n              </button>\\n            ) : (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={onClose}\\n                disabled={isGenerating}\\n                className=\\\"px-4 py-2.5 border border-slate-300 text-slate-700 font-semibold rounded-xl hover:bg-slate-50 text-xs cursor-pointer\\\"\\n              >\\n                Cancelar\\n              </button>\\n            )}\\n          </div>\\n\\n          <div>\\n            {currentStep < 4 ? (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={() => {\\n                  if (currentStep === 2 && !isStep2Valid) return;\\n                  setCurrentStep((prev) => (prev < 4 ? ((prev + 1) as any) : prev));\\n                }}\\n                disabled={currentStep === 2 && !isStep2Valid}\\n                className=\\\"inline-flex items-center gap-1.5 px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-xl text-xs cursor-pointer disabled:opacity-50\\\"\\n              >\\n                <span>Continuar</span>\\n                <ArrowRight className=\\\"w-4 h-4\\\" />\\n              </button>\\n            ) : (\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleFinalSubmit}\\n                disabled={isGenerating || !nome.trim()}\\n                className=\\\"inline-flex items-center gap-2 px-6 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-xl text-xs cursor-pointer disabled:opacity-50 shadow-sm\\\"\\n              >\\n                {isGenerating ? (\\n                  <>\\n                    <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />\\n                    <span>Gerando PEI...</span>\\n                  </>\\n                ) : (\\n                  <>\\n                    <Sparkles className=\\\"w-4 h-4\\\" />\\n                    <span>Concluir e Gerar PEI</span>\\n                  </>\\n                )}\\n              </button>\\n            )}\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Refactor AddStudentModal.tsx with clean Chip/Checkbox neurodivergence buttons, hidden summary toggle, and VoiceDictationButton\", \"Overwrite\":true, \"TargetFile\":\"/src/components/AddStudentModal.tsx\", \"toolAction\":\"Refactoring AddStudentModal.tsx\", \"toolSummary\":\"Refactor AddStudentModal.tsx\"}"
      thinking_signature: "\022\321\n\n\316\n\001i\024}\023\220\342\240W\33206*,\213\273\317\232\361\301\307q\276\261V\\Y\226\372hm\020W\314`\226)\334\274*\016D~*y\267\302\361_\246q\250Q\246\233\303\"\031\034t\254\335\222w.\221\360\177\021T.\343zKK\340\202\332s8\f\215Ub\202\002.\223\342S\245j\242d\272I\325FD\301\371\277\3044\234\245b\374\244q8\225\206WB\r\345\210r\312\busI\021\215m9n\370=,\256\241\"\020\300\3150!\366\2752{\253\344\314\353\231\344\002\264\306\347\003\307\357\362\031\317\317N5C\224\017m\252X\346\350\371`\025\314\222o\306\360\256,\354\317|=\351\377\304z\021}@*@\365\016r\214\000\345\262\'Y\237\237\377\205\v\3169\375\263\371\372\206\35747H\330F\265\276\206\211l\232]97L1\255\267\274\fR5\221\3222\363\333YB\273\246\305\371\224\036\027\025v\301\nCQ\246\277\200\"\331\275\024\b\333\rg\'\374\315\253F\246\256\031n\252\306\321\214hw3~c\237\246\346`8\267\036\347\315\336\255\351S\n\365eeJR\231W\266\250\354\274\357b\261\323\021\211\n_u+5pl\315\030l\371G$\003\005\217\364}y\374C\227\3003v\314\306\360\233W\330\026\322b\325\232\205{\f=)\307\340\216r[\036e\002\222`\026~z\215&=\363\334\253}\a\f\022\303\204H\264\367-\361TO\341\033r:\251\231\233.\266\005v\201\314\205\345\204\362\320A\230#t_\375\026\274\376\352\v\023<\213\002\004\314\273 \n\n6\234\335ZP}\222\367\361\033[1\3025,ec\264?/\016i\323\217\244\204j{Sy4.j\352\017\331\254Z\301f\2066H\244l\247\332\273\271\207\005\332\024\206\277\360\215%[/{1\367\f\223\023H\223\375\\\327\214\000\017\001\312+\275\217\304+bb\256\322\022\201ic^\231r\210\337\245K\250\366\312\255\000\234\366\346<\204_\211\302\276\265\343\204\354[^\337!\305\203\274\034 \227\340$E\224\001\377\321e\312-\216\332\323\022\234\373F\261!\017\233\027\033\340\271gA\377\240\003\214\276=$\006\020|=\2071\200U@c)L8\024b\247\027\025&\217\317z\225\273-!>\255^?\021\237\260w\233\302\315\217\234M\233\261`m5\251>:\020\375&\022\374U\032\310\334^\353\367).\030\t\201\026P\b)Al-\'\253\3378G\f\027>\246\267\036\255\211r8\256N\207y\326\330\350\277(\367u\357\023\272\333`\2131\264\322H\332\226An\223\307\333am%\002:\002\232\204\327\033`;\361\215F*5?\322\207\217\361\344w\201\0217\222P\035\347\245\034\vu[N+_`\271\002y\a\036N\336\321[,\213\035NZ\234\253\377\030\206k\216\242\211\256\255-\202\263\313\330tk\233a\302rD\255\2705\b\r\274\322\034\321\026?\317n\242\211M\305\312+\360z\201\221\241%\237\253\f\300\244L4\340$9\313\223\266iM\255\271\370r\r?t~i\312\az\3353\344\017\36526F8\222\315\n}\335\274\3527&*\360\326\260\225R\234\260\250\317\366\375\rL\271\f\3348\261\375\026ar\331\3761\030\\\r\375<\203\240#\343^/\260\370\341@Jf\375\240\n#n\224O\343\367(\273F\274\244\347\363\377\f6\021\247\336-^\225k\364[\031\004@\306L&6O\020\322&\000m:\323yG\272H\341\031@\216\036$b\317\231\254\355\376\205\3051%\257\211.]<\257\277D\a\370\237t*\234K\bZt\2028\367\333^3\261\271er%\337 C\005\371\377xS\266\021\0365\372\247\345\326\016;o\272\356\b\253\267\313v\360\342\223\363\343\035K\354\226\251\253i0\001\250\026\026Lo\fQ\365\324f\223N\345\366eb\b\316\252\244@\314\206\n\311\030\020\fT\236\243\234\352C\177\024\312N\225\251\001\204?\3525\310\234\256\204w\v\236~\003\250\363\327\222\240\273\355\224l\247\2362c\311;K\254\031\r\177\274\234\210t\302P\265\234\210\305x\305X\212\350\"\201\304<;\230m\032\021\204\376-\272p\225^{\341\307*\2061\331Hd\342M\357r\204\353\354\002E\271A\363y\306F\266\240\204\3516<R\324\232\3356\265y\340\025\274;\037%\313$c\033\231\267\243\221\177.\022\3153\276\335\235\301\213\242\342\a^\372\252\236\347\225\335\345\2254\235\354Z\327\270\236T\2668\252\rM\303b:\374\036\217\275\364\271AX@\215M\273\235\315\v\232R\272\aT9\337\006\212\207>\212\251K\002\261\231R\325\225+\351a\203\001\346\312\034\332\033\233\262$\247\033eC{v\270n\362Q\247\t\344\273\216\375\215e\352\274\201\037\254_\303z\307\243\367\366O6$\3203\376\310 \254\330\273\031xz1A}\315\035\346\355\340p\031\276Y\024B\362\300U\371\333CX\232\263\271;y+\304x\234\345\363E\262\027\003\342G\256\202\206+\270\247\002\213\373"
