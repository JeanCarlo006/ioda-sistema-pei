            }
            lines {
              text: "    descricaoProblema:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Perfeccionismo paralisante e rigidez cognitiva na refatora\303\247\303\243o de c\303\263digo, reda\303\247\303\243o de planos de teste e documenta\303\247\303\243o, gerando atrasos severos na entrega por checagens repetitivas exaustivas ou sofrimento desproporcional com avisos do compilador.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    remediosSugeridos: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      engajamento:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Defini\303\247\303\243o expl\303\255cita e pactuada de crit\303\251rios de \"conclu\303\255do\" (Definition of Done - DoD); estabelecimento de limites saud\303\241veis de refatora\303\247\303\243o para interromper ciclos de checagem repetitiva.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      representacao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Checklists com crit\303\251rios finitos e objetivos de aceite (ex: \"passou nos 3 testes unit\303\241rios principais = atividade finalizada com sucesso\"); sem regras abertas ou subjetivas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      acaoExpressao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Prazos intermedi\303\241rios com margem de seguran\303\247a; avalia\303\247\303\243o com foco na funcionalidade e n\303\243o na perfei\303\247\303\243o estil\303\255stica; tempo estendido (+50%).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      recursosTA: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
