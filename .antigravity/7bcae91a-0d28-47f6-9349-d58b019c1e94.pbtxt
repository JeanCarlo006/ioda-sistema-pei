  view_file {
    absolute_path_uri: "file:///src/data/initialCases.ts"
    start_line: 939
    end_line: 1259
    content: "\n// BANCO DE SOLU\303\207\303\225ES PEDAG\303\223GICAS PARA CONDI\303\207\303\225ES E NEURODIVERG\303\212NCIAS EM TI / COMPUTA\303\207\303\203O\n// Fundamentado no PPC do Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins),\n// no Plano de Ensino de Engenharia de Software II (BAC.0406) e nas diretrizes DUA 3.0 / Portaria MEC n\302\272 421/2026.\nexport const bancoDeSolucoesPedagogicas: SolucaoCondicao[] = [\n  {\n    id: \'sol-tdah\',\n    titulo: \'Transtorno do D\303\251ficit de Aten\303\247\303\243o com Hiperatividade (TDAH)\',\n    condicao: \'Transtorno do D\303\251ficit de Aten\303\247\303\243o com Hiperatividade (TDAH)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade de sustenta\303\247\303\243o de aten\303\247\303\243o em longas sess\303\265es de codifica\303\247\303\243o nos laborat\303\263rios (LABIN), desorganiza\303\247\303\243o em projetos de software extensos com prazos distantes e bloqueio executivo na leitura de normas t\303\251cnicas densas (ex: ISO/IEC 25010, CMMI, MPS.BR).\',\n    remediosSugeridos: {\n      engajamento:\n        \'Metodologia \303\241gil com divis\303\243o de projetos em micro-sprints semanais (Kanban/Jira/GitHub Projects); t\303\251cnica Pomodoro (25 min de foco / 5 min de pausa); feedback formativo imediato p\303\263s-entrega.\',\n      representacao:\n        \'Roteiros de laborat\303\263rio fracionados em checklists objetivos com caixas de sele\303\247\303\243o; disponibiliza\303\247\303\243o de starter kits e snippets comentados; linters visuais (Error Lens) no VS Code.\',\n      acaoExpressao:\n        \'Demonstra\303\247\303\243o progressiva por commits semanais de testes unit\303\241rios (TDD: red-green-refactor); aceita\303\247\303\243o de documenta\303\247\303\243o sintetizada em Markdown em vez de relat\303\263rios extensos; tempo estendido (+50%).\',\n      recursosTA: [\n        \'Quadro Kanban digital integrado ao Jira / GitHub Projects\',\n        \'Extens\303\265es de foco e linter no VS Code (Error Lens, Todo Tree, Pomodoro Timer)\',\n        \'Templates estruturados em Markdown para planos de teste\',\n        \'Fones com cancelamento ativo de ru\303\255do para sess\303\265es de programa\303\247\303\243o no LABIN\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o processual somativa por marcos parciais semanais entregues, mitigando o peso de uma \303\272nica prova final te\303\263rica ou entrega acumulada.\',\n    },\n  },\n  {\n    id: \'sol-tea\',\n    titulo: \'Transtorno do Espectro Autista (TEA)\',\n    condicao: \'Transtorno do Espectro Autista (TEA)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Sobrecarga sensorial decorrente de ru\303\255dos cont\303\255nuos de coolers, servidores e conversas paralelas nos laborat\303\263rios (LABIN/LADES), somada a desestabiliza\303\247\303\243o por mudan\303\247as imprevistas de rotina e inseguran\303\247a com instru\303\247\303\265es amb\303\255guas ou met\303\241foras.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Previsibilidade com cronograma detalhado de aulas pr\303\241ticas e testes de software publicado com anteced\303\252ncia no AVA Moodle; defini\303\247\303\243o expl\303\255cita de pap\303\251is em equipes de desenvolvimento.\',\n      representacao:\n        \'Roteiros de laborat\303\263rio estruturados em formato de checklist numerado sem ambiguidades; tabelas expl\303\255citas de casos de teste com entradas e sa\303\255das esperadas (parti\303\247\303\243o de equival\303\252ncia); fluxogramas visuais.\',\n      acaoExpressao:\n        \'Demonstra\303\247\303\243o pr\303\241tica atrav\303\251s de c\303\263digo funcional com su\303\255te de testes automatizados (JUnit/Selenium); tempo estendido (+50%); op\303\247\303\243o de sustenta\303\247\303\243o t\303\251cnica individual ou grava\303\247\303\243o ass\303\255ncrona (Loom).\',\n      recursosTA: [\n        \'Abafador de ru\303\255dos circum-aural (27dB+) para uso nos laborat\303\263rios de computa\303\247\303\243o\',\n        \'Cart\303\243o de pausa sensorial para autorregula\303\247\303\243o discreta\',\n        \'Roteiros t\303\251cnicos estruturados no AVA Moodle com crit\303\251rios objetivos de aceite\',\n        \'Ambiente de bancada reservado com ilumina\303\247\303\243o est\303\241vel e menor tr\303\241fego de pessoas\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o pr\303\241tica em laborat\303\263rio com crit\303\251rios anal\303\255ticos expl\303\255citos (Definition of Done), sem press\303\243o de comunica\303\247\303\243o informal desestruturada.\',\n    },\n  },\n  {\n    id: \'sol-ansiedade\',\n    titulo: \'Transtornos de ansiedade (generalizada, f\303\263bico-ansiosos, p\303\242nico, outros)\',\n    condicao: \'Transtornos de ansiedade (generalizada, f\303\263bico-ansiosos, p\303\242nico, outros)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Bloqueio cognitivo e sintomas f\303\255sicos agudos (taquicardia, tremores) em apresenta\303\247\303\265es p\303\272blicas de semin\303\241rios, defesas de projetos de software perante a turma ou avalia\303\247\303\265es pr\303\241ticas cronometradas com press\303\243o temporal r\303\255gida.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Ambiente de laborat\303\263rio psicologicamente seguro e acolhedor; possibilidade de apresenta\303\247\303\243o em pequenos grupos ou grava\303\247\303\243o em v\303\255deo (screencast com Loom); media\303\247\303\243o pr\303\251via pelo professor regente e NAPNE.\',\n      representacao:\n        \'Disponibiliza\303\247\303\243o antecipada (48h) dos enunciados de laborat\303\263rio e rubricas avaliativas no Moodle para reduzir a ansiedade antecipat\303\263ria; exemplos de solu\303\247\303\265es esperadas.\',\n      acaoExpressao:\n        \'Tempo estendido (+50%) garantido em avalia\303\247\303\265es de c\303\263digo e testes; permiss\303\243o de pausas de 5-10 minutos para autorregula\303\247\303\243o fora do laborat\303\263rio; avalia\303\247\303\243o fracionada em etapas.\',\n      recursosTA: [\n        \'Software de grava\303\247\303\243o de tela (Loom / OBS Studio) para apresenta\303\247\303\243o ass\303\255ncrona\',\n        \'Rubricas anal\303\255ticas de avalia\303\247\303\243o disponibilizadas previamente no AVA Moodle\',\n        \'Espa\303\247o de viv\303\252ncia discente do campus dispon\303\255vel para pausas de regula\303\247\303\243o\',\n      ],\n      avaliacaoAcessivel:\n        \'Substitui\303\247\303\243o de bancas e semin\303\241rios abertos por apresenta\303\247\303\243o reservada para o docente ou envio de v\303\255deo gravado, preservando a mesma exig\303\252ncia t\303\251cnica da ementa.\',\n    },\n  },\n  {\n    id: \'sol-aprendizagem\',\n    titulo: \'Transtorno espec\303\255fico de aprendizagem (dislexia, disgrafia, discalculia)\',\n    condicao: \'Transtorno espec\303\255fico de aprendizagem (dislexia, disgrafia, discalculia)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Troca, espelhamento e omiss\303\243o de caracteres em sintaxes r\303\255gidas de linguagens de programa\303\247\303\243o (ponto-e-v\303\255rgula, par\303\252nteses, chaves, operadores l\303\263gicos); fadiga visual r\303\241pida na leitura de enunciados densos e logs extensos de testes.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Acolhimento pedag\303\263gico seguro que remove a puni\303\247\303\243o punitiva por erros mec\303\242nicos de sintaxe, valorizando a arquitetura, a corretude l\303\263gica e o racioc\303\255nio do algoritmo.\',\n      representacao:\n        \'Uso de fontes tipogr\303\241ficas especializadas (OpenDyslexic Mono, JetBrains Mono); realce colorido de delimitadores e operadores; diagramas visuais de fluxo de dados (Mermaid/UML).\',\n      acaoExpressao:\n        \'Permiss\303\243o de IDEs configuradas com linters visuais e autocompletar em tempo real; permiss\303\243o de leitor de tela / sintetizador de voz para enunciados; tempo estendido (+50%) e defesa oral da l\303\263gica.\',\n      recursosTA: [\n        \'Fontes acess\303\255veis OpenDyslexic Mono e Atkinson Hyperlegible instaladas na IDE\',\n        \'Extens\303\265es de linter visual no VS Code (Error Lens, Bracket Pair Colorizer, Prettier)\',\n        \'Sintetizador de voz / leitor de tela para leitura mediada de enunciados longos\',\n        \'Tabela de consulta de operadores l\303\263gicos e sintaxes de teste (JUnit/Selenium)\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o pr\303\241tica em laborat\303\263rio com IDE configurada e linter ativo; corre\303\247\303\243o focada no racioc\303\255nio e fluxo de processamento, sem preju\303\255zo por pequenas trocas de caracteres.\',\n    },\n  },\n  {\n    id: \'sol-def-intelectual\',\n    titulo: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',\n    condicao: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade na reten\303\247\303\243o de sequ\303\252ncias extensas de instru\303\247\303\265es abstratas e na compreens\303\243o de conceitos excessivamente te\303\263ricos desvinculados da experimenta\303\247\303\243o pr\303\241tica nos laborat\303\263rios de inform\303\241tica.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Aprendizagem mediada e contextualizada com exemplos pr\303\241ticos imediatos do cotidiano do campus; valoriza\303\247\303\243o dos sucessos intermedi\303\241rios com refor\303\247o pedag\303\263gico positivo pelo monitor de apoio.\',\n      representacao:\n        \'Fracionamento de instru\303\247\303\265es complexas em 2 a 3 passos objetivos por vez; suporte de esquemas visuais coloridos, fluxogramas simplificados e tutoriais passo a passo em v\303\255deo curto.\',\n      acaoExpressao:\n        \'Avalia\303\247\303\243o pr\303\241tica focada na execu\303\247\303\243o de tarefas t\303\251cnicas concretas (ex: rodar teste unit\303\241rio, identificar falha guiada); tempo ampliado (+100%); media\303\247\303\243o assistida de monitor.\',\n      recursosTA: [\n        \'Roteiros impressos com esquemas visuais passo a passo\',\n        \'Ambiente de desenvolvimento simplificado com atalhos de execu\303\247\303\243o pr\303\251-configurados\',\n        \'Apoio individualizado de monitor de acessibilidade pedag\303\263gica do NAPNE\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o formativa mediada com base em checklists concretos de tarefas pr\303\241ticas realizadas em laborat\303\263rio.\',\n    },\n  },\n  {\n    id: \'sol-toc\',\n    titulo: \'Transtorno obsessivo-compulsivo (TOC)\',\n    condicao: \'Transtorno obsessivo-compulsivo (TOC)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Perfeccionismo paralisante e rigidez cognitiva na refatora\303\247\303\243o de c\303\263digo, reda\303\247\303\243o de planos de teste e documenta\303\247\303\243o, gerando atrasos severos na entrega por checagens repetitivas exaustivas ou sofrimento desproporcional com avisos do compilador.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Defini\303\247\303\243o expl\303\255cita e pactuada de crit\303\251rios de \"conclu\303\255do\" (Definition of Done - DoD); estabelecimento de limites saud\303\241veis de refatora\303\247\303\243o para interromper ciclos de checagem repetitiva.\',\n      representacao:\n        \'Checklists com crit\303\251rios finitos e objetivos de aceite (ex: \"passou nos 3 testes unit\303\241rios principais = atividade finalizada com sucesso\"); sem regras abertas ou subjetivas.\',\n      acaoExpressao:\n        \'Prazos intermedi\303\241rios com margem de seguran\303\247a; avalia\303\247\303\243o com foco na funcionalidade e n\303\243o na perfei\303\247\303\243o estil\303\255stica; tempo estendido (+50%).\',\n      recursosTA: [\n        \'Pipelines de testes automatizados (CI/CD) que fornecem valida\303\247\303\243o objetiva e externa do c\303\263digo\',\n        \'Ferramenta de rastreio de tarefas (Jira / GitHub Projects) com etapas sequenciais limitadas\',\n        \'Temporizador para limitar o tempo de refatora\303\247\303\243o a blocos pr\303\251-determinados\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o baseada no cumprimento dos testes funcionais automatizados, liberando o estudante da necessidade de reescrever o c\303\263digo indefinidamente.\',\n    },\n  },\n  {\n    id: \'sol-misto-ansioso-depressivo\',\n    titulo: \'Transtorno misto ansioso e depressivo\',\n    condicao: \'Transtorno misto ansioso e depressivo\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Oscila\303\247\303\265es significativas de energia e motiva\303\247\303\243o aliadas a epis\303\263dios agudos de ansiedade de desempenho; desmotiva\303\247\303\243o diante de erros de compila\303\247\303\243o ou falhas em testes somada a medo paralisante de reprova\303\247\303\243o.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Acolhimento pedag\303\263gico seguro com escuta pelo professor e pelo NAPNE; pactua\303\247\303\243o de metas de pequeno porte para recomposi\303\247\303\243o gradual da autoefic\303\241cia acad\303\252mica; flexibilidade em situa\303\247\303\265es de crise.\',\n      representacao:\n        \'Materiais did\303\241ticos sintetizados e organizados no AVA Moodle; roteiros objetivos que evitam a sensa\303\247\303\243o de sobrecarga cognitiva ou volume inating\303\255vel de tarefas.\',\n      acaoExpressao:\n        \'Entregas fracionadas semanais; avalia\303\247\303\243o cont\303\255nua formativa que substitui provas de grande peso emocional; tempo estendido (+50%) em laborat\303\263rio.\',\n      recursosTA: [\n        \'Acesso ao AVA Moodle com possibilidade de envio flex\303\255vel em per\303\255odos de acompanhamento\',\n        \'Canal de comunica\303\247\303\243o reservado e direto com o docente regente e equipe do NAPNE\',\n        \'Calend\303\241rio visual de entregas com marcos graduais\',\n      ],\n      avaliacaoAcessivel:\n        \'Composi\303\247\303\243o da nota atrav\303\251s de m\303\272ltiplos pequenos exerc\303\255cios pr\303\241ticos de laborat\303\263rio, com feedback formativo e oportunidade de reenvio.\',\n    },\n  },\n  {\n    id: \'sol-depressao\',\n    titulo: \'Transtornos depressivos\',\n    condicao: \'Transtornos depressivos\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Lentifica\303\247\303\243o do processamento cognitivo, fadiga extrema e crises de anedonia/des\303\242nimo que comprometem a assiduidade e a energia necess\303\241ria para iniciar e manter projetos extensos de desenvolvimento de software.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Apoio tutorial pr\303\263ximo pelo docente e NAPNE; inclus\303\243o em duplas colaborativas acolhedoras (Pair Programming); celebra\303\247\303\243o e registro expl\303\255cito de cada avan\303\247o alcan\303\247ado.\',\n      representacao:\n        \'Grava\303\247\303\243o de aulas expositivas e disponibiliza\303\247\303\243o de roteiros de laborat\303\263rio no AVA Moodle para consulta em momentos de melhor disposi\303\247\303\243o energ\303\251tica.\',\n      acaoExpressao:\n        \'Aplica\303\247\303\243o do regime de Atividades Acompanhadas (Decreto-Lei n\302\272 1.044/1969 e ODP-IFTO) em fases agudas; flexibiliza\303\247\303\243o de cronogramas sem rebaixamento curricular; tempo estendido (+50%).\',\n      recursosTA: [\n        \'Ambiente Virtual de Aprendizagem Moodle para acesso ass\303\255ncrono aos conte\303\272dos e testes\',\n        \'Monitoria orientada pelo NAPNE Campus Para\303\255so para acompanhamento do cronograma\',\n        \'Canal de atendimento pedag\303\263gico individualizado\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o baseada na consolida\303\247\303\243o das compet\303\252ncias ao longo do semestre, permitindo prazos estendidos para conclus\303\243o de projetos pr\303\241ticos.\',\n    },\n  },\n  {\n    id: \'sol-epilepsia\',\n    titulo: \'Epilepsia e crises convulsivas\',\n    condicao: \'Epilepsia e crises convulsivas\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Fotossensibilidade a telas de monitores com taxas de atualiza\303\247\303\243o oscilantes ou brilho excessivo nos laborat\303\263rios (LABIN); fadiga f\303\255sica e necessidade de recupera\303\247\303\243o cognitiva p\303\263s-ictal ou preven\303\247\303\243o de crises causadas por estresse severo.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Ambiente de laborat\303\263rio calmo, sem estresse temporal punitivo; protocolo de primeiros socorros e seguran\303\247a em sa\303\272de j\303\241 alinhado com a equipe de enfermagem do campus.\',\n      representacao:\n        \'Monitores com filtro antirreflexo e taxa est\303\241vel de 60Hz+; configura\303\247\303\243o de temas de alto contraste com fundo escuro suave (modo s\303\251pia/escuro) sem elementos piscantes ou anima\303\247\303\265es r\303\241pidas.\',\n      acaoExpressao:\n        \'Pausas preventivas programadas a cada 45 minutos longe da tela; tempo ampliado (+50%) em pr\303\241ticas avaliativas; garantia de reposi\303\247\303\243o de avalia\303\247\303\265es em caso de crise.\',\n      recursosTA: [\n        \'Monitores do laborat\303\263rio configurados com filtros de luz azul e taxa est\303\241vel de atualiza\303\247\303\243o\',\n        \'Temas de IDE com paleta de cores suave sem flashes ou contrastes estrobosc\303\263picos\',\n        \'Assento em bancada de f\303\241cil acesso e circula\303\247\303\243o segura no laborat\303\263rio\',\n      ],\n      avaliacaoAcessivel:\n        \'Garantia de reposi\303\247\303\243o de qualquer atividade avaliativa interrompida por crise convulsiva, com tempo integral recomposto e ambiente tranquilo.\',\n    },\n  },\n  {\n    id: \'sol-baixa-visao-sql\',\n    titulo: \'Defici\303\252ncia Visual / Baixa Vis\303\243o Severa ou Cegueira\',\n    condicao: \'Baixa Vis\303\243o Severa, Retinopatia, Glaucoma ou Cegueira\',\n    nivelSugerido: \'Superior TI\',\n    descricaoProblema:\n      \'Diagramas visuais de Modelos de Dados (MER/UML) em imagens rasterizadas (.png/.jpg) s\303\243o completamente inacess\303\255veis a leitores de tela em disciplinas como Banco de Dados e Engenharia de Software.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Envolvimento em projetos reais de modelagem de dados e sistemas corporativos com foco no racioc\303\255nio abstrato e arquitetura l\303\263gica.\',\n      representacao:\n        \'Substitui\303\247\303\243o de diagramas visuais por linguagens declarativas acess\303\255veis (DBML / YAML / scripts SQL DDL comentados) e audiodescri\303\247\303\243o em sala.\',\n      acaoExpressao:\n        \'Intera\303\247\303\243o com o sistema via terminal CLI e clientes acess\303\255veis ao leitor NVDA; entrega de scripts e documenta\303\247\303\243o em Markdown acess\303\255vel; tempo estendido (+50%).\',\n      recursosTA: [\n        \'Leitor de telas NVDA / Orca com voz pt-BR configurada\',\n        \'Terminal com alto contraste invertido e fonte monoespa\303\247ada 22pt+\',\n        \'Monitor de 27 a 32 polegadas com bra\303\247o articulado pantogr\303\241fico\',\n        \'Documenta\303\247\303\243o t\303\251cnica em Markdown ou LaTeX acess\303\255vel\',\n      ],\n      avaliacaoAcessivel:\n        \'Resolu\303\247\303\243o de problemas de consultas anal\303\255ticas e modelagem via terminal de testes com tempo estendido e defesa oral.\',\n    },\n  },\n  {\n    id: \'sol-motor-programacao\',\n    titulo: \'Defici\303\252ncia F\303\255sica / Dificuldade Motora em Laborat\303\263rio\',\n    condicao: \'Paralisia Cerebral, Espasticidade, Tetraparesia, LER/DORT ou Tremores\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Lentid\303\243o ou dor muscular na digita\303\247\303\243o em teclado convencional durante aulas pr\303\241ticas de programa\303\247\303\243o e testes de software cronometrados no laborat\303\263rio.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Ado\303\247\303\243o da metodologia de Pair Programming (programa\303\247\303\243o em pares): o aluno atua com destaque como copiloto e arquiteto da l\303\263gica do sistema.\',\n      representacao:\n        \'Roteiros de laborat\303\263rio diagramados com diagramas de fluxo de dados (Mermaid/UML) e snippets de c\303\263digo comentados dispon\303\255veis antecipadamente no Moodle.\',\n      acaoExpressao:\n        \'Tempo estendido (+50%), ferramentas de autocompletar inteligente (Copilot/Snippets), entrega de c\303\263digo versionado no Git e defesa oral do algoritmo.\',\n      recursosTA: [\n        \'Teclados mec\303\242nicos de ativa\303\247\303\243o leve com colmeia acr\303\255lica\',\n        \'Mouse ergon\303\264mico vertical ou trackball\',\n        \'Extens\303\265es de atalhos e autocompletar na IDE (VS Code)\',\n        \'Suporte ergon\303\264mico articulado para apoio dos bra\303\247os\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o formativa cont\303\255nua baseada em commits no GitHub e demonstra\303\247\303\243o funcional em vez de digita\303\247\303\243o em tempo cronometrado.\',\n    },\n  },\n  {\n    id: \'sol-surdez-ti\',\n    titulo: \'Surdez / Defici\303\252ncia Auditiva em Computa\303\247\303\243o\',\n    condicao: \'Surdez, Defici\303\252ncia Auditiva Bilateral\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Aulas expositivas r\303\241pidas e termos t\303\251cnicos de inform\303\241tica e engenharia de software em ingl\303\252s sem tradutor int\303\251rprete de Libras ou legendagem dificultam o acompanhamento.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Valoriza\303\247\303\243o do estudante em projetos de acessibilidade digital e design visual de interfaces web e m\303\263veis.\',\n      representacao:\n        \'Disponibiliza\303\247\303\243o antecipada de slides e c\303\263digos; presen\303\247a de Tradutor Int\303\251rprete de Libras com vocabul\303\241rio t\303\251cnico de TI.\',\n      acaoExpressao:\n        \'Submiss\303\243o de c\303\263digo documentado, diagramas arquiteturais e relat\303\263rios textuais ou sinalizados em Libras gravados em v\303\255deo.\',\n      recursosTA: [\n        \'Softwares de transcri\303\247\303\243o de \303\241udio em tempo real e legendagem autom\303\241tica\',\n        \'Gloss\303\241rio de sinais de Libras para termos computacionais (algoritmo, banco de dados, rede)\',\n        \'Fones com amplifica\303\247\303\243o sonora para estudantes com res\303\255duo auditivo\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\265es pr\303\241ticas com apoio de int\303\251rprete de Libras para esclarecimento de d\303\272vidas e tempo estendido.\',\n    },\n  },\n  {\n    id: \'sol-hipotese-sem-laudo\',\n    titulo: \'Hip\303\263tese Diagn\303\263stica / Sem Laudo Fechado (Portaria MEC n\302\272 421/2026)\',\n    condicao: \'Hip\303\263tese de neurodiverg\303\252ncia ou transtorno em processo investigativo pelo NAPNE\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade acad\303\252mica persistente em sala ou laborat\303\263rio de TI sem que o estudante possua laudo pericial formal fechado, com risco indevido de atraso na concess\303\243o de apoios.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Garantia legal imediata: a Portaria MEC n\302\272 421/2026 assegura que o PEI independe de laudo m\303\251dico, focando na acolhida pedag\303\263gica e redu\303\247\303\243o do estresse escolar.\',\n      representacao:\n        \'Diversifica\303\247\303\243o multissensorial dos conte\303\272dos (roteiros em t\303\263picos, recursos visuais, esquemas e \303\241udio explicativo); disponibiliza\303\247\303\243o pr\303\251via de materiais antes das aulas de laborat\303\263rio.\',\n      acaoExpressao:\n        \'Tempo estendido (+50%) em todas as avalia\303\247\303\265es, toler\303\242ncia a erros pontuais de ortografia de c\303\263digo, permiss\303\243o de consulta orientada e possibilidade de defesa oral da l\303\263gica.\',\n      recursosTA: [\n        \'Tempo estendido (+50%) em provas e projetos pr\303\241ticos\',\n        \'Extens\303\265es de aux\303\255lio visual e linter de c\303\263digo na IDE\',\n        \'Formul\303\241rio de observa\303\247\303\243o pedag\303\263gica cont\303\255nua do NAPNE Campus Para\303\255so\',\n        \'Enunciados com metodologia DUA em formato claro e direto\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o diagn\303\263stica e formativa processual com feedback imediato, sem depend\303\252ncia de prova \303\272nica cronometrada.\',\n    },\n  },\n];\n\n// Gerador R\303\241pido de Novo PEI Completo para Aluno Cadastrado (Suporta m\303\272ltiplas neurodiverg\303\252ncias combinadas)\nexport function gerarNovoPeiCompleto(dados: {\n  nome: string;\n  matricula: string;\n  idade: string;\n  curso: string;\n  disciplina: string;\n  modulo: string;\n  condicao: string;"
