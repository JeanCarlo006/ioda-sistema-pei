              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Compreens\303\243o da l\303\263gica computacional, estrutura\303\247\303\243o correta do algoritmo e funcionamento esperado do sistema, sem penaliza\303\247\303\243o por velocidade de digita\303\247\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
