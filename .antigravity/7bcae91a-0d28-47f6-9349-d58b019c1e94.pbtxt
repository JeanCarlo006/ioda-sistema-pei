        target_content: "// 4. CASO ENSINO SUPERIOR EM TI - DUPLA EXCEPCIONALIDADE (TDAH + ALTAS HABILIDADES/SUPERDOTA\303\207\303\203O)\nexport const casoLarissaSuperior: PEICompleto = {\n  id: \'SUP-BSI-07\',\n  cabecalho: {\n    estudante: \'Larissa Menezes Costa\',\n    codigo_matricula: \'2024.1.BSI.031\',\n    idade: \'20 anos\',\n    curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\',\n    componente_curricular: \'Engenharia de Software e Programa\303\247\303\243o Orientada a Objetos\',\n    modulo_periodo: \'3\302\272 Semestre / Noturno\',\n    data_elaboracao: \'2026-10-27\',\n    docente_regente: \'Prof\302\252. Dra. Helena Bittencourt (Docente de Engenharia de Software)\',\n    docente_aee: \'Prof\302\252. Renata Cavalcanti (Especialista em Educa\303\247\303\243o Especial / NAPNE)\',\n    profissional_apoio: \'Thiago Martins (Monitor de Acessibilidade Digital e Laborat\303\263rio)\',\n    coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n  },\n  historico_napne: {\n    status_diagnostico: \'confirmado\',\n    categoria_neurodivergencia: \'TDAH Combinado + Altas Habilidades / Superdota\303\247\303\243o (Dupla Excepcionalidade)\',\n    cid_ou_hipotese: \'F90.0 (TDAH) + Z73.0 / Altas Habilidades com laudo neuropsicol\303\263gico\',\n    breve_historico_clinico_familiar:\n      \'Estudante do Bacharelado em Sistemas de Informa\303\247\303\243o no Campus Para\303\255so (integrante dos 14 estudantes acompanhados no Ensino Superior). Apresenta laudo neuropsicol\303\263gico multidisciplinar com diagn\303\263stico de Dupla Excepcionalidade: TDAH tipo combinado associado a Altas Habilidades / Superdota\303\247\303\243o na \303\241rea l\303\263gica e tecnol\303\263gica. Possui velocidade de processamento l\303\263gico muito acima da m\303\251dia e hiperfoco criativo, por\303\251m sofre com desregula\303\247\303\243o nas fun\303\247\303\265es executivas (procrastina\303\247\303\243o, dificuldade de iniciar projetos com instru\303\247\303\265es gen\303\251ricas, desorganiza\303\247\303\243o com prazos extensos e esquecimento de etapas documentais).\',\n    descricao_condicao_especifica:\n      \'Tende a se desmotivar e dispersar rapidamente quando o conte\303\272do \303\251 excessivamente repetitivo ou expositivo passivo. Quando o projeto tem entregas espa\303\247adas de 2 meses, deixa para os \303\272ltimos dias, gerando crises de sobrecarga e ansiedade, apesar de entregar solu\303\247\303\265es de software sofisticadas.\',\n    informacoes_dos_pais:\n      \'Estudante aut\303\264noma que busca o apoio do NAPNE do Campus Para\303\255so para aprender a estruturar rotinas de estudo e metodologias \303\241geis de gest\303\243o de tempo aplicadas aos projetos de programa\303\247\303\243o.\',\n  },"
        replacement_content: "// 4. CASO ENSINO SUPERIOR EM TI - DUPLA EXCEPCIONALIDADE (TDAH + ALTAS HABILIDADES/SUPERDOTA\303\207\303\203O)\nexport const casoLarissaSuperior: PEICompleto = {\n  id: \'SUP-BSI-07\',\n  cabecalho: {\n    estudante: \'Estudante BSI-04 (Superior TI)\',\n    codigo_matricula: \'2024.1.BSI.031\',\n    idade: \'20 anos\',\n    curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\',\n    componente_curricular: \'Engenharia de Software e Programa\303\247\303\243o Orientada a Objetos\',\n    modulo_periodo: \'3\302\272 Semestre / Noturno\',\n    data_elaboracao: \'2026-10-27\',\n    docente_regente: \'Prof\302\252. Dra. Helena Bittencourt (Docente de Engenharia de Software)\',\n    docente_aee: \'Prof\302\252. Renata Cavalcanti (Especialista em Educa\303\247\303\243o Especial / NAPNE)\',\n    profissional_apoio: \'Monitor de Acessibilidade Digital e Laborat\303\263rio\',\n    coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n  },\n  historico_napne: {\n    status_diagnostico: \'confirmado\',\n    categoria_neurodivergencia: \'TDAH Combinado + Altas Habilidades / Superdota\303\247\303\243o (Dupla Excepcionalidade)\',\n    cid_ou_hipotese: \'Perfil com laudo de neurodiverg\303\252ncia arquivado no NAPNE\',\n    breve_historico_clinico_familiar:\n      \'Estudante do Bacharelado em Sistemas de Informa\303\247\303\243o no Campus Para\303\255so (integrante dos 14 estudantes acompanhados no Ensino Superior). Apresenta perfil de Dupla Excepcionalidade: velocidade de processamento l\303\263gico muito acima da m\303\251dia e hiperfoco criativo, associado a desafios na fun\303\247\303\243o executiva e planejamento de prazos longos.\',\n    descricao_condicao_especifica:\n      \'Tend\303\252ncia a sobrecarga quando projetos semestrais possuem prazos \303\272nicos e distantes. Beneficia-se de entregas modulares curtas (micro-sprints no GitHub/Kanban) e tarefas com objetivos expl\303\255citos.\',\n    informacoes_dos_pais:\n      \'Estudante universit\303\241rio aut\303\264nomo com acompanhamento pedag\303\263gico pelo NAPNE Campus Para\303\255so.\',\n  },"
