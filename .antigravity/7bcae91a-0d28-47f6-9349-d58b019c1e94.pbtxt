    content: "stify-between\">\n                        <span className=\"font-bold text-slate-900 truncate\">{sol.titulo.split(\'/\')[0]}</span>\n                        <span className=\"text-[9px] text-slate-500 font-mono shrink-0 ml-1\">\n                          {sol.nivelSugerido}\n                        </span>\n                      </div>\n                      <p className=\"text-[10px] text-slate-500 mt-0.5 truncate\">\n                        {sol.condicao}\n                      </p>\n                    </button>\n                  ))}\n                </div>\n              </div>\n\n              {/* Barreiras no Laborat\303\263rio de TI */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n                <label className=\"block text-xs font-bold text-slate-800 uppercase tracking-wider mb-1\">\n                  Barreiras Observadas no Laborat\303\263rio de TI / Contexto Escolar\n                </label>\n                <textarea\n                  value={condicao}\n                  onChange={(e) => setCondicao(e.target.value)}\n                  rows={2}\n                  placeholder=\"Descreva as barreiras metodol\303\263gicas, comunicacionais ou tecnol\303\263gicas observadas em aula pr\303\241tica\"\n                  className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                />\n              </div>\n\n              {/* Potencialidades e Recursos de TA */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                  <label className=\"block text-xs font-bold text-slate-800 uppercase tracking-wider mb-1\">\n                    Potencialidades & Interesses em TI\n                  </label>\n                  <textarea\n                    value={potencialidades}\n                    onChange={(e) => setPotentialidades(e.target.value)}\n                    rows={2}\n                    placeholder=\"Racioc\303\255nio l\303\263gico, capacidade de abstra\303\247\303\243o, interesse em linguagens de programa\303\247\303\243o, jogos\"\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                  />\n                </div>\n\n                <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                  <label className=\"block text-xs font-bold text-slate-800 uppercase tracking-wider mb-1\">\n                    Recursos de Tecnologia Assistiva / Acomoda\303\247\303\265es\n                  </label>\n                  <textarea\n                    value={assistiveTech}\n                    onChange={(e) => setAssistiveTech(e.target.value)}\n                    rows={2}\n                    placeholder=\"Ex: Teclado ergon\303\264mico, tempo estendido (+50%), fonte OpenDyslexic, leitor NVDA, abafadores\"\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                  />\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* ============================================================== */}\n          {/* ETAPA 4: REVIS\303\203O SINT\303\211TICA & GERA\303\207\303\203O IODA AI                   */}\n          {/* ============================================================== */}\n          {currentStep === 4 && (\n            <div className=\"space-y-4 animate-fadeIn\">\n              <div className=\"p-3 bg-emerald-50 border border-emerald-200 rounded-xl flex items-start gap-2.5\">\n                <Sparkles className=\"w-4 h-4 text-emerald-800 shrink-0 mt-0.5\" />\n                <div className=\"text-xs text-emerald-950\">\n                  <strong>Etapa 4 de 4 \302\267 Revis\303\243o e Gera\303\247\303\243o Inteligente:</strong> Confira os dados sintetizados abaixo. O agente Ioda ir\303\241 estruturar o PEI oficial completo com 8 blocos, flexibiliza\303\247\303\243o DUA 3.0 e metas SMART para computa\303\247\303\243o.\n                </div>\n              </div>\n\n              {/* Review Card */}\n              <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-3\">\n                <div className=\"flex items-center justify-between pb-2 border-b border-slate-200\">\n                  <div>\n                    <h4 className=\"text-sm font-bold text-slate-900\">{nome || \'Nome do Estudante\'}</h4>\n                    <span className=\"text-xs text-slate-500 font-mono\">\n                      Matr\303\255cula: {matricula || \'Gerada pelo sistema\'} \302\267 Idade: {idade}\n                    </span>\n                  </div>\n                  <span className=\"text-xs font-bold bg-emerald-100 text-emerald-900 px-2.5 py-1 rounded-full\">\n                    {perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\'}\n                  </span>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\">\n                  <div>\n                    <span className=\"text-slate-500 font-medium block\">Curso & Per\303\255odo:</span>\n                    <span className=\"text-slate-900 font-bold\">{curso} ({modulo})</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 font-medium block\">Disciplina de TI:</span>\n                    <span className=\"text-slate-900 font-bold text-emerald-800\">{disciplina}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 font-medium block\">Situa\303\247\303\243o Diagn\303\263stica:</span>\n                    <span className=\"font-semibold text-slate-800\">\n                      {statusDiagnostico === \'em_investigacao_hipotese\'\n                        ? \'Sem Laudo / Hip\303\263tese em Investiga\303\247\303\243o (Portaria MEC 421/2026)\'\n                        : \'Diagn\303\263stico Confirmado em Prontu\303\241rio\'}\n                    </span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 font-medium block\">Docente Respons\303\241vel:</span>\n                    <span className=\"text-slate-900 font-semibold\">{docenteRegente}</span>\n                  </div>\n                </div>\n\n                <div className=\"pt-2 border-t border-slate-200 text-xs space-y-1.5\">\n                  <div>\n                    <span className=\"text-slate-500 font-medium\">Barreiras Mapeadas: </span>\n                    <span className=\"text-slate-800\">{condicao || \'Barreiras de laborat\303\263rio a serem amenizadas com DUA 3.0.\'}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 font-medium\">Recursos de Tecnologia Assistiva: </span>\n                    <span className=\"text-slate-800 font-medium\">{assistiveTech || \'Tempo ampliado (+50%) e acessibilidade na IDE.\'}</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Pedagogical Guarantee Callout */}\n              <div className=\"p-3 bg-blue-50/60 border border-blue-200 rounded-xl text-xs text-blue-950 flex items-start gap-2.5\">\n                <ShieldCheck className=\"w-4 h-4 text-blue-700 shrink-0 mt-0.5\" />\n                <span>\n                  <strong>R\303\251gua de Coer\303\252ncia Curricular:</strong> A compet\303\252ncia t\303\251cnica essencial da ementa de {disciplina} ser\303\241 mantida na \303\255ntegra. O agente Ioda flexibilizar\303\241 os formatos de representa\303\247\303\243o, engajamento e vias de avalia\303\247\303\243o (DUA 3.0) sem rebaixamento cognitivo.\n                </span>\n              </div>\n\n              {/* Generation Progress Display */}\n              {isGenerating && (\n                <div className=\"p-4 bg-emerald-50 border-2 border-emerald-300 rounded-xl flex items-center gap-3 animate-pulse\">\n                  <Loader2 className=\"w-5 h-5 text-emerald-800 animate-spin shrink-0\" />\n                  <div className=\"text-xs\">\n                    <span className=\"font-bold text-emerald-950 block text-sm\">\n                      Agente Ioda sintetizando PEI para {perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico\'}...\n                    </span>\n                    <span className=\"text-emerald-800 font-medium mt-0.5 block\">{stepMessage}</span>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* FOOTER ACTIONS (Wizard Navigation) */}\n        <div className=\"pt-3 border-t border-slate-100 flex items-center justify-between shrink-0 bg-white\">\n          {/* Back button or step indicator */}\n          <div>\n            {currentStep > 1 && (\n              <button\n                type=\"button\"\n                onClick={() => setCurrentStep((prev) => (prev > 1 ? ((prev - 1) as any) : prev))}\n                disabled={isGenerating}\n                className=\"inline-flex items-center gap-1.5 px-3.5 py-2 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 text-xs transition-colors cursor-pointer disabled:opacity-50\"\n              >\n                <ArrowLeft className=\"w-3.5 h-3.5\" />\n                <span>Voltar</span>\n              </button>\n            )}\n            {currentStep === 1 && (\n              <button\n                type=\"button\"\n                onClick={onClose}\n                disabled={isGenerating}\n                className=\"px-3.5 py-2 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 text-xs transition-colors cursor-pointer disabled:opacity-50\"\n              >\n                Cancelar\n              </button>\n            )}\n          </div>\n\n          {/* Forward / Generate Buttons */}\n          <div className=\"flex items-center gap-2\">\n            {currentStep < 4 ? (\n              <button\n                type=\"button\"\n                onClick={() => {\n                  if (currentStep === 2 && !isStep2Valid) return;\n                  setCurrentStep((prev) => (prev < 4 ? ((prev + 1) as any) : prev));\n                }}\n                disabled={currentStep === 2 && !isStep2Valid}\n                className=\"inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg text-xs transition-colors cursor-pointer disabled:opacity-50 shadow-xs\"\n              >\n                <span>Avan\303\247ar</span>\n                <ArrowRight className=\"w-3.5 h-3.5\" />\n              </button>\n            ) : (\n              <button\n                type=\"button\"\n                onClick={handleFinalSubmit}\n                disabled={isGenerating || !nome.trim()}\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg text-xs transition-colors cursor-pointer disabled:opacity-50 shadow-sm\"\n              >\n                {isGenerating ? (\n                  <>\n                    <Loader2 className=\"w-4 h-4 animate-spin\" />\n                    <span>Gerando PEI Oficial...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4 text-emerald-200\" />\n                    <span>Gerar PEI Completo com Ioda AI</span>\n                  </>\n                )}\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 1068
    num_bytes: 56228
    content_offset: 45000
    line_range_bytes: 56228
  }
}
