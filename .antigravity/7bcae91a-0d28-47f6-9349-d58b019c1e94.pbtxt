              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id: \'sol-ansiedade\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    titulo: \'Transtornos de ansiedade (generalizada, f\303\263bico-ansiosos, p\303\242nico, outros)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    condicao: \'Transtornos de ansiedade (generalizada, f\303\263bico-ansiosos, p\303\242nico, outros)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    nivelSugerido: \'Ambos\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    descricaoProblema:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Bloqueio cognitivo e sintomas f\303\255sicos agudos (taquicardia, tremores) em apresenta\303\247\303\265es p\303\272blicas de semin\303\241rios, defesas de projetos de software perante a turma ou avalia\303\247\303\265es pr\303\241ticas cronometradas com press\303\243o temporal r\303\255gida.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    remediosSugeridos: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      engajamento:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Ambiente de laborat\303\263rio psicologicamente seguro e acolhedor; possibilidade de apresenta\303\247\303\243o em pequenos grupos ou grava\303\247\303\243o em v\303\255deo (screencast com Loom); media\303\247\303\243o pr\303\251via pelo professor regente e NAPNE.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      representacao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Disponibiliza\303\247\303\243o antecipada (48h) dos enunciados de laborat\303\263rio e rubricas avaliativas no Moodle para reduzir a ansiedade antecipat\303\263ria; exemplos de solu\303\247\303\265es esperadas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      acaoExpressao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Tempo estendido (+50%) garantido em avalia\303\247\303\265es de c\303\263digo e testes; permiss\303\243o de pausas de 5-10 minutos para autorregula\303\247\303\243o fora do laborat\303\263rio; avalia\303\247\303\243o fracionada em etapas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      recursosTA: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Software de grava\303\247\303\243o de tela (Loom / OBS Studio) para apresenta\303\247\303\243o ass\303\255ncrona\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Rubricas anal\303\255ticas de avalia\303\247\303\243o disponibilizadas previamente no AVA Moodle\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Espa\303\247o de viv\303\252ncia discente do campus dispon\303\255vel para pausas de regula\303\247\303\243o\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      avaliacaoAcessivel:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Substitui\303\247\303\243o de bancas e semin\303\241rios abertos por apresenta\303\247\303\243o reservada para o docente ou envio de v\303\255deo gravado, preservando a mesma exig\303\252ncia t\303\251cnica da ementa.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    guiaPratico: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      passo_a_passo_explicacao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Evite chamadas orais surpresa (\"cold calling\") durante a explica\303\247\303\243o. Antecipe no in\303\255cio da aula exatamente o que ser\303\241 cobrado e mostre um exemplo resolvido completo para eliminar o medo do desconhecido.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      divisao_tarefa_chunking: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 1: Validar primeiro um exemplo guiado de baixa complexidade sem valer nota para ganhar seguran\303\247a.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 2: Desenvolver o requisito principal do exerc\303\255cio com consulta livre \303\240 documenta\303\247\303\243o e material de apoio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 3: Entregar o c\303\263digo no reposit\303\263rio ou apresentar em v\303\255deo curto gravado (Loom) sem exposi\303\247\303\243o p\303\272blica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      avaliacao_pratica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Avalia\303\247\303\243o em etapas ao longo do bimestre em vez de uma \303\272nica prova de alto risco. Conceda +50% de tempo adicional sem cron\303\264metro regressivo vis\303\255vel na tela e aceite defesa em hor\303\241rio de atendimento individual.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      manejo_e_acolhimento:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Se o aluno apresentar branco cognitivo, tremores ou respira\303\247\303\243o curta durante uma pr\303\241tica, valide com calma (\"Est\303\241 tudo bem, seu progresso at\303\251 aqui j\303\241 est\303\241 salvo\"), permita beber \303\241gua ou respirar fora do laborat\303\263rio e retome a avalia\303\247\303\243o de onde parou.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id: \'sol-aprendizagem\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    titulo: \'Transtorno espec\303\255fico de aprendizagem (dislexia, disgrafia, discalculia)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    condicao: \'Transtorno espec\303\255fico de aprendizagem (dislexia, disgrafia, discalculia)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    nivelSugerido: \'Ambos\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    descricaoProblema:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Troca, espelhamento e omiss\303\243o de caracteres em sintaxes r\303\255gidas de linguagens de programa\303\247\303\243o (ponto-e-v\303\255rgula, par\303\252nteses, chaves, operadores l\303\263gicos); fadiga visual r\303\241pida na leitura de enunciados densos e logs extensos de testes.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    remediosSugeridos: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      engajamento:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Acolhimento pedag\303\263gico seguro que remove a puni\303\247\303\243o punitiva por erros mec\303\242nicos de sintaxe, valorizando a arquitetura, a corretude l\303\263gica e o racioc\303\255nio do algoritmo.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      representacao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Uso de fontes tipogr\303\241ficas especializadas (OpenDyslexic Mono, JetBrains Mono); realce colorido de delimitadores e operadores; diagramas visuais de fluxo de dados (Mermaid/UML).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      acaoExpressao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Permiss\303\243o de IDEs configuradas com linters visuais e autocompletar em tempo real; permiss\303\243o de leitor de tela / sintetizador de voz para enunciados; tempo estendido (+50%) e defesa oral da l\303\263gica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      recursosTA: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Fontes acess\303\255veis OpenDyslexic Mono e Atkinson Hyperlegible instaladas na IDE\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Extens\303\265es de linter visual no VS Code (Error Lens, Bracket Pair Colorizer, Prettier)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Sintetizador de voz / leitor de tela para leitura mediada de enunciados longos\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Tabela de consulta de operadores l\303\263gicos e sintaxes de teste (JUnit/Selenium)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      avaliacaoAcessivel:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Avalia\303\247\303\243o pr\303\241tica em laborat\303\263rio com IDE configurada e linter ativo; corre\303\247\303\243o focada no racioc\303\255nio e fluxo de processamento, sem preju\303\255zo por pequenas trocas de caracteres.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    guiaPratico: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      passo_a_passo_explicacao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Associe sempre o c\303\263digo textual a um fluxograma visual ou diagrama de blocos no quadro. Destaque com cores diferentes onde abrem e fecham chaves/par\303\252nteses e leia em voz alta os enunciados das quest\303\265es.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      divisao_tarefa_chunking: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 1: Desenhar ou montar a l\303\263gica do algoritmo em fluxograma/pseudoc\303\263digo antes de lidar com a sintaxe da linguagem.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 2: Codificar no VS Code utilizando folha de consulta r\303\241pida (Cheat Sheet) de comandos e autocompletar ativo.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 3: Testar o programa com apoio do formatador autom\303\241tico (Prettier) e explicar oralmente a l\303\263gica ao professor.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      avaliacao_pratica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Provas pr\303\241ticas sempre no computador com corretor sint\303\241tico ativo (nunca exigir c\303\263digo escrito \303\240 m\303\243o no papel). Desconsidere trocas ortogr\303\241ficas em nomes de vari\303\241veis e avalie 100% pela l\303\263gica algor\303\255tmica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      manejo_e_acolhimento:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Quando o c\303\263digo n\303\243o compilar por um erro simples de digita\303\247\303\243o (ex: invers\303\243o de letras ou falta de ponto-e-v\303\255rgula), aponte diretamente a linha para o estudante corrigir sem descontar nota, mantendo o foco no racioc\303\255nio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    id: \'sol-def-intelectual\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    titulo: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    condicao: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    nivelSugerido: \'Ambos\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    descricaoProblema:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Dificuldade na reten\303\247\303\243o de sequ\303\252ncias extensas de instru\303\247\303\265es abstratas e na compreens\303\243o de conceitos excessivamente te\303\263ricos desvinculados da experimenta\303\247\303\243o pr\303\241tica nos laborat\303\263rios de inform\303\241tica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    remediosSugeridos: {"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      engajamento:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Aprendizagem mediada e contextualizada com exemplos pr\303\241ticos imediatos do cotidiano do campus; valoriza\303\247\303\243o dos sucessos intermedi\303\241rios com refor\303\247o pedag\303\263gico positivo pelo monitor de apoio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      representacao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Fracionamento de instru\303\247\303\265es complexas em 2 a 3 passos objetivos por vez; suporte de esquemas visuais coloridos, fluxogramas simplificados e tutoriais passo a passo em v\303\255deo curto.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      acaoExpressao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Avalia\303\247\303\243o pr\303\241tica focada na execu\303\247\303\243o de tarefas t\303\251cnicas concretas (ex: rodar teste unit\303\241rio, identificar falha guiada); tempo ampliado (+100%); media\303\247\303\243o assistida de monitor.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      recursosTA: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Roteiros impressos com esquemas visuais passo a passo\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Ambiente de desenvolvimento simplificado com atalhos de execu\303\247\303\243o pr\303\251-configurados\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Apoio individualizado de monitor de acessibilidade pedag\303\263gica do NAPNE\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      avaliacaoAcessivel:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Avalia\303\247\303\243o formativa mediada com base em checklists concretos de tarefas pr\303\241ticas realizadas em laborat\303\263rio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    guiaPratico: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      passo_a_passo_explicacao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Transforme abstra\303\247\303\265es em situa\303\247\303\265es concretas do dia a dia (ex: comparar um Banco de Dados a uma ficha de cadastro da biblioteca do campus). Demonstre a a\303\247\303\243o primeiro na m\303\241quina do aluno e pe\303\247a para ele repetir logo em seguida.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      divisao_tarefa_chunking: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 1: Seguir um guia visual ilustrado com capturas de tela contendo apenas 2 a 3 comandos por bloco.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 2: Preencher as lacunas de um c\303\263digo pr\303\251-estruturado (scaffolding) com media\303\247\303\243o do monitor ou colega tutor.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 3: Executar o sistema na pr\303\241tica e demonstrar oralmente para o professor o que o programa faz.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      avaliacao_pratica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Avalia\303\247\303\243o cont\303\255nua por portf\303\263lio das atividades pr\303\241ticas realizadas em laborat\303\263rio com media\303\247\303\243o pedag\303\263gica, instru\303\247\303\265es curtas e tempo ampliado (+100%).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      manejo_e_acolhimento:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Se o aluno demonstrar frustra\303\247\303\243o diante de uma tarefa abstrata, volte um passo para o exemplo concreto ilustrado, elogie o que j\303\241 foi constru\303\255do e fa\303\247a o pr\303\263ximo passo em conjunto (modelagem guiada).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "  },"
