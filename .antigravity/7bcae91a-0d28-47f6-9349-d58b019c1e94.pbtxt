      arguments_json: "{\"Description\":\"Integrate ConfirmDeleteModal and PEI deletion logic into App.tsx\", \"Instruction\":\"Add ConfirmDeleteModal, peiToDelete state, delete handlers, and pass onRequestDeletePei to child components in App.tsx\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":24, \"ReplacementContent\":\"import { CampusStatsModal } from \'./components/CampusStatsModal\';\\nimport { ConfirmDeleteModal } from \'./components/ConfirmDeleteModal\';\\nimport { ILovePeiHub } from \'./components/ILovePeiHub\';\\nimport { ArrowLeft, Trash2, CheckCircle2 } from \'lucide-react\';\\n\\nexport default function App() {\\n  const [studentsList, setStudentsList] = useState<PEICompleto[]>(todosOsCasos);\\n  const [activePei, setActivePei] = useState<PEICompleto>(todosOsCasos[0]); // INF-01 - T\303\251cnico em Inform\303\241tica\\n  const [activeTab, setActiveTab] = useState<string>(\'hub\');\\n  const [isAddStudentOpen, setIsAddStudentOpen] = useState<boolean>(false);\\n  const [isSolutionBankOpen, setIsSolutionBankOpen] = useState<boolean>(false);\\n  const [isCampusStatsOpen, setIsCampusStatsOpen] = useState<boolean>(false);\\n  const [peiToDelete, setPeiToDelete] = useState<PEICompleto | null>(null);\\n  const [deleteNotice, setDeleteNotice] = useState<string | null>(null);\", \"StartLine\":12, \"TargetContent\":\"import { CampusStatsModal } from \'./components/CampusStatsModal\';\\nimport { ILovePeiHub } from \'./components/ILovePeiHub\';\\nimport { ArrowLeft } from \'lucide-react\';\\n\\nexport default function App() {\\n  const [studentsList, setStudentsList] = useState<PEICompleto[]>(todosOsCasos);\\n  const [activePei, setActivePei] = useState<PEICompleto>(todosOsCasos[0]); // INF-01 - T\303\251cnico em Inform\303\241tica\\n  const [activeTab, setActiveTab] = useState<string>(\'hub\');\\n  const [isAddStudentOpen, setIsAddStudentOpen] = useState<boolean>(false);\\n  const [isSolutionBankOpen, setIsSolutionBankOpen] = useState<boolean>(false);\\n  const [isCampusStatsOpen, setIsCampusStatsOpen] = useState<boolean>(false);\"}, {\"AllowMultiple\":false, \"EndLine\":50, \"ReplacementContent\":\"  // Switch student\\n  const handleSelectStudent = (student: PEICompleto) => {\\n    setActivePei(student);\\n  };\\n\\n  // Request to delete a PEI (opens confirmation dialog)\\n  const handleRequestDeletePei = (pei: PEICompleto) => {\\n    setPeiToDelete(pei);\\n  };\\n\\n  // Confirm deletion of selected PEI\\n  const handleConfirmDeletePei = () => {\\n    if (!peiToDelete) return;\\n\\n    const codigo = peiToDelete.cabecalho.codigo_matricula || peiToDelete.id;\\n    const nomeEstudante = peiToDelete.cabecalho.estudante;\\n\\n    setStudentsList((prev) => {\\n      const remaining = prev.filter((s) => s.id !== peiToDelete.id);\\n      if (activePei.id === peiToDelete.id && remaining.length > 0) {\\n        setActivePei(remaining[0]);\\n      }\\n      return remaining;\\n    });\\n\\n    setPeiToDelete(null);\\n    setDeleteNotice(`O PEI N\302\272 ${codigo} do estudante ${nomeEstudante} foi exclu\303\255do com sucesso.`);\\n    setTimeout(() => {\\n      setDeleteNotice(null);\\n    }, 5000);\\n  };\", \"StartLine\":46, \"TargetContent\":\"  // Switch student\\n  const handleSelectStudent = (student: PEICompleto) => {\\n    setActivePei(student);\\n  };\"}, {\"AllowMultiple\":false, \"EndLine\":277, \"ReplacementContent\":\"              <div className=\\\"text-xs text-slate-500 hidden sm:flex items-center gap-2\\\">\\n                <span>Visualizando PEI de:</span>\\n                <span className=\\\"font-bold text-slate-900 bg-slate-100 px-2 py-0.5 rounded\\\">\\n                  {activePei.cabecalho.estudante}\\n                </span>\\n                <span aria-hidden=\\\"true\\\" className=\\\"text-slate-300\\\">\302\267</span>\\n                <span className=\\\"text-emerald-800 font-semibold\\\">\\n                  {activeTab === \'pei\' && \'Plano de Ensino (PEI & DUA 3.0)\'}\\n                  {activeTab === \'estudo_caso\' && \'Estudo de Caso & Barreiras (Art. 11)\'}\\n                  {activeTab === \'documento_oficial\' && \'Modelo Oficial NAPNE / Processo SEI\'}\\n                  {activeTab === \'painel\' && \'Acompanhamento & Metas\'}\\n                </span>\\n                {studentsList.length > 1 && (\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => handleRequestDeletePei(activePei)}\\n                    className=\\\"ml-2 inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[11px] font-semibold text-red-700 bg-red-50 hover:bg-red-100 border border-red-200 transition-colors cursor-pointer\\\"\\n                    title=\\\"Excluir este PEI caso tenha sido salvo errado\\\"\\n                  >\\n                    <Trash2 className=\\\"w-3 h-3\\\" />\\n                    <span>Excluir PEI</span>\\n                  </button>\\n                )}\\n              </div>\\n            </div>\\n          </div>\\n\\n          <StudentHeader\\n            pei={activePei}\\n            allStudents={studentsList}\\n            onSelectCase={handleSelectStudent}\\n            onOpenAddStudent={() => setIsAddStudentOpen(true)}\\n            onOpenCampusStats={() => setIsCampusStatsOpen(true)}\\n            onRequestDeletePei={handleRequestDeletePei}\\n          />\\n        </div>\\n      )}\\n\\n      {/* Notification Banner on PEI Deletion */}\\n      {deleteNotice && (\\n        <div className=\\\"max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4 no-print animate-fadeIn\\\">\\n          <div className=\\\"p-3.5 bg-emerald-900 text-white rounded-xl shadow-md flex items-center justify-between gap-3 text-xs\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-300 shrink-0\\\" />\\n              <span className=\\\"font-semibold\\\">{deleteNotice}</span>\\n            </div>\\n            <button\\n              onClick={() => setDeleteNotice(null)}\\n              className=\\\"text-emerald-200 hover:text-white font-bold px-2 py-0.5 rounded cursor-pointer\\\"\\n            >\\n              Fechar\\n            </button>\\n          </div>\\n        </div>\\n      )}\\n\\n      {/* Main Content Area */}\\n      <main className=\\\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8\\\">\\n        {activeTab === \'hub\' && (\\n          <ILovePeiHub\\n            activePei={activePei}\\n            allStudents={studentsList}\\n            onSelectStudent={handleSelectStudent}\\n            onNavigate={(tab) => setActiveTab(tab)}\\n            onOpenAddStudent={() => setIsAddStudentOpen(true)}\\n            onOpenSolutionBank={() => setIsSolutionBankOpen(true)}\\n            onOpenCampusStats={() => setIsCampusStatsOpen(true)}\\n            onPrint={handlePrint}\\n            onRequestDeletePei={handleRequestDeletePei}\\n          />\\n        )}\", \"StartLine\":237, \"TargetContent\":\"              <div className=\\\"text-xs text-slate-500 hidden sm:flex items-center gap-2\\\">\\n                <span>Visualizando PEI de:</span>\\n                <span className=\\\"font-bold text-slate-900 bg-slate-100 px-2 py-0.5 rounded\\\">\\n                  {activePei.cabecalho.estudante}\\n                </span>\\n                <span aria-hidden=\\\"true\\\" className=\\\"text-slate-300\\\">\302\267</span>\\n                <span className=\\\"text-emerald-800 font-semibold\\\">\\n                  {activeTab === \'pei\' && \'Plano de Ensino (PEI & DUA 3.0)\'}\\n                  {activeTab === \'estudo_caso\' && \'Estudo de Caso & Barreiras (Art. 11)\'}\\n                  {activeTab === \'documento_oficial\' && \'Modelo Oficial NAPNE / Processo SEI\'}\\n                  {activeTab === \'painel\' && \'Acompanhamento & Metas\'}\\n                </span>\\n              </div>\\n            </div>\\n          </div>\\n\\n          <StudentHeader\\n            pei={activePei}\\n            allStudents={studentsList}\\n            onSelectCase={handleSelectStudent}\\n            onOpenAddStudent={() => setIsAddStudentOpen(true)}\\n            onOpenCampusStats={() => setIsCampusStatsOpen(true)}\\n          />\\n        </div>\\n      )}\\n\\n      {/* Main Content Area */}\\n      <main className=\\\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8\\\">\\n        {activeTab === \'hub\' && (\\n          <ILovePeiHub\\n            activePei={activePei}\\n            allStudents={studentsList}\\n            onSelectStudent={handleSelectStudent}\\n            onNavigate={(tab) => setActiveTab(tab)}\\n            onOpenAddStudent={() => setIsAddStudentOpen(true)}\\n            onOpenSolutionBank={() => setIsSolutionBankOpen(true)}\\n            onOpenCampusStats={() => setIsCampusStatsOpen(true)}\\n            onPrint={handlePrint}\\n          />\\n        )}\"}, {\"AllowMultiple\":false, \"EndLine\":350, \"ReplacementContent\":\"      {/* Modal: Estat\303\255sticas e Censo NAPNE Campus Para\303\255so */}\\n      <CampusStatsModal\\n        isOpen={isCampusStatsOpen}\\n        onClose={() => setIsCampusStatsOpen(false)}\\n      />\\n\\n      {/* Modal: Confirma\303\247\303\243o de Exclus\303\243o de PEI */}\\n      <ConfirmDeleteModal\\n        isOpen={Boolean(peiToDelete)}\\n        pei={peiToDelete}\\n        onConfirm={handleConfirmDeletePei}\\n        onCancel={() => setPeiToDelete(null)}\\n      />\\n    </div>\\n  );\\n}\", \"StartLine\":343, \"TargetContent\":\"      {/* Modal: Estat\303\255sticas e Censo NAPNE Campus Para\303\255so */}\\n      <CampusStatsModal\\n        isOpen={isCampusStatsOpen}\\n        onClose={() => setIsCampusStatsOpen(false)}\\n      />\\n    </div>\\n  );\\n}\"}], \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating App.tsx with ConfirmDeleteModal and deletion handlers\", \"toolSummary\":\"Integrate PEI deletion in App.tsx\"}"
