  view_file {
    absolute_path_uri: "file:///src/components/StudentHeader.tsx"
    end_line: 139
    content: "import React, { useState } from \'react\';\nimport { PEICompleto } from \'../types/pei\';\nimport { estatisticasCampusParaiso } from \'../data/initialCases\';\nimport {\n  UserCheck,\n  BookOpen,\n  GraduationCap,\n  UserPlus,\n  Building2,\n  FileCheck2,\n  HelpCircle,\n  BarChart3,\n  Filter,\n} from \'lucide-react\';\n\ninterface StudentHeaderProps {\n  pei: PEICompleto;\n  allStudents: PEICompleto[];\n  onSelectCase: (selectedPei: PEICompleto) => void;\n  onOpenAddStudent: () => void;\n  onOpenCampusStats?: () => void;\n}\n\nexport const StudentHeader: React.FC<StudentHeaderProps> = ({\n  pei,\n  allStudents,\n  onSelectCase,\n  onOpenAddStudent,\n  onOpenCampusStats,\n}) => {\n  const [activeFilter, setActiveFilter] = useState<\'todos\' | \'medio\' | \'superior\' | \'confirmado\' | \'hipotese\'>(\'todos\');\n  const { cabecalho, metricas, historico_napne } = pei;\n  const stats = estatisticasCampusParaiso;\n\n  const getInitial = (name: string) => {\n    return name ? name.charAt(0).toUpperCase() : \'E\';\n  };\n\n  const isSuperior =\n    cabecalho.curso.toLowerCase().includes(\'superior\') ||\n    cabecalho.curso.toLowerCase().includes(\'sistemas\') ||\n    cabecalho.modulo_periodo.toLowerCase().includes(\'semestre\');\n\n  const isTecnico =\n    cabecalho.curso.toLowerCase().includes(\'t\303\251cnico\') ||\n    cabecalho.curso.toLowerCase().includes(\'tecnico\') ||\n    cabecalho.modulo_periodo.toLowerCase().includes(\'t\303\251cnico\');\n\n  const isHipotese = historico_napne.status_diagnostico === \'em_investigacao_hipotese\';\n\n  // Filter students based on selection\n  const filteredStudents = allStudents.filter((s) => {\n    const sSuperior =\n      s.cabecalho.curso.toLowerCase().includes(\'superior\') ||\n      s.cabecalho.curso.toLowerCase().includes(\'sistemas\');\n    const sTecnico =\n      s.cabecalho.curso.toLowerCase().includes(\'t\303\251cnico\') ||\n      s.cabecalho.curso.toLowerCase().includes(\'tecnico\');\n    const sHipotese = s.historico_napne.status_diagnostico === \'em_investigacao_hipotese\';\n\n    if (activeFilter === \'medio\') return sTecnico;\n    if (activeFilter === \'superior\') return sSuperior;\n    if (activeFilter === \'confirmado\') return !sHipotese;\n    if (activeFilter === \'hipotese\') return sHipotese;\n    return true;\n  });\n\n  return (\n    <div className=\"bg-white border-b border-slate-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5\">\n        {/* Campus Paraiso Statistics Bar & Filter */}\n        <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-3 sm:p-4 mb-4 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-emerald-800 text-white flex items-center justify-center shrink-0\">\n              <Building2 className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xs font-bold text-slate-900 uppercase tracking-wide\">\n                  NAPNE \302\267 Campus Para\303\255so\n                </span>\n                <span className=\"text-[11px] font-mono text-emerald-800 bg-emerald-100 font-semibold px-2 py-0.5 rounded\">\n                  {stats.estudantes_geral} Estudantes Acompanhados\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                Censo oficial: <strong>{stats.estudantes_medio}</strong> no Ensino M\303\251dio \302\267 <strong>{stats.estudantes_superior}</strong> no Ensino Superior \302\267 <strong>{stats.com_diagnostico_confirmado}</strong> c/ laudo \302\267 <strong>{stats.sem_diagnostico_hipotese}</strong> s/ laudo (hip\303\263tese)\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-1.5 w-full lg:w-auto\">\n            <div className=\"flex items-center gap-1 text-[11px] font-semibold text-slate-500 mr-1\">\n              <Filter className=\"w-3 h-3\" />\n              <span>Filtrar:</span>\n            </div>\n\n            <button\n              onClick={() => setActiveFilter(\'todos\')}\n              className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-all cursor-pointer ${\n                activeFilter === \'todos\'\n                  ? \'bg-slate-900 text-white\'\n                  : \'bg-white border border-slate-200 text-slate-600 hover:bg-slate-100\'\n              }`}\n            >\n              Todos ({allStudents.length})\n            </button>\n\n            <button\n              onClick={() => setActiveFilter(\'medio\')}\n              className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-all cursor-pointer ${\n                activeFilter === \'medio\'\n                  ? \'bg-emerald-800 text-white\'\n                  : \'bg-white border border-slate-200 text-emerald-800 hover:bg-emerald-50\'\n              }`}\n              title=\"15 estudantes no M\303\251dio T\303\251cnico\"\n            >\n              M\303\251dio T\303\251cnico (15)\n            </button>\n\n            <button\n              onClick={() => setActiveFilter(\'superior\')}\n              className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-all cursor-pointer ${\n                activeFilter === \'superior\'\n                  ? \'bg-teal-800 text-white\'\n                  : \'bg-white border border-slate-200 text-teal-800 hover:bg-teal-50\'\n              }`}\n              title=\"14 estudantes no Superior TI\"\n            >\n              Superior TI (14)\n            </button>\n\n            <button\n              onClick={() => setActiveFilter(\'confirmado\')}\n              className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-all cursor-pointer ${\n                activeFilter === \'confirmado\'\n                  ? \'bg-blue-800 text-white\'\n                  : \'bg-white border border-slate-200 text-blue-800 hover:bg-blue-50\'\n              }`}\n              title=\"24 com diagn\303\263stico confirmado\""
    num_lines: 353
    num_bytes: 16446
    line_range_bytes: 5818
  }
}
