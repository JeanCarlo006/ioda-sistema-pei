            }
            lines {
              text: "    breve_historico_clinico_familiar:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Estudante do 1\302\272 Ano do Curso T\303\251cnico Integrado em Inform\303\241tica no Campus Para\303\255so. Integra o grupo dos 5 estudantes acompanhados pelo NAPNE que n\303\243o possuem diagn\303\263stico m\303\251dico formal. Conforme preconizado pela Portaria MEC n\302\272 421/2026 e pelo Decreto n\302\272 12.686/2025, a aus\303\252ncia de laudo m\303\251dico N\303\203O impede a elabora\303\247\303\243o do PEI nem a concess\303\243o de apoios e Tecnologias Assistivas no laborat\303\263rio de TI.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    descricao_condicao_especifica:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Apresenta grande dificuldade na decodifica\303\247\303\243o e digita\303\247\303\243o de sintaxes textuais r\303\255gidas de c\303\263digo (troca de caracteres como ponto-e-v\303\255rgula, chaves e par\303\252nteses) e fadiga na leitura de enunciados densos. Demonstra excelente racioc\303\255nio algor\303\255tmico quando apoiado por linters visuais e enunciados fracionados.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
