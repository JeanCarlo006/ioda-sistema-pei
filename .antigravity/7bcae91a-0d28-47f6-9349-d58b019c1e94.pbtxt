            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      avaliacao_pratica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Substitua provas longas de papel por desafios pr\303\241ticos de laborat\303\263rio divididos em 3 blocos curtos com pontua\303\247\303\243o imediata a cada bloco conclu\303\255do e tempo estendido (+50%). Valorize a l\303\263gica e o funcionamento do teste acima de detalhes burocr\303\241ticos de formata\303\247\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      manejo_e_acolhimento:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Se o estudante travar por sobrecarga executiva (\"n\303\243o sei por onde come\303\247ar\"), sente-se ao lado dele por 2 minutos, escreva a assinatura da primeira fun\303\247\303\243o ou o coment\303\241rio \"// Passo 1 aqui\" no editor dele e combine apenas os pr\303\263ximos 10 minutos de c\303\263digo.\',"
