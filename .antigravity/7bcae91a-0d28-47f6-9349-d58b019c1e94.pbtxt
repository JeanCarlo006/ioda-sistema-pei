            lines {
              text: "        descricao_meta: \'Compreender a rela\303\247\303\243o entre a adi\303\247\303\243o repetida de parcelas iguais e o conceito de multiplica\303\247\303\243o utilizando materiais concretos e cart\303\265es de CAA.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
