              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Grava\303\247\303\243o de aulas expositivas e disponibiliza\303\247\303\243o de roteiros de laborat\303\263rio no AVA Moodle para consulta em momentos de melhor disposi\303\247\303\243o energ\303\251tica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      acaoExpressao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Aplica\303\247\303\243o do regime de Atividades Acompanhadas (Decreto-Lei n\302\272 1.044/1969 e ODP-IFTO) em fases agudas; flexibiliza\303\247\303\243o de cronogramas sem rebaixamento curricular; tempo estendido (+50%).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      recursosTA: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
