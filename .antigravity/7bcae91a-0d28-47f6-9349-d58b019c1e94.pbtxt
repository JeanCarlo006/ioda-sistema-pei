      thinking_signature: "\022\344\024\n\341\024\001i\024}\023hQ8Vz\246\360.\244\335\245\336\250Q\367\340\332*\311\274\'\247\301\343\267\224{\\\204O\322}d\331z\341\274\317\366\025\320\016\331\360Q\b\037\223\223zaI\356u>\350$\211\327\351\277\035sx\374\2768\'\273\337_\f\221\036{\027\366j\370;\207#\37579b\016\030\252bj\336\225\0355\237\325\"\324\235\034\223%\215\261\212BZi\351w\375\264\311h.\3548\373\257\223\2433\267e\357U\231V\237[\000\030\210F=\260\3651\3378\022r<!\344\n\f2y\317\250\312\344\357\006\2055\245\322\"P\f\320\320\364\251\243E\037\270\211\375D<1\343?u\"\272\004c\274\273\370\v!\031\334\000\325\031\336\2007\214t\240\315l\376\0202z@\367\375\016]\374p\260U\265(\330ME\255\330\205K\235\377\211\201k\001\371J\006\027\231\365U\273\334Z\327\027\361U\207\233\3618Z\256\024\222C\365S^\223s\336\322g%\0350\320\v]\230A\003\333D\305q\323R1\r\375\334\267\243.+!\023k\276>\375\327\bW\277\a_\251\210\307O\335\334[!I\374y\225\206\233\213\210 %[\233r\352/\307\240\277\213\312u\272\361\356\'FV\354\243\234\235=\367\203r\200$\242g\276|mRDT]U\317\370\262\203\241\320\203Y\242A\300\266\351\216\031\310\2064Ap<\006<\356\365\240\252\247\023k\340\276\374<\021Yyp\243\201\322\003\177\202\224X<\202T\000\224\236j\276\327\331H\315\230\354\036h\005\254\026\3718\360Ux\"\2670\021\004Y1\322\177\372\231\016\221]?t\324\027Y_%\250N\370a\354\316,\332\313\326\352\223\235C\212\311\361\254\t\362\346\223\343O\316\310Qe\317Sp\031p\026\021\017C\263;\006?\346\267F\374u\236ZuM\311~w9\000|\212\317W\205\213\322\"On\242=\315\216\3173}\337epV*\301\031\247);)\357\265\356y\3027\303\030\233{vd*\360\301y\"Z\337\236\357>\034\004\030Y\305\200\361\267\340\332\311\343(NT\b\251?L\033\276\350\2101\265\017\320b\232\241\312L2\373\326\2534\301k-\024\333w\236\353\331\217/\237&\364\260\251\016\223z\204\262W\213\223\365mm\331\017\032\256as\235\016\354I\326\226\177\227\341k\201`S\344\244;d\257e \"\276\302%\371\302\334\'I\233):\002%\r\321\215\231\244\225\235\026\236\370\242&\261hP\350:]\216\200\320 \312\240\365n\253\346\027?\342\311