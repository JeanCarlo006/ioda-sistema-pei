    content: "              </div>\n            </div>\n\n            {/* Right: Meus PEIs Cadastrados (Acesso Confidencial) */}\n            <div className=\"w-full lg:w-96 bg-slate-50 border border-slate-200 rounded-2xl p-4.5 flex flex-col justify-between shrink-0\">\n              <div>\n                <div className=\"flex items-center justify-between pb-3 border-b border-slate-200\">\n                  <div className=\"flex items-center gap-2\">\n                    <FolderOpen className=\"w-4 h-4 text-emerald-800\" />\n                    <h3 className=\"text-xs font-bold text-slate-900 uppercase tracking-wider\">\n                      PEIs Cadastrados ({allStudents.length})\n                    </h3>\n                  </div>\n                  <span className=\"text-[10px] font-mono font-semibold text-emerald-900 bg-emerald-100 px-2 py-0.5 rounded\">\n                    Privacidade Ativa\n                  </span>\n                </div>\n\n                <p className=\"text-[11px] text-slate-500 mt-2\">\n                  Os nomes dos alunos s\303\243o mantidos em sigilo nesta tela. Acesse o PEI para visualizar os dados completos:\n                </p>\n\n                {/* Confidential List of PEIs */}\n                <div className=\"mt-3 space-y-2 max-h-56 overflow-y-auto pr-1\">\n                  {allStudents.map((s, idx) => {\n                    const isSelected = s.id === activePei.id;\n                    const isSuperior =\n                      s.cabecalho.curso.toLowerCase().includes(\'superior\') ||\n                      s.cabecalho.curso.toLowerCase().includes(\'sistemas\');\n                    const isSemLaudo = s.historico_napne.status_diagnostico === \'em_investigacao_hipotese\';\n\n                    return (\n                      <button\n                        key={s.id}\n                        type=\"button\"\n                        onClick={() => {\n                          onSelectStudent(s);\n                          onNavigate(\'pei\');\n                        }}\n                        className={`w-full p-2.5 rounded-xl border text-left transition-all cursor-pointer flex items-center justify-between group ${\n                          isSelected\n                            ? \'bg-white border-emerald-600 shadow-xs ring-1 ring-emerald-600\'\n                            : \'bg-white border-slate-200 hover:border-slate-300 hover:bg-slate-100/50\'\n                        }`}\n                      >\n                        <div className=\"truncate mr-2\">\n                          <div className=\"flex items-center gap-1.5\">\n                            <span className=\"text-xs font-bold text-slate-900 group-hover:text-emerald-800 transition-colors\">\n                              {getIdentificadorConfidencial(s, idx)}\n                            </span>\n                            {isSemLaudo && (\n                              <span className=\"text-[9px] font-bold text-amber-900 bg-amber-100 px-1.5 py-0.2 rounded uppercase\">\n                                s/ laudo\n                              </span>\n                            )}\n                          </div>\n                          <div className=\"text-[11px] text-slate-500 font-mono truncate mt-0.5\">\n                            {s.cabecalho.componente_curricular}\n                          </div>\n                        </div>\n\n                        <span className=\"text-[11px] font-bold text-emerald-800 flex items-center gap-1 shrink-0 group-hover:translate-x-0.5 transition-transform\">\n                          Abrir PEI \342\206\222\n                        </span>\n                      </button>\n                    );\n                  })}\n                </div>\n              </div>\n\n              {/* Bot\303\243o para Novo PEI */}\n              <div className=\"mt-4 pt-3 border-t border-slate-200\">\n                <button\n                  type=\"button\"\n                  onClick={onOpenAddStudent}\n                  className=\"w-full py-2.5 px-3 bg-emerald-700 hover:bg-emerald-800 text-white font-bold text-xs rounded-xl transition-all shadow-xs flex items-center justify-center gap-2 cursor-pointer\"\n                >\n                  <UserPlus className=\"w-4 h-4 text-emerald-200\" />\n                  <span>+ Elaborar Novo PEI com Ioda AI</span>\n                </button>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* 3. BARRA DE FILTROS (iLovePDF Style) */}\n      <div className=\"flex items-center justify-center flex-wrap gap-2 max-w-4xl mx-auto px-4\">\n        {categories.map((cat) => {\n          const isActive = activeCategory === cat.id;\n          return ("
