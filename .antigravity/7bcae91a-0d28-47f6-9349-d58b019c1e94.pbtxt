              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      avaliacaoAcessivel:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Composi\303\247\303\243o da nota atrav\303\251s de m\303\272ltiplos pequenos exerc\303\255cios pr\303\241ticos de laborat\303\263rio, com feedback formativo e oportunidade de reenvio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
