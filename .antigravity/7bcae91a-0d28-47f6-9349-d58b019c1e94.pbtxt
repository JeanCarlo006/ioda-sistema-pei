              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        estrategia_enfrentamento: \'DUA 3.0: Uso de materiais t\303\241teis e concretos (Material Dourado, \303\241baco de pinos largos, tampinhas antiderrapantes, contextualiza\303\247\303\243o com figurinhas de futebol).\',"
