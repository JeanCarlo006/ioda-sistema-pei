            lines {
              text: "    breve_historico_clinico_familiar:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Estudante do Curso T\303\251cnico Integrado em Inform\303\241tica. Reside com os pais e irm\303\243o mais novo. Fam\303\255lia presente nas reuni\303\265es pedag\303\263gicas do NAPNE. Apresenta diagn\303\263stico neurol\303\263gico de Paralisia Cerebral com leve espasticidade em membros superiores (preens\303\243o fina reduzida para digita\303\247\303\243o veloz cont\303\255nua) e caracter\303\255sticas de dislexia visual para leitura de blocos densos de texto e c\303\263digo. Ressalta-se que, conforme a PNEEI (Decreto n\302\272 12.686/2025), o PEI tem finalidade estritamente pedag\303\263gica para acessibilizar o curr\303\255culo t\303\251cnico sem rebaixamento de conte\303\272dos.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    descricao_condicao_especifica:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Limita\303\247\303\243o motora manual para digita\303\247\303\243o acelerada de sintaxe em teclados convencionais e fadiga visual com fontes monoespa\303\247adas compactas sem realce de sintaxe adequado. Apresenta excelente habilidade de abstra\303\247\303\243o l\303\263gica, racioc\303\255nio dedutivo, decomposi\303\247\303\243o de problemas e afinidade por arquitetura de software.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    informacoes_dos_pais:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Os pais relatam que Lucas passa horas em casa programando em projetos pessoais de desenvolvimento de jogos em JavaScript e automa\303\247\303\243o. Expressam preocupa\303\247\303\243o quanto \303\240 press\303\243o de tempo em avalia\303\247\303\265es pr\303\241ticas de laborat\303\263rio com cron\303\264metro r\303\255gido e solicitam media\303\247\303\243o para trabalhos em equipe sem atitudes capacitistas dos colegas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
