              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Previsibilidade com cronograma detalhado de aulas pr\303\241ticas e testes de software publicado com anteced\303\252ncia no AVA Moodle; defini\303\247\303\243o expl\303\255cita de pap\303\251is em equipes de desenvolvimento.\',"
