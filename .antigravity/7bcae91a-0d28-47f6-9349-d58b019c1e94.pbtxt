            }
            lines {
              text: "    guiaPratico: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      passo_a_passo_explicacao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Apresente o conte\303\272do de forma calma, mostrando que erros de compila\303\247\303\243o fazem parte natural do desenvolvimento de software. Disponibilize o resumo da aula e o c\303\263digo-base no Moodle para estudo no ritmo do aluno.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      divisao_tarefa_chunking: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
