      thinking_signature: "\022\254\b\n\251\b\001i\024}\023\212\356\"\321\177d\264\005\36449\020\264\240\245\355\323\360P\224\267\232\216/[La\205G\a\r\317Y\202\355\306_\376\336;\225\212\a\223\323\030\230\256\222\347H\210E\264:\215\361\2101\rb)\345Z\b\004}\224\037\326\343N\213\200\351%\032`|\234\335\304T\253r\276\021u\241\371\345ZUsc\020\237\241\375\313t\275A\001\201\375.\254s\220\2742a\003@\v:\224\202a\bj\220\302\004MT\362\202\354D\354s\245\"h\234>o\316R%2\254UL\221)\361\252\v^D\032\216L&b\337U\266z\334\237unY\000\005\230\274\256l\215\361\367\313\227D\204\302SO\035Co\"\320\207L\021\002\354#a\330\a\211Y\271\313\340\a\260\271P4\237\300\266\036#\372\3557\266\220\302\354\227\0310M;C\255\207\324\352\366\220]\350X\334\273\250\245\023\023\375]\256IeJ\377\324\320_\022\024\251\355\365~\260\204\221?a\036\3354DM\210D~\337\376\374\364r\230I\\\r\317@z5\322\227t\236}\375>0,\033\244\216\027\212\017\242\233\371\3466\253\003\030\265\312i;\227G\004\305;X\232]\'\322\355-v?\2257N\"\375\002^\260\352L\256F01-\253fkD\352\2701\003;\211\245\002H\231\\\3456\265\262\022,(\205\253\304\277\260\253[i\235`\006\316(\2043\017\345\375\354\320p\221\260PN\240\306$3/\265\302\353\201\203\224Y\031\330\a\260\304\236B\177\315i$\333\257\205tq4\017\275i?_\0249\303q\3175\004\250\316a\312\263\363\254\022\223\t`\274\213\257\003o\240\356\257\353\232$\257\355ows\024\023\350N\353U\224\341\375\376cZ\270\377\345\033gS\2769\222n\227:co(\335\2068d\005\340K\020;\032\350{F\202oIIx<_\263B>\202\202\262au\376w\315\206\032}\302f;\235%_M$\313(^fB\361\245\335\225\366&=\320q\310W\307]V\023\272\255m\355\322J#sd\361a.\020][G\254\206\353<\204d<F\331;\033\"H\\\\\032\321\367\273\374Ibw\351\213\344m\360 %\302\273\272Y\341\006\361\222\215\037\001R1\2352\317\004p\327b\332\006\0350\373\341\350\006~Z\221\035\270H\352\301\302U`\347\364\234:/\223*\3570\303\311\206\"$\315\376\000\201\213\025\326V#\350v\']A\n\246\236\365Cj!\\\267\\\367\252\304\fvd5\3275|hv~\020\003\345]\261\360:?m\fKo3\365\216J\200\001O\301\243\022BH }\341\020\3634\234\022\