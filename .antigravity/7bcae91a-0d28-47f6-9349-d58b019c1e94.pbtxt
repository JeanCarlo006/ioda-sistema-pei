              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Avalia\303\247\303\243o distribu\303\255da em pequenas entregas semanais durante as pr\303\263prias aulas de laborat\303\263rio, permitindo corre\303\247\303\243o e reenvio sem penalidade severa.\',"
