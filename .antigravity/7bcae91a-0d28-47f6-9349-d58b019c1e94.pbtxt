            }
            lines {
              text: "      engajamento:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Metodologia \303\241gil com divis\303\243o de projetos em micro-sprints semanais (Kanban/Jira/GitHub Projects); t\303\251cnica Pomodoro (25 min de foco / 5 min de pausa); feedback formativo imediato p\303\263s-entrega.\',"
