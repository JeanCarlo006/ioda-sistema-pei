            }
            lines {
              text: "    descricaoProblema:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Oscila\303\247\303\265es significativas de energia e motiva\303\247\303\243o aliadas a epis\303\263dios agudos de ansiedade de desempenho; desmotiva\303\247\303\243o diante de erros de compila\303\247\303\243o ou falhas em testes somada a medo paralisante de reprova\303\247\303\243o.\',"
