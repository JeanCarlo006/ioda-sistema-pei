  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { PEICompleto } from \'../types/pei\';\nimport { Printer, Download, CheckCircle2 } from \'lucide-react\';\n\ninterface OfficialTemplateViewProps {\n  pei: PEICompleto;\n  onPrint: () => void;\n}\n\nexport const OfficialTemplateView: React.FC<OfficialTemplateViewProps> = ({\n  pei,\n  onPrint,\n}) => {\n  const { cabecalho, historico_napne, planejamento_pei, metricas } = pei;\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Action Header (Hidden in Print) */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-4 sm:p-5 shadow-xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 no-print\">\n        <div>\n          <span className=\"text-xs font-semibold text-emerald-800 uppercase tracking-wider block\">\n            Formato Institucional NAPNE / MEC\n          </span>\n          <h2 className=\"text-base sm:text-lg font-bold text-slate-900 mt-0.5\">\n            Documento Formal do Plano de Ensino Individualizado (PEI)\n          </h2>\n          <p className=\"text-xs text-slate-500\">\n            Diagrama\303\247\303\243o estrita baseada no Modelo Oficial do NAPNE e Cadernos Pedag\303\263gicos da PNEEI\n          </p>\n        </div>\n\n        <button\n          onClick={onPrint}\n          className=\"inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold text-white bg-slate-900 hover:bg-slate-800 rounded-lg transition-colors cursor-pointer shadow-xs whitespace-nowrap\"\n        >\n          <Printer className=\"w-4 h-4\" />\n          Imprimir / Salvar PDF Oficial\n        </button>\n      </div>\n\n      {/* Official Document Container (A4 Printable Layout) */}\n      <div className=\"bg-white border border-slate-300 shadow-sm p-8 sm:p-12 max-w-4xl mx-auto rounded-none text-slate-900 font-sans print:border-none print:shadow-none print:p-0\">\n        {/* Document Header */}\n        <div className=\"border-b-2 border-slate-900 pb-4 mb-6\">\n          <div className=\"flex items-start justify-between gap-4\">\n            <div>\n              <span className=\"text-xs font-mono uppercase tracking-widest text-slate-500 block\">\n                MINIST\303\211RIO DA EDUCA\303\207\303\203O \302\267 POL\303\215TICA NACIONAL DE EDUCA\303\207\303\203O ESPECIAL INCLUSIVA\n              </span>\n              <h1 className=\"text-xl sm:text-2xl font-black tracking-tight text-slate-900 mt-1\">\n                PEI - PLANO DE ENSINO INDIVIDUALIZADO\n              </h1>\n              <span className=\"text-xs text-slate-600 block mt-0.5\">\n                N\303\272cleo de Atendimento \303\240s Pessoas com Necessidades Educacionais Espec\303\255ficas (NAPNE)\n              </span>\n            </div>\n\n            {/* Photo / ID Stamp Box */}\n            <div className=\"w-24 h-28 border-2 border-slate-400 bg-slate-50 rounded-sm flex flex-col items-center justify-center text-center p-1.5 shrink-0\">\n              <span className=\"text-[10px] font-mono font-bold text-slate-600 uppercase leading-tight\">\n                FOTO DO ESTUDANTE\n              </span>\n              <span className=\"text-xs font-bold text-slate-900 mt-1\">\n                {cabecalho.estudante.split(\' \')[0]}\n              </span>\n              <span className=\"text-[9px] text-slate-400 font-mono mt-0.5\">\n                {cabecalho.codigo_matricula}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Section 1: Identifica\303\247\303\243o */}\n        <div className=\"mb-6\">\n          <div className=\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\">\n            1. Identifica\303\247\303\243o Geral\n          </div>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-2 text-xs\">\n            <div>\n              <strong className=\"text-slate-600\">Nome do Estudante:</strong>{\' \'}\n              <span className=\"font-semibold text-slate-900\">{cabecalho.estudante}</span>\n            </div>\n            <div>\n              <strong className=\"text-slate-600\">Matr\303\255cula / C\303\263digo:</strong>{\' \'}\n              <span className=\"font-mono text-slate-900\">{cabecalho.codigo_matricula}</span>\n            </div>\n            <div>\n              <strong className=\"text-slate-600\">Docente(s) Respons\303\241vel(eis):</strong>{\' \'}\n              <span className=\"font-medium text-slate-900\">{cabecalho.docente_regente}</span>\n            </div>\n            <div>\n              <strong className=\"text-slate-600\">Docente do AEE:</strong>{\' \'}\n              <span className=\"font-medium text-slate-900\">{cabecalho.docente_aee}</span>\n            </div>\n            <div>\n              <strong className=\"text-slate-600\">Componente Curricular:</strong>{\' \'}\n              <span className=\"font-medium text-slate-900\">{cabecalho.componente_curricular}</span>\n            </div>\n            <div>\n              <strong className=\"text-slate-600\">Per\303\255odo / M\303\263dulo:</strong>{\' \'}\n              <span className=\"font-medium text-slate-900\">{cabecalho.modulo_periodo}</span>\n            </div>\n            <div>\n              <strong className=\"text-slate-600\">Profissional de Apoio:</strong>{\' \'}\n              <span className=\"font-medium text-slate-900\">{cabecalho.profissional_apoio}</span>\n            </div>\n            <div>\n              <strong className=\"text-slate-600\">Data de Elabora\303\247\303\243o:</strong>{\' \'}\n              <span className=\"font-mono text-slate-900\">{cabecalho.data_elaboracao}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Section 2: Hist\303\263rico Cl\303\255nico e Familiar (NAPNE) */}\n        <div className=\"mb-6\">\n          <div className=\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\">\n            2. Hist\303\263ricos Cl\303\255nico e Familiar do Estudante (NAPNE)\n          </div>\n          <div className=\"space-y-3 text-xs leading-relaxed\">\n            <div>\n              <span className=\"font-bold text-slate-700 block mb-0.5\">\n                Breve Hist\303\263rico Cl\303\255nico e Familiar do Estudante:\n              </span>\n              <p className=\"text-slate-800 text-justify\">\n                {historico_napne.breve_historico_clinico_familiar}\n              </p>\n            </div>\n\n            <div>\n              <span className=\"font-bold text-slate-700 block mb-0.5\">\n                Breve Descri\303\247\303\243o da Condi\303\247\303\243o Espec\303\255fica do Estudante:\n              </span>\n              <p className=\"text-slate-800 text-justify\">\n                {historico_napne.descricao_condicao_especifica}\n              </p>\n            </div>\n\n            <div>\n              <span className=\"font-bold text-slate-700 block mb-0.5\">\n                Informa\303\247\303\265es dos Pais e Respons\303\241veis:\n              </span>\n              <p className=\"text-slate-800 text-justify\">\n                {historico_napne.informacoes_dos_pais}\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Section 3: Planejamento do Componente Curricular */}\n        <div className=\"mb-6\">\n          <div className=\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\">\n            3. Planejamento do Componente Curricular\n          </div>\n          <div className=\"space-y-3 text-xs leading-relaxed\">\n            <div>\n              <span className=\"font-bold text-slate-700 block mb-0.5\">Conte\303\272do (Ementa Oficial):</span>\n              <p className=\"text-slate-800\">{planejamento_pei.conteudo_ementa_oficial}</p>\n            </div>\n\n            <div>\n              <span className=\"font-bold text-slate-700 block mb-0.5\">\n                Compet\303\252ncias e Habilidades BNCC (Ementa):\n              </span>\n              <p className=\"text-slate-800\">{planejamento_pei.competencias_habilidades_bncc}</p>\n            </div>\n\n            <div>\n              <span className=\"font-bold text-slate-700 block mb-0.5\">\n                Adapta\303\247\303\243o e Flexibiliza\303\247\303\243o Curricular (Conte\303\272dos Acessibilizados):\n              </span>\n              <p className=\"text-slate-800 text-justify\">\n                {planejamento_pei.adaptacao_flexibilizacao_curricular}\n              </p>\n            </div>\n          </div>\n        </div>\n\n        {/* Section 4: Adapta\303\247\303\243o e Flexibiliza\303\247\303\243o Metodol\303\263gica (DUA 3.0) */}\n        <div className=\"mb-6\">\n          <div className=\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\">\n            4. Adapta\303\247\303\243o e Flexibiliza\303\247\303\243o Metodol\303\263gica (DUA 3.0 - Pr\303\241ticas Pedag\303\263gicas)\n          </div>\n          <div className=\"space-y-2 text-xs leading-relaxed\">\n            <div>\n              <strong className=\"text-slate-800\">M\303\272ltiplos Meios de Engajamento:</strong>{\' \'}\n              <span className=\"text-slate-800\">\n                {planejamento_pei.flexibilizacao_metodologica_dua.engajamento.join(\' \')}\n              </span>\n            </div>\n            <div>\n              <strong className=\"text-slate-800\">M\303\272ltiplos Meios de Representa\303\247\303\243o:</strong>{\' \'}\n              <span className=\"text-slate-800\">\n                {planejamento_pei.flexibilizacao_metodologica_dua.representacao.join(\' \')}\n              </span>\n            </div>\n            <div>\n              <strong className=\"text-slate-800\">M\303\272ltiplos Meios de A\303\247\303\243o e Express\303\243o:</strong>{\' \'}\n              <span className=\"text-slate-800\">\n                {planejamento_pei.flexibilizacao_metodologica_dua.acao_e_expressao.join(\' \')}\n              </span>\n            </div>\n            <div>\n              <strong className=\"text-slate-800\">Gest\303\243o e Rotina da Sala de Aula:</strong>{\' \'}\n              <span className=\"text-slate-800\">\n                {planejamento_pei.gestao_sala_de_aula.organizacao_espacial}{\' \'}\n                {planejamento_pei.gestao_sala_de_aula.rotina_e_pausas}{\' \'}\n                {planejamento_pei.gestao_sala_de_aula.suporte_docente_semanal}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Section 5: Avalia\303\247\303\243o Processual */}\n        <div className=\"mb-6\">\n          <div className=\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\">\n            5. Avalia\303\247\303\243o (Onde Estava; O Quanto o Estudante Avan\303\247ou)\n          </div>\n          <div className=\"text-xs space-y-2 text-slate-800 leading-relaxed text-justify\">\n            <p>\n              <strong>Formato Acess\303\255vel:</strong> {planejamento_pei.estrategias_avaliacao.formato_acessivel}\n            </p>\n            <p>\n              <strong>Crit\303\251rio de Sucesso:</strong> {planejamento_pei.estrategias_avaliacao.criterio_de_sucesso}\n            </p>\n            <p>\n              <strong>Condi\303\247\303\265es de Aplica\303\247\303\243o:</strong> Tempo estendido, avalia\303\247\303\243o mediada com plano inclinado e prancha de CAA tem\303\241tica.\n            </p>\n          </div>\n        </div>\n\n        {/* Section 6: Observa\303\247\303\243o do Professor / Resultado */}\n        <div className=\"mb-8\">\n          <div className=\"bg-slate-100 py-1 px-2.5 font-bold text-xs uppercase tracking-wider text-slate-800 border-l-4 border-slate-900 mb-3\">\n            6. Observa\303\247\303\243o do Professor: Resultado e Objetivos Alcan\303\247ados\n          </div>\n          <div className=\"text-xs text-slate-800 text-justify leading-relaxed p-3 bg-slate-50 border border-slate-200\">\n            {planejamento_pei.observacoes_docente}\n          </div>\n        </div>\n\n        {/* Signatures Block (NAPNE Model) */}\n        <div className=\"mt-12 pt-6 border-t-2 border-slate-300\">\n          <div className=\"grid grid-cols-2 gap-12 text-center text-xs\">\n            <div>\n              <div className=\"border-b border-slate-900 mb-1 pb-4\">\n                <span className=\"font-semibold text-slate-900 block\">{cabecalho.docente_regente}</span>\n              </div>\n              <span className=\"text-slate-600 uppercase tracking-wider font-medium\">\n                Docente Respons\303\241vel\n              </span>\n            </div>\n\n            <div>\n              <div className=\"border-b border-slate-900 mb-1 pb-4\">\n                <span className=\"font-semibold text-slate-900 block\">{cabecalho.coordenacao_napne}</span>\n              </div>\n              <span className=\"text-slate-600 uppercase tracking-wider font-medium\">\n                Coordena\303\247\303\243o NAPNE / Educa\303\247\303\243o Especial\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Footer Reference */}\n        <div className=\"mt-8 text-center text-[10px] text-slate-400 font-mono\">\n          Documento elaborado nos termos do Decreto n\302\272 12.686/2025 e Portaria MEC n\302\272 421/2026.\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/OfficialTemplateView.tsx"
        }
        overwrite: true
      }
    }
