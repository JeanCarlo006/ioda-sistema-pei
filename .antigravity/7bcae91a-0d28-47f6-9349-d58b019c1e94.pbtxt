    tool_calls {
      id: "call_274094"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { X, CheckCircle2, BookOpen, ExternalLink, HelpCircle } from \'lucide-react\';\\n\\ninterface CentralAjudaModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n}\\n\\nexport const CentralAjudaModal: React.FC<CentralAjudaModalProps> = ({ isOpen, onClose }) => {\\n  if (!isOpen) return null;\\n\\n  const checklistProfessor = [\\n    {\\n      passo: \'1. Conhecer o Estudante antes do R\303\263tulo\',\\n      descricao:\\n        \'Identifique primeiro os interesses, talentos e o que motiva o estudante (ex: jogos, m\303\272sica, programa\303\247\303\243o visual). O ensino funciona melhor quando parte do que ele j\303\241 domina.\',\\n    },\\n    {\\n      passo: \'2. Fracionar Atividades (Chunking) e DUA\',\\n      descricao:\\n        \'Divida tarefas e projetos extensos em 3 etapas curtas com entregas parciais. Combine explica\303\247\303\265es faladas com esquemas visuais ou exemplos pr\303\241ticos no laborat\303\263rio.\',\\n    },\\n    {\\n      passo: \'3. Avaliar pelo Dom\303\255nio Pr\303\241tico (Equidade)\',\\n      descricao:\\n        \'Adapte o formato da prova (tempo adicional de 25% a 50%, quest\303\265es diretas sem pegadinhas, defesa oral ou entrega pr\303\241tica comentada) mantendo o objetivo central da disciplina.\',\\n    },\\n  ];\\n\\n  const glossarioNapne = [\\n    {\\n      sigla: \'PEI\',\\n      termo: \'Plano Educacional Individualizado\',\\n      definicao:\\n        \'Instrumento pedag\303\263gico constru\303\255do com o professor para adaptar o ensino, as atividades e as avalia\303\247\303\265es de uma disciplina \303\240s necessidades do estudante.\',\\n    },\\n    {\\n      sigla: \'PAEE\',\\n      termo: \'Plano de Atendimento Educacional Especializado\',\\n      definicao:\\n        \'Plano elaborado pela equipe multiprofissional/NAPNE para organizar os suportes, recursos de tecnologia assistiva e atendimentos no contraturno.\',\\n    },\\n    {\\n      sigla: \'DUA\',\\n      termo: \'Desenho Universal para a Aprendizagem (CAST 3.0)\',\\n      definicao:\\n        \'Abordagem que planeja aulas acess\303\255veis a todos desde o in\303\255cio, oferecendo m\303\272ltiplas formas de engajar, apresentar o conte\303\272do e avaliar o aprendizado.\',\\n    },\\n    {\\n      sigla: \'PNEEI\',\\n      termo: \'Pol\303\255tica Nacional de Educa\303\247\303\243o Especial Inclusiva\',\\n      definicao:\\n        \'Diretriz nacional atualizada pelo Decreto n\302\272 12.686/2025 que assegura a inclus\303\243o escolar, proibindo a exig\303\252ncia de laudo m\303\251dico para iniciar o apoio pedag\303\263gico.\',\\n    },\\n    {\\n      sigla: \'TA\',\\n      termo: \'Tecnologia Assistiva\',\\n      definicao:\\n        \'Qualquer recurso, software ou equipamento (leitores de tela, fontes adaptadas, mapas mentais, abafadores de ru\303\255do) que amplia a autonomia do estudante.\',\\n    },\\n  ];\\n\\n  return (\\n    <div\\n      className=\\\"fixed inset-0 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center z-50 p-4 overflow-y-auto\\\"\\n      role=\\\"dialog\\\"\\n      aria-modal=\\\"true\\\"\\n      aria-labelledby=\\\"central-ajuda-title\\\"\\n    >\\n      <div className=\\\"bg-white border border-slate-200 rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl my-8\\\">\\n        {/* Cabe\303\247alho */}\\n        <div className=\\\"bg-slate-900 px-6 py-4 flex items-center justify-between text-white\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"bg-emerald-600 p-2 rounded-lg\\\">\\n              <HelpCircle className=\\\"w-5 h-5 text-white\\\" />\\n            </div>\\n            <div>\\n              <h2 id=\\\"central-ajuda-title\\\" className=\\\"text-lg font-bold\\\">\\n                Central de Ajuda & Legisla\303\247\303\243o\\n              </h2>\\n              <p className=\\\"text-xs text-slate-300\\\">\\n                Guia r\303\241pido de bolso para professores e equipe NAPNE \342\200\224 Consulta instant\303\242nea\\n              </p>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"text-slate-400 hover:text-white p-1.5 rounded-lg hover:bg-slate-800 transition-colors\\\"\\n            aria-label=\\\"Fechar janela de ajuda\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        <div className=\\\"p-6 space-y-6 max-h-[75vh] overflow-y-auto\\\">\\n          {/* 1. Checklist R\303\241pido do Professor */}\\n          <section>\\n            <h3 className=\\\"text-sm font-bold text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-2\\\">\\n              <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600\\\" />\\n              Checklist R\303\241pido do Professor (3 Passos Pr\303\241ticos)\\n            </h3>\\n            <div className=\\\"space-y-3\\\">\\n              {checklistProfessor.map((item, idx) => (\\n                <div\\n                  key={idx}\\n                  className=\\\"bg-slate-50 border border-slate-200 rounded-xl p-4\\\"\\n                >\\n                  <p className=\\\"font-bold text-slate-900 text-sm mb-1\\\">{item.passo}</p>\\n                  <p className=\\\"text-slate-600 text-sm leading-relaxed\\\">{item.descricao}</p>\\n                </div>\\n              ))}\\n            </div>\\n          </section>\\n\\n          {/* 2. Gloss\303\241rio do NAPNE */}\\n          <section>\\n            <h3 className=\\\"text-sm font-bold text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-2\\\">\\n              <BookOpen className=\\\"w-4 h-4 text-emerald-600\\\" />\\n              Gloss\303\241rio R\303\241pido do NAPNE\\n            </h3>\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              {glossarioNapne.map((item) => (\\n                <div\\n                  key={item.sigla}\\n                  className=\\\"bg-white border border-slate-200 rounded-xl p-3.5\\\"\\n                >\\n                  <div className=\\\"flex items-baseline gap-2 mb-1\\\">\\n                    <span className=\\\"px-2 py-0.5 bg-emerald-50 text-emerald-800 font-bold text-xs rounded border border-emerald-200\\\">\\n                      {item.sigla}\\n                    </span>\\n                    <span className=\\\"text-xs font-semibold text-slate-800\\\">{item.termo}</span>\\n                  </div>\\n                  <p className=\\\"text-xs text-slate-600 leading-relaxed\\\">{item.definicao}</p>\\n                </div>\\n              ))}\\n            </div>\\n          </section>\\n\\n          {/* 3. Links Oficiais Institucionais */}\\n          <section>\\n            <h3 className=\\\"text-sm font-bold text-slate-900 uppercase tracking-wider mb-3 flex items-center gap-2\\\">\\n              <ExternalLink className=\\\"w-4 h-4 text-emerald-600\\\" />\\n              Legisla\303\247\303\243o Oficial (\303\215ntegra no Portal Gov.br / DOU)\\n            </h3>\\n            <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n              <a\\n                href=\\\"https://www.in.gov.br/web/dou\\\"\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"flex items-start justify-between p-4 rounded-xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/40 transition-colors group\\\"\\n              >\\n                <div>\\n                  <p className=\\\"text-sm font-bold text-slate-900 group-hover:text-emerald-800\\\">\\n                    Decreto n\302\272 12.686/2025\\n                  </p>\\n                  <p className=\\\"text-xs text-slate-600 mt-1\\\">\\n                    Institui a Pol\303\255tica Nacional de Educa\303\247\303\243o Especial Inclusiva (PNEEI) e veda a exig\303\252ncia de laudo m\303\251dico.\\n                  </p>\\n                </div>\\n                <ExternalLink className=\\\"w-4 h-4 text-slate-400 group-hover:text-emerald-600 shrink-0 mt-0.5\\\" />\\n              </a>\\n\\n              <a\\n                href=\\\"https://www.gov.br/mec/pt-br\\\"\\n                target=\\\"_blank\\\"\\n                rel=\\\"noopener noreferrer\\\"\\n                className=\\\"flex items-start justify-between p-4 rounded-xl border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50/40 transition-colors group\\\"\\n              >\\n                <div>\\n                  <p className=\\\"text-sm font-bold text-slate-900 group-hover:text-emerald-800\\\">\\n                    Portaria MEC n\302\272 421/2026\\n                  </p>\\n                  <p className=\\\"text-xs text-slate-600 mt-1\\\">\\n                    Regulamenta a Rede Nacional de Educa\303\247\303\243o Especial Inclusiva, o PAEE e o atendimento nos Institutos Federais.\\n                  </p>\\n                </div>\\n                <ExternalLink className=\\\"w-4 h-4 text-slate-400 group-hover:text-emerald-600 shrink-0 mt-0.5\\\" />\\n              </a>\\n            </div>\\n          </section>\\n        </div>\\n\\n        <div className=\\\"bg-slate-50 px-6 py-3.5 border-t border-slate-200 flex justify-end\\\">\\n          <button\\n            onClick={onClose}\\n            className=\\\"px-5 py-2 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-sm font-semibold transition-colors\\\"\\n          >\\n            Fechar Guia\\n          </button>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create CentralAjudaModal component with Teacher Checklist, NAPNE Glossary, and official legislation links\", \"Overwrite\":true, \"TargetFile\":\"/src/components/CentralAjudaModal.tsx\", \"toolAction\":\"Creating CentralAjudaModal component\", \"toolSummary\":\"Create CentralAjudaModal.tsx\"}"
      original_name: "write_to_file"
