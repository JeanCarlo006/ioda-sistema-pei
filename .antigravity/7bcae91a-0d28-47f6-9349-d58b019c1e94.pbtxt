            lines {
              text: "    ],"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    flexibilizacao_metodologica_dua: {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      engajamento: ["
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Ancoragem tem\303\241tica no futebol: contagem de figurinhas, escala\303\247\303\243o de jogadores e combina\303\247\303\265es de uniformes esportivos que despertam a motiva\303\247\303\243o intr\303\255nseca de Gabriel.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Organiza\303\247\303\243o de agrupamentos colaborativos (3 a 4 alunos) com tutoria entre pares, atribuindo a Gabriel o papel de estrategista que decide as combina\303\247\303\265es das jogadas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Rotina previs\303\255vel e acolhedora: calend\303\241rio visual afixado no plano inclinado com a ordem das atividades do dia e pausas de descanso programadas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      representacao: ["
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Encena\303\247\303\243o concreta na sala de aula: os pr\303\263prios alunos representam os times e as combina\303\247\303\265es com camisas coloridas antes do registro gr\303\241fico no quadro.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Apresenta\303\247\303\243o simult\303\242nea no quadro principal e na mini-lousa individual do plano inclinado com s\303\255mbolos visuais, fonte ampliada (Arial 20) e alto contraste.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Explora\303\247\303\243o multissensorial com Material Dourado em relevo, \303\241baco de pinos largos e apoio de s\303\255ntese vocal no tablet para audi\303\247\303\243o dos enunciados.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      acao_e_expressao: ["
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Elimina\303\247\303\243o da exig\303\252ncia de caligrafia manual em folhas soltas: respostas registradas via fixa\303\247\303\243o de cart\303\265es com velcro em tabelas r\303\255gidas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Uso de prancha de Comunica\303\247\303\243o Aumentativa e Alternativa (CAA) com ponteira adaptada ou sele\303\247\303\243o t\303\241til para resposta a perguntas conceituais da professora.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Possibilidade de valida\303\247\303\243o de c\303\241lculos matem\303\241ticos no tablet ou calculador t\303\241til adaptado.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      ],"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "    gestao_sala_de_aula: {"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      organizacao_espacial:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Disposi\303\247\303\243o das carteiras em semic\303\255rculo ou ilhas de trabalho, garantindo corredor livre de 1,20m para circula\303\247\303\243o da cadeira de rodas e posicionamento central pr\303\263ximo ao quadro e aos colegas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      rotina_e_pausas:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Aulas de racioc\303\255nio matem\303\241tico alocadas no in\303\255cio do turno escolar (per\303\255odo de maior alerta cognitivo e menor fadiga f\303\255sica). Previs\303\243o de pausa de 5 a 10 minutos para \"respiro\" fora da sala quando houver sinais de cansa\303\247o postural.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "      agrupamentos_e_tutoria:"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Duplas produtivas e tutoria por pares rotativa com colegas acolhedores que auxiliam na sustenta\303\247\303\243o de materiais sem substituir o protagonismo de escolha do estudante.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
