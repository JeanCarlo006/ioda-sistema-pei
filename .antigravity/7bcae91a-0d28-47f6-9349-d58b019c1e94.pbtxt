  view_file {
    absolute_path_uri: "file:///src/components/AddStudentModal.tsx"
    start_line: 299
    end_line: 449
    content: "            <div className=\"w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-800\">\n              <UserPlus className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h3 className=\"text-base sm:text-lg font-bold text-slate-900\">\n                Cadastrar Estudante & Gerar PEI com Ioda (Gemini API)\n              </h3>\n              <span className=\"text-xs text-slate-500\">\n                Gera\303\247\303\243o autom\303\241tica com sugest\303\265es de TA, flexibiliza\303\247\303\243o DUA 3.0 e metas SMART para TI\n              </span>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            disabled={isGenerating}\n            className=\"p-1 text-slate-400 hover:text-slate-600 rounded-lg cursor-pointer disabled:opacity-50\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Level Switcher (Ensino M\303\251dio T\303\251cnico vs Ensino Superior TI) */}\n        <div className=\"mb-5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n          <label className=\"text-xs font-bold text-slate-700 uppercase tracking-wider block\">\n            1. Selecione o N\303\255vel de Ensino:\n          </label>\n          <div className=\"grid grid-cols-2 gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => handleToggleNivel(\'medio\')}\n              className={`p-2.5 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer ${\n                nivelEducacional === \'medio\'\n                  ? \'bg-emerald-800 text-white border-emerald-900 shadow-xs\'\n                  : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-100\'\n              }`}\n            >\n              Ensino M\303\251dio T\303\251cnico (Inform\303\241tica / Redes)\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => handleToggleNivel(\'superior\')}\n              className={`p-2.5 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer ${\n                nivelEducacional === \'superior\'\n                  ? \'bg-emerald-800 text-white border-emerald-900 shadow-xs\'\n                  : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-100\'\n              }`}\n            >\n              Ensino Superior em TI (Sistemas / Computa\303\247\303\243o)\n            </button>\n          </div>\n        </div>\n\n        {/* Quick condition presets */}\n        <div className=\"mb-5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <label className=\"text-xs font-bold text-slate-700 uppercase tracking-wider block\">\n              2. Preencher Automaticamente por Condi\303\247\303\243o / Barreira de TI:\n            </label>\n            <span className=\"text-[10px] text-slate-500 font-mono\">DUA 3.0 & TA</span>\n          </div>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2\">\n            {bancoDeSolucoesPedagogicas.map((sol) => (\n              <button\n                key={sol.id}\n                type=\"button\"\n                onClick={() => handleSelectPredefinedSolution(sol.id)}\n                className={`p-2.5 text-left text-xs rounded-lg border transition-all cursor-pointer ${\n                  solucaoId === sol.id\n                    ? \'bg-emerald-50 border-emerald-500 text-emerald-950 font-semibold shadow-xs\'\n                    : \'bg-white border-slate-300 text-slate-700 hover:border-slate-400\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-bold text-slate-900\">{sol.titulo.split(\'/\')[0]}</span>\n                  <span className=\"text-[10px] text-slate-500 font-mono\">\n                    {sol.nivelSugerido}\n                  </span>\n                </div>\n                <p className=\"text-[11px] text-slate-500 mt-0.5 line-clamp-1\">\n                  {sol.condicao}\n                </p>\n              </button>\n            ))}\n          </div>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4 text-xs\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n            <div className=\"sm:col-span-2\">\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Nome Completo do Estudante\n              </label>\n              <input\n                type=\"text\"\n                value={nome}\n                onChange={(e) => setNome(e.target.value)}\n                placeholder=\"Ex: Gabriel Moreira Silva\"\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\"\n                required\n              />\n            </div>\n\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Matr\303\255cula\n              </label>\n              <input\n                type=\"text\"\n                value={matricula}\n                onChange={(e) => setMatricula(e.target.value)}\n                placeholder=\"Ex: 2026.1.TI.088\"\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Curso\n              </label>\n              <input\n                type=\"text\"\n                value={curso}\n                onChange={(e) => setCurso(e.target.value)}\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\"\n                required\n              />\n            </div>\n\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                M\303\263dulo / Per\303\255odo / Ano\n              </label>\n              <input\n                type=\"text\"\n                value={modulo}\n                onChange={(e) => setModulo(e.target.value)}\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\"\n                required\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n              Componente Curricular / Disciplina de TI\n            </label>\n            <input\n              type=\"text\""
    num_lines: 544
