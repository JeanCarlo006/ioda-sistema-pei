            }
            lines {
              text: "    breve_historico_clinico_familiar:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Estudante com diagn\303\263stico de Transtorno do Espectro Autista (TEA - N\303\255vel 1 de Suporte). Apresenta hipersensibilidade auditiva a frequ\303\252ncias sonoras espec\303\255ficas (ru\303\255do constante de ventoinhas de servidores, switches e alarmes de rack) e perfil de comunica\303\247\303\243o literal e met\303\263dica. Excelente capacidade de memoriza\303\247\303\243o sistem\303\241tica de padr\303\265es e grande hiperfoco em protocolos de comunica\303\247\303\243o (TCP/IP, UDP) e sub-redes IPv4/IPv6.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    descricao_condicao_especifica:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Pode apresentar desorganiza\303\247\303\243o sensorial em aulas pr\303\241ticas com ru\303\255do intenso simult\303\242neo e comandos vagos ou poliss\303\252micos. Necessita de antecipa\303\247\303\243o visual das etapas da aula pr\303\241tica de laborat\303\263rio e uso permitido de abafadores de ru\303\255do circum-aurais.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    informacoes_dos_pais:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Os pais relatam que Matheus \303\251 muito focado e dedicado aos estudos de inform\303\241tica. Solicitam apoio da escola para que o ambiente de laborat\303\263rio seja acolhedor e para que as equipes de trabalho respeitem seu tempo de comunica\303\247\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
