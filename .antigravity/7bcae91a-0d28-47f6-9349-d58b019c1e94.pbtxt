              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Avalia\303\247\303\243o processual somativa por marcos parciais semanais entregues, mitigando o peso de uma \303\272nica prova final te\303\263rica ou entrega acumulada.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    },"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
