            }
            lines {
              text: "      representacao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Roteiros de laborat\303\263rio fracionados em checklists objetivos com caixas de sele\303\247\303\243o; disponibiliza\303\247\303\243o de starter kits e snippets comentados; linters visuais (Error Lens) no VS Code.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      acaoExpressao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Demonstra\303\247\303\243o progressiva por commits semanais de testes unit\303\241rios (TDD: red-green-refactor); aceita\303\247\303\243o de documenta\303\247\303\243o sintetizada em Markdown em vez de relat\303\263rios extensos; tempo estendido (+50%).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      recursosTA: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Quadro Kanban digital integrado ao Jira / GitHub Projects\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Extens\303\265es de foco e linter no VS Code (Error Lens, Todo Tree, Pomodoro Timer)\',"
