            }
            lines {
              text: "      avaliacao_pratica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Priorize entregas pr\303\241ticas ass\303\255ncronas via Git/Moodle e defesas individuais tranquilas, assegurando segunda oportunidade de entrega em fases agudas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
