            }
            lines {
              text: "      avaliacaoAcessivel:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Avalia\303\247\303\243o baseada na consolida\303\247\303\243o das compet\303\252ncias ao longo do semestre, permitindo prazos estendidos para conclus\303\243o de projetos pr\303\241ticos.\',"
