    content: "  isOpen,\n  onClose,\n  onAddStudent,\n  escalaFonteAtual = \'normal\',\n  onMudarFonte,\n  modoContrasteAtual = \'padrao\',\n  onMudarContraste,\n}) => {\n  // Wizard / Stepper state (Progressive Disclosure - 4 Steps)\n  const [currentStep, setCurrentStep] = useState<1 | 2 | 3 | 4>(1);\n\n  // Profile and diagnostic status\n  const [perfilModalidade, setPerfilModalidade] = useState<\'medio_tecnico\' | \'superior_ti\'>(\'medio_tecnico\');\n  const [statusDiagnostico, setStatusDiagnostico] = useState<\'confirmado\' | \'em_investigacao_hipotese\'>(\'confirmado\');\n  const [categoriaNeurodivergencia, setCategoriaNeurodivergencia] = useState(\'Transtorno do D\303\251ficit de Aten\303\247\303\243o com Hiperatividade (TDAH)\');\n  const [mostrarOutrasCondicoes, setMostrarOutrasCondicoes] = useState(false);\n\n  // Form fields\n  const [nome, setNome] = useState(\'\');\n  const [matricula, setMatricula] = useState(\'\');\n  const [idade, setIdade] = useState(\'17 anos\');\n  const [curso, setCurso] = useState(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n  const [disciplina, setDisciplina] = useState(\'Programa\303\247\303\243o Web e Algoritmos\');\n  const [modulo, setModulo] = useState(\'2\302\272 Ano / Diurno\');\n  const [condicao, setCondicao] = useState(\'\');\n  const [potencialidades, setPotentialidades] = useState(\'\');\n  const [assistiveTech, setAssistiveTech] = useState(\'\');\n  const [solucaoId, setSolucaoId] = useState(\'sol-tdah\');\n  const [docenteRegente, setDocenteRegente] = useState(\'Prof. Docente da Disciplina\');\n  const [docenteAee] = useState(\'Prof\302\252. Renata Cavalcanti (NAPNE \302\267 Campus Para\303\255so)\');\n  const [benchmarkFeedback, setBenchmarkFeedback] = useState<string | null>(null);\n\n  // Loading state with dynamic step progress\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [stepMessage, setStepMessage] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  // Presets from PPC do BSI (Campus Para\303\255so) and Plano de Ensino de Engenharia de Software II (BAC.0406)\n  const presetsPpcEPlano = [\n    {\n      id: \'preset-eng-soft-2\',\n      tag: \'Plano de Ensino em Anexo\',\n      titulo: \'BAC.0406 - Engenharia de Software II\',\n      curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\',\n      modulo: \'4\302\272 Per\303\255odo / Noturno\',\n      docente: \'Prof. Alexandre Santos\',\n      perfil: \'superior_ti\' as const,\n      idade: \'21 anos\',\n      descricao: \'Qualidade (ISO 25010), TDD, Testes Automatizados (JUnit/Selenium) e Jira\',\n    },\n    {\n      id: \'preset-bd-sql\',\n      tag: \'PPC BSI \302\267 3\302\272/4\302\272 Per\303\255odo\',\n      titulo: \'Banco de Dados Relacional e SQL\',\n      curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\',\n      modulo: \'3\302\272 Per\303\255odo / Noturno\',\n      docente: \'Prof. Docente de Banco de Dados\',\n      perfil: \'superior_ti\' as const,\n      idade: \'20 anos\',\n      descricao: \'Normaliza\303\247\303\243o, \303\241lgebra relacional, DDL/DML e consultas SQL anal\303\255ticas\',\n    },\n    {\n      id: \'preset-algoritmos-bsi\',\n      tag: \'PPC BSI \302\267 1\302\272 Per\303\255odo\',\n      titulo: \'Algoritmos e L\303\263gica de Programa\303\247\303\243o\',\n      curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\',\n      modulo: \'1\302\272 Per\303\255odo / Noturno\',\n      docente: \'Prof. Docente de L\303\263gica e Algoritmos\',\n      perfil: \'superior_ti\' as const,\n      idade: \'19 anos\',\n      descricao: \'L\303\263gica estruturada, tabelas-verdade, estruturas de repeti\303\247\303\243o e vetores\',\n    },\n    {\n      id: \'preset-tecnico-web\',\n      tag: \'M\303\251dio T\303\251cnico \302\267 2\302\272 Ano\',\n      titulo: \'Programa\303\247\303\243o Web e Algoritmos\',\n      curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\n      modulo: \'2\302\272 Ano / Diurno\',\n      docente: \'Prof. Docente de Desenvolvimento Web\',\n      perfil: \'medio_tecnico\' as const,"
