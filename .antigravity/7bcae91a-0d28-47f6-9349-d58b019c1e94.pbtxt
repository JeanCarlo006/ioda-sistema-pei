              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      \'Fam\303\255lia acolhida pelo NAPNE Campus Para\303\255so, com alinhamento cont\303\255nuo sobre os apoios pedag\303\263gicos em sala de aula.\',"
