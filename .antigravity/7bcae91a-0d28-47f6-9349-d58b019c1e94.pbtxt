  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { UserPlus, Printer, Wrench, Building2, BarChart2 } from \'lucide-react\';\nimport { estatisticasCampusParaiso } from \'../data/initialCases\';\n\ninterface NavbarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  onOpenAddStudent: () => void;\n  onOpenSolutionBank: () => void;\n  onOpenCampusStats?: () => void;\n  onPrint: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  setActiveTab,\n  onOpenAddStudent,\n  onOpenSolutionBank,\n  onOpenCampusStats,\n  onPrint,\n}) => {\n  const stats = estatisticasCampusParaiso;\n  const navItems = [\n    { id: \'pei\', label: \'Plano de Ensino (PEI & DUA 3.0)\' },\n    { id: \'estudo_caso\', label: \'Estudo de Caso & Barreiras\' },\n    { id: \'documento_oficial\', label: \'Modelo Oficial NAPNE / MEC\' },\n    { id: \'painel\', label: \'Painel de Suporte Docente\' },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-30 bg-white border-b border-slate-200 no-print\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between gap-6 h-16\">\n          {/* Zone 1: Wordmark */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"w-9 h-9 rounded-lg bg-emerald-800 flex items-center justify-center text-white font-bold text-lg shadow-xs\">\n              I\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <a\n                  href=\"#\"\n                  onClick={(e) => {\n                    e.preventDefault();\n                    setActiveTab(\'pei\');\n                  }}\n                  className=\"text-lg font-bold tracking-tight text-slate-900 whitespace-nowrap shrink-0 hover:text-emerald-800 transition-colors block leading-tight\"\n                >\n                  Ioda\n                </a>\n                <span className=\"hidden sm:inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-900 bg-emerald-100 px-2 py-0.5 rounded font-mono\">\n                  Campus Para\303\255so\n                </span>\n              </div>\n              <span className=\"hidden sm:inline-block text-[11px] text-slate-500\">\n                Inclusion on Diversity Agent \302\267 NAPNE\n              </span>\n            </div>\n          </div>\n\n          {/* Zone 2: Navigation Links */}\n          <nav className=\"hidden lg:flex items-center gap-1 xl:gap-2 text-sm font-medium text-slate-600\">\n            {navItems.map((item) => {\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => setActiveTab(item.id)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n                    isActive\n                      ? \'bg-slate-100 text-emerald-900\'\n                      : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n                  }`}\n                >\n                  {item.label}\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Zone 3: Actions */}\n          <div className=\"flex items-center gap-2 shrink-0\">\n            {onOpenCampusStats && (\n              <button\n                onClick={onOpenCampusStats}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-emerald-900 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n                title=\"Estat\303\255sticas e Neurodiverg\303\252ncias do Campus Para\303\255so\"\n              >\n                <BarChart2 className=\"w-3.5 h-3.5 text-emerald-700\" />\n                <span className=\"hidden sm:inline\">Censo Campus</span>\n                <span className=\"font-mono bg-emerald-200 text-emerald-950 px-1.5 py-0.2 rounded text-[10px]\">\n                  {stats.estudantes_geral}\n                </span>\n              </button>\n            )}\n\n            <button\n              onClick={onOpenSolutionBank}\n              className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              title=\"Banco de Solu\303\247\303\265es Pedag\303\263gicas para Condi\303\247\303\265es em TI\"\n            >\n              <Wrench className=\"w-3.5 h-3.5 text-slate-600\" />\n              <span className=\"hidden sm:inline\">Banco de Solu\303\247\303\265es</span>\n            </button>\n\n            <button\n              onClick={onPrint}\n              className=\"hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              title=\"Imprimir PEI\"\n            >\n              <Printer className=\"w-3.5 h-3.5 text-slate-500\" />\n              Imprimir\n            </button>\n\n            <button\n              onClick={onOpenAddStudent}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer shadow-xs\"\n            >\n              <UserPlus className=\"w-3.5 h-3.5 text-emerald-200\" />\n              + Novo Estudante\n            </button>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Navbar.tsx"
        }
        overwrite: true
      }
    }
