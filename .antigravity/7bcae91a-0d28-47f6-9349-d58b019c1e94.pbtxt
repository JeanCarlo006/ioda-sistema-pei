            }
            lines {
              text: "      representacao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Materiais did\303\241ticos sintetizados e organizados no AVA Moodle; roteiros objetivos que evitam a sensa\303\247\303\243o de sobrecarga cognitiva ou volume inating\303\255vel de tarefas.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      acaoExpressao:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Entregas fracionadas semanais; avalia\303\247\303\243o cont\303\255nua formativa que substitui provas de grande peso emocional; tempo estendido (+50%) em laborat\303\263rio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "      recursosTA: ["
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
