              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        descricao: \'Avalia\303\247\303\265es pr\303\241ticas de programa\303\247\303\243o com exig\303\252ncia de digita\303\247\303\243o manual sob press\303\243o temporal restrita (ex: implementar 3 algoritmos em 50 minutos).\',"
