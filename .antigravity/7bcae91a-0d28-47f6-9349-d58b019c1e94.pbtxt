      thinking_signature: "\022\301\001\n\276\001\001i\024}\023\3442\375\302\372\031kYt7\271!\324\001\215,.\310a\343=\a\220\020\370\211Rj\303~O\263\277\036\021\355\251\225\355\343\251\276c\361[\305\213L\262\fA\244ekD\346\202\214\242\n\252}\374O\372\276\376o\300c.\034a\2005<\377YTI0bS\036\231\334]|\027\256\375\254\316=\221%C\333\317/\005\177\215\306\264\3766s\217\311\001;pT\255*\230]\032\226`\003\366\307\321{g^A\235\v\223\254\247G\212\360e\340[O\232\236}\304?\340\003y\241\301\365\240UlavY\230\234F\247\356\22178\260\214\274\222%l\222*Z\223\262h\255Y\336(.X."
