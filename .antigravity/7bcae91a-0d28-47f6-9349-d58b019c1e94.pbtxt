    replacement_infos {
      original_chunk {
        target_content: "  const navItems = [\n    { id: \'pei\', label: \'Plano de Ensino (PEI & DUA 3.0)\' },\n    { id: \'estudo_caso\', label: \'Estudo de Caso & Barreiras\' },\n    { id: \'documento_oficial\', label: \'Modelo Oficial NAPNE / MEC\' },\n    { id: \'painel\', label: \'Painel de Suporte Docente\' },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-30 bg-white border-b border-slate-200 no-print transition-colors\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between gap-4 h-16\">\n          {/* Zone 1: Wordmark */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"w-9 h-9 rounded-lg bg-emerald-800 flex items-center justify-center text-white font-bold text-lg shadow-xs\">\n              I\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <a\n                  href=\"#\"\n                  onClick={(e) => {\n                    e.preventDefault();\n                    setActiveTab(\'pei\');\n                  }}\n                  className=\"text-lg font-bold tracking-tight text-slate-900 whitespace-nowrap shrink-0 hover:text-emerald-800 transition-colors block leading-tight\"\n                >\n                  Ioda\n                </a>\n                <span className=\"hidden sm:inline-flex items-center gap-1 text-[10px] font-semibold text-emerald-900 bg-emerald-100 px-2 py-0.5 rounded font-mono\">\n                  Campus Para\303\255so\n                </span>\n              </div>\n              <span className=\"hidden sm:inline-block text-[11px] text-slate-500\">\n                Inclusion on Diversity Agent \302\267 NAPNE\n              </span>\n            </div>\n          </div>\n\n          {/* Zone 2: Navigation Links */}\n          <nav className=\"hidden lg:flex items-center gap-1 xl:gap-2 text-sm font-medium text-slate-600\">\n            {navItems.map((item) => {\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => setActiveTab(item.id)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n                    isActive\n                      ? \'bg-slate-100 text-emerald-900 font-bold\'\n                      : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n                  }`}\n                >\n                  {item.label}\n                </button>\n              );\n            })}\n          </nav>"
        replacement_content: "  const navItems = [\n    { id: \'hub\', label: \'Hub de Ferramentas\' },\n    { id: \'pei\', label: \'Plano de Ensino (PEI)\' },\n    { id: \'estudo_caso\', label: \'Estudo de Caso & DUA\' },\n    { id: \'documento_oficial\', label: \'Modelo Oficial IFTO\' },\n    { id: \'painel\', label: \'Painel & Metas\' },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-30 bg-white border-b border-slate-200/90 no-print transition-colors shadow-2xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between gap-4 h-16\">\n          {/* Zone 1: Wordmark iLovePDF-style (i\360\237\222\232PEI) */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <button\n              onClick={() => setActiveTab(\'hub\')}\n              className=\"flex items-center gap-1.5 text-left group cursor-pointer\"\n              title=\"Voltar ao Hub Principal i\360\237\222\232PEI\"\n            >\n              <span className=\"text-2xl font-black tracking-tighter text-slate-900 group-hover:text-emerald-700 transition-colors\">\n                I\n              </span>\n              <span className=\"text-xl sm:text-2xl leading-none\" role=\"img\" aria-label=\"cora\303\247\303\243o verde\">\n                \360\237\222\232\n              </span>\n              <span className=\"text-2xl font-black tracking-tighter text-slate-900 group-hover:text-emerald-700 transition-colors\">\n                PEI\n              </span>\n              <span className=\"ml-1 hidden sm:inline-flex items-center gap-1 text-[10px] font-bold text-emerald-900 bg-emerald-100 px-2 py-0.5 rounded-full font-mono uppercase tracking-wider\">\n                Ioda AI\n              </span>\n            </button>\n          </div>\n\n          {/* Zone 2: Navigation Links (matching iLovePDF top menu) */}\n          <nav className=\"hidden lg:flex items-center gap-1 text-sm font-semibold text-slate-600\">\n            {navItems.map((item) => {\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => setActiveTab(item.id)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n                    isActive\n                      ? \'bg-slate-900 text-white shadow-2xs\'\n                      : \'text-slate-700 hover:text-slate-950 hover:bg-slate-100\'\n                  }`}\n                >\n                  {item.label}\n                </button>\n              );\n            })}\n          </nav>"
        start_line: 32
        end_line: 88
      }
