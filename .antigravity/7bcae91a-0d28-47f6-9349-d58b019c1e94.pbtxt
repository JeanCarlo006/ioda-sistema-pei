    content: "    },\n  },\n  {\n    id: \'sol-baixa-visao-sql\',\n    titulo: \'Defici\303\252ncia Visual / Baixa Vis\303\243o Severa em Banco de Dados e Sistemas\',\n    condicao: \'Retinopatia, Glaucoma, Baixa Vis\303\243o Severa, Cegueira\',\n    nivelSugerido: \'Superior TI\',\n    descricaoProblema:\n      \'Diagramas visuais de Modelo Entidade-Relacionamento (MER) em imagens rasterizadas (.png/.jpg) s\303\243o completamente inacess\303\255veis a leitores de tela.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Envolvimento em projetos reais de modelagem de dados para sistemas p\303\272blicos e e-commerce acess\303\255vel, valorizando o racioc\303\255nio abstrato.\',\n      representacao:\n        \'Substitui\303\247\303\243o de diagramas gr\303\241ficos por linguagens declarativas acess\303\255veis (DBML / YAML / scripts SQL DDL comentados) e audiodescri\303\247\303\243o em sala.\',\n      acaoExpressao:\n        \'Intera\303\247\303\243o com o banco de dados via terminal CLI (PostgreSQL psql, SQLite) integrado a leitor de telas e entrega de scripts .sql puros.\',\n      recursosTA: [\n        \'Leitor de telas NVDA / Orca com voz pt-BR configurada\',\n        \'Terminal com alto contraste invertido e fonte monoespa\303\247ada 22pt+\',\n        \'Monitor de 27 a 32 polegadas com bra\303\247o articulado pantogr\303\241fico\',\n        \'Documenta\303\247\303\243o t\303\251cnica em Markdown ou LaTeX acess\303\255vel\',\n      ],\n      avaliacaoAcessivel:\n        \'Resolu\303\247\303\243o de problemas de consultas anal\303\255ticas via terminal de testes com tempo estendido e semin\303\241rio com defesa oral.\',\n    },\n  },\n  {\n    id: \'sol-tea-sensorial-redes\',\n    titulo: \'Transtorno do Espectro Autista (TEA) & Hipersensibilidade em Datacenter/Redes\',\n    condicao: \'TEA (N\303\255vel 1 de suporte), Hipersensibilidade Auditiva e Sensorial\',\n    nivelSugerido: \'M\303\251dio T\303\251cnico\',\n    descricaoProblema:\n      \'O ru\303\255do cont\303\255nuo de ventiladores de servidores, switches e cabos no laborat\303\263rio somado a instru\303\247\303\265es orais amb\303\255guas causa sobrecarga sensorial.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Desafios de ciberseguran\303\247a e redes com regras expl\303\255citas; previsibilidade de cronograma de laborat\303\263rio com anteced\303\252ncia de duas semanas.\',\n      representacao:\n        \'Roteiros passo a passo em formato de checklist numerado sem met\303\241foras; simula\303\247\303\265es visuais da transmiss\303\243o de pacotes no Cisco Packet Tracer.\',\n      acaoExpressao:\n        \'Demonstra\303\247\303\243o da configura\303\247\303\243o atrav\303\251s de arquivos de topologia (.pkt) e sa\303\255da de comandos de terminal, com tempo estendido.\',\n      recursosTA: [\n        \'Abafador de ru\303\255dos circum-aural (concha) com certifica\303\247\303\243o NRR 27dB+\',\n        \'Software simulador de redes Cisco Packet Tracer\',\n        \'Checklist t\303\251cnico de bancada com fluxo de configura\303\247\303\243o de switches\',\n        \'Cart\303\243o de pausa visual para sinaliza\303\247\303\243o discreta ao docente\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o pr\303\241tica no simulador e na bancada com roteiro objetivo e sem press\303\243o de comunica\303\247\303\243o informal desestruturada.\',\n    },\n  },\n  {\n    id: \'sol-tdah-desenvolvimento\',\n    titulo: \'TDAH / Dificuldade de Sustenta\303\247\303\243o de Aten\303\247\303\243o em Projetos de Software\',\n    condicao: \'Transtorno do D\303\251ficit de Aten\303\247\303\243o e Hiperatividade (TDAH)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade de planejar entregas de longo prazo em projetos de TI, desaten\303\247\303\243o a detalhes sint\303\241ticos e procrastina\303\247\303\243o por sobrecarga.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Quebra de projetos complexos em micro-entregas semanais (metodologia \303\241gil/Scrum com sprints de 7 dias) e gamifica\303\247\303\243o de conquistas.\',\n      representacao:\n        \'Instru\303\247\303\265es curtas em t\303\263picos destacados; uso de linters estritos que apontam erros de sintaxe em tempo real com cores n\303\255tidas.\',\n      acaoExpressao:\n        \'Possibilidade de demonstrar o aprendizado em pequenos marcos incrementais de c\303\263digo funcional.\',\n      recursosTA: [\n        \'Aplicativos de gest\303\243o visual de tarefas (Kanban / Trello / GitHub Projects)\',\n        \'Extens\303\265es de foco e linter (Error Lens, Prettier, Todo Tree)\',\n        \'Temporizadores de t\303\251cnica Pomodoro integrados \303\240 rotina de laborat\303\263rio\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o processual somativa com notas atribu\303\255das a cada sprint entregue, mitigando o peso de uma \303\272nica prova final te\303\263rica.\',\n    },\n  },\n  {\n    id: \'sol-surdez-ti\',\n    titulo: \'Surdez / Defici\303\252ncia Auditiva em Cursos de Tecnologia da Informa\303\247\303\243o\',\n    condicao: \'Surdez, Defici\303\252ncia Auditiva Bilateral\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Aulas expositivas r\303\241pidas e termos t\303\251cnicos de inform\303\241tica em ingl\303\252s sem tradutor int\303\251rprete de Libras ou legendagem dificultam o acompanhamento.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Valoriza\303\247\303\243o do estudante em projetos de acessibilidade digital e design visual de interfaces.\',\n      representacao:\n        \'Disponibiliza\303\247\303\243o de slides e c\303\263digos antes da aula expositiva; presen\303\247a de Tradutor Int\303\251rprete de Libras com vocabul\303\241rio t\303\251cnico de TI.\',\n      acaoExpressao:\n        \'Submiss\303\243o de c\303\263digo documentado, diagramas arquiteturais e relat\303\263rios textuais ou sinalizados em Libras gravados em v\303\255deo.\',\n      recursosTA: [\n        \'Softwares de transcri\303\247\303\243o de \303\241udio em tempo real e legendagem autom\303\241tica\',\n        \'Gloss\303\241rio de sinais de Libras para termos computacionais (algoritmo, banco de dados, rede)\',\n        \'Fones com amplifica\303\247\303\243o sonora para estudantes com res\303\255duo auditivo\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\265es pr\303\241ticas com apoio de int\303\251rprete de Libras para esclarecimento de d\303\272vidas e tempo estendido.\',\n    },\n  },\n  {\n    id: \'sol-hipotese-sem-laudo\',\n    titulo: \'Hip\303\263tese Diagn\303\263stica / Em Investiga\303\247\303\243o pelo NAPNE (Sem Laudo - Portaria MEC 421/2026)\',\n    condicao: \'Hip\303\263tese de neurodiverg\303\252ncia ou transtorno em processo avaliativo (5 casos no Campus Para\303\255so)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade acad\303\252mica persistente em sala ou laborat\303\263rio de TI sem que o estudante possua laudo m\303\251dico com CID fechado, gerando receio docente ou risco de nega\303\247\303\243o indevida de apoios.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Garantia legal imediata de direitos: a Portaria MEC n\302\272 421/2026 e o Decreto 12.686/2025 asseguram que o PEI independe de laudo cl\303\255nico, focando na acolhida pedag\303\263gica e redu\303\247\303\243o da ansiedade.\',\n      representacao:\n        \'Diversifica\303\247\303\243o multissensorial dos conte\303\272dos (roteiros em t\303\263picos, recursos visuais, esquemas e \303\241udio explicativo); disponibiliza\303\247\303\243o pr\303\251via de materiais antes das aulas de laborat\303\263rio.\',\n      acaoExpressao:\n        \'Tempo estendido (+50%) em todas as avalia\303\247\303\265es, toler\303\242ncia a erros pontuais de ortografia de c\303\263digo, permiss\303\243o de consulta orientada e possibilidade de defesa oral da l\303\263gica.\',\n      recursosTA: [\n        \'Tempo estendido (+50%) em provas e projetos pr\303\241ticos\',\n        \'Extens\303\265es de aux\303\255lio visual e linter de c\303\263digo na IDE\',\n        \'Formul\303\241rio de observa\303\247\303\243o pedag\303\263gica cont\303\255nua do NAPNE Campus Para\303\255so\',\n        \'Enunciados com metodologia DUA em formato claro e direto\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o diagn\303\263stica e formativa processual com feedback imediato, sem depend\303\252ncia de prova \303\272nica cronometrada.\',\n    },\n  },\n  {\n    id: \'sol-tdah-ahsd-dupla\',\n    titulo: \'Dupla Excepcionalidade (TDAH + Altas Habilidades/Superdota\303\247\303\243o em TI)\',\n    condicao: \'TDAH Combinado com Altas Habilidades / Superdota\303\247\303\243o (AH/SD)\',\n    nivelSugerido: \'Superior TI\',\n    descricaoProblema:\n      \'Velocidade e capacidade de abstra\303\247\303\243o l\303\263gica muito elevadas contrastando com procrastina\303\247\303\243o severa, dispers\303\243o com rotinas burocr\303\241ticas e desmotiva\303\247\303\243o com aulas puramente expositivas.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Enriquecimento curricular com desafios de ponta (arquitetura de software, IA, microsservi\303\247os) e metodologia \303\241gil (Scrum) com gamifica\303\247\303\243o e feedback frequente.\',\n      representacao:\n        \'Instru\303\247\303\265es curtas e visuais em t\303\263picos destacados; reposit\303\263rios modelo no GitHub com README comentados.\',\n      acaoExpressao:\n        \'Micro-sprints semanais com entregas cont\303\255nuas em Kanban (GitHub Projects), aceita\303\247\303\243o de documenta\303\247\303\243o t\303\251cnica em Markdown e screencasts curtos.\',\n      recursosTA: [\n        \'Quadro Kanban digital integrado ao GitHub Projects\',\n        \'Extens\303\265es de foco e linter no VS Code (Pomodoro Timer, Todo Tree)\',\n        \'Templates de documenta\303\247\303\243o t\303\251cnica em Markdown\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o processual somativa por marcos parciais semanais entregues, eliminando a depend\303\252ncia de grandes entregas acumuladas.\',\n    },\n  },\n  {\n    id: \'sol-dislexia-sintaxe\',\n    titulo: \'Dislexia & Transtorno de Aprendizagem em Sintaxe de Programa\303\247\303\243o\',\n    condicao: \'Dislexia do desenvolvimento, disgrafia ou trocas de caracteres de c\303\263digo\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade para decodificar sintaxe estrita de c\303\263digo em compiladores r\303\255gidos, troca de caracteres especiais (;, {}, ()) e fadiga intensa na leitura de enunciados densos.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Acolhimento pedag\303\263gico seguro que remove a puni\303\247\303\243o por pequenos erros sint\303\241ticos, valorizando o racioc\303\255nio e a resolu\303\247\303\243o do problema.\',\n      representacao:\n        \'Fontes tipogr\303\241ficas especializadas (OpenDyslexic Mono, JetBrains Mono), destaque colorido de pares de chaves e tabelas visuais com casos de teste (Input/Output).\',\n      acaoExpressao:\n        \'Permiss\303\243o de IDE com linters visuais que corrigem ou real\303\247am erros de sintaxe em tempo real; tempo estendido (+50%) e defesa oral da l\303\263gica em caso de d\303\272vida.\',\n      recursosTA: [\n        \'Fontes acess\303\255veis OpenDyslexic Mono e Atkinson Hyperlegible\',\n        \'Extens\303\265es de linter visual no VS Code (Error Lens, Bracket Pair Colorizer)\',\n        \'Sintetizador de voz / leitor de tela para enunciados extensos\',\n        \'Gloss\303\241rio ilustrado de sintaxe e operadores l\303\263gicos\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o pr\303\241tica em laborat\303\263rio com apoio de linter e tempo ampliado; corre\303\247\303\243o focada no fluxo l\303\263gico e n\303\243o na memoriza\303\247\303\243o mec\303\242nica de pontua\303\247\303\243o.\',\n    },\n  },\n];\n\n// Gerador R\303\241pido de Novo PEI Completo para Aluno Cadastrado\nexport function gerarNovoPeiCompleto(dados: {"
