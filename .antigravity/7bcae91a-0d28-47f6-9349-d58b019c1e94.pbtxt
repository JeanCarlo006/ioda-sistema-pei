            }
            lines {
              text: "      avaliacao_pratica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Enunciados 100% objetivos com rubrica anal\303\255tica entregue junto com a prova (indicando exatamente quantos pontos vale cada requisito t\303\251cnico). Permita apresenta\303\247\303\243o individual para o professor ou v\303\255deo gravado em vez de exposi\303\247\303\243o diante da turma.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      manejo_e_acolhimento:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Caso haja desconforto sensorial por barulho ou mudan\303\247a imprevista no laborat\303\263rio, permita imediatamente o uso do abafador auricular ou uma pausa de 5 a 10 minutos fora da sala sem necessidade de justificativa p\303\272blica.\',"
