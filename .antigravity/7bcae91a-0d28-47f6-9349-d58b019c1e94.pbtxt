            }
            lines {
              text: "    adaptacao_flexibilizacao_curricular:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Curr\303\255culo comum assegurado sem redu\303\247\303\243o de objetivos cognitivos. Acessibiliza\303\247\303\243o conceitual realizada pela representa\303\247\303\243o com uniformes e figurinhas de futebol.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
