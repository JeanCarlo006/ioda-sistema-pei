      id: "call_1003484"
      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Format student switcher button name cleanly for anonymized student codes\", \"EndLine\":204, \"Instruction\":\"Display anonymized student identifier like INF-01 or BSI-02 cleanly on switcher buttons\", \"ReplacementContent\":\"              const shortName = c.cabecalho.estudante.includes(\'(\')\\n                ? c.cabecalho.estudante.split(\'(\')[0].replace(\'Estudante\', \'\').trim()\\n                : c.cabecalho.estudante;\\n\\n              return (\\n                <button\\n                  key={c.id}\\n                  onClick={() => onSelectCase(c)}\\n                  className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer flex items-center gap-1.5 ${\\n                    isCurrent\\n                      ? \'bg-slate-900 text-white font-semibold shadow-xs\'\\n                      : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n                  }`}\\n                >\\n                  <span className=\\\"font-semibold\\\">{shortName || c.cabecalho.codigo_matricula}</span>\\n                  <span className=\\\"text-[10px] opacity-80\\\">\\n                    {studSuperior ? \'(Sup TI)\' : studTecnico ? \'(M\303\251dio)\' : \'\'}\\n                  </span>\", \"StartLine\":190, \"TargetContent\":\"              return (\\n                <button\\n                  key={c.id}\\n                  onClick={() => onSelectCase(c)}\\n                  className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer flex items-center gap-1.5 ${\\n                    isCurrent\\n                      ? \'bg-slate-900 text-white font-semibold shadow-xs\'\\n                      : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\\n                  }`}\\n                >\\n                  <span className=\\\"font-semibold\\\">{c.cabecalho.estudante.split(\' \')[0]}</span>\\n                  <span className=\\\"text-[10px] opacity-80\\\">\\n                    {studSuperior ? \'(Sup TI)\' : studTecnico ? \'(M\303\251dio)\' : \'\'}\\n                  </span>\", \"TargetFile\":\"/src/components/StudentHeader.tsx\", \"toolAction\":\"Editing student identifier formatting\", \"toolSummary\":\"Display anonymized student ID in buttons\"}"
