            }
            lines {
              text: "      engajamento:"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Apoio tutorial pr\303\263ximo pelo docente e NAPNE; inclus\303\243o em duplas colaborativas acolhedoras (Pair Programming); celebra\303\247\303\243o e registro expl\303\255cito de cada avan\303\247o alcan\303\247ado.\',"
