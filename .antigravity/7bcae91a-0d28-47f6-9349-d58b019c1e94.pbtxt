      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { SolucaoCondicao, PEICompleto } from \'../types/pei\';\\nimport { bancoDeSolucoesPedagogicas } from \'../data/initialCases\';\\nimport { BookOpen, Check, Wrench, X, Sparkles, Layers, ShieldCheck, ArrowRight } from \'lucide-react\';\\n\\ninterface SolutionBankModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  activePei: PEICompleto;\\n  onApplySolution: (solucao: SolucaoCondicao) => void;\\n}\\n\\nexport const SolutionBankModal: React.FC<SolutionBankModalProps> = ({\\n  isOpen,\\n  onClose,\\n  activePei,\\n  onApplySolution,\\n}) => {\\n  const [selectedSolution, setSelectedSolution] = useState<SolucaoCondicao>(\\n    bancoDeSolucoesPedagogicas[0]\\n  );\\n  const [appliedSuccess, setAppliedSuccess] = useState(false);\\n\\n  if (!isOpen) return null;\\n\\n  const handleApply = () => {\\n    onApplySolution(selectedSolution);\\n    setAppliedSuccess(true);\\n    setTimeout(() => {\\n      setAppliedSuccess(false);\\n      onClose();\\n    }, 1200);\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto\\\">\\n      <div className=\\\"bg-white rounded-2xl max-w-4xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 my-8\\\">\\n        {/* Header */}\\n        <div className=\\\"flex items-center justify-between pb-4 border-b border-slate-100 mb-6\\\">\\n          <div className=\\\"flex items-center gap-2.5\\\">\\n            <div className=\\\"w-9 h-9 rounded-xl bg-teal-100 flex items-center justify-center text-teal-800\\\">\\n              <Wrench className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <h3 className=\\\"text-base sm:text-lg font-bold text-slate-900\\\">\\n                Guia de Aux\303\255lio & Banco de Solu\303\247\303\265es Pedag\303\263gicas para Condi\303\247\303\265es em TI\\n              </h3>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                Estrat\303\251gias baseadas no DUA 3.0 e Tecnologia Assistiva para cursos T\303\251cnicos e Superiores de TI\\n              </p>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-1 text-slate-400 hover:text-slate-600 rounded-lg cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Two-column layout: List of conditions & detailed solutions */}\\n        <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-6\\\">\\n          {/* Solution Selector Sidebar */}\\n          <div className=\\\"space-y-2 border-r border-slate-100 pr-0 md:pr-4\\\">\\n            <span className=\\\"text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-2\\\">\\n              Condi\303\247\303\265es & Barreiras Mapeadas:\\n            </span>\\n            {bancoDeSolucoesPedagogicas.map((sol) => {\\n              const isSelected = selectedSolution.id === sol.id;\\n              return (\\n                <button\\n                  key={sol.id}\\n                  onClick={() => setSelectedSolution(sol)}\\n                  className={`w-full text-left p-3 rounded-xl border transition-all cursor-pointer ${\\n                    isSelected\\n                      ? \'bg-emerald-50/70 border-emerald-500 text-emerald-950 font-semibold shadow-xs\'\\n                      : \'bg-slate-50 border-slate-200 text-slate-700 hover:bg-white\'\\n                  }`}\\n                >\\n                  <div className=\\\"flex items-center justify-between mb-1\\\">\\n                    <span className=\\\"text-xs font-bold leading-tight\\\">{sol.titulo}</span>\\n                  </div>\\n                  <span className=\\\"text-[10px] text-slate-500 block truncate\\\">\\n                    {sol.condicao}\\n                  </span>\\n                </button>\\n              );\\n            })}\\n          </div>\\n\\n          {/* Detailed Solutions View */}\\n          <div className=\\\"md:col-span-2 space-y-4\\\">\\n            <div className=\\\"p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-2\\\">\\n              <div className=\\\"flex items-center justify-between\\\">\\n                <h4 className=\\\"text-sm font-bold text-slate-900\\\">{selectedSolution.titulo}</h4>\\n                <span className=\\\"text-[11px] font-mono text-emerald-800 bg-emerald-100 px-2 py-0.5 rounded\\\">\\n                  Recomendado: {selectedSolution.nivelSugerido}\\n                </span>\\n              </div>\\n              <p className=\\\"text-xs text-slate-600 leading-relaxed\\\">\\n                <strong className=\\\"text-slate-800\\\">Desafio / Barreira T\303\255pica:</strong>{\' \'}\\n                {selectedSolution.descricaoProblema}\\n              </p>\\n            </div>\\n\\n            {/* DUA Solutions 3 Pillars */}\\n            <div className=\\\"space-y-3\\\">\\n              <span className=\\\"text-xs font-bold text-slate-800 uppercase tracking-wider block\\\">\\n                Solu\303\247\303\265es DUA 3.0 para Aplica\303\247\303\243o no PEI:\\n              </span>\\n\\n              <div className=\\\"p-3 bg-amber-50/60 border border-amber-200 rounded-lg text-xs space-y-1\\\">\\n                <strong className=\\\"text-amber-900 block font-semibold\\\">1. Meios de Engajamento:</strong>\\n                <p className=\\\"text-amber-950 leading-relaxed\\\">{selectedSolution.remediosSugeridos.engajamento}</p>\\n              </div>\\n\\n              <div className=\\\"p-3 bg-teal-50/60 border border-teal-200 rounded-lg text-xs space-y-1\\\">\\n                <strong className=\\\"text-teal-900 block font-semibold\\\">2. Meios de Representa\303\247\303\243o:</strong>\\n                <p className=\\\"text-teal-950 leading-relaxed\\\">{selectedSolution.remediosSugeridos.representacao}</p>\\n              </div>\\n\\n              <div className=\\\"p-3 bg-emerald-50/60 border border-emerald-200 rounded-lg text-xs space-y-1\\\">\\n                <strong className=\\\"text-emerald-900 block font-semibold\\\">3. Meios de A\303\247\303\243o e Express\303\243o:</strong>\\n                <p className=\\\"text-emerald-950 leading-relaxed\\\">{selectedSolution.remediosSugeridos.acaoExpressao}</p>\\n              </div>\\n\\n              <div className=\\\"p-3 bg-slate-100 border border-slate-200 rounded-lg text-xs space-y-1.5\\\">\\n                <strong className=\\\"text-slate-800 block font-semibold\\\">Tecnologias Assistivas e Ferramentas:</strong>\\n                <div className=\\\"flex flex-wrap gap-1.5\\\">\\n                  {selectedSolution.remediosSugeridos.recursosTA.map((ta, i) => (\\n                    <span key={i} className=\\\"bg-white border border-slate-300 text-slate-700 px-2 py-0.5 rounded text-[11px]\\\">\\n                      {ta}\\n                    </span>\\n                  ))}\\n                </div>\\n              </div>\\n\\n              <div className=\\\"p-3 bg-purple-50/60 border border-purple-200 rounded-lg text-xs space-y-1\\\">\\n                <strong className=\\\"text-purple-900 block font-semibold\\\">Estrat\303\251gia de Avalia\303\247\303\243o Acess\303\255vel:</strong>\\n                <p className=\\\"text-purple-950 leading-relaxed\\\">{selectedSolution.remediosSugeridos.avaliacaoAcessivel}</p>\\n              </div>\\n            </div>\\n\\n            {/* Action Bar */}\\n            <div className=\\\"pt-4 border-t border-slate-100 flex items-center justify-between\\\">\\n              <span className=\\\"text-xs text-slate-500\\\">\\n                Aplicar\303\241 estas solu\303\247\303\265es no PEI de <strong>{activePei.cabecalho.estudante}</strong>\\n              </span>\\n\\n              <button\\n                type=\\\"button\\\"\\n                onClick={handleApply}\\n                disabled={appliedSuccess}\\n                className={`inline-flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-lg transition-all cursor-pointer shadow-xs ${\\n                  appliedSuccess\\n                    ? \'bg-emerald-600 text-white\'\\n                    : \'bg-slate-900 hover:bg-slate-800 text-white\'\\n                }`}\\n              >\\n                {appliedSuccess ? (\\n                  <>\\n                    <Check className=\\\"w-4 h-4\\\" />\\n                    Solu\303\247\303\265es Aplicadas com Sucesso!\\n                  </>\\n                ) : (\\n                  <>\\n                    <Sparkles className=\\\"w-4 h-4 text-emerald-300\\\" />\\n                    Aplicar no PEI Atual\\n                  </>\\n                )}\\n              </button>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Create SolutionBankModal providing condition-specific pedagogical solutions and one-click injection into student PEI\", \"Overwrite\":true, \"TargetFile\":\"/src/components/SolutionBankModal.tsx\", \"toolAction\":\"Creating SolutionBankModal\", \"toolSummary\":\"Create SolutionBankModal component\"}"
      thinking_signature: "\022\315\005\n\312\005\001i\024}\023\237t\211\034]<\214Q\356q\022|\a\225\246%Ca[\023<\334^\336\246!\326ZCk\321\365E\337\326p\334I\004\250\275\340\304D\032E\313uiU^+\376\205o\346\315&\253W(\335L/\371\025\212\366\222|\322f\216\314,+\263\337\356\020\357\216\271\333\204\030\215\306\321\354\312B{\225\336)-]\f\234\210\303q\223\030\331\254g\ak\237zi\243\256\20660\304\b\271e\020\241\024NI\350\342\264UE\346l\245\202\231?r\350:\"\333X\266n}\016a4\320\v\247\227\264v\350\224\323bc\310(\3217\256C\337\220r\344\r\330%\245FK7\221\216\345dK\343\262D}%\300\366K\362\301\200\374:\016\263\302e`\226\375{\211\266\v<U$^`<1{H\342\016\350>ry\000}H\253\366\351\223\236\302O+\230\031\357Lf\202\227\205\022\362\236\245\374\373NDL\265w\240\352\022\350\f\021g\231\017w\352\265\b\222\222%\037\324!\372\335\310\260l)\320\034\224\2143Xs\203z\027\323\r\216\211\310\222H\025\301)\370H\030\213\225\233\v\2156\325\265\r\250\303UU;\2340\344S0\024\f\253D\341\035m\311p\024\356\027\036\006\353\200R\344\232\332G\000\364\221\331\337\016\033\247 \267!\343\266\327<Y\273\303\275\220\267q\211\273\374\320&{\227\301\263\377k\377\034\237m$\262f\360Mj\250\344s\233\331\357|\234\331\340\037\243{_(\324\'J\270$\223\322Cw\304E\266\364n\362\303\270t\213\312\342\022\303\260\371\202\b|\235\33719\220u^\022jF]\036F\373\025\312M\311#;\321A\242Yy\341pe\325\243\325+Y\276\241b\337\337d\247\205m\033]\236\'X\2568y*\206I\261\\\030\005\226\330./2iD\003 \\\216\275\305p%Z-,\201T\2536\332l\226s\264n,\334\332\211\"V\006=\002\227~\005Jcg\016L\321\327m\373\2619\035*\343},lZ\227\273B\341\033\222*\'\316\316\3338E\207\tI\f\000=\030\363<L\017\"Jy \027\004`R\300\'>\224n\006\257I\320-\311Z\217l\005\250\217\272\273S5\260\235\371\346\311\322|\231\227\340\vI\225\225\022\260EYl\244\006\033+\313\0254V\301\374q\335\004\356\035\377\353\230^\371\340\361\367\243Y\300\b\216+.p\2763[\253\214\363\347\005\327\304\247\317Uo?\3112\261\355\272\254\002~\206\206Rva^\366v\220\215\2355\300\2315\310o\253\317\250\032\320\352m\2230\266\022\20548+]\