  planner_response {
    thinking: "**Constructing Initial Files**\n\nI\'m currently focused on creating the foundational files: `OfficialTemplateView.tsx`, `src/index.css`, and `src/App.tsx`. The initial version of `OfficialTemplateView.tsx` will include the official IFTO logo within the official header. This will establish the initial structure for the template.\n\n\n**Designing the New Template**\n\nI\'ve been working on the design elements for the new template. I\'ve integrated the official NAPNE logo and IODA avatar, and finalized the title \"PEI - Plano de Ensino Individualizado\". I\'ve also focused on the student identification section. I\'m building out the structured tables with the correct styling for all eight sections, ensuring they match the specified format and headers. I\'m focusing on \"Identifica\303\247\303\243o\", and section headers with styling, and all 8 sections are in progress.\n\n\n"
    tool_calls {
      id: "call_304434"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { PEICompleto } from \'../types/pei\';\\nimport { Printer, Edit3, Save } from \'lucide-react\';\\n\\ninterface OfficialTemplateViewProps {\\n  pei: PEICompleto;\\n  onPrint: () => void;\\n  onUpdatePei?: (updatedPei: PEICompleto) => void;\\n}\\n\\nexport const OfficialTemplateView: React.FC<OfficialTemplateViewProps> = ({\\n  pei,\\n  onPrint,\\n  onUpdatePei,\\n}) => {\\n  const [isEditing, setIsEditing] = useState(false);\\n  const [editedPei, setEditedPei] = useState<PEICompleto>(pei);\\n\\n  React.useEffect(() => {\\n    if (!isEditing) {\\n      setEditedPei(pei);\\n    }\\n  }, [pei, isEditing]);\\n\\n  const handleSave = () => {\\n    if (onUpdatePei) {\\n      onUpdatePei(editedPei);\\n    }\\n    setIsEditing(false);\\n  };\\n\\n  const { cabecalho, historico_napne, planejamento_pei } = editedPei;\\n\\n  const textoMetodologiaCombinada = [\\n    `Engajamento: ${planejamento_pei.flexibilizacao_metodologica_dua.engajamento.join(\' \')}`,\\n    `Representa\303\247\303\243o: ${planejamento_pei.flexibilizacao_metodologica_dua.representacao.join(\' \')}`,\\n    `A\303\247\303\243o e Express\303\243o: ${planejamento_pei.flexibilizacao_metodologica_dua.acao_e_expressao.join(\' \')}`,\\n    planejamento_pei.guia_pratico_sala_de_aula\\n      ? `Passo a Passo em Aula: ${planejamento_pei.guia_pratico_sala_de_aula.passo_a_passo_explicacao} | Divis\303\243o de Tarefas: ${planejamento_pei.guia_pratico_sala_de_aula.divisao_tarefa_chunking.join(\' \')}`\\n      : \'\',\\n  ]\\n    .filter(Boolean)\\n    .join(\'\\\\n\\\\n\');\\n\\n  const textoAvaliacaoCombinada = [\\n    `Formato Acess\303\255vel: ${planejamento_pei.estrategias_avaliacao.formato_acessivel}`,\\n    `Crit\303\251rio de Sucesso e Avan\303\247o: ${planejamento_pei.estrategias_avaliacao.criterio_de_sucesso}`,\\n    `Tempo e Espa\303\247o: ${planejamento_pei.estrategias_avaliacao.tempo_e_espaco}`,\\n    `Recursos de Tecnologia Assistiva Utilizados: ${planejamento_pei.estrategias_avaliacao.recursos_utilizados.join(\', \')}.`,\\n  ].join(\'\\\\n\');\\n\\n  return (\\n    <div className=\\\"space-y-6\\\">\\n      {/* Top Action Bar (hidden in print) */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 shadow-2xs flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 no-print\\\">\\n        <div className=\\\"flex items-center gap-3\\\">\\n          <img\\n            src=\\\"/assets/ioda-avatar.png\\\"\\n            alt=\\\"IODA\\\"\\n            className=\\\"w-11 h-11 rounded-full object-cover border-2 border-emerald-500 bg-slate-900 shrink-0\\\"\\n          />\\n          <div>\\n            <span className=\\\"text-xs font-bold text-emerald-800 uppercase tracking-wider block\\\">\\n              Modelo Oficial Institucional \302\267 IFTO / NAPNE (Processo SEI)\\n            </span>\\n            <h2 className=\\\"text-base sm:text-lg font-bold text-slate-900\\\">\\n              PEI - Plano de Ensino Individualizado\\n            </h2>\\n            <p className=\\\"text-xs text-slate-500\\\">\\n              Documento formatado com cabe\303\247alho oficial, tabelas padronizadas e bloco de assinaturas\\n            </p>\\n          </div>\\n        </div>\\n\\n        <div className=\\\"flex items-center gap-2\\\">\\n          {isEditing ? (\\n            <button\\n              onClick={handleSave}\\n              className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 rounded-xl transition-colors cursor-pointer shadow-xs\\\"\\n            >\\n              <Save className=\\\"w-4 h-4\\\" />\\n              <span>Salvar Altera\303\247\303\265es</span>\\n            </button>\\n          ) : (\\n            <button\\n              onClick={() => setIsEditing(true)}\\n              className=\\\"inline-flex items-center gap-1.5 px-4 py-2 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 rounded-xl transition-colors cursor-pointer\\\"\\n            >\\n              <Edit3 className=\\\"w-4 h-4\\\" />\\n              <span>Editar Campos</span>\\n            </button>\\n          )}\\n\\n          <button\\n            onClick={onPrint}\\n            className=\\\"inline-flex items-center gap-2 px-4 py-2 text-xs font-bold text-white bg-slate-900 hover:bg-slate-800 rounded-xl transition-colors cursor-pointer shadow-xs whitespace-nowrap\\\"\\n          >\\n            <Printer className=\\\"w-4 h-4\\\" />\\n            <span>Imprimir / Salvar PDF</span>\\n          </button>\\n        </div>\\n      </div>\\n\\n      {/* A4 Official Printable Document Sheet */}\\n      <div className=\\\"official-print-sheet bg-white border border-slate-400 shadow-sm p-6 sm:p-10 max-w-4xl mx-auto text-black font-sans print:border-none print:shadow-none print:p-0 print:max-w-none\\\">\\n        {/* CABE\303\207ALHO OFICIAL IFTO + NAPNE + IODA + FOTO DO ESTUDANTE */}\\n        <table className=\\\"w-full border-collapse border border-black mb-4\\\">\\n          <tbody>\\n            <tr>\\n              {/* Logo Oficial IFTO (Campus Para\303\255so do Tocantins) */}\\n              <td className=\\\"border border-black p-3 w-1/4 align-middle\\\">\\n                <div className=\\\"flex items-center gap-2.5\\\">\\n                  {/* S\303\255mbolo Oficial IF (Grade de quadrados verdes e ponto vermelho) */}\\n                  <svg\\n                    viewBox=\\\"0 0 60 80\\\"\\n                    className=\\\"w-10 h-13 shrink-0\\\"\\n                    aria-label=\\\"Logo Instituto Federal do Tocantins\\\"\\n                  >\\n                    <circle cx=\\\"10\\\" cy=\\\"10\\\" r=\\\"8\\\" fill=\\\"#c8102e\\\" />\\n                    <rect x=\\\"24\\\" y=\\\"2\\\" width=\\\"14\\\" height=\\\"14\\\" rx=\\\"2\\\" fill=\\\"#00843d\\\" />\\n                    <rect x=\\\"42\\\" y=\\\"2\\\" width=\\\"14\\\" height=\\\"14\\\" rx=\\\"2\\\" fill=\\\"#00843d\\\" />\\n                    <rect x=\\\"2\\\" y=\\\"22\\\" width=\\\"14\\\" height=\\\"14\\\" rx=\\\"2\\\" fill=\\\"#00843d\\\" />\\n                    <rect x=\\\"24\\\" y=\\\"22\\\" width=\\\"14\\\" height=\\\"14\\\" rx=\\\"2\\\" fill=\\\"#00843d\\\" />\\n                    <rect x=\\\"2\\\" y=\\\"42\\\" width=\\\"14\\\" height=\\\"14\\\" rx=\\\"2\\\" fill=\\\"#00843d\\\" />\\n                    <rect x=\\\"24\\\" y=\\\"42\\\" width=\\\"14\\\" height=\\\"14\\\" rx=\\\"2\\\" fill=\\\"#00843d\\\" />\\n                    <rect x=\\\"42\\\" y=\\\"42\\\" width=\\\"14\\\" height=\\\"14\\\" rx=\\\"2\\\" fill=\\\"#00843d\\\" />\\n                    <rect x=\\\"2\\\" y=\\\"62\\\" width=\\\"14\\\" height=\\\"14\\\" rx=\\\"2\\\" fill=\\\"#00843d\\\" />\\n                    <rect x=\\\"24\\\" y=\\\"62\\\" width=\\\"14\\\" height=\\\"14\\\" rx=\\\"2\\\" fill=\\\"#00843d\\\" />\\n                  </svg>\\n                  <div className=\\\"leading-tight\\\">\\n                    <span className=\\\"block text-[10px] font-black uppercase tracking-tight text-slate-900\\\">\\n                      INSTITUTO FEDERAL\\n                    </span>\\n                    <span className=\\\"block text-[10px] font-bold text-emerald-800\\\">\\n                      Tocantins\\n                    </span>\\n                    <span className=\\\"block text-[9px] text-slate-600 mt-0.5\\\">\\n                      Campus Para\303\255so do Tocantins\\n                    </span>\\n                  </div>\\n                </div>\\n              </td>\\n\\n              {/* Centro: T\303\255tulo Institucional & Logo NAPNE / IODA */}\\n              <td className=\\\"border border-black p-3 text-center align-middle\\\">\\n                <div className=\\\"flex flex-col items-center justify-center\\\">\\n                  <div className=\\\"flex items-center justify-center gap-2 mb-1\\\">\\n                    <img\\n                      src=\\\"/assets/ioda-avatar.png\\\"\\n                      alt=\\\"Logo IODA NAPNE\\\"\\n                      className=\\\"w-8 h-8 rounded-full object-cover border border-emerald-700\\\"\\n                    />\\n                    <span className=\\\"text-[10px] font-bold uppercase tracking-wider text-slate-800\\\">\\n                      MINIST\303\211RIO DA EDUCA\303\207\303\203O \302\267 NAPNE / IFTO\\n                    </span>\\n                  </div>\\n                  <h1 className=\\\"text-base sm:text-lg font-black uppercase tracking-tight text-black\\\">\\n                    PEI - Plano de Ensino Individualizado\\n                  </h1>\\n                  <span className=\\\"text-[10px] text-slate-700 font-medium\\\">\\n                    N\303\272cleo de Atendimento \303\240s Pessoas com Necessidades Espec\303\255ficas\\n                  </span>\\n                </div>\\n              </td>\\n\\n              {/* Direita: Quadro de Foto / Identifica\303\247\303\243o do Estudante */}\\n              <td className=\\\"border border-black p-2 w-32 text-center align-middle bg-slate-50\\\">\\n                <div className=\\\"flex flex-col items-center justify-center min-h-[76px]\\\">\\n                  <span className=\\\"text-[9px] font-bold uppercase text-slate-600 leading-tight\\\">\\n                    Foto de\\n                  </span>\\n                  <span className=\\\"text-[10px] font-extrabold text-black uppercase mt-1 leading-tight\\\">\\n                    {cabecalho.estudante}\\n                  </span>\\n                  <span className=\\\"text-[9px] font-mono text-slate-600 mt-1\\\">\\n                    {cabecalho.codigo_matricula}\\n                  </span>\\n                </div>\\n              </td>\\n            </tr>\\n          </tbody>\\n        </table>\\n\\n        {/* 1. IDENTIFICA\303\207\303\203O */}\\n        <table className=\\\"w-full border-collapse border border-black mb-4 text-xs\\\">\\n          <thead>\\n            <tr>\\n              <th\\n                colSpan={2}\\n                className=\\\"border border-black bg-slate-200 py-1.5 px-3 text-left font-bold uppercase tracking-wide text-black\\\"\\n              >\\n                1. Identifica\303\247\303\243o\\n              </th>\\n            </tr>\\n          </thead>\\n          <tbody>\\n            <tr>\\n              <td className=\\\"border border-black py-1.5 px-3 w-1/2\\\">\\n                <strong>Docente:</strong>{\' \'}\\n                {isEditing ? (\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={cabecalho.docente_regente}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        cabecalho: { ...cabecalho, docente_regente: e.target.value },\\n                      })\\n                    }\\n                    className=\\\"w-full p-1 border border-slate-400 rounded mt-0.5 text-xs\\\"\\n                  />\\n                ) : (\\n                  <span>{cabecalho.docente_regente}</span>\\n                )}\\n              </td>\\n              <td className=\\\"border border-black py-1.5 px-3 w-1/2\\\">\\n                <strong>Nome do estudante:</strong>{\' \'}\\n                {isEditing ? (\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={cabecalho.estudante}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        cabecalho: { ...cabecalho, estudante: e.target.value },\\n                      })\\n                    }\\n                    className=\\\"w-full p-1 border border-slate-400 rounded mt-0.5 text-xs font-bold\\\"\\n                  />\\n                ) : (\\n                  <span className=\\\"font-bold\\\">{cabecalho.estudante}</span>\\n                )}\\n              </td>\\n            </tr>\\n            <tr>\\n              <td className=\\\"border border-black py-1.5 px-3\\\">\\n                <strong>Matr\303\255cula:</strong> <span>{cabecalho.codigo_matricula}</span>\\n              </td>\\n              <td className=\\\"border border-black py-1.5 px-3\\\">\\n                <strong>Curso:</strong>{\' \'}\\n                {isEditing ? (\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={cabecalho.curso}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        cabecalho: { ...cabecalho, curso: e.target.value },\\n                      })\\n                    }\\n                    className=\\\"w-full p-1 border border-slate-400 rounded mt-0.5 text-xs\\\"\\n                  />\\n                ) : (\\n                  <span>{cabecalho.curso}</span>\\n                )}\\n              </td>\\n            </tr>\\n            <tr>\\n              <td className=\\\"border border-black py-1.5 px-3\\\">\\n                <strong>Componente Curricular:</strong>{\' \'}\\n                {isEditing ? (\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={cabecalho.componente_curricular}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        cabecalho: { ...cabecalho, componente_curricular: e.target.value },\\n                      })\\n                    }\\n                    className=\\\"w-full p-1 border border-slate-400 rounded mt-0.5 text-xs\\\"\\n                  />\\n                ) : (\\n                  <span>{cabecalho.componente_curricular}</span>\\n                )}\\n              </td>\\n              <td className=\\\"border border-black py-1.5 px-3\\\">\\n                <strong>Per\303\255odo / M\303\263dulo:</strong>{\' \'}\\n                {isEditing ? (\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={cabecalho.modulo_periodo}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        cabecalho: { ...cabecalho, modulo_periodo: e.target.value },\\n                      })\\n                    }\\n                    className=\\\"w-full p-1 border border-slate-400 rounded mt-0.5 text-xs\\\"\\n                  />\\n                ) : (\\n                  <span>{cabecalho.modulo_periodo}</span>\\n                )}\\n              </td>\\n            </tr>\\n          </tbody>\\n        </table>\\n\\n        {/* 2. HIST\303\223RICOS CL\303\215NICO E FAMILIAR DO ESTUDANTE */}\\n        <table className=\\\"w-full border-collapse border border-black mb-4 text-xs\\\">\\n          <thead>\\n            <tr>\\n              <th className=\\\"border border-black bg-slate-200 py-1.5 px-3 text-left font-bold uppercase tracking-wide text-black\\\">\\n                2. Hist\303\263ricos Cl\303\255nico e Familiar do Estudante\\n              </th>\\n            </tr>\\n          </thead>\\n          <tbody>\\n            <tr>\\n              <td className=\\\"border border-black p-3\\\">\\n                <div className=\\\"font-bold text-black mb-1\\\">\\n                  Breve hist\303\263rico cl\303\255nico e familiar do estudante: (NAPNE)\\n                </div>\\n                {isEditing ? (\\n                  <textarea\\n                    value={historico_napne.breve_historico_clinico_familiar}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        historico_napne: {\\n                          ...historico_napne,\\n                          breve_historico_clinico_familiar: e.target.value,\\n                        },\\n                      })\\n                    }\\n                    rows={3}\\n                    className=\\\"w-full p-2 border border-slate-400 rounded text-xs\\\"\\n                  />\\n                ) : (\\n                  <p className=\\\"text-justify leading-relaxed\\\">\\n                    {historico_napne.breve_historico_clinico_familiar}\\n                  </p>\\n                )}\\n              </td>\\n            </tr>\\n            <tr>\\n              <td className=\\\"border border-black p-3\\\">\\n                <div className=\\\"font-bold text-black mb-1\\\">\\n                  Breve descri\303\247\303\243o da condi\303\247\303\243o espec\303\255fica do estudante: (NAPNE)\\n                </div>\\n                {isEditing ? (\\n                  <textarea\\n                    value={historico_napne.descricao_condicao_especifica}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        historico_napne: {\\n                          ...historico_napne,\\n                          descricao_condicao_especifica: e.target.value,\\n                        },\\n                      })\\n                    }\\n                    rows={3}\\n                    className=\\\"w-full p-2 border border-slate-400 rounded text-xs\\\"\\n                  />\\n                ) : (\\n                  <p className=\\\"text-justify leading-relaxed whitespace-pre-line\\\">\\n                    {historico_napne.descricao_condicao_especifica}\\n                  </p>\\n                )}\\n              </td>\\n            </tr>\\n          </tbody>\\n        </table>\\n\\n        {/* 3. INFORMA\303\207\303\225ES DOS PAIS (NAPNE) */}\\n        <table className=\\\"w-full border-collapse border border-black mb-4 text-xs\\\">\\n          <thead>\\n            <tr>\\n              <th className=\\\"border border-black bg-slate-200 py-1.5 px-3 text-left font-bold uppercase tracking-wide text-black\\\">\\n                3. Informa\303\247\303\265es dos Pais (NAPNE)\\n              </th>\\n            </tr>\\n          </thead>\\n          <tbody>\\n            <tr>\\n              <td className=\\\"border border-black p-3\\\">\\n                {isEditing ? (\\n                  <textarea\\n                    value={historico_napne.informacoes_dos_pais}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        historico_napne: {\\n                          ...historico_napne,\\n                          informacoes_dos_pais: e.target.value,\\n                        },\\n                      })\\n                    }\\n                    rows={2}\\n                    className=\\\"w-full p-2 border border-slate-400 rounded text-xs\\\"\\n                  />\\n                ) : (\\n                  <p className=\\\"text-justify leading-relaxed\\\">\\n                    {historico_napne.informacoes_dos_pais}\\n                  </p>\\n                )}\\n              </td>\\n            </tr>\\n          </tbody>\\n        </table>\\n\\n        {/* 4. PLANEJAMENTO DO COMPONENTE CURRICULAR */}\\n        <table className=\\\"w-full border-collapse border border-black mb-4 text-xs\\\">\\n          <thead>\\n            <tr>\\n              <th className=\\\"border border-black bg-slate-200 py-1.5 px-3 text-left font-bold uppercase tracking-wide text-black\\\">\\n                4. Planejamento do Componente Curricular\\n              </th>\\n            </tr>\\n          </thead>\\n          <tbody>\\n            <tr>\\n              <td className=\\\"border border-black p-3\\\">\\n                <div className=\\\"font-bold text-black mb-1\\\">Conte\303\272do (Ementa):</div>\\n                {isEditing ? (\\n                  <textarea\\n                    value={planejamento_pei.conteudo_ementa_oficial}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        planejamento_pei: {\\n                          ...planejamento_pei,\\n                          conteudo_ementa_oficial: e.target.value,\\n                        },\\n                      })\\n                    }\\n                    rows={2}\\n                    className=\\\"w-full p-2 border border-slate-400 rounded text-xs\\\"\\n                  />\\n                ) : (\\n                  <p className=\\\"text-justify leading-relaxed\\\">\\n                    {planejamento_pei.conteudo_ementa_oficial}\\n                  </p>\\n                )}\\n              </td>\\n            </tr>\\n            <tr>\\n              <td className=\\\"border border-black p-3\\\">\\n                <div className=\\\"font-bold text-black mb-1\\\">\\n                  Compet\303\252ncias e Habilidades (Ementa):\\n                </div>\\n                {isEditing ? (\\n                  <textarea\\n                    value={planejamento_pei.competencias_habilidades_ementa}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        planejamento_pei: {\\n                          ...planejamento_pei,\\n                          competencias_habilidades_ementa: e.target.value,\\n                        },\\n                      })\\n                    }\\n                    rows={2}\\n                    className=\\\"w-full p-2 border border-slate-400 rounded text-xs\\\"\\n                  />\\n                ) : (\\n                  <p className=\\\"text-justify leading-relaxed\\\">\\n                    {planejamento_pei.competencias_habilidades_ementa}\\n                  </p>\\n                )}\\n              </td>\\n            </tr>\\n          </tbody>\\n        </table>\\n\\n        {/* 5. ADAPTA\303\207\303\203O E FLEXIBILIZA\303\207\303\203O CURRICULAR */}\\n        <table className=\\\"w-full border-collapse border border-black mb-4 text-xs\\\">\\n          <thead>\\n            <tr>\\n              <th className=\\\"border border-black bg-slate-200 py-1.5 px-3 text-left font-bold uppercase tracking-wide text-black\\\">\\n                5. Adapta\303\247\303\243o e Flexibiliza\303\247\303\243o Curricular{\' \'}\\n                <span className=\\\"font-normal normal-case\\\">\\n                  (descrever os conte\303\272dos aplicados/adaptados)\\n                </span>\\n              </th>\\n            </tr>\\n          </thead>\\n          <tbody>\\n            <tr>\\n              <td className=\\\"border border-black p-3\\\">\\n                {isEditing ? (\\n                  <textarea\\n                    value={planejamento_pei.adaptacao_flexibilizacao_curricular}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        planejamento_pei: {\\n                          ...planejamento_pei,\\n                          adaptacao_flexibilizacao_curricular: e.target.value,\\n                        },\\n                      })\\n                    }\\n                    rows={3}\\n                    className=\\\"w-full p-2 border border-slate-400 rounded text-xs\\\"\\n                  />\\n                ) : (\\n                  <p className=\\\"text-justify leading-relaxed\\\">\\n                    {planejamento_pei.adaptacao_flexibilizacao_curricular}\\n                  </p>\\n                )}\\n              </td>\\n            </tr>\\n          </tbody>\\n        </table>\\n\\n        {/* 6. ADAPTA\303\207\303\203O E FLEXIBILIZA\303\207\303\203O METODOL\303\223GICA */}\\n        <table className=\\\"w-full border-collapse border border-black mb-4 text-xs\\\">\\n          <thead>\\n            <tr>\\n              <th className=\\\"border border-black bg-slate-200 py-1.5 px-3 text-left font-bold uppercase tracking-wide text-black\\\">\\n                6. Adapta\303\247\303\243o e Flexibiliza\303\247\303\243o Metodol\303\263gica{\' \'}\\n                <span className=\\\"font-normal normal-case\\\">\\n                  (descrever as pr\303\241ticas pedag\303\263gicas aplicadas/adaptadas)\\n                </span>\\n              </th>\\n            </tr>\\n          </thead>\\n          <tbody>\\n            <tr>\\n              <td className=\\\"border border-black p-3 space-y-1.5 leading-relaxed\\\">\\n                <p className=\\\"text-justify whitespace-pre-line\\\">{textoMetodologiaCombinada}</p>\\n              </td>\\n            </tr>\\n          </tbody>\\n        </table>\\n\\n        {/* 7. AVALIA\303\207\303\203O */}\\n        <table className=\\\"w-full border-collapse border border-black mb-4 text-xs\\\">\\n          <thead>\\n            <tr>\\n              <th className=\\\"border border-black bg-slate-200 py-1.5 px-3 text-left font-bold uppercase tracking-wide text-black\\\">\\n                7. Avalia\303\247\303\243o{\' \'}\\n                <span className=\\\"font-normal normal-case\\\">\\n                  (onde estava; o quanto o estudante avan\303\247ou):\\n                </span>\\n              </th>\\n            </tr>\\n          </thead>\\n          <tbody>\\n            <tr>\\n              <td className=\\\"border border-black p-3 leading-relaxed\\\">\\n                <p className=\\\"text-justify whitespace-pre-line\\\">{textoAvaliacaoCombinada}</p>\\n              </td>\\n            </tr>\\n          </tbody>\\n        </table>\\n\\n        {/* 8. OBSERVA\303\207\303\203O DO PROFESSOR / RESULTADO E OBJETIVOS ALCAN\303\207ADOS */}\\n        <table className=\\\"w-full border-collapse border border-black mb-8 text-xs\\\">\\n          <thead>\\n            <tr>\\n              <th className=\\\"border border-black bg-slate-200 py-1.5 px-3 text-left font-bold uppercase tracking-wide text-black\\\">\\n                8. Observa\303\247\303\243o do Professor \342\200\224 Resultado e Objetivos Alcan\303\247ados\\n              </th>\\n            </tr>\\n          </thead>\\n          <tbody>\\n            <tr>\\n              <td className=\\\"border border-black p-3\\\">\\n                {isEditing ? (\\n                  <textarea\\n                    value={planejamento_pei.observacoes_docente}\\n                    onChange={(e) =>\\n                      setEditedPei({\\n                        ...editedPei,\\n                        planejamento_pei: {\\n                          ...planejamento_pei,\\n                          observacoes_docente: e.target.value,\\n                        },\\n                      })\\n                    }\\n                    rows={3}\\n                    className=\\\"w-full p-2 border border-slate-400 rounded text-xs\\\"\\n                  />\\n                ) : (\\n                  <p className=\\\"text-justify leading-relaxed\\\">\\n                    {planejamento_pei.observacoes_docente}\\n                  </p>\\n                )}\\n              </td>\\n            </tr>\\n          </tbody>\\n        </table>\\n\\n        {/* RODAP\303\211 DE ASSINATURAS LADO A LADO */}\\n        <div className=\\\"mt-14 pt-4\\\">\\n          <div className=\\\"grid grid-cols-2 gap-12 text-center text-xs\\\">\\n            <div>\\n              <div className=\\\"border-b border-black mb-1.5 pb-1\\\">\\n                <span className=\\\"font-semibold text-black\\\">\\n                  {cabecalho.docente_regente}\\n                </span>\\n              </div>\\n              <span className=\\\"font-bold uppercase tracking-wider text-black\\\">\\n                Docente\\n              </span>\\n            </div>\\n\\n            <div>\\n              <div className=\\\"border-b border-black mb-1.5 pb-1\\\">\\n                <span className=\\\"font-semibold text-black\\\">\\n                  {cabecalho.coordenacao_napne}\\n                </span>\\n              </div>\\n              <span className=\\\"font-bold uppercase tracking-wider text-black\\\">\\n                Coordenadora NAPNE\\n              </span>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Format OfficialTemplateView.tsx strictly with IFTO/NAPNE logos, light gray table headers (bg-slate-200), thin black borders, all 8 sections, and side-by-side signatures\", \"Overwrite\":true, \"TargetFile\":\"/src/components/OfficialTemplateView.tsx\", \"toolAction\":\"Formatting OfficialTemplateView.tsx with IFTO/NAPNE official layout\", \"toolSummary\":\"Update OfficialTemplateView.tsx\"}"
