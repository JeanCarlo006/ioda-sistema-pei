              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      avaliacaoAcessivel:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Avalia\303\247\303\243o formativa mediada com base em checklists concretos de tarefas pr\303\241ticas realizadas em laborat\303\263rio.\',"
