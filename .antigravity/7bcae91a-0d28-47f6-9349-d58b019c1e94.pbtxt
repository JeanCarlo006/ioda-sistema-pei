            }
            lines {
              text: "        descricao_meta: \'Utilizar autonomamente a prancha tem\303\241tica de CAA no tablet ou fich\303\241rio para expressar d\303\272vidas e solicitar recursos durante os momentos de aula coletiva.\',"
