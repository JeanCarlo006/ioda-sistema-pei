    content: "                      <span className=\"font-mono text-[10px]\">Gradua\303\247\303\243o / TI</span>\n                    </div>\n                  </button>\n                </div>\n              </div>\n\n              {/* Privacy & Legal Compliance Banner (LGPD & Portaria MEC 421/2026) */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n                <div className=\"flex items-start gap-2.5\">\n                  <ShieldCheck className=\"w-4 h-4 text-emerald-800 shrink-0 mt-0.5\" />\n                  <div className=\"text-xs text-slate-700 leading-relaxed\">\n                    <strong>Privacidade & Prote\303\247\303\243o de Dados (LGPD):</strong> Em estrito cumprimento \303\240 Lei n\302\272 13.709/2018 (LGPD) e ao Decreto n\302\272 12.686/2025 (Art. 12, \302\2475\302\272), as informa\303\247\303\265es pedag\303\263gicas do estudante s\303\243o mantidas sob absoluto sigilo institucional. O PEI foca exclusivamente na elimina\303\247\303\243o de barreiras escolares no laborat\303\263rio de inform\303\241tica.\n                  </div>\n                </div>\n              </div>\n              </div>\n            </div>\n          )}\n\n          {/* ============================================================== */}\n          {/* ETAPA 2: IDENTIFICA\303\207\303\203O DO ESTUDANTE & COMPONENTE              */}\n          {/* ============================================================== */}\n          {currentStep === 2 && (\n            <div className=\"space-y-4 animate-fadeIn\">\n              <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-start gap-2.5\">\n                <Info className=\"w-4 h-4 text-slate-600 shrink-0 mt-0.5\" />\n                <div className=\"text-xs text-slate-700\">\n                  <strong>Etapa 2 de 4 \302\267 Identifica\303\247\303\243o B\303\241sica:</strong> Preencha os dados do estudante e a disciplina de computa\303\247\303\243o. Os campos de curso e m\303\263dulo j\303\241 foram calibrados para <em>{perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico\'}</em>.\n                </div>\n              </div>\n\n              {/* Card A: Dados Pessoais do Aluno */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\">\n                <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5\">\n                  <UserPlus className=\"w-3.5 h-3.5 text-emerald-700\" />\n                  <span>Dados do Estudante:</span>"
