    content: "          {/* ============================================================== */}\n          {currentStep === 2 && (\n            <div className=\"space-y-4 animate-fadeIn\">\n              <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-start gap-2.5\">\n                <Info className=\"w-4 h-4 text-slate-600 shrink-0 mt-0.5\" />\n                <div className=\"text-xs text-slate-700\">\n                  <strong>Etapa 2 de 4 \302\267 Identifica\303\247\303\243o B\303\241sica:</strong> Preencha os dados do estudante e a disciplina de computa\303\247\303\243o. Os campos de curso e m\303\263dulo j\303\241 foram calibrados para <em>{perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico\'}</em>.\n                </div>\n              </div>\n\n              {/* Card A: Dados Pessoais do Aluno */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\">\n                <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5\">\n                  <UserPlus className=\"w-3.5 h-3.5 text-emerald-700\" />\n                  <span>Dados do Estudante:</span>\n                </h4>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <div className=\"sm:col-span-2\">\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Nome Completo do Estudante <span className=\"text-red-500\">*</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={nome}\n                      onChange={(e) => setNome(e.target.value)}\n                      placeholder=\"Ex: Gabriel Moreira Silva\"\n                      className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                      required\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Matr\303\255cula / C\303\263digo\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={matricula}\n                      onChange={(e) => setMatricula(e.target.value)}\n                      placeholder=\"Ex: 2026.1.INF.092\"\n                      className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                    />\n                  </div>\n                </div>\n\n                <div className=\"w-full sm:w-1/3\">\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Idade / Faixa Et\303\241ria\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={idade}\n                    onChange={(e) => setIdade(e.target.value)}\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                  />\n                </div>\n              </div>\n\n              {/* Card B: Componente Curricular de TI */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\">\n                <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5\">\n                  <Laptop className=\"w-3.5 h-3.5 text-emerald-700\" />\n                  <span>Componente Curricular & Curso de TI:</span>\n                </h4>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <div className=\"sm:col-span-2\">\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Curso de TI <span className=\"text-red-500\">*</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={curso}\n                      onChange={(e) => setCurso(e.target.value)}\n                      className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                      required\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      M\303\263dulo / Per\303\255odo / Ano\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={modulo}\n                      onChange={(e) => setModulo(e.target.value)}\n                      className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                      required\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Disciplina / Componente Curricular de Computa\303\247\303\243o <span className=\"text-red-500\">*</span>\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={disciplina}\n                    onChange={(e) => setDisciplina(e.target.value)}\n                    placeholder=\"Ex: Programa\303\247\303\243o Web, Banco de Dados Relacional, Redes, Algoritmos\"\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                    required\n                  />\n                </div>\n              </div>\n\n              {/* Card C: Doc\303\252ncia e AEE */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Docente Regente da Disciplina\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={docenteRegente}\n                    onChange={(e) => setDocenteRegente(e.target.value)}\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                  />"
    num_lines: 1068
