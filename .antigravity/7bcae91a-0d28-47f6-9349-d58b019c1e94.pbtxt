      thinking_signature: "\022\321\n\n\316\n\001i\024}\023\220\342\240W\33206*,\213\273\317\232\361\301\307q\276\261V\\Y\226\372hm\020W\314`\226)\334\274*\016D~*y\267\302\361_\246q\250Q\246\233\303\"\031\034t\254\335\222w.\221\360\177\021T.\343zKK\340\202\332s8\f\215Ub\202\002.\223\342S\245j\242d\272I\325FD\301\371\277\3044\234\245b\374\244q8\225\206WB\r\345\210r\312\busI\021\215m9n\370=,\256\241\"\020\300\3150!\366\2752{\253\344\314\353\231\344\002\264\306\347\003\307\357\362\031\317\317N5C\224\017m\252X\346\350\371`\025\314\222o\306\360\256,\354\317|=\351\377\304z\021}@*@\365\016r\214\000\345\262\'Y\237\237\377\205\v\3169\375\263\371\372\206\35747H\330F\265\276\206\211l\232]97L1\255\267\274\fR5\221\3222\363\333YB\273\246\305\371\224\036\027\025v\301\nCQ\246\277\200\"\331\275\024\b\333\rg\'\374\315\253F\246\256\031n\252\306\321\214hw3~c\237\246\346`8\267\036\347\315\336\255\351S\n\365eeJR\231W\266\250\354\274\357b\261\323\021\211\n_u+5pl\315\030l\371G$\003\005\217\364}y\374C\227\3003v\314\306\360\233W\330\026\322b\325\232\205{\f=)\307\340\216r[\036e\002\222`\026~z\215&=\363\334\253}\a\f\022\303\204H\264\367-\361TO\341\033r:\251\231\233.\266\005v\201\314\205\345\204\362\320A\230#t_\375\026\274\376\352\v\023<\213\002\004\314\273 \n\n6\234\335ZP}\222\367\361\033[1\3025,ec\264?/\016i\323\217\244\204j{Sy4.j\352\017\331\254Z\301f\2066H\244l\247\332\273\271\207\005\332\024\206\277\360\215%[/{1\367\f\223\023H\223\375\\\327\214\000\017\001\312+\275\217\304+bb\256\322\022\201ic^\231r\210\337\245K\250\366\312\255\000\234\366\346<\204_\211\302\276\265\343\204\354[^\337!\305\203\274\034 \227\340$E\224\001\377\321e\312-\216\332\323\022\234\373F\261!\017\233\027\033\340\271gA\377\240\003\214\276=$\006\020|=\2071\200U@c)L8\024b\247\027\025&\217\317z\225\273-!>\255^?\021\237\260w\233\302\315\217\234M\233\261`m5\251>:\020\375&\022\374U\032\310\334^\353\367).\030\t\201\026P\b)Al-\'\253\3378G\f\027>\246\267\036\255\211r8\256N\207y\326\330\350\277(\367u\357\023\272\333`\2131\264\322H\332\226An\223\307\333am%\002:\002\232\204\327\033`;\361\215F*5?\322\207\217\361\344w\201\0217\222P\035\347\245\034\vu[N+_`\271\002y\a\036N\336\321[,\213\035NZ\234\253\377\030\206k\216\242\211\256\255-\202\263\313\330tk\233a\302rD\255\2705\b\r\274\322\034\321\026?\317n\242\211M\305\312+\360z\201\221\241%\237\253\f\300\244L4\340$9\313\223\266iM\255\271\370r\r?t~i\312\az\3353\344\017\36526F8\222\315\n}\335\274\3527&*\360\326\260\225R\234\260\250\317\366\375\rL\271\f\3348\261\375\026ar\331\3761\030\\\r\375<\203\240#\343^/\260\370\341@Jf\375\240\n#n\224O\343\367(\273F\274\244\347\363\377\f6\021\247\336-^\225k\364[\031\004@\306L&6O\020\322&\000m:\323yG\272H\341\031@\216\036$b\317\231\254\355\376\205\3051%\257\211.]<\257\277D\a\370\237t*\234K\bZt\2028\367\333^3\261\271er%\337 C\005\371\377xS\266\021\0365\372\247\345\326\016;o\272\356\b\253\267\313v\360\342\223\363\343\035K\354\226\251\253i0\001\250\026\026Lo\fQ\365\324f\223N\345\366eb\b\316\252\244@\314\206\n\311\030\020\fT\236\243\234\352C\177\024\312N\225\251\001\204?\3525\310\234\256\204w\v\236~\003\250\363\327\222\240\273\355\224l\247\2362c\311;K\254\031\r\177\274\234\210t\302P\265\234\210\305x\305X\212\350\"\201\304<;\230m\032\021\204\376-\272p\225^{\341\307*\2061\331Hd\342M\357r\204\353\354\002E\271A\363y\306F\266\240\204\3516<R\324\232\3356\265y\340\025\274;\037%\313$c\033\231\267\243\221\177.\022\3153\276\335\235\301\213\242\342\a^\372\252\236\347\225\335\345\2254\235\354Z\327\270\236T\2668\252\rM\303b:\374\036\217\275\364\271AX@\215M\273\235\315\v\232R\272\aT9\337\006\212\207>\212\251K\002\261\231R\325\225+\351a\203\001\346\312\034\332\033\233\262$\247\033eC{v\270n\362Q\247\t\344\273\216\375\215e\352\274\201\037\254_\303z\307\243\367\366O6$\3203\376\310 \254\330\273\031xz1A}\315\035\346\355\340p\031\276Y\024B\362\300U\371\333CX\232\263\271;y+\304x\234\345\363E\262\027\003\342G\256\202\206+\270\247\002\213\373"
