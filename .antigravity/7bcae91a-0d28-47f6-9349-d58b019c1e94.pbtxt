      thinking_signature: "\022\230\r\n\225\r\001i\024}\023g\376\363j\025V\237\207\246N3\200+u\342\222\214#\315\277D\366\'$x\365\220\033G\237K^\271^\233\242\371\256\257\264\244\223W\'\333\335\353\261\307Z\'Ky\264Y\0177\367\354xv\325jSN\233vK\t\227\372\211P25\220n\372\304\326\237\357\021Zz\3410\347\237\274\266\314b>8\3273\vR3\320\032\326\345\303\207]*:\237\333\b\016\023\256r9\213\350\202\342d\312\353\337\023\273\036\327\232.\310\345\262lg\005\306d\024\361\036\344\'\355\3327\302\371\361\214\002F\264\377~ >\366j\344\031{\024\361\022\375y\305\217\002\004s\232[E\"\214\026\264\376\203\352\226\360\\\361o\'\251\304J\025\000-6_Wt4\233\356Ln\244\256\376\263 \332=\022TK\211\373\276\a\v\247\003%\\lJn\332\356\267\373G+J\276\270\370\177yNF\024\306\225\325\257\271\240\017lm\330\210+c\201\270x\201\002%\320\243\254\3647\205\026\216B\252\3545\230\003\311\312\237\343x`\237\235\020z\317\362o\'\304\214\360thy\335\000\261\321\'\226\3511\357\002\034\366Pw&\340\243\"cO\316\333\003\036\036\300^\347r\267,\201\320\031\261B\256\257{\016\352\311\331\326$\352\364\201S+\006o\177\245b:\364\300\372\266\034\252\217\342\355\263\201\316\266s\032\264\022\334\306>\312\223\253\357\242?\021\230A\267\317\240\215\022m,j0@\206%\311\023\361\322/\"rL\000N\242>\267*\r]\377pv\332Jz\262\337\331 \233\361\2636*g\177UBM\001L\264\232D\365\254\021\213\3474$.8\255B\036tp\330q\231O\235\350k\345\375n{\004V\344\327L\215\364!Y\306xm\266A\357\227<1\006\355\b\375\032\354%\016\321\350\266\016\317su\343\224cS\321\233q\304Yz\327Bv\371\262\215W\253E\027S\303\"z\324\"\036(`@A[Rt\305\361l\263\337XAS\307\a\f\200\363l\270u\343@P\316\221v\376\245\215c\356\377@\234\030\026J\256}\206\246\331\000\263c\363\204E=\0364I\201+\207\212\002\252\354\343.($\347\'\177\016\344\266\247R\272G\242\373\220\274\333;\371y;\361y\214\230\'\004\3445~\241l\346\231\250h\025\314\177\354\363\352Zu^\270^\360\270\325\326\214\341\\\221\0055F\263\021\2126\350\267k\201\353\320D\3051QY\306uj\306\256Y\203\017\336 \353%>I\274!\020\344\243\263\3242\267\032\022\256\031\030\034\\\nB\262Y+\331R*\343>\220\216S\266\267\257\307\323 \024\366i$\357\3438\340\335r\356\351\177\322\222\362\t]\a\315o\300\372\243\265\217\343\240\223\200 \2777\\\333C\027\344\027\347\177\335\223\277\307\354\364\223\255`r\213 \350\002\334J\346E\274\006@A\336g\371\240\f\271<\030N\321/\260\2114U\346\332\306\345Nb\000\232i3x\243\003\025\211\036\204r\201\272\263C\327k\373\365\301V/X\177X\227\377\262\301B\036\241s# \324Y\271\226;\000\236\262oG~\027[)PI;\356\266m\027Yn\234\256,\273\200\306\216s\n\a\353\032`\021\352\31438M\344{[[\033\022\374\373_\001\235\217\211;\256?\0250\315\371Ue\376\a<\204o\247U\360I\337\317M4p\235\263\241\322\200\271,R\233\320a\035\021\331\271\306\327\024\277\374\243\3613\330h\315\310\267z\261P\271\0347\271e\223\246\274?\200\263(\357P\376\177V\341\027\222\214&:l\231\027\"2\344\n\334\372_W\\c\350\240\bN\355\335\244\244(%p\211#\267\216bl\374\215O\210L\362&\355Z\235 \374\235\261;\3014=\211\003\2606W\000\033 \224\001y\221\000\355\354\301Q^\200\351\376\270\301\343\243\361\341\020\236\343\334\256\332Q\330\334\203T\201\205\272\220kv\017\346\354\035\230\3234\213U\312\177xe\177~\201\216\3455j\322D\001.+YA\v\257\350\bB\267\vW\203\213\v\356\221\305K\030\fv%\224 \367\346*\261\341\017 d\346\312\303\352\232\376\3520\310\333\267\326\264\033\313\033\021\227\322K5j\036\367Q\350\254s\rS\373\275\343\373\211\020I_\265\213`\034|Py\211\365\251{\205\376\261\314\276\321\212\311*5\332,rM\321\021F90}4\'\303p\332$\337\276\"Y\316:/\206e]\322\326\237\276M]G\aJ*\332\324*\020\301R\\\240\262\277:\002\314\037\017\257\254\003\245\341#\342\213{\311\275\340\v\vK\313\321T,\362B\325\303\376k:[`\254\302\306\222\364@\206#w\312\213\246\0213G\364\036\223\223\235!e\365\360\366\357\261\271R7\277\206\021\t\200w\264\316qI\'\301\265\2340\351\3140s\213mB\314\323\002\374\201N6\004\350K\b\213\273\271\343\360,\001\365\303([a.d3qN\356\320\221]\272\233\031+\372\302k\000\333\350\177\244,V(\3669\b\2148h\250\223\253\311\217D\020$\271l\004\265\322\300m\224A\3119V\326\364\325\262\023\t?\303\032\376\036*\3