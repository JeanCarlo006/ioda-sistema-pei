    content: "    bancoDeSolucoesPedagogicas.find((s) => s.id === dados.solucaoBaseId) ||\n    bancoDeSolucoesPedagogicas[0];\n\n  const id = `PEI-${Date.now().toString().slice(-4)}`;\n\n  return {\n    id,\n    cabecalho: {\n      estudante: dados.nome,\n      codigo_matricula: dados.matricula || `TI-${Math.floor(1000 + Math.random() * 9000)}`,\n      idade: dados.idade || \'18 anos\',\n      curso: dados.curso || \'Curso T\303\251cnico em Inform\303\241tica / Bacharelado em TI\',\n      componente_curricular: dados.disciplina || \'Tecnologia da Informa\303\247\303\243o\',\n      modulo_periodo: dados.modulo || \'2\302\272 Semestre / 2026\',\n      data_elaboracao: new Date().toISOString().split(\'T\')[0],\n      docente_regente: dados.docenteRegente || \'Prof. Respons\303\241vel pela Disciplina\',\n      docente_aee: dados.docenteAee || \'Prof\302\252. Especialista do NAPNE\',\n      profissional_apoio: \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\n      coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n    },\n    historico_napne: {\n      status_diagnostico: dados.statusDiagnostico || \'confirmado\',\n      categoria_neurodivergencia:\n        dados.categoriaNeurodivergencia ||\n        (dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \'Hip\303\263tese Diagn\303\263stica / Em Investiga\303\247\303\243o pelo NAPNE\'\n          : \'Neurodiverg\303\252ncia / Condi\303\247\303\243o Acompanhada\'),\n      cid_ou_hipotese:\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \'Em investiga\303\247\303\243o pedag\303\263gica multiprofissional (Portaria MEC n\302\272 421/2026)\'\n          : \'Diagn\303\263stico confirmado em prontu\303\241rio NAPNE\',\n      breve_historico_clinico_familiar: `Estudante do ${dados.curso} no Campus Para\303\255so. Acompanhado pelo NAPNE com foco na garantia do direito \303\240 educa\303\247\303\243o inclusiva e acessibilidade curricular nos termos da Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.${\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \' Atendimento pedag\303\263gico iniciado com base nas barreiras escolares observadas, sem depend\303\252ncia de laudo pericial pr\303\251vio.\'\n          : \'\'\n      }`,\n      descricao_condicao_especifica: dados.condicao || solucao.descricaoProblema,\n      informacoes_dos_pais: \'Estudante e fam\303\255lia em alinhamento constante com o NAPNE Campus Para\303\255so e coordena\303\247\303\243o de curso.\',\n    },\n    estudo_de_caso: {\n      barreiras: [\n        {\n          id: \'B1\',\n          categoria: \'metodologica\',\n          descricao: `Metodologia de ensino em ${dados.disciplina} focada exclusivamente em formato \303\272nico sem op\303\247\303\265es acess\303\255veis.`,\n          impacto: \'Dificuldade de demonstra\303\247\303\243o plena da capacidade t\303\251cnica na aus\303\252ncia de recursos adaptados.\',\n          estrategia_enfrentamento: solucao.remediosSugeridos.acaoExpressao,\n        },\n        {\n          id: \'B2\',\n          categoria: \'tecnologica\',\n          descricao: \'Ambientes de desenvolvimento e computadores de laborat\303\263rio sem configura\303\247\303\243o pr\303\251via de acessibilidade.\',\n          impacto: \'Sobrecarga visual e muscular durante atividades pr\303\241ticas prolongadas.\',\n          estrategia_enfrentamento: `Instala\303\247\303\243o e configura\303\247\303\243o de: ${solucao.remediosSugeridos.recursosTA.join(\', \')}.`,\n        },\n        {\n          id: \'B3\',\n          categoria: \'atitudinal\',\n          descricao: \'Risco de expectativas rebaixadas ou desconhecimento das potencialidades t\303\251cnicas do aluno pela turma.\',\n          impacto: \'Isolamento em trabalhos pr\303\241ticos de equipe.\',\n          estrategia_enfrentamento: \'Planejamento docente com metodologias ativas e valoriza\303\247\303\243o das contribui\303\247\303\265es do estudante.\',\n        },\n      ],\n      potencialidades: [\n        {\n          id: \'P1\',\n          area: \'Capacidade Anal\303\255tica & Computacional\',\n          descricao: \'Motiva\303\247\303\243o para resolu\303\247\303\243o de problemas e aprendizado pr\303\241tico de ferramentas de TI.\',\n          apoio_demandado: \'Orienta\303\247\303\243o personalizada em projetos de desenvolvimento.\',\n        },\n        {\n          id: \'P2\',\n          area: \'Trabalho Colaborativo\',\n          descricao: \'Excelente coopera\303\247\303\243o em duplas estruturadas com objetivos transparentes.\',\n          apoio_demandado: \'Incentivo cont\303\255nuo ao trabalho compartilhado.\',\n        },\n      ],\n      recursos_ta: solucao.remediosSugeridos.recursosTA,\n      sintese_observacao: {\n        interacao_professores: \'Receptivo e proativo nas orienta\303\247\303\265es pedag\303\263gicas.\',\n        interacao_colegas: \'Excelente entrosamento em equipes de desenvolvimento.\',"
