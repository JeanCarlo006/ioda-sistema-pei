            }
            lines {
              text: "  const isSuperior ="
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    pei.cabecalho.curso.toLowerCase().includes(\'superior\') ||"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
