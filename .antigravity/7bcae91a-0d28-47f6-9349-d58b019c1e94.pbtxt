            lines {
              text: "        descricao: \'Aulas pr\303\241ticas no datacenter/laborat\303\263rio com m\303\272ltiplos est\303\255mulos sonoros concomitantes sem abafador ou roteiro antecipado.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
