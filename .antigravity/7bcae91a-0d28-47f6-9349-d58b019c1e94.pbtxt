    tool_calls {
      id: "call_202329"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React from \'react\';\\nimport { PEICompleto } from \'../types/pei\';\\nimport { getIdentificadorConfidencial } from \'../data/initialCases\';\\nimport {\\n  Sparkles,\\n  FileText,\\n  Search,\\n  BookOpen,\\n  LayoutDashboard,\\n  Printer,\\n  UserPlus,\\n  ArrowRight,\\n  FolderOpen,\\n  Wrench,\\n  Trash2,\\n} from \'lucide-react\';\\n\\ninterface ILovePeiHubProps {\\n  activePei: PEICompleto;\\n  allStudents: PEICompleto[];\\n  onSelectStudent: (student: PEICompleto) => void;\\n  onNavigate: (tabId: string) => void;\\n  onOpenAddStudent: () => void;\\n  onOpenSolutionBank: () => void;\\n  onOpenCampusStats: () => void;\\n  onPrint: () => void;\\n  onRequestDeletePei?: (peiToDelete: PEICompleto) => void;\\n}\\n\\nexport const ILovePeiHub: React.FC<ILovePeiHubProps> = ({\\n  activePei,\\n  allStudents,\\n  onSelectStudent,\\n  onNavigate,\\n  onOpenAddStudent,\\n  onOpenSolutionBank,\\n  onPrint,\\n  onRequestDeletePei,\\n}) => {\\n  const toolCards = [\\n    {\\n      id: \'novo_pei\',\\n      title: \'Criar Novo PEI\',\\n      description: \'Elaborar passo a passo um novo Plano de Aula Individualizado para um estudante.\',\\n      iconBg: \'bg-emerald-600 text-white\',\\n      icon: Sparkles,\\n      action: onOpenAddStudent,\\n    },\\n    {\\n      id: \'plano_pei\',\\n      title: \'Plano de Aula (PEI)\',\\n      description: \'Ver o Guia Pr\303\241tico de Sala de Aula, adapta\303\247\303\265es de prova, metas e o Guia do Aluno.\',\\n      iconBg: \'bg-emerald-700 text-white\',\\n      icon: FileText,\\n      action: () => onNavigate(\'pei\'),\\n    },\\n    {\\n      id: \'estudo_caso\',\\n      title: \'Estudo de Caso\',\\n      description: \'Consultar as dificuldades observadas, pontos fortes do estudante e recursos de apoio.\',\\n      iconBg: \'bg-teal-700 text-white\',\\n      icon: Search,\\n      action: () => onNavigate(\'estudo_caso\'),\\n    },\\n    {\\n      id: \'painel_metas\',\\n      title: \'Metas e Notas\',\\n      description: \'Acompanhar o progresso das metas e registrar observa\303\247\303\265es r\303\241pidas por voz ou texto.\',\\n      iconBg: \'bg-slate-800 text-white\',\\n      icon: LayoutDashboard,\\n      action: () => onNavigate(\'painel\'),\\n    },\\n    {\\n      id: \'modelo_oficial\',\\n      title: \'Imprimir p/ SEI\',\\n      description: \'Visualizar, editar e imprimir o documento formal padronizado do IFTO.\',\\n      iconBg: \'bg-emerald-900 text-white\',\\n      icon: BookOpen,\\n      action: () => onNavigate(\'documento_oficial\'),\\n    },\\n    {\\n      id: \'banco_solucoes\',\\n      title: \'Guia de Metodologias\',\\n      description: \'Consultar como explicar o conte\303\272do, dividir tarefas e avaliar cada condi\303\247\303\243o.\',\\n      iconBg: \'bg-slate-900 text-white\',\\n      icon: Wrench,\\n      action: onOpenSolutionBank,\\n    },\\n  ];\\n\\n  return (\\n    <div className=\\\"space-y-10\\\">\\n      {/* Clean Hero Header */}\\n      <div className=\\\"text-center pt-2 max-w-3xl mx-auto px-4\\\">\\n        <h1 className=\\\"text-2xl sm:text-4xl font-bold text-slate-900 tracking-tight\\\">\\n          Ol\303\241, professor(a). Vamos come\303\247ar?\\n        </h1>\\n        <p className=\\\"mt-2 text-sm sm:text-base text-slate-600\\\">\\n          Escolha um PEI salvo ou crie um novo plano de aula adaptado de forma simples e r\303\241pida.\\n        </p>\\n      </div>\\n\\n      {/* Main Grid: Tools on Left + Confidential Saved PEIs on Right */}\\n      <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\\\">\\n        {/* Left: 6 Direct Action Cards */}\\n        <div className=\\\"lg:col-span-8 grid grid-cols-1 sm:grid-cols-2 gap-4\\\">\\n          {toolCards.map((card) => {\\n            const Icon = card.icon;\\n            return (\\n              <button\\n                key={card.id}\\n                type=\\\"button\\\"\\n                onClick={card.action}\\n                className=\\\"group bg-white rounded-2xl border border-slate-200 p-6 text-left hover:border-emerald-500 hover:shadow-md transition-all cursor-pointer flex flex-col justify-between min-h-[160px]\\\"\\n              >\\n                <div>\\n                  <div\\n                    className={`w-11 h-11 rounded-xl flex items-center justify-center ${card.iconBg}`}\\n                  >\\n                    <Icon className=\\\"w-5 h-5\\\" />\\n                  </div>\\n                  <h2 className=\\\"text-base font-bold text-slate-900 mt-4 group-hover:text-emerald-700 transition-colors\\\">\\n                    {card.title}\\n                  </h2>\\n                  <p className=\\\"text-xs text-slate-600 mt-1.5 leading-relaxed\\\">\\n                    {card.description}\\n                  </p>\\n                </div>\\n\\n                <div className=\\\"mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-emerald-700\\\">\\n                  <span>Abrir</span>\\n                  <ArrowRight className=\\\"w-4 h-4 transform group-hover:translate-x-1 transition-transform\\\" />\\n                </div>\\n              </button>\\n            );\\n          })}\\n        </div>\\n\\n        {/* Right: Saved PEIs List (Confidential on Home Screen) */}\\n        <div className=\\\"lg:col-span-4 bg-white border border-slate-200 rounded-2xl p-5 space-y-4\\\">\\n          <div className=\\\"flex items-center justify-between pb-3 border-b border-slate-100\\\">\\n            <div className=\\\"flex items-center gap-2\\\">\\n              <FolderOpen className=\\\"w-4 h-4 text-emerald-700\\\" />\\n              <h3 className=\\\"text-sm font-bold text-slate-900\\\">\\n                PEIs Cadastrados ({allStudents.length})\\n              </h3>\\n            </div>\\n            <span className=\\\"text-[11px] font-medium text-emerald-800 bg-emerald-50 px-2.5 py-0.5 rounded-full\\\">\\n              Sigilo Ativo\\n            </span>\\n          </div>\\n\\n          <p className=\\\"text-xs text-slate-500 leading-relaxed\\\">\\n            Para proteger a privacidade, o nome do estudante s\303\263 \303\251 exibido ap\303\263s abrir o PEI:\\n          </p>\\n\\n          <div className=\\\"space-y-2 max-h-80 overflow-y-auto pr-1\\\">\\n            {allStudents.map((s, idx) => {\\n              const isSelected = s.id === activePei.id;\\n              const isSemLaudo =\\n                s.historico_napne.status_diagnostico === \'em_investigacao_hipotese\';\\n\\n              return (\\n                <div\\n                  key={s.id}\\n                  className={`w-full p-3 rounded-xl border transition-all flex items-center justify-between gap-2 group ${\\n                    isSelected\\n                      ? \'bg-emerald-50/50 border-emerald-600\'\\n                      : \'bg-slate-50/70 border-slate-200 hover:border-slate-300 hover:bg-white\'\\n                  }`}\\n                >\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => {\\n                      onSelectStudent(s);\\n                      onNavigate(\'pei\');\\n                    }}\\n                    className=\\\"flex-1 min-w-0 text-left cursor-pointer flex items-center justify-between\\\"\\n                  >\\n                    <div className=\\\"truncate mr-2\\\">\\n                      <div className=\\\"flex items-center gap-1.5\\\">\\n                        <span className=\\\"text-xs font-bold text-slate-900 group-hover:text-emerald-800\\\">\\n                          {getIdentificadorConfidencial(s, idx)}\\n                        </span>\\n                        {isSemLaudo && (\\n                          <span className=\\\"text-[10px] font-semibold text-amber-900 bg-amber-100 px-1.5 py-0.2 rounded\\\">\\n                            s/ laudo\\n                          </span>\\n                        )}\\n                      </div>\\n                      <div className=\\\"text-xs text-slate-500 truncate mt-0.5\\\">\\n                        {s.cabecalho.componente_curricular}\\n                      </div>\\n                    </div>\\n\\n                    <span className=\\\"text-xs font-bold text-emerald-700 shrink-0\\\">\\n                      Abrir \342\206\222\\n                    </span>\\n                  </button>\\n\\n                  {onRequestDeletePei && allStudents.length > 1 && (\\n                    <button\\n                      type=\\\"button\\\"\\n                      onClick={(e) => {\\n                        e.stopPropagation();\\n                        onRequestDeletePei(s);\\n                      }}\\n                      className=\\\"p-1.5 rounded-lg text-slate-400 hover:text-red-600 hover:bg-red-50 transition-colors shrink-0 cursor-pointer\\\"\\n                      title={`Excluir ${getIdentificadorConfidencial(s, idx)}`}\\n                      aria-label=\\\"Excluir PEI\\\"\\n                    >\\n                      <Trash2 className=\\\"w-4 h-4\\\" />\\n                    </button>\\n                  )}\\n                </div>\\n              );\\n            })}\\n          </div>\\n\\n          <div className=\\\"pt-2 border-t border-slate-100 flex flex-col gap-2\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenAddStudent}\\n              className=\\\"w-full py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer\\\"\\n            >\\n              <UserPlus className=\\\"w-4 h-4\\\" />\\n              <span>+ Criar Novo PEI</span>\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onPrint}\\n              className=\\\"w-full py-2 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 font-semibold text-xs rounded-xl transition-colors flex items-center justify-center gap-2 cursor-pointer\\\"\\n            >\\n              <Printer className=\\\"w-3.5 h-3.5\\\" />\\n              <span>Imprimir PEI Selecionado</span>\\n            </button>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Declutter ILovePeiHub.tsx removing repetitive legal citations and keeping simple action cards and confidential student list\", \"Overwrite\":true, \"TargetFile\":\"/src/components/ILovePeiHub.tsx\", \"toolAction\":\"Decluttering ILovePeiHub.tsx\", \"toolSummary\":\"Declutter ILovePeiHub.tsx\"}"
      original_name: "write_to_file"
    }
    tool_calls {
      id: "call_202450"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { SolucaoCondicao, PEICompleto } from \'../types/pei\';\\nimport { bancoDeSolucoesPedagogicas } from \'../data/initialCases\';\\nimport { ListenButton } from \'./SpeechControls\';\\nimport {\\n  Wrench,\\n  X,\\n  CheckCircle2,\\n  BookOpen,\\n  ListChecks,\\n  FileCheck,\\n  HeartHandshake,\\n  Cpu,\\n} from \'lucide-react\';\\n\\ninterface SolutionBankModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  activePei: PEICompleto;\\n  onApplySolution: (solucao: SolucaoCondicao) => void;\\n}\\n\\nexport const SolutionBankModal: React.FC<SolutionBankModalProps> = ({\\n  isOpen,\\n  onClose,\\n  activePei,\\n  onApplySolution,\\n}) => {\\n  const [selectedId, setSelectedId] = useState<string>(bancoDeSolucoesPedagogicas[0].id);\\n  const [appliedSuccess, setAppliedSuccess] = useState<string | null>(null);\\n\\n  if (!isOpen) return null;\\n\\n  const selectedSolution =\\n    bancoDeSolucoesPedagogicas.find((s) => s.id === selectedId) ||\\n    bancoDeSolucoesPedagogicas[0];\\n\\n  const handleApply = () => {\\n    onApplySolution(selectedSolution);\\n    setAppliedSuccess(selectedSolution.titulo);\\n    setTimeout(() => {\\n      setAppliedSuccess(null);\\n    }, 3000);\\n  };\\n\\n  const guia = selectedSolution.guiaPratico;\\n\\n  const textoParaOuvir = guia\\n    ? `Guia pr\303\241tico de sala de aula para ${selectedSolution.titulo}. Passo a passo na pr\303\241tica: ${guia.passo_a_passo_explicacao}. Divis\303\243o da tarefa em 3 etapas: ${guia.divisao_tarefa_chunking.join(\' \')}. Como avaliar na pr\303\241tica: ${guia.avaliacao_pratica}. Manejo e acolhimento: ${guia.manejo_e_acolhimento}.`\\n    : `${selectedSolution.titulo}. ${selectedSolution.remediosSugeridos.acaoExpressao}`;\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto\\\">\\n      <div className=\\\"bg-white rounded-2xl max-w-5xl w-full p-6 shadow-2xl border border-slate-200 my-8 max-h-[90vh] flex flex-col\\\">\\n        {/* Clean Header */}\\n        <div className=\\\"flex items-center justify-between pb-4 border-b border-slate-200 shrink-0\\\">\\n          <div className=\\\"flex items-center gap-3\\\">\\n            <div className=\\\"w-10 h-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white\\\">\\n              <Wrench className=\\\"w-5 h-5\\\" />\\n            </div>\\n            <div>\\n              <h3 className=\\\"text-lg font-bold text-slate-900\\\">\\n                Guia Pr\303\241tico de Metodologias de Ensino\\n              </h3>\\n              <p className=\\\"text-xs text-slate-500\\\">\\n                Selecione uma condi\303\247\303\243o para ver como explicar a mat\303\251ria, dividir atividades e adaptar provas\\n              </p>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            className=\\\"p-1.5 text-slate-400 hover:text-slate-600 rounded-lg cursor-pointer\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Main Body */}\\n        <div className=\\\"grid grid-cols-1 lg:grid-cols-12 gap-6 py-5 overflow-y-auto flex-1\\\">\\n          {/* Left: Clean List of Conditions */}\\n          <div className=\\\"lg:col-span-4 space-y-1.5 pr-1 overflow-y-auto max-h-[60vh]\\\">\\n            <span className=\\\"text-xs font-bold text-slate-500 uppercase tracking-wider block mb-2\\\">\\n              Condi\303\247\303\265es e Neurodiverg\303\252ncias\\n            </span>\\n            {bancoDeSolucoesPedagogicas.map((sol) => {\\n              const isSelected = sol.id === selectedId;\\n              return (\\n                <button\\n                  key={sol.id}\\n                  onClick={() => setSelectedId(sol.id)}\\n                  className={`w-full text-left px-3.5 py-2.5 rounded-xl border text-xs font-semibold transition-all cursor-pointer ${\\n                    isSelected\\n                      ? \'bg-emerald-700 text-white border-emerald-700 shadow-2xs\'\\n                      : \'bg-white border-slate-200 text-slate-700 hover:bg-slate-50\'\\n                  }`}\\n                >\\n                  {sol.titulo}\\n                </button>\\n              );\\n            })}\\n          </div>\\n\\n          {/* Right: 4-Part Practical Classroom Guide */}\\n          <div className=\\\"lg:col-span-8 flex flex-col justify-between bg-slate-50 border border-slate-200 rounded-2xl p-5 space-y-5\\\">\\n            <div className=\\\"space-y-5\\\">\\n              {/* Top Title + Listen Aloud Button */}\\n              <div className=\\\"flex flex-wrap items-start justify-between gap-3 border-b border-slate-200 pb-4\\\">\\n                <div>\\n                  <h4 className=\\\"text-base font-bold text-slate-900\\\">\\n                    {selectedSolution.titulo}\\n                  </h4>\\n                  <p className=\\\"text-xs text-slate-600 mt-1\\\">\\n                    {selectedSolution.descricaoProblema}\\n                  </p>\\n                </div>\\n                <ListenButton text={textoParaOuvir} label=\\\"Ouvir Guia em Voz Alta\\\" />\\n              </div>\\n\\n              {/* 4 Practical Pillars */}\\n              {guia && (\\n                <div className=\\\"grid grid-cols-1 gap-4\\\">\\n                  {/* 1. Passo a Passo na Pr\303\241tica */}\\n                  <div className=\\\"bg-white p-4 rounded-xl border border-slate-200\\\">\\n                    <div className=\\\"flex items-center gap-2 text-xs font-bold text-emerald-800 uppercase tracking-wider mb-1.5\\\">\\n                      <BookOpen className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                      <span>1. Passo a Passo na Pr\303\241tica (Como Explicar o Conte\303\272do)</span>\\n                    </div>\\n                    <p className=\\\"text-sm text-slate-700 leading-relaxed\\\">\\n                      {guia.passo_a_passo_explicacao}\\n                    </p>\\n                  </div>\\n\\n                  {/* 2. Divis\303\243o da Tarefa (Chunking) */}\\n                  <div className=\\\"bg-white p-4 rounded-xl border border-slate-200\\\">\\n                    <div className=\\\"flex items-center gap-2 text-xs font-bold text-emerald-800 uppercase tracking-wider mb-2\\\">\\n                      <ListChecks className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                      <span>2. Divis\303\243o da Tarefa em 3 Etapas Menores (Chunking)</span>\\n                    </div>\\n                    <ul className=\\\"space-y-1.5\\\">\\n                      {guia.divisao_tarefa_chunking.map((etapa, i) => (\\n                        <li\\n                          key={i}\\n                          className=\\\"text-sm text-slate-700 bg-slate-50 px-3 py-2 rounded-lg border border-slate-100\\\"\\n                        >\\n                          {etapa}\\n                        </li>\\n                      ))}\\n                    </ul>\\n                  </div>\\n\\n                  {/* 3. Como Avaliar na Pr\303\241tica */}\\n                  <div className=\\\"bg-white p-4 rounded-xl border border-slate-200\\\">\\n                    <div className=\\\"flex items-center gap-2 text-xs font-bold text-emerald-800 uppercase tracking-wider mb-1.5\\\">\\n                      <FileCheck className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                      <span>3. Como Avaliar na Pr\303\241tica (Provas e Trabalhos)</span>\\n                    </div>\\n                    <p className=\\\"text-sm text-slate-700 leading-relaxed\\\">\\n                      {guia.avaliacao_pratica}\\n                    </p>\\n                  </div>\\n\\n                  {/* 4. Manejo e Acolhimento */}\\n                  <div className=\\\"bg-white p-4 rounded-xl border border-slate-200\\\">\\n                    <div className=\\\"flex items-center gap-2 text-xs font-bold text-emerald-800 uppercase tracking-wider mb-1.5\\\">\\n                      <HeartHandshake className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                      <span>4. Manejo e Acolhimento (Se o Aluno Travar ou Desregular)</span>\\n                    </div>\\n                    <p className=\\\"text-sm text-slate-700 leading-relaxed\\\">\\n                      {guia.manejo_e_acolhimento}\\n                    </p>\\n                  </div>\\n                </div>\\n              )}\\n\\n              {/* Recursos de Apoio */}\\n              <div className=\\\"bg-white p-4 rounded-xl border border-slate-200\\\">\\n                <div className=\\\"flex items-center gap-1.5 text-xs font-bold text-slate-700 uppercase tracking-wider mb-2\\\">\\n                  <Cpu className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                  <span>Recursos e Tecnologias de Apoio Recomendados</span>\\n                </div>\\n                <div className=\\\"flex flex-wrap gap-1.5\\\">\\n                  {selectedSolution.remediosSugeridos.recursosTA.map((ta, i) => (\\n                    <span\\n                      key={i}\\n                      className=\\\"text-xs bg-slate-100 text-slate-800 px-2.5 py-1 rounded-lg font-medium\\\"\\n                    >\\n                      {ta}\\n                    </span>\\n                  ))}\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Bottom Apply Bar */}\\n            <div className=\\\"pt-4 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3\\\">\\n              <div className=\\\"text-xs text-slate-600\\\">\\n                Aplicar estas orienta\303\247\303\265es ao PEI de:{\' \'}\\n                <strong className=\\\"text-slate-900\\\">{activePei.cabecalho.estudante}</strong>\\n              </div>\\n\\n              <div className=\\\"flex items-center gap-2 w-full sm:w-auto justify-end\\\">\\n                {appliedSuccess && (\\n                  <span className=\\\"inline-flex items-center gap-1 text-xs font-semibold text-emerald-800 bg-emerald-100 px-3 py-1.5 rounded-lg\\\">\\n                    <CheckCircle2 className=\\\"w-4 h-4 text-emerald-700\\\" />\\n                    Adicionado ao PEI!\\n                  </span>\\n                )}\\n                <button\\n                  onClick={handleApply}\\n                  className=\\\"px-4 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white text-xs font-bold rounded-xl transition-colors cursor-pointer\\\"\\n                >\\n                  Adicionar Guia ao PEI Atual\\n                </button>\\n              </div>\\n            </div>\\n          </div>\\n        </div>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update SolutionBankModal.tsx to display the 4-part Guia Pr\303\241tico de Sala de Aula and ListenButton\", \"Overwrite\":true, \"TargetFile\":\"/src/components/SolutionBankModal.tsx\", \"toolAction\":\"Updating SolutionBankModal.tsx with Guia Pr\303\241tico\", \"toolSummary\":\"Update SolutionBankModal.tsx\"}"
      original_name: "write_to_file"
    }
