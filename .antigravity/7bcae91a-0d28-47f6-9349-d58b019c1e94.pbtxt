    content: "                    <p className=\"text-xs text-slate-600 mt-2.5 leading-relaxed\">\n                      Autonomia acad\303\252mica, abstra\303\247\303\243o l\303\263gica avan\303\247ada, micro-sprints \303\241geis (Kanban/GitHub), terminal CLI acess\303\255vel e modelagem de dados.\n                    </p>\n                    <div className=\"mt-2.5 pt-2 border-t border-slate-200 text-[11px] text-emerald-900 font-semibold flex items-center justify-between\">\n                      <span>14 alunos no Campus Para\303\255so</span>\n                      <span className=\"font-mono text-[10px]\">Beatriz \302\267 Larissa</span>\n                    </div>\n                  </button>\n                </div>\n              </div>\n\n              {/* Benchmark Cases for Current Profile */}\n              <div className=\"p-3.5 bg-blue-50/60 border border-blue-200 rounded-xl space-y-2.5\">\n                <div className=\"flex items-center justify-between\">\n                  <label className=\"text-xs font-bold text-blue-950 uppercase tracking-wider flex items-center gap-1.5\">\n                    <Sparkles className=\"w-4 h-4 text-blue-700\" />\n                    <span>Usar Caso de Refer\303\252ncia do Campus Para\303\255so (Opcional):</span>\n                  </label>\n                  <span className=\"text-[10px] text-blue-700 font-medium bg-blue-100 px-2 py-0.5 rounded\">\n                    Preenche dados base em 1 clique\n                  </span>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n                  {perfilModalidade === \'medio_tecnico\' ? (\n                    <>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleLoadRealCaseBenchmark(\'lucas\')}\n                        className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                      >\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Lucas</span>\n                          <span className=\"text-[9px] bg-emerald-100 text-emerald-800 px-1 rounded font-mono\">Web</span>\n                        </div>\n                        <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                          Paralisia Cerebral: Pair Programming orientado, atalhos de VS Code e tempo ampliado (+50%).\n                        </p>\n                      </button>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => handleLoadRealCaseBenchmark(\'matheus\')}\n                        className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                      >\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Matheus</span>\n                          <span className=\"text-[9px] bg-purple-100 text-purple-800 px-1 rounded font-mono\">Redes</span>\n                        </div>\n                        <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                          TEA & Sensorial: Abafador de ru\303\255do para datacenter, rotinas expl\303\255citas e comandos diretos.\n                        </p>\n                      </button>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => handleLoadRealCaseBenchmark(\'caua\')}\n                        className=\"p-2.5 bg-white border border-blue-200 hover:border-amber-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                      >\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"font-bold text-xs text-slate-900 group-hover:text-amber-800\">Caso Cau\303\243</span>\n                          <span className=\"text-[9px] bg-amber-100 text-amber-800 px-1 rounded font-mono\">Sem Laudo</span>\n                        </div>\n                        <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                          Portaria MEC 421/2026: Enunciados fracionados e casos de teste em tabelas (Input/Output).\n                        </p>\n                      </button>\n                    </>\n                  ) : (\n                    <>\n                      <button\n                        type=\"button\"\n                        onClick={() => handleLoadRealCaseBenchmark(\'beatriz\')}\n                        className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                      >\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Beatriz</span>\n                          <span className=\"text-[9px] bg-blue-100 text-blue-800 px-1 rounded font-mono\">Banco de Dados</span>\n                        </div>\n                        <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                          Baixa Vis\303\243o: Terminal CLI acess\303\255vel ao NVDA, modelos em DBML e audiodescri\303\247\303\243o.\n                        </p>\n                      </button>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => handleLoadRealCaseBenchmark(\'larissa\')}\n                        className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                      >\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Larissa</span>\n                          <span className=\"text-[9px] bg-indigo-100 text-indigo-800 px-1 rounded font-mono\">Eng. Software</span>\n                        </div>\n                        <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                          TDAH + Altas Habilidades: Gest\303\243o \303\241gil via Kanban/GitHub, micro-sprints e enriquecimento.\n                        </p>\n                      </button>\n\n                      <button\n                        type=\"button\"\n                        onClick={() => handleLoadRealCaseBenchmark(\'superior_geral\')}\n                        className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                      >\n                        <div className=\"flex items-center justify-between\">\n                          <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Geral TI</span>\n                          <span className=\"text-[9px] bg-slate-100 text-slate-800 px-1 rounded font-mono\">Arquitetura</span>\n                        </div>\n                        <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                          Autonomia universit\303\241ria: Avalia\303\247\303\243o processual via Git e sustenta\303\247\303\243o oral da arquitetura.\n                        </p>\n                      </button>\n                    </>\n                  )}\n                </div>\n\n                {benchmarkFeedback && (\n                  <div className=\"p-2 bg-emerald-50 border border-emerald-200 rounded-lg text-xs text-emerald-900 font-medium flex items-center gap-1.5 animate-fadeIn\">\n                    <CheckCircle className=\"w-3.5 h-3.5 text-emerald-700 shrink-0\" />\n                    <span>{benchmarkFeedback}</span>\n                  </div>\n                )}"
