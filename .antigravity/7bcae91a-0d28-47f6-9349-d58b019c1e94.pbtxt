        instruction: "import React, { useState } from \'react\';\nimport { PEICompleto } from \'../types/pei\';\nimport {\n  gerarNovoPeiCompleto,\n  bancoDeSolucoesPedagogicas,\n  casoLucasTecnico,\n  casoBeatrizSuperior,\n  casoMatheusMedio,\n  casoLarissaSuperior,\n  casoSemLaudoHipotese,\n} from \'../data/initialCases\';\nimport {\n  UserPlus,\n  X,\n  Sparkles,\n  GraduationCap,\n  Loader2,\n  CheckCircle,\n  Cpu,\n  Layers,\n  Wrench,\n  HelpCircle,\n  FileCheck2,\n  ShieldCheck,\n  Laptop,\n  BookOpen,\n  UserCheck,\n  ArrowRight,\n  Info,\n} from \'lucide-react\';\n\ninterface AddStudentModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onAddStudent: (newStudent: PEICompleto) => void;\n}\n\nexport const AddStudentModal: React.FC<AddStudentModalProps> = ({\n  isOpen,\n  onClose,\n  onAddStudent,\n}) => {\n  // Main profile selector: \'medio_tecnico\' vs \'superior_ti\'\n  const [perfilModalidade, setPerfilModalidade] = useState<\'medio_tecnico\' | \'superior_ti\'>(\'medio_tecnico\');\n  const [statusDiagnostico, setStatusDiagnostico] = useState<\'confirmado\' | \'em_investigacao_hipotese\'>(\'confirmado\');\n\n  // Form fields\n  const [nome, setNome] = useState(\'\');\n  const [matricula, setMatricula] = useState(\'\');\n  const [idade, setIdade] = useState(\'17 anos\');\n  const [curso, setCurso] = useState(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n  const [disciplina, setDisciplina] = useState(\'Programa\303\247\303\243o Web e Algoritmos\');\n  const [modulo, setModulo] = useState(\'2\302\272 Ano / Diurno\');\n  const [condicao, setCondicao] = useState(\'\');\n  const [potencialidades, setPotentialidades] = useState(\'\');\n  const [assistiveTech, setAssistiveTech] = useState(\'\');\n  const [solucaoId, setSolucaoId] = useState(\'sol-motor-programacao\');\n  const [docenteRegente, setDocenteRegente] = useState(\'Prof. Docente da Disciplina\');\n  const [docenteAee] = useState(\'Prof\302\252. Renata Cavalcanti (NAPNE \302\267 Campus Para\303\255so)\');\n  const [benchmarkFeedback, setBenchmarkFeedback] = useState<string | null>(null);\n\n  // Loading state with dynamic step progress\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [stepMessage, setStepMessage] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  // Handle Profile Switcher\n  const handleSelectProfile = (perfil: \'medio_tecnico\' | \'superior_ti\') => {\n    setPerfilModalidade(perfil);\n    setBenchmarkFeedback(null);\n\n    if (perfil === \'superior_ti\') {\n      setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\');\n      setModulo(\'4\302\272 Semestre / Noturno\');\n      setDisciplina(\'Banco de Dados Relacional e SQL\');\n      setIdade(\'21 anos\');\n      setSolucaoId(\'sol-visual-sql\');\n      setCondicao(\'Baixa vis\303\243o severa para leitura de diagramas gr\303\241ficos e interfaces complexas de banco de dados.\');\n      setAssistiveTech(\'Terminal de linha de comando CLI/SSH acess\303\255vel ao leitor NVDA, scripts DDL e modelos em DBML, tempo estendido (+50%).\');\n      setPotentialidades(\'Alta capacidade de racioc\303\255nio dedutivo, modelagem conceitual e dom\303\255nio de linguagens de consulta estruturada.\');\n    } else {\n      setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n      setModulo(\'2\302\272 Ano / Diurno\');\n      setDisciplina(\'Programa\303\247\303\243o Web e Algoritmos\');\n      setIdade(\'17 anos\');\n      setSolucaoId(\'sol-motor-programacao\');\n      setCondicao(\'Limita\303\247\303\243o de motricidade fina para digita\303\247\303\243o \303\241gil cont\303\255nua e risco de fadiga em avalia\303\247\303\265es de c\303\263digo sob press\303\243o.\');\n      setAssistiveTech(\'Teclado ergon\303\264mico mec\303\242nico, Pair Programming orientado, perfil de atalhos e temas no VS Code, tempo ampliado (+50%).\');\n      setPotentialidades(\'Excelente racioc\303\255nio l\303\263gico, decomposi\303\247\303\243o de algoritmos e interesse em desenvolvimento web moderno.\');\n    }\n  };\n\n  // Populate from a real campus case benchmark\n  const handleLoadRealCaseBenchmark = (tipo: \'lucas\' | \'matheus\' | \'caua\' | \'beatriz\' | \'larissa\' | \'superior_geral\') => {\n    switch (tipo) {\n      case \'lucas\':\n        setNome(\'Lucas (Caso Refer\303\252ncia - M\303\251dio)\');\n        setMatricula(\'2025.1.INF.042\');\n        setIdade(\'17 anos\');\n        setCurso(casoLucasTecnico.cabecalho.curso);\n        setModulo(casoLucasTecnico.cabecalho.modulo_periodo);\n        setDisciplina(casoLucasTecnico.cabecalho.componente_curricular);\n        setCondicao(casoLucasTecnico.historico_napne.descricao_condicao_especifica);\n        setPotentialidades(casoLucasTecnico.estudo_de_caso.potencialidades.map(p => p.descricao).join(\' \'));\n        setAssistiveTech(casoLucasTecnico.estudo_de_caso.recursos_ta.join(\', \'));\n        setStatusDiagnostico(\'confirmado\');\n        setSolucaoId(\'sol-motor-programacao\');\n        setBenchmarkFeedback(\'Caso real de Lucas carregado: Refer\303\252ncia de Paralisia Cerebral e Pair Programming em Programa\303\247\303\243o Web.\');\n        break;\n\n      case \'matheus\':\n        setNome(\'Matheus (Caso Refer\303\252ncia - M\303\251dio)\');\n        setMatricula(\'2025.1.INF.019\');\n        setIdade(\'16 anos\');\n        setCurso(casoMatheusMedio.cabecalho.curso);\n        setModulo(casoMatheusMedio.cabecalho.modulo_periodo);\n        setDisciplina(casoMatheusMedio.cabecalho.componente_curricular);\n        setCondicao(casoMatheusMedio.historico_napne.descricao_condicao_especifica);\n        setPotentialidades(casoMatheusMedio.estudo_de_caso.potencialidades.map(p => p.descricao).join(\' \'));\n        setAssistiveTech(casoMatheusMedio.estudo_de_caso.recursos_ta.join(\', \'));\n        setStatusDiagnostico(\'confirmado\');\n        setSolucaoId(\'sol-tea-redes\');\n        setBenchmarkFeedback(\'Caso real de Matheus carregado: Refer\303\252ncia de TEA, acomoda\303\247\303\243o sensorial e rotinas em Redes e SO.\');\n        break;\n\n      case \'caua\':\n        setNome(\'Cau\303\243 (Caso Refer\303\252ncia - Sem Laudo)\');\n        setMatricula(\'2026.1.INF.088\');\n        setIdade(\'16 anos\');\n        setCurso(casoSemLaudoHipotese.cabecalho.curso);\n        setModulo(casoSemLaudoHipotese.cabecalho.modulo_periodo);\n        setDisciplina(casoSemLaudoHipotese.cabecalho.componente_curricular);\n        setCondicao(casoSemLaudoHipotese.historico_napne.descricao_condicao_especifica);\n        setPotentialidades(casoSemLaudoHipotese.estudo_de_caso.potencialidades.map(p => p.descricao).join(\' \'));\n        setAssistiveTech(casoSemLaudoHipotese.estudo_de_caso.recursos_ta.join(\', \'));\n        setStatusDiagnostico(\'em_investigacao_hipotese\');\n        setSolucaoId(\'sol-hipotese-sem-laudo\');\n        setBenchmarkFeedback(\'Caso real de Cau\303\243 carregado: Refer\303\252ncia legal sem laudo (Portaria MEC 421/2026) em L\303\263gica de Programa\303\247\303\243o.\');\n        break;\n\n      case \'beatriz\':\n        setNome(\'Beatriz (Caso Refer\303\252ncia - Superior)\');\n        setMatricula(\'2024.1.BSI.015\');\n        setIdade(\'21 anos\');\n        setCurso(casoBeatrizSuperior.cabecalho.curso);\n        setModulo(casoBeatrizSuperior.cabecalho.modulo_periodo);\n        setDisciplina(casoBeatrizSuperior.cabecalho.componente_curricular);\n        setCondicao(casoBeatrizSuperior.historico_napne.descricao_condicao_especifica);\n        setPotentialidades(casoBeatrizSuperior.estudo_de_caso.potencialidades.map(p => p.descricao).join(\' \'));\n        setAssistiveTech(casoBeatrizSuperior.estudo_de_caso.recursos_ta.join(\', \'));\n        setStatusDiagnostico(\'confirmado\');\n        setSolucaoId(\'sol-visual-sql\');\n        setBenchmarkFeedback(\'Caso real de Beatriz carregado: Refer\303\252ncia de Baixa Vis\303\243o, NVDA e Terminal CLI em Banco de Dados SQL.\');\n        break;\n\n      case \'larissa\':\n        setNome(\'Larissa (Caso Refer\303\252ncia - Superior)\');\n        setMatricula(\'2023.2.BSI.008\');\n        setIdade(\'22 anos\');\n        setCurso(casoLarissaSuperior.cabecalho.curso);\n        setModulo(casoLarissaSuperior.cabecalho.modulo_periodo);\n        setDisciplina(casoLarissaSuperior.cabecalho.componente_curricular);\n        setCondicao(casoLarissaSuperior.historico_napne.descricao_condicao_especifica);\n        setPotentialidades(casoLarissaSuperior.estudo_de_caso.potencialidades.map(p => p.descricao).join(\' \'));\n        setAssistiveTech(casoLarissaSuperior.estudo_de_caso.recursos_ta.join(\', \'));\n        setStatusDiagnostico(\'confirmado\');\n        setSolucaoId(\'sol-tdah-engenharia\');\n        setBenchmarkFeedback(\'Caso real de Larissa carregado: Refer\303\252ncia de TDAH + Altas Habilidades e Sprints \303\201geis em Engenharia de Software.\');\n        break;\n\n      case \'superior_geral\':\n        setNome(\'Estudante Superior TI (Refer\303\252ncia)\');\n        setMatricula(\'2024.2.BSI.031\');\n        setIdade(\'20 anos\');\n        setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o\');\n        setModulo(\'3\302\272 Semestre / Noturno\');\n        setDisciplina(\'Arquitetura de Software e Microsservi\303\247os\');\n        setCondicao(\'Dificuldade de regula\303\247\303\243o em aulas expositivas longas e necessidade de prazos estruturados com entregas modulares.\');\n        setPotentialidades(\'Pensamento computacional anal\303\255tico, curiosidade em padr\303\265es de design (GoF) e automa\303\247\303\243o.\');\n        setAssistiveTech(\'Quadro Kanban com micro-sprints semanais, testes automatizados e reposit\303\263rio Git com revis\303\265es formativas.\');\n        setStatusDiagnostico(\'confirmado\');\n        setSolucaoId(\'sol-tdah-engenharia\');\n        setBenchmarkFeedback(\'Caso de Refer\303\252ncia Superior carregado: Foco em Arquitetura, Kanban e entregas modulares.\');\n        break;\n    }\n  };\n\n  const handleSelectPredefinedSolution = (id: string) => {\n    setSolucaoId(id);\n    const sol = bancoDeSolucoesPedagogicas.find((s) => s.id === id);\n    if (sol) {\n      setCondicao(`${sol.condicao}: ${sol.descricaoProblema}`);\n      setAssistiveTech(sol.remediosSugeridos.recursosTA.join(\', \'));\n      setPotentialidades(\n        \'Racioc\303\255nio l\303\263gico, boa capacidade de abstra\303\247\303\243o e dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o.\'\n      );\n\n      if (id === \'sol-hipotese-sem-laudo\') {\n        setStatusDiagnostico(\'em_investigacao_hipotese\');\n      } else {\n        setStatusDiagnostico(\'confirmado\');\n      }\n\n      if (sol.nivelSugerido === \'Superior TI\') {\n        setPerfilModalidade(\'superior_ti\');\n        setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\');\n        setModulo(\'4\302\272 Semestre / Noturno\');\n      } else if (sol.nivelSugerido === \'M\303\251dio T\303\251cnico\') {\n        setPerfilModalidade(\'medio_tecnico\');\n        setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n        setModulo(\'2\302\272 Ano / Diurno\');\n      }\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!nome.trim() || !disciplina.trim()) return;\n\n    setIsGenerating(true);\n    const modalidadeDesc = perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\';\n    setStepMessage(`1/3: Ioda AI consultando refer\303\252ncias do perfil [${modalidadeDesc}] e normas do NAPNE...`);\n\n    try {\n      let finalPei: PEICompleto | null = null;\n\n      // Call Gemini API on backend with timeout\n      try {\n        const timeoutPromise = new Promise((_, reject) =>\n          setTimeout(() => reject(new Error(\'Timeout\')), 7000)\n        );\n\n        const fetchPromise = fetch(\'/api/gemini/generate-pei\', {\n          method: \'POST\',\n          headers: {\n            \'Content-Type\': \'application/json\',\n            Accept: \'application/json\',\n          },\n          body: JSON.stringify({\n            studentName: nome.trim(),\n            grade: modulo.trim(),\n            course: curso.trim(),\n            subject: disciplina.trim(),\n            barriers: condicao.trim(),\n            potentialities: potencialidades.trim(),\n            assistiveTech: assistiveTech.trim(),\n            docenteRegente: docenteRegente.trim(),\n            docenteAee: docenteAee.trim(),\n            age: idade.trim(),\n            perfilModalidade,\n            statusDiagnostico,\n            campus: \'Campus Para\303\255so\',\n          }),\n        });\n\n        setStepMessage(`2/3: Mapeando Tecnologias Assistivas e acomoda\303\247\303\265es de laborat\303\263rio para ${modalidadeDesc}...`);\n\n        const response: any = await Promise.race([fetchPromise, timeoutPromise]);\n        const contentType = response.headers?.get(\'content-type\') || \'\';\n\n        if (contentType.includes(\'application/json\')) {\n          const resData = await response.json();\n          if (resData.success && resData.data) {\n            const gen = resData.data;\n\n            setStepMessage(`3/3: Estruturando Metas SMART e DUA 3.0 alinhados a ${modalidadeDesc}...`);\n\n            finalPei = {\n              id: `PEI-${Date.now().toString().slice(-4)}`,\n              cabecalho: {\n                estudante: gen.cabecalho?.estudante || nome.trim(),\n                codigo_matricula:\n                  gen.cabecalho?.codigo_matricula ||\n                  matricula.trim() ||\n                  `TI-${Math.floor(1000 + Math.random() * 9000)}`,\n                idade: idade.trim(),\n                curso: gen.cabecalho?.curso || curso.trim(),\n                componente_curricular: gen.cabecalho?.componente_curricular || disciplina.trim(),\n                modulo_periodo: gen.cabecalho?.modulo_periodo || modulo.trim(),\n                data_elaboracao: new Date().toISOString().split(\'T\')[0],\n                docente_regente: docenteRegente.trim(),\n                docente_aee: docenteAee.trim(),\n                profissional_apoio: perfilModalidade === \'superior_ti\'\n                  ? \'Monitor de Acessibilidade Digital\'\n                  : \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\n                coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n              },\n              historico_napne: {\n                status_diagnostico: statusDiagnostico,\n                categoria_neurodivergencia:\n                  statusDiagnostico === \'em_investigacao_hipotese\'\n                    ? \'Hip\303\263tese Diagn\303\263stica / Sem Laudo Fechado (Portaria MEC n\302\272 421/2026)\'\n                    : \'Diagn\303\263stico Confirmado em Prontu\303\241rio NAPNE\',\n                cid_ou_hipotese:\n                  statusDiagnostico === \'em_investigacao_hipotese\'\n                    ? \'Em investiga\303\247\303\243o pedag\303\263gica multiprofissional pelo NAPNE Campus Para\303\255so\'\n                    : \'Laudo pericial m\303\251dico arquivado no prontu\303\241rio do NAPNE\',\n                breve_historico_clinico_familiar:\n                  gen.historico_e_condicao_napne?.breve_historico_clinico_familiar ||\n                  `Estudante do ${curso.trim()} no Campus Para\303\255so (${modalidadeDesc}). Acompanhamento pedag\303\263gico individualizado nos termos do Decreto n\302\272 12.686/2025 e Portaria MEC n\302\272 421/2026.${\n                    statusDiagnostico === \'em_investigacao_hipotese\'\n                      ? \' Atendimento garantido sem exig\303\252ncia de laudo m\303\251dico pericial pr\303\251vio.\'\n                      : \'\'\n                  }`,\n                descricao_condicao_especifica:\n                  gen.historico_e_condicao_napne?.descricao_condicao_especifica || condicao.trim(),\n                informacoes_dos_pais:\n                  gen.historico_e_condicao_napne?.informacoes_dos_pais ||\n                  (perfilModalidade === \'superior_ti\'\n                    ? \'Estudante com autonomia acad\303\252mica universit\303\241ria em contato com o NAPNE e coordena\303\247\303\243o do curso.\'\n                    : \'Estudante e respons\303\241veis em contato constante com o NAPNE Campus Para\303\255so e coordena\303\247\303\243o do curso.\'),\n              },\n              estudo_de_caso: {\n                barreiras: (gen.estudo_de_caso_sintese?.barreiras_identificadas || []).map(\n                  (bText: string, i: number) => ({\n                    id: `B${i + 1}`,\n                    categoria: \'metodologica\',\n                    descricao: bText,\n                    impacto: \'Dificuldade de participa\303\247\303\243o equ\303\242nime na aus\303\252ncia de recursos adaptados.\',\n                    estrategia_enfrentamento: \'Elimina\303\247\303\243o da barreira atrav\303\251s do DUA 3.0 e Tecnologias Assistivas.\',\n                  })\n                ),\n                potencialidades: (gen.estudo_de_caso_sintese?.potencialidades_interesses || []).map(\n                  (pText: string, i: number) => ({\n                    id: `P${i + 1}`,\n                    area: \'\303\201rea T\303\251cnica e Pensamento Computacional\',\n                    descricao: pText,\n                    apoio_demandado: \'Mobiliza\303\247\303\243o pedag\303\263gica nas aulas te\303\263ricas e pr\303\241ticas de laborat\303\263rio.\',\n                  })\n                ),\n                recursos_ta: gen.estudo_de_caso_sintese?.recursos_tecnologia_assistiva || [\n                  assistiveTech.trim() || \'Recursos de Tecnologia Assistiva e tempo ampliado\',\n                ],\n                sintese_observacao: {\n                  interacao_professores: \'Participativo e reflexivo nas discuss\303\265es conceituais.\',\n                  interacao_colegas: \'Excelente integra\303\247\303\243o em metodologias ativas e pareamento.\',\n                  tarefas_coletivas: \'Contribui de forma ativa na arquitetura e documenta\303\247\303\243o de projetos.\',\n                  interesses_centrais: disciplina.trim(),\n                  habilidades_tecnicas: \'Pensamento computacional e capacidade l\303\263gica.\',\n                  autonomia_rotina: \'Autonomia com suporte das acomoda\303\247\303\265es recomendadas.\',\n                },\n              },\n              planejamento_pei: {\n                conteudo_ementa_oficial:\n                  gen.planejamento_pedagogico_pei?.conteudo_ementa_oficial ||\n                  `Ementa Oficial: ${disciplina.trim()}. Fundamentos te\303\263ricos e pr\303\241ticas de desenvolvimento no ${curso.trim()}.`,\n                competencias_habilidades_ementa:\n                  gen.planejamento_pedagogico_pei?.competencias_habilidades_ementa ||\n                  `Desenvolver compet\303\252ncias de an\303\241lise, modelagem e codifica\303\247\303\243o em ${disciplina.trim()}.`,\n                adaptacao_flexibilizacao_curricular:\n                  gen.planejamento_pedagogico_pei?.adaptacao_flexibilizacao_curricular ||\n                  `Curr\303\255culo integral (${modalidadeDesc}) sem redu\303\247\303\265es conceituais. Acessibilidade metodol\303\263gica garantida pelo DUA 3.0.`,\n                objetivos_e_metas: (gen.planejamento_pedagogico_pei?.objetivos_e_metas_adaptadas || []).map(\n                  (m: any) => ({\n                    id_meta: m.id_meta || \'M1\',\n                    descricao_meta: m.descricao_meta,\n                    prazo: m.prazo || \'Mensal (4 semanas)\',\n                    indicador_sucesso: m.indicador_sucesso,\n                    progresso_percentual: 50,\n                    status: \'em_andamento\',\n                  })\n                ),\n                flexibilizacao_metodologica_dua: {\n                  engajamento: gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.engajamento || [\n                    perfilModalidade === \'superior_ti\'\n                      ? \'Projetos aplicados corporativos com metodologia \303\241gil Kanban/GitHub e sustenta\303\247\303\243o oral.\'\n                      : \'Projetos pr\303\241ticos no laborat\303\263rio com Pair Programming e impacto na comunidade.\',\n                  ],\n                  representacao: gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.representacao || [\n                    \'Disponibiliza\303\247\303\243o antecipada de roteiros em Markdown e tutoriais passo a passo.\',\n                  ],\n                  acao_e_expressao: gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.acao_e_expressao || [\n                    \'Tempo estendido (+50%) e entrega cont\303\255nua em reposit\303\263rio Git com crit\303\251rios anal\303\255ticos.\',\n                  ],\n                },\n                gestao_sala_de_aula: {\n                  organizacao_espacial:\n                    \'Bancada de laborat\303\263rio acess\303\255vel com layout ergon\303\264mico e espa\303\247o amplo para circula\303\247\303\243o.\',\n                  rotina_e_pausas:\n                    \'Pausas programadas a cada 45-60 minutos para preven\303\247\303\243o de fadiga f\303\255sica e sensorial.\',\n                  agrupamentos_e_tutoria: perfilModalidade === \'superior_ti\'\n                    ? \'Projetos colaborativos em equipe \303\241gil (Sprints/Kanban) e orienta\303\247\303\243o t\303\251cnica individualizada.\'\n                    : \'Trabalho em duplas colaborativas (Pair Programming: piloto e copiloto) e tutoria orientada.\',\n                  suporte_docente_semanal:\n                    \'Sess\303\243o semanal de alinhamento pedag\303\263gico entre o docente de TI e o NAPNE Campus Para\303\255so.\',\n                },\n                estrategias_avaliacao: {\n                  formato_acessivel:\n                    gen.planejamento_pedagogico_pei?.estrategias_de_avaliacao?.formato_acessivel ||\n                    \'Avalia\303\247\303\243o processual formativa com projetos em etapas e tempo estendido (+50%).\',\n                  criterio_de_sucesso:\n                    gen.planejamento_pedagogico_pei?.estrategias_de_avaliacao?.criterio_de_sucesso ||\n                    \'Compreens\303\243o substantiva da l\303\263gica e dos conceitos t\303\251cnicos exigidos na ementa.\',\n                  grau_mediacao: \'pouca_mediacao\',\n                  tempo_e_espaco: \'Tempo estendido (+50%) em laborat\303\263rio com recursos de TA.\',\n                  recursos_utilizados:\n                    gen.estudo_de_caso_sintese?.recursos_tecnologia_assistiva || [\n                      \'Perfil de acessibilidade no ambiente de desenvolvimento\',\n                      \'Tempo estendido (+50%)\',\n                    ],\n                },\n                observacoes_docente: `PEI gerado pelo agente Ioda para ${nome.trim()} no NAPNE Campus Para\303\255so (${modalidadeDesc}), com fundamenta\303\247\303\243o na Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.`,\n              },\n              painel_notas: [\n                {\n                  id: `N_auto_${Date.now()}`,\n                  autor: docenteRegente.trim(),\n                  papel: \'Regente\',\n                  categoria: \'objetivos\',\n                  conteudo: `In\303\255cio do acompanhamento pedag\303\263gico inclusivo com Ioda AI para ${disciplina.trim()} (${modalidadeDesc}) no Campus Para\303\255so.`,\n                  data: new Date().toLocaleDateString(\'pt-BR\'),\n                  cor: \'green\',\n                },\n              ],\n              metricas: {\n                percentual_metas_alcancadas: 45,\n                nivel_autonomia: 4,\n                engajamento: 5,\n                sessoes_semanais_realizadas: 4,\n                status_geral: \'EM_ANDAMENTO\',\n              },\n              parecer_pedagogico: `PEI estruturado pelo agente Ioda para o perfil ${modalidadeDesc} em conson\303\242ncia com a Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.`,\n              sugestoes_proximo_ciclo: [\n                \'Manter as sess\303\265es semanais de suporte pedag\303\263gico com o NAPNE Campus Para\303\255so.\',\n                `Avan\303\247ar para projeto pr\303\241tico integrador de ${modalidadeDesc} no per\303\255odo seguinte.`,\n              ],\n            };\n          }\n        }\n      } catch (err) {\n        console.warn(\'API fetch did not return within threshold, generating via Ioda Pedagogical Engine:\', err);\n      }\n\n      // If remote call failed or timed out, synthesize with zero latency via local Ioda engine\n      if (!finalPei) {\n        finalPei = gerarNovoPeiCompleto({\n          nome: nome.trim(),\n          matricula: matricula.trim(),\n          idade: idade.trim(),\n          curso: curso.trim(),\n          disciplina: disciplina.trim(),\n          modulo: modulo.trim(),\n          condicao: condicao.trim() || \'Barreiras observadas no laborat\303\263rio de inform\303\241tica.\',\n          docenteRegente: docenteRegente.trim(),\n          docenteAee: docenteAee.trim(),\n          solucaoBaseId: solucaoId,\n          statusDiagnostico,\n        });\n      }\n\n      onAddStudent(finalPei);\n      onClose();\n    } finally {\n      setIsGenerating(false);\n      setStepMessage(\'\');\n    }\n  };\n\n  // Filter solutions that match current profile\n  const filteredSolutions = bancoDeSolucoesPedagogicas.filter((sol) => {\n    if (perfilModalidade === \'medio_tecnico\') {\n      return sol.nivelSugerido === \'M\303\251dio T\303\251cnico\' || sol.nivelSugerido === \'Ambos\';\n    }\n    return sol.nivelSugerido === \'Superior TI\' || sol.nivelSugerido === \'Ambos\';\n  });\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto\">\n      <div className=\"bg-white rounded-2xl max-w-3xl w-full p-5 sm:p-7 shadow-2xl border border-slate-200 my-6 max-h-[92vh] overflow-y-auto\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-4 border-b border-slate-100 mb-5\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-9 h-9 rounded-xl bg-emerald-100 flex items-center justify-center text-emerald-800 shadow-xs\">\n              <UserPlus className=\"w-5 h-5\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-base sm:text-lg font-bold text-slate-900\">\n                  Cadastrar Estudante & Gerar PEI \302\267 Ioda\n                </h3>\n                <span className=\"text-[10px] bg-emerald-100 text-emerald-900 font-semibold px-2 py-0.5 rounded font-mono\">\n                  NAPNE Campus Para\303\255so\n                </span>\n              </div>\n              <span className=\"text-xs text-slate-500\">\n                Selecione a modalidade de ensino para carregar refer\303\252ncias reais do campus e gerar o PEI adaptado\n              </span>\n            </div>\n          </div>\n          <button\n            onClick={onClose}\n            disabled={isGenerating}\n            className=\"p-1 text-slate-400 hover:text-slate-600 rounded-lg cursor-pointer disabled:opacity-50\"\n            title=\"Fechar\"\n          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* 1. PRIMARY PROFILE SELECTOR: M\303\251dio T\303\251cnico vs Superior em TI */}\n        <div className=\"mb-5 p-3.5 bg-slate-50 border-2 border-slate-200 rounded-xl\">\n          <div className=\"flex items-center justify-between mb-2\">\n            <label className=\"text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5\">\n              <span className=\"w-5 h-5 rounded-full bg-emerald-700 text-white inline-flex items-center justify-center text-[11px] font-bold\">1</span>\n              Seletor de Perfil Institucional (Obrigat\303\263rio):\n            </label>\n            <span className=\"text-[11px] font-semibold text-emerald-800 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full\">\n              {perfilModalidade === \'medio_tecnico\' ? \'15 alunos no Campus\' : \'14 alunos no Campus\'}\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2.5\">\n            {/* Option 1: Ensino M\303\251dio T\303\251cnico em Inform\303\241tica */}\n            <button\n              type=\"button\"\n              onClick={() => handleSelectProfile(\'medio_tecnico\')}\n              className={`p-3 rounded-xl border-2 text-left transition-all cursor-pointer relative ${\n                perfilModalidade === \'medio_tecnico\'\n                  ? \'bg-emerald-50/80 border-emerald-700 shadow-sm\'\n                  : \'bg-white border-slate-200 hover:border-slate-300 opacity-80\'\n              }`}\n            >\n              <div className=\"flex items-start justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className={`p-1.5 rounded-lg ${perfilModalidade === \'medio_tecnico\' ? \'bg-emerald-700 text-white\' : \'bg-slate-100 text-slate-600\'}`}>\n                    <Laptop className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <h4 className=\"font-bold text-slate-900 text-xs sm:text-sm\">M\303\251dio T\303\251cnico em TI</h4>\n                    <span className=\"text-[10px] text-slate-500 font-medium\">T\303\251cnico Integrado em Inform\303\241tica</span>\n                  </div>\n                </div>\n                {perfilModalidade === \'medio_tecnico\' && (\n                  <CheckCircle className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                )}\n              </div>\n              <p className=\"text-[11px] text-slate-600 mt-2 leading-relaxed\">\n                Articula\303\247\303\243o com a BNCC, laborat\303\263rios de inform\303\241tica, duplas de Pair Programming e acompanhamento de monitoria.\n              </p>\n              <div className=\"mt-2 pt-2 border-t border-slate-200/60 flex items-center justify-between text-[10px] text-emerald-900 font-medium\">\n                <span>15 estudantes acompanhados</span>\n                <span className=\"font-mono\">Casos: Lucas, Matheus, Cau\303\243</span>\n              </div>\n            </button>\n\n            {/* Option 2: Ensino Superior em TI */}\n            <button\n              type=\"button\"\n              onClick={() => handleSelectProfile(\'superior_ti\')}\n              className={`p-3 rounded-xl border-2 text-left transition-all cursor-pointer relative ${\n                perfilModalidade === \'superior_ti\'\n                  ? \'bg-emerald-50/80 border-emerald-700 shadow-sm\'\n                  : \'bg-white border-slate-200 hover:border-slate-300 opacity-80\'\n              }`}\n            >\n              <div className=\"flex items-start justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <div className={`p-1.5 rounded-lg ${perfilModalidade === \'superior_ti\' ? \'bg-emerald-700 text-white\' : \'bg-slate-100 text-slate-600\'}`}>\n                    <GraduationCap className=\"w-4 h-4\" />\n                  </div>\n                  <div>\n                    <h4 className=\"font-bold text-slate-900 text-xs sm:text-sm\">Superior em TI</h4>\n                    <span className=\"text-[10px] text-slate-500 font-medium\">Sistemas de Informa\303\247\303\243o & Gest\303\243o de TI</span>\n                  </div>\n                </div>\n                {perfilModalidade === \'superior_ti\' && (\n                  <CheckCircle className=\"w-4 h-4 text-emerald-700 shrink-0 mt-0.5\" />\n                )}\n              </div>\n              <p className=\"text-[11px] text-slate-600 mt-2 leading-relaxed\">\n                Autonomia acad\303\252mica, abstra\303\247\303\243o l\303\263gica, projetos \303\241geis (Kanban/GitHub), terminal CLI acess\303\255vel e modelos de dados.\n              </p>\n              <div className=\"mt-2 pt-2 border-t border-slate-200/60 flex items-center justify-between text-[10px] text-emerald-900 font-medium\">\n                <span>14 estudantes acompanhados</span>\n                <span className=\"font-mono\">Casos: Beatriz, Larissa</span>\n              </div>\n            </button>\n          </div>\n        </div>\n\n        {/* 2. REAL CASES BENCHMARK PICKER: Specific to chosen modality */}\n        <div className=\"mb-5 p-3.5 bg-blue-50/50 border border-blue-200 rounded-xl space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <label className=\"text-xs font-bold text-blue-950 uppercase tracking-wider flex items-center gap-1.5\">\n              <Sparkles className=\"w-4 h-4 text-blue-700\" />\n              <span>Casos Reais de Refer\303\252ncia do Campus Para\303\255so ({perfilModalidade === \'medio_tecnico\' ? \'M\303\251dio T\303\251cnico\' : \'Superior TI\'}):</span>\n            </label>\n            <span className=\"text-[10px] text-blue-700 font-medium bg-blue-100/70 px-2 py-0.5 rounded\">\n              Clique para preencher como base\n            </span>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-2\">\n            {perfilModalidade === \'medio_tecnico\' ? (\n              <>\n                <button\n                  type=\"button\"\n                  onClick={() => handleLoadRealCaseBenchmark(\'lucas\')}\n                  className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Lucas</span>\n                    <span className=\"text-[9px] bg-emerald-100 text-emerald-800 px-1 rounded font-mono\">Web/Algoritmos</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                    Paralisia Cerebral: Pair Programming orientado, atalhos de VS Code e tempo estendido (+50%).\n                  </p>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => handleLoadRealCaseBenchmark(\'matheus\')}\n                  className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Matheus</span>\n                    <span className=\"text-[9px] bg-purple-100 text-purple-800 px-1 rounded font-mono\">Redes & SO</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                    TEA & Sensorial: Abafador de ru\303\255do para rack/laborat\303\263rio, comandos diretos e cronograma antecipado.\n                  </p>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => handleLoadRealCaseBenchmark(\'caua\')}\n                  className=\"p-2.5 bg-white border border-blue-200 hover:border-amber-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-bold text-xs text-slate-900 group-hover:text-amber-800\">Caso Cau\303\243</span>\n                    <span className=\"text-[9px] bg-amber-100 text-amber-800 px-1 rounded font-mono\">Sem Laudo</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                    Portaria MEC 421/2026: Enunciados fracionados e tabelas de casos de teste (Input/Output).\n                  </p>\n                </button>\n              </>\n            ) : (\n              <>\n                <button\n                  type=\"button\"\n                  onClick={() => handleLoadRealCaseBenchmark(\'beatriz\')}\n                  className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Beatriz</span>\n                    <span className=\"text-[9px] bg-blue-100 text-blue-800 px-1 rounded font-mono\">Banco de Dados/SQL</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                    Baixa Vis\303\243o: Terminal CLI acess\303\255vel ao NVDA, modelos em DBML textual e audiodescri\303\247\303\243o.\n                  </p>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => handleLoadRealCaseBenchmark(\'larissa\')}\n                  className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Larissa</span>\n                    <span className=\"text-[9px] bg-indigo-100 text-indigo-800 px-1 rounded font-mono\">Eng. Software</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                    TDAH + Altas Habilidades: Gest\303\243o \303\241gil via Kanban/GitHub, micro-sprints e enriquecimento curricular.\n                  </p>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => handleLoadRealCaseBenchmark(\'superior_geral\')}\n                  className=\"p-2.5 bg-white border border-blue-200 hover:border-emerald-600 rounded-lg text-left transition-all cursor-pointer hover:shadow-xs group\"\n                >\n                  <div className=\"flex items-center justify-between\">\n                    <span className=\"font-bold text-xs text-slate-900 group-hover:text-emerald-800\">Caso Geral TI</span>\n                    <span className=\"text-[9px] bg-slate-100 text-slate-800 px-1 rounded font-mono\">Arquitetura</span>\n                  </div>\n                  <p className=\"text-[11px] text-slate-600 mt-1 line-clamp-2\">\n                    Autonomia universit\303\241ria: Avalia\303\247\303\243o pr\303\241tica de c\303\263digo via Git e sustenta\303\247\303\243o oral da arquitetura.\n                  </p>\n                </button>\n              </>\n            )}\n          </div>\n\n          {benchmarkFeedback && (\n            <div className=\"p-2 bg-emerald-50 border border-emerald-200 rounded-lg text-[11px] text-emerald-900 font-medium flex items-center gap-1.5 animate-fadeIn\">\n              <CheckCircle className=\"w-3.5 h-3.5 text-emerald-700 shrink-0\" />\n              <span>{benchmarkFeedback}</span>\n            </div>\n          )}\n        </div>\n\n        {/* 3. DIAGNOSTIC STATUS (Portaria MEC 421/2026) */}\n        <div className=\"mb-5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n          <label className=\"text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5\">\n            <span className=\"w-5 h-5 rounded-full bg-slate-700 text-white inline-flex items-center justify-center text-[11px] font-bold\">2</span>\n            Situa\303\247\303\243o Diagn\303\263stica do Estudante:\n          </label>\n          <div className=\"grid grid-cols-2 gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => setStatusDiagnostico(\'confirmado\')}\n              className={`p-2 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer flex items-center justify-center gap-1.5 ${\n                statusDiagnostico === \'confirmado\'\n                  ? \'bg-blue-800 text-white border-blue-900 shadow-xs\'\n                  : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-100\'\n              }`}\n            >\n              <FileCheck2 className=\"w-3.5 h-3.5\" />\n              <span>Diagn\303\263stico Confirmado (24 no campus)</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setStatusDiagnostico(\'em_investigacao_hipotese\')}\n              className={`p-2 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer flex items-center justify-center gap-1.5 ${\n                statusDiagnostico === \'em_investigacao_hipotese\'\n                  ? \'bg-amber-600 text-white border-amber-700 shadow-xs\'\n                  : \'bg-white text-amber-900 border-amber-300 hover:bg-amber-50\'\n              }`}\n            >\n              <HelpCircle className=\"w-3.5 h-3.5\" />\n              <span>Sem Laudo / Em Investiga\303\247\303\243o (5 no campus)</span>\n            </button>\n          </div>\n\n          {statusDiagnostico === \'em_investigacao_hipotese\' && (\n            <div className=\"p-2.5 bg-amber-50 border border-amber-200 rounded-lg text-[11px] text-amber-900 leading-relaxed flex items-start gap-2 mt-2\">\n              <ShieldCheck className=\"w-4 h-4 text-amber-700 shrink-0 mt-0.5\" />\n              <span>\n                <strong>Garantia Legal Portaria MEC n\302\272 421/2026:</strong> A aus\303\252ncia de laudo m\303\251dico pericial n\303\243o impede a elabora\303\247\303\243o do PEI nem a disponibiliza\303\247\303\243o de acomoda\303\247\303\265es no laborat\303\263rio de TI. O plano \303\251 centrado na elimina\303\247\303\243o de barreiras contextuais.\n              </span>\n            </div>\n          )}\n        </div>\n\n        {/* 4. SOLUTION BANK CARDS (Filtered by selected profile) */}\n        <div className=\"mb-5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <label className=\"text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5\">\n              <span className=\"w-5 h-5 rounded-full bg-slate-700 text-white inline-flex items-center justify-center text-[11px] font-bold\">3</span>\n              Solu\303\247\303\265es do Banco DUA 3.0 para {perfilModalidade === \'medio_tecnico\' ? \'M\303\251dio T\303\251cnico\' : \'Superior TI\'}:\n            </label>\n            <span className=\"text-[10px] text-slate-500 font-mono\">Filtro Ativo</span>\n          </div>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-1.5 max-h-36 overflow-y-auto pr-1\">\n            {filteredSolutions.map((sol) => (\n              <button\n                key={sol.id}\n                type=\"button\"\n                onClick={() => handleSelectPredefinedSolution(sol.id)}\n                className={`p-2 text-left text-xs rounded-lg border transition-all cursor-pointer ${\n                  solucaoId === sol.id\n                    ? \'bg-emerald-50 border-emerald-500 text-emerald-950 font-semibold shadow-xs\'\n                    : \'bg-white border-slate-300 text-slate-700 hover:border-slate-400\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-bold text-slate-900 truncate\">{sol.titulo.split(\'/\')[0]}</span>\n                  <span className=\"text-[9px] text-slate-500 font-mono shrink-0 ml-1\">\n                    {sol.nivelSugerido}\n                  </span>\n                </div>\n                <p className=\"text-[10px] text-slate-500 mt-0.5 truncate\">\n                  {sol.condicao}\n                </p>\n              </button>\n            ))}\n          </div>\n        </div>\n\n        {/* FORM FIELDS */}\n        <form onSubmit={handleSubmit} className=\"space-y-4 text-xs\">\n          <div className=\"p-3 bg-slate-50/60 rounded-xl border border-slate-200\">\n            <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider mb-2.5\">\n              4. Dados do Estudante e do Componente Curricular:\n            </h4>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3\">\n              <div className=\"sm:col-span-2\">\n                <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                  Nome Completo do Estudante\n                </label>\n                <input\n                  type=\"text\"\n                  value={nome}\n                  onChange={(e) => setNome(e.target.value)}\n                  placeholder=\"Ex: Gabriel Moreira Silva\"\n                  className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white\"\n                  required\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                  Matr\303\255cula / C\303\263digo\n                </label>\n                <input\n                  type=\"text\"\n                  value={matricula}\n                  onChange={(e) => setMatricula(e.target.value)}\n                  placeholder=\"Ex: 2026.1.INF.092\"\n                  className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white\"\n                />\n              </div>\n            </div>\n\n            <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3 mb-3\">\n              <div className=\"sm:col-span-2\">\n                <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                  Curso de TI\n                </label>\n                <input\n                  type=\"text\"\n                  value={curso}\n                  onChange={(e) => setCurso(e.target.value)}\n                  className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white\"\n                  required\n                />\n              </div>\n\n              <div>\n                <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                  M\303\263dulo / Per\303\255odo\n                </label>\n                <input\n                  type=\"text\"\n                  value={modulo}\n                  onChange={(e) => setModulo(e.target.value)}\n                  className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white\"\n                  required\n                />\n              </div>\n            </div>\n\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Componente Curricular / Disciplina de Computa\303\247\303\243o\n              </label>\n              <input\n                type=\"text\"\n                value={disciplina}\n                onChange={(e) => setDisciplina(e.target.value)}\n                placeholder=\"Ex: Programa\303\247\303\243o Web, Banco de Dados, Redes, Algoritmos\"\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white\"\n                required\n              />\n            </div>\n          </div>\n\n          <div>\n            <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n              Barreiras Observadas no Contexto Escolar / Laborat\303\263rio de TI\n            </label>\n            <textarea\n              value={condicao}\n              onChange={(e) => setCondicao(e.target.value)}\n              rows={2}\n              placeholder=\"Descreva as barreiras metodol\303\263gicas, comunicacionais ou tecnol\303\263gicas observadas em aula\"\n              className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Potencialidades e Interesses\n              </label>\n              <textarea\n                value={potencialidades}\n                onChange={(e) => setPotentialidades(e.target.value)}\n                rows={2}\n                placeholder=\"Racioc\303\255nio l\303\263gico, afinidade com linguagens de programa\303\247\303\243o, jogos\"\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Recursos de Tecnologia Assistiva Desejados\n              </label>\n              <textarea\n                value={assistiveTech}\n                onChange={(e) => setAssistiveTech(e.target.value)}\n                rows={2}\n                placeholder=\"Ex: Linters de c\303\263digo, fontes acess\303\255veis, tempo estendido (+50%), abafadores\"\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Docente Regente da Disciplina\n              </label>\n              <input\n                type=\"text\"\n                value={docenteRegente}\n                onChange={(e) => setDocenteRegente(e.target.value)}\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white\"\n              />\n            </div>\n\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Coordena\303\247\303\243o NAPNE (Campus Para\303\255so)\n              </label>\n              <input\n                type=\"text\"\n                value={docenteAee}\n                disabled\n                className=\"w-full p-2.5 border border-slate-200 bg-slate-50 text-slate-600 rounded-lg\"\n              />\n            </div>\n          </div>\n\n          {/* Dynamic Progress indicator during AI generation */}\n          {isGenerating && (\n            <div className=\"p-3.5 bg-emerald-50 border border-emerald-200 rounded-xl flex items-center gap-3 animate-pulse\">\n              <Loader2 className=\"w-5 h-5 text-emerald-800 animate-spin shrink-0\" />\n              <div className=\"text-xs\">\n                <span className=\"font-bold text-emerald-950 block\">\n                  Agente Ioda gerando PEI personalizado para {perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\'}...\n                </span>\n                <span className=\"text-emerald-800 font-medium\">{stepMessage}</span>\n              </div>\n            </div>\n          )}\n\n          {/* Modal Actions */}\n          <div className=\"pt-3 border-t border-slate-100 flex items-center justify-between\">\n            <div className=\"text-[11px] text-slate-500 flex items-center gap-1.5\">\n              <Info className=\"w-3.5 h-3.5 text-slate-400\" />\n              <span>\n                Perfil ativo: <strong>{perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\'}</strong>\n              </span>\n            </div>\n\n            <div className=\"flex items-center gap-2\">\n              <button\n                type=\"button\"\n                onClick={onClose}\n                disabled={isGenerating}\n                className=\"px-4 py-2 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 cursor-pointer disabled:opacity-50\"\n              >\n                Cancelar\n              </button>\n\n              <button\n                type=\"submit\"\n                disabled={isGenerating || !nome.trim()}\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg transition-colors cursor-pointer disabled:opacity-50 shadow-sm\"\n              >\n                {isGenerating ? (\n                  <>\n                    <Loader2 className=\"w-4 h-4 animate-spin\" />\n                    <span>Gerando com Ioda AI...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4 text-emerald-200\" />\n                    <span>Gerar PEI para {perfilModalidade === \'superior_ti\' ? \'Superior\' : \'M\303\251dio T\303\251cnico\'}</span>\n                  </>\n                )}\n              </button>\n            </div>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
