    content: "  const isEngSoft =\n    finalSubject.toLowerCase().includes(\'engenharia de software\') ||\n    finalSubject.toLowerCase().includes(\'bac.0406\') ||\n    finalSubject.toLowerCase().includes(\'qualidade\');\n\n  const isVisual =\n    barriers.toLowerCase().includes(\'vis\303\243o\') ||\n    barriers.toLowerCase().includes(\'visual\') ||\n    barriers.toLowerCase().includes(\'cego\') ||\n    barriers.toLowerCase().includes(\'cegueira\');\n\n  const isMotor =\n    barriers.toLowerCase().includes(\'motor\') ||\n    barriers.toLowerCase().includes(\'digita\') ||\n    barriers.toLowerCase().includes(\'paralisia\') ||\n    barriers.toLowerCase().includes(\'espastic\') ||\n    barriers.toLowerCase().includes(\'m\303\243o\') ||\n    barriers.toLowerCase().includes(\'punho\');\n\n  const isAutism =\n    barriers.toLowerCase().includes(\'autista\') ||\n    barriers.toLowerCase().includes(\'autismo\') ||\n    barriers.toLowerCase().includes(\'tea\') ||\n    barriers.toLowerCase().includes(\'sensorial\') ||\n    barriers.toLowerCase().includes(\'ru\303\255do\');\n\n  const isAdhd =\n    barriers.toLowerCase().includes(\'tdah\') ||\n    barriers.toLowerCase().includes(\'d\303\251ficit de aten\303\247\303\243o\') ||\n    barriers.toLowerCase().includes(\'hiperativid\');\n\n  const isAnxiety =\n    barriers.toLowerCase().includes(\'ansied\') ||\n    barriers.toLowerCase().includes(\'p\303\242nico\') ||\n    barriers.toLowerCase().includes(\'f\303\263bic\');\n\n  const isLearning =\n    barriers.toLowerCase().includes(\'dislex\') ||\n    barriers.toLowerCase().includes(\'disgraf\') ||\n    barriers.toLowerCase().includes(\'discalcul\') ||\n    barriers.toLowerCase().includes(\'aprendizagem\');\n\n  const isIntellectual =\n    barriers.toLowerCase().includes(\'intelectual\') ||\n    barriers.toLowerCase().includes(\'desenvolvimento intelectual\');\n\n  const isOCD =\n    barriers.toLowerCase().includes(\'toc\') ||\n    barriers.toLowerCase().includes(\'obsessiv\') ||\n    barriers.toLowerCase().includes(\'compulsiv\');\n\n  const isDepression =\n    barriers.toLowerCase().includes(\'depress\') ||\n    barriers.toLowerCase().includes(\'anedonia\');\n\n  const isEpilepsy =\n    barriers.toLowerCase().includes(\'epilep\') ||\n    barriers.toLowerCase().includes(\'convuls\') ||\n    barriers.toLowerCase().includes(\'crise\');\n\n  // Dynamic DUA 3.0 recommendations tailored for IT modality, PPC BSI and discipline\n  const engajamento = isSuperior\n    ? [\n        isEngSoft\n          ? \'Metodologia \303\241gil com ciclos curtos de teste (TDD red-green-refactor) e rastreamento visual de tarefas e bugs no Jira / GitHub Projects (Plano de Ensino BAC.0406).\'\n          : \'Contextualiza\303\247\303\243o em problemas corporativos reais de engenharia de software, modelagem de dados e arquitetura de sistemas do PPC do BSI.\',\n        isAdhd\n          ? \'Divis\303\243o das atividades de laborat\303\263rio (LABIN/LADES) em micro-sprints com t\303\251cnica Pomodoro e entregas graduais de su\303\255tes de teste.\'\n          : isAutism\n          ? \'Previsibilidade com cronograma semanal antecipado no Moodle, rotina met\303\263dica de testes e pap\303\251is t\303\251cnicos bem definidos.\'\n          : isAnxiety\n          ? \'Ambiente de laborat\303\263rio seguro, substitui\303\247\303\243o de defesas orais abertas por v\303\255deos curtos (Loom) e rubricas anal\303\255ticas pr\303\251vias.\'\n          : isOCD\n          ? \'Crit\303\251rios expl\303\255citos de aceite (Definition of Done) para interromper refatora\303\247\303\265es infinitas com valida\303\247\303\243o por pipeline de CI/CD.\'\n          : isDepression\n          ? \'Acolhimento cont\303\255nuo com metas de pequeno porte para recomposi\303\247\303\243o da autoefic\303\241cia e apoio em duplas colaborativas.\'\n          : isEpilepsy\n          ? \'Ambiente calmo sem sobrecarga de estresse temporal e protocolo de sa\303\272de alinhado com a equipe do campus.\'\n          : isMotor\n          ? \'Metodologia de Pair Programming com rod\303\255zio orientado (aluno como arquiteto da l\303\263gica e dos testes de software).\'\n          : \'Participa\303\247\303\243o ativa em projetos acad\303\252micos e reposit\303\263rios colaborativos no GitHub com pap\303\251is de lideran\303\247a t\303\251cnica definidos.\',\n        \'Sess\303\265es de alinhamento com a coordena\303\247\303\243o pedag\303\263gica do NAPNE e docente regente no Campus Para\303\255so.\',\n      ]\n    : [\n        \'Projetos pr\303\241ticos de desenvolvimento integrados \303\240 forma\303\247\303\243o t\303\251cnica e comunit\303\241ria no IFTO Campus Para\303\255so.\',\n        isMotor\n          ? \'Metodologia de Pair Programming com rod\303\255zio orientado: divis\303\243o entre Piloto (digita\303\247\303\243o) e Copiloto (l\303\263gica).\'\n          : isAutism\n          ? \'Previsibilidade de laborat\303\263rio com cronograma antecipado, rotina estruturada de testes e regras transparentes.\'\n          : isAdhd\n          ? \'Gamifica\303\247\303\243o de conquistas semanais e tarefas de c\303\263digo fracionadas com linters visuais.\'\n          : isLearning\n          ? \'Acolhimento seguro que remove puni\303\247\303\243o por erros sint\303\241ticos, valorizando o racioc\303\255nio algor\303\255tmico.\'\n          : \'Trabalho em duplas e equipes colaborativas articuladas com a BNCC e a forma\303\247\303\243o profissional t\303\251cnica.\',\n        \'Sess\303\265es semanais de monitoria orientada e acompanhamento formativo sem press\303\243o temporal restrita.\',\n      ];\n\n  const representacao = isSuperior\n    ? [\n        isLearning\n          ? \'Instala\303\247\303\243o de fontes acess\303\255veis (OpenDyslexic Mono / JetBrains Mono) na IDE e enunciados em tabelas limpas de casos de teste (Input / Output).\'\n          : isVisual\n          ? \'Substitui\303\247\303\243o obrigat\303\263ria de diagramas rasterizados por representa\303\247\303\265es textuais estruturadas acess\303\255veis ao leitor NVDA (scripts DDL, DBML, YAML e Mermaid).\'\n          : isIntellectual\n          ? \'Fracionamento de instru\303\247\303\265es complexas em passos at\303\264micos ilustrados com tutoriais visuais e exemplos guiados no Moodle.\'\n          : isEpilepsy\n          ? \'Monitores com taxa de atualiza\303\247\303\243o est\303\241vel (60Hz+), filtros antirreflexo e temas de IDE sem contrastes estrobosc\303\263picos ou flashes.\'\n          : \'Diagrama\303\247\303\243o visual de arquiteturas, diagramas entidade-relacionamento (DER) e fluxogramas no Mermaid/UML.\',\n        isEngSoft\n          ? \'Disponibiliza\303\247\303\243o antecipada no Moodle de modelos de planos de teste (IEEE 829), especifica\303\247\303\265es de casos de teste e su\303\255tes JUnit comentadas.\'\n          : \'Disponibiliza\303\247\303\243o antecipada de roteiros de laborat\303\263rio em formato Markdown acess\303\255vel e snippets de c\303\263digo comentados.\',\n        isAutism || isOCD\n          ? \'Roteiros de laborat\303\263rio passo a passo com crit\303\251rios de aceite expl\303\255citos e sem termos amb\303\255guos ou subjetivos.\'\n          : \'Roteiros de projeto passo a passo com crit\303\251rios de aceite expl\303\255citos e casos de teste em tabelas.\',\n      ]\n    : [\n        \'Diagrama\303\247\303\243o visual de algoritmos e topologias de rede atrav\303\251s de fluxogramas coloridos e esquemas visuais.\',\n        \'Enunciados de problemas algor\303\255tmicos em t\303\263picos fracionados com casos de teste em tabelas limpas (Input / Output).\',\n        isLearning\n          ? \'Uso de fontes tipogr\303\241ficas acess\303\255veis (OpenDyslexic Mono) e realce colorido de delimitadores de c\303\263digo.\'\n          : isAutism\n          ? \'Avisos pr\303\251vios sobre mudan\303\247as no roteiro de aula e instru\303\247\303\265es diretas sem duplo sentido.\'\n          : \'Roteiros de pr\303\241tica de laborat\303\263rio estruturados em checklists graduais passo a passo.\',\n      ];\n\n  const acaoExpressao = isSuperior\n    ? [\n        isAnxiety\n          ? \'Op\303\247\303\243o de grava\303\247\303\243o de v\303\255deo/screencast curto (Loom) para demonstra\303\247\303\243o de projetos e testes em substitui\303\247\303\243o a semin\303\241rios presenciais.\'\n          : isVisual\n          ? \'Intera\303\247\303\243o com banco de dados e servidores via terminal de linha de comando (CLI/SSH) e clientes SQL por linha de comando acess\303\255veis ao NVDA.\'\n          : isMotor\n          ? \'Uso de atalhos de teclado, ferramentas de autocompletar inteligente (Copilot) e tempo estendido (+50%).\'\n          : \'Demonstra\303\247\303\243o de compet\303\252ncia por meio de reposit\303\263rio no GitHub com commits sem\303\242nticos e documenta\303\247\303\243o de arquitetura.\',\n        isEngSoft\n          ? \'Entrega cont\303\255nua de su\303\255tes de testes automatizados e planos de testes funcionais, com avalia\303\247\303\243o processual somativa por sprint.\'\n          : \'Defesa t\303\251cnica individualizada das decis\303\265es arquiteturais em substitui\303\247\303\243o a provas escritas tradicionais.\',\n        \'Tempo estendido (+50%) assegurado em avalia\303\247\303\265es pr\303\241ticas de programa\303\247\303\243o, testes e modelagem de software.\',\n      ]\n    : [\n        isMotor\n          ? \'Uso de teclado mec\303\242nico ergon\303\264mico com switches leves, mouse vertical e tempo estendido (+50%) em pr\303\241ticas avaliativas.\'\n          : \'Demonstra\303\247\303\243o pr\303\241tica atrav\303\251s de arquivos de c\303\263digo funcional, prot\303\263tipos comentados e listas de verifica\303\247\303\243o.\',\n        \'Op\303\247\303\243o de explica\303\247\303\243o oral do algoritmo diretamente ao professor ou grava\303\247\303\243o em \303\241udio/v\303\255deo.\',\n        \'Avalia\303\247\303\243o processual cont\303\255nua com base em entregas parciais de c\303\263digo e projetos pr\303\241ticos no laborat\303\263rio.\',\n      ];\n\n  // Assistive Technology suggestions tailored\n  const taList = isSuperior\n    ? [\n        isAdhd\n          ? \'Quadro Kanban integrado ao Jira / GitHub Projects e temporizador Pomodoro\'\n          : isAutism\n          ? \'Abafador de ru\303\255dos circum-aural (27dB+) e cart\303\243o de pausa sensorial para uso no LABIN\'\n          : isAnxiety\n          ? \'Ferramenta de grava\303\247\303\243o de tela Loom e rubricas anal\303\255ticas disponibilizadas no Moodle\'\n          : isLearning\n          ? \'Fontes especializadas (OpenDyslexic Mono) e linters visuais no VS Code (Error Lens)\'\n          : isEpilepsy\n          ? \'Monitores com taxa de atualiza\303\247\303\243o de 60Hz+, modo escuro suave sem piscamento\'\n          : isVisual\n          ? \'Leitor de telas NVDA configurado com sintetizador em portugu\303\252s e terminal CLI acess\303\255vel\'\n          : isMotor\n          ? \'Teclado mec\303\242nico com apoio de punho regul\303\241vel e mouse vertical ergon\303\264mico\'\n          : \'Editor VS Code com temas de alto contraste e extens\303\265es de acessibilidade t\303\251cnica\',\n        isEngSoft\n          ? \'Frameworks de automa\303\247\303\243o de testes (JUnit, Selenium) e rastreamento de defeitos (Jira)\'\n          : \'Roteiros de projeto em Markdown estruturado com documenta\303\247\303\243o t\303\251cnica limpa\',\n        \'Tempo estendido (+50%) assegurado em avalia\303\247\303\265es pr\303\241ticas de computa\303\247\303\243o\',\n        \'Bancada de laborat\303\263rio acess\303\255vel nos laborat\303\263rios LABIN 1/2/3 do Campus Para\303\255so\',\n      ]\n    : [\n        isLearning\n          ? \'Editor VS Code com fonte especializada OpenDyslexic Mono e linters visuais\'\n          : isAutism\n          ? \'Abafador de ru\303\255dos circum-aural (27dB) para uso no laborat\303\263rio de inform\303\241tica\'\n          : isMotor\n          ? \'Teclado ergon\303\264mico mec\303\242nico com switches de ativa\303\247\303\243o leve e apoio de punho articulado\'\n          : \'Editor VS Code com tema de alto contraste e atalhos ergon\303\264micos\',\n        \'Roteiros de pr\303\241tica de laborat\303\263rio em formato Markdown com casos de teste em tabelas limpas\',\n        \'Tempo estendido (+50%) garantido em avalia\303\247\303\265es e exerc\303\255cios pr\303\241ticos de programa\303\247\303\243o\',\n        \'Dupla tutoria (Pair Programming) no laborat\303\263rio de inform\303\241tica\',\n      ];\n\n  // Specific SMART goals tailored for modality and discipline\n  const metas = isSuperior\n    ? [\n        {\n          id_meta: \'M1\',\n          descricao_meta: isEngSoft\n            ? `Aplicar t\303\251cnicas de teste de software (caixa-preta, parti\303\247\303\243o de equival\303\252ncia e ciclo TDD red-green-refactor) na implementa\303\247\303\243o de su\303\255tes de testes automatizados com apoio de TA.`\n            : `Modelar, implementar e documentar as estruturas centrais de ${finalSubject} utilizando ferramentas de acessibilidade configuradas e controle de vers\303\243o no Git.`,\n          prazo: \'Mensal (4 semanas)\',\n          indicador_sucesso: isEngSoft\n            ? \'Su\303\255te de testes automatizados funcional com cobertura de c\303\263digo documentada no GitHub/Jira.\'\n            : \'Reposit\303\263rio no GitHub contendo c\303\263digo funcional, scripts documentados e valida\303\247\303\243o t\303\251cnica em laborat\303\263rio.\',\n          progresso_percentual: 50,\n          status: \'em_andamento\',\n        },\n        {\n          id_meta: \'M2\',\n          descricao_meta: isEngSoft\n            ? `Elaborar plano de testes e gerenciar o ciclo de defeitos em ferramenta de bug tracking (Jira/Bugzilla) em equipe \303\241gil com vias de apresenta\303\247\303\243o acess\303\255veis.`\n            : `Desenvolver projeto aplicado de n\303\255vel superior em equipe colaborativa com sustenta\303\247\303\243o t\303\251cnica oral e crit\303\251rios anal\303\255ticos de qualidade.`,\n          prazo: \'Bimestral (8 semanas)\',\n          indicador_sucesso: isEngSoft\n            ? \'Entrega de plano de testes completo com casos documentados e rastreabilidade entre requisitos e defeitos.\'\n            : \'Apresenta\303\247\303\243o arquitetural com entrega dos m\303\263dulos de software testados e aprovados.\',\n          progresso_percentual: 35,\n          status: \'em_andamento\',\n        },\n      ]\n    : [\n        {\n          id_meta: \'M1\',\n          descricao_meta: `Compreender e implementar algoritmos pr\303\241ticos em ${finalSubject} atrav\303\251s de exerc\303\255cios estruturados em laborat\303\263rio com apoio de TA.`,\n          prazo: \'Mensal (4 semanas)\',\n          indicador_sucesso: \'Execu\303\247\303\243o bem-sucedida do algoritmo no laborat\303\263rio com valida\303\247\303\243o t\303\251cnica pelo professor e autoavalia\303\247\303\243o.\',\n          progresso_percentual: 55,\n          status: \'em_andamento\',\n        },\n        {\n          id_meta: \'M2\',\n          descricao_meta: \'Participar ativamente da cria\303\247\303\243o de projeto pr\303\241tico em duplas (Pair Programming) aplicando as diretrizes do DUA 3.0.\',\n          prazo: \'Bimestral (8 semanas)\',\n          indicador_sucesso: \'Entrega do c\303\263digo funcional em reposit\303\263rio com divis\303\243o clara de pap\303\251is e documenta\303\247\303\243o b\303\241sica.\',\n          progresso_percentual: 35,\n          status: \'em_andamento\',\n        },\n      ];\n"
