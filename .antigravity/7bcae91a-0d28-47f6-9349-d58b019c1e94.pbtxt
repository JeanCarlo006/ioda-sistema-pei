            }
            lines {
              text: "      \'Lentifica\303\247\303\243o do processamento cognitivo, fadiga extrema e crises de anedonia/des\303\242nimo que comprometem a assiduidade e a energia necess\303\241ria para iniciar e manter projetos extensos de desenvolvimento de software.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
