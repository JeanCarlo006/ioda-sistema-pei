        replacement_content: "    },\n  },\n  {\n    id: \'sol-hipotese-sem-laudo\',\n    titulo: \'Hip\303\263tese Diagn\303\263stica / Em Investiga\303\247\303\243o pelo NAPNE (Sem Laudo - Portaria MEC 421/2026)\',\n    condicao: \'Hip\303\263tese de neurodiverg\303\252ncia ou transtorno em processo avaliativo (5 casos no Campus Para\303\255so)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade acad\303\252mica persistente em sala ou laborat\303\263rio de TI sem que o estudante possua laudo m\303\251dico com CID fechado, gerando receio docente ou risco de nega\303\247\303\243o indevida de apoios.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Garantia legal imediata de direitos: a Portaria MEC n\302\272 421/2026 e o Decreto 12.686/2025 asseguram que o PEI independe de laudo cl\303\255nico, focando na acolhida pedag\303\263gica e redu\303\247\303\243o da ansiedade.\',\n      representacao:\n        \'Diversifica\303\247\303\243o multissensorial dos conte\303\272dos (roteiros em t\303\263picos, recursos visuais, esquemas e \303\241udio explicativo); disponibiliza\303\247\303\243o pr\303\251via de materiais antes das aulas de laborat\303\263rio.\',\n      acaoExpressao:\n        \'Tempo estendido (+50%) em todas as avalia\303\247\303\265es, toler\303\242ncia a erros pontuais de ortografia de c\303\263digo, permiss\303\243o de consulta orientada e possibilidade de defesa oral da l\303\263gica.\',\n      recursosTA: [\n        \'Tempo estendido (+50%) em provas e projetos pr\303\241ticos\',\n        \'Extens\303\265es de aux\303\255lio visual e linter de c\303\263digo na IDE\',\n        \'Formul\303\241rio de observa\303\247\303\243o pedag\303\263gica cont\303\255nua do NAPNE Campus Para\303\255so\',\n        \'Enunciados com metodologia DUA em formato claro e direto\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o diagn\303\263stica e formativa processual com feedback imediato, sem depend\303\252ncia de prova \303\272nica cronometrada.\',\n    },\n  },\n  {\n    id: \'sol-tdah-ahsd-dupla\',\n    titulo: \'Dupla Excepcionalidade (TDAH + Altas Habilidades/Superdota\303\247\303\243o em TI)\',\n    condicao: \'TDAH Combinado com Altas Habilidades / Superdota\303\247\303\243o (AH/SD)\',\n    nivelSugerido: \'Superior TI\',\n    descricaoProblema:\n      \'Velocidade e capacidade de abstra\303\247\303\243o l\303\263gica muito elevadas contrastando com procrastina\303\247\303\243o severa, dispers\303\243o com rotinas burocr\303\241ticas e desmotiva\303\247\303\243o com aulas puramente expositivas.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Enriquecimento curricular com desafios de ponta (arquitetura de software, IA, microsservi\303\247os) e metodologia \303\241gil (Scrum) com gamifica\303\247\303\243o e feedback frequente.\',\n      representacao:\n        \'Instru\303\247\303\265es curtas e visuais em t\303\263picos destacados; reposit\303\263rios modelo no GitHub com README comentados.\',\n      acaoExpressao:\n        \'Micro-sprints semanais com entregas cont\303\255nuas em Kanban (GitHub Projects), aceita\303\247\303\243o de documenta\303\247\303\243o t\303\251cnica em Markdown e screencasts curtos.\',\n      recursosTA: [\n        \'Quadro Kanban digital integrado ao GitHub Projects\',\n        \'Extens\303\265es de foco e linter no VS Code (Pomodoro Timer, Todo Tree)\',\n        \'Templates de documenta\303\247\303\243o t\303\251cnica em Markdown\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o processual somativa por marcos parciais semanais entregues, eliminando a depend\303\252ncia de grandes entregas acumuladas.\',\n    },\n  },\n  {\n    id: \'sol-dislexia-sintaxe\',\n    titulo: \'Dislexia & Transtorno de Aprendizagem em Sintaxe de Programa\303\247\303\243o\',\n    condicao: \'Dislexia do desenvolvimento, disgrafia ou trocas de caracteres de c\303\263digo\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade para decodificar sintaxe estrita de c\303\263digo em compiladores r\303\255gidos, troca de caracteres especiais (;, {}, ()) e fadiga intensa na leitura de enunciados densos.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Acolhimento pedag\303\263gico seguro que remove a puni\303\247\303\243o por pequenos erros sint\303\241ticos, valorizando o racioc\303\255nio e a resolu\303\247\303\243o do problema.\',\n      representacao:\n        \'Fontes tipogr\303\241ficas especializadas (OpenDyslexic Mono, JetBrains Mono), destaque colorido de pares de chaves e tabelas visuais com casos de teste (Input/Output).\',\n      acaoExpressao:\n        \'Permiss\303\243o de IDE com linters visuais que corrigem ou real\303\247am erros de sintaxe em tempo real; tempo estendido (+50%) e defesa oral da l\303\263gica em caso de d\303\272vida.\',\n      recursosTA: [\n        \'Fontes acess\303\255veis OpenDyslexic Mono e Atkinson Hyperlegible\',\n        \'Extens\303\265es de linter visual no VS Code (Error Lens, Bracket Pair Colorizer)\',\n        \'Sintetizador de voz / leitor de tela para enunciados extensos\',\n        \'Gloss\303\241rio ilustrado de sintaxe e operadores l\303\263gicos\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o pr\303\241tica em laborat\303\263rio com apoio de linter e tempo ampliado; corre\303\247\303\243o focada no fluxo l\303\263gico e n\303\243o na memoriza\303\247\303\243o mec\303\242nica de pontua\303\247\303\243o.\',\n    },\n  },\n];\n"
