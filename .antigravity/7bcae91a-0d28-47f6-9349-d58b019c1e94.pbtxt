    end_line: 1333
    content: "\n        descricao: \'Projetos semestrais com prazos \303\272nicos e distantes (ex: entrega de software completo apenas no fim do semestre).\',\n        impacto: \'D\303\251ficit de fun\303\247\303\243o executiva leva \303\240 procrastina\303\247\303\243o, hiperfoco de \303\272ltima hora, sobrecarga e perda de prazos intermedi\303\241rios.\',\n        estrategia_enfrentamento: \'DUA 3.0: Metodologia Scrum educacional com micro-sprints semanais (Kanban), checkpoints regulares e feedback cont\303\255nuo.\',\n      },\n      {\n        id: \'B2\',\n        categoria: \'atitudinal\',\n        descricao: \'Expectativa docente de que por ter Altas Habilidades ela \"n\303\243o precisa de apoio\" ou que a desorganiza\303\247\303\243o com relat\303\263rios \303\251 \"desleixo\".\',\n        impacto: \'Invisibiliza\303\247\303\243o do TDAH e sofrimento psicol\303\263gico (ansiedade de desempenho e s\303\255ndrome do impostor).\',\n        estrategia_enfrentamento: \'Sensibiliza\303\247\303\243o docente com orienta\303\247\303\243o do NAPNE: reconhecimento da dupla excepcionalidade como demanda leg\303\255tima de acessibilidade pedag\303\263gica.\',\n      },\n      {\n        id: \'B3\',\n        categoria: \'tecnologica\',\n        descricao: \'Exig\303\252ncia de preenchimento de extensos relat\303\263rios t\303\251cnicos manuais em formatos r\303\255gidos e burocr\303\241ticos.\',\n        impacto: \'Dispers\303\243o e bloqueio executivo na escrita burocr\303\241tica, contrastando com seu c\303\263digo fonte de alt\303\255ssima qualidade.\',\n        estrategia_enfrentamento: \'Aceite de documenta\303\247\303\243o t\303\251cnica viva via Markdown no reposit\303\263rio GitHub, issues e diagramas de classe em Mermaid.js.\',\n      },\n    ],\n    potencialidades: [\n      {\n        id: \'P1\',\n        area: \'Arquitetura de Software & Design Patterns\',\n        descricao: \'Facilidade \303\255mpar para desenhar arquiteturas desacopladas, microsservi\303\247os e aplicar padr\303\265es de projeto (GoF).\',\n        apoio_demandado: \'Enriquecimento curricular com desafios de ponta, participa\303\247\303\243o em projetos de pesquisa e inova\303\247\303\243o.\',\n      },\n      {\n        id: \'P2\',\n        area: \'Resolu\303\247\303\243o Criativa de Problemas\',\n        descricao: \'Pensamento divergente; prop\303\265e abordagens inovadoras que superam os requisitos b\303\241sicos propostos pelo docente.\',\n        apoio_demandado: \'Canalizar a criatividade dentro do escopo com mentoria t\303\251cnica orientada.\',\n      },\n    ],\n    recursos_ta: [\n      \'Quadro Kanban digital integrado ao GitHub Projects para microtarefas visuais\',\n      \'Extens\303\265es de foco e linter no VS Code (Pomodoro Timer, Error Lens, Todo Tree)\',\n      \'Templates estruturados em Markdown com se\303\247\303\265es pr\303\251-definidas para documenta\303\247\303\243o\',\n      \'Grava\303\247\303\243o em \303\241udio das reuni\303\265es de alinhamento para consulta posterior\',\n    ],\n    sintese_observacao: {\n      interacao_professores: \'Muito participativa e questionadora; prop\303\265e solu\303\247\303\265es de alta complexidade conceitual.\',\n      interacao_colegas: \'Excelente lideran\303\247a t\303\251cnica em hackathons e projetos de desenvolvimento.\',\n      tarefas_coletivas: \'Rendimento excelente quando atua como Tech Lead com colega respons\303\241vel pela gest\303\243o de cronograma.\',\n      interesses_centrais: \'Engenharia de Software, Arquitetura em Nuvem, Intelig\303\252ncia Artificial e UI/UX.\',\n      habilidades_tecnicas: \'Java, TypeScript, Docker, Design Patterns e Arquitetura Limpa.\',\n      autonomia_rotina: \'Aut\303\264noma nas atividades de vida di\303\241ria; necessita de suporte focado em gest\303\243o executiva e prazos.\',\n    },\n  },\n  planejamento_pei: {\n    conteudo_ementa_oficial:\n      \'Engenharia de Software: Ciclo de vida de software, Metodologias \303\201geis (Scrum/Kanban), Modelagem Orientada a Objetos com UML, Padr\303\265es de Projeto (Design Patterns) e Testes Automatizados.\',\n    competencias_habilidades_ementa:\n      \'Modelar e construir sistemas orientados a objetos robustos; aplicar princ\303\255pios SOLID e design patterns; implementar pipeline de testes unit\303\241rios; atuar em equipes \303\241geis com versionamento e entrega cont\303\255nua.\',\n    adaptacao_flexibilizacao_curricular:\n      \'Enriquecimento curricular nos termos da Portaria MEC n\302\272 421/2026: aprofundamento pr\303\241tico em arquitetura de microsservi\303\247os e automa\303\247\303\243o, com suporte \303\240s fun\303\247\303\265es executivas atrav\303\251s de micro-entregas semanais.\',\n    objetivos_e_metas: [\n      {\n        id_meta: \'M1\',\n        descricao_meta: \'Modelar e implementar microsservi\303\247o com princ\303\255pios SOLID e cobertura de testes unit\303\241rios de 80%.\',\n        prazo: \'Mensal (4 semanas - at\303\251 26/11/2026)\',\n        indicador_sucesso: \'Pipeline de CI/CD no GitHub Actions aprovando todos os testes com c\303\263digo documentado.\',\n        progresso_percentual: 70,\n        status: \'em_andamento\',\n      },\n      {\n        id_meta: \'M2\',\n        descricao_meta: \'Manter quadro Kanban no GitHub Projects atualizado semanalmente com checklist de issues fechadas.\',\n        prazo: \'Bimestral (8 semanas - at\303\251 20/12/2026)\',\n        indicador_sucesso: \'Pelo menos 85% das micro-entregas semanais cumpridas sem ac\303\272mulo no final do per\303\255odo.\',\n        progresso_percentual: 80,\n        status: \'em_andamento\',\n      },\n    ],\n    flexibilizacao_metodologica_dua: {\n      engajamento: [\n        \'Enriquecimento curricular com desafios de computa\303\247\303\243o em nuvem e arquitetura avan\303\247ada.\',\n        \'Metodologia \303\241gil com gamifica\303\247\303\243o de micro-entregas semanais para manter dopamina e motiva\303\247\303\243o.\',\n        \'Feedback formativo imediato p\303\263s-sprint pelo docente regente.\',\n      ],\n      representacao: [\n        \'Instru\303\247\303\265es curtas e visualmente estruturadas em t\303\263picos destacados (sem blocos monol\303\255ticos de texto).\',\n        \'Modelos de exemplo comentados (starter kits de reposit\303\263rio no GitHub).\',\n        \'Uso de diagramas din\303\242micos em Mermaid e fluxogramas visuais.\',\n      ],\n      acao_e_expressao: [\n        \'Demonstra\303\247\303\243o pr\303\241tica atrav\303\251s de c\303\263digo funcional no GitHub e grava\303\247\303\243o de screencast curto (Loom).\',\n        \'Aceite de documenta\303\247\303\243o t\303\251cnica sintetizada em Markdown em vez de relat\303\263rios em Word.\',\n        \'Apresenta\303\247\303\243o t\303\251cnica no formato de \"Tech Talk\" universit\303\241ria.\',\n      ],\n    },\n    gestao_sala_de_aula: {\n      organizacao_espacial: \'Mesa de trabalho em laborat\303\263rio com ilumina\303\247\303\243o adequada e espa\303\247o para notebook pessoal.\',\n      rotina_e_pausas: \'Pausas programadas com t\303\251cnica Pomodoro para descanso cognitivo e autorregula\303\247\303\243o.\',\n      agrupamentos_e_tutoria: \'Pareamento em equipe \303\241gil com papel de lideran\303\247a t\303\251cnica (Tech Lead).\',\n      suporte_docente_semanal: \'Reuni\303\243o semanal de 15 minutos de alinhamento com NAPNE e docente de Engenharia de Software.\',\n    },\n    estrategias_avaliacao: {\n      formato_acessivel: \'Avalia\303\247\303\243o processual baseada em commits semanais e demonstra\303\247\303\243o ao vivo de microsservi\303\247o funcional.\',\n      criterio_de_sucesso: \'Aplica\303\247\303\243o correta dos padr\303\265es de projeto e testes, com autonomia no versionamento.\',\n      grau_mediacao: \'pouca_mediacao\',\n      tempo_e_espaco: \'Entregas fracionadas semanais com tempo estendido caso ocorra crise de dispers\303\243o.\',\n      recursos_utilizados: [\'GitHub Projects (Kanban)\', \'Pomodoro Timer\', \'Extens\303\265es de foco VS Code\'],\n    },\n    observacoes_docente:\n      \'Larissa \303\251 brilhante na concep\303\247\303\243o t\303\251cnica de software. Com a divis\303\243o do projeto em micro-sprints e apoio do NAPNE Campus Para\303\255so nas fun\303\247\303\265es executivas, seu potencial foi plenamente potencializado.\',\n  },\n  painel_notas: [\n    {\n      id: \'NL1\',\n      autor: \'Prof\302\252. Dra. Helena (Docente)\',\n      papel: \'Regente\',\n      categoria: \'objetivos\',\n      conteudo: \'Larissa implementou um padr\303\243o Factory Method e Strategy impec\303\241veis no backend! O acompanhamento semanal tem evitado a procrastina\303\247\303\243o.\',\n      data: \'24/10/2026\',\n      cor: \'green\',\n    },\n  ],\n  metricas: {\n    percentual_metas_alcancadas: 75,\n    nivel_autonomia: 5,\n    engajamento: 5,\n    sessoes_semanais_realizadas: 6,\n    status_geral: \'EM_ANDAMENTO\',\n  },\n  parecer_pedagogico:\n    \'A inclus\303\243o universit\303\241ria na \303\241rea de TI no Campus Para\303\255so abrange o reconhecimento da neurodiverg\303\252ncia e da dupla excepcionalidade. O PEI permite equalizar o desafio cognitivo \303\240 gest\303\243o do tempo, viabilizando excel\303\252ncia t\303\251cnica e bem-estar.\',\n  sugestoes_proximo_ciclo: [\n    \'Submeter projeto para o edital de Inicia\303\247\303\243o Tecnol\303\263gica (PIBITI).\',\n    \'Convidar Larissa para ministrar oficina de Git e GitHub para os calouros.\',\n  ],\n};\n\n// 5. CASO ENSINO M\303\211DIO T\303\211CNICO - HIP\303\223TESE DIAGN\303\223STICA / SEM LAUDO CONFIRMADO (PORTARIA MEC 421/2026)\nexport const casoCauaSemLaudo: PEICompleto = {\n  id: \'MED-INF-05-HIP\',\n  cabecalho: {\n    estudante: \'Cau\303\243 Ribeiro dos Santos\',\n    codigo_matricula: \'2026.1.INF.058\',\n    idade: \'15 anos\',\n    curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\n    componente_curricular: \'L\303\263gica de Programa\303\247\303\243o e Algoritmos\',\n    modulo_periodo: \'1\302\272 Ano / 2\302\272 Semestre\',\n    data_elaboracao: \'2026-10-27\',\n    docente_regente: \'Prof. Marcos Vin\303\255cius Toledo (Docente de Algoritmos e L\303\263gica)\',\n    docente_aee: \'Prof\302\252. Renata Cavalcanti (Especialista em Educa\303\247\303\243o Especial / NAPNE)\',\n    profissional_apoio: \'Monitor de Acessibilidade Digital e Laborat\303\263rio\',\n    coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n  },\n  historico_napne: {\n    status_diagnostico: \'em_investigacao_hipotese\',\n    categoria_neurodivergencia: \'Hip\303\263tese Diagn\303\263stica em Investiga\303\247\303\243o Pedag\303\263gica (Sem Laudo)\',\n    cid_ou_hipotese: \'Em investiga\303\247\303\243o pedag\303\263gica pelo NAPNE (Portaria MEC n\302\272 421/2026)\',\n    breve_historico_clinico_familiar:\n      \'Estudante do 1\302\272 Ano do Curso T\303\251cnico Integrado em Inform\303\241tica no Campus Para\303\255so. Integra o grupo dos 5 estudantes acompanhados pelo NAPNE que n\303\243o possuem diagn\303\263stico m\303\251dico formal. Conforme preconizado pela Portaria MEC n\302\272 421/2026 e pelo Decreto n\302\272 12.686/2025, a aus\303\252ncia de laudo m\303\251dico N\303\203O impede a elabora\303\247\303\243o do PEI nem a concess\303\243o de apoios e Tecnologias Assistivas no laborat\303\263rio de TI.\',\n    descricao_condicao_especifica:\n      \'Apresenta grande dificuldade na decodifica\303\247\303\243o e digita\303\247\303\243o de sintaxes textuais r\303\255gidas de c\303\263digo (troca de caracteres como ponto-e-v\303\255rgula, chaves e par\303\252nteses) e fadiga na leitura de enunciados densos. Demonstra excelente racioc\303\255nio algor\303\255tmico quando apoiado por linters visuais e enunciados fracionados.\',\n    informacoes_dos_pais:\n      \'Fam\303\255lia acolhida pelo NAPNE Campus Para\303\255so, com alinhamento cont\303\255nuo sobre os apoios pedag\303\263gicos em sala de aula.\',\n  },\n  estudo_de_caso: {\n    barreiras: [\n      {\n        id: \'B1\',\n        categoria: \'metodologica\',\n        descricao: \'Avalia\303\247\303\265es de programa\303\247\303\243o manuscritas no papel ou com penaliza\303\247\303\243o severa por erros de sintaxe ortogr\303\241fica de c\303\263digo (ex: esquecimento de v\303\255rgula ou par\303\252ntese).\',\n        impacto: \'Gera reprova\303\247\303\243o por falhas de ortografia/dislexia de sintaxe, ocultando que a l\303\263gica algor\303\255tmica do estudante estava correta.\',\n        estrategia_enfrentamento: \'DUA 3.0: Foco na sem\303\242ntica e na l\303\263gica do algoritmo; permiss\303\243o de IDEs com linters visuais que destacam automaticamente erros sint\303\241ticos com cores n\303\255tidas.\',\n      },\n      {\n        id: \'B2\',\n        categoria: \'comunicacional\',\n        descricao: \'Enunciados de exerc\303\255cios com textos densos, vocabul\303\241rio rebuscado e instru\303\247\303\265es orais sem apoio visual de entrada/sa\303\255da.\',\n        impacto: \'Dificuldade de processamento textual atrasa o in\303\255cio da resolu\303\247\303\243o do problema.\',\n        estrategia_enfrentamento: \'Enunciados com metodologia DUA: destacados em t\303\263picos, tabela de casos de teste (Input/Output) e leitura mediada em voz alta se necess\303\241rio.\',\n      },\n      {\n        id: \'B3\',\n        categoria: \'atitudinal\',\n        descricao: \'Risco de questionamentos da equipe pedag\303\263gica sobre a concess\303\243o de tempo ampliado pelo fato do estudante \"ainda n\303\243o ter laudo com CID\".\',\n        impacto: \'Inseguran\303\247a docente e desamparo ao estudante em momento crucial de transi\303\247\303\243o para o ensino t\303\251cnico.\',\n        estrategia_enfrentamento: \'Forma\303\247\303\243o continuada do NAPNE Campus Para\303\255so com base na Portaria MEC n\302\272 421/2026, firmando que a acessibilidade \303\251 dever imediato da institui\303\247\303\243o.\',\n      },\n    ],\n    potencialidades: [\n      {\n        id: \'P1\',\n        area: \'Racioc\303\255nio Algor\303\255tmico Visual & L\303\263gica Abstrata\',\n        descricao: \'Capacidade veloz de resolu\303\247\303\243o de problemas quando apoiado por fluxogramas, linguagens visuais de blocos (Scratch/Blockly) ou representa\303\247\303\265es gr\303\241ficas.\',\n        apoio_demandado: \'Utilizar ferramentas visuais como ponte para a linguagem textual de programa\303\247\303\243o.\',\n      },\n      {\n        id: \'P2\',\n        area: \'Resili\303\252ncia & Motiva\303\247\303\243o com Tecnologia\',\n        descricao: \'Grande entusiasmo em aprender inform\303\241tica, curiosidade com hardware e manuten\303\247\303\243o de computadores.\',\n        apoio_demandado: \'Vincular os algoritmos a aplica\303\247\303\265es pr\303\241ticas de automa\303\247\303\243o e rob\303\263tica educativa.\',\n      },\n    ],\n    recursos_ta: [\n      \'Extens\303\265es do VS Code para dislexia e apoio visual (Color Highlight, Bracket Pair Colorizer, Error Lens)\',\n      \'Fontes tipogr\303\241ficas acess\303\255veis (OpenDyslexic Mono / Atkinson Hyperlegible)\',\n      \'Tempo estendido (+50%) em provas pr\303\241ticas e avalia\303\247\303\265es diagn\303\263sticas\',\n      \'Permiss\303\243o de leitor de tela / sintetizador de voz para leitura de enunciados longos\',\n      \'Caderno de apoio com gloss\303\241rio visual de sintaxe de l\303\263gica de programa\303\247\303\243o\',\n    ],\n    sintese_observacao: {\n      interacao_professores: \'Participativo e atento; solicita esclarecimentos individuais quando o enunciado \303\251 muito prolixo.\',\n      interacao_colegas: \'Bem integrado; colaborativo e respeitoso nas din\303\242micas de laborat\303\263rio.\',\n      tarefas_coletivas: \'Rendimento excelente em atividades pr\303\241ticas manuais de laborat\303\263rio.\',\n      interesses_centrais: \'L\303\263gica de Programa\303\247\303\243o, Jogos Digitais, Montagem e Manuten\303\247\303\243o de Hardware.\',\n      habilidades_tecnicas: \'Compreens\303\243o de la\303\247os de repeti\303\247\303\243o, condicionais e estruturas vetoriais.\',\n      autonomia_rotina: \'Aut\303\264nomo; necessita apenas de adequa\303\247\303\243o visual e tempo estendido para leitura.\',\n    },\n  },\n  planejamento_pei: {\n    conteudo_ementa_oficial:\n      \'L\303\263gica de Programa\303\247\303\243o e Algoritmos: Conceito de algoritmos, tipos primitivos de dados, vari\303\241veis e constantes, operadores l\303\263gicos e aritm\303\251ticos, estruturas condicionais (if/else), estruturas de repeti\303\247\303\243o (for/while) e vetores unidimensionais.\',\n    competencias_habilidades_ementa:\n      \'Compreender a l\303\263gica algor\303\255tmica para resolu\303\247\303\243o de problemas computacionais; implementar estruturas de controle de fluxo; desenvolver pensamento computacional decompondo problemas em sub-rotinas.\',\n    adaptacao_flexibilizacao_curricular:\n      \'Garantia do curr\303\255culo pleno sem rebaixamento cognitivo. Flexibiliza\303\247\303\243o metodol\303\263gica nos canais de leitura e escrita atrav\303\251s do DUA 3.0 e Tecnologias Assistivas, com valida\303\247\303\243o diagn\303\263stica cont\303\255nua.\',\n    objetivos_e_metas: [\n      {\n        id_meta: \'M1\',\n        descricao_meta: \'Construir algoritmos com estruturas condicionais e de repeti\303\247\303\243o utilizando IDE com linter visual e fonte acess\303\255vel.\',\n        prazo: \'Mensal (4 semanas - at\303\251 26/11/2026)\',\n        indicador_sucesso: \'Execu\303\247\303\243o correta de pelo menos 4 de 5 exerc\303\255cios de l\303\263gica com casos de teste validados.\',\n        progresso_percentual: 65,\n        status: \'em_andamento\',\n      },\n      {\n        id_meta: \'M2\',\n        descricao_meta: \'Explicar verbalmente ou via fluxograma o fluxo de dados e execu\303\247\303\243o de um algoritmo de ordena\303\247\303\243o de vetores.\',\n        prazo: \'Bimestral (8 semanas - at\303\251 20/12/2026)\',\n        indicador_sucesso: \'Apresenta\303\247\303\243o oral com demonstra\303\247\303\243o pr\303\241tica para o docente sem penaliza\303\247\303\243o por trocas sint\303\241ticas manuais.\',\n        progresso_percentual: 50,\n        status: \'em_andamento\',\n      },\n    ],\n    flexibilizacao_metodologica_dua: {\n      engajamento: [\n        \'Desafios pr\303\241ticos com aplica\303\247\303\243o em cen\303\241rios reais e contextualizados do campus.\',\n        \'Acolhimento pedag\303\263gico seguro que remove a ansiedade e o estigma do erro sint\303\241tico.\',\n        \'Reconhecimento das solu\303\247\303\265es l\303\263gicas elegantes desenvolvidas pelo estudante.\',\n      ],\n      representacao: [\n        \'Disponibiliza\303\247\303\243o de enunciados com fontes acess\303\255veis (OpenDyslexic) e espa\303\247amento ampliado.\',\n        \'Uso de fluxogramas e tabelas visuais com exemplos de entrada e sa\303\255da esperados.\',\n        \'Possibilidade de ouvir o enunciado atrav\303\251s de sintetizador de voz ou leitura do monitor.\',\n      ],\n      acao_e_expressao: [\n        \'Avalia\303\247\303\243o pr\303\241tica no computador com tempo ampliado (+50%) e corretor ortogr\303\241fico/sint\303\241tico.\',\n        \'Permiss\303\243o de defesa oral da solu\303\247\303\243o algor\303\255tmica em caso de d\303\272vida sobre a l\303\263gica.\',\n        \'Foco da corre\303\247\303\243o na resolu\303\247\303\243o do problema e n\303\243o na memoriza\303\247\303\243o de caracteres pontuais.\',\n      ],\n    },\n    gestao_sala_de_aula: {\n      organizacao_espacial: \'Bancada de laborat\303\263rio bem posicionada para visualiza\303\247\303\243o do quadro e do projetor.\',\n      rotina_e_pausas: \'Pausas visuais para descanso ocular ap\303\263s 40 minutos de leitura cont\303\255nua de c\303\263digo.\',\n      agrupamentos_e_tutoria: \'Programa\303\247\303\243o em pares orientada com colega acolhedor.\',\n      suporte_docente_semanal: \'Reuni\303\243o pedag\303\263gica semanal entre docente de algoritmos e equipe do NAPNE Campus Para\303\255so.\',\n    },\n    estrategias_avaliacao: {\n      formato_acessivel: \'Prova pr\303\241tica no laborat\303\263rio com IDE configurada (linter ativo), tempo ampliado e enunciados em t\303\263picos claros.\',\n      criterio_de_sucesso: \'Racioc\303\255nio l\303\263gico correto, corretude da solu\303\247\303\243o e fluxo de processamento.\',\n      grau_mediacao: \'pouca_mediacao\',\n      tempo_e_espaco: \'Tempo ampliado (+50%) em ambiente tranquilo de laborat\303\263rio.\',\n      recursos_utilizados: [\'VS Code com fonte OpenDyslexic\', \'Linter de erros visuais\', \'Tabela de casos de teste\'],\n    },\n    observacoes_docente:\n      \'O PEI investigativo de Cau\303\243 evidencia a excel\303\252ncia da diretriz da Portaria MEC n\302\272 421/2026: ao eliminar barreiras de digita\303\247\303\243o e enunciados confusos, ele demonstrou um racioc\303\255nio l\303\263gico brilhante, superando o receio inicial da turma.\',\n  },\n  painel_notas: [\n    {\n      id: \'NC1\',\n      autor: \'Prof. Marcos (Docente Algoritmos)\',\n      papel: \'Regente\',\n      categoria: \'objetivos\',\n      conteudo: \'Cau\303\243 resolveu um problema complexo de la\303\247os aninhados hoje! A extens\303\243o de cores para par\303\252nteses e o tempo estendido fizeram total diferen\303\247a.\',\n      data: \'23/10/2026\',\n      cor: \'green\',\n    },\n    {\n      id: \'NC2\',\n      autor: \'Prof\302\252. Renata (NAPNE)\',\n      papel: \'AEE\',\n      categoria: \'apoio\',\n      conteudo: \'Protocolo de atendimento sem laudo (Portaria MEC 421/2026) plenamente implementado. Fam\303\255lia acolhida e estudante motivado.\',\n      data: \'22/10/2026\',\n      cor: \'yellow\',\n    },\n  ],\n  metricas: {\n    percentual_metas_alcancadas: 58,\n    nivel_autonomia: 4,\n    engajamento: 5,\n    sessoes_semanais_realizadas: 8,\n    status_geral: \'EM_ANDAMENTO\',\n  },\n  parecer_pedagogico:\n    \'A elabora\303\247\303\243o do PEI para estudantes em hip\303\263tese diagn\303\263stica assegura que o direito \303\240 educa\303\247\303\243o p\303\272blica, gratuita e inclusiva no Campus Para\303\255so n\303\243o seja ref\303\251m da lentid\303\243o burocr\303\241tica de laudos periciais externos, materializando a equidade preconizada no Decreto n\302\272 12.686/2025 e Portaria MEC n\302\272 421/2026.\',\n  sugestoes_proximo_ciclo: [\n    \'Manter o acompanhamento pelo NAPNE e registrar a evolu\303\247\303\243o pedag\303\263gica para o relat\303\263rio multiprofissional.\',\n    \'Apresentar os recursos de linter e fontes acess\303\255veis no planejamento pedag\303\263gico geral do curso.\',\n  ],\n};\n\nexport const todosOsCasos: PEICompleto[] = [\n  casoLucasTecnico,\n  casoBeatrizSuperior,\n  casoMatheusRedes,\n  casoLarissaSuperior,\n  casoCauaSemLaudo,\n];\n\n// BANCO DE SOLU\303\207\303\225ES PEDAG\303\223GICAS PARA CONDI\303\207\303\225ES ESPEC\303\215FICAS EM TI / COMPUTA\303\207\303\203O\nexport const bancoDeSolucoesPedagogicas: SolucaoCondicao[] = [\n  {\n    id: \'sol-motor-programacao\',\n    titulo: \'Dificuldade Motora / Digita\303\247\303\243o Manual em C\303\263digo e Algoritmos\',\n    condicao: \'Paralisia Cerebral, Espasticidade, Tetraparesia, LER/DORT ou Tremores\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'A lentid\303\243o ou dor na digita\303\247\303\243o em teclado convencional prejudica a realiza\303\247\303\243o de avalia\303\247\303\265es cronometradas em laborat\303\263rio e gera fadiga muscular intensa.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Ado\303\247\303\243o da metodologia de Pair Programming (programa\303\247\303\243o em pares) com divis\303\243o de pap\303\251is: o aluno atua como copiloto e arquiteto da l\303\263gica.\',\n      representacao:\n        \'Roteiros de laborat\303\263rio diagramados com diagramas de fluxo de dados (Mermaid/UML) e snippets de c\303\263digo comentados dispon\303\255veis antecipadamente.\',\n      acaoExpressao:\n        \'Tempo estendido (+50%), permiss\303\243o de ferramentas de autocompletar inteligente (Copilot/Snippets), entrega de c\303\263digo versionado no Git e defesa oral do algoritmo.\',\n      recursosTA: [\n        \'Teclados mec\303\242nicos de ativa\303\247\303\243o leve com colmeia acr\303\255lica\',\n        \'Mouse ergon\303\264mico vertical ou trackball\',\n        \'Extens\303\265es de atalhos e autocompletar na IDE (VS Code)\',\n        \'Suporte ergon\303\264mico articulado para apoio dos bra\303\247os\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o formativa cont\303\255nua baseada em commits no GitHub e demonstra\303\247\303\243o funcional em vez de digita\303\247\303\243o em tempo cronometrado.\',\n    },\n  },\n  {\n    id: \'sol-baixa-visao-sql\',\n    titulo: \'Defici\303\252ncia Visual / Baixa Vis\303\243o Severa em Banco de Dados e Sistemas\',\n    condicao: \'Retinopatia, Glaucoma, Baixa Vis\303\243o Severa, Cegueira\',\n    nivelSugerido: \'Superior TI\',\n    descricaoProblema:\n      \'Diagramas visuais de Modelo Entidade-Relacionamento (MER) em imagens rasterizadas (.png/.jpg) s\303\243o completamente inacess\303\255veis a leitores de tela.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Envolvimento em projetos reais de modelagem de dados para sistemas p\303\272blicos e e-commerce acess\303\255vel, valorizando o racioc\303\255nio abstrato.\',\n      representacao:\n        \'Substitui\303\247\303\243o de diagramas gr\303\241ficos por linguagens declarativas acess\303\255veis (DBML / YAML / scripts SQL DDL comentados) e audiodescri\303\247\303\243o em sala.\',\n      acaoExpressao:\n        \'Intera\303\247\303\243o com o banco de dados via terminal CLI (PostgreSQL psql, SQLite) integrado a leitor de telas e entrega de scripts .sql puros.\',\n      recursosTA: [\n        \'Leitor de telas NVDA / Orca com voz pt-BR configurada\',\n        \'Terminal com alto contraste invertido e fonte monoespa\303\247ada 22pt+\',\n        \'Monitor de 27 a 32 polegadas com bra\303\247o articulado pantogr\303\241fico\',\n        \'Documenta\303\247\303\243o t\303\251cnica em Markdown ou LaTeX acess\303\255vel\',\n      ],\n      avaliacaoAcessivel:\n        \'Resolu\303\247\303\243o de problemas de consultas anal\303\255ticas via terminal de testes com tempo estendido e semin\303\241rio com defesa oral.\',\n    },\n  },\n  {\n    id: \'sol-tea-sensorial-redes\',\n    titulo: \'Transtorno do Espectro Autista (TEA) & Hipersensibilidade em Datacenter/Redes\',\n    condicao: \'TEA (N\303\255vel 1 de suporte), Hipersensibilidade Auditiva e Sensorial\',\n    nivelSugerido: \'M\303\251dio T\303\251cnico\',\n    descricaoProblema:\n      \'O ru\303\255do cont\303\255nuo de ventiladores de servidores, switches e cabos no laborat\303\263rio somado a instru\303\247\303\265es orais amb\303\255guas causa sobrecarga sensorial.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Desafios de ciberseguran\303\247a e redes com regras expl\303\255citas; previsibilidade de cronograma de laborat\303\263rio com anteced\303\252ncia de duas semanas.\',\n      representacao:\n        \'Roteiros passo a passo em formato de checklist numerado sem met\303\241foras; simula\303\247\303\265es visuais da transmiss\303\243o de pacotes no Cisco Packet Tracer.\',\n      acaoExpressao:\n        \'Demonstra\303\247\303\243o da configura\303\247\303\243o atrav\303\251s de arquivos de topologia (.pkt) e sa\303\255da de comandos de terminal, com tempo estendido.\',\n      recursosTA: [\n        \'Abafador de ru\303\255dos circum-aural (concha) com certifica\303\247\303\243o NRR 27dB+\',\n        \'Software simulador de redes Cisco Packet Tracer\',\n        \'Checklist t\303\251cnico de bancada com fluxo de configura\303\247\303\243o de switches\',\n        \'Cart\303\243o de pausa visual para sinaliza\303\247\303\243o discreta ao docente\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o pr\303\241tica no simulador e na bancada com roteiro objetivo e sem press\303\243o de comunica\303\247\303\243o informal desestruturada.\',\n    },\n  },\n  {\n    id: \'sol-tdah-desenvolvimento\',\n    titulo: \'TDAH / Dificuldade de Sustenta\303\247\303\243o de Aten\303\247\303\243o em Projetos de Software\',\n    condicao: \'Transtorno do D\303\251ficit de Aten\303\247\303\243o e Hiperatividade (TDAH)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade de planejar entregas de longo prazo em projetos de TI, desaten\303\247\303\243o a detalhes sint\303\241ticos e procrastina\303\247\303\243o por sobrecarga.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Quebra de projetos complexos em micro-entregas semanais (metodologia \303\241gil/Scrum com sprints de 7 dias) e gamifica\303\247\303\243o de conquistas.\',\n      representacao:\n        \'Instru\303\247\303\265es curtas em t\303\263picos destacados; uso de linters estritos que apontam erros de sintaxe em tempo real com cores n\303\255tidas.\',\n      acaoExpressao:\n        \'Possibilidade de demonstrar o aprendizado em pequenos marcos incrementais de c\303\263digo funcional.\',\n      recursosTA: [\n        \'Aplicativos de gest\303\243o visual de tarefas (Kanban / Trello / GitHub Projects)\',\n        \'Extens\303\265es de foco e linter (Error Lens, Prettier, Todo Tree)\',\n        \'Temporizadores de t\303\251cnica Pomodoro integrados \303\240 rotina de laborat\303\263rio\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o processual somativa com notas atribu\303\255das a cada sprint entregue, mitigando o peso de uma \303\272nica prova final te\303\263rica.\',\n    },\n  },\n  {\n    id: \'sol-surdez-ti\',\n    titulo: \'Surdez / Defici\303\252ncia Auditiva em Cursos de Tecnologia da Informa\303\247\303\243o\',\n    condicao: \'Surdez, Defici\303\252ncia Auditiva Bilateral\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Aulas expositivas r\303\241pidas e termos t\303\251cnicos de inform\303\241tica em ingl\303\252s sem tradutor int\303\251rprete de Libras ou legendagem dificultam o acompanhamento.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Valoriza\303\247\303\243o do estudante em projetos de acessibilidade digital e design visual de interfaces.\',\n      representacao:\n        \'Disponibiliza\303\247\303\243o de slides e c\303\263digos antes da aula expositiva; presen\303\247a de Tradutor Int\303\251rprete de Libras com vocabul\303\241rio t\303\251cnico de TI.\',\n      acaoExpressao:\n        \'Submiss\303\243o de c\303\263digo documentado, diagramas arquiteturais e relat\303\263rios textuais ou sinalizados em Libras gravados em v\303\255deo.\',\n      recursosTA: [\n        \'Softwares de transcri\303\247\303\243o de \303\241udio em tempo real e legendagem autom\303\241tica\',\n        \'Gloss\303\241rio de sinais de Libras para termos computacionais (algoritmo, banco de dados, rede)\',\n        \'Fones com amplifica\303\247\303\243o sonora para estudantes com res\303\255duo auditivo\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\265es pr\303\241ticas com apoio de int\303\251rprete de Libras para esclarecimento de d\303\272vidas e tempo estendido.\',\n    },\n  },\n  {\n    id: \'sol-hipotese-sem-laudo\',\n    titulo: \'Hip\303\263tese Diagn\303\263stica / Em Investiga\303\247\303\243o pelo NAPNE (Sem Laudo - Portaria MEC 421/2026)\',\n    condicao: \'Hip\303\263tese de neurodiverg\303\252ncia ou transtorno em processo avaliativo (5 casos no Campus Para\303\255so)\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade acad\303\252mica persistente em sala ou laborat\303\263rio de TI sem que o estudante possua laudo m\303\251dico com CID fechado, gerando receio docente ou risco de nega\303\247\303\243o indevida de apoios.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Garantia legal imediata de direitos: a Portaria MEC n\302\272 421/2026 e o Decreto 12.686/2025 asseguram que o PEI independe de laudo cl\303\255nico, focando na acolhida pedag\303\263gica e redu\303\247\303\243o da ansiedade.\',\n      representacao:\n        \'Diversifica\303\247\303\243o multissensorial dos conte\303\272dos (roteiros em t\303\263picos, recursos visuais, esquemas e \303\241udio explicativo); disponibiliza\303\247\303\243o pr\303\251via de materiais antes das aulas de laborat\303\263rio.\',\n      acaoExpressao:\n        \'Tempo estendido (+50%) em todas as avalia\303\247\303\265es, toler\303\242ncia a erros pontuais de ortografia de c\303\263digo, permiss\303\243o de consulta orientada e possibilidade de defesa oral da l\303\263gica.\',\n      recursosTA: [\n        \'Tempo estendido (+50%) em provas e projetos pr\303\241ticos\',\n        \'Extens\303\265es de aux\303\255lio visual e linter de c\303\263digo na IDE\',\n        \'Formul\303\241rio de observa\303\247\303\243o pedag\303\263gica cont\303\255nua do NAPNE Campus Para\303\255so\',\n        \'Enunciados com metodologia DUA em formato claro e direto\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o diagn\303\263stica e formativa processual com feedback imediato, sem depend\303\252ncia de prova \303\272nica cronometrada.\',\n    },\n  },\n  {\n    id: \'sol-tdah-ahsd-dupla\',\n    titulo: \'Dupla Excepcionalidade (TDAH + Altas Habilidades/Superdota\303\247\303\243o em TI)\',\n    condicao: \'TDAH Combinado com Altas Habilidades / Superdota\303\247\303\243o (AH/SD)\',\n    nivelSugerido: \'Superior TI\',\n    descricaoProblema:\n      \'Velocidade e capacidade de abstra\303\247\303\243o l\303\263gica muito elevadas contrastando com procrastina\303\247\303\243o severa, dispers\303\243o com rotinas burocr\303\241ticas e desmotiva\303\247\303\243o com aulas puramente expositivas.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Enriquecimento curricular com desafios de ponta (arquitetura de software, IA, microsservi\303\247os) e metodologia \303\241gil (Scrum) com gamifica\303\247\303\243o e feedback frequente.\',\n      representacao:\n        \'Instru\303\247\303\265es curtas e visuais em t\303\263picos destacados; reposit\303\263rios modelo no GitHub com README comentados.\',\n      acaoExpressao:\n        \'Micro-sprints semanais com entregas cont\303\255nuas em Kanban (GitHub Projects), aceita\303\247\303\243o de documenta\303\247\303\243o t\303\251cnica em Markdown e screencasts curtos.\',\n      recursosTA: [\n        \'Quadro Kanban digital integrado ao GitHub Projects\',\n        \'Extens\303\265es de foco e linter no VS Code (Pomodoro Timer, Todo Tree)\',\n        \'Templates de documenta\303\247\303\243o t\303\251cnica em Markdown\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o processual somativa por marcos parciais semanais entregues, eliminando a depend\303\252ncia de grandes entregas acumuladas.\',\n    },\n  },\n  {\n    id: \'sol-dislexia-sintaxe\',\n    titulo: \'Dislexia & Transtorno de Aprendizagem em Sintaxe de Programa\303\247\303\243o\',\n    condicao: \'Dislexia do desenvolvimento, disgrafia ou trocas de caracteres de c\303\263digo\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'Dificuldade para decodificar sintaxe estrita de c\303\263digo em compiladores r\303\255gidos, troca de caracteres especiais (;, {}, ()) e fadiga intensa na leitura de enunciados densos.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Acolhimento pedag\303\263gico seguro que remove a puni\303\247\303\243o por pequenos erros sint\303\241ticos, valorizando o racioc\303\255nio e a resolu\303\247\303\243o do problema.\',\n      representacao:\n        \'Fontes tipogr\303\241ficas especializadas (OpenDyslexic Mono, JetBrains Mono), destaque colorido de pares de chaves e tabelas visuais com casos de teste (Input/Output).\',\n      acaoExpressao:\n        \'Permiss\303\243o de IDE com linters visuais que corrigem ou real\303\247am erros de sintaxe em tempo real; tempo estendido (+50%) e defesa oral da l\303\263gica em caso de d\303\272vida.\',\n      recursosTA: [\n        \'Fontes acess\303\255veis OpenDyslexic Mono e Atkinson Hyperlegible\',\n        \'Extens\303\265es de linter visual no VS Code (Error Lens, Bracket Pair Colorizer)\',\n        \'Sintetizador de voz / leitor de tela para enunciados extensos\',\n        \'Gloss\303\241rio ilustrado de sintaxe e operadores l\303\263gicos\',\n      ],\n      avaliacaoAcessivel:\n        \'Avalia\303\247\303\243o pr\303\241tica em laborat\303\263rio com apoio de linter e tempo ampliado; corre\303\247\303\243o focada no fluxo l\303\263gico e n\303\243o na memoriza\303\247\303\243o mec\303\242nica de pontua\303\247\303\243o.\',\n    },\n  },\n];\n\n// Gerador R\303\241pido de Novo PEI Completo para Aluno Cadastrado\nexport function gerarNovoPeiCompleto(dados: {\n  nome: string;\n  matricula: string;\n  idade: string;\n  curso: string;\n  disciplina: string;\n  modulo: string;\n  condicao: string;\n  docenteRegente: string;\n  docenteAee: string;\n  solucaoBaseId?: string;\n  statusDiagnostico?: \'confirmado\' | \'em_investigacao_hipotese\';\n  categoriaNeurodivergencia?: string;\n}): PEICompleto {\n  const solucao =\n    bancoDeSolucoesPedagogicas.find((s) => s.id === dados.solucaoBaseId) ||\n    bancoDeSolucoesPedagogicas[0];\n\n  const id = `PEI-${Date.now().toString().slice(-4)}`;\n\n  return {\n    id,\n    cabecalho: {\n      estudante: dados.nome,\n      codigo_matricula: dados.matricula || `TI-${Math.floor(1000 + Math.random() * 9000)}`,\n      idade: dados.idade || \'18 anos\',\n      curso: dados.curso || \'Curso T\303\251cnico em Inform\303\241tica / Bacharelado em TI\',\n      componente_curricular: dados.disciplina || \'Tecnologia da Informa\303\247\303\243o\',\n      modulo_periodo: dados.modulo || \'2\302\272 Semestre / 2026\',\n      data_elaboracao: new Date().toISOString().split(\'T\')[0],\n      docente_regente: dados.docenteRegente || \'Prof. Respons\303\241vel pela Disciplina\',\n      docente_aee: dados.docenteAee || \'Prof\302\252. Especialista do NAPNE\',\n      profissional_apoio: \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\n      coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n    },\n    historico_napne: {\n      status_diagnostico: dados.statusDiagnostico || \'confirmado\',\n      categoria_neurodivergencia:\n        dados.categoriaNeurodivergencia ||\n        (dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \'Hip\303\263tese Diagn\303\263stica / Em Investiga\303\247\303\243o pelo NAPNE\'\n          : \'Neurodiverg\303\252ncia / Condi\303\247\303\243o Acompanhada\'),\n      cid_ou_hipotese:\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \'Em investiga\303\247\303\243o pedag\303\263gica multiprofissional (Portaria MEC n\302\272 421/2026)\'\n          : \'Diagn\303\263stico confirmado em prontu\303\241rio NAPNE\',\n      breve_historico_clinico_familiar: `Estudante do ${dados.curso} no Campus Para\303\255so. Acompanhado pelo NAPNE com foco na garantia do direito \303\240 educa\303\247\303\243o inclusiva e acessibilidade curricular nos termos da Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.${\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \' Atendimento pedag\303\263gico iniciado com base nas barreiras escolares observadas, sem depend\303\252ncia de laudo pericial pr\303\251vio.\'\n          : \'\'\n      }`,\n      descricao_condicao_especifica: dados.condicao || solucao.descricaoProblema,\n      informacoes_dos_pais: \'Estudante e fam\303\255lia em alinhamento constante com o NAPNE Campus Para\303\255so e coordena\303\247\303\243o de curso.\',\n    },\n    estudo_de_caso: {\n      barreiras: [\n        {\n          id: \'B1\',\n          categoria: \'metodologica\',\n          descricao: `Metodologia de ensino em ${dados.disciplina} focada exclusivamente em formato \303\272nico sem op\303\247\303\265es acess\303\255veis.`,\n          impacto: \'Dificuldade de demonstra\303\247\303\243o plena da capacidade t\303\251cnica na aus\303\252ncia de recursos adaptados.\',\n          estrategia_enfrentamento: solucao.remediosSugeridos.acaoExpressao,\n        },\n        {\n          id: \'B2\',\n          categoria: \'tecnologica\',\n          descricao: \'Ambientes de desenvolvimento e computadores de laborat\303\263rio sem configura\303\247\303\243o pr\303\251via de acessibilidade.\',\n          impacto: \'Sobrecarga visual e muscular durante atividades pr\303\241ticas prolongadas.\',\n          estrategia_enfrentamento: `Instala\303\247\303\243o e configura\303\247\303\243o de: ${solucao.remediosSugeridos.recursosTA.join(\', \')}.`,\n        },\n        {\n          id: \'B3\',\n          categoria: \'atitudinal\',\n          descricao: \'Risco de expectativas rebaixadas ou desconhecimento das potencialidades t\303\251cnicas do aluno pela turma.\',\n          impacto: \'Isolamento em trabalhos pr\303\241ticos de equipe.\',\n          estrategia_enfrentamento: \'Planejamento docente com metodologias ativas e valoriza\303\247\303\243o das contribui\303\247\303\265es do estudante.\',\n        },\n      ],\n      potencialidades: [\n        {\n          id: \'P1\',\n          area: \'Capacidade Anal\303\255tica & Computacional\',\n          descricao: \'Motiva\303\247\303\243o para resolu\303\247\303\243o de problemas e aprendizado pr\303\241tico de ferramentas de TI.\',\n          apoio_demandado: \'Orienta\303\247\303\243o personalizada em projetos de desenvolvimento.\',\n        },\n        {\n          id: \'P2\',\n          area: \'Trabalho Colaborativo\',\n          descricao: \'Excelente coopera\303\247\303\243o em duplas estruturadas com objetivos transparentes.\',\n          apoio_demandado: \'Incentivo cont\303\255nuo ao trabalho compartilhado.\',\n        },\n      ],\n      recursos_ta: solucao.remediosSugeridos.recursosTA,\n      sintese_observacao: {\n        interacao_professores: \'Receptivo e proativo nas orienta\303\247\303\265es pedag\303\263gicas.\',\n        interacao_colegas: \'Excelente entrosamento em equipes de desenvolvimento.\',\n        tarefas_coletivas: \'Participa com responsabilidade nas etapas atribu\303\255das.\',\n        interesses_centrais: dados.disciplina,\n        habilidades_tecnicas: \'Pensamento computacional e capacidade l\303\263gica.\',\n        autonomia_rotina: \'Aut\303\264nomo com suporte dos recursos de acessibilidade recomendados.\',\n      },\n    },\n    planejamento_pei: {\n      conteudo_ementa_oficial: `Ementa Oficial do Componente Curricular: ${dados.disciplina}. Abordagem dos conceitos fundamentais te\303\263ricos e pr\303\241ticos de desenvolvimento e aplica\303\247\303\243o.`,\n      competencias_habilidades_ementa: `Desenvolver compet\303\252ncias t\303\251cnicas, operacionais e de racioc\303\255nio l\303\263gico em ${dados.disciplina}, aplicando boas pr\303\241ticas da profiss\303\243o.`,\n      adaptacao_flexibilizacao_curricular:\n        \'Curr\303\255culo mantido na \303\255ntegra sem rebaixamento conceitual. Acessibilidade promovida nas formas de representa\303\247\303\243o dos conte\303\272dos e nos canais de express\303\243o t\303\251cnica.\',\n      objetivos_e_metas: [\n        {\n          id_meta: \'M1\',\n          descricao_meta: `Compreender e aplicar os fundamentos centrais de ${dados.disciplina} atrav\303\251s de atividades estruturadas com DUA 3.0.`,\n          prazo: \'Mensal (4 semanas)\',\n          indicador_sucesso: \'Execu\303\247\303\243o aut\303\264noma de projeto pr\303\241tico documentado e com funcionamento validado.\',\n          progresso_percentual: 60,\n          status: \'em_andamento\',\n        },\n        {\n          id_meta: \'M2\',\n          descricao_meta: \'Desenvolver projeto integrador em equipe utilizando boas pr\303\241ticas e recursos de acessibilidade configurados.\',\n          prazo: \'Bimestral (8 semanas)\',\n          indicador_sucesso: \'Apresenta\303\247\303\243o t\303\251cnica com valida\303\247\303\243o entre pares e feedback formativo do docente.\',\n          progresso_percentual: 30,\n          status: \'em_andamento\',\n        },\n      ],\n      flexibilizacao_metodologica_dua: {\n        engajamento: [\n          solucao.remediosSugeridos.engajamento,\n          \'Acompanhamento cont\303\255nuo dos marcos parciais do projeto.\',\n          \'Reconhecimento das habilidades do estudante perante a turma.\',\n        ],\n        representacao: [\n          solucao.remediosSugeridos.representacao,\n          \'Disponibiliza\303\247\303\243o antecipada de guias e roteiros de laborat\303\263rio.\',\n          \'Suporte multissensorial com materiais textuais, diagramas e tutoriais.\',\n        ],\n        acao_e_expressao: [\n          solucao.remediosSugeridos.acaoExpressao,\n          \'Tempo ampliado (+50%) em atividades avaliativas de laborat\303\263rio.\',\n          \'M\303\272ltiplas formas de demonstra\303\247\303\243o t\303\251cnica (c\303\263digo, documenta\303\247\303\243o, defesa oral).\',\n        ],\n      },\n      gestao_sala_de_aula: {\n        organizacao_espacial: \'Bancada de laborat\303\263rio acess\303\255vel com layout ergon\303\264mico e espa\303\247o para circula\303\247\303\243o.\',\n        rotina_e_pausas: \'Pausas programadas a cada 45-60 minutos para preven\303\247\303\243o de fadiga f\303\255sica e sensorial.\',\n        agrupamentos_e_tutoria: \'Trabalho em duplas colaborativas com pap\303\251is t\303\251cnicos definidos.\',\n        suporte_docente_semanal: \'Sess\303\243o semanal de alinhamento pedag\303\263gico entre docente t\303\251cnico e NAPNE.\',\n      },\n      estrategias_avaliacao: {\n        formato_acessivel: solucao.remediosSugeridos.avaliacaoAcessivel,\n        criterio_de_sucesso: \'Compreens\303\243o t\303\251cnica, corretude l\303\263gica e aplica\303\247\303\243o pr\303\241tica dos conceitos da ementa.\',\n        grau_mediacao: \'pouca_mediacao\',\n        tempo_e_espaco: \'Tempo estendido (+50%) em ambiente de laborat\303\263rio com recursos de TA dispon\303\255veis.\',\n        recursos_utilizados: solucao.remediosSugeridos.recursosTA,\n      },\n      observacoes_docente: `O PEI foi estruturado de forma personalizada para ${dados.nome}, integrando as acomoda\303\247\303\265es recomendadas para sua condi\303\247\303\243o com foco no desenvolvimento de autonomia e excel\303\252ncia t\303\251cnica.`,\n    },\n    painel_notas: [\n      {\n        id: `N_init_${Date.now()}`,\n        autor: dados.docenteRegente || \'Docente Respons\303\241vel\',\n        papel: \'Regente\',\n        categoria: \'objetivos\',\n        conteudo: `In\303\255cio do acompanhamento pedag\303\263gico inclusivo para ${dados.disciplina}. Metas pactuadas no PEI.`,\n        data: new Date().toLocaleDateString(\'pt-BR\'),\n        cor: \'green\',\n      },\n    ],\n    metricas: {\n      percentual_metas_alcancadas: 45,\n      nivel_autonomia: 4,\n      engajamento: 5,\n      sessoes_semanais_realizadas: 4,\n      status_geral: \'EM_ANDAMENTO\',\n    },\n    parecer_pedagogico: `PEI elaborado em conson\303\242ncia com a Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025 para assegurar o pleno direito \303\240 escolariza\303\247\303\243o t\303\251cnica e superior com equidade.`,\n    sugestoes_proximo_ciclo: [\n      \'Manter as sess\303\265es semanais de suporte pedag\303\263gico com o NAPNE.\',\n      \'Acompanhar a evolu\303\247\303\243o das metas no conselho de classe / colegiado de curso.\',\n    ],\n  };\n}\n\n/**\n * Retorna o identificador an\303\264nimo/confidencial do estudante para visualiza\303\247\303\243o externa (Hub e listas p\303\272blicas),\n * preservando a privacidade at\303\251 que o docente acesse o PEI espec\303\255fico.\n */\nexport function getIdentificadorConfidencial(pei: PEICompleto, index?: number): string {\n  const isSuperior =\n    pei.cabecalho.curso.toLowerCase().includes(\'superior\') ||\n    pei.cabecalho.curso.toLowerCase().includes(\'sistemas\');\n  const modalidade = isSuperior ? \'Superior TI\' : \'M\303\251dio T\303\251cnico\';\n  const numLabel = index !== undefined ? `#${index + 1}` : \'\';\n  const codMat = pei.cabecalho.codigo_matricula\n    ? `[${pei.cabecalho.codigo_matricula}]`\n    : \'\';\n  return `PEI ${numLabel} \302\267 ${modalidade} ${codMat}`.trim();\n}\n\n"
