            lines {
              text: "    guiaPratico: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      passo_a_passo_explicacao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Inicie a aula mostrando o c\303\263digo ou teste j\303\241 funcionando na tela (vis\303\243o do objetivo final em 2 minutos). Em seguida, explique apenas o conceito central do dia usando um exemplo curto de c\303\263digo comentado, evitando exposi\303\247\303\265es te\303\263ricas cont\303\255nuas maiores que 15 minutos antes de ir para a pr\303\241tica no computador.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      divisao_tarefa_chunking: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 1 (15 min): Baixar o template inicial (starter kit) j\303\241 configurado e rodar o primeiro teste de verifica\303\247\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 2 (20 min): Implementar apenas a fun\303\247\303\243o principal ou caso de teste solicitado seguindo o checklist de 3 itens no quadro.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 3 (10 min): Validar com o linter visual na IDE, registrar o commit no Git e receber visto imediato do professor.\',"
