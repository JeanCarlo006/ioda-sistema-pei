    action_spec {
      create_file {
        instruction: "import { PEICompleto, ItemCAA } from \'../types/pei\';\n\nexport const casoGabriel: PEICompleto = {\n  id: \'EST-GRR-05\',\n  cabecalho: {\n    estudante: \'Gabriel Ramos Rodrigues\',\n    codigo_matricula: \'EST-GRR-05 / 2026.1\',\n    idade: \'11 anos\',\n    componente_curricular: \'Matem\303\241tica\',\n    modulo_periodo: \'5\302\272 Ano do Ensino Fundamental - 2\302\272 Semestre/2026\',\n    data_elaboracao: \'2026-10-27\',\n    docente_regente: \'Prof\302\252. Mariana de Souza & Prof\302\252. Manuela Ramos\',\n    docente_aee: \'Prof\302\252. Patr\303\255cia Silveira (AEE / SRM)\',\n    profissional_apoio: \'Jo\303\243o Pedro Alencar (Profissional de Apoio Escolar)\',\n    coordenacao_napne: \'Prof. Alexandre Lima (Orienta\303\247\303\243o e NAPNE)\',\n  },\n  historico_napne: {\n    breve_historico_clinico_familiar:\n      \'Gabriel reside em comunidade perif\303\251rica com sua m\303\243e, pai e dois irm\303\243os mais novos que tamb\303\251m estudam na mesma escola. Fam\303\255lia acolhedora e participativa, por\303\251m com vulnerabilidade socioecon\303\264mica e barreiras no transporte acess\303\255vel regular. O estudante apresenta diagn\303\263stico neurol\303\263gico de paralisia cerebral esp\303\241stica com quadros espor\303\241dicos de epilepsia controlada clinicamente. Importante ressaltar que, conforme a PNEEI (Decreto n\302\272 12.686/2025) e a Portaria MEC n\302\272 421/2026, a avalia\303\247\303\243o pedag\303\263gica escolar independe do laudo cl\303\255nico e tem foco na remo\303\247\303\243o de barreiras e promo\303\247\303\243o da acessibilidade curricular.\',\n    descricao_condicao_especifica:\n      \'Comprometimento motor bilateral com uso cont\303\255nuo de cadeira de rodas manual, limita\303\247\303\265es na preens\303\243o fina das m\303\243os (dificuldade para escrita manual cursiva e manuseio de folhas finas) e necessidades complexas de comunica\303\247\303\243o (oralidade em desenvolvimento, fala por emiss\303\265es monossil\303\241bicas e gestos). Requer apoio para locomo\303\247\303\243o em desn\303\255veis, alimenta\303\247\303\243o e higieniza\303\247\303\243o com fraldas descart\303\241veis, devendo-se sempre zelar por sua privacidade, dignidade e desenvolvimento de autonomia.\',\n    informacoes_dos_pais:\n      \'Entrevista realizada com a m\303\243e (Sra. Ana) em 16/03/2026. A fam\303\255lia valoriza muito os estudos de Gabriel e tem altas expectativas quanto \303\240 sua conclus\303\243o da Educa\303\247\303\243o B\303\241sica. Em casa, o estudante demonstra grande curiosidade e adora futebol (reconhece escudos, jogadores e coleciona figurinhas). A m\303\243e relatou que ele utiliza mesa inclinada em casa e colher adaptada, mas ainda escorrega da cadeira sem cinto adequado. Expressou grande desejo de ver Gabriel participando plenamente com os colegas.\',\n  },\n  estudo_de_caso: {\n    barreiras: [\n      {\n        id: \'B1\',\n        categoria: \'comunicacional\',\n        descricao: \'Comunica\303\247\303\243o oral e escrita tradicionalmente r\303\241pida, sem pausas nem suporte de pranchas de CAA estruturadas para comandos matem\303\241ticos e de rotina.\',\n        impacto: \'Dificulta a express\303\243o aut\303\264noma do racioc\303\255nio e a compreens\303\243o de enunciados longos.\',\n        estrategia_enfrentamento: \'Implementa\303\247\303\243o de pranchas de Comunica\303\247\303\243o Aumentativa e Alternativa (CAA) de baixa e alta tecnologia com s\303\255mbolos matem\303\241ticos e palavras-chave ilustradas (Lei n\302\272 15.249/2025).\',\n      },\n      {\n        id: \'B2\',\n        categoria: \'metodologica\',\n        descricao: \'Ensino da multiplica\303\247\303\243o e divis\303\243o ministrado prioritariamente de forma expositiva e abstrata no quadro.\',\n        impacto: \'Impede o estudante de construir o conceito de agrupamentos e proporcionalidade.\',\n        estrategia_enfrentamento: \'DUA 3.0: Uso de materiais t\303\241teis e concretos (Material Dourado, \303\241baco de pinos largos, tampinhas antiderrapantes, contextualiza\303\247\303\243o com figurinhas de futebol).\',\n      },\n      {\n        id: \'B3\',\n        categoria: \'tecnologica\',\n        descricao: \'Aus\303\252ncia de mesa acess\303\255vel na sala comum e falta de dispositivo digital (tablet/computador) com teclado de colmeia.\',\n        impacto: \'Gera fadiga postural precoce e impossibilita o registro independente das resolu\303\247\303\265es.\',\n        estrategia_enfrentamento: \'Garantir acesso constante a plano inclinado, fich\303\241rio com folhas de alta gramatura e tablet com aplicativo de prancha de comunica\303\247\303\243o e colmeia.\',\n      },\n      {\n        id: \'B4\',\n        categoria: \'arquitetonica\',\n        descricao: \'Cal\303\247ada de acesso \303\240 escola com desn\303\255veis, banheiro sem bancada de higieniza\303\247\303\243o apropriada e biblioteca situada no segundo andar apenas com escada.\',\n        impacto: \'Restringe a circula\303\247\303\243o e frequ\303\252ncia em dias chuvosos ou de falhas de transporte.\',\n        estrategia_enfrentamento: \'Encaminhamento urgente \303\240 Secretaria via FNDE (Caderno 14); reorganiza\303\247\303\243o provis\303\263ria das atividades da biblioteca em salas t\303\251rreas e bancada no trocador.\',\n      },\n      {\n        id: \'B5\',\n        categoria: \'atitudinal\',\n        descricao: \'Concep\303\247\303\265es de que o estudante necessita de tarefas empobrecidas, terap\303\252uticas ou infantilizadas em vez do curr\303\255culo do 5\302\272 ano.\',\n        impacto: \'Risco de baixa expectativa de aprendizagem e segrega\303\247\303\243o nas din\303\242micas de sala de aula.\',\n        estrategia_enfrentamento: \'Forma\303\247\303\243o continuada docente contra o capacitismo, valoriza\303\247\303\243o do protagonismo de Gabriel e aplica\303\247\303\243o dos princ\303\255pios de Justi\303\247a Curricular de Connell.\',\n      },\n    ],\n    potencialidades: [\n      {\n        id: \'P1\',\n        area: \'Centro de Interesse e Motiva\303\247\303\243o\',\n        descricao: \'Extrema paix\303\243o por futebol, clubes brasileiros, escala\303\247\303\265es e cole\303\247\303\265es de figurinhas numeradas.\',\n        apoio_demandado: \'Utilizar o futebol como tema disparador de problemas matem\303\241ticos de contagem e combina\303\247\303\265es (camisas x cal\303\247\303\265es).\',\n      },\n      {\n        id: \'P2\',\n        area: \'Sociabilidade e V\303\255nculo Afetivo\',\n        descricao: \'Muito soci\303\241vel, emp\303\241tico, comunica-se expressivamente atrav\303\251s de sorrisos, olhares direcionados, acenos e monoss\303\255labos.\',\n        apoio_demandado: \'Agrupamentos produtivos e tutoria por pares em pequenos grupos na sala comum.\',\n      },\n      {\n        id: \'P3\',\n        area: \'Racioc\303\255nio Matem\303\241tico Concreto\',\n        descricao: \'J\303\241 domina opera\303\247\303\265es de adi\303\247\303\243o e subtra\303\247\303\243o com unidades e dezenas quando manipula objetos concretos ou tabelas com velcro.\',\n        apoio_demandado: \'Transi\303\247\303\243o guiada da adi\303\247\303\243o de parcelas repetidas para o princ\303\255pio multiplicativo da BNCC.\',\n      },\n      {\n        id: \'P4\',\n        area: \'Capacidade de Leitura e Reconhecimento\',\n        descricao: \'L\303\252 palavras-chave, reconhece algarismos e associa pictogramas da CAA ao significado concreto com rapidez.\',\n        apoio_demandado: \'Substitui\303\247\303\243o de enunciados textuais prolixos por senten\303\247as curtas, cart\303\265es visuais e apoio de sintetizador de voz.\',\n      },\n    ],\n    recursos_ta: [\n      \'Pranchas de Comunica\303\247\303\243o Aumentativa e Alternativa (CAA) tem\303\241ticas com s\303\255mbolos matem\303\241ticos e futebol (baixa e alta tecnologia)\',\n      \'Plano inclinado ergon\303\264mico acoplado \303\240 carteira escolar acess\303\255vel\',\n      \'Fich\303\241rio adaptado com folhas de gramatura 120g/m\302\262, espa\303\247amento duplo e cart\303\265es imantados/velcro\',\n      \'Material Dourado em madeira de alta densidade e \303\241baco aberto com pinos e argolas de f\303\241cil empunhadura\',\n      \'Tablet acess\303\255vel com software de CAA din\303\242mica e teclado com colmeia acr\303\255lica\',\n      \'Colher com engrossador de silicone e prato com anteparo lateral para autonomia alimentar\',\n    ],\n    sintese_observacao: {\n      interacao_professores: \'Muito receptivo com professoras e mediadores; responde com entusiasmo quando solicitado de forma direta e afetuosa.\',\n      interacao_colegas: \'Excelente aceita\303\247\303\243o pelos colegas de turma; participa com alegria de jogos em equipe e torce com entusiasmo.\',\n      tarefas_coletivas: \'Participa ativamente quando h\303\241 material manipul\303\241vel ou fun\303\247\303\243o clara atribu\303\255da no grupo (ex: validador dos agrupamentos).\',\n      interesses_centrais: \'Futebol, figurinhas da copa e do campeonato brasileiro, m\303\272sicas alegres, v\303\255deos esportivos.\',\n      alfabetizacao_e_matematica: \'Em consolida\303\247\303\243o da leitura de voc\303\241bulos e frases curtas; realiza adi\303\247\303\243o e subtra\303\247\303\243o concreta com precis\303\243o.\',\n      cuidados_pessoais_autonomia: \'Usu\303\241rio de cadeira de rodas; necessita de profissional de apoio para transfer\303\252ncias, higieniza\303\247\303\243o e lanche.\',\n    },\n  },\n  plano_aee: {\n    organizacao_srm: {\n      frequencia: \'3 vezes na semana (2 atendimentos na SRM e 1 acompanhamento colaborativo em doc\303\252ncia compartilhada na sala comum)\',\n      duracao_minutos: 50,\n      composicao: \'individual_coletivo\',\n      espaco_atuacao: \'Sala de Recursos Multifuncionais (SRM Tipo I) + Sala de Aula Comum do 5\302\272 Ano\',\n    },\n    materiais_a_produzir: [\n      \'Pranchas de CAA de baixa tecnologia plastificadas com velcro (termos: vezes, igual, juntar, figurinhas, gols, times)\',\n      \'Tabelas de dupla entrada plastificadas com cart\303\265es de velcro destac\303\241veis para combina\303\247\303\265es de uniformes\',\n      \'Jogos pedag\303\263gicos de trilha multiplicativa com dados de tamanho ampliado e relevo t\303\241til\',\n      \'Fich\303\241rio de matem\303\241tica adaptado com fonte Arial tamanho 20 e contraste visual ampliado\',\n    ],\n    materiais_a_adquirir: [\n      \'Tablet com capa antiqueda e software de CAA din\303\242mica (Grid / Prancha F\303\241cil / Livox)\',\n      \'Plano inclinado com 4 n\303\255veis de angula\303\247\303\243o e r\303\251guas magn\303\251ticas de fixa\303\247\303\243o\',\n      \'Mesa com recorte curvo para encaixe de cadeira de rodas na sala de aula\',\n      \'Engrossadores universais de silicone e ponteira de cabe\303\247a/m\303\243o para digita\303\247\303\243o\',\n    ],\n    articulacao_ensino_comum: {\n      objetivos: \'Planejar em coparticipa\303\247\303\243o semanal as sequ\303\252ncias did\303\241ticas inclusivas, adequando as vias de representa\303\247\303\243o e express\303\243o conforme o DUA 3.0.\',\n      sessoes_suporte_semanal: \'Sess\303\243o semanal de 60 minutos (toda ter\303\247a-feira \303\240s 11h) entre a Professora do AEE, as Professoras Regentes e o Profissional de Apoio, para revis\303\243o cont\303\255nua das pr\303\241ticas, antecipa\303\247\303\243o de materiais e alinhamento dos apoios.\',\n      profissionais_orientados: [\n        \'Professoras Regentes do 5\302\272 Ano (Mariana e Manuela)\',\n        \'Profissional de Apoio Escolar (Jo\303\243o Pedro)\',\n        \'Equipe Pedag\303\263gica e Dire\303\247\303\243o Escolar\',\n        \'Equipe de Merenda e Nutri\303\247\303\243o escolar (card\303\241pio e consist\303\252ncia)\',\n      ],\n    },\n    articulacao_intersetorial: {\n      saude: \'Reuni\303\243o mensal com o N\303\272cleo Intersetorial (Fonoaudi\303\263loga da UBS e Terapeuta Ocupacional/Fisioterapeuta do CER II) para compatibiliza\303\247\303\243o da prancha de CAA escolar com a domiciliar.\',\n      assistencia_social: \'Articula\303\247\303\243o com o CRAS do territ\303\263rio para apoio na regulariza\303\247\303\243o do passe livre do transporte escolar acess\303\255vel e benef\303\255cios sociais da fam\303\255lia.\',\n      educacao_infraestrutura: \'Of\303\255cio enviado ao setor de engenharia da Secretaria Municipal de Educa\303\247\303\243o para reforma urgente da rampa de entrada e adapta\303\247\303\243o do banheiro infantil.\',\n    },\n    cronograma_revisao: \'Revis\303\243o formal semestral com a fam\303\255lia, equipe escolar e parecer descritivo cont\303\255nuo no portf\303\263lio pedag\303\263gico.\',\n  },\n  planejamento_pei: {\n    conteudo_ementa_oficial:\n      \'Problemas de contagem e princ\303\255pio multiplicativo: resolu\303\247\303\243o e elabora\303\247\303\243o de problemas envolvendo a determina\303\247\303\243o do n\303\272mero de agrupamentos poss\303\255veis ao se combinar elementos de cole\303\247\303\265es distintas.\',\n    competencias_habilidades_bncc:\n      \'BNCC Matem\303\241tica 5\302\272 Ano: (EF05MA09) Resolver e elaborar problemas simples de contagem envolvendo o princ\303\255pio multiplicativo, como a determina\303\247\303\243o do n\303\272mero de agrupamentos poss\303\255veis ao se combinar cada elemento de uma cole\303\247\303\243o com todos os elementos de outra cole\303\247\303\243o, por meio de diagramas de \303\241rvore ou por tabelas.\',\n    adaptacao_flexibilizacao_curricular:\n      \'Curr\303\255culo comum assegurado sem redu\303\247\303\243o de objetivos cognitivos. Acessibiliza\303\247\303\243o conceitual realizada pela representa\303\247\303\243o de opera\303\247\303\265es atrav\303\251s de cole\303\247\303\265es reais e tang\303\255veis (combina\303\247\303\265es de 3 camisas x 2 cal\303\247\303\265es de times de futebol; contagem de pacotinhos com 5 figurinhas cada).\',\n    objetivos_e_metas: [\n      {\n        id_meta: \'M1\',\n        descricao_meta: \'Compreender a rela\303\247\303\243o entre a adi\303\247\303\243o repetida de parcelas iguais e o conceito de multiplica\303\247\303\243o utilizando materiais concretos e cart\303\265es de CAA.\',\n        prazo: \'Mensal (4 semanas - at\303\251 25/11/2026)\',\n        indicador_sucesso: \'O estudante agrupa corretamente cole\303\247\303\265es concretas (ex: 3 pacotes de 4 figurinhas) e seleciona na prancha num\303\251rica o c\303\241lculo correspondente (4 + 4 + 4 = 12 ou 3 x 4 = 12) em pelo menos 4 de 5 tentativas.\',\n        progresso_percentual: 75,\n        status: \'em_andamento\',\n      },\n      {\n        id_meta: \'M2\',\n        descricao_meta: \'Resolver situa\303\247\303\265es-problema de princ\303\255pio multiplicativo combinat\303\263rio atrav\303\251s de matriz de dupla entrada com cart\303\265es de velcro no plano inclinado.\',\n        prazo: \'Bimestral (8 semanas - at\303\251 20/12/2026)\',\n        indicador_sucesso: \'Ao combinar elementos de duas cole\303\247\303\265es (camisas x cal\303\247\303\265es), o estudante posiciona as imagens na tabela de dupla entrada e indica o total de 6 combina\303\247\303\265es sem necessitar de escrita caligr\303\241fica manual.\',\n        progresso_percentual: 50,\n        status: \'em_andamento\',\n      },\n      {\n        id_meta: \'M3\',\n        descricao_meta: \'Utilizar autonomamente a prancha tem\303\241tica de CAA no tablet ou fich\303\241rio para expressar d\303\272vidas e solicitar recursos durante os momentos de aula coletiva.\',\n        prazo: \'Bimestral cont\303\255nuo\',\n        indicador_sucesso: \'Aciona o s\303\255mbolo \"Quero tentar\", \"Mais tempo\" ou \"Preciso de ajuda\" de forma espont\303\242nea em pelo menos 3 aulas semanais.\',\n        progresso_percentual: 80,\n        status: \'em_andamento\',\n      },\n    ],\n    flexibilizacao_metodologica_dua: {\n      engajamento: [\n        \'Ancoragem tem\303\241tica no futebol: contagem de figurinhas, escala\303\247\303\243o de jogadores e combina\303\247\303\265es de uniformes esportivos que despertam a motiva\303\247\303\243o intr\303\255nseca de Gabriel.\',\n        \'Organiza\303\247\303\243o de agrupamentos colaborativos (3 a 4 alunos) com tutoria entre pares, atribuindo a Gabriel o papel de estrategista que decide as combina\303\247\303\265es das jogadas.\',\n        \'Rotina previs\303\255vel e acolhedora: calend\303\241rio visual afixado no plano inclinado com a ordem das atividades do dia e pausas de descanso programadas.\',\n      ],\n      representacao: [\n        \'Encena\303\247\303\243o concreta na sala de aula: os pr\303\263prios alunos representam os times e as combina\303\247\303\265es com camisas coloridas antes do registro gr\303\241fico no quadro.\',\n        \'Apresenta\303\247\303\243o simult\303\242nea no quadro principal e na mini-lousa individual do plano inclinado com s\303\255mbolos visuais, fonte ampliada (Arial 20) e alto contraste.\',\n        \'Explora\303\247\303\243o multissensorial com Material Dourado em relevo, \303\241baco de pinos largos e apoio de s\303\255ntese vocal no tablet para audi\303\247\303\243o dos enunciados.\',\n      ],\n      acao_e_expressao: [\n        \'Elimina\303\247\303\243o da exig\303\252ncia de caligrafia manual em folhas soltas: respostas registradas via fixa\303\247\303\243o de cart\303\265es com velcro em tabelas r\303\255gidas.\',\n        \'Uso de prancha de Comunica\303\247\303\243o Aumentativa e Alternativa (CAA) com ponteira adaptada ou sele\303\247\303\243o t\303\241til para resposta a perguntas conceituais da professora.\',\n        \'Possibilidade de valida\303\247\303\243o de c\303\241lculos matem\303\241ticos no tablet ou calculador t\303\241til adaptado.\',\n      ],\n    },\n    gestao_sala_de_aula: {\n      organizacao_espacial:\n        \'Disposi\303\247\303\243o das carteiras em semic\303\255rculo ou ilhas de trabalho, garantindo corredor livre de 1,20m para circula\303\247\303\243o da cadeira de rodas e posicionamento central pr\303\263ximo ao quadro e aos colegas.\',\n      rotina_e_pausas:\n        \'Aulas de racioc\303\255nio matem\303\241tico alocadas no in\303\255cio do turno escolar (per\303\255odo de maior alerta cognitivo e menor fadiga f\303\255sica). Previs\303\243o de pausa de 5 a 10 minutos para \"respiro\" fora da sala quando houver sinais de cansa\303\247o postural.\',\n      agrupamentos_e_tutoria:\n        \'Duplas produtivas e tutoria por pares rotativa com colegas acolhedores que auxiliam na sustenta\303\247\303\243o de materiais sem substituir o protagonismo de escolha do estudante.\',\n      suporte_docente_semanal:\n        \'Sess\303\265es de suporte semanais garantidas na carga hor\303\241ria (ter\303\247as-feiras) entre regentes, AEE e profissional de apoio para alinhar os materiais acess\303\255veis e o progresso das metas.\',\n    },\n    estrategias_avaliacao: {\n      formato_acessivel:\n        \'Avalia\303\247\303\243o formativa, cont\303\255nua e processual integrada aos jogos e resolu\303\247\303\265es no plano inclinado. Substitui\303\247\303\243o da prova tradicional de papel e caneta por verifica\303\247\303\243o pr\303\241tica mediada com tabela de velcro e prancha de CAA.\',\n      criterio_de_sucesso:\n        \'Compreens\303\243o substantiva da rela\303\247\303\243o multiplicativa e resolu\303\247\303\243o correta das combina\303\247\303\265es da BNCC EF05MA09 atrav\303\251s das m\303\272ltiplas formas de a\303\247\303\243o e express\303\243o.\',\n      grau_mediacao: \'com_mediacao\',\n      tempo_e_espaco:\n        \'Tempo estendido (+50%) em ambiente acolhedor, respeitando o ritmo motor e comunicacional do estudante sem press\303\243o temporal.\',\n      recursos_utilizados: [\n        \'Prancha de CAA com n\303\272meros e operadores\',\n        \'Tabela de dupla entrada com velcro\',\n        \'Tablet com aplicativo de respostas matem\303\241ticas\',\n        \'Plano inclinado para mesa acess\303\255vel\',\n      ],\n    },\n    observacoes_docente:\n      \'Gabriel demonstra not\303\241vel ganho de confian\303\247a ao longo das \303\272ltimas 4 semanas. A introdu\303\247\303\243o dos uniformes de futebol no plano inclinado eliminou completamente o desinteresse inicial. Observa-se maior persist\303\252ncia na tarefa e os colegas da turma aprenderam a aguardar o tempo de resposta na prancha de CAA, promovendo uma cultura escolar genuinamente inclusiva e fraterna.\',\n  },\n  painel_notas: [\n    {\n      id: \'N1\',\n      autor: \'Prof\302\252. Mariana (Regente)\',\n      papel: \'Regente\',\n      categoria: \'objetivos\',\n      conteudo: \'Gabriel conseguiu resolver 4 combina\303\247\303\265es de uniformes hoje na tabela de velcro sem errar! Mostrou o n\303\272mero 6 na prancha sorrindo.\',\n      data: \'24/10/2026\',\n      cor: \'green\',\n    },\n    {\n      id: \'N2\',\n      autor: \'Prof\302\252. Patr\303\255cia (AEE)\',\n      papel: \'AEE\',\n      categoria: \'recursos_ta\',\n      conteudo: \'Entregamos o novo jogo de cart\303\265es com velcro de futebol plastificados e com contraste preto/amarelo para facilitar a fixa\303\247\303\243o motora.\',\n      data: \'22/10/2026\',\n      cor: \'yellow\',\n    },\n    {\n      id: \'N3\',\n      autor: \'Jo\303\243o Pedro (Apoio)\',\n      papel: \'Apoio\',\n      categoria: \'rotina\',\n      conteudo: \'A pausa de 7 minutos no meio da aula de matem\303\241tica evitou a fadiga que ele sentia antes. Ele retornou com \303\263timo foco.\',\n      data: \'21/10/2026\',\n      cor: \'blue\',\n    },\n    {\n      id: \'N4\',\n      autor: \'Prof. Alexandre (Coord. NAPNE)\',\n      papel: \'Coordena\303\247\303\243o\',\n      categoria: \'apoio\',\n      conteudo: \'Reuni\303\243o de alinhamento semanal agendada para ter\303\247a-feira \303\240s 11h. Pauta: aquisi\303\247\303\243o de tablet pelo recurso do PDDE Acess\303\255vel.\',\n      data: \'20/10/2026\',\n      cor: \'pink\',\n    },\n    {\n      id: \'N5\',\n      autor: \'Sra. Ana (M\303\243e)\',\n      papel: \'Fam\303\255lia\',\n      categoria: \'rotina\',\n      conteudo: \'Gabriel chegou em casa ontem contando com o fich\303\241rio sobre as figurinhas dos times! Muito feliz de ver a motiva\303\247\303\243o dele.\',\n      data: \'18/10/2026\',\n      cor: \'orange\',\n    },\n  ],\n  metricas: {\n    percentual_metas_alcancadas: 68,\n    nivel_autonomia: 3,\n    engajamento: 5,\n    sessoes_semanais_realizadas: 8,\n    status_geral: \'EM_ANDAMENTO\',\n  },\n  parecer_pedagogico:\n    \'O Plano Educacional Individualizado (PEI) de Gabriel Ramos Rodrigues, derivado das quatro etapas do Estudo de Caso e alinhado ao PAEE, atende integralmente ao Decreto Presidencial n\302\272 12.686/2025 e \303\240 Portaria MEC n\302\272 421/2026. A elimina\303\247\303\243o das barreiras metodol\303\263gicas e comunicacionais atrav\303\251s do DUA 3.0 e dos recursos de Tecnologia Assistiva comprovou que a defici\303\252ncia f\303\255sica e as necessidades complexas de comunica\303\247\303\243o n\303\243o representam impedimento para a apropria\303\247\303\243o dos conceitos matem\303\241ticos da BNCC do 5\302\272 ano.\',\n  sugestoes_proximo_ciclo: [\n    \'Manter e institucionalizar as sess\303\265es de suporte semanais no calend\303\241rio da escola para garantir a efic\303\241cia das interven\303\247\303\265es e o progresso cont\303\255nuo no plano.\',\n    \'Avan\303\247ar para a divis\303\243o como partilha de quantidades concretas ap\303\263s a consolida\303\247\303\243o plena do princ\303\255pio multiplicativo.\',\n    \'Finalizar a aquisi\303\247\303\243o do tablet escolar com colmeia para uso integrado em todas as disciplinas e ambientes da escola.\',\n    \'Cobrar retorno da Secretaria Municipal sobre a reforma do banheiro acess\303\255vel e da rota de entrada da escola.\',\n  ],\n};\n\nexport const itensCaaMatematica: ItemCAA[] = [\n  { id: \'c1\', rotulo: \'1\', categoria: \'matematica\', icone: \'1\357\270\217\342\203\243\', audioTexto: \'Um\' },\n  { id: \'c2\', rotulo: \'2\', categoria: \'matematica\', icone: \'2\357\270\217\342\203\243\', audioTexto: \'Dois\' },\n  { id: \'c3\', rotulo: \'3\', categoria: \'matematica\', icone: \'3\357\270\217\342\203\243\', audioTexto: \'Tr\303\252s\' },\n  { id: \'c4\', rotulo: \'4\', categoria: \'matematica\', icone: \'4\357\270\217\342\203\243\', audioTexto: \'Quatro\' },\n  { id: \'c5\', rotulo: \'5\', categoria: \'matematica\', icone: \'5\357\270\217\342\203\243\', audioTexto: \'Cinco\' },\n  { id: \'c6\', rotulo: \'6\', categoria: \'matematica\', icone: \'6\357\270\217\342\203\243\', audioTexto: \'Seis\' },\n  { id: \'c7\', rotulo: \'12\', categoria: \'matematica\', icone: \'\360\237\224\242\', audioTexto: \'Doze\' },\n  { id: \'c8\', rotulo: \'Multiplicar (\303\227)\', categoria: \'matematica\', icone: \'\342\234\226\357\270\217\', audioTexto: \'Vezes, multiplicar\' },\n  { id: \'c9\', rotulo: \'Igual (=)\', categoria: \'matematica\', icone: \'\360\237\237\260\', audioTexto: \'\303\211 igual a\' },\n  { id: \'c10\', rotulo: \'Pacote Figurinhas\', categoria: \'futebol\', icone: \'\360\237\203\217\', audioTexto: \'Pacote de figurinhas\' },\n  { id: \'c11\', rotulo: \'Camisa de Time\', categoria: \'futebol\', icone: \'\360\237\221\225\', audioTexto: \'Camisa do time\' },\n  { id: \'c12\', rotulo: \'Cal\303\247\303\243o\', categoria: \'futebol\', icone: \'\360\237\251\263\', audioTexto: \'Cal\303\247\303\243o\' },\n  { id: \'c13\', rotulo: \'Gol / Ponto\', categoria: \'futebol\', icone: \'\342\232\275\', audioTexto: \'Gol! Marcou ponto\' },\n  { id: \'c14\', rotulo: \'Quero Tentar\', categoria: \'comunicacao\', icone: \'\360\237\231\213\342\200\215\342\231\202\357\270\217\', audioTexto: \'Eu quero tentar fazer agora!\' },\n  { id: \'c15\', rotulo: \'Preciso de Ajuda\', categoria: \'comunicacao\', icone: \'\360\237\244\235\', audioTexto: \'Professor, preciso de ajuda aqui.\' },\n  { id: \'c16\', rotulo: \'Entendi!\', categoria: \'socioemocional\', icone: \'\360\237\222\241\', audioTexto: \'Entendi o conceito, que legal!\' },\n  { id: \'c17\', rotulo: \'Pausa / Respiro\', categoria: \'rotina\', icone: \'\360\237\252\221\', audioTexto: \'Preciso de uma pausa para respirar.\' },\n  { id: \'c18\', rotulo: \'Meu Amigo / Dupla\', categoria: \'rotina\', icone: \'\360\237\221\245\', audioTexto: \'Quero fazer a atividade em dupla.\' },\n];\n"
