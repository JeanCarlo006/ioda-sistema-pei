  code_action {
    action_spec {
      create_file {
        instruction: "@import \"tailwindcss\";\n\n@layer base {\n  body {\n    font-family: \'Inter\', system-ui, -apple-system, BlinkMacSystemFont, \'Segoe UI\', Roboto, sans-serif;\n    transition: background-color 0.2s ease, color 0.2s ease;\n    letter-spacing: -0.011em;\n  }\n}\n\n/* DUA 3.0: Personaliza\303\247\303\243o de Tamanho de Fonte */\nhtml.font-scale-normal {\n  font-size: 16px;\n}\nhtml.font-scale-ampliada {\n  font-size: 18px;\n}\nhtml.font-scale-grande {\n  font-size: 20px;\n}\n\n/* DUA 3.0: Temas de Contraste e Conforto Visual */\nbody.theme-alto-contraste {\n  background-color: #09090b !important;\n  color: #f4f4f5 !important;\n}\n\nbody.theme-alto-contraste .bg-white {\n  background-color: #121215 !important;\n  color: #f4f4f5 !important;\n  border-color: #3f3f46 !important;\n}\n\nbody.theme-alto-contraste .bg-slate-50,\nbody.theme-alto-contraste .bg-slate-100 {\n  background-color: #1c1c21 !important;\n  color: #f4f4f5 !important;\n  border-color: #52525b !important;\n}\n\nbody.theme-alto-contraste .text-slate-900,\nbody.theme-alto-contraste .text-slate-800,\nbody.theme-alto-contraste .text-slate-700 {\n  color: #ffffff !important;\n}\n\nbody.theme-alto-contraste .text-slate-600,\nbody.theme-alto-contraste .text-slate-500 {\n  color: #d4d4d8 !important;\n}\n\nbody.theme-alto-contraste input,\nbody.theme-alto-contraste textarea,\nbody.theme-alto-contraste select {\n  background-color: #18181b !important;\n  color: #ffffff !important;\n  border-color: #a1a1aa !important;\n}\n\nbody.theme-alto-contraste .border-slate-200,\nbody.theme-alto-contraste .border-slate-100,\nbody.theme-alto-contraste .border-slate-300 {\n  border-color: #3f3f46 !important;\n}\n\n/* Modo Conforto Visual (S\303\251pia / Leitura Suave) */\nbody.theme-conforto {\n  background-color: #fcf9f2 !important;\n  color: #292524 !important;\n}\n\nbody.theme-conforto .bg-white {\n  background-color: #f7f3e8 !important;\n  border-color: #e7dec8 !important;\n}\n\nbody.theme-conforto .bg-slate-50,\nbody.theme-conforto .bg-slate-100 {\n  background-color: #efe9d9 !important;\n  border-color: #ded3bd !important;\n}\n\nbody.theme-conforto input,\nbody.theme-conforto textarea,\nbody.theme-conforto select {\n  background-color: #fcf9f2 !important;\n  border-color: #cfc2a7 !important;\n}\n\n/* CSS Oficial de Impress\303\243o (@media print) */\n@media print {\n  @page {\n    size: A4 portrait;\n    margin: 12mm;\n  }\n\n  html,\n  body {\n    background: #ffffff !important;\n    color: #000000 !important;\n    font-size: 12px !important;\n    -webkit-print-color-adjust: exact !important;\n    print-color-adjust: exact !important;\n  }\n\n  .no-print {\n    display: none !important;\n  }\n\n  .print-only {\n    display: block !important;\n  }\n\n  main {\n    padding: 0 !important;\n    margin: 0 !important;\n    max-width: 100% !important;\n  }\n\n  .official-print-sheet {\n    border: none !important;\n    box-shadow: none !important;\n    padding: 0 !important;\n    margin: 0 !important;\n    width: 100% !important;\n    max-width: 100% !important;\n  }\n\n  table {\n    page-break-inside: auto;\n  }\n\n  tr {\n    page-break-inside: avoid;\n    page-break-after: auto;\n  }\n}\n"
        path {
          absolute_uri: "file:///src/index.css"
        }
        overwrite: true
      }
    }
