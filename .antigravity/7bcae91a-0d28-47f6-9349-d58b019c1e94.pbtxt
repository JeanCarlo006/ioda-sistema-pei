              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Publique o roteiro da aula no Moodle com anteced\303\252ncia. Use linguagem literal, direta e sem figuras de linguagem. Apresente entradas e sa\303\255das esperadas em tabelas claras (Ex: Entrada = 5 -> Sa\303\255da Esperada = \"Aprovado\") e mantenha a mesma bancada fixa no laborat\303\263rio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      divisao_tarefa_chunking: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 1: Ler o roteiro passo a passo numerado (1.1, 1.2, 1.3) com crit\303\251rios objetivos de conclus\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Etapa 2: Codificar os m\303\263dulos individualmente ou em dupla fixa com papel t\303\251cnico claramente definido (ex: respons\303\241vel pelos testes unit\303\241rios).\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
