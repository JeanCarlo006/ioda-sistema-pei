              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        id: \'B1\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        categoria: \'metodologica\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        descricao: \'Avalia\303\247\303\265es pr\303\241ticas de programa\303\247\303\243o com exig\303\252ncia de digita\303\247\303\243o manual sob press\303\243o temporal restrita (ex: implementar 3 algoritmos em 50 minutos).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        impacto: \'A fadiga muscular nas m\303\243os impede a finaliza\303\247\303\243o do c\303\263digo, gerando notas que n\303\243o refletem sua real capacidade l\303\263gica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        estrategia_enfrentamento: \'DUA 3.0: Tempo ampliado (+50%), entrega de projetos em etapas com versionamento no Git (avalia\303\247\303\243o processual cont\303\255nua) e op\303\247\303\243o de defesa oral da l\303\263gica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
