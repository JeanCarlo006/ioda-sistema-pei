);\n      }\n    }\n  };"
        replacement_content: "    if (perfil === \'superior_ti\') {\n      setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\');\n      setModulo(\'4\302\272 Per\303\255odo / Noturno\');\n      setDisciplina(\'BAC.0406 - Engenharia de Software II\');\n      setDocenteRegente(\'Prof. Alexandre Santos\');\n      setIdade(\'21 anos\');\n      syncSelectedConditions([\'sol-tdah\'], \'BAC.0406 - Engenharia de Software II\');\n    } else {\n      setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n      setModulo(\'2\302\272 Ano / Diurno\');\n      setDisciplina(\'Programa\303\247\303\243o Web e Algoritmos\');\n      setDocenteRegente(\'Prof. Docente da Disciplina\');\n      setIdade(\'17 anos\');\n      syncSelectedConditions([\'sol-tea\'], \'Programa\303\247\303\243o Web e Algoritmos\');\n    }\n  };\n\n  // Synchronize form fields whenever the multi-selected neurodivergences change\n  const syncSelectedConditions = (ids: string[], discOverride?: string) => {\n    const finalIds = ids.length > 0 ? ids : [\'sol-tdah\'];\n    setSelectedSolucoes(finalIds);\n\n    const solucoesObjs = finalIds\n      .map((sid) => bancoDeSolucoesPedagogicas.find((s) => s.id === sid))\n      .filter(Boolean);\n\n    if (solucoesObjs.length > 0) {\n      const titulosCombinados = solucoesObjs.map((s) => s!.titulo).join(\' + \');\n      setCategoriaNeurodivergencia(titulosCombinados);\n\n      const currentDisc = discOverride ?? disciplina;\n      const isEngSoft =\n        currentDisc.toLowerCase().includes(\'engenharia de software\') ||\n        currentDisc.includes(\'BAC.0406\');\n\n      const descricoesCombinadas = solucoesObjs\n        .map((s) => `\342\200\242 ${s!.titulo}: ${s!.descricaoProblema}`)\n        .join(\'\\n\');\n\n      let customCondicao = descricoesCombinadas;\n      if (isEngSoft) {\n        customCondicao += `\\n\\n[Contextualiza\303\247\303\243o na disciplina BAC.0406 - Engenharia de Software II: acomoda\303\247\303\265es integradas para testes unit\303\241rios TDD em JUnit/Selenium, relat\303\263rios de defeitos no Jira e normas de qualidade ISO/IEC 25010].`;\n      }\n      setCondicao(customCondicao);\n\n      const taUnificada = Array.from(\n        new Set(solucoesObjs.flatMap((s) => s!.remediosSugeridos.recursosTA))\n      );\n      setAssistiveTech(taUnificada.join(\', \'));\n\n      const mapPotencial: Record<string, string> = {\n        \'sol-tdah\':\n          \'Racioc\303\255nio \303\241gil, resolu\303\247\303\243o criativa de bugs l\303\263gicos e hiperfoco em desafios t\303\251cnicos de codifica\303\247\303\243o quando apoiado por micro-sprints\',\n        \'sol-tea\':\n          \'Aten\303\247\303\243o meticulosa aos detalhes, racioc\303\255nio l\303\263gico met\303\263dico e facilidade para identificar anomalias em c\303\263digo e testes automatizados\',\n        \'sol-ansiedade\':\n          \'Rigor conceitual, comprometimento com entregas de qualidade e excelente desempenho em projetos pr\303\241ticos desenvolvidos com tranquilidade\',\n        \'sol-aprendizagem\':\n          \'Pensamento computacional visual, vis\303\243o de arquitetura de software desacoplada e excelente racioc\303\255nio algor\303\255tmico\',\n        \'sol-def-intelectual\':\n          \'Dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o, colabora\303\247\303\243o em duplas estruturadas e boa reten\303\247\303\243o com instru\303\247\303\265es objetivas\',\n        \'sol-toc\':\n          \'Elevada precis\303\243o t\303\251cnica, meticulosidade na cobertura de testes e ader\303\252ncia a padr\303\265es arquiteturais limpos\',\n        \'sol-misto-ansioso-depressivo\':\n          \'Comprometimento com projetos significativos e foco t\303\251cnico consistente quando amparado por metas graduais\',\n        \'sol-depressao\':\n          \'Capacidade anal\303\255tica e engajamento construtivo em projetos pr\303\241ticos em ambiente acolhedor e ass\303\255ncrono\',\n        \'sol-epilepsia\':\n          \'Racioc\303\255nio l\303\263gico estruturado e consist\303\252ncia t\303\251cnica em ambiente de laborat\303\263rio visualmente seguro\',\n      };\n\n      const potList = finalIds.map(\n        (id) =>\n          mapPotencial[id] ||\n          \'Dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o, racioc\303\255nio l\303\263gico e colabora\303\247\303\243o t\303\251cnica\'\n      );\n      setPotentialidades(Array.from(new Set(potList)).join(\'; \') + \'.\');\n\n      if (finalIds.includes(\'sol-hipotese-sem-laudo\')) {\n        setStatusDiagnostico(\'em_investigacao_hipotese\');\n      }\n    }\n  };\n\n  // Toggle selection of one or more neurodivergences (supports TEA + TDAH, etc.)\n  const handleTogglePredefinedSolution = (id: string) => {\n    const exists = selectedSolucoes.includes(id);\n    let nextIds: string[];\n    if (exists) {\n      // Keep at least 1 selected or replace if only 1\n      nextIds = selectedSolucoes.length > 1 ? selectedSolucoes.filter((item) => item !== id) : [id];\n    } else {\n      nextIds = [...selectedSolucoes, id];\n    }\n    syncSelectedConditions(nextIds);\n  };"
