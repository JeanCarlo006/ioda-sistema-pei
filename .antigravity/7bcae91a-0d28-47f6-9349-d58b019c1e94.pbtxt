    content: "          >\n            <X className=\"w-5 h-5\" />\n          </button>\n        </div>\n\n        {/* Level Switcher (Ensino M\303\251dio T\303\251cnico vs Ensino Superior TI) */}\n        <div className=\"mb-4 p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n          <label className=\"text-xs font-bold text-slate-700 uppercase tracking-wider block\">\n            1. Selecione o N\303\255vel de Ensino (Campus Para\303\255so):\n          </label>\n          <div className=\"grid grid-cols-2 gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => handleToggleNivel(\'medio\')}\n              className={`p-2 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer ${\n                nivelEducacional === \'medio\'\n                  ? \'bg-emerald-800 text-white border-emerald-900 shadow-xs\'\n                  : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-100\'\n              }`}\n            >\n              Ensino M\303\251dio T\303\251cnico (15 estudantes no campus)\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => handleToggleNivel(\'superior\')}\n              className={`p-2 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer ${\n                nivelEducacional === \'superior\'\n                  ? \'bg-emerald-800 text-white border-emerald-900 shadow-xs\'\n                  : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-100\'\n              }`}\n            >\n              Ensino Superior em TI (14 estudantes no campus)\n            </button>\n          </div>\n        </div>\n\n        {/* Diagnostic Status Switcher (Confirmed vs Hypothesis/No Medical Report) */}\n        <div className=\"mb-4 p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n          <label className=\"text-xs font-bold text-slate-700 uppercase tracking-wider block\">\n            2. Situa\303\247\303\243o Diagn\303\263stica do Estudante:\n          </label>\n          <div className=\"grid grid-cols-2 gap-2\">\n            <button\n              type=\"button\"\n              onClick={() => setStatusDiagnostico(\'confirmado\')}\n              className={`p-2 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer flex items-center justify-center gap-1.5 ${\n                statusDiagnostico === \'confirmado\'\n                  ? \'bg-blue-800 text-white border-blue-900 shadow-xs\'\n                  : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-100\'\n              }`}\n            >\n              <FileCheck2 className=\"w-3.5 h-3.5\" />\n              <span>Diagn\303\263stico Confirmado (24 no campus)</span>\n            </button>\n\n            <button\n              type=\"button\"\n              onClick={() => setStatusDiagnostico(\'em_investigacao_hipotese\')}\n              className={`p-2 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer flex items-center justify-center gap-1.5 ${\n                statusDiagnostico === \'em_investigacao_hipotese\'\n                  ? \'bg-amber-600 text-white border-amber-700 shadow-xs\'\n                  : \'bg-white text-amber-900 border-amber-300 hover:bg-amber-50\'\n              }`}\n            >\n              <HelpCircle className=\"w-3.5 h-3.5\" />\n              <span>Sem Laudo / Em Investiga\303\247\303\243o (5 no campus)</span>\n            </button>\n          </div>\n\n          {statusDiagnostico === \'em_investigacao_hipotese\' && (\n            <div className=\"p-2.5 bg-amber-50 border border-amber-200 rounded-lg text-[11px] text-amber-900 leading-relaxed flex items-start gap-2 mt-2\">\n              <ShieldCheck className=\"w-4 h-4 text-amber-700 shrink-0 mt-0.5\" />\n              <span>\n                <strong>Garantia Legal Portaria MEC n\302\272 421/2026:</strong> A aus\303\252ncia de laudo m\303\251dico pericial n\303\243o impede a elabora\303\247\303\243o do PEI nem a disponibiliza\303\247\303\243o de adapta\303\247\303\265es no laborat\303\263rio de TI. O plano \303\251 centrado na observa\303\247\303\243o das barreiras escolares.\n              </span>\n            </div>\n          )}\n        </div>\n\n        {/* Quick condition presets */}\n        <div className=\"mb-4 p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n          <div className=\"flex items-center justify-between\">\n            <label className=\"text-xs font-bold text-slate-700 uppercase tracking-wider block\">\n              3. Preencher por Condi\303\247\303\243o Mapeada no Campus:\n            </label>\n            <span className=\"text-[10px] text-slate-500 font-mono\">DUA 3.0 & TA</span>\n          </div>\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-1.5 max-h-48 overflow-y-auto pr-1\">\n            {bancoDeSolucoesPedagogicas.map((sol) => (\n              <button\n                key={sol.id}\n                type=\"button\"\n                onClick={() => handleSelectPredefinedSolution(sol.id)}\n                className={`p-2 text-left text-xs rounded-lg border transition-all cursor-pointer ${\n                  solucaoId === sol.id\n                    ? \'bg-emerald-50 border-emerald-500 text-emerald-950 font-semibold shadow-xs\'\n                    : \'bg-white border-slate-300 text-slate-700 hover:border-slate-400\'\n                }`}\n              >\n                <div className=\"flex items-center justify-between\">\n                  <span className=\"font-bold text-slate-900 truncate\">{sol.titulo.split(\'/\')[0]}</span>\n                  <span className=\"text-[9px] text-slate-500 font-mono shrink-0 ml-1\">\n                    {sol.nivelSugerido}\n                  </span>\n                </div>\n                <p className=\"text-[10px] text-slate-500 mt-0.5 truncate\">\n                  {sol.condicao}\n                </p>\n              </button>\n            ))}\n          </div>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4 text-xs\">\n          <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n            <div className=\"sm:col-span-2\">\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Nome Completo do Estudante\n              </label>\n              <input\n                type=\"text\"\n                value={nome}\n                onChange={(e) => setNome(e.target.value)}\n                placeholder=\"Ex: Gabriel Moreira Silva\"\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\"\n                required\n              />\n            </div>\n\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Matr\303\255cula\n              </label>\n              <input\n                type=\"text\"\n                value={matricula}\n                onChange={(e) => setMatricula(e.target.value)}\n                placeholder=\"Ex: 2026.1.INF.092\"\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\"\n              />\n            </div>\n          </div>\n\n          <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                Curso\n              </label>\n              <input\n                type=\"text\"\n                value={curso}\n                onChange={(e) => setCurso(e.target.value)}\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\"\n                required\n              />\n            </div>\n\n            <div>\n              <label className=\"block font-bold text-slate-700 uppercase tracking-wider mb-1\">\n                M\303\263dulo / Per\303\255odo / Ano\n              </label>\n              <input\n                type=\"text\"\n                value={modulo}\n                onChange={(e) => setModulo(e.target.value)}\n                className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\"\n                required\n              />\n            </div>"
    num_lines: 651
