            }
            lines {
              text: "    nivelSugerido: \'Ambos\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    descricaoProblema:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Dificuldade na reten\303\247\303\243o de sequ\303\252ncias extensas de instru\303\247\303\265es abstratas e na compreens\303\243o de conceitos excessivamente te\303\263ricos desvinculados da experimenta\303\247\303\243o pr\303\241tica nos laborat\303\263rios de inform\303\241tica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    remediosSugeridos: {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      engajamento:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Aprendizagem mediada e contextualizada com exemplos pr\303\241ticos imediatos do cotidiano do campus; valoriza\303\247\303\243o dos sucessos intermedi\303\241rios com refor\303\247o pedag\303\263gico positivo pelo monitor de apoio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      representacao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Fracionamento de instru\303\247\303\265es complexas em 2 a 3 passos objetivos por vez; suporte de esquemas visuais coloridos, fluxogramas simplificados e tutoriais passo a passo em v\303\255deo curto.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      acaoExpressao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Avalia\303\247\303\243o pr\303\241tica focada na execu\303\247\303\243o de tarefas t\303\251cnicas concretas (ex: rodar teste unit\303\241rio, identificar falha guiada); tempo ampliado (+100%); media\303\247\303\243o assistida de monitor.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      recursosTA: ["
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Roteiros impressos com esquemas visuais passo a passo\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Ambiente de desenvolvimento simplificado com atalhos de execu\303\247\303\243o pr\303\251-configurados\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Apoio individualizado de monitor de acessibilidade pedag\303\263gica do NAPNE\',"
