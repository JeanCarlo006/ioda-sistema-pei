      create_file {
        instruction: "import React from \'react\';\nimport { PEICompleto } from \'../types/pei\';\nimport { todosOsCasos } from \'../data/initialCases\';\nimport { UserCheck, ShieldCheck, BookOpen, GraduationCap } from \'lucide-react\';\n\ninterface StudentHeaderProps {\n  pei: PEICompleto;\n  onSelectCase: (selectedPei: PEICompleto) => void;\n}\n\nexport const StudentHeader: React.FC<StudentHeaderProps> = ({ pei, onSelectCase }) => {\n  const { cabecalho, metricas } = pei;\n\n  const getInitial = (name: string) => {\n    return name ? name.charAt(0).toUpperCase() : \'E\';\n  };\n\n  return (\n    <div className=\"bg-white border-b border-slate-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5\">\n        {/* Case Selector Banner */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-4 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <GraduationCap className=\"w-4 h-4 text-emerald-700\" />\n            <span className=\"text-xs font-bold text-slate-800 uppercase tracking-wider\">\n              Casos Reais por N\303\255vel de Ensino (NAPNE / PNEEI):\n            </span>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-1.5\">\n            {todosOsCasos.map((c) => {\n              const isCurrent = c.id === pei.id;\n              const isTecnico = c.id === \'MED-INF-02\' || c.id === \'MED-INF-01\';\n              const isSuperior = c.id === \'SUP-BSI-04\';\n\n              return (\n                <button\n                  key={c.id}\n                  onClick={() => onSelectCase(c)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer ${\n                    isCurrent\n                      ? \'bg-slate-900 text-white font-semibold shadow-xs\'\n                      : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n                  }`}\n                >\n                  <span className=\"font-semibold\">{c.cabecalho.estudante.split(\' \')[0]}</span>\n                  <span className=\"text-[10px] ml-1.5 opacity-80\">\n                    {isSuperior ? \'(Superior TI)\' : isTecnico ? \'(M\303\251dio T\303\251cnico)\' : \'(Fundamental)\'}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Active Student Info */}\n        <div className=\"flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6\">\n          {/* Student Profile Block */}\n          <div className=\"flex items-start gap-4 sm:gap-5\">\n            {/* Student Avatar */}\n            <div className=\"relative w-16 h-16 sm:w-20 sm:h-20 rounded-xl bg-gradient-to-br from-emerald-100 to-teal-50 border border-emerald-200 flex items-center justify-center text-emerald-800 font-bold text-2xl shrink-0 overflow-hidden shadow-xs\">\n              <span className=\"select-none font-serif text-3xl\">{getInitial(cabecalho.estudante)}</span>\n              <div className=\"absolute bottom-0 inset-x-0 bg-emerald-900/80 text-[10px] text-white text-center py-0.5 font-medium tracking-tight\">\n                {cabecalho.modulo_periodo.includes(\'Superior\') || cabecalho.modulo_periodo.includes(\'Semestre\')\n                  ? \'SUPERIOR\'\n                  : cabecalho.modulo_periodo.includes(\'T\303\251cnico\')\n                  ? \'T\303\211CNICO\'\n                  : \'ESTUDANTE\'}\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <h1 className=\"text-xl sm:text-2xl font-bold tracking-tight text-slate-900\">\n                  {cabecalho.estudante}\n                </h1>\n                <span className=\"text-xs font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded\">\n                  {cabecalho.codigo_matricula}\n                </span>\n              </div>\n\n              {/* Unboxed Metadata with typographic separators */}\n              <div className=\"flex flex-wrap items-center gap-2 mt-1.5 text-xs text-slate-600\">\n                <span className=\"font-medium text-slate-800\">{cabecalho.modulo_periodo}</span>\n                <span aria-hidden=\"true\" className=\"text-slate-300\">\302\267</span>\n                <span className=\"font-semibold text-emerald-800\">{cabecalho.componente_curricular}</span>\n                <span aria-hidden=\"true\" className=\"text-slate-300\">\302\267</span>\n                <span>{cabecalho.idade}</span>\n                <span aria-hidden=\"true\" className=\"text-slate-300\">\302\267</span>\n                <span className=\"text-emerald-700 font-medium\">Decreto 12.686/2025</span>\n                <span aria-hidden=\"true\" className=\"text-slate-300\">\302\267</span>\n                <span className=\"text-slate-500\">Portaria MEC 421/2026</span>\n              </div>\n\n              {/* Responsible Educators */}\n              <div className=\"flex flex-wrap items-center gap-4 mt-2.5 text-xs text-slate-500\">\n                <div className=\"flex items-center gap-1.5\">\n                  <UserCheck className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  <span>Docente: <strong className=\"text-slate-700 font-medium\">{cabecalho.docente_regente}</strong></span>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <BookOpen className=\"w-3.5 h-3.5 text-teal-600\" />\n                  <span>AEE / NAPNE: <strong className=\"text-slate-700 font-medium\">{cabecalho.docente_aee}</strong></span>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <ShieldCheck className=\"w-3.5 h-3.5 text-slate-500\" />\n                  <span>Apoio: <strong className=\"text-slate-700 font-medium\">{cabecalho.profissional_apoio}</strong></span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* KPI strip (Tabular figures) */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 w-full lg:w-auto border-t lg:border-t-0 pt-4 lg:pt-0 border-slate-100\">\n            <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg\">\n              <span className=\"block text-[11px] font-medium text-slate-500 uppercase tracking-wider\">\n                Metas Conclu\303\255das\n              </span>\n              <div className=\"flex items-baseline gap-1 mt-1\">\n                <span className=\"text-xl font-bold font-mono text-emerald-700 tabular-nums\">\n                  {metricas.percentual_metas_alcancadas}%\n                </span>\n                <span className=\"text-xs text-slate-400\">em evolu\303\247\303\243o</span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg\">\n              <span className=\"block text-[11px] font-medium text-slate-500 uppercase tracking-wider\">\n                \303\215ndice Autonomia\n              </span>\n              <div className=\"flex items-baseline gap-1 mt-1\">\n                <span className=\"text-xl font-bold font-mono text-slate-900 tabular-nums\">\n                  {metricas.nivel_autonomia}/5\n                </span>\n                <span className=\"text-xs text-slate-400\">n\303\255vel t\303\251cnico</span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg\">\n              <span className=\"block text-[11px] font-medium text-slate-500 uppercase tracking-wider\">\n                Engajamento DUA\n              </span>\n              <div className=\"flex items-baseline gap-1 mt-1\">\n                <span className=\"text-xl font-bold font-mono text-teal-700 tabular-nums\">\n                  {metricas.engajamento}/5\n                </span>\n                <span className=\"text-xs text-slate-400\">muito alto</span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg\">\n              <span className=\"block text-[11px] font-medium text-slate-500 uppercase tracking-wider\">\n                Suporte Semanal\n              </span>\n              <div className=\"flex items-baseline gap-1 mt-1\">\n                <span className=\"text-xl font-bold font-mono text-slate-900 tabular-nums\">\n                  {metricas.sessoes_semanais_realizadas}\n                </span>\n                <span className=\"text-xs text-slate-400\">sess\303\265es feitas</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/StudentHeader.tsx"
        }
        overwrite: true
      }
    }
