          end_line: 500
          unified_diff {
            lines {
              text: "import React, { useState } from \'react\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "import { PEICompleto } from \'../types/pei\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "import { Sparkles, Loader2, X, BookOpen, User, CheckCircle2 } from \'lucide-react\';"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "import {"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
