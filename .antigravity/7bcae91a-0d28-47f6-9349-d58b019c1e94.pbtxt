 * 25, 25, 255]);\n\n// 4. Robot Legs & Feet\nfillRoundRect(318, 415, 66, 108, 24, (x, y, nx, ny) => {\n  const s = 230 - nx * 35 - ny * 20;\n  return [s, s - 4, s - 12, 255];\n});\nfillRoundRect(416, 415, 66, 108, 24, (x, y, nx, ny) => {\n  const s = 222 - nx * 35 - ny * 20;\n  return [s, s - 4, s - 12, 255];\n});\n// Feet\nfillRoundRect(310, 495, 78, 38, 18, (x, y, nx, ny) => {\n  const s = 215 - ny * 30;\n  return [s, s - 4, s - 10, 255];\n});\nfillRoundRect(412, 495, 78, 38, 18, (x, y, nx, ny) => {\n  const s = 210 - ny * 30;\n  return [s, s - 4, s - 10, 255];\n});\n\n// 5. Robot Arms (Left & Right)\nfillRoundRect(256, 305, 52, 132, 24, (x, y, nx, ny) => {\n  if (ny > 0.72 && ny < 0.82) return [232, 112, 28, 255]; // orange cuff\n  const s = 232 - nx * 30 - ny * 20;\n  return [s, s - 5, s - 12, 255];\n});\nfillRoundRect(492, 305, 52, 132, 24, (x, y, nx, ny) => {\n  if (ny > 0.72 && ny < 0.82) return [225, 105, 25, 255]; // orange cuff\n  const s = 220 - nx * 30 - ny * 20;\n  return [s, s - 5, s - 12, 255];\n});\n// Shoulder joints\nfillCircle(292, 315, 24, (x, y, nx, ny) => [235 - nx * 25, 230 - ny * 25, 220, 255]);\nfillCircle(280, 312, 9, () => [238, 120, 30, 255]);\nfillCircle(508, 315, 24, (x, y, nx, ny) => [225 - nx * 25, 220 - ny * 25, 210, 255]);\nfillCircle(520, 312, 9, () => [238, 120, 30, 255]);\n\n// 6. Robot Torso (White with Orange Collar & Waist Trim)\nfillRoundRect(302, 282, 196, 152, 46, (x, y, nx, ny) => {\n  // Orange collar ring\n  if (ny < 0.14) return [235, 115, 28, 255];\n  // Orange waist stripe\n  if (ny > 0.73 && ny < 0.81) return [235, 115, 28, 255];\n  const shade = 242 - Math.abs(nx - 0.38) * 42 - ny * 22;\n  return [shade, shade - 3, shade - 11, 255];\n});\n\n// 7. \"IODA\" Text on Chest\n// Draw clean bold letters I O D A centered at y=342..362\nconst letters = [\n  // I\n  [[362, 340, 5, 22]],\n  // O\n  [[375, 340, 18, 4], [375, 358, 18, 4], [375, 340, 4, 22], [389, 340, 4, 22]],\n  // D\n  [[401, 340, 16, 4], [401, 358, 16, 4], [401, 340, 4, 22], [415, 343, 4, 16]],\n  // A\n  [[428, 340, 18, 4], [428, 350, 18, 4], [428, 340, 4, 22], [442, 340, 4, 22]],\n];\nletters.flat().forEach(([lx, ly, lw, lh]) => {\n  fillRoundRect(lx, ly, lw, lh, 1, () => [62, 70, 78, 255]);\n});\n\n// 8. Robot Head (Large rounded 3D head)\nfillRoundRect(290, 96, 220, 186, 84, (x, y, nx, ny) => {\n  const dx = nx - 0.38;\n  const dy = ny - 0.32;\n  const d = Math.sqrt(dx * dx + dy * dy);\n  const s = 248 - d * 52;\n  return [s, s - 3, s - 12, 255];\n});\n\n// 9. Glowing Emerald-Green Eyes (Left & Right)\nfunction drawRobotEye(cx, cy) {\n  // Outer socket rim\n  fillCircle(cx, cy, 39, (x, y, nx, ny) => {\n    const s = 175 + ny * 35;\n    return [s, s + 4, s + 8, 255];\n  });\n  // Dark socket\n  fillCircle(cx, cy, 33, () => [24, 32, 36, 255]);\n  // Glowing emerald iris\n  fillCircle(cx, cy, 27, (x, y, nx, ny, nd) => {\n    const glow = Math.max(0, 1 - Math.abs(nd - 0.72) * 2.5);\n    return [40 + glow * 95, 185 + glow * 70, 95 + glow * 45, 255];\n  });\n  // Dark pupil\n  fillCircle(cx, cy, 15, () => [14, 22, 20, 255]);\n  // Crisp white specular highlights\n  fillCircle(cx - 8, cy - 8, 6.5, () => [255, 255, 255, 245]);\n  fillCircle(cx + 7, cy + 7, 3, () => [210, 255, 230, 210]);\n}\ndrawRobotEye(354, 192);\ndrawRobotEye(448, 192);\n\n// Subtle friendly smile line\nfor (let x = 365; x <= 435; x++) {\n  const dx = (x - 400) / 35;\n  const y = 252 + (1 - dx * dx) * 6;\n  setPixel(x, y, 110, 115, 122, 180);\n  setPixel(x, y + 1, 110, 115, 122, 180);\n}\n\n// Encode PNG\nfunction crc32(buf) {\n  let c = -1;\n  for (let i = 0; i < buf.length; i++) {\n    c = (c >>> 8) ^ crcTable[(c ^ buf[i]) & 0xff];\n  }\n  return (c ^ -1) >>> 0;\n}\nconst crcTable = new Uint32Array(256);\nfor (let n = 0; n < 256; n++) {\n  let c = n;\n  for (let k = 0; k < 8; k++) c = c & 1 ? 0xedb88320 ^ (c >>> 1) : c >>> 1;\n  crcTable[n] = c;\n}\nfunction chunk(type, buf) {\n  const len = Buffer.alloc(4);\n  len.writeUInt32BE(buf.length, 0);\n  const t = Buffer.from(type, \"ascii\");\n  const crc = Buffer.alloc(4);\n  crc.writeUInt32BE(crc32(Buffer.concat([t, buf])), 0);\n  return Buffer.concat([len, t, buf, crc]);\n}\n\nconst raw = Buffer.alloc(H * (W * 4 + 1));\nfor (let y = 0; y < H; y++) {\n  raw[y * (W * 4 + 1)] = 0;\n  data.copy(raw, y * (W * 4 + 1) + 1, y * W * 4, (y + 1) * W * 4);\n}\nconst ihdr = Buffer.alloc(13);\nihdr.writeUInt32BE(W, 0);\nihdr.writeUInt32BE(H, 4);\nihdr[8] = 8;\nihdr[9] = 6;\nconst png = Buffer.concat([\n  Buffer.from([137, 80, 78, 71, 13, 10, 26, 10]),\n  chunk(\"IHDR\", ihdr),\n  chunk(\"IDAT\", zlib.deflateSync(raw)),\n  chunk(\"IEND\", Buffer.alloc(0)),\n]);\nfs.writeFileSync(\"public/assets/ioda-avatar.png\", png);\nconsole.log(\"Saved public/assets/ioda-avatar.png:\", png.length, \"bytes\");\n\'"
