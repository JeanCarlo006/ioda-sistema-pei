            }
            lines {
              text: "      avaliacao_pratica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Quest\303\265es fechadas em escopo com bateria de testes automatizados: passou no teste = nota m\303\241xima garantida naquele item, dando seguran\303\247a objetiva para o aluno avan\303\247ar.\',"
