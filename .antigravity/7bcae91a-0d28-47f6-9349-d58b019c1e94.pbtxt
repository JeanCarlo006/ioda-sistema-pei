      thinking_signature: "\022\226\020\n\223\020\001i\024}\023\217\254\231?h\3603=\344\021\334\345\027\312\004\nE\231\b\223t\250 \000q\357\215!\227\035\005\250\363\342\037\345\312\236\205Y\317\375\306\201\361w\306\024\337\262{#<Fw\265\255Wj7\223\225\024\356i\023\345\366\267\205E\275\203V\323\245\177\224\2715?\373\303j\340\f\003\2525\255\271n\ts\247\342\330\302)7\372\362\343\325\357TnQ\353%>F*\026uQ}\231\225-\241sJ\\3\236\023\375\034\373\336`\372@\213\217\257|\224\246\\_\002\033\225\262\326L\v\342\225\303\210\v\212`[\277X\362\fx\312x\247\r\214J<\211m\241\317\0011\221\211\217\266\356\270\355?,{@\200\273\231\016\263<kg\276\331\3462\377Z\363Vje\205\221\213\332|l\033\334p\177\302\263\356\201h(\240\3307^ey43b\262\002\264\321\2470E\2253`\304\2433~\344\t\037(\217\362\262&@D\207\366\334\243\346C\032\242\222w\bV\343\245\244,\247\306\005\307\262\315E\236\364\330\277\304\a\315c\243\335\256\246>}\357\367\357mE\305\023\371d\262\215\242\222\306\257\233\210\327z\272\331\276\r7S6Q\361\333\321\272\315\304\312\367Fx[\263\375\034\026Mz\243A\372)\215\021\310\360\245\271\311_\005\033\342V\361\337$$\303z\326\277iC\265\037[\265ep\025\207\253v\350\255R\032\274\335\254\021G\r\345q\303\320\374\002\234\330S38\256\2233\"E\272p\372R\031\350\367\357\311\277m\374\n\224\211\031b8\ab\215CUH\327\356v 4=px\245<\021\217\375\'\361\207\017\242na\v2/<\254N\241\364/h/\025\270\205\365\245\217\017u\200\310\204r9\314|\303\242\004H\223j~\250`L]\252~\206\260J\332\353\363\004\ts*\372\213.l\273\267H~\2144<\333E\350\230\002u\325=\315\223P\026w\213\266>\212\231\233w\027aU*;\236Z\031,1\254\022\023\n\214O\302qb\2174\202U@,\vx\322\264:@i\256}\am\237\333\202\371v\220\v\336\331\377RT^H\366f\336\3743\3629\276\313\277\024&\247|\301\301\274\031\215\262a>\353e\306B\023>\377\374\307}\021\226!z\035\320\262\002\313\217\004sT\027l\204!\036\261\200s`R\242\205$\331\372\a\364\024\234[\205\346?i\327\250\274\205\362\247}\326\304\345\347\330\220\210B\337\345\346\032\345\345\376\001y\312C\224}\376\232\303\362\201\225\316\203\261\332\