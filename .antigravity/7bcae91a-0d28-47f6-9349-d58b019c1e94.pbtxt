    end_line: 638
    content: "import express, { Request, Response } from \'express\';\nimport { GoogleGenAI } from \'@google/genai\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst app = express();\nconst port = process.env.PORT || 3000;\n\napp.use(express.json({ limit: \'10mb\' }));\n\n// Initialize Google GenAI client (Server-Side only)\nconst ai = new GoogleGenAI({\n  apiKey: process.env.GEMINI_API_KEY || \'\',\n  httpOptions: {\n    headers: {\n      \'User-Agent\': \'aistudio-build\',\n    },\n  },\n});\n\n// Advanced Ioda Pedagogical Engine for TI (Ensino M\303\251dio T\303\251cnico e Superior)\nfunction synthesizeIodaPei(params: any) {\n  const {\n    studentName = \'Estudante\',\n    grade,\n    course,\n    subject,\n    barriers = \'Dificuldade motora ou visual no laborat\303\263rio de inform\303\241tica\',\n    potentialities = \'Racioc\303\255nio l\303\263gico e dedutivo para tecnologia\',\n    assistiveTech = \'Softwares adaptados e tempo ampliado\',\n    docenteRegente = \'Prof. Respons\303\241vel da Disciplina\',\n    docenteAee = \'Prof\302\252. Renata Cavalcanti (NAPNE \302\267 Campus Para\303\255so)\',\n    perfilModalidade = \'medio_tecnico\',\n    statusDiagnostico = \'confirmado\',\n  } = params;\n\n  const isSuperior =\n    perfilModalidade === \'superior_ti\' ||\n    (course && (\n      course.toLowerCase().includes(\'superior\') ||\n      course.toLowerCase().includes(\'sistemas\') ||\n      course.toLowerCase().includes(\'ci\303\252ncia\') ||\n      course.toLowerCase().includes(\'engenharia\')\n    )) ||\n    (grade && grade.toLowerCase().includes(\'semestre\'));\n\n  const finalCourse = course || (isSuperior\n    ? \'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\'\n    : \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n\n  const finalGrade = grade || (isSuperior ? \'4\302\272 Semestre / Noturno\' : \'2\302\272 Ano / Diurno\');\n  const finalSubject = subject || (isSuperior ? \'Banco de Dados Relacional e SQL\' : \'Programa\303\247\303\243o Web e Algoritmos\');\n\n  const selectedIds: string[] = Array.isArray(params.selectedIds) ? params.selectedIds : [];\n  const selectedNeurodivergences: string[] = Array.isArray(params.selectedNeurodivergences)\n    ? params.selectedNeurodivergences\n    : [];\n  const combinedContext = `${barriers} ${selectedIds.join(\' \')} ${selectedNeurodivergences.join(\' \')}`.toLowerCase();\n\n  const isEngSoft =\n    finalSubject.toLowerCase().includes(\'engenharia de software\') ||\n    finalSubject.toLowerCase().includes(\'bac.0406\') ||\n    finalSubject.toLowerCase().includes(\'qualidade\');\n\n  const isVisual =\n    combinedContext.includes(\'vis\303\243o\') ||\n    combinedContext.includes(\'visual\') ||\n    combinedContext.includes(\'cego\') ||\n    combinedContext.includes(\'cegueira\') ||\n    combinedContext.includes(\'sol-baixa-visao\');\n\n  const isMotor =\n    combinedContext.includes(\'motor\') ||\n    combinedContext.includes(\'digita\') ||\n    combinedContext.includes(\'paralisia\') ||\n    combinedContext.includes(\'espastic\') ||\n    combinedContext.includes(\'m\303\243o\') ||\n    combinedContext.includes(\'punho\') ||\n    combinedContext.includes(\'sol-motora\');\n\n  const isAutism =\n    combinedContext.includes(\'autista\') ||\n    combinedContext.includes(\'autismo\') ||\n    combinedContext.includes(\'tea\') ||\n    combinedContext.includes(\'sensorial\') ||\n    combinedContext.includes(\'ru\303\255do\') ||\n    combinedContext.includes(\'sol-tea\');\n\n  const isAdhd =\n    combinedContext.includes(\'tdah\') ||\n    combinedContext.includes(\'d\303\251ficit de aten\303\247\303\243o\') ||\n    combinedContext.includes(\'hiperativid\') ||\n    combinedContext.includes(\'sol-tdah\');\n\n  const isAnxiety =\n    combinedContext.includes(\'ansied\') ||\n    combinedContext.includes(\'p\303\242nico\') ||\n    combinedContext.includes(\'f\303\263bic\') ||\n    combinedContext.includes(\'sol-ansiedade\') ||\n    combinedContext.includes(\'sol-misto-ansioso-depressivo\');\n\n  const isLearning =\n    combinedContext.includes(\'dislex\') ||\n    combinedContext.includes(\'disgraf\') ||\n    combinedContext.includes(\'discalcul\') ||\n    combinedContext.includes(\'aprendizagem\') ||\n    combinedContext.includes(\'sol-aprendizagem\');\n\n  const isIntellectual =\n    combinedContext.includes(\'intelectual\') ||\n    combinedContext.includes(\'desenvolvimento intelectual\') ||\n    combinedContext.includes(\'sol-def-intelectual\');\n\n  const isOCD =\n    combinedContext.includes(\'toc\') ||\n    combinedContext.includes(\'obsessiv\') ||\n    combinedContext.includes(\'compulsiv\') ||\n    combinedContext.includes(\'sol-toc\');\n\n  const isDepression =\n    combinedContext.includes(\'depress\') ||\n    combinedContext.includes(\'anedonia\') ||\n    combinedContext.includes(\'sol-depressao\') ||\n    combinedContext.includes(\'sol-misto-ansioso-depressivo\');\n\n  const isEpilepsy =\n    combinedContext.includes(\'epilep\') ||\n    combinedContext.includes(\'convuls\') ||\n    combinedContext.includes(\'crise\') ||\n    combinedContext.includes(\'sol-epilepsia\');\n\n  // Dynamic cumulative DUA 3.0 recommendations tailored for ALL selected neurodivergences\n  const engajamento: string[] = [];\n  if (isEngSoft) {\n    engajamento.push(\n      \'Metodologia \303\241gil com ciclos curtos de teste (TDD red-green-refactor) e rastreamento visual de tarefas e bugs no Jira / GitHub Projects (Plano de Ensino BAC.0406).\'\n    );\n  } else {\n    engajamento.push(\n      isSuperior\n        ? \'Contextualiza\303\247\303\243o em problemas corporativos reais de engenharia de software, modelagem de dados e arquitetura de sistemas do PPC do BSI.\'\n        : \'Projetos pr\303\241ticos de desenvolvimento integrados \303\240 forma\303\247\303\243o t\303\251cnica e comunit\303\241ria no IFTO Campus Para\303\255so.\'\n    );\n  }\n\n  if (isAdhd) {\n    engajamento.push(\n      \'TDAH: Divis\303\243o das atividades de laborat\303\263rio (LABIN/LADES) em micro-sprints com t\303\251cnica Pomodoro (25min foco / 5min pausa) e entregas graduais.\'\n    );\n  }\n  if (isAutism) {\n    engajamento.push(\n      \'TEA: Previsibilidade com cronograma semanal antecipado no Moodle, rotina met\303\263dica de testes, pap\303\251is t\303\251cnicos definidos e cart\303\243o de pausa sensorial.\'\n    );\n  }\n  if (isAnxiety) {\n    engajamento.push(\n      \'Ansiedade: Ambiente de laborat\303\263rio acolhedor, substitui\303\247\303\243o de defesas orais abertas por v\303\255deos curtos (Loom) ou banca reservada e rubricas anal\303\255ticas pr\303\251vias.\'\n    );\n  }\n  if (isOCD) {\n    engajamento.push(\n      \'TOC: Crit\303\251rios expl\303\255citos de aceite (Definition of Done) para interromper refatora\303\247\303\265es excessivas com valida\303\247\303\243o autom\303\241tica por pipeline de CI/CD.\'\n    );\n  }\n  if (isDepression) {\n    engajamento.push(\n      \'Humor/Depress\303\243o: Acolhimento cont\303\255nuo com metas graduais de recomposi\303\247\303\243o da autoefic\303\241cia, acesso ass\303\255ncrono ao Moodle e duplas colaborativas.\'\n    );\n  }\n  if (isEpilepsy) {\n    engajamento.push(\n      \'Epilepsia: Ambiente calmo sem sobrecarga de estresse temporal, pausas a cada 45 minutos e protocolo de seguran\303\247a alinhado.\'\n    );\n  }\n  if (isLearning) {\n    engajamento.push(\n      \'Aprendizagem (Dislexia/Disgrafia/Discalculia): Acolhimento que remove puni\303\247\303\243o por erros sint\303\241ticos de digita\303\247\303\243o, valorizando o racioc\303\255nio algor\303\255tmico.\'\n    );\n  }\n  if (isIntellectual) {\n    engajamento.push(\n      \'Desenvolvimento Intelectual: Media\303\247\303\243o assistida de monitor de TI, desafios contextualizados e valoriza\303\247\303\243o imediata de cada etapa conclu\303\255da.\'\n    );\n  }\n  if (isMotor) {\n    engajamento.push(\n      \'Motora: Metodologia de Pair Programming com rod\303\255zio orientado (estudante atua como arquiteto da l\303\263gica e dos casos de teste).\'\n    );\n  }\n  engajamento.push(\n    \'Sess\303\265es de alinhamento cont\303\255nuo com a coordena\303\247\303\243o pedag\303\263gica do NAPNE e docente regente no Campus Para\303\255so.\'\n  );\n\n  const representacao: string[] = [];\n  if (isEngSoft) {\n    representacao.push(\n      \'Disponibiliza\303\247\303\243o antecipada no Moodle de modelos de planos de teste (IEEE 829), especifica\303\247\303\265es de casos de teste e su\303\255tes JUnit/Selenium comentadas.\'\n    );\n  } else {\n    representacao.push(\n      \'Disponibiliza\303\247\303\243o antecipada de roteiros de laborat\303\263rio em formato Markdown acess\303\255vel e snippets de c\303\263digo comentados.\'\n    );\n  }\n  if (isLearning) {\n    representacao.push(\n      \'Aprendizagem: Instala\303\247\303\243o de fontes acess\303\255veis (OpenDyslexic Mono / JetBrains Mono) na IDE e enunciados em tabelas limpas de casos de teste (Input / Output).\'\n    );\n  }\n  if (isAutism || isOCD) {\n    representacao.push(\n      \'TEA / TOC: Roteiros de laborat\303\263rio passo a passo com crit\303\251rios de aceite objetivos e linguagem direta sem ambiguidades.\'\n    );\n  }\n  if (isAdhd) {\n    representacao.push(\n      \'TDAH: Instru\303\247\303\265es fracionadas em checklists interativos com destaque visual das entregas priorit\303\241rias e linters em tempo real.\'\n    );\n  }\n  if (isVisual) {\n    representacao.push(\n      \'Visual: Substitui\303\247\303\243o obrigat\303\263ria de diagramas rasterizados por representa\303\247\303\265es textuais estruturadas acess\303\255veis ao leitor NVDA (scripts DDL, DBML, YAML e Mermaid).\'\n    );\n  }\n  if (isIntellectual) {\n    representacao.push(\n      \'Desenvolvimento Intelectual: Fracionamento de conceitos abstratos em blocos curtos (2 a 3 passos) ilustrados com fluxogramas visuais.\'\n    );\n  }\n  if (isEpilepsy) {\n    representacao.push(\n      \'Epilepsia: Monitores com taxa de atualiza\303\247\303\243o est\303\241vel (60Hz+), filtros antirreflexo e temas de IDE sem contrastes estrobosc\303\263picos ou flashes.\'\n    );\n  }\n  if (representacao.length < 3) {\n    representacao.push(\n      \'Diagrama\303\247\303\243o visual de arquiteturas e algoritmos com casos de teste exemplificados em tabelas claras.\'\n    );\n  }\n\n  const acaoExpressao: string[] = [];\n  if (isAnxiety || isDepression) {\n    acaoExpressao.push(\n      \'Op\303\247\303\243o de grava\303\247\303\243o de v\303\255deo/screencast curto (Loom) ou apresenta\303\247\303\243o individual ao docente em substitui\303\247\303\243o a exposi\303\247\303\265es orais para toda a turma.\'\n    );\n  }\n  if (isAdhd || isAutism) {\n    acaoExpressao.push(\n      \'Entregas cont\303\255nuas fracionadas por sprint no GitHub/Jira em substitui\303\247\303\243o a avalia\303\247\303\265es \303\272nicas extensas, com uso de templates estruturados.\'\n    );\n  }\n  if (isVisual) {\n    acaoExpressao.push(\n      \'Intera\303\247\303\243o com banco de dados e servidores via terminal de linha de comando (CLI/SSH) acess\303\255vel ao NVDA.\'\n    );\n  }\n  if (isMotor) {\n    acaoExpressao.push(\n      \'Uso de teclado mec\303\242nico ergon\303\264mico de ativa\303\247\303\243o leve, atalhos de IDE e ferramentas de autocompletar inteligente.\'\n    );\n  }\n  if (isEngSoft) {\n    acaoExpressao.push(\n      \'Entrega pr\303\241tica de su\303\255tes de testes automatizados (JUnit/Selenium) e relat\303\263rios de bugs no Jira com avalia\303\247\303\243o formativa.\'\n    );\n  } else {\n    acaoExpressao.push(\n      \'Demonstra\303\247\303\243o de compet\303\252ncia por meio de reposit\303\263rio Git com commits sem\303\242nticos e defesa t\303\251cnica guiada.\'\n    );\n  }\n  acaoExpressao.push(\n    \'Tempo estendido (+50%) assegurado em todas as avalia\303\247\303\265es pr\303\241ticas de programa\303\247\303\243o, testes e modelagem de software.\'\n  );\n\n  // Assistive Technology suggestions combined across all selected conditions\n  const taList: string[] = [];\n  if (isAdhd) {\n    taList.push(\'Quadro Kanban integrado ao Jira / GitHub Projects e temporizador Pomodoro\');\n  }\n  if (isAutism) {\n    taList.push(\'Abafador de ru\303\255dos circum-aural (27dB+) e cart\303\243o de pausa sensorial para uso no LABIN\');\n  }\n  if (isAnxiety || isDepression) {\n    taList.push(\'Ferramenta de grava\303\247\303\243o de tela Loom e rubricas anal\303\255ticas antecipadas no Moodle\');\n  }\n  if (isLearning) {\n    taList.push(\'Fontes especializadas (OpenDyslexic Mono) e linters visuais no VS Code (Error Lens)\');\n  }\n  if (isOCD) {\n    taList.push(\'Checklists automatizados de Definition of Done (DoD) e pipelines CI/CD no GitHub Actions\');\n  }\n  if (isEpilepsy) {\n    taList.push(\'Monitor LCD/LED 60Hz+ antirreflexo e tema de IDE com contraste suave sem anima\303\247\303\265es piscantes\');\n  }\n  if (isIntellectual) {\n    taList.push(\'Templates de c\303\263digo pr\303\251-estruturados (scaffolding) e ambiente visual de depura\303\247\303\243o passo a passo\');\n  }\n  if (isVisual) {\n    taList.push(\'Leitor de telas NVDA configurado com sintetizador em portugu\303\252s e terminal CLI acess\303\255vel\');\n  }\n  if (isMotor) {\n    taList.push(\'Teclado mec\303\242nico com apoio de punho regul\303\241vel e mouse vertical ergon\303\264mico\');\n  }\n  if (isEngSoft) {\n    taList.push(\'Frameworks de automa\303\247\303\243o de testes (JUnit, Selenium) e rastreamento de defeitos (Jira)\');\n  }\n  taList.push(\'Tempo estendido (+50%) assegurado em avalia\303\247\303\265es pr\303\241ticas de computa\303\247\303\243o\');\n  taList.push(\'Bancada de laborat\303\263rio acess\303\255vel nos laborat\303\263rios LABIN 1/2/3 e LADES do Campus Para\303\255so\');\n\n  // Specific SMART goals tailored for modality, discipline, and combined neurodivergences\n  const metas: any[] = [\n    {\n      id_meta: \'M1\',\n      descricao_meta: isEngSoft\n        ? `Aplicar t\303\251cnicas de teste de software (caixa-preta, parti\303\247\303\243o de equival\303\252ncia e ciclo TDD red-green-refactor) na implementa\303\247\303\243o de su\303\255tes de testes automatizados com apoio de TA.`\n        : `Compreender e implementar as estruturas pr\303\241ticas de ${finalSubject} utilizando ferramentas de acessibilidade configuradas e controle de vers\303\243o no Git.`,\n      prazo: \'Mensal (4 semanas)\',\n      indicador_sucesso: isEngSoft\n        ? \'Su\303\255te de testes automatizados funcional com cobertura de c\303\263digo documentada no GitHub/Jira.\'\n        : \'Reposit\303\263rio contendo c\303\263digo funcional, scripts documentados e valida\303\247\303\243o t\303\251cnica em laborat\303\263rio.\',\n      progresso_percentual: 50,\n      status: \'em_andamento\',\n    },\n    {\n      id_meta: \'M2\',\n      descricao_meta: isEngSoft\n        ? `Elaborar plano de testes e gerenciar o ciclo de defeitos em ferramenta de bug tracking (Jira/Bugzilla) em equipe \303\241gil com vias de apresenta\303\247\303\243o acess\303\255veis.`\n        : `Desenvolver projeto pr\303\241tico colaborativo aplicando as diretrizes do DUA 3.0 com entregas graduais e sustenta\303\247\303\243o t\303\251cnica acess\303\255vel.`,\n      prazo: \'Bimestral (8 semanas)\',\n      indicador_sucesso: isEngSoft\n        ? \'Entrega de plano de testes completo com casos documentados e rastreabilidade entre requisitos e defeitos.\'\n        : \'Entrega dos m\303\263dulos de software testados e validados com documenta\303\247\303\243o clara.\',\n      progresso_percentual: 35,\n      status: \'em_andamento\',\n    },\n  ];\n\n  if (isAutism && isAdhd) {\n    metas.push({\n      id_meta: \'M3\',\n      descricao_meta:\n        \'Consolidar rotina combinada de autorregula\303\247\303\243o sensorial (uso de abafador e roteiros previs\303\255veis para TEA) e autogest\303\243o executiva por micro-sprints (Pomodoro e Kanban para TDAH) durante os laborat\303\263rios pr\303\241ticos.\',\n      prazo: \'Semestral (12 semanas)\',\n      indicador_sucesso:\n        \'Conclus\303\243o de 85% das micro-entregas semanais sem sobrecarga sensorial ou bloqueio executivo nos laborat\303\263rios LABIN/LADES.\',\n      progresso_percentual: 40,\n      status: \'em_andamento\',\n    });\n  } else if (selectedNeurodivergences.length > 1) {\n    metas.push({\n      id_meta: \'M3\',\n      descricao_meta: `Integrar os apoios de Tecnologia Assistiva e flexibiliza\303\247\303\265es de tempo/espa\303\247o para atender conjuntamente \303\240s necessidades de ${selectedNeurodivergences.join(\' + \')}.`,\n      prazo: \'Semestral (12 semanas)\',\n      indicador_sucesso:\n        \'Participa\303\247\303\243o aut\303\264noma e segura nas atividades avaliativas com alcance pleno dos objetivos t\303\251cnicos da ementa.\',\n      progresso_percentual: 40,\n      status: \'em_andamento\',\n    });\n  }\n\n  return {\n    cabecalho: {\n      estudante: studentName,\n      codigo_matricula: `TI-${Math.floor(1000 + Math.random() * 9000)}`,\n      idade: params.age || (isSuperior ? \'21 anos\' : \'17 anos\'),\n      curso: finalCourse,\n      componente_curricular: finalSubject,\n      modulo_periodo: finalGrade,\n      data_elaboracao: new Date().toISOString().split(\'T\')[0],\n      docente_regente: docenteRegente,\n      docente_aee: docenteAee,\n      profissional_apoio: isSuperior ? \'Monitor de Acessibilidade Digital\' : \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\n      coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n    },\n    historico_e_condicao_napne: {\n      breve_historico_clinico_familiar: `Estudante matriculado no ${finalCourse} no Campus Para\303\255so (${isSuperior ? \'Ensino Superior em TI\' : \'Ensino M\303\251dio T\303\251cnico Integrado\'}). Acompanhado pelo NAPNE com foco na garantia do direito \303\240 educa\303\247\303\243o inclusiva e acessibilidade curricular nos termos da PNEEI (Decreto n\302\272 12.686/2025) e Portaria MEC n\302\272 421/2026.${\n        statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \' Atendimento garantido sem depend\303\252ncia de laudo m\303\251dico pericial pr\303\251vio (investiga\303\247\303\243o pedag\303\263gica pelo NAPNE).\'\n          : \'\'\n      }`,\n      descricao_condicao_especifica: barriers,\n      informacoes_dos_pais: isSuperior\n        ? \'Estudante com autonomia acad\303\252mica universit\303\241ria em contato com o NAPNE e coordena\303\247\303\243o do curso.\'\n        : \'Estudante e respons\303\241veis em contato constante com o NAPNE Campus Para\303\255so e coordena\303\247\303\243o do curso.\',\n    },\n    estudo_de_caso_sintese: {\n      barreiras_identificadas: [\n        `Barreiras Metodol\303\263gicas: Aulas pr\303\241ticas de ${finalSubject} com formato tradicional sem diversifica\303\247\303\243o de vias DUA 3.0.`,\n        `Barreiras Tecnol\303\263gicas: Computadores de laborat\303\263rio sem perfil pr\303\251vio de acessibilidade para a condi\303\247\303\243o do estudante.`,\n        `Barreiras Atitudinais: Risco de pressupostos capacitistas sobre a capacidade de desenvolvimento t\303\251cnico em ${isSuperior ? \'n\303\255vel superior\' : \'n\303\255vel m\303\251dio integrado\'}.`,\n      ],\n      potencialidades_interesses: [\n        potentialities,\n        `Capacidade de racioc\303\255nio dedutivo e pensamento computacional quando garantidos os apoios necess\303\241rios para ${isSuperior ? \'projetos complexos de TI\' : \'o aprendizado pr\303\241tico de TI\'}.`,\n        \'Excelente coopera\303\247\303\243o em metodologias ativas com pap\303\251is t\303\251cnicos definidos.\',\n      ],\n      recursos_tecnologia_assistiva: taList,\n    },\n    planejamento_pedagogico_pei: {\n      conteudo_ementa_oficial: `Ementa Oficial do Componente Curricular: ${finalSubject}. Conte\303\272dos te\303\263ricos e desenvolvimento de aplica\303\247\303\265es pr\303\241ticas no ${finalCourse}.`,\n      competencias_habilidades_ementa: `Desenvolver compet\303\252ncias de an\303\241lise, modelagem e codifica\303\247\303\243o em ${finalSubject}, aplicando boas pr\303\241ticas de desenvolvimento de software e pensamento computacional.`,\n      adaptacao_flexibilizacao_curricular:\n        `Garantia do curr\303\255culo de TI pleno (${isSuperior ? \'Superior\' : \'M\303\251dio T\303\251cnico\'}) sem rebaixamento de conte\303\272dos. Acessibiliza\303\247\303\243o assegurada pela diversifica\303\247\303\243o das vias de representa\303\247\303\243o, engajamento e de a\303\247\303\243o t\303\251cnica.`,\n      objetivos_e_metas_adaptadas: metas,\n      flexibilizacao_metodologica_dua: {\n        engajamento,\n        representacao,\n        acao_e_expressao: acaoExpressao,\n      },\n      gestao_sala_de_aula: [\n        \'Bancada de laborat\303\263rio reservada com layout ergon\303\264mico e ferramentas de acessibilidade instaladas.\',\n        \'Pausas programadas a cada 45-60 minutos para preven\303\247\303\243o de fadiga f\303\255sica, visual ou cognitiva.\',\n        \'Sess\303\265es de suporte semanais garantidas na carga hor\303\241ria docente entre o professor t\303\251cnico e o NAPNE Campus Para\303\255so.\',\n      ],\n      estrategias_de_avaliacao: {\n        formato_acessivel:\n          \'Avalia\303\247\303\243o formativa processual com entregas graduais no Git, testes pr\303\241ticos em laborat\303\263rio e tempo estendido (+50%).\',\n        criterio_de_sucesso: \'Compreens\303\243o substantiva da l\303\263gica e capacidade de aplica\303\247\303\243o pr\303\241tica na disciplina.\',\n      },\n    },\n    painel_de_acompanhamento: {\n      status_periodo: \'EM_ANDAMENTO\',\n      metricas_grafico: {\n        percentual_metas_alcancadas: 45,\n        nivel_autonomia_1_a_5: 4,\n        engajamento_nas_atividades_1_a_5: 5,\n      },\n      parecer_pedagogico: `PEI estruturado pelo agente Ioda em estrita conformidade com a Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025 para assegurar a perman\303\252ncia e \303\252xito em ${finalCourse}.`,\n      sugestoes_proximo_ciclo: [\n        \'Manter reuni\303\265es semanais de suporte entre a equipe t\303\251cnica e o NAPNE Campus Para\303\255so.\',\n        `Avan\303\247ar para projeto pr\303\241tico integrador de ${isSuperior ? \'n\303\255vel superior\' : \'n\303\255vel m\303\251dio t\303\251cnico\'} no per\303\255odo seguinte.`,\n      ],\n    },\n  };\n}\n\n// Track quota cooldown to prevent repeated 429 errors\nlet quotaCooldownUntil = 0;\n\nfunction isQuotaOnCooldown(): boolean {\n  return Date.now() < quotaCooldownUntil;\n}\n\nfunction triggerQuotaCooldown(durationMs = 300000) {\n  quotaCooldownUntil = Date.now() + durationMs;\n}\n\n// API Route: Generate PEI with Ioda AI\napp.post(\'/api/gemini/generate-pei\', async (req: Request, res: Response) => {\n  res.setHeader(\'Content-Type\', \'application/json\');\n\n  try {\n    const {\n      studentName,\n      grade,\n      course,\n      subject,\n      barriers,\n      potentialities,\n      assistiveTech,\n      perfilModalidade = \'medio_tecnico\',\n      statusDiagnostico = \'confirmado\',\n    } = req.body;\n\n    const isSuperior =\n      perfilModalidade === \'superior_ti\' ||\n      (course && course.toLowerCase().includes(\'superior\'));\n\n    // Check if API key is not configured or currently on quota cooldown\n    if (!process.env.GEMINI_API_KEY || isQuotaOnCooldown()) {\n      console.log(\'[Ioda Engine] Utilizando Motor Pedag\303\263gico Ioda DUA 3.0 com benchmark de TI.\');\n      const synthesized = synthesizeIodaPei(req.body);\n      return res.json({\n        success: true,\n        data: synthesized,\n        isIodaEngine: true,\n        notice: `PEI estruturado pelo Motor Pedag\303\263gico Ioda (DUA 3.0 \302\267 ${isSuperior ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\'})`,\n      });\n    }\n\n    const modalityGuidelines = isSuperior\n      ? `PERFIL SELECIONADO: ENSINO SUPERIOR EM TI (Bacharelado / Tecnologia em Sistemas de Informa\303\247\303\243o - 14 estudantes no Campus Para\303\255so).\nCasos de Refer\303\252ncia Reais do Campus:\n- Beatriz Sales Guimar\303\243es (Baixa Vis\303\243o Severa \302\267 Banco de Dados Relacional e SQL): uso de terminal CLI acess\303\255vel, scripts DDL e modelos relacionais em texto (DBML/YAML) sem depend\303\252ncia de diagramas visuais rasterizados, NVDA, tempo estendido (+50%).\n- Larissa de Moura Toledo (TDAH + Altas Habilidades/Superdota\303\247\303\243o \302\267 Engenharia de Software): gest\303\243o \303\241gil via Kanban/GitHub Projects com micro-sprints, enriquecimento curricular avan\303\247ado, autonomia universit\303\241ria e rubricas anal\303\255ticas.\nDiretrizes Pedag\303\263gicas para Superior em TI:\n- Foco em autonomia acad\303\252mica, racioc\303\255nio l\303\263gico avan\303\247ado e arquitetura de software.\n- Instrumentos de avalia\303\247\303\243o: entregas cont\303\255nuas em reposit\303\263rio Git, sustenta\303\247\303\243o oral das decis\303\265es arquiteturais e avalia\303\247\303\265es pr\303\241ticas baseadas em projetos com tempo estendido (+50%).`\n      : `PERFIL SELECIONADO: ENSINO M\303\211DIO T\303\211CNICO INTEGRADO EM INFORM\303\201TICA (15 estudantes no Campus Para\303\255so).\nCasos de Refer\303\252ncia Reais do Campus:\n- Lucas Ferreira de Lima (Paralisia Cerebral / Coordena\303\247\303\243o Fina \302\267 Programa\303\247\303\243o Web e Algoritmos II): Pair Programming orientado (piloto/copiloto), VS Code com tema e atalhos ergon\303\264micos, tempo estendido (+50%) sem empobrecimento curricular.\n- Matheus Albuquerque (TEA / Sensorial \302\267 Redes de Computadores e SO): abafador circum-aural no laborat\303\263rio de redes, rotina estruturada de comandos de terminal, instru\303\247\303\265es diretas sem duplo sentido.\n- Cau\303\243 Ribeiro Fontes (Sem Laudo / Hip\303\263tese Diagn\303\263stica em Investiga\303\247\303\243o \302\267 L\303\263gica de Programa\303\247\303\243o): garantia legal da Portaria MEC n\302\272 421/2026, enunciados fracionados com casos de teste em tabelas (Input/Output).\nDiretrizes Pedag\303\263gicas para M\303\251dio T\303\251cnico em TI:\n- Forma\303\247\303\243o Profissional T\303\251cnica articulada \303\240 BNCC.\n- Acomoda\303\247\303\265es de laborat\303\263rio de inform\303\241tica: duplas colaborativas, roteiros passo a passo em Markdown, acompanhamento de monitoria e garantia de perman\303\252ncia e \303\252xito.`;\n\n    const systemPrompt = `Voc\303\252 \303\251 o agente Ioda (Inclusion on Diversity Agent), especialista s\303\252nior em Educa\303\247\303\243o Especial Inclusiva do Brasil e NAPNE, focado em Tecnologia da Informa\303\247\303\243o (TI).\nLegisla\303\247\303\243o e Refer\303\252ncias:\n- Decreto n\302\272 12.686/2025 e Decreto n\302\272 12.773/2025 (PNEEI)\n- Portaria MEC n\302\272 421/2026 (arts. 7\302\272, 10 e 11) - O PEI N\303\203O depende de laudo m\303\251dico pericial.\n- DUA 3.0 (CAST 2024): Engajamento, Representa\303\247\303\243o, A\303\247\303\243o e Express\303\243o.\n- Princ\303\255pio Inegoci\303\241vel: O curr\303\255culo de TI deve ser acess\303\255vel sem empobrecimento ou rebaixamento cognitivo.\n\n${modalityGuidelines}\n\nRetorne estritamente um JSON estruturado com:\n{\n  \"cabecalho\": { \"estudante\": \"\", \"codigo_matricula\": \"\", \"idade\": \"\", \"curso\": \"\", \"componente_curricular\": \"\", \"modulo_periodo\": \"\", \"docente_regente\": \"\", \"docente_aee\": \"\" },\n  \"historico_e_condicao_napne\": { \"breve_historico_clinico_familiar\": \"\", \"descricao_condicao_especifica\": \"\", \"informacoes_dos_pais\": \"\" },\n  \"estudo_de_caso_sintese\": { \"barreiras_identificadas\": [], \"potencialidades_interesses\": [], \"recursos_tecnologia_assistiva\": [] },\n  \"planejamento_pedagogico_pei\": {\n    \"conteudo_ementa_oficial\": \"\",\n    \"competencias_habilidades_ementa\": \"\",\n    \"adaptacao_flexibilizacao_curricular\": \"\",\n    \"objetivos_e_metas_adaptadas\": [{ \"id_meta\": \"M1\", \"descricao_meta\": \"\", \"prazo\": \"\", \"indicador_sucesso\": \"\" }],\n    \"flexibilizacao_metodologica_dua\": { \"engajamento\": [], \"representacao\": [], \"acao_e_expressao\": [] },\n    \"gestao_sala_de_aula\": [],\n    \"estrategias_de_avaliacao\": { \"formato_acessivel\": \"\", \"criterio_de_sucesso\": \"\" }\n  },\n  \"painel_de_acompanhamento\": { \"status_periodo\": \"EM_ANDAMENTO\", \"parecer_pedagogico\": \"\", \"sugestoes_proximo_ciclo\": [] }\n}`;\n\n    const neuroList = Array.isArray(req.body?.selectedNeurodivergences) && req.body.selectedNeurodivergences.length > 0\n      ? req.body.selectedNeurodivergences.join(\' + \')\n      : \'Neurodiverg\303\252ncia / Condi\303\247\303\243o espec\303\255fica\';\n\n    const userPrompt = `Gere o PEI completo pelo agente Ioda para o perfil ${isSuperior ? \'SUPERIOR EM TI\' : \'M\303\211DIO T\303\211CNICO EM INFORM\303\201TICA\'}:\nAluno: ${studentName || \'Estudante\'}\nN\303\255vel / Modalidade: ${isSuperior ? \'Ensino Superior em TI\' : \'Ensino M\303\251dio T\303\251cnico Integrado em Inform\303\241tica\'}\nCurso: ${course || (isSuperior ? \'Bacharelado em Sistemas de Informa\303\247\303\243o\' : \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\')} (${grade || (isSuperior ? \'4\302\272 Semestre\' : \'2\302\272 Ano\')})\nDisciplina de TI: ${subject || (isSuperior ? \'Banco de Dados Relacional e SQL\' : \'Programa\303\247\303\243o Web e Algoritmos\')}\nSitua\303\247\303\243o Diagn\303\263stica: ${statusDiagnostico === \'em_investigacao_hipotese\' ? \'Sem Laudo / Hip\303\263tese em Investiga\303\247\303\243o (Portaria MEC n\302\272 421/2026)\' : \'Diagn\303\263stico Confirmado no NAPNE\'}\nNeurodiverg\303\252ncias Selecionadas (Comorbidade / M\303\272ltiplas): ${neuroList} (ATEN\303\207\303\203O: Se houver mais de uma neurodiverg\303\252ncia, adapte as estrat\303\251gias DUA 3.0, recursos de TA e metas SMART para contemplar simultaneamente todas as condi\303\247\303\265es informadas)\nCondi\303\247\303\243o e Barreiras: ${barriers || \'Dificuldades no laborat\303\263rio de inform\303\241tica\'}\nPotencialidades: ${potentialities || \'Racioc\303\255nio l\303\263gico e dedutivo para tecnologia\'}\nRecursos de TA pr\303\251vios: ${assistiveTech || \'Softwares de acessibilidade e tempo ampliado (+50%)\'}`;\n\n    // Attempt Gemini call with quick timeout\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() => controller.abort(), 8000);\n\n    try {\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.8-flash\',\n        contents: userPrompt,\n        config: {\n          systemInstruction: systemPrompt,\n        },\n      });\n      clearTimeout(timeoutId);\n\n      const outputText = response.text || \'\';\n      const groundingChunks = response.candidates?.[0]?.groundingMetadata?.groundingChunks || [];\n\n      // Extract JSON if wrapped in markdown blocks\n      let jsonStr = outputText.trim();\n      if (jsonStr.includes(\'```json\')) {\n        jsonStr = jsonStr.split(\'```json\')[1].split(\'```\')[0].trim();\n      } else if (jsonStr.includes(\'```\')) {\n        jsonStr = jsonStr.split(\'```\')[1].split(\'```\')[0].trim();\n      }\n\n      if (jsonStr.startsWith(\'{\')) {\n        const parsed = JSON.parse(jsonStr);\n        return res.json({\n          success: true,\n          data: parsed,\n          groundingChunks,\n          isAiGenerated: true,\n        });\n      } else {\n        throw new Error(\'Retorno sem JSON\');\n      }\n    } catch (genError: any) {\n      clearTimeout(timeoutId);\n      const isQuotaError =\n        genError?.status === 429 ||\n        genError?.code === 429 ||\n        `${genError?.message}`.includes(\'429\') ||\n        `${genError?.message}`.includes(\'quota\') ||\n        `${genError?.message}`.includes(\'RESOURCE_EXHAUSTED\');\n\n      if (isQuotaError) {\n        triggerQuotaCooldown(300000); // 5 min cooldown on quota exhaustion\n        console.log(\'[Ioda Pedagogical Engine] Cota de API de IA atingida. Ativando Motor Pedag\303\263gico Ioda DUA 3.0 com benchmark de TI.\');\n      } else {\n        console.log(\'[Ioda Pedagogical Engine] Ativando Motor Pedag\303\263gico Ioda para sintetizar o PEI com excel\303\252ncia curricular.\');\n      }\n\n      const synthesized = synthesizeIodaPei(req.body);\n      return res.json({\n        success: true,\n        data: synthesized,\n        isIodaEngine: true,\n        notice: `PEI estruturado pelo Motor Pedag\303\263gico Ioda (DUA 3.0 \302\267 ${isSuperior ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\'})`,\n      });\n    }\n  } catch (_error: any) {\n    console.log(\'[Ioda Server] Requisi\303\247\303\243o tratada pelo motor pedag\303\263gico resiliente.\');\n    const fallbackData = synthesizeIodaPei(req.body || {});\n    return res.json({\n      success: true,\n      data: fallbackData,\n      isIodaEngine: true,\n      notice: \'Recupera\303\247\303\243o autom\303\241tica do PEI efetuada com sucesso.\',\n    });\n  }\n});\n\n// Setup Vite middleware in dev or serve static files in production\nasync function startServer() {\n  if (process.env.NODE_ENV !== \'production\') {\n    const { createServer } = await import(\'vite\');\n    const vite = await createServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    app.use(express.static(path.join(__dirname, \'dist\')));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.join(__dirname, \'dist\', \'index.html\'));\n    });\n  }\n\n  app.listen(port, () => {\n    console.log(`Server running on port ${port}`);\n  });\n}\n\nstartServer();\n"
