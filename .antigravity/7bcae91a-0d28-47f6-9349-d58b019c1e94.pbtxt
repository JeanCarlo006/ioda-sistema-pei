      thinking_signature: "\022\243\005\n\240\005\001i\024}\023f\231\260BD\300I\347q\232\324^\n\021\030\267M\316\333\303\267\333\253\355f\3449B\254\225\225\017\364\277\261\016\322\0233\001q)q\312\005/h*\034.\r\314Do\241\"c\035\3547\372\347?Y9\265W+$\264\225\3177-\263\201Wc/C\302\022{\242\221cM\330\210A_\001\004K\214\020\373\2575\036\212zl\002R\272\230\322\210\026\335\356\356F\000\205\230\"\232\334{f\334\356\031\016r\216\254\276\033\371\201v<\005\217\246_\023\255\257[8\321\202\354E\317\354-\233%SW\260\305\347\377\222\3424g\215B\315CH\265\316\331\344=p\357]Q[\300\304\265\307Ad\311\205-\325\332\020\370\274\356F\370\226\273\301\327\220\024M\320\247\240(\t\b\271\374\035\024\267JnP\342\205\374UE1\307\000m|\247\314\226\204\366\325\217.\300\216\352\022\277\325J\204}4\326,n\001\365\301\250f_-\324 \316W\221N/\334f2\220x6m\374yN\336\334\035\376J\374\203\2644\217b\327P\204\264\331\275\277\023K\320\310p\226\a\243\017J7\314\274\244a\351\202\211\276\321X`\005\031W\307\315\264\265\344\274\315\002T\237XT\271O\333\341\'\'\335\225p\032cy\213\340e\243\230\200\375!u\365\202\277uk\327\006^\347\210\206\250|=\n\3117\3601iX\354V\221\036q\303=[\237\260\317\355\004K\242b\352\311{\257X\204\222\315-g\303\bCu\031\037\035)-\277\000(\037\332\234\352\234\320x7\"#\243\035\030\300\203\202\357\030)w\330u\254>\347\222\277\300\177\267\240\367s\250\256\305U\345\025\244ofu\237\322\201l\230VU\237q\205\335\3034\364\273\227p\360\343\024=t\206\334bki\214\316VQ;\306\3654\341JZ\215p\2422bD\025\006\204e\017\237\214\267\213\246M\323S\254v\006\275\222\362w\337\363>\322\303\v\344\210;\211dp#\362\361]M\031K*;\354-\2316\275\006\316j\330kc\364\026\016\264$\"\v5\034Y\210Jh?\300tQ\271DDq\241\240\373\v\303j\216C\265\n/3!\v\2412Q\260\215\251\250{\377\v\245\344\216\220a\2660\332\177A_\277}\021\237\001\271m\362\302>O\342\336\303+\021\200\214c\305\203\250\2441V\342\341\237\0231\323y\343z\341\215\261SY\243\251\r\352\324\026l\237\256\256\a\3160Ys\236\305kL\034\343\n\355\234\236\017\224"
