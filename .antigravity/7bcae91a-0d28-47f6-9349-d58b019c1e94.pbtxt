        target_content: "              {/* Observa\303\247\303\265es e Potencialidades com Ditado por Voz */}\n              <div className=\"space-y-4 pt-2 border-t border-slate-100\">\n                <div>\n                  <div className=\"flex items-center justify-between mb-1.5\">\n                    <label className=\"text-xs font-bold text-slate-800\">\n                      Dificuldades / Barreiras Observadas em Aula\n                    </label>\n                    <VoiceDictationButton\n                      label=\"Ditar por Voz\"\n                      onTranscript={(spoken) =>\n                        setCondicao((prev) => (prev ? `${prev} ${spoken}` : spoken))\n                      }\n                    />\n                  </div>\n                  <textarea\n                    value={condicao}\n                    onChange={(e) => setCondicao(e.target.value)}\n                    rows={2}\n                    placeholder=\"Voc\303\252 pode digitar ou clicar em \'Ditar por Voz\' para falar...\"\n                    className=\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-xs\"\n                  />\n                </div>\n\n                <div>\n                  <div className=\"flex items-center justify-between mb-1.5\">\n                    <label className=\"text-xs font-bold text-slate-800\">\n                      Interesses e Pontos Fortes do Estudante\n                    </label>\n                    <VoiceDictationButton\n                      label=\"Ditar por Voz\"\n                      onTranscript={(spoken) =>\n                        setPotentialidades((prev) => (prev ? `${prev} ${spoken}` : spoken))\n                      }\n                    />\n                  </div>\n                  <textarea\n                    value={potencialidades}\n                    onChange={(e) => setPotentialidades(e.target.value)}\n                    rows={2}\n                    placeholder=\"Ex: Gosta de jogos, visual, aprende r\303\241pido com exemplos pr\303\241ticos...\"\n                    className=\"w-full p-3 border border-slate-300 rounded-xl focus:ring-2 focus:ring-emerald-600 focus:outline-none text-xs\"\n                  />\n                </div>\n              </div>"
