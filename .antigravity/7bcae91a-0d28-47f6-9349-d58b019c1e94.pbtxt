        target_content: "};\n\nexport const todosOsCasos: PEICompleto[] = [\n  casoLucasTecnico,\n  casoBeatrizSuperior,\n  casoMatheusRedes,\n];\n\n// BANCO DE SOLU\303\207\303\225ES PEDAG\303\223GICAS PARA CONDI\303\207\303\225ES ESPEC\303\215FICAS EM TI / COMPUTA\303\207\303\203O\nexport const bancoDeSolucoesPedagogicas: SolucaoCondicao[] = [\n"
        replacement_content: "};\n\n// 4. CASO ENSINO SUPERIOR EM TI - DUPLA EXCEPCIONALIDADE (TDAH + ALTAS HABILIDADES/SUPERDOTA\303\207\303\203O)\nexport const casoLarissaSuperior: PEICompleto = {\n  id: \'SUP-BSI-07\',\n  cabecalho: {\n    estudante: \'Larissa Menezes Costa\',\n    codigo_matricula: \'2024.1.BSI.031\',\n    idade: \'20 anos\',\n    curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\',\n    componente_curricular: \'Engenharia de Software e Programa\303\247\303\243o Orientada a Objetos\',\n    modulo_periodo: \'3\302\272 Semestre / Noturno\',\n    data_elaboracao: \'2026-10-27\',\n    docente_regente: \'Prof\302\252. Dra. Helena Bittencourt (Docente de Engenharia de Software)\',\n    docente_aee: \'Prof\302\252. Renata Cavalcanti (Especialista em Educa\303\247\303\243o Especial / NAPNE)\',\n    profissional_apoio: \'Thiago Martins (Monitor de Acessibilidade Digital e Laborat\303\263rio)\',\n    coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n  },\n  historico_napne: {\n    status_diagnostico: \'confirmado\',\n    categoria_neurodivergencia: \'TDAH Combinado + Altas Habilidades / Superdota\303\247\303\243o (Dupla Excepcionalidade)\',\n    cid_ou_hipotese: \'F90.0 (TDAH) + Z73.0 / Altas Habilidades com laudo neuropsicol\303\263gico\',\n    breve_historico_clinico_familiar:\n      \'Estudante do Bacharelado em Sistemas de Informa\303\247\303\243o no Campus Para\303\255so (integrante dos 14 estudantes acompanhados no Ensino Superior). Apresenta laudo neuropsicol\303\263gico multidisciplinar com diagn\303\263stico de Dupla Excepcionalidade: TDAH tipo combinado associado a Altas Habilidades / Superdota\303\247\303\243o na \303\241rea l\303\263gica e tecnol\303\263gica. Possui velocidade de processamento l\303\263gico muito acima da m\303\251dia e hiperfoco criativo, por\303\251m sofre com desregula\303\247\303\243o nas fun\303\247\303\265es executivas (procrastina\303\247\303\243o, dificuldade de iniciar projetos com instru\303\247\303\265es gen\303\251ricas, desorganiza\303\247\303\243o com prazos extensos e esquecimento de etapas documentais).\',\n    descricao_condicao_especifica:\n      \'Tende a se desmotivar e dispersar rapidamente quando o conte\303\272do \303\251 excessivamente repetitivo ou expositivo passivo. Quando o projeto tem entregas espa\303\247adas de 2 meses, deixa para os \303\272ltimos dias, gerando crises de sobrecarga e ansiedade, apesar de entregar solu\303\247\303\265es de software sofisticadas.\',\n    informacoes_dos_pais:\n      \'Estudante aut\303\264noma que busca o apoio do NAPNE do Campus Para\303\255so para aprender a estruturar rotinas de estudo e metodologias \303\241geis de gest\303\243o de tempo aplicadas aos projetos de programa\303\247\303\243o.\',\n  },\n  estudo_de_caso: {\n    barreiras: [\n      {\n        id: \'B1\',\n        categoria: \'metodologica\',\n        descricao: \'Projetos semestrais com prazos \303\272nicos e distantes (ex: entrega de software completo apenas no fim do semestre).\',\n        impacto: \'D\303\251ficit de fun\303\247\303\243o executiva leva \303\240 procrastina\303\247\303\243o, hiperfoco de \303\272ltima hora, sobrecarga e perda de prazos intermedi\303\241rios.\',\n        estrategia_enfrentamento: \'DUA 3.0: Metodologia Scrum educacional com micro-sprints semanais (Kanban), checkpoints regulares e feedback cont\303\255nuo.\',\n      },\n      {\n        id: \'B2\',\n        categoria: \'atitudinal\',\n        descricao: \'Expectativa docente de que por ter Altas Habilidades ela \"n\303\243o precisa de apoio\" ou que a desorganiza\303\247\303\243o com relat\303\263rios \303\251 \"desleixo\".\',\n        impacto: \'Invisibiliza\303\247\303\243o do TDAH e sofrimento psicol\303\263gico (ansiedade de desempenho e s\303\255ndrome do impostor).\',\n        estrategia_enfrentamento: \'Sensibiliza\303\247\303\243o docente com orienta\303\247\303\243o do NAPNE: reconhecimento da dupla excepcionalidade como demanda leg\303\255tima de acessibilidade pedag\303\263gica.\',\n      },\n      {\n        id: \'B3\',\n        categoria: \'tecnologica\',\n        descricao: \'Exig\303\252ncia de preenchimento de extensos relat\303\263rios t\303\251cnicos manuais em formatos r\303\255gidos e burocr\303\241ticos.\',\n        impacto: \'Dispers\303\243o e bloqueio executivo na escrita burocr\303\241tica, contrastando com seu c\303\263digo fonte de alt\303\255ssima qualidade.\',\n        estrategia_enfrentamento: \'Aceite de documenta\303\247\303\243o t\303\251cnica viva via Markdown no reposit\303\263rio GitHub, issues e diagramas de classe em Mermaid.js.\',\n      },\n    ],\n    potencialidades: [\n      {\n        id: \'P1\',\n        area: \'Arquitetura de Software & Design Patterns\',\n        descricao: \'Facilidade \303\255mpar para desenhar arquiteturas desacopladas, microsservi\303\247os e aplicar padr\303\265es de projeto (GoF).\',\n        apoio_demandado: \'Enriquecimento curricular com desafios de ponta, participa\303\247\303\243o em projetos de pesquisa e inova\303\247\303\243o.\',\n      },\n      {\n        id: \'P2\',\n        area: \'Resolu\303\247\303\243o Criativa de Problemas\',\n        descricao: \'Pensamento divergente; prop\303\265e abordagens inovadoras que superam os requisitos b\303\241sicos propostos pelo docente.\',\n        apoio_demandado: \'Canalizar a criatividade dentro do escopo com mentoria t\303\251cnica orientada.\',\n      },\n    ],\n    recursos_ta: [\n      \'Quadro Kanban digital integrado ao GitHub Projects para microtarefas visuais\',\n      \'Extens\303\265es de foco e linter no VS Code (Pomodoro Timer, Error Lens, Todo Tree)\',\n      \'Templates estruturados em Markdown com se\303\247\303\265es pr\303\251-definidas para documenta\303\247\303\243o\',\n      \'Grava\303\247\303\243o em \303\241udio das reuni\303\265es de alinhamento para consulta posterior\',\n    ],\n    sintese_observacao: {\n      interacao_professores: \'Muito participativa e questionadora; prop\303\265e solu\303\247\303\265es de alta complexidade conceitual.\',\n      interacao_colegas: \'Excelente lideran\303\247a t\303\251cnica em hackathons e projetos de desenvolvimento.\',\n      tarefas_coletivas: \'Rendimento excelente quando atua como Tech Lead com colega respons\303\241vel pela gest\303\243o de cronograma.\',\n      interesses_centrais: \'Engenharia de Software, Arquitetura em Nuvem, Intelig\303\252ncia Artificial e UI/UX.\',\n      habilidades_tecnicas: \'Java, TypeScript, Docker, Design Patterns e Arquitetura Limpa.\',\n      autonomia_rotina: \'Aut\303\264noma nas atividades de vida di\303\241ria; necessita de suporte focado em gest\303\243o executiva e prazos.\',\n    },\n  },\n  planejamento_pei: {\n    conteudo_ementa_oficial:\n      \'Engenharia de Software: Ciclo de vida de software, Metodologias \303\201geis (Scrum/Kanban), Modelagem Orientada a Objetos com UML, Padr\303\265es de Projeto (Design Patterns) e Testes Automatizados.\',\n    competencias_habilidades_ementa:\n      \'Modelar e construir sistemas orientados a objetos robustos; aplicar princ\303\255pios SOLID e design patterns; implementar pipeline de testes unit\303\241rios; atuar em equipes \303\241geis com versionamento e entrega cont\303\255nua.\',\n    adaptacao_flexibilizacao_curricular:\n      \'Enriquecimento curricular nos termos da Portaria MEC n\302\272 421/2026: aprofundamento pr\303\241tico em arquitetura de microsservi\303\247os e automa\303\247\303\243o, com suporte \303\240s fun\303\247\303\265es executivas atrav\303\251s de micro-entregas semanais.\',\n    objetivos_e_metas: [\n      {\n        id_meta: \'M1\',\n        descricao_meta: \'Modelar e implementar microsservi\303\247o com princ\303\255pios SOLID e cobertura de testes unit\303\241rios de 80%.\',\n        prazo: \'Mensal (4 semanas - at\303\251 26/11/2026)\',\n        indicador_sucesso: \'Pipeline de CI/CD no GitHub Actions aprovando todos os testes com c\303\263digo documentado.\',\n        progresso_percentual: 70,\n        status: \'em_andamento\',\n      },\n      {\n        id_meta: \'M2\',\n        descricao_meta: \'Manter quadro Kanban no GitHub Projects atualizado semanalmente com checklist de issues fechadas.\',\n        prazo: \'Bimestral (8 semanas - at\303\251 20/12/2026)\',\n        indicador_sucesso: \'Pelo menos 85% das micro-entregas semanais cumpridas sem ac\303\272mulo no final do per\303\255odo.\',\n        progresso_percentual: 80,\n        status: \'em_andamento\',\n      },\n    ],\n    flexibilizacao_metodologica_dua: {\n      engajamento: [\n        \'Enriquecimento curricular com desafios de computa\303\247\303\243o em nuvem e arquitetura avan\303\247ada.\',\n        \'Metodologia \303\241gil com gamifica\303\247\303\243o de micro-entregas semanais para manter dopamina e motiva\303\247\303\243o.\',\n        \'Feedback formativo imediato p\303\263s-sprint pelo docente regente.\',\n      ],\n      representacao: [\n        \'Instru\303\247\303\265es curtas e visualmente estruturadas em t\303\263picos destacados (sem blocos monol\303\255ticos de texto).\',\n        \'Modelos de exemplo comentados (starter kits de reposit\303\263rio no GitHub).\',\n        \'Uso de diagramas din\303\242micos em Mermaid e fluxogramas visuais.\',\n      ],\n      acao_e_expressao: [\n        \'Demonstra\303\247\303\243o pr\303\241tica atrav\303\251s de c\303\263digo funcional no GitHub e grava\303\247\303\243o de screencast curto (Loom).\',\n        \'Aceite de documenta\303\247\303\243o t\303\251cnica sintetizada em Markdown em vez de relat\303\263rios em Word.\',\n        \'Apresenta\303\247\303\243o t\303\251cnica no formato de \"Tech Talk\" universit\303\241ria.\',\n      ],\n    },\n    gestao_sala_de_aula: {\n      organizacao_espacial: \'Mesa de trabalho em laborat\303\263rio com ilumina\303\247\303\243o adequada e espa\303\247o para notebook pessoal.\',\n      rotina_e_pausas: \'Pausas programadas com t\303\251cnica Pomodoro para descanso cognitivo e autorregula\303\247\303\243o.\',\n      agrupamentos_e_tutoria: \'Pareamento em equipe \303\241gil com papel de lideran\303\247a t\303\251cnica (Tech Lead).\',\n      suporte_docente_semanal: \'Reuni\303\243o semanal de 15 minutos de alinhamento com NAPNE e docente de Engenharia de Software.\',\n    },\n    estrategias_avaliacao: {\n      formato_acessivel: \'Avalia\303\247\303\243o processual baseada em commits semanais e demonstra\303\247\303\243o ao vivo de microsservi\303\247o funcional.\',\n      criterio_de_sucesso: \'Aplica\303\247\303\243o correta dos padr\303\265es de projeto e testes, com autonomia no versionamento.\',\n      grau_mediacao: \'pouca_mediacao\',\n      tempo_e_espaco: \'Entregas fracionadas semanais com tempo estendido caso ocorra crise de dispers\303\243o.\',\n      recursos_utilizados: [\'GitHub Projects (Kanban)\', \'Pomodoro Timer\', \'Extens\303\265es de foco VS Code\'],\n    },\n    observacoes_docente:\n      \'Larissa \303\251 brilhante na concep\303\247\303\243o t\303\251cnica de software. Com a divis\303\243o do projeto em micro-sprints e apoio do NAPNE Campus Para\303\255so nas fun\303\247\303\265es executivas, seu potencial foi plenamente potencializado.\',\n  },\n  painel_notas: [\n    {\n      id: \'NL1\',\n      autor: \'Prof\302\252. Dra. Helena (Docente)\',\n      papel: \'Regente\',\n      categoria: \'objetivos\',\n      conteudo: \'Larissa implementou um padr\303\243o Factory Method e Strategy impec\303\241veis no backend! O acompanhamento semanal tem evitado a procrastina\303\247\303\243o.\',\n      data: \'24/10/2026\',\n      cor: \'green\',\n    },\n  ],\n  metricas: {\n    percentual_metas_alcancadas: 75,\n    nivel_autonomia: 5,\n    engajamento: 5,\n    sessoes_semanais_realizadas: 6,\n    status_geral: \'EM_ANDAMENTO\',\n  },\n  parecer_pedagogico:\n    \'A inclus\303\243o universit\303\241ria na \303\241rea de TI no Campus Para\303\255so abrange o reconhecimento da neurodiverg\303\252ncia e da dupla excepcionalidade. O PEI permite equalizar o desafio cognitivo \303\240 gest\303\243o do tempo, viabilizando excel\303\252ncia t\303\251cnica e bem-estar.\',\n  sugestoes_proximo_ciclo: [\n    \'Submeter projeto para o edital de Inicia\303\247\303\243o Tecnol\303\263gica (PIBITI).\',\n    \'Convidar Larissa para ministrar oficina de Git e GitHub para os calouros.\',\n  ],\n};\n\n// 5. CASO ENSINO M\303\211DIO T\303\211CNICO - HIP\303\223TESE DIAGN\303\223STICA / SEM LAUDO CONFIRMADO (PORTARIA MEC 421/2026)\nexport const casoCauaSemLaudo: PEICompleto = {\n  id: \'MED-INF-05-HIP\',\n  cabecalho: {\n    estudante: \'Cau\303\243 Ribeiro de Almeida\',\n    codigo_matricula: \'2026.1.INF.058\',\n    idade: \'15 anos\',\n    curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\n    componente_curricular: \'L\303\263gica de Programa\303\247\303\243o e Algoritmos\',\n    modulo_periodo: \'1\302\272 Ano / 2\302\272 Semestre\',\n    data_elaboracao: \'2026-10-27\',\n    docente_regente: \'Prof. Marcos Vin\303\255cius Toledo (Docente de Algoritmos e L\303\263gica)\',\n    docente_aee: \'Prof\302\252. Renata Cavalcanti (Especialista em Educa\303\247\303\243o Especial / NAPNE)\',\n    profissional_apoio: \'Thiago Martins (Monitor de Acessibilidade Digital e Laborat\303\263rio)\',\n    coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n  },\n  historico_napne: {\n    status_diagnostico: \'em_investigacao_hipotese\',\n    categoria_neurodivergencia: \'Hip\303\263tese Diagn\303\263stica / Suspeita de Dislexia e Processamento de Linguagem (Sem Laudo)\',\n    cid_ou_hipotese: \'Em investiga\303\247\303\243o pedag\303\263gica e multiprofissional pelo NAPNE (sem CID m\303\251dico conclusivo)\',\n    breve_historico_clinico_familiar:\n      \'Estudante do 1\302\272 Ano do Curso T\303\251cnico Integrado em Inform\303\241tica no Campus Para\303\255so. Integra o grupo dos 5 estudantes acompanhados pelo NAPNE que n\303\243o possuem diagn\303\263stico m\303\251dico formal (casos com hip\303\263tese diagn\303\263stica ou suspeita de neurodiverg\303\252ncia). Conforme expressamente preconizado pela Portaria MEC n\302\272 421/2026 e pelo Decreto n\302\272 12.686/2025, a aus\303\252ncia de laudo m\303\251dico N\303\203O impede a elabora\303\247\303\243o do PEI nem a concess\303\243o de apoios e Tecnologias Assistivas, uma vez que o direito \303\240 acessibilidade fundamenta-se nas barreiras escolares identificadas pela equipe pedag\303\263gica.\',\n    descricao_condicao_especifica:\n      \'Apresenta grande dificuldade na decodifica\303\247\303\243o e digita\303\247\303\243o de sintaxes textuais r\303\255gidas de c\303\263digo (troca de caracteres como ponto-e-v\303\255rgula, chaves, par\303\252nteses e indenta\303\247\303\243o), fadiga r\303\241pida na leitura de enunciados prolixos e lentid\303\243o para transcrever algoritmos do quadro para a IDE. Em contrapartida, demonstra excelente racioc\303\255nio l\303\263gico-matem\303\241tico quando resolve problemas por meio de blocos visuais, diagramas ou explica oralmente o racioc\303\255nio.\',\n    informacoes_dos_pais:\n      \'A fam\303\255lia foi acolhida pelo NAPNE do Campus Para\303\255so e relata hist\303\263rico de dificuldades com leitura e escrita desde os anos finais do ensino fundamental, sem acesso anterior a avalia\303\247\303\243o neuropsicol\303\263gica por car\303\252ncia de especialistas na regi\303\243o. A fam\303\255lia apoia integralmente o plano de atendimento pedag\303\263gico inclusivo enquanto aguarda encaminhamento \303\240 rede p\303\272blica de sa\303\272de.\',\n  },\n  estudo_de_caso: {\n    barreiras: [\n      {\n        id: \'B1\',\n        categoria: \'metodologica\',\n        descricao: \'Avalia\303\247\303\265es de programa\303\247\303\243o manuscritas no papel ou com penaliza\303\247\303\243o severa por erros de sintaxe ortogr\303\241fica de c\303\263digo (ex: esquecimento de v\303\255rgula ou par\303\252ntese).\',\n        impacto: \'Gera reprova\303\247\303\243o por falhas de ortografia/dislexia de sintaxe, ocultando que a l\303\263gica algor\303\255tmica do estudante estava correta.\',\n        estrategia_enfrentamento: \'DUA 3.0: Foco na sem\303\242ntica e na l\303\263gica do algoritmo; permiss\303\243o de IDEs com linters visuais que destacam automaticamente erros sint\303\241ticos com cores n\303\255tidas.\',\n      },\n      {\n        id: \'B2\',\n        categoria: \'comunicacional\',\n        descricao: \'Enunciados de exerc\303\255cios com textos densos, vocabul\303\241rio rebuscado e instru\303\247\303\265es orais sem apoio visual de entrada/sa\303\255da.\',\n        impacto: \'Dificuldade de processamento textual atrasa o in\303\255cio da resolu\303\247\303\243o do problema.\',\n        estrategia_enfrentamento: \'Enunciados com metodologia DUA: destacados em t\303\263picos, tabela de casos de teste (Input/Output) e leitura mediada em voz alta se necess\303\241rio.\',\n      },\n      {\n        id: \'B3\',\n        categoria: \'atitudinal\',\n        descricao: \'Risco de questionamentos da equipe pedag\303\263gica sobre a concess\303\243o de tempo ampliado pelo fato do estudante \"ainda n\303\243o ter laudo com CID\".\',\n        impacto: \'Inseguran\303\247a docente e desamparo ao estudante em momento crucial de transi\303\247\303\243o para o ensino t\303\251cnico.\',\n        estrategia_enfrentamento: \'Forma\303\247\303\243o continuada do NAPNE Campus Para\303\255so com base na Portaria MEC n\302\272 421/2026, firmando que a acessibilidade \303\251 dever imediato da institui\303\247\303\243o.\',\n      },\n    ],\n    potencialidades: [\n      {\n        id: \'P1\',\n        area: \'Racioc\303\255nio Algor\303\255tmico Visual & L\303\263gica Abstrata\',\n        descricao: \'Capacidade veloz de resolu\303\247\303\243o de problemas quando apoiado por fluxogramas, linguagens visuais de blocos (Scratch/Blockly) ou representa\303\247\303\265es gr\303\241ficas.\',\n        apoio_demandado: \'Utilizar ferramentas visuais como ponte para a linguagem textual de programa\303\247\303\243o.\',\n      },\n      {\n        id: \'P2\',\n        area: \'Resili\303\252ncia & Motiva\303\247\303\243o com Tecnologia\',\n        descricao: \'Grande entusiasmo em aprender inform\303\241tica, curiosidade com hardware e manuten\303\247\303\243o de computadores.\',\n        apoio_demandado: \'Vincular os algoritmos a aplica\303\247\303\265es pr\303\241ticas de automa\303\247\303\243o e rob\303\263tica educativa.\',\n      },\n    ],\n    recursos_ta: [\n      \'Extens\303\265es do VS Code para dislexia e apoio visual (Color Highlight, Bracket Pair Colorizer, Error Lens)\',\n      \'Fontes tipogr\303\241ficas acess\303\255veis (OpenDyslexic Mono / Atkinson Hyperlegible)\',\n      \'Tempo estendido (+50%) em provas pr\303\241ticas e avalia\303\247\303\265es diagn\303\263sticas\',\n      \'Permiss\303\243o de leitor de tela / sintetizador de voz para leitura de enunciados longos\',\n      \'Caderno de apoio com gloss\303\241rio visual de sintaxe de l\303\263gica de programa\303\247\303\243o\',\n    ],\n    sintese_observacao: {\n      interacao_professores: \'Participativo e atento; solicita esclarecimentos individuais quando o enunciado \303\251 muito prolixo.\',\n      interacao_colegas: \'Bem integrado; colaborativo e respeitoso nas din\303\242micas de laborat\303\263rio.\',\n      tarefas_coletivas: \'Rendimento excelente em atividades pr\303\241ticas manuais de laborat\303\263rio.\',\n      interesses_centrais: \'L\303\263gica de Programa\303\247\303\243o, Jogos Digitais, Montagem e Manuten\303\247\303\243o de Hardware.\',\n      habilidades_tecnicas: \'Compreens\303\243o de la\303\247os de repeti\303\247\303\243o, condicionais e estruturas vetoriais.\',\n      autonomia_rotina: \'Aut\303\264nomo; necessita apenas de adequa\303\247\303\243o visual e tempo estendido para leitura.\',\n    },\n  },\n  planejamento_pei: {\n    conteudo_ementa_oficial:\n      \'L\303\263gica de Programa\303\247\303\243o e Algoritmos: Conceito de algoritmos, tipos primitivos de dados, vari\303\241veis e constantes, operadores l\303\263gicos e aritm\303\251ticos, estruturas condicionais (if/else), estruturas de repeti\303\247\303\243o (for/while) e vetores unidimensionais.\',\n    competencias_habilidades_ementa:\n      \'Compreender a l\303\263gica algor\303\255tmica para resolu\303\247\303\243o de problemas computacionais; implementar estruturas de controle de fluxo; desenvolver pensamento computacional decompondo problemas em sub-rotinas.\',\n    adaptacao_flexibilizacao_curricular:\n      \'Garantia do curr\303\255culo pleno sem rebaixamento cognitivo. Flexibiliza\303\247\303\243o metodol\303\263gica nos canais de leitura e escrita atrav\303\251s do DUA 3.0 e Tecnologias Assistivas, com valida\303\247\303\243o diagn\303\263stica cont\303\255nua.\',\n    objetivos_e_metas: [\n      {\n        id_meta: \'M1\',\n        descricao_meta: \'Construir algoritmos com estruturas condicionais e de repeti\303\247\303\243o utilizando IDE com linter visual e fonte acess\303\255vel.\',\n        prazo: \'Mensal (4 semanas - at\303\251 26/11/2026)\',\n        indicador_sucesso: \'Execu\303\247\303\243o correta de pelo menos 4 de 5 exerc\303\255cios de l\303\263gica com casos de teste validados.\',\n        progresso_percentual: 65,\n        status: \'em_andamento\',\n      },\n      {\n        id_meta: \'M2\',\n        descricao_meta: \'Explicar verbalmente ou via fluxograma o fluxo de dados e execu\303\247\303\243o de um algoritmo de ordena\303\247\303\243o de vetores.\',\n        prazo: \'Bimestral (8 semanas - at\303\251 20/12/2026)\',\n        indicador_sucesso: \'Apresenta\303\247\303\243o oral com demonstra\303\247\303\243o pr\303\241tica para o docente sem penaliza\303\247\303\243o por trocas sint\303\241ticas manuais.\',\n        progresso_percentual: 50,\n        status: \'em_andamento\',\n      },\n    ],\n    flexibilizacao_metodologica_dua: {\n      engajamento: [\n        \'Desafios pr\303\241ticos com aplica\303\247\303\243o em cen\303\241rios reais e contextualizados do campus.\',\n        \'Acolhimento pedag\303\263gico seguro que remove a ansiedade e o estigma do erro sint\303\241tico.\',\n        \'Reconhecimento das solu\303\247\303\265es l\303\263gicas elegantes desenvolvidas pelo estudante.\',\n      ],\n      representacao: [\n        \'Disponibiliza\303\247\303\243o de enunciados com fontes acess\303\255veis (OpenDyslexic) e espa\303\247amento ampliado.\',\n        \'Uso de fluxogramas e tabelas visuais com exemplos de entrada e sa\303\255da esperados.\',\n        \'Possibilidade de ouvir o enunciado atrav\303\251s de sintetizador de voz ou leitura do monitor.\',\n      ],\n      acao_e_expressao: [\n        \'Avalia\303\247\303\243o pr\303\241tica no computador com tempo ampliado (+50%) e corretor ortogr\303\241fico/sint\303\241tico.\',\n        \'Permiss\303\243o de defesa oral da solu\303\247\303\243o algor\303\255tmica em caso de d\303\272vida sobre a l\303\263gica.\',\n        \'Foco da corre\303\247\303\243o na resolu\303\247\303\243o do problema e n\303\243o na memoriza\303\247\303\243o de caracteres pontuais.\',\n      ],\n    },\n    gestao_sala_de_aula: {\n      organizacao_espacial: \'Bancada de laborat\303\263rio bem posicionada para visualiza\303\247\303\243o do quadro e do projetor.\',\n      rotina_e_pausas: \'Pausas visuais para descanso ocular ap\303\263s 40 minutos de leitura cont\303\255nua de c\303\263digo.\',\n      agrupamentos_e_tutoria: \'Programa\303\247\303\243o em pares orientada com colega acolhedor.\',\n      suporte_docente_semanal: \'Reuni\303\243o pedag\303\263gica semanal entre docente de algoritmos e equipe do NAPNE Campus Para\303\255so.\',\n    },\n    estrategias_avaliacao: {\n      formato_acessivel: \'Prova pr\303\241tica no laborat\303\263rio com IDE configurada (linter ativo), tempo ampliado e enunci