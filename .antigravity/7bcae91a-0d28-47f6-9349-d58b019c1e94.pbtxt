    end_line: 260
    content: "import React, { useState } from \'react\';\nimport {\n  UserPlus,\n  Printer,\n  Wrench,\n  BarChart2,\n  Type,\n  Eye,\n  Sun,\n  Moon,\n  ChevronDown,\n  ShieldCheck,\n  HelpCircle,\n  BookOpen,\n  Settings,\n} from \'lucide-react\';\nimport { estatisticasCampusParaiso } from \'../data/initialCases\';\nimport { EscalaFonte, ModoContraste } from \'../types/pei\';\n\ninterface NavbarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  onOpenAddStudent: () => void;\n  onOpenSolutionBank: () => void;\n  onOpenCampusStats?: () => void;\n  onPrint: () => void;\n  escalaFonte?: EscalaFonte;\n  onMudarFonte?: (escala: EscalaFonte) => void;\n  modoContraste?: ModoContraste;\n  onMudarContraste?: (modo: ModoContraste) => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  setActiveTab,\n  onOpenAddStudent,\n  onOpenSolutionBank,\n  onOpenCampusStats,\n  onPrint,\n  escalaFonte = \'normal\',\n  onMudarFonte,\n  modoContraste = \'padrao\',\n  onMudarContraste,\n}) => {\n  const [isSupportOpen, setIsSupportOpen] = useState(false);\n  const stats = estatisticasCampusParaiso;\n  const navItems = [\n    { id: \'hub\', label: \'Hub do PEI\' },\n    { id: \'pei\', label: \'Plano de Ensino (PEI)\' },\n    { id: \'estudo_caso\', label: \'Estudo de Caso & DUA\' },\n    { id: \'documento_oficial\', label: \'Modelo Oficial IFTO\' },\n    { id: \'painel\', label: \'Acompanhamento & Metas\' },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-30 bg-white border-b border-slate-200/90 no-print transition-colors shadow-2xs\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between gap-4 h-16\">\n          {/* Zone 1: Wordmark iLovePDF-style (i\360\237\222\232PEI) */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <button\n              onClick={() => setActiveTab(\'hub\')}\n              className=\"flex items-center gap-1.5 text-left group cursor-pointer\"\n              title=\"Voltar ao Hub Principal i\360\237\222\232PEI\"\n            >\n              <span className=\"text-2xl font-black tracking-tighter text-slate-900 group-hover:text-emerald-700 transition-colors\">\n                I\n              </span>\n              <span className=\"text-xl sm:text-2xl leading-none\" role=\"img\" aria-label=\"cora\303\247\303\243o verde\">\n                \360\237\222\232\n              </span>\n              <span className=\"text-2xl font-black tracking-tighter text-slate-900 group-hover:text-emerald-700 transition-colors\">\n                PEI\n              </span>\n              <span className=\"ml-1 hidden sm:inline-flex items-center gap-1 text-[10px] font-bold text-emerald-900 bg-emerald-100 px-2 py-0.5 rounded-full font-mono uppercase tracking-wider\">\n                Ioda AI\n              </span>\n            </button>\n          </div>\n\n          {/* Zone 2: Navigation Links (matching iLovePDF top menu) */}\n          <nav className=\"hidden lg:flex items-center gap-1 text-sm font-semibold text-slate-600\">\n            {navItems.map((item) => {\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => setActiveTab(item.id)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-semibold whitespace-nowrap transition-colors cursor-pointer ${\n                    isActive\n                      ? \'bg-slate-900 text-white shadow-2xs\'\n                      : \'text-slate-700 hover:text-slate-950 hover:bg-slate-100\'\n                  }`}\n                >\n                  {item.label}\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Zone 3: Actions + DUA 3.0 Accessibility Controls */}\n          <div className=\"flex items-center gap-2 shrink-0\">\n            {/* DUA 3.0 Visual Preferences Toolbar */}\n            {onMudarFonte && onMudarContraste && (\n              <div className=\"flex items-center gap-1 bg-slate-100/90 p-1 rounded-lg border border-slate-200 text-xs\">\n                {/* Font Scaling */}\n                <div className=\"flex items-center\">\n                  <button\n                    onClick={() => {\n                      const proxima =\n                        escalaFonte === \'normal\'\n                          ? \'ampliada\'\n                          : escalaFonte === \'ampliada\'\n                          ? \'grande\'\n                          : \'normal\';\n                      onMudarFonte(proxima);\n                    }}\n                    className=\"px-1.5 py-1 text-[11px] font-bold text-slate-700 hover:bg-white rounded transition-colors flex items-center gap-0.5 cursor-pointer\"\n                    title={`DUA 3.0: Tamanho de fonte (${escalaFonte}). Clique para alternar.`}\n                  >\n                    <Type className=\"w-3 h-3 text-slate-500\" />\n                    <span>{escalaFonte === \'normal\' ? \'A\' : escalaFonte === \'ampliada\' ? \'A+\' : \'A++\'}</span>\n                  </button>\n                </div>\n\n                <div className=\"w-px h-3.5 bg-slate-300 mx-0.5\" />\n\n                {/* Color Contrast Theme */}\n                <button\n                  onClick={() => {\n                    const proximo =\n                      modoContraste === \'padrao\'\n                        ? \'conforto\'\n                        : modoContraste === \'conforto\'\n                        ? \'alto-contraste\'\n                        : \'padrao\';\n                    onMudarContraste(proximo);\n                  }}\n                  className=\"px-1.5 py-1 text-[11px] font-medium text-slate-700 hover:bg-white rounded transition-colors flex items-center gap-1 cursor-pointer\"\n                  title={`DUA 3.0: Contraste Visual (${modoContraste}). Clique para alternar (Padr\303\243o / Conforto S\303\251pia / Alto Contraste).`}\n                >\n                  <Eye className={`w-3.5 h-3.5 ${modoContraste === \'alto-contraste\' ? \'text-amber-500\' : modoContraste === \'conforto\' ? \'text-amber-700\' : \'text-emerald-700\'}`} />\n                  <span className=\"hidden sm:inline\">\n                    {modoContraste === \'padrao\'\n                      ? \'Padr\303\243o\'\n                      : modoContraste === \'conforto\'\n                      ? \'Conforto\'\n                      : \'Contraste\'}\n                  </span>\n                </button>\n              </div>\n            )}\n\n            {/* Menu de Suporte, Configura\303\247\303\243o & Diretrizes (unificando Censo, Banco DUA e Legisla\303\247\303\243o) */}\n            <div className=\"relative\">\n              <button\n                type=\"button\"\n                onClick={() => setIsSupportOpen(!isSupportOpen)}\n                className=\"inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-slate-700 bg-slate-100 hover:bg-slate-200 border border-slate-200 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n                title=\"Recursos de Suporte Pedag\303\263gico, Legisla\303\247\303\243o e Banco DUA\"\n              >\n                <HelpCircle className=\"w-3.5 h-3.5 text-emerald-700\" />\n                <span className=\"hidden sm:inline\">Suporte & Diretrizes</span>\n                <ChevronDown className=\"w-3 h-3 text-slate-500\" />\n              </button>\n\n              {isSupportOpen && (\n                <div className=\"absolute right-0 top-full mt-2 w-80 bg-white rounded-2xl shadow-xl border border-slate-200 z-50 p-2 space-y-1 animate-fadeIn\">\n                  <div className=\"text-[10px] font-bold text-slate-400 uppercase tracking-wider px-3 py-1.5\">\n                    Recursos de Apoio Pedag\303\263gico\n                  </div>\n\n                  <button\n                    onClick={() => {\n                      onOpenSolutionBank();\n                      setIsSupportOpen(false);\n                    }}\n                    className=\"w-full text-left p-2.5 rounded-xl hover:bg-slate-50 text-xs transition-colors flex items-start gap-2.5 cursor-pointer\"\n                  >\n                    <div className=\"p-1.5 bg-emerald-100 text-emerald-800 rounded-lg shrink-0 mt-0.5\">\n                      <Wrench className=\"w-4 h-4\" />\n                    </div>\n                    <div>\n                      <div className=\"font-bold text-slate-900\">Banco de Solu\303\247\303\265es DUA 3.0</div>\n                      <div className=\"text-[11px] text-slate-500\">\n                        Cat\303\241logo de tecnologias assistivas e estrat\303\251gias para laborat\303\263rios de TI.\n                      </div>\n                    </div>\n                  </button>\n\n                  {onOpenCampusStats && (\n                    <button\n                      onClick={() => {\n                        onOpenCampusStats();\n                        setIsSupportOpen(false);\n                      }}\n                      className=\"w-full text-left p-2.5 rounded-xl hover:bg-slate-50 text-xs transition-colors flex items-start gap-2.5 cursor-pointer\"\n                    >\n                      <div className=\"p-1.5 bg-teal-100 text-teal-800 rounded-lg shrink-0 mt-0.5\">\n                        <BarChart2 className=\"w-4 h-4\" />\n                      </div>\n                      <div>\n                        <div className=\"font-bold text-slate-900 flex items-center gap-1.5\">\n                          <span>Censo Inclusivo Campus Para\303\255so</span>\n                          <span className=\"text-[10px] bg-teal-100 text-teal-900 font-mono font-bold px-1.5 py-0.2 rounded\">\n                            {stats.estudantes_geral}\n                          </span>\n                        </div>\n                        <div className=\"text-[11px] text-slate-500\">\n                          15 M\303\251dio T\303\251cnico \302\267 14 Superior TI \302\267 5 Sem Laudo (MEC 421)\n                        </div>\n                      </div>\n                    </button>\n                  )}\n\n                  <div className=\"p-2.5 bg-emerald-50/70 border border-emerald-100 rounded-xl text-[11px] text-slate-700 space-y-1\">\n                    <div className=\"font-bold text-emerald-950 flex items-center gap-1\">\n                      <ShieldCheck className=\"w-3.5 h-3.5 text-emerald-700\" />\n                      <span>Garantia Sem Laudo (Portaria MEC 421/2026)</span>\n                    </div>\n                    <p className=\"text-[10px] text-emerald-900 leading-relaxed\">\n                      O PEI e o AEE s\303\243o assegurados com base na avalia\303\247\303\243o pedag\303\263gica das barreiras, sem exig\303\252ncia de diagn\303\263stico m\303\251dico pr\303\251vio.\n                    </p>\n                  </div>\n                </div>\n              )}\n            </div>\n\n            <button\n              onClick={onPrint}\n              className=\"hidden md:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              title=\"Imprimir PEI\"\n            >\n              <Printer className=\"w-3.5 h-3.5 text-slate-500\" />\n              Imprimir\n            </button>\n\n            <button\n              onClick={onOpenAddStudent}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-bold text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg transition-colors whitespace-nowrap shrink-0 cursor-pointer shadow-xs\"\n            >\n              <UserPlus className=\"w-3.5 h-3.5 text-emerald-200\" />\n              <span>+ Novo PEI</span>\n            </button>\n\n            {/* User Profile Avatar (matching iLovePDF screenshot) */}\n            <div className=\"flex items-center gap-2 pl-1.5 border-l border-slate-200 shrink-0\">\n              <div\n                className=\"w-8 h-8 rounded-full bg-slate-900 text-white font-bold text-xs flex items-center justify-center shadow-xs cursor-pointer hover:bg-emerald-800 transition-colors\"\n                title=\"Jean Carlo \302\267 Docente Regente / Equipe Pedag\303\263gica NAPNE\"\n              >\n                JC\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </header>\n  );\n};\n"
    num_lines: 261
    num_bytes: 11911
    line_range_bytes: 11911
  }
}
