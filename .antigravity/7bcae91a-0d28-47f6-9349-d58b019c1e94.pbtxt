              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        \'Avalia\303\247\303\243o pr\303\241tica em laborat\303\263rio com crit\303\251rios anal\303\255ticos expl\303\255citos (Definition of Done), sem press\303\243o de comunica\303\247\303\243o informal desestruturada.\',"
