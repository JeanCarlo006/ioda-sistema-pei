  view_file {
    absolute_path_uri: "file:///src/components/AddStudentModal.tsx"
    end_line: 1495
    content: "import React, { useState } from \'react\';\nimport { PEICompleto, EscalaFonte, ModoContraste } from \'../types/pei\';\nimport {\n  gerarNovoPeiCompleto,\n  bancoDeSolucoesPedagogicas,\n} from \'../data/initialCases\';\nimport {\n  UserPlus,\n  X,\n  Sparkles,\n  GraduationCap,\n  Loader2,\n  CheckCircle,\n  Cpu,\n  Layers,\n  Wrench,\n  HelpCircle,\n  FileCheck2,\n  ShieldCheck,\n  Laptop,\n  ArrowRight,\n  ArrowLeft,\n  Info,\n  Sliders,\n  Type,\n  Sun,\n  Moon,\n  Eye,\n  Check,\n  Brain,\n  HeartPulse,\n  Activity,\n  CheckSquare,\n  ShieldAlert,\n  BookOpen,\n  Users,\n} from \'lucide-react\';\n\ninterface AddStudentModalProps {\n  isOpen: boolean;\n  onClose: () => void;\n  onAddStudent: (newStudent: PEICompleto) => void;\n  escalaFonteAtual?: EscalaFonte;\n  onMudarFonte?: (escala: EscalaFonte) => void;\n  modoContrasteAtual?: ModoContraste;\n  onMudarContraste?: (modo: ModoContraste) => void;\n}\n\nexport const AddStudentModal: React.FC<AddStudentModalProps> = ({\n  isOpen,\n  onClose,\n  onAddStudent,\n  escalaFonteAtual = \'normal\',\n  onMudarFonte,\n  modoContrasteAtual = \'padrao\',\n  onMudarContraste,\n}) => {\n  // Wizard / Stepper state (Progressive Disclosure - 4 Steps)\n  const [currentStep, setCurrentStep] = useState<1 | 2 | 3 | 4>(1);\n\n  // Profile and diagnostic status\n  const [perfilModalidade, setPerfilModalidade] = useState<\'medio_tecnico\' | \'superior_ti\'>(\'medio_tecnico\');\n  const [statusDiagnostico, setStatusDiagnostico] = useState<\'confirmado\' | \'em_investigacao_hipotese\'>(\'confirmado\');\n  const [categoriaNeurodivergencia, setCategoriaNeurodivergencia] = useState(\'Transtorno do D\303\251ficit de Aten\303\247\303\243o com Hiperatividade (TDAH)\');\n  const [mostrarOutrasCondicoes, setMostrarOutrasCondicoes] = useState(false);\n\n  // Form fields\n  const [nome, setNome] = useState(\'\');\n  const [matricula, setMatricula] = useState(\'\');\n  const [idade, setIdade] = useState(\'17 anos\');\n  const [curso, setCurso] = useState(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n  const [disciplina, setDisciplina] = useState(\'Programa\303\247\303\243o Web e Algoritmos\');\n  const [modulo, setModulo] = useState(\'2\302\272 Ano / Diurno\');\n  const [condicao, setCondicao] = useState(\'\');\n  const [potencialidades, setPotentialidades] = useState(\'\');\n  const [assistiveTech, setAssistiveTech] = useState(\'\');\n  const [selectedSolucoes, setSelectedSolucoes] = useState<string[]>([\'sol-tdah\']);\n  const [docenteRegente, setDocenteRegente] = useState(\'Prof. Docente da Disciplina\');\n  const [docenteAee] = useState(\'Prof\302\252. Renata Cavalcanti (NAPNE \302\267 Campus Para\303\255so)\');\n  const [benchmarkFeedback, setBenchmarkFeedback] = useState<string | null>(null);\n\n  // Loading state with dynamic step progress\n  const [isGenerating, setIsGenerating] = useState(false);\n  const [stepMessage, setStepMessage] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  // Presets from PPC do BSI (Campus Para\303\255so) and Plano de Ensino de Engenharia de Software II (BAC.0406)\n  const presetsPpcEPlano = [\n    {\n      id: \'preset-eng-soft-2\',\n      tag: \'Plano de Ensino em Anexo\',\n      titulo: \'BAC.0406 - Engenharia de Software II\',\n      curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\',\n      modulo: \'4\302\272 Per\303\255odo / Noturno\',\n      docente: \'Prof. Alexandre Santos\',\n      perfil: \'superior_ti\' as const,\n      idade: \'21 anos\',\n      descricao: \'Qualidade (ISO 25010), TDD, Testes Automatizados (JUnit/Selenium) e Jira\',\n    },\n    {\n      id: \'preset-bd-sql\',\n      tag: \'PPC BSI \302\267 3\302\272/4\302\272 Per\303\255odo\',\n      titulo: \'Banco de Dados Relacional e SQL\',\n      curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\',\n      modulo: \'3\302\272 Per\303\255odo / Noturno\',\n      docente: \'Prof. Docente de Banco de Dados\',\n      perfil: \'superior_ti\' as const,\n      idade: \'20 anos\',\n      descricao: \'Normaliza\303\247\303\243o, \303\241lgebra relacional, DDL/DML e consultas SQL anal\303\255ticas\',\n    },\n    {\n      id: \'preset-algoritmos-bsi\',\n      tag: \'PPC BSI \302\267 1\302\272 Per\303\255odo\',\n      titulo: \'Algoritmos e L\303\263gica de Programa\303\247\303\243o\',\n      curso: \'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\',\n      modulo: \'1\302\272 Per\303\255odo / Noturno\',\n      docente: \'Prof. Docente de L\303\263gica e Algoritmos\',\n      perfil: \'superior_ti\' as const,\n      idade: \'19 anos\',\n      descricao: \'L\303\263gica estruturada, tabelas-verdade, estruturas de repeti\303\247\303\243o e vetores\',\n    },\n    {\n      id: \'preset-tecnico-web\',\n      tag: \'M\303\251dio T\303\251cnico \302\267 2\302\272 Ano\',\n      titulo: \'Programa\303\247\303\243o Web e Algoritmos\',\n      curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\n      modulo: \'2\302\272 Ano / Diurno\',\n      docente: \'Prof. Docente de Desenvolvimento Web\',\n      perfil: \'medio_tecnico\' as const,\n      idade: \'16 anos\',\n      descricao: \'L\303\263gica em JavaScript/Python, interfaces HTML/CSS e banco de dados b\303\241sico\',\n    },\n    {\n      id: \'preset-tecnico-redes\',\n      tag: \'M\303\251dio T\303\251cnico \302\267 1\302\272 Ano\',\n      titulo: \'Fundamentos de Redes de Computadores e Hardware\',\n      curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\n      modulo: \'1\302\272 Ano / Diurno\',\n      docente: \'Prof. Gilberto Mendes\',\n      perfil: \'medio_tecnico\' as const,\n      idade: \'15 anos\',\n      descricao: \'Topologias, cabeamento, c\303\241lculo de sub-redes e arquitetura TCP/IP\',\n    },\n  ];\n\n  // Quick Preset Selection Handler\n  const handleApplyCoursePreset = (preset: typeof presetsPpcEPlano[0]) => {\n    setCurso(preset.curso);\n    setDisciplina(preset.titulo);\n    setModulo(preset.modulo);\n    setDocenteRegente(preset.docente);\n    setIdade(preset.idade);\n    setPerfilModalidade(preset.perfil);\n  };\n\n  // Handle Profile Switcher\n  const handleSelectProfile = (perfil: \'medio_tecnico\' | \'superior_ti\') => {\n    setPerfilModalidade(perfil);\n    setBenchmarkFeedback(null);\n\n    if (perfil === \'superior_ti\') {\n      setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\');\n      setModulo(\'4\302\272 Per\303\255odo / Noturno\');\n      setDisciplina(\'BAC.0406 - Engenharia de Software II\');\n      setDocenteRegente(\'Prof. Alexandre Santos\');\n      setIdade(\'21 anos\');\n      syncSelectedConditions([\'sol-tdah\'], \'BAC.0406 - Engenharia de Software II\');\n    } else {\n      setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n      setModulo(\'2\302\272 Ano / Diurno\');\n      setDisciplina(\'Programa\303\247\303\243o Web e Algoritmos\');\n      setDocenteRegente(\'Prof. Docente da Disciplina\');\n      setIdade(\'17 anos\');\n      syncSelectedConditions([\'sol-tea\'], \'Programa\303\247\303\243o Web e Algoritmos\');\n    }\n  };\n\n  // Synchronize form fields whenever the multi-selected neurodivergences change\n  const syncSelectedConditions = (ids: string[], discOverride?: string) => {\n    const finalIds = ids.length > 0 ? ids : [\'sol-tdah\'];\n    setSelectedSolucoes(finalIds);\n\n    const solucoesObjs = finalIds\n      .map((sid) => bancoDeSolucoesPedagogicas.find((s) => s.id === sid))\n      .filter(Boolean);\n\n    if (solucoesObjs.length > 0) {\n      const titulosCombinados = solucoesObjs.map((s) => s!.titulo).join(\' + \');\n      setCategoriaNeurodivergencia(titulosCombinados);\n\n      const currentDisc = discOverride ?? disciplina;\n      const isEngSoft =\n        currentDisc.toLowerCase().includes(\'engenharia de software\') ||\n        currentDisc.includes(\'BAC.0406\');\n\n      const descricoesCombinadas = solucoesObjs\n        .map((s) => `\342\200\242 ${s!.titulo}: ${s!.descricaoProblema}`)\n        .join(\'\\n\');\n\n      let customCondicao = descricoesCombinadas;\n      if (isEngSoft) {\n        customCondicao += `\\n\\n[Contextualiza\303\247\303\243o na disciplina BAC.0406 - Engenharia de Software II: acomoda\303\247\303\265es integradas para testes unit\303\241rios TDD em JUnit/Selenium, relat\303\263rios de defeitos no Jira e normas de qualidade ISO/IEC 25010].`;\n      }\n      setCondicao(customCondicao);\n\n      const taUnificada = Array.from(\n        new Set(solucoesObjs.flatMap((s) => s!.remediosSugeridos.recursosTA))\n      );\n      setAssistiveTech(taUnificada.join(\', \'));\n\n      const mapPotencial: Record<string, string> = {\n        \'sol-tdah\':\n          \'Racioc\303\255nio \303\241gil, resolu\303\247\303\243o criativa de bugs l\303\263gicos e hiperfoco em desafios t\303\251cnicos de codifica\303\247\303\243o quando apoiado por micro-sprints\',\n        \'sol-tea\':\n          \'Aten\303\247\303\243o meticulosa aos detalhes, racioc\303\255nio l\303\263gico met\303\263dico e facilidade para identificar anomalias em c\303\263digo e testes automatizados\',\n        \'sol-ansiedade\':\n          \'Rigor conceitual, comprometimento com entregas de qualidade e excelente desempenho em projetos pr\303\241ticos desenvolvidos com tranquilidade\',\n        \'sol-aprendizagem\':\n          \'Pensamento computacional visual, vis\303\243o de arquitetura de software desacoplada e excelente racioc\303\255nio algor\303\255tmico\',\n        \'sol-def-intelectual\':\n          \'Dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o, colabora\303\247\303\243o em duplas estruturadas e boa reten\303\247\303\243o com instru\303\247\303\265es objetivas\',\n        \'sol-toc\':\n          \'Elevada precis\303\243o t\303\251cnica, meticulosidade na cobertura de testes e ader\303\252ncia a padr\303\265es arquiteturais limpos\',\n        \'sol-misto-ansioso-depressivo\':\n          \'Comprometimento com projetos significativos e foco t\303\251cnico consistente quando amparado por metas graduais\',\n        \'sol-depressao\':\n          \'Capacidade anal\303\255tica e engajamento construtivo em projetos pr\303\241ticos em ambiente acolhedor e ass\303\255ncrono\',\n        \'sol-epilepsia\':\n          \'Racioc\303\255nio l\303\263gico estruturado e consist\303\252ncia t\303\251cnica em ambiente de laborat\303\263rio visualmente seguro\',\n      };\n\n      const potList = finalIds.map(\n        (id) =>\n          mapPotencial[id] ||\n          \'Dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o, racioc\303\255nio l\303\263gico e colabora\303\247\303\243o t\303\251cnica\'\n      );\n      setPotentialidades(Array.from(new Set(potList)).join(\'; \') + \'.\');\n\n      if (finalIds.includes(\'sol-hipotese-sem-laudo\')) {\n        setStatusDiagnostico(\'em_investigacao_hipotese\');\n      }\n    }\n  };\n\n  // Toggle selection of one or more neurodivergences (supports TEA + TDAH, etc.)\n  const handleTogglePredefinedSolution = (id: string) => {\n    const exists = selectedSolucoes.includes(id);\n    let nextIds: string[];\n    if (exists) {\n      // Keep at least 1 selected or replace if only 1\n      nextIds = selectedSolucoes.length > 1 ? selectedSolucoes.filter((item) => item !== id) : [id];\n    } else {\n      nextIds = [...selectedSolucoes, id];\n    }\n    syncSelectedConditions(nextIds);\n  };\n\n  // Step 2 validation check\n  const isStep2Valid = nome.trim().length > 0 && disciplina.trim().length > 0;\n\n  // Final submit to generate with Ioda AI\n  const handleFinalSubmit = async () => {\n    if (!nome.trim() || !disciplina.trim()) {\n      setCurrentStep(2);\n      return;\n    }\n\n    setIsGenerating(true);\n    const modalidadeDesc = perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\';\n    setStepMessage(`1/3: Ioda AI consultando refer\303\252ncias do perfil [${modalidadeDesc}] e normas do NAPNE...`);\n\n    try {\n      let finalPei: PEICompleto | null = null;\n\n      // Call Gemini API on backend with timeout\n      try {\n        const timeoutPromise = new Promise((_, reject) =>\n          setTimeout(() => reject(new Error(\'Timeout\')), 7000)\n        );\n\n        const fetchPromise = fetch(\'/api/gemini/generate-pei\', {\n          method: \'POST\',\n          headers: {\n            \'Content-Type\': \'application/json\',\n            Accept: \'application/json\',\n          },\n          body: JSON.stringify({\n            studentName: nome.trim(),\n            grade: modulo.trim(),\n            course: curso.trim(),\n            subject: disciplina.trim(),\n            barriers: condicao.trim(),\n            potentialities: potencialidades.trim(),\n            assistiveTech: assistiveTech.trim(),\n            docenteRegente: docenteRegente.trim(),\n            docenteAee: docenteAee.trim(),\n            age: idade.trim(),\n            perfilModalidade,\n            statusDiagnostico,\n            campus: \'Campus Para\303\255so\',\n            selectedIds: selectedSolucoes,\n            selectedNeurodivergences: selectedSolucoes\n              .map((sid) => bancoDeSolucoesPedagogicas.find((s) => s.id === sid)?.titulo)\n              .filter(Boolean),\n          }),\n        });\n\n        setStepMessage(`2/3: Mapeando Tecnologias Assistivas e acomoda\303\247\303\265es de laborat\303\263rio para ${modalidadeDesc}...`);\n\n        const response: any = await Promise.race([fetchPromise, timeoutPromise]);\n        const contentType = response.headers?.get(\'content-type\') || \'\';\n\n        if (contentType.includes(\'application/json\')) {\n          const resData = await response.json();\n          if (resData.success && resData.data) {\n            const gen = resData.data;\n\n            setStepMessage(`3/3: Estruturando Metas SMART e DUA 3.0 alinhados a ${modalidadeDesc}...`);\n\n            finalPei = {\n              id: `PEI-${Date.now().toString().slice(-4)}`,\n              cabecalho: {\n                estudante: gen.cabecalho?.estudante || nome.trim(),\n                codigo_matricula:\n                  gen.cabecalho?.codigo_matricula ||\n                  matricula.trim() ||\n                  `TI-${Math.floor(1000 + Math.random() * 9000)}`,\n                idade: idade.trim(),\n                curso: gen.cabecalho?.curso || curso.trim(),\n                componente_curricular: gen.cabecalho?.componente_curricular || disciplina.trim(),\n                modulo_periodo: gen.cabecalho?.modulo_periodo || modulo.trim(),\n                data_elaboracao: new Date().toISOString().split(\'T\')[0],\n                docente_regente: docenteRegente.trim(),\n                docente_aee: docenteAee.trim(),\n                profissional_apoio:\n                  perfilModalidade === \'superior_ti\'\n                    ? \'Monitor de Acessibilidade Digital\'\n                    : \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\n                coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n              },\n              historico_napne: {\n                status_diagnostico: statusDiagnostico,\n                categoria_neurodivergencia:\n                  statusDiagnostico === \'em_investigacao_hipotese\'\n                    ? `Hip\303\263tese Diagn\303\263stica (${categoriaNeurodivergencia}) \302\267 Portaria MEC n\302\272 421/2026`\n                    : categoriaNeurodivergencia || \'Diagn\303\263stico Confirmado em Prontu\303\241rio NAPNE\',\n                cid_ou_hipotese:\n                  statusDiagnostico === \'em_investigacao_hipotese\'\n                    ? \'Em investiga\303\247\303\243o pedag\303\263gica multiprofissional pelo NAPNE Campus Para\303\255so\'\n                    : \'Laudo pericial m\303\251dico arquivado no prontu\303\241rio do NAPNE\',\n                breve_historico_clinico_familiar:\n                  gen.historico_e_condicao_napne?.breve_historico_clinico_familiar ||\n                  `Estudante do ${curso.trim()} no Campus Para\303\255so (${modalidadeDesc}). Acompanhamento pedag\303\263gico individualizado nos termos do Decreto n\302\272 12.686/2025 e Portaria MEC n\302\272 421/2026.${\n                    statusDiagnostico === \'em_investigacao_hipotese\'\n                      ? \' Atendimento garantido sem exig\303\252ncia de laudo m\303\251dico pericial pr\303\251vio.\'\n                      : \'\'\n                  }`,\n                descricao_condicao_especifica:\n                  gen.historico_e_condicao_napne?.descricao_condicao_especifica || condicao.trim(),\n                informacoes_dos_pais:\n                  gen.historico_e_condicao_napne?.informacoes_dos_pais ||\n                  (perfilModalidade === \'superior_ti\'\n                    ? \'Estudante com autonomia acad\303\252mica universit\303\241ria em contato com o NAPNE e coordena\303\247\303\243o do curso.\'\n                    : \'Estudante e respons\303\241veis em contato constante com o NAPNE Campus Para\303\255so e coordena\303\247\303\243o do curso.\'),\n              },\n              estudo_de_caso: {\n                barreiras: (gen.estudo_de_caso_sintese?.barreiras_identificadas || []).map(\n                  (bText: string, i: number) => ({\n                    id: `B${i + 1}`,\n                    categoria: \'metodologica\',\n                    descricao: bText,\n                    impacto: \'Dificuldade de participa\303\247\303\243o equ\303\242nime na aus\303\252ncia de recursos adaptados.\',\n                    estrategia_enfrentamento: \'Elimina\303\247\303\243o da barreira atrav\303\251s do DUA 3.0 e Tecnologias Assistivas.\',\n                  })\n                ),\n                potencialidades: (gen.estudo_de_caso_sintese?.potencialidades_interesses || []).map(\n                  (pText: string, i: number) => ({\n                    id: `P${i + 1}`,\n                    area: \'\303\201rea T\303\251cnica e Pensamento Computacional\',\n                    descricao: pText,\n                    apoio_demandado: \'Mobiliza\303\247\303\243o pedag\303\263gica nas aulas te\303\263ricas e pr\303\241ticas de laborat\303\263rio.\',\n                  })\n                ),\n                recursos_ta: gen.estudo_de_caso_sintese?.recursos_tecnologia_assistiva || [\n                  assistiveTech.trim() || \'Recursos de Tecnologia Assistiva e tempo ampliado\',\n                ],\n                sintese_observacao: {\n                  interacao_professores: \'Participativo e reflexivo nas discuss\303\265es conceituais.\',\n                  interacao_colegas: \'Excelente integra\303\247\303\243o em metodologias ativas e pareamento.\',\n                  tarefas_coletivas: \'Contribui de forma ativa na arquitetura e documenta\303\247\303\243o de projetos.\',\n                  interesses_centrais: disciplina.trim(),\n                  habilidades_tecnicas: \'Pensamento computacional e capacidade l\303\263gica.\',\n                  autonomia_rotina: \'Autonomia com suporte das acomoda\303\247\303\265es recomendadas.\',\n                },\n              },\n              planejamento_pei: {\n                conteudo_ementa_oficial:\n                  gen.planejamento_pedagogico_pei?.conteudo_ementa_oficial ||\n                  `Ementa Oficial: ${disciplina.trim()}. Fundamentos te\303\263ricos e pr\303\241ticas de desenvolvimento no ${curso.trim()}.`,\n                competencias_habilidades_ementa:\n                  gen.planejamento_pedagogico_pei?.competencias_habilidades_ementa ||\n                  `Desenvolver compet\303\252ncias de an\303\241lise, modelagem e codifica\303\247\303\243o em ${disciplina.trim()}.`,\n                adaptacao_flexibilizacao_curricular:\n                  gen.planejamento_pedagogico_pei?.adaptacao_flexibilizacao_curricular ||\n                  `Curr\303\255culo integral (${modalidadeDesc}) sem redu\303\247\303\265es conceituais. Acessibilidade metodol\303\263gica garantida pelo DUA 3.0.`,\n                objetivos_e_metas: (gen.planejamento_pedagogico_pei?.objetivos_e_metas_adaptadas || []).map(\n                  (m: any) => ({\n                    id_meta: m.id_meta || \'M1\',\n                    descricao_meta: m.descricao_meta,\n                    prazo: m.prazo || \'Mensal (4 semanas)\',\n                    indicador_sucesso: m.indicador_sucesso,\n                    progresso_percentual: 50,\n                    status: \'em_andamento\',\n                  })\n                ),\n                flexibilizacao_metodologica_dua: {\n                  engajamento: gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.engajamento || [\n                    perfilModalidade === \'superior_ti\'\n                      ? \'Projetos aplicados corporativos com metodologia \303\241gil Kanban/GitHub e sustenta\303\247\303\243o oral.\'\n                      : \'Projetos pr\303\241ticos no laborat\303\263rio com Pair Programming e impacto na comunidade.\',\n                  ],\n                  representacao: gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.representacao || [\n                    \'Disponibiliza\303\247\303\243o antecipada de roteiros em Markdown e tutoriais passo a passo.\',\n                  ],\n                  acao_e_expressao: gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.acao_e_expressao || [\n                    \'Tempo estendido (+50%) e entrega cont\303\255nua em reposit\303\263rio Git com crit\303\251rios anal\303\255ticos.\',\n                  ],\n                },\n                gestao_sala_de_aula: {\n                  organizacao_espacial:\n                    \'Bancada de laborat\303\263rio acess\303\255vel com layout ergon\303\264mico e espa\303\247o amplo para circula\303\247\303\243o.\',\n                  rotina_e_pausas:\n                    \'Pausas programadas a cada 45-60 minutos para preven\303\247\303\243o de fadiga f\303\255sica e sensorial.\',\n                  agrupamentos_e_tutoria:\n                    perfilModalidade === \'superior_ti\'\n                      ? \'Projetos colaborativos em equipe \303\241gil (Sprints/Kanban) e orienta\303\247\303\243o t\303\251cnica individualizada.\'\n                      : \'Trabalho em duplas colaborativas (Pair Programming: piloto e copiloto) e tutoria orientada.\',\n                  suporte_docente_semanal:\n                    \'Sess\303\243o semanal de alinhamento pedag\303\263gico entre o docente de TI e o NAPNE Campus Para\303\255so.\',\n                },\n                estrategias_avaliacao: {\n                  formato_acessivel:\n                    gen.planejamento_pedagogico_pei?.estrategias_de_avaliacao?.formato_acessivel ||\n                    \'Avalia\303\247\303\243o processual formativa com projetos em etapas e tempo estendido (+50%).\',\n                  criterio_de_sucesso:\n                    gen.planejamento_pedagogico_pei?.estrategias_de_avaliacao?.criterio_de_sucesso ||\n                    \'Compreens\303\243o substantiva da l\303\263gica e dos conceitos t\303\251cnicos exigidos na ementa.\',\n                  grau_mediacao: \'pouca_mediacao\',\n                  tempo_e_espaco: \'Tempo estendido (+50%) em laborat\303\263rio com recursos de TA.\',\n                  recursos_utilizados:\n                    gen.estudo_de_caso_sintese?.recursos_tecnologia_assistiva || [\n                      \'Perfil de acessibilidade no ambiente de desenvolvimento\',\n                      \'Tempo estendido (+50%)\',\n                    ],\n                },\n                observacoes_docente: `PEI gerado pelo agente Ioda para ${nome.trim()} no NAPNE Campus Para\303\255so (${modalidadeDesc}), com fundamenta\303\247\303\243o na Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.`,\n              },\n              painel_notas: [\n                {\n                  id: `N_auto_${Date.now()}`,\n                  autor: docenteRegente.trim(),\n                  papel: \'Regente\',\n                  categoria: \'objetivos\',\n                  conteudo: `In\303\255cio do acompanhamento pedag\303\263gico inclusivo com Ioda AI para ${disciplina.trim()} (${modalidadeDesc}) no Campus Para\303\255so.`,\n                  data: new Date().toLocaleDateString(\'pt-BR\'),\n                  cor: \'green\',\n                },\n              ],\n              metricas: {\n                percentual_metas_alcancadas: 45,\n                nivel_autonomia: 4,\n                engajamento: 5,\n                sessoes_semanais_realizadas: 4,\n                status_geral: \'EM_ANDAMENTO\',\n              },\n              parecer_pedagogico: `PEI estruturado pelo agente Ioda para o perfil ${modalidadeDesc} em conson\303\242ncia com a Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.`,\n              sugestoes_proximo_ciclo: [\n                \'Manter as sess\303\265es semanais de suporte pedag\303\263gico com o NAPNE Campus Para\303\255so.\',\n                `Avan\303\247ar para projeto pr\303\241tico integrador de ${modalidadeDesc} no per\303\255odo seguinte.`,\n              ],\n            };\n          }\n        }\n      } catch (_err) {\n        console.log(\'[Ioda Frontend] S\303\255ntese resiliente do PEI ativada via Motor Pedag\303\263gico Ioda.\');\n      }\n\n      // If remote call failed or timed out, synthesize with zero latency via local Ioda engine\n      if (!finalPei) {\n        finalPei = gerarNovoPeiCompleto({\n          nome: nome.trim(),\n          matricula: matricula.trim(),\n          idade: idade.trim(),\n          curso: curso.trim(),\n          disciplina: disciplina.trim(),\n          modulo: modulo.trim(),\n          condicao: condicao.trim() || \'Barreiras observadas no laborat\303\263rio de inform\303\241tica.\',\n          docenteRegente: docenteRegente.trim(),\n          docenteAee: docenteAee.trim(),\n          solucaoBaseId: selectedSolucoes[0] || \'sol-tdah\',\n          solucaoBaseIds: selectedSolucoes,\n          statusDiagnostico,\n          categoriaNeurodivergencia,\n        });\n      }\n\n      onAddStudent(finalPei);\n      onClose();\n    } finally {\n      setIsGenerating(false);\n      setStepMessage(\'\');\n    }\n  };\n\n  // Filter solutions that match current profile\n  const filteredSolutions = bancoDeSolucoesPedagogicas.filter((sol) => {\n    if (perfilModalidade === \'medio_tecnico\') {\n      return sol.nivelSugerido === \'M\303\251dio T\303\251cnico\' || sol.nivelSugerido === \'Ambos\';\n    }\n    return sol.nivelSugerido === \'Superior TI\' || sol.nivelSugerido === \'Ambos\';\n  });\n\n  return (\n    <div className=\"fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto\">\n      <div className=\"bg-white rounded-2xl max-w-3xl w-full p-4 sm:p-6 shadow-2xl border border-slate-200 my-4 max-h-[94vh] flex flex-col overflow-hidden\">\n        {/* Header with Title and DUA 3.0 Inline Accessibility Controls */}\n        <div className=\"flex items-center justify-between pb-3.5 border-b border-slate-100 shrink-0\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-800 shadow-xs\">\n              <UserPlus className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <h3 className=\"text-sm sm:text-base font-bold text-slate-900 leading-tight\">\n                  Assistente de Elabora\303\247\303\243o do PEI \302\267 Ioda\n                </h3>\n                <span className=\"text-[10px] bg-emerald-100 text-emerald-900 font-semibold px-2 py-0.2 rounded font-mono\">\n                  DUA 3.0\n                </span>\n              </div>\n              <span className=\"text-[11px] text-slate-500\">\n                Preenchimento sequencial com revela\303\247\303\243o progressiva (Portaria MEC n\302\272 421/2026)\n              </span>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-2\">\n            {/* Quick DUA 3.0 Visual Preferences Toolbar */}\n            {onMudarFonte && onMudarContraste && (\n              <div className=\"hidden sm:flex items-center gap-1 bg-slate-100 p-1 rounded-lg border border-slate-200\">\n                <button\n                  type=\"button\"\n                  onClick={() => onMudarFonte(escalaFonteAtual === \'normal\' ? \'ampliada\' : escalaFonteAtual === \'ampliada\' ? \'grande\' : \'normal\')}\n                  className=\"px-1.5 py-0.5 text-[10px] font-bold text-slate-700 hover:bg-white rounded transition-colors\"\n                  title=\"Ajustar tamanho da fonte\"\n                >\n                  <Type className=\"w-3 h-3 inline mr-0.5\" />\n                  {escalaFonteAtual === \'normal\' ? \'A\' : escalaFonteAtual === \'ampliada\' ? \'A+\' : \'A++\'}\n                </button>\n                <div className=\"w-px h-3 bg-slate-300 mx-0.5\" />\n                <button\n                  type=\"button\"\n                  onClick={() => onMudarContraste(modoContrasteAtual === \'padrao\' ? \'conforto\' : modoContrasteAtual === \'conforto\' ? \'alto-contraste\' : \'padrao\')}\n                  className=\"px-1.5 py-0.5 text-[10px] font-medium text-slate-700 hover:bg-white rounded transition-colors\"\n                  title=\"Alternar contraste / tema visual\"\n                >\n                  <Eye className=\"w-3 h-3 inline mr-0.5 text-emerald-700\" />\n                  {modoContrasteAtual === \'padrao\' ? \'Padr\303\243o\' : modoContrasteAtual === \'conforto\' ? \'Conforto\' : \'Contraste\'}\n                </button>\n              </div>\n            )}\n\n            <button\n              onClick={onClose}\n              disabled={isGenerating}\n              className=\"p-1 text-slate-400 hover:text-slate-600 rounded-lg cursor-pointer disabled:opacity-50\"\n              title=\"Fechar assistente\"\n            >\n              <X className=\"w-5 h-5\" />\n            </button>\n          </div>\n        </div>\n\n        {/* STEPPER WIZARD: Progressive Disclosure Visual Steps */}\n        <div className=\"py-3 px-1 border-b border-slate-100 shrink-0 bg-slate-50/50 -mx-4 sm:-mx-6 px-4 sm:px-6\">\n          <div className=\"grid grid-cols-4 gap-2 text-center\">\n            {/* Step 1 */}\n            <button\n              type=\"button\"\n              onClick={() => !isGenerating && setCurrentStep(1)}\n              className={`flex items-center justify-center gap-1.5 p-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                currentStep === 1\n                  ? \'bg-emerald-800 text-white shadow-xs\'\n                  : currentStep > 1\n                  ? \'bg-emerald-50 text-emerald-900 border border-emerald-200\'\n                  : \'bg-white text-slate-500 border border-slate-200\'\n              }`}\n            >\n              <span className={`w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold ${currentStep === 1 ? \'bg-white text-emerald-900\' : currentStep > 1 ? \'bg-emerald-700 text-white\' : \'bg-slate-200 text-slate-700\'}`}>\n                {currentStep > 1 ? <Check className=\"w-2.5 h-2.5\" /> : \'1\'}\n              </span>\n              <span className=\"truncate hidden sm:inline\">1. Perfil & Caso</span>\n              <span className=\"sm:hidden\">1</span>\n            </button>\n\n            {/* Step 2 */}\n            <button\n              type=\"button\"\n              onClick={() => !isGenerating && setCurrentStep(2)}\n              className={`flex items-center justify-center gap-1.5 p-1.5 rounded-lg text-xs font-semibold transition-all cursor-pointer ${\n                currentStep === 2\n                  ? \'bg-emerald-800 text-white shadow-xs\'\n                  : currentStep > 2\n                  ? \'bg-emerald-50 text-emerald-900 border border-emerald-200\'\n                  : \'bg-white text-slate-500 border border-slate-200\'\n              }`}\n            >\n              <span className={`w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold ${currentStep === 2 ? \'bg-white text-emerald-900\' : currentStep > 2 ? \'bg-emerald-700 text-white\' : \'bg-slate-200 text-slate-700\'}`}>\n                {currentStep > 2 ? <Check className=\"w-2.5 h-2.5\" /> : \'2\'}\n              </span>\n              <span className=\"truncate hidden sm:inline\">2. Identifica\303\247\303\243o</span>\n              <span className=\"sm:hidden\">2</span>\n            </button>\n\n            {/* Step 3 */}\n            <button\n              type=\"button\"\n              onClick={() => !isGenerating && isStep2Valid && setCurrentStep(3)}\n              disabled={!isStep2Valid}\n              className={`flex items-center justify-center gap-1.5 p-1.5 rounded-lg text-xs font-semibold transition-all ${\n                !isStep2Valid ? \'opacity-50 cursor-not-allowed\' : \'cursor-pointer\'\n              } ${\n                currentStep === 3\n                  ? \'bg-emerald-800 text-white shadow-xs\'\n                  : currentStep > 3\n                  ? \'bg-emerald-50 text-emerald-900 border border-emerald-200\'\n                  : \'bg-white text-slate-500 border border-slate-200\'\n              }`}\n            >\n              <span className={`w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold ${currentStep === 3 ? \'bg-white text-emerald-900\' : currentStep > 3 ? \'bg-emerald-700 text-white\' : \'bg-slate-200 text-slate-700\'}`}>\n                {currentStep > 3 ? <Check className=\"w-2.5 h-2.5\" /> : \'3\'}\n              </span>\n              <span className=\"truncate hidden sm:inline\">3. Barreiras & DUA</span>\n              <span className=\"sm:hidden\">3</span>\n            </button>\n\n            {/* Step 4 */}\n            <button\n              type=\"button\"\n              onClick={() => !isGenerating && isStep2Valid && setCurrentStep(4)}\n              disabled={!isStep2Valid}\n              className={`flex items-center justify-center gap-1.5 p-1.5 rounded-lg text-xs font-semibold transition-all ${\n                !isStep2Valid ? \'opacity-50 cursor-not-allowed\' : \'cursor-pointer\'\n              } ${\n                currentStep === 4\n                  ? \'bg-emerald-800 text-white shadow-xs\'\n                  : \'bg-white text-slate-500 border border-slate-200\'\n              }`}\n            >\n              <span className={`w-4 h-4 rounded-full flex items-center justify-center text-[10px] font-bold ${currentStep === 4 ? \'bg-white text-emerald-900\' : \'bg-slate-200 text-slate-700\'}`}>\n                4\n              </span>\n              <span className=\"truncate hidden sm:inline\">4. Revis\303\243o & IA</span>\n              <span className=\"sm:hidden\">4</span>\n            </button>\n          </div>\n\n          {/* Stepper Progress Line */}\n          <div className=\"w-full bg-slate-200 h-1 rounded-full mt-2 overflow-hidden\">\n            <div\n              className=\"bg-emerald-700 h-full transition-all duration-300\"\n              style={{\n                width: currentStep === 1 ? \'25%\' : currentStep === 2 ? \'50%\' : currentStep === 3 ? \'75%\' : \'100%\',\n              }}\n            />\n          </div>\n        </div>\n\n        {/* STEP CONTENT BODY (Scrollable, progressive disclosure) */}\n        <div className=\"flex-1 overflow-y-auto py-4 px-1 space-y-4\">\n          {/* ============================================================== */}\n          {/* ETAPA 1: PERFIL INSTITUCIONAL & CASOS DE REFER\303\212NCIA           */}\n          {/* ============================================================== */}\n          {currentStep === 1 && (\n            <div className=\"space-y-4 animate-fadeIn\">\n              <div className=\"p-3 bg-emerald-50/70 border border-emerald-200 rounded-xl flex items-start gap-2.5\">\n                <Info className=\"w-4 h-4 text-emerald-800 shrink-0 mt-0.5\" />\n                <div className=\"text-xs text-emerald-950\">\n                  <strong>Etapa 1 de 4 \302\267 Sele\303\247\303\243o de Modalidade e Benchmark:</strong> Escolha o n\303\255vel de ensino para que o agente Ioda calibre os objetivos curriculares (BNCC T\303\251cnica vs Autonomia no Ensino Superior) e selecione casos de refer\303\252ncia reais do Campus Para\303\255so.\n                </div>\n              </div>\n\n              {/* Profile Card Selection */}\n              <div>\n                <label className=\"text-xs font-bold text-slate-800 uppercase tracking-wider block mb-2\">\n                  Selecione a Modalidade do Estudante:\n                </label>\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                  {/* Option 1: M\303\251dio T\303\251cnico */}\n                  <button\n                    type=\"button\"\n                    onClick={() => handleSelectProfile(\'medio_tecnico\')}\n                    className={`p-3.5 rounded-xl border-2 text-left transition-all cursor-pointer relative ${\n                      perfilModalidade === \'medio_tecnico\'\n                        ? \'bg-emerald-50 border-emerald-700 shadow-sm ring-1 ring-emerald-700\'\n                        : \'bg-white border-slate-200 hover:border-slate-300\'\n                    }`}\n                  >\n                    <div className=\"flex items-start justify-between\">\n                      <div className=\"flex items-center gap-2\">\n                        <div className={`p-2 rounded-lg ${perfilModalidade === \'medio_tecnico\' ? \'bg-emerald-700 text-white\' : \'bg-slate-100 text-slate-600\'}`}>\n                          <Laptop className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"font-bold text-slate-900 text-sm\">M\303\251dio T\303\251cnico em TI</h4>\n                          <span className=\"text-[11px] text-slate-500 font-medium\">Integrado em Inform\303\241tica</span>\n                        </div>\n                      </div>\n                      {perfilModalidade === \'medio_tecnico\' && (\n                        <CheckCircle className=\"w-5 h-5 text-emerald-700 shrink-0 mt-0.5\" />\n                      )}\n                    </div>\n                    <p className=\"text-xs text-slate-600 mt-2.5 leading-relaxed\">\n                      Articula\303\247\303\243o com a BNCC, laborat\303\263rios pr\303\241ticos, duplas de <em>Pair Programming</em> (piloto e copiloto) e suporte de monitoria escolar.\n                    </p>\n                    <div className=\"mt-2.5 pt-2 border-t border-slate-200 text-[11px] text-emerald-900 font-semibold flex items-center justify-between\">\n                      <span>15 alunos no Campus Para\303\255so</span>\n                      <span className=\"font-mono text-[10px]\">1\302\272 ao 3\302\272 Ano T\303\251cnico</span>\n                    </div>\n                  </button>\n\n                  {/* Option 2: Superior em TI */}\n                  <button\n                    type=\"button\"\n                    onClick={() => handleSelectProfile(\'superior_ti\')}\n                    className={`p-3.5 rounded-xl border-2 text-left transition-all cursor-pointer relative ${\n                      perfilModalidade === \'superior_ti\'\n                        ? \'bg-emerald-50 border-emerald-700 shadow-sm ring-1 ring-emerald-700\'\n                        : \'bg-white border-slate-200 hover:border-slate-300\'\n                    }`}\n                  >\n                    <div className=\"flex items-start justify-between\">\n                      <div className=\"flex items-center gap-2\">\n                        <div className={`p-2 rounded-lg ${perfilModalidade === \'superior_ti\' ? \'bg-emerald-700 text-white\' : \'bg-slate-100 text-slate-600\'}`}>\n                          <GraduationCap className=\"w-4 h-4\" />\n                        </div>\n                        <div>\n                          <h4 className=\"font-bold text-slate-900 text-sm\">Superior em TI</h4>\n                          <span className=\"text-[11px] text-slate-500 font-medium\">Sistemas de Informa\303\247\303\243o & Gest\303\243o</span>\n                        </div>\n                      </div>\n                      {perfilModalidade === \'superior_ti\' && (\n                        <CheckCircle className=\"w-5 h-5 text-emerald-700 shrink-0 mt-0.5\" />\n                      )}\n                    </div>\n                    <p className=\"text-xs text-slate-600 mt-2.5 leading-relaxed\">\n                      Autonomia acad\303\252mica, abstra\303\247\303\243o l\303\263gica avan\303\247ada, micro-sprints \303\241geis (Kanban/GitHub), terminal CLI acess\303\255vel e modelagem de dados.\n                    </p>\n                    <div className=\"mt-2.5 pt-2 border-t border-slate-200 text-[11px] text-emerald-900 font-semibold flex items-center justify-between\">\n                      <span>14 alunos no Campus Para\303\255so</span>\n                      <span className=\"font-mono text-[10px]\">Gradua\303\247\303\243o / TI</span>\n                    </div>\n                  </button>\n                </div>\n              </div>\n\n              {/* Privacy & Legal Compliance Banner (LGPD & Portaria MEC 421/2026) */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n                <div className=\"flex items-start gap-2.5\">\n                  <ShieldCheck className=\"w-4 h-4 text-emerald-800 shrink-0 mt-0.5\" />\n                  <div className=\"text-xs text-slate-700 leading-relaxed\">\n                    <strong>Privacidade & Prote\303\247\303\243o de Dados (LGPD):</strong> Em estrito cumprimento \303\240 Lei n\302\272 13.709/2018 (LGPD) e ao Decreto n\302\272 12.686/2025 (Art. 12, \302\2475\302\272), as informa\303\247\303\265es pedag\303\263gicas do estudante s\303\243o mantidas sob absoluto sigilo institucional. O PEI foca exclusivamente na elimina\303\247\303\243o de barreiras escolares no laborat\303\263rio de inform\303\241tica.\n                  </div>\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* ============================================================== */}\n          {/* ETAPA 2: IDENTIFICA\303\207\303\203O DO ESTUDANTE & COMPONENTE              */}\n          {/* ============================================================== */}\n          {currentStep === 2 && (\n            <div className=\"space-y-4 animate-fadeIn\">\n              <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl flex items-start gap-2.5\">\n                <Info className=\"w-4 h-4 text-slate-600 shrink-0 mt-0.5\" />\n                <div className=\"text-xs text-slate-700\">\n                  <strong>Etapa 2 de 4 \302\267 Identifica\303\247\303\243o B\303\241sica:</strong> Preencha os dados do estudante e a disciplina de computa\303\247\303\243o. Os campos de curso e m\303\263dulo j\303\241 foram calibrados para <em>{perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico\'}</em>.\n                </div>\n              </div>\n\n              {/* Card A: Dados Pessoais do Aluno */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\">\n                <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5\">\n                  <UserPlus className=\"w-3.5 h-3.5 text-emerald-700\" />\n                  <span>Dados do Estudante:</span>\n                </h4>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <div className=\"sm:col-span-2\">\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Nome Completo do Estudante <span className=\"text-red-500\">*</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={nome}\n                      onChange={(e) => setNome(e.target.value)}\n                      placeholder=\"Ex: Gabriel Moreira Silva\"\n                      className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                      required\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Matr\303\255cula / C\303\263digo\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={matricula}\n                      onChange={(e) => setMatricula(e.target.value)}\n                      placeholder=\"Ex: 2026.1.INF.092\"\n                      className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                    />\n                  </div>\n                </div>\n\n                <div className=\"w-full sm:w-1/3\">\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Idade / Faixa Et\303\241ria\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={idade}\n                    onChange={(e) => setIdade(e.target.value)}\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                  />\n                </div>\n              </div>\n\n              {/* Card B: Componente Curricular de TI */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\">\n                <div className=\"flex items-center justify-between\">\n                  <h4 className=\"text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center gap-1.5\">\n                    <Laptop className=\"w-3.5 h-3.5 text-emerald-700\" />\n                    <span>Componente Curricular & Curso de TI:</span>\n                  </h4>\n                  <span className=\"text-[10px] text-emerald-800 bg-emerald-50 px-2 py-0.5 rounded border border-emerald-200 font-mono\">\n                    PPC BSI & Plano de Ensino IFTO\n                  </span>\n                </div>\n\n                {/* Quick Presets from PPC do BSI and Plano de Ensino in attachment */}\n                <div className=\"p-2.5 bg-white border border-slate-200 rounded-lg space-y-1.5\">\n                  <span className=\"text-[11px] font-bold text-slate-700 block\">\n                    Sugest\303\265es R\303\241pidas de Disciplinas do Campus Para\303\255so (PPC / Anexo):\n                  </span>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-1.5\">\n                    {presetsPpcEPlano.map((p) => {\n                      const isCurrent = disciplina === p.titulo;\n                      return (\n                        <button\n                          key={p.id}\n                          type=\"button\"\n                          onClick={() => handleApplyCoursePreset(p)}\n                          className={`p-2 rounded-lg border text-left transition-all cursor-pointer ${\n                            isCurrent\n                              ? \'bg-emerald-50 border-emerald-600 shadow-xs ring-1 ring-emerald-600\'\n                              : \'bg-slate-50/70 border-slate-200 hover:border-slate-300 hover:bg-white\'\n                          }`}\n                        >\n                          <div className=\"flex items-center justify-between\">\n                            <span className=\"text-xs font-bold text-slate-900 truncate\">{p.titulo}</span>\n                            <span className=\"text-[9px] px-1.5 py-0.2 rounded font-mono font-medium bg-emerald-100 text-emerald-900 shrink-0 ml-1\">\n                              {p.tag}\n                            </span>\n                          </div>\n                          <span className=\"text-[10px] text-slate-500 block truncate mt-0.5\">\n                            {p.docente} \302\267 {p.modulo}\n                          </span>\n                        </button>\n                      );\n                    })}\n                  </div>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <div className=\"sm:col-span-2\">\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Curso de TI <span className=\"text-red-500\">*</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={curso}\n                      onChange={(e) => setCurso(e.target.value)}\n                      className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                      required\n                    />\n                  </div>\n\n                  <div"
