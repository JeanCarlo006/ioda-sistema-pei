            lines {
              text: "    titulo: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    condicao: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',"
