  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { PEICompleto } from \'../types/pei\';\nimport {\n  ShieldAlert,\n  Building2,\n  PackagePlus,\n  Users2,\n  Share2,\n  CalendarDays,\n  CheckCircle2,\n  Clock,\n  Sparkles,\n} from \'lucide-react\';\n\ninterface PaeeViewProps {\n  pei: PEICompleto;\n}\n\nexport const PaeeView: React.FC<PaeeViewProps> = ({ pei }) => {\n  const { plano_aee, cabecalho } = pei;\n\n  return (\n    <div className=\"space-y-8\">\n      {/* PAEE Header & Legal Reference */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-5 sm:p-6 shadow-xs\">\n        <div className=\"flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 pb-4 border-b border-slate-100 mb-5\">\n          <div>\n            <span className=\"text-xs font-semibold text-emerald-800 uppercase tracking-wider block\">\n              Documento Obrigat\303\263rio da PNEEI \302\267 Portaria MEC n\302\272 421/2026 Art. 10\n            </span>\n            <h2 className=\"text-lg sm:text-xl font-bold tracking-tight text-slate-900 mt-1\">\n              Plano de Atendimento Educacional Especializado (PAEE)\n            </h2>\n            <p className=\"text-xs sm:text-sm text-slate-500 mt-1\">\n              Organiza\303\247\303\243o dos servi\303\247os de AEE, provis\303\243o de Tecnologia Assistiva, articula\303\247\303\243o colaborativa e intersetorialidade\n            </p>\n          </div>\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-xs bg-emerald-50 text-emerald-800 border border-emerald-200 px-3 py-1 rounded-md font-medium\">\n              Vig\303\252ncia: 2\302\272 Semestre/2026\n            </span>\n          </div>\n        </div>\n\n        {/* SRM Organization */}\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n            <span className=\"text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-1\">\n              Frequ\303\252ncia & Locais de Atendimento\n            </span>\n            <p className=\"text-xs sm:text-sm font-semibold text-slate-900\">\n              {plano_aee.organizacao_srm.frequencia}\n            </p>\n          </div>\n\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n            <span className=\"text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-1\">\n              Dura\303\247\303\243o & Composi\303\247\303\243o\n            </span>\n            <p className=\"text-xs sm:text-sm font-semibold text-slate-900\">\n              {plano_aee.organizacao_srm.duracao_minutos} minutos por sess\303\243o \302\267 Atendimento Individual & Pequeno Grupo\n            </p>\n          </div>\n\n          <div className=\"p-4 bg-slate-50 rounded-xl border border-slate-200\">\n            <span className=\"text-[11px] font-bold text-slate-500 uppercase tracking-wider block mb-1\">\n              Espa\303\247o F\303\255sico Credenciado\n            </span>\n            <p className=\"text-xs sm:text-sm font-semibold text-slate-900\">\n              {plano_aee.organizacao_srm.espaco_atuacao}\n            </p>\n          </div>\n        </div>\n      </div>\n\n      {/* Articula\303\247\303\243o Ensino Comum + Sess\303\265es de Suporte Semanal */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-5 sm:p-6 shadow-xs\">\n        <div className=\"flex items-center gap-2 pb-4 border-b border-slate-100 mb-5\">\n          <Users2 className=\"w-5 h-5 text-emerald-700\" />\n          <h3 className=\"text-base font-bold text-slate-900\">\n            Articula\303\247\303\243o com Professores do Ensino Comum & Profissional de Apoio\n          </h3>\n        </div>\n\n        <div className=\"grid grid-cols-1 lg:grid-cols-2 gap-6\">\n          <div className=\"space-y-3\">\n            <div>\n              <label className=\"text-xs font-bold text-slate-700 uppercase tracking-wider block mb-1\">\n                Objetivo do Trabalho Colaborativo\n              </label>\n              <p className=\"text-xs sm:text-sm text-slate-700 bg-slate-50 p-3.5 rounded-lg border border-slate-200 leading-relaxed\">\n                {plano_aee.articulacao_ensino_comum.objetivos}\n              </p>\n            </div>\n\n            <div>\n              <label className=\"text-xs font-bold text-slate-700 uppercase tracking-wider block mb-1.5\">\n                Profissionais Orientados Continuamente pelo AEE\n              </label>\n              <ul className=\"space-y-1.5 text-xs text-slate-700\">\n                {plano_aee.articulacao_ensino_comum.profissionais_orientados.map((prof, idx) => (\n                  <li key={idx} className=\"flex items-center gap-2 p-2 bg-slate-50 rounded border border-slate-100\">\n                    <CheckCircle2 className=\"w-3.5 h-3.5 text-emerald-600 shrink-0\" />\n                    <span>{prof}</span>\n                  </li>\n                ))}\n              </ul>\n            </div>\n          </div>\n\n          {/* User Request Requirement: Sess\303\265es de suporte semanal */}\n          <div className=\"p-5 bg-gradient-to-br from-emerald-50 to-teal-50/50 border border-emerald-200 rounded-xl space-y-3 flex flex-col justify-between\">\n            <div>\n              <div className=\"flex items-center gap-2 mb-2\">\n                <Clock className=\"w-5 h-5 text-emerald-800\" />\n                <h4 className=\"text-sm font-bold text-emerald-950\">\n                  Sess\303\265es de Suporte Semanal Institucionalizadas\n                </h4>\n              </div>\n              <p className=\"text-xs sm:text-sm text-emerald-900 leading-relaxed\">\n                {plano_aee.articulacao_ensino_comum.sessoes_suporte_semanal}\n              </p>\n            </div>\n\n            <div className=\"p-3 bg-white/80 rounded-lg border border-emerald-200 text-xs text-emerald-950 space-y-1\">\n              <strong className=\"block font-semibold\">Garantia Pedag\303\263gica:</strong>\n              <span>\n                Assegura o alinhamento de condutas entre as regentes de Matem\303\241tica e o profissional de apoio Jo\303\243o Pedro, impedindo lacunas na disponibiliza\303\247\303\243o dos materiais adaptados.\n              </span>\n            </div>\n          </div>\n        </div>\n      </div>\n\n      {/* Materiais e Tecnologia Assistiva (A Produzir vs A Adquirir) */}\n      <div className=\"grid grid-cols-1 md:grid-cols-2 gap-6\">\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs\">\n          <div className=\"flex items-center gap-2 pb-3 border-b border-slate-100 mb-4\">\n            <PackagePlus className=\"w-4 h-4 text-emerald-700\" />\n            <h3 className=\"text-sm font-bold text-slate-900\">\n              Materiais a Produzir pelo Professor de AEE\n            </h3>\n          </div>\n          <ul className=\"space-y-2 text-xs text-slate-700\">\n            {plano_aee.materiais_a_produzir.map((mat, i) => (\n              <li key={i} className=\"p-2.5 bg-slate-50 rounded-lg border border-slate-100 flex items-start gap-2\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-emerald-600 mt-1.5 shrink-0\" />\n                <span>{mat}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n\n        <div className=\"bg-white border border-slate-200 rounded-xl p-5 shadow-xs\">\n          <div className=\"flex items-center gap-2 pb-3 border-b border-slate-100 mb-4\">\n            <Building2 className=\"w-4 h-4 text-teal-700\" />\n            <h3 className=\"text-sm font-bold text-slate-900\">\n              Equipamentos & Recursos a Adquirir pela Escola (PDDE)\n            </h3>\n          </div>\n          <ul className=\"space-y-2 text-xs text-slate-700\">\n            {plano_aee.materiais_a_adquirir.map((eq, i) => (\n              <li key={i} className=\"p-2.5 bg-slate-50 rounded-lg border border-slate-100 flex items-start gap-2\">\n                <span className=\"w-1.5 h-1.5 rounded-full bg-teal-600 mt-1.5 shrink-0\" />\n                <span>{eq}</span>\n              </li>\n            ))}\n          </ul>\n        </div>\n      </div>\n\n      {/* Articula\303\247\303\243o com o N\303\272cleo Intersetorial */}\n      <div className=\"bg-white border border-slate-200 rounded-xl p-5 sm:p-6 shadow-xs\">\n        <div className=\"flex items-center justify-between pb-4 border-b border-slate-100 mb-5\">\n          <div className=\"flex items-center gap-2\">\n            <Share2 className=\"w-5 h-5 text-emerald-700\" />\n            <h3 className=\"text-base font-bold text-slate-900\">\n              Articula\303\247\303\243o com o N\303\272cleo Intersetorial & Rede de Prote\303\247\303\243o Social\n            </h3>\n          </div>\n          <span className=\"text-xs text-slate-500 font-mono\">\n            Caderno 12 PNEEI\n          </span>\n        </div>\n\n        <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n          <div className=\"p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n            <span className=\"text-xs font-bold text-slate-800 uppercase tracking-wider block\">\n              1. Eixo Sa\303\272de & Reabilita\303\247\303\243o\n            </span>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              {plano_aee.articulacao_intersetorial.saude}\n            </p>\n          </div>\n\n          <div className=\"p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n            <span className=\"text-xs font-bold text-slate-800 uppercase tracking-wider block\">\n              2. Eixo Assist\303\252ncia Social (CRAS)\n            </span>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              {plano_aee.articulacao_intersetorial.assistencia_social}\n            </p>\n          </div>\n\n          <div className=\"p-4 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n            <span className=\"text-xs font-bold text-slate-800 uppercase tracking-wider block\">\n              3. Eixo Transporte & Infraestrutura\n            </span>\n            <p className=\"text-xs text-slate-600 leading-relaxed\">\n              {plano_aee.articulacao_intersetorial.educacao_infraestrutura}\n            </p>\n          </div>\n        </div>\n\n        <div className=\"mt-5 pt-4 border-t border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-3 text-xs text-slate-500\">\n          <div className=\"flex items-center gap-2\">\n            <CalendarDays className=\"w-4 h-4 text-emerald-600\" />\n            <span>Ciclo de Monitoramento: <strong>{plano_aee.cronograma_revisao}</strong></span>\n          </div>\n          <span className=\"font-mono text-slate-400\">Respons\303\241vel T\303\251cnica: {cabecalho.docente_aee}</span>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/PaeeView.tsx"
        }
        overwrite: true
      }
    }
