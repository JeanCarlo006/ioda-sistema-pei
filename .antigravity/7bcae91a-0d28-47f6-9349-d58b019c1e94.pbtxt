        instruction: "import React, { useState } from \'react\';\nimport { PEICompleto } from \'../types/pei\';\nimport { estatisticasCampusParaiso } from \'../data/initialCases\';\nimport {\n  UserCheck,\n  BookOpen,\n  GraduationCap,\n  UserPlus,\n  Building2,\n  FileCheck2,\n  HelpCircle,\n  BarChart3,\n  Filter,\n} from \'lucide-react\';\n\ninterface StudentHeaderProps {\n  pei: PEICompleto;\n  allStudents: PEICompleto[];\n  onSelectCase: (selectedPei: PEICompleto) => void;\n  onOpenAddStudent: () => void;\n  onOpenCampusStats?: () => void;\n}\n\nexport const StudentHeader: React.FC<StudentHeaderProps> = ({\n  pei,\n  allStudents,\n  onSelectCase,\n  onOpenAddStudent,\n  onOpenCampusStats,\n}) => {\n  const [activeFilter, setActiveFilter] = useState<\'todos\' | \'medio\' | \'superior\' | \'confirmado\' | \'hipotese\'>(\'todos\');\n  const { cabecalho, metricas, historico_napne } = pei;\n  const stats = estatisticasCampusParaiso;\n\n  const getInitial = (name: string) => {\n    return name ? name.charAt(0).toUpperCase() : \'E\';\n  };\n\n  const isSuperior =\n    cabecalho.curso.toLowerCase().includes(\'superior\') ||\n    cabecalho.curso.toLowerCase().includes(\'sistemas\') ||\n    cabecalho.modulo_periodo.toLowerCase().includes(\'semestre\');\n\n  const isTecnico =\n    cabecalho.curso.toLowerCase().includes(\'t\303\251cnico\') ||\n    cabecalho.curso.toLowerCase().includes(\'tecnico\') ||\n    cabecalho.modulo_periodo.toLowerCase().includes(\'t\303\251cnico\');\n\n  const isHipotese = historico_napne.status_diagnostico === \'em_investigacao_hipotese\';\n\n  // Filter students based on selection\n  const filteredStudents = allStudents.filter((s) => {\n    const sSuperior =\n      s.cabecalho.curso.toLowerCase().includes(\'superior\') ||\n      s.cabecalho.curso.toLowerCase().includes(\'sistemas\');\n    const sTecnico =\n      s.cabecalho.curso.toLowerCase().includes(\'t\303\251cnico\') ||\n      s.cabecalho.curso.toLowerCase().includes(\'tecnico\');\n    const sHipotese = s.historico_napne.status_diagnostico === \'em_investigacao_hipotese\';\n\n    if (activeFilter === \'medio\') return sTecnico;\n    if (activeFilter === \'superior\') return sSuperior;\n    if (activeFilter === \'confirmado\') return !sHipotese;\n    if (activeFilter === \'hipotese\') return sHipotese;\n    return true;\n  });\n\n  return (\n    <div className=\"bg-white border-b border-slate-200\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5\">\n        {/* Campus Paraiso Statistics Bar & Filter */}\n        <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-3 sm:p-4 mb-4 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-3\">\n          <div className=\"flex items-center gap-2.5\">\n            <div className=\"w-8 h-8 rounded-lg bg-emerald-800 text-white flex items-center justify-center shrink-0\">\n              <Building2 className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <div className=\"flex items-center gap-2\">\n                <span className=\"text-xs font-bold text-slate-900 uppercase tracking-wide\">\n                  NAPNE \302\267 Campus Para\303\255so\n                </span>\n                <span className=\"text-[11px] font-mono text-emerald-800 bg-emerald-100 font-semibold px-2 py-0.5 rounded\">\n                  {stats.estudantes_geral} Estudantes Acompanhados\n                </span>\n              </div>\n              <p className=\"text-[11px] text-slate-500 mt-0.5\">\n                Censo oficial: <strong>{stats.estudantes_medio}</strong> no Ensino M\303\251dio \302\267 <strong>{stats.estudantes_superior}</strong> no Ensino Superior \302\267 <strong>{stats.com_diagnostico_confirmado}</strong> c/ laudo \302\267 <strong>{stats.sem_diagnostico_hipotese}</strong> s/ laudo (hip\303\263tese)\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-1.5 w-full lg:w-auto\">\n            <div className=\"flex items-center gap-1 text-[11px] font-semibold text-slate-500 mr-1\">\n              <Filter className=\"w-3 h-3\" />\n              <span>Filtrar:</span>\n            </div>\n\n            <button\n              onClick={() => setActiveFilter(\'todos\')}\n              className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-all cursor-pointer ${\n                activeFilter === \'todos\'\n                  ? \'bg-slate-900 text-white\'\n                  : \'bg-white border border-slate-200 text-slate-600 hover:bg-slate-100\'\n              }`}\n            >\n              Todos ({allStudents.length})\n            </button>\n\n            <button\n              onClick={() => setActiveFilter(\'medio\')}\n              className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-all cursor-pointer ${\n                activeFilter === \'medio\'\n                  ? \'bg-emerald-800 text-white\'\n                  : \'bg-white border border-slate-200 text-emerald-800 hover:bg-emerald-50\'\n              }`}\n              title=\"15 estudantes no M\303\251dio T\303\251cnico\"\n            >\n              M\303\251dio T\303\251cnico (15)\n            </button>\n\n            <button\n              onClick={() => setActiveFilter(\'superior\')}\n              className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-all cursor-pointer ${\n                activeFilter === \'superior\'\n                  ? \'bg-teal-800 text-white\'\n                  : \'bg-white border border-slate-200 text-teal-800 hover:bg-teal-50\'\n              }`}\n              title=\"14 estudantes no Superior TI\"\n            >\n              Superior TI (14)\n            </button>\n\n            <button\n              onClick={() => setActiveFilter(\'confirmado\')}\n              className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-all cursor-pointer ${\n                activeFilter === \'confirmado\'\n                  ? \'bg-blue-800 text-white\'\n                  : \'bg-white border border-slate-200 text-blue-800 hover:bg-blue-50\'\n              }`}\n              title=\"24 com diagn\303\263stico confirmado\"\n            >\n              Com Laudo (24)\n            </button>\n\n            <button\n              onClick={() => setActiveFilter(\'hipotese\')}\n              className={`px-2.5 py-1 text-xs rounded-lg font-medium transition-all cursor-pointer ${\n                activeFilter === \'hipotese\'\n                  ? \'bg-amber-600 text-white\'\n                  : \'bg-amber-50 border border-amber-300 text-amber-900 hover:bg-amber-100\'\n              }`}\n              title=\"5 sem diagn\303\263stico formalizado / em hip\303\263tese diagn\303\263stica\"\n            >\n              Sem Laudo (5)\n            </button>\n\n            {onOpenCampusStats && (\n              <button\n                onClick={onOpenCampusStats}\n                className=\"inline-flex items-center gap-1 px-2.5 py-1 text-xs font-semibold text-slate-700 bg-white border border-slate-300 hover:bg-slate-100 rounded-lg transition-colors cursor-pointer ml-auto lg:ml-1\"\n                title=\"Ver estat\303\255sticas detalhadas e legisla\303\247\303\243o\"\n              >\n                <BarChart3 className=\"w-3.5 h-3.5 text-slate-600\" />\n                <span>Panorama</span>\n              </button>\n            )}\n          </div>\n        </div>\n\n        {/* Student Switcher and Add Student Bar */}\n        <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-4 mb-4 border-b border-slate-100\">\n          <div className=\"flex items-center gap-2\">\n            <GraduationCap className=\"w-4 h-4 text-emerald-700\" />\n            <span className=\"text-xs font-bold text-slate-800 uppercase tracking-wider\">\n              Estudantes Ativos com PEI Gerado:\n            </span>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-1.5\">\n            {filteredStudents.map((c) => {\n              const isCurrent = c.id === pei.id;\n              const studSuperior =\n                c.cabecalho.curso.toLowerCase().includes(\'superior\') ||\n                c.cabecalho.curso.toLowerCase().includes(\'sistemas\');\n              const studTecnico =\n                c.cabecalho.curso.toLowerCase().includes(\'t\303\251cnico\') ||\n                c.cabecalho.curso.toLowerCase().includes(\'tecnico\');\n              const studHipotese = c.historico_napne.status_diagnostico === \'em_investigacao_hipotese\';\n\n              return (\n                <button\n                  key={c.id}\n                  onClick={() => onSelectCase(c)}\n                  className={`px-3 py-1.5 rounded-lg text-xs font-medium transition-all cursor-pointer flex items-center gap-1.5 ${\n                    isCurrent\n                      ? \'bg-slate-900 text-white font-semibold shadow-xs\'\n                      : \'bg-slate-100 text-slate-700 hover:bg-slate-200\'\n                  }`}\n                >\n                  <span className=\"font-semibold\">{c.cabecalho.estudante.split(\' \')[0]}</span>\n                  <span className=\"text-[10px] opacity-80\">\n                    {studSuperior ? \'(Sup TI)\' : studTecnico ? \'(M\303\251dio)\' : \'\'}\n                  </span>\n                  {studHipotese ? (\n                    <span\n                      className={`text-[9px] px-1.5 py-0.2 rounded font-bold uppercase ${\n                        isCurrent ? \'bg-amber-400 text-slate-950\' : \'bg-amber-200 text-amber-950\'\n                      }`}\n                      title=\"Sem laudo formal / hip\303\263tese em investiga\303\247\303\243o\"\n                    >\n                      s/ laudo\n                    </span>\n                  ) : (\n                    <span\n                      className={`text-[9px] px-1 py-0.2 rounded font-bold uppercase ${\n                        isCurrent ? \'bg-emerald-600 text-white\' : \'bg-emerald-100 text-emerald-900\'\n                      }`}\n                      title=\"Diagn\303\263stico confirmado\"\n                    >\n                      laudo\n                    </span>\n                  )}\n                </button>\n              );\n            })}\n\n            <button\n              onClick={onOpenAddStudent}\n              className=\"inline-flex items-center gap-1 px-3 py-1.5 rounded-lg text-xs font-semibold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 transition-colors cursor-pointer ml-1\"\n            >\n              <UserPlus className=\"w-3.5 h-3.5\" />\n              <span>+ Novo Aluno</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Active Student Info */}\n        <div className=\"flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6\">\n          {/* Profile Block */}\n          <div className=\"flex items-start gap-4 sm:gap-5\">\n            <div className=\"relative w-16 h-16 sm:w-20 sm:h-20 rounded-xl bg-gradient-to-br from-emerald-100 to-teal-50 border border-emerald-200 flex items-center justify-center text-emerald-800 font-bold text-2xl shrink-0 overflow-hidden shadow-xs\">\n              <span className=\"select-none font-serif text-3xl\">{getInitial(cabecalho.estudante)}</span>\n              <div className=\"absolute bottom-0 inset-x-0 bg-emerald-900/80 text-[10px] text-white text-center py-0.5 font-medium tracking-tight\">\n                {isSuperior ? \'SUPERIOR TI\' : isTecnico ? \'M\303\211DIO T\303\211CNICO\' : \'ESTUDANTE\'}\n              </div>\n            </div>\n\n            <div>\n              <div className=\"flex flex-wrap items-center gap-2\">\n                <h1 className=\"text-xl sm:text-2xl font-bold tracking-tight text-slate-900\">\n                  {cabecalho.estudante}\n                </h1>\n                <span className=\"text-xs font-mono text-slate-500 bg-slate-100 px-2 py-0.5 rounded\">\n                  {cabecalho.codigo_matricula}\n                </span>\n\n                {/* Diagnostic Status Badge */}\n                {isHipotese ? (\n                  <span className=\"inline-flex items-center gap-1 text-[11px] font-semibold text-amber-900 bg-amber-100 border border-amber-300 px-2 py-0.5 rounded\">\n                    <HelpCircle className=\"w-3.5 h-3.5 text-amber-700\" />\n                    Sem Laudo Confirmado \302\267 Hip\303\263tese em Investiga\303\247\303\243o (Portaria MEC 421/2026)\n                  </span>\n                ) : (\n                  <span className=\"inline-flex items-center gap-1 text-[11px] font-semibold text-emerald-900 bg-emerald-100 border border-emerald-300 px-2 py-0.5 rounded\">\n                    <FileCheck2 className=\"w-3.5 h-3.5 text-emerald-700\" />\n                    Diagn\303\263stico Confirmado: {historico_napne.categoria_neurodivergencia || \'Laudo em Prontu\303\241rio\'}\n                  </span>\n                )}\n              </div>\n\n              {/* Unboxed Metadata with typographic separators */}\n              <div className=\"flex flex-wrap items-center gap-2 mt-1.5 text-xs text-slate-600\">\n                <span className=\"font-semibold text-slate-800\">{cabecalho.curso}</span>\n                <span aria-hidden=\"true\" className=\"text-slate-300\">\302\267</span>\n                <span className=\"text-emerald-800 font-medium\">{cabecalho.componente_curricular}</span>\n                <span aria-hidden=\"true\" className=\"text-slate-300\">\302\267</span>\n                <span>{cabecalho.modulo_periodo}</span>\n                <span aria-hidden=\"true\" className=\"text-slate-300\">\302\267</span>\n                <span>{cabecalho.idade}</span>\n              </div>\n\n              {/* Responsible Educators */}\n              <div className=\"flex flex-wrap items-center gap-4 mt-2.5 text-xs text-slate-500\">\n                <div className=\"flex items-center gap-1.5\">\n                  <UserCheck className=\"w-3.5 h-3.5 text-emerald-600\" />\n                  <span>Docente: <strong className=\"text-slate-700 font-medium\">{cabecalho.docente_regente}</strong></span>\n                </div>\n                <div className=\"flex items-center gap-1.5\">\n                  <BookOpen className=\"w-3.5 h-3.5 text-teal-600\" />\n                  <span>NAPNE / AEE: <strong className=\"text-slate-700 font-medium\">{cabecalho.docente_aee}</strong></span>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Metric KPIs */}\n          <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3 sm:gap-4 w-full lg:w-auto border-t lg:border-t-0 pt-4 lg:pt-0 border-slate-100\">\n            <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg\">\n              <span className=\"block text-[11px] font-medium text-slate-500 uppercase tracking-wider\">\n                Metas do PEI\n              </span>\n              <div className=\"flex items-baseline gap-1 mt-1\">\n                <span className=\"text-xl font-bold font-mono text-emerald-700 tabular-nums\">\n                  {metricas.percentual_metas_alcancadas}%\n                </span>\n                <span className=\"text-xs text-slate-400\">conclu\303\255do</span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg\">\n              <span className=\"block text-[11px] font-medium text-slate-500 uppercase tracking-wider\">\n                Autonomia T\303\251cnica\n              </span>\n              <div className=\"flex items-baseline gap-1 mt-1\">\n                <span className=\"text-xl font-bold font-mono text-slate-900 tabular-nums\">\n                  {metricas.nivel_autonomia}/5\n                </span>\n                <span className=\"text-xs text-slate-400\">n\303\255vel</span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg\">\n              <span className=\"block text-[11px] font-medium text-slate-500 uppercase tracking-wider\">\n                Engajamento DUA\n              </span>\n              <div className=\"flex items-baseline gap-1 mt-1\">\n                <span className=\"text-xl font-bold font-mono text-teal-700 tabular-nums\">\n                  {metricas.engajamento}/5\n                </span>\n                <span className=\"text-xs text-slate-400\">ativo</span>\n              </div>\n            </div>\n\n            <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-lg\">\n              <span className=\"block text-[11px] font-medium text-slate-500 uppercase tracking-wider\">\n                Suporte Semanal\n              </span>\n              <div className=\"flex items-baseline gap-1 mt-1\">\n                <span className=\"text-xl font-bold font-mono text-slate-900 tabular-nums\">\n                  {metricas.sessoes_semanais_realizadas}\n                </span>\n                <span className=\"text-xs text-slate-400\">sess\303\265es</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/StudentHeader.tsx"
        }
        overwrite: true
      }
    }
