            }
            lines {
              text: "        indicador_sucesso: \'Aciona o s\303\255mbolo \"Quero tentar\", \"Mais tempo\" ou \"Preciso de ajuda\" de forma espont\303\242nea em pelo menos 3 aulas semanais.\',"
