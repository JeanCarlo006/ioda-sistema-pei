      thinking_signature: "\022\371\021\n\366\021\001i\024}\023^\330\322G/\'re\303\374\017\262`\020\336\3133\004\304\306]M\343\357\221\217\344\363\001\301^,<^Z\017|n\233\277/\374K\231m\345\r\344\222\000\365|\3555v\245h\361\036\315\b\274\016o\2653\r\312\251\322\313\0308.\275\037K77u#\275\221\314\033\323\211\265\030\031\270\374[.y\356G\271n\310,&\236\v\220t\314\361\362\240\003\033\261\223`\002\253\243\276\"\250\031\020\a\202\003Q\262HLGnu\252\320\354\200\234\206\357\022`\017b\277N\353\231{5L\0039\277s\\\000)\356\300~\024.T\002)\337\311\354hJ\324\341\a\031.\036;Xq\016N\250\367\250/Rw\375\236\350\303\361\376#\003R\354\025bD\017\332\255\245\b;\020\350\376\215\231\303]\307yPH\367\336\355WSP8\031\020\300\333\340\260\313\'\016\316\310\243\226\256y\326\240\332\276\027\210\2050\362\201\274\212$]\271;E\201\177\031\246\025\032\275\264\377\334\324\332N\200\316aW\033\201\204\034=Mq\251JX\320&-0J\\\340HY,\333YQz_l2\352~\024\302-\255\203V\265r];Ws\035\2771Q\276\363\025\246\357\v\317%\006\277R(\377%\211\267#jbz\231\302\006<\376\027\204\345\204|\003P7,\241pf\210~\3300\244V{\024\003W%t\347\261-\330\316\364\344\270\375\236\270\253\263\212ty\0177\211\277Ae\307X\225+\034\243\240x\255\337\362\036\304\300\304\235\237S\364i\266\237]\223\322\330\220A\215\331\201\254!X\222\367o\334\223\325R\2131\2460C\210\355\2753K\263\206\330\rd\253\230\232\373\tMnzI\242s\335#\202\362l\232\305\352\254J3r\254|XC\222n:T3\337\326C\2161\023CX\035Wq\245T.w\311\243\363\237\022\247\350\203EsvK\001b<\245\212\334\356\366\205SLM\006-\276\314z\227\325%d\325<u.b\'\305\320\256\266\375p\034l?u@\024\213\023\v*Sm\267\003L-\225\242\355\246\332\375\301\005g\215c\351\3245V\231\233\344L\'\237(\370\001\276\372d\251F0\206{\317 Z\270\202\220\335\002o\315\335\272cE\320B\200\266E\224G;\243\303\205\314}\302w\205\340-m\313(ec\263\254#\344\3526.\223\204Z\331\f7\205\261\262~\322\367\t\0335\351\242\022q\000\331\226\033;FQ\270\203\376\224\305\'`\330\241\373\243\215\226\3743\224~\262\307\322\r-4\220\250L\005\352\022\326>\306\227B\037\214E\211\200YBw\362\324n\204os\\\255iz\217\335\001\263\273\v\237a\3501\006\273\226\v,\223}\225\307\3423\271\2311\234\374oE\302Q\032k\347\216\232\235\030i\227\2046\377\366\001:r\004?\230\365\320\033\245\200\220\272\331~=\a\346\326\201+\305\024hC\350\217\r\344\322H\203\325\003\365Q\375M\025\205\311#\245\021\236\303}\025 I\321\031e\241=3\222\373\230*\026|\257\240\311yy\b\335\"@\363\223?\024\237\274\023\177Mz\335\220\250\325\327\201V\033<\'Q\240\226O\024\321@q\226\322\210n\365L$\300e\360\220\247\021\317\267\311dX6&\006i\203\022\364\026B\227\220\324\376\332\314-U@\272\200su\232\310!y\f%\277\341#\226Q\321\253\236\330\320\213V\224i\201\255APd\203&\006w\265\233\367\317\241\241\217\373\201\036n\251ZU\362\264u\247q \266\'\205\252\276\032B\354w\245;\353iU\214\375!@Xv\234\205\272\200T2\216\215\344\275\b\022$\326j\270\3647X\002\310L\376\270\t\310\033d\245\212&\331H2\274\311\370\243D\334\027E\236\273C7K^MR\300\\\305\v_}\265e\377^9\016\340l\214]\214\251\373\313\315\264\241x\020\024N~\306\241\360\264x\334\237\025Y\021z,Z\356\263\225\005\302\000\020\261@S\001d\005\366C\032;J\3462\237B\267\033\035\277\253\r@\301\301\v\256\t\310\356\336\200\"=_\260\373\000=\376\3468\345\353j]\366\021\364\037\225\311\210\330{\016%\004\003C\v\257e\240\300#\213\277\221P\321\264\220\276T\020s\034O\035\275\021\340\017\315\206\367\006\247\255-\351\346\316\222\306\277\036\004U!,\332w\310anvb\214\354[\217<\313\334o\020\236Y\227\321igGMqyj\255\036\230\220\2647\002\352\215=\260\336\232z\374\310\241\253\3406;\310\346\017u\217\0011k\201\252\222\263\242l\346\3021\236\350\271\337x&\025\024%\277\\H\347WZV\036A\207\'\310\204\255\261\352\267=\205a\215\276\0269\037X\224\255\251\224\034\211\254\237Bt\232\022\256\366o\277\002b\233\303\204We4\252\234\261\302K,\352.j{\355\245\210\027\270Y\342T\026\363\345\n\a;yQ\262\366\345U\211\236uk3\332\2310\233\253\031\344#\341\374S\273\n6\352O|\226t\026\331\037z\362\326\2439O\t@\"3\322\245\261\322rHQ\354=(=\236\222\236r\357\004\243\005\364M\034ZS\344\345ds\356|\357ILt\267,i\002\261\217\316