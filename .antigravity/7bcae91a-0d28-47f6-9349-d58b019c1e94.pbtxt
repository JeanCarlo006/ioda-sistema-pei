    content: "            engajamento: [\n              solucao.remediosSugeridos.engajamento,\n              ...prev.planejamento_pei.flexibilizacao_metodologica_dua.engajamento,\n            ],\n            representacao: [\n              solucao.remediosSugeridos.representacao,\n              ...prev.planejamento_pei.flexibilizacao_metodologica_dua.representacao,\n            ],\n            acao_e_expressao: [\n              solucao.remediosSugeridos.acaoExpressao,\n              ...prev.planejamento_pei.flexibilizacao_metodologica_dua.acao_e_expressao,\n            ],\n          },\n          estrategias_avaliacao: {\n            ...prev.planejamento_pei.estrategias_avaliacao,\n            formato_acessivel: solucao.remediosSugeridos.avaliacaoAcessivel,\n            recursos_utilizados: [\n              ...new Set([\n                ...prev.planejamento_pei.estrategias_avaliacao.recursos_utilizados,\n                ...solucao.remediosSugeridos.recursosTA,\n              ]),\n            ],\n          },\n        },\n        painel_notas: [\n          {\n            id: `N_Sol_${Date.now()}`,\n            autor: \'NAPNE \302\267 Campus Para\303\255so\',\n            papel: \'AEE\',\n            categoria: \'apoio\',\n            conteudo: `Solu\303\247\303\243o aplicada para ${solucao.titulo}: ${solucao.remediosSugeridos.acaoExpressao}`,\n            data: new Date().toLocaleDateString(\'pt-BR\'),\n            cor: \'blue\',\n          },\n          ...prev.painel_notas,\n        ],\n      };\n\n      setStudentsList((list) =>\n        list.map((s) => (s.id === updated.id ? updated : s))\n      );\n\n      return updated;\n    });\n  };\n\n  // Direct edit update on official template\n  const handleUpdatePei = (updated: PEICompleto) => {\n    setActivePei(updated);\n    setStudentsList((list) =>\n      list.map((s) => (s.id === updated.id ? updated : s))\n    );\n  };\n\n  // Add / delete notes on panel\n  const handleAddPostIt = (postIt: PostItPainel) => {\n    setActivePei((prev) => {\n      const updated = {\n        ...prev,\n        painel_notas: [postIt, ...prev.painel_notas],\n      };\n      setStudentsList((list) =>\n        list.map((s) => (s.id === updated.id ? updated : s))\n      );\n      return updated;\n    });\n  };\n\n  const handleDeletePostIt = (id: string) => {\n    setActivePei((prev) => {\n      const updated = {\n        ...prev,\n        painel_notas: prev.painel_notas.filter((n) => n.id !== id),\n      };\n      setStudentsList((list) =>\n        list.map((s) => (s.id === updated.id ? updated : s))\n      );\n      return updated;\n    });\n  };\n\n  // Print handler\n  const handlePrint = () => {\n    window.print();\n  };\n\n  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col font-sans\">\n      {/* Top Bar Navigation */}\n      <Navbar\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        onOpenAddStudent={() => setIsAddStudentOpen(true)}\n        onOpenSolutionBank={() => setIsSolutionBankOpen(true)}\n        onOpenCampusStats={() => setIsCampusStatsOpen(true)}\n        onPrint={handlePrint}\n        escalaFonte={escalaFonte}\n        onMudarFonte={setEscalaFonte}\n        modoContraste={modoContraste}\n        onMudarContraste={setModoContraste}\n      />\n\n      {/* If in child tab, render back navigation breadcrumb and StudentHeader */}\n      {activeTab !== \'hub\' && (\n        <div className=\"no-print\">\n          {/* Breadcrumb Bar */}\n          <div className=\"bg-white border-b border-slate-200\">\n            <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2.5 flex items-center justify-between\">\n              <button\n                onClick={() => setActiveTab(\'hub\')}\n                className=\"inline-flex items-center gap-2 text-xs font-bold text-emerald-800 hover:text-emerald-950 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 px-3 py-1.5 rounded-lg transition-colors cursor-pointer\"\n              >\n                <ArrowLeft className=\"w-3.5 h-3.5\" />\n                <span>\342\206\220 Voltar ao Hub de Ferramentas (i\360\237\222\232PEI)</span>\n              </button>\n\n              <div className=\"text-xs text-slate-500 hidden sm:flex items-center gap-2\">\n                <span>Visualizando PEI de:</span>\n                <span className=\"font-bold text-slate-900 bg-slate-100 px-2 py-0.5 rounded\">\n                  {activePei.cabecalho.estudante}\n                </span>\n                <span aria-hidden=\"true\" className=\"text-slate-300\">\302\267</span>\n                <span className=\"text-emerald-800 font-semibold\">\n                  {activeTab === \'pei\' && \'Plano de Ensino (PEI & DUA 3.0)\'}\n                  {activeTab === \'estudo_caso\' && \'Estudo de Caso & Barreiras (Art. 11)\'}\n                  {activeTab === \'documento_oficial\' && \'Modelo Oficial NAPNE / Processo SEI\'}\n                  {activeTab === \'painel\' && \'Acompanhamento & Metas\'}\n                </span>\n              </div>\n            </div>"
