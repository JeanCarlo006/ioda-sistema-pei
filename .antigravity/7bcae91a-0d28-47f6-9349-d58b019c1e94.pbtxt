  code_action {
    action_spec {
      create_file {
        instruction: "import express, { Request, Response } from \'express\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst app = express();\nconst port = process.env.PORT || 3000;\n\napp.use(express.json({ limit: \'10mb\' }));\n\n// Initialize Google GenAI client (Server-Side only)\nconst ai = new GoogleGenAI({\n  apiKey: process.env.GEMINI_API_KEY || \'\',\n  httpOptions: {\n    headers: {\n      \'User-Agent\': \'aistudio-build\',\n    },\n  },\n});\n\n// Helper for generating PEI structure safely with fallback\nfunction generateLocalPeiFallback(params: any) {\n  const {\n    studentName = \'Estudante\',\n    grade = \'Ensino M\303\251dio T\303\251cnico / Superior\',\n    subject = \'Tecnologia da Informa\303\247\303\243o\',\n    syllabus = \'Desenvolvimento de Sistemas e Computa\303\247\303\243o\',\n    essentialObjectives = \'Desenvolvimento de compet\303\252ncias t\303\251cnicas e pensamento computacional\',\n    barriers = \'Barreiras metodol\303\263gicas e comunicacionais no ambiente pr\303\241tico de inform\303\241tica\',\n    potentialities = \'Capacidade de racioc\303\255nio l\303\263gico e interesse em tecnologia\',\n    assistiveTech = \'Softwares acess\303\255veis, teclado adaptado e DUA 3.0\',\n    familyContext = \'Acompanhamento pelo NAPNE e apoio institucional\',\n  } = params;\n\n  return {\n    cabecalho: {\n      estudante: studentName,\n      matricula: `TI-${Math.floor(1000 + Math.random() * 9000)}`,\n      componente_curricular: subject,\n      modulo_periodo: grade,\n      data_elaboracao: new Date().toISOString().split(\'T\')[0],\n      docente_regente: \'Prof. Coordenador da Disciplina\',\n      docente_aee: \'Prof\302\252. Especialista NAPNE / AEE\',\n      profissional_apoio: \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\n    },\n    historico_e_condicao_napne: {\n      breve_historico_clinico_familiar: familyContext,\n      descricao_condicao_especifica: barriers,\n      informacoes_dos_pais: \'Fam\303\255lia e estudante em alinhamento constante com o NAPNE institucional.\',\n    },\n    estudo_de_caso_sintese: {\n      barreiras_identificadas: [\n        `Barreiras Metodol\303\263gicas: Atividades pr\303\241ticas de ${subject} centradas em uma \303\272nica via de instru\303\247\303\243o.`,\n        \'Barreiras Tecnol\303\263gicas: Ferramentas e IDEs de desenvolvimento sem pr\303\251via configura\303\247\303\243o de acessibilidade.\',\n        \'Barreiras Atitudinais: Subestima\303\247\303\243o da capacidade t\303\251cnica ou pressupostos capacitistas no trabalho em equipe.\',\n      ],\n      potencialidades_interesses: [\n        potentialities,\n        \'Alta motiva\303\247\303\243o para projetos pr\303\241ticos aplicados e resolu\303\247\303\243o de desafios de c\303\263digo/sistemas.\',\n        \'Capacidade de colabora\303\247\303\243o produtiva quando em duplas com divis\303\243o de pap\303\251is (pair programming).\',\n      ],\n      recursos_tecnologia_assistiva: [\n        assistiveTech,\n        \'Editores de c\303\263digo com suporte a temas de alto contraste e leitores de tela\',\n        \'Tempo estendido para elabora\303\247\303\243o e testes pr\303\241ticos em laborat\303\263rio\',\n      ],\n    },\n    planejamento_pedagogico_pei: {\n      conteudo_ementa_oficial: syllabus,\n      competencias_habilidades_ementa: essentialObjectives,\n      objetivos_e_metas_adaptadas: [\n        {\n          id_meta: \'M1\',\n          descricao_meta: `Dominar os conceitos centrais de ${subject} atrav\303\251s de projetos orientados por DUA 3.0.`,\n          prazo: \'Mensal (4 semanas)\',\n          indicador_sucesso: \'Executa e documenta a solu\303\247\303\243o pr\303\241tica com autonomia utilizando seus recursos assistivos.\',\n        },\n        {\n          id_meta: \'M2\',\n          descricao_meta: \'Participar ativamente em equipes colaborativas de desenvolvimento e projetos pr\303\241ticos.\',\n          prazo: \'Bimestral (8 semanas)\',\n          indicador_sucesso: \'Entrega as partes modulares do projeto com valida\303\247\303\243o entre pares e feedback formativo.\',\n        },\n      ],\n      flexibilizacao_metodologica_dua: {\n        engajamento: [\n          \'Projetos aplicados conectados a desafios reais do mercado de TI e centros de interesse.\',\n          \'Pr\303\241tica de Pair Programming (programa\303\247\303\243o em pares) com revezamento de pap\303\251is de piloto e copiloto.\',\n          \'Rotina estruturada de entregas parciais e suporte cont\303\255nuo para evitar sobrecarga.\',\n        ],\n        representacao: [\n          \'M\303\272ltiplos formatos: documenta\303\247\303\243o textual acess\303\255vel, diagramas de arquitetura e exemplos gravados.\',\n          \'Disponibiliza\303\247\303\243o antecipada de snippets de c\303\263digo, gloss\303\241rios t\303\251cnicos e roteiros de laborat\303\263rio.\',\n          \'Suporte a ferramentas de linha de comando (CLI) e editores com fontes aumentadas / leitores de tela.\',\n        ],\n        acao_e_expressao: [\n          \'M\303\272ltiplas formas de demonstrar conhecimento: c\303\263digo execut\303\241vel, apresenta\303\247\303\243o oral, documenta\303\247\303\243o t\303\251cnica ou revis\303\243o de c\303\263digo.\',\n          \'Uso de atalhos de teclado, scripts de automa\303\247\303\243o e tempo ampliado para testes pr\303\241ticos.\',\n          \'Elimina\303\247\303\243o de avalia\303\247\303\265es puramente memorizadas em papel; prioriza\303\247\303\243o de projetos formativos.\',\n        ],\n      },\n      gestao_sala_de_aula: [\n        \'Organiza\303\247\303\243o ergon\303\264mica da bancada do laborat\303\263rio com acesso desobstru\303\255do.\',\n        \'Pausas programadas para preven\303\247\303\243o de fadiga cognitiva e sensorial.\',\n        \'Sess\303\265es semanais de suporte pedag\303\263gico com a equipe docente e o NAPNE.\',\n      ],\n      estrategias_de_avaliacao: {\n        formato_acessivel: \'Avalia\303\247\303\243o processual baseada em portf\303\263lio pr\303\241tico de projetos e revis\303\265es de c\303\263digo com tempo estendido.\',\n        criterio_de_sucesso: \'Compreens\303\243o l\303\263gica e operacional dos conceitos exigidos na ementa oficial.\',\n      },\n    },\n    plano_aee: {\n      organizacao_srm: \'2 vezes por semana no NAPNE para suporte a ferramentas acess\303\255veis e media\303\247\303\243o pedag\303\263gica.\',\n      materiais_a_produzir: [\n        \'Roteiros de laborat\303\263rio acess\303\255veis em Markdown e alto contraste\',\n        \'Scripts e guias de configura\303\247\303\243o de acessibilidade em IDEs\',\n      ],\n      articulacoes_ensino_comum: \'Reuni\303\265es semanais entre docentes de TI, monitoria especializada e NAPNE.\',\n      articulacoes_intersetoriais: \'Articula\303\247\303\243o com servi\303\247os de sa\303\272de e reabilita\303\247\303\243o profissional quando pertinente.\',\n    },\n    painel_de_acompanhamento: {\n      status_periodo: \'EM_ANDAMENTO\',\n      metricas_grafico: {\n        percentual_metas_alcancadas: 40,\n        nivel_autonomia_1_a_5: 4,\n        engajamento_nas_atividades_1_a_5: 5,\n      },\n      parecer_pedagogico: \'Estudante apresenta excelente desenvolvimento t\303\251cnico quando garantida a acessibilidade metodol\303\263gica e tecnol\303\263gica recomendada pela PNEEI.\',\n      sugestoes_proximo_ciclo: [\n        \'Avan\303\247ar para a fase de desenvolvimento de projeto integrador com tutoria por pares.\',\n        \'Manter reuni\303\265es de alinhamento com os docentes do m\303\263dulo.\',\n      ],\n    },\n  };\n}\n\n// API Route: Generate or Refine PEI & PAEE\napp.post(\'/api/gemini/generate-pei\', async (req: Request, res: Response) => {\n  res.setHeader(\'Content-Type\', \'application/json\');\n\n  try {\n    const {\n      studentName,\n      age,\n      subject,\n      grade,\n      syllabus,\n      essentialObjectives,\n      barriers,\n      potentialities,\n      assistiveTech,\n      familyContext,\n      actionType,\n    } = req.body;\n\n    // Check if API key is configured\n    if (!process.env.GEMINI_API_KEY) {\n      const fallbackData = generateLocalPeiFallback(req.body);\n      return res.json({ success: true, data: fallbackData, isFallback: true });\n    }\n\n    const systemPrompt = `Voc\303\252 \303\251 um especialista em Educa\303\247\303\243o Inclusiva do Brasil, atuante em NAPNEs (N\303\272cleos de Atendimento \303\240s Pessoas com Necessidades Educacionais Espec\303\255ficas) para Ensino M\303\251dio T\303\251cnico e Ensino Superior em TI / Computa\303\247\303\243o.\nLegisla\303\247\303\243o:\n- Decreto n\302\272 12.686/2025 e Decreto n\302\272 12.773/2025 (PNEEI)\n- Portaria MEC n\302\272 421/2026 (arts. 7\302\272, 10 e 11)\n- DUA 3.0 (CAST 2024): Engajamento, Representa\303\247\303\243o, A\303\247\303\243o e Express\303\243o\n- Princ\303\255pio: O curr\303\255culo de TI deve ser acess\303\255vel sem empobrecimento de conte\303\272dos.\n\nGere uma estrutura JSON com cabecalho, historico_e_condicao_napne, estudo_de_caso_sintese, planejamento_pedagogico_pei, plano_aee e painel_de_acompanhamento.`;\n\n    const userPrompt = `A\303\207\303\203O: ${actionType || \'CRIA\303\207\303\203O_INICIAL\'}\n[DADOS DO CURSO E COMPONENTE CURRICULAR]\n- N\303\255vel/Curso: ${grade || \'Ensino M\303\251dio T\303\251cnico em Inform\303\241tica / Ensino Superior em TI\'}\n- Disciplina: ${subject || \'L\303\263gica de Programa\303\247\303\243o e Desenvolvimento Web\'}\n- Ementa / Conte\303\272do Program\303\241tico: ${syllabus || \'Algoritmos, estruturas de repeti\303\247\303\243o, fun\303\247\303\265es, arrays e manipula\303\247\303\243o de DOM\'}\n- Objetivos Essenciais da Turma: ${essentialObjectives || \'Construir programas funcionais e resolver problemas computacionais\'}\n\n[ESTUDO DE CASO DO ESTUDANTE]\n- Nome do Aluno: ${studentName || \'Estudante\'}\n- Idade: ${age || \'17 anos\'}\n- Barreiras Observadas: ${barriers || \'Barreiras metodol\303\263gicas e tecnol\303\263gicas no ambiente pr\303\241tico de inform\303\241tica\'}\n- Potencialidades e Interesses: ${potentialities || \'Racioc\303\255nio l\303\263gico, paix\303\243o por tecnologia\'}\n- Necessidades de Apoio / TA: ${assistiveTech || \'Teclado adaptado, editores com leitor de tela / atalhos, tempo estendido\'}\n- Contexto Familiar / NAPNE: ${familyContext || \'Apoio pedag\303\263gico articulado com o NAPNE\'}\n\nRetorne uma estrutura JSON v\303\241lida.`;\n\n    // Attempt Gemini call with timeout of 12 seconds\n    const controller = new AbortController();\n    const timeoutId = setTimeout(() => controller.abort(), 12000);\n\n    try {\n      const response = await ai.models.generateContent({\n        model: \'gemini-3.8-flash\',\n        contents: userPrompt,\n        config: {\n          systemInstruction: systemPrompt,\n          responseMimeType: \'application/json\',\n        },\n      });\n      clearTimeout(timeoutId);\n\n      const outputText = response.text || \'\';\n      if (outputText.trim().startsWith(\'{\')) {\n        const parsed = JSON.parse(outputText);\n        return res.json({ success: true, data: parsed });\n      } else {\n        throw new Error(\'Formato retornado pelo modelo n\303\243o foi JSON puro.\');\n      }\n    } catch (genAiError: any) {\n      clearTimeout(timeoutId);\n      console.warn(\'Gemini API call timed out or failed, utilizing robust pedagogical fallback:\', genAiError.message);\n      const fallbackData = generateLocalPeiFallback(req.body);\n      return res.json({ success: true, data: fallbackData, note: \'Gerado via motor pedag\303\263gico integrado PNEEI\' });\n    }\n  } catch (error: any) {\n    console.error(\'General error handling /api/gemini/generate-pei:\', error);\n    const fallbackData = generateLocalPeiFallback(req.body || {});\n    return res.json({ success: true, data: fallbackData, note: \'Recupera\303\247\303\243o autom\303\241tica efetuada\' });\n  }\n});\n\n// Setup Vite middleware in dev or serve static files in production\nasync function startServer() {\n  if (process.env.NODE_ENV !== \'production\') {\n    const { createServer } = await import(\'vite\');\n    const vite = await createServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    app.use(express.static(path.join(__dirname, \'dist\')));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.join(__dirname, \'dist\', \'index.html\'));\n    });\n  }\n\n  app.listen(port, () => {\n    console.log(`Server running on port ${port}`);\n  });\n}\n\nstartServer();\n"
        path {
