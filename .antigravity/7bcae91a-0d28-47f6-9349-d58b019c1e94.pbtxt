    replacement_infos {
      original_chunk {
        target_content: "import { PEICompleto, SolucaoCondicao } from \'../types/pei\';\n\n// 1. CASO ENSINO M\303\211DIO T\303\211CNICO INTEGRADO EM INFORM\303\201TICA\nexport const casoLucasTecnico: PEICompleto = {\n  id: \'MED-INF-02\',\n  cabecalho: {\n    estudante: \'Lucas Ferreira de Lima\',\n    codigo_matricula: \'2025.1.INF.042\',\n    idade: \'17 anos\',\n    curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\n    componente_curricular: \'Programa\303\247\303\243o Web e Algoritmos II\',\n    modulo_periodo: \'2\302\272 Ano / 4\302\272 Bimestre\',\n    data_elaboracao: \'2026-10-27\',\n    docente_regente: \'Prof. Carlos Eduardo Viana (Docente da \303\201rea T\303\251cnica de TI)\',\n    docente_aee: \'Prof\302\252. Renata Cavalcanti (Especialista em Educa\303\247\303\243o Especial / NAPNE)\',\n    profissional_apoio: \'Thiago Martins (Monitor de Acessibilidade Digital e Laborat\303\263rio)\',\n    coordenacao_napne: \'Prof\302\252. Dra. Vanessa Moreira (Coordenadora NAPNE)\',\n  },\n  historico_napne: {\n    breve_historico_clinico_familiar:\n      \'Estudante do Curso T\303\251cnico Integrado em Inform\303\241tica. Reside com os pais e irm\303\243o mais novo. Fam\303\255lia presente nas reuni\303\265es pedag\303\263gicas do NAPNE. Apresenta diagn\303\263stico neurol\303\263gico de Paralisia Cerebral com leve espasticidade em membros superiores (preens\303\243o fina reduzida para digita\303\247\303\243o veloz cont\303\255nua) e caracter\303\255sticas de dislexia visual para leitura de blocos densos de texto e c\303\263digo. Ressalta-se que, conforme a PNEEI (Decreto n\302\272 12.686/2025), o PEI tem finalidade estritamente pedag\303\263gica para acessibilizar o curr\303\255culo t\303\251cnico sem rebaixamento de conte\303\272dos.\',\n    descricao_condicao_especifica:\n      \'Limita\303\247\303\243o motora manual para digita\303\247\303\243o acelerada de sintaxe em teclados convencionais e fadiga visual com fontes monoespa\303\247adas compactas sem realce de sintaxe adequado. Apresenta excelente habilidade de abstra\303\247\303\243o l\303\263gica, racioc\303\255nio dedutivo, decomposi\303\247\303\243o de problemas e afinidade por arquitetura de software.\',\n    informacoes_dos_pais:\n      \'Os pais relatam que Lucas passa horas em casa programando em projetos pessoais de desenvolvimento de jogos em JavaScript e automa\303\247\303\243o. Expressam preocupa\303\247\303\243o quanto \303\240 press\303\243o de tempo em avalia\303\247\303\265es pr\303\241ticas de laborat\303\263rio com cron\303\264metro r\303\255gido e solicitam media\303\247\303\243o para trabalhos em equipe sem atitudes capacitistas dos colegas.\',\n  },\n"
        replacement_content: "import { PEICompleto, SolucaoCondicao, EstatisticasCampusParaiso } from \'../types/pei\';\n\n// ESTAT\303\215STICAS REAIS DO NAPNE \302\267 CAMPUS PARA\303\215SO (29 ESTUDANTES ACOMPANHADOS)\nexport const estatisticasCampusParaiso: EstatisticasCampusParaiso = {\n  campus: \'NAPNE \302\267 Campus Para\303\255so\',\n  estudantes_geral: 29,\n  estudantes_medio: 15,\n  estudantes_superior: 14,\n  com_diagnostico_confirmado: 24,\n  sem_diagnostico_hipotese: 5,\n  data_atualizacao: \'2026-10-27\',\n};\n\n// 1. CASO ENSINO M\303\211DIO T\303\211CNICO INTEGRADO EM INFORM\303\201TICA - CAMPUS PARA\303\215SO (DIAGN\303\223STICO CONFIRMADO)\nexport const casoLucasTecnico: PEICompleto = {\n  id: \'MED-INF-02\',\n  cabecalho: {\n    estudante: \'Lucas Ferreira de Lima\',\n    codigo_matricula: \'2025.1.INF.042\',\n    idade: \'17 anos\',\n    curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\n    componente_curricular: \'Programa\303\247\303\243o Web e Algoritmos II\',\n    modulo_periodo: \'2\302\272 Ano / 4\302\272 Bimestre\',\n    data_elaboracao: \'2026-10-27\',\n    docente_regente: \'Prof. Carlos Eduardo Viana (Docente da \303\201rea T\303\251cnica de TI)\',\n    docente_aee: \'Prof\302\252. Renata Cavalcanti (Especialista em Educa\303\247\303\243o Especial / NAPNE)\',\n    profissional_apoio: \'Thiago Martins (Monitor de Acessibilidade Digital e Laborat\303\263rio)\',\n    coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n  },\n  historico_napne: {\n    status_diagnostico: \'confirmado\',\n    categoria_neurodivergencia: \'Defici\303\252ncia F\303\255sica & Coordena\303\247\303\243o Fina\',\n    cid_ou_hipotese: \'G80.9 (Paralisia Cerebral com leve espasticidade em MMSS)\',\n    breve_historico_clinico_familiar:\n      \'Estudante do Curso T\303\251cnico Integrado em Inform\303\241tica no Campus Para\303\255so (integrante dos 15 estudantes acompanhados no Ensino M\303\251dio). Reside com os pais e irm\303\243o mais novo. Fam\303\255lia presente nas reuni\303\265es pedag\303\263gicas do NAPNE. Apresenta diagn\303\263stico neurol\303\263gico de Paralisia Cerebral com leve espasticidade em membros superiores (preens\303\243o fina reduzida para digita\303\247\303\243o veloz cont\303\255nua) e caracter\303\255sticas de dislexia visual para leitura de blocos densos de texto e c\303\263digo. Ressalta-se que, conforme a PNEEI (Decreto n\302\272 12.686/2025) e Portaria MEC n\302\272 421/2026, o PEI tem finalidade estritamente pedag\303\263gica para acessibilizar o curr\303\255culo t\303\251cnico sem rebaixamento de conte\303\272dos.\',\n    descricao_condicao_especifica:\n      \'Limita\303\247\303\243o motora manual para digita\303\247\303\243o acelerada de sintaxe em teclados convencionais e fadiga visual com fontes monoespa\303\247adas compactas sem realce de sintaxe adequado. Apresenta excelente habilidade de abstra\303\247\303\243o l\303\263gica, racioc\303\255nio dedutivo, decomposi\303\247\303\243o de problemas e afinidade por arquitetura de software.\',\n    informacoes_dos_pais:\n      \'Os pais relatam que Lucas passa horas em casa programando em projetos pessoais de desenvolvimento de jogos em JavaScript e automa\303\247\303\243o. Expressam preocupa\303\247\303\243o quanto \303\240 press\303\243o de tempo em avalia\303\247\303\265es pr\303\241ticas de laborat\303\263rio com cron\303\264metro r\303\255gido e solicitam media\303\247\303\243o para trabalhos em equipe sem atitudes capacitistas dos colegas.\',\n  },\n"
