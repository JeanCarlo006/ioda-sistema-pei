              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const modalidade = isSuperior ? \'Superior TI\' : \'M\303\251dio T\303\251cnico\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const numLabel = index !== undefined ? `#${index + 1}` : \'\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  const codMat = pei.cabecalho.codigo_matricula"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    ? `[${pei.cabecalho.codigo_matricula}]`"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    : \'\';"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "  return `PEI ${numLabel} \302\267 ${modalidade} ${codMat}`.trim();"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
