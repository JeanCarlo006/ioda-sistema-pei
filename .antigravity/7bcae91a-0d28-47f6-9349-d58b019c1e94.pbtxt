            lines {
              text: "    \'Submeter relato de experi\303\252ncia sobre modelagem de banco de dados acess\303\255vel no Congresso Brasileiro de Inform\303\241tica na Educa\303\247\303\243o (CBIE).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \'Convidar Beatriz para integrar projeto de extens\303\243o universit\303\241ria em desenvolvimento de software acess\303\255vel.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    \'Garantir continuidade dos apoios no semestre seguinte para as disciplinas de Engenharia de Software e Redes.\',"
