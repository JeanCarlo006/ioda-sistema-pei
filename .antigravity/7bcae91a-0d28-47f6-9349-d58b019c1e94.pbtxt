      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Pass allowedHosts: true in Vite middleware server creation in server.ts\", \"EndLine\":644, \"Instruction\":\"Ensure createServer in server.ts enables allowedHosts: true and uses relative dist path\", \"ReplacementContent\":\"async function startServer() {\\n  if (process.env.NODE_ENV !== \'production\') {\\n    const { createServer } = await import(\'vite\');\\n    const vite = await createServer({\\n      server: { middlewareMode: true, allowedHosts: true },\\n      appType: \'spa\',\\n    });\\n    app.use(vite.middlewares);\\n  } else {\\n    const distPath = path.resolve(__dirname, \'dist\');\\n    app.use(express.static(distPath));\\n    app.get(\'*\', (_req, res) => {\\n      res.sendFile(path.join(distPath, \'index.html\'));\\n    });\\n  }\", \"StartLine\":630, \"TargetContent\":\"async function startServer() {\\n  if (process.env.NODE_ENV !== \'production\') {\\n    const { createServer } = await import(\'vite\');\\n    const vite = await createServer({\\n      server: { middlewareMode: true },\\n      appType: \'spa\',\\n    });\\n    app.use(vite.middlewares);\\n  } else {\\n    app.use(express.static(path.join(__dirname, \'dist\')));\\n    app.get(\'*\', (_req, res) => {\\n      res.sendFile(path.join(__dirname, \'dist\', \'index.html\'));\\n    });\\n  }\", \"TargetFile\":\"/server.ts\", \"toolAction\":\"Updating Vite middleware configuration in server.ts\", \"toolSummary\":\"Update Vite middleware in server.ts\"}"
