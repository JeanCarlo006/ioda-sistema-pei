              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        descricao: \'Computadores do laborat\303\263rio de inform\303\241tica com configura\303\247\303\265es padr\303\243o sem fontes acess\303\255veis, extens\303\265es de autocompletar ou teclado de toque suave.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        impacto: \'Dificulta a leitura r\303\241pida de mensagens de erro do terminal e compila\303\247\303\243o.\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "        estrategia_enfrentamento: \'Instala\303\247\303\243o de perfil acess\303\255vel no VS Code (tema de alto contraste, fonte OpenDyslexic Mono, leitor de linter configurado e atalhos de snippets).\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
