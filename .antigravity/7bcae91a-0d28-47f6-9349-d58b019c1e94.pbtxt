      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Ensure handlePrint in App.tsx switches to the official template view before printing\", \"EndLine\":256, \"Instruction\":\"Update handlePrint in App.tsx so printing from any screen renders the official IFTO/NAPNE document\", \"ReplacementContent\":\"  const handlePrint = () => {\\n    if (activeTab !== \'documento_oficial\') {\\n      setActiveTab(\'documento_oficial\');\\n      setTimeout(() => {\\n        window.print();\\n      }, 150);\\n    } else {\\n      window.print();\\n    }\\n  };\", \"StartLine\":245, \"TargetContent\":\"  const handlePrint = () => {\\n    window.print();\\n  };\", \"TargetFile\":\"/src/App.tsx\", \"toolAction\":\"Updating handlePrint in App.tsx\", \"toolSummary\":\"Update handlePrint in App.tsx\"}"
      original_name: "replace_file_content"
    }
