  code_action {
    action_spec {
      create_file {
        instruction: "import React from \'react\';\nimport { Sparkles, Printer } from \'lucide-react\';\n\ninterface NavbarProps {\n  activeTab: string;\n  setActiveTab: (tab: string) => void;\n  onOpenAiModal: () => void;\n  onPrint: () => void;\n}\n\nexport const Navbar: React.FC<NavbarProps> = ({\n  activeTab,\n  setActiveTab,\n  onOpenAiModal,\n  onPrint,\n}) => {\n  const navItems = [\n    { id: \'pei\', label: \'PEI & DUA 3.0\' },\n    { id: \'estudo_caso\', label: \'Estudo de Caso\' },\n    { id: \'paee\', label: \'Plano PAEE\' },\n    { id: \'painel\', label: \'PEI-Painel Coletivo\' },\n    { id: \'caa\', label: \'Prancha CAA\' },\n    { id: \'documento_oficial\', label: \'Modelo NAPNE / MEC\' },\n  ];\n\n  return (\n    <header className=\"sticky top-0 z-30 bg-white border-b border-slate-200 no-print\">\n      <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8\">\n        <div className=\"flex items-center justify-between gap-8 h-16\">\n          {/* Zone 1: Single text wordmark */}\n          <div className=\"flex items-center gap-3 shrink-0\">\n            <div className=\"w-9 h-9 rounded-lg bg-emerald-700 flex items-center justify-center text-white font-bold text-lg shadow-xs\">\n              E\n            </div>\n            <a\n              href=\"#\"\n              onClick={(e) => {\n                e.preventDefault();\n                setActiveTab(\'pei\');\n              }}\n              className=\"text-lg font-bold tracking-tight text-slate-900 whitespace-nowrap shrink-0 hover:text-emerald-800 transition-colors\"\n            >\n              EduInclusiva\n            </a>\n            <span className=\"hidden sm:inline-block text-xs text-slate-400\">\n              \302\267 PNEEI Decreto 12.686/2025\n            </span>\n          </div>\n\n          {/* Zone 2: 4-6 concise single-line text links */}\n          <nav className=\"hidden lg:flex items-center gap-1 xl:gap-2 text-sm font-medium text-slate-600\">\n            {navItems.map((item) => {\n              const isActive = activeTab === item.id;\n              return (\n                <button\n                  key={item.id}\n                  onClick={() => setActiveTab(item.id)}\n                  className={`px-3 py-1.5 rounded-md text-xs font-semibold whitespace-nowrap transition-colors ${\n                    isActive\n                      ? \'bg-slate-100 text-emerald-800\'\n                      : \'text-slate-600 hover:text-slate-900 hover:bg-slate-50\'\n                  }`}\n                >\n                  {item.label}\n                </button>\n              );\n            })}\n          </nav>\n\n          {/* Zone 3: Primary action */}\n          <div className=\"flex items-center gap-2 shrink-0\">\n            <button\n              onClick={onPrint}\n              className=\"hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 text-xs font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors whitespace-nowrap shrink-0 cursor-pointer\"\n              title=\"Visualizar e Imprimir Documento Oficial\"\n            >\n              <Printer className=\"w-3.5 h-3.5 text-slate-500\" />\n              Imprimir\n            </button>\n            <button\n              onClick={onOpenAiModal}\n              className=\"inline-flex items-center gap-1.5 px-3.5 py-1.5 text-xs font-semibold text-white bg-emerald-700 rounded-lg hover:bg-emerald-800 transition-colors whitespace-nowrap shrink-0 cursor-pointer shadow-xs\"\n            >\n              <Sparkles className=\"w-3.5 h-3.5 text-emerald-200\" />\n              Gerar PEI com IA\n            </button>\n          </div>\n        </div>\n\n        {/* Mobile secondary navigation strip */}\n        <div className=\"lg:hidden flex overflow-x-auto py-2 gap-1 border-t border-slate-100 scrollbar-none\">\n          {navItems.map((item) => (\n            <button\n              key={item.id}\n              onClick={() => setActiveTab(item.id)}\n              className={`px-2.5 py-1 text-xs font-medium rounded-md whitespace-nowrap shrink-0 ${\n                activeTab === item.id\n                  ? \'bg-emerald-50 text-emerald-800 font-semibold\'\n                  : \'text-slate-600\'\n              }`}\n            >\n              {item.label}\n            </button>\n          ))}\n        </div>\n      </div>\n    </header>\n  );\n};\n"
        path {
          absolute_uri: "file:///src/components/Navbar.tsx"
        }
        overwrite: true
      }
    }
