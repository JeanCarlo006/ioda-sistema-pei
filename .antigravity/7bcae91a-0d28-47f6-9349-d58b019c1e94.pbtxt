            }
            lines {
              text: "    coordenacao_napne: \'Prof. Alexandre Lima (Orienta\303\247\303\243o e NAPNE)\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "  },"
