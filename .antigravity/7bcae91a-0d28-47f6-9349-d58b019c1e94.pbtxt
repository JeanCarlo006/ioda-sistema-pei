              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    titulo: \'Transtorno misto ansioso e depressivo\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
