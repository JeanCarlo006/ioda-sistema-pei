              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Avalia\303\247\303\243o baseada no cumprimento dos testes funcionais automatizados, liberando o estudante da necessidade de reescrever o c\303\263digo indefinidamente.\',"
