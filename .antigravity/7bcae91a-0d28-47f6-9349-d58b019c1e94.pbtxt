              type: UNIFIED_DIFF_LINE_TYPE_DELETE
            }
            lines {
              text: "        \'Avalia\303\247\303\243o formativa, cont\303\255nua e processual integrada aos jogos e resolu\303\247\303\265es no plano inclinado. Substitui\303\247\303\243o da prova tradicional de papel e caneta por verifica\303\247\303\243o pr\303\241tica mediada com tabela de velcro e prancha de CAA.\',"
              type: UNIFIED_DIFF_LINE_TYPE_DELETE
