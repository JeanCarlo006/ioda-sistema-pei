  planner_response {
    thinking: "**Revising PeiView Structure**\n\nI\'m currently refining the `PeiView` component. My focus is on achieving a cleaner visual layout by increasing whitespace and opting for a neutral white card design. I\'ve also removed the conflicting colored borders and repetitive legal citations to streamline the interface and improve readability.\n\n\n**Implementing Student View Features**\n\nI\'m now incorporating several new features. I\'m adding a \"Ver Guia do Aluno\" toggle for a simplified, interactive student view with study tips and an \"Ouvir\" button to read aloud in Portuguese. I\'m also implementing the 4-part Classroom Guide for teachers, alongside a \"Ditar por Voz\" button for observations.\n\n\n"
    tool_calls {
      id: "call_306194"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { PEICompleto, MetaPEI } from \'../types/pei\';\\nimport { bancoDeSolucoesPedagogicas } from \'../data/initialCases\';\\nimport { ListenButton, VoiceDictationButton } from \'./SpeechControls\';\\nimport {\\n  BookOpen,\\n  Target,\\n  CheckCircle2,\\n  Clock,\\n  Layers,\\n  Award,\\n  Plus,\\n  Wrench,\\n  ListChecks,\\n  FileCheck,\\n  HeartHandshake,\\n  GraduationCap,\\n  Sparkles,\\n  CheckSquare,\\n  Square,\\n} from \'lucide-react\';\\n\\ninterface PeiViewProps {\\n  pei: PEICompleto;\\n  onUpdateMetaStatus: (metaId: string, newStatus: MetaPEI[\'status\'], newProgress: number) => void;\\n  onAddMeta: (newMeta: MetaPEI) => void;\\n  onOpenSolutionBank?: () => void;\\n  onUpdateObservacoes?: (novaObs: string) => void;\\n}\\n\\nexport const PeiView: React.FC<PeiViewProps> = ({\\n  pei,\\n  onUpdateMetaStatus,\\n  onAddMeta,\\n  onOpenSolutionBank,\\n  onUpdateObservacoes,\\n}) => {\\n  const { planejamento_pei, cabecalho, estudo_de_caso, historico_napne } = pei;\\n  const [showAddForm, setShowAddForm] = useState(false);\\n  const [modoGuiaAluno, setModoGuiaAluno] = useState(false);\\n  const [novaDescricao, setNovaDescricao] = useState(\'\');\\n  const [novoPrazo, setNovoPrazo] = useState(\'Mensal (4 semanas)\');\\n  const [novoIndicador, setNovoIndicador] = useState(\'\');\\n\\n  const handleCreateMeta = (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!novaDescricao.trim() || !novoIndicador.trim()) return;\\n\\n    const newMeta: MetaPEI = {\\n      id_meta: `M${planejamento_pei.objetivos_e_metas.length + 1}`,\\n      descricao_meta: novaDescricao.trim(),\\n      prazo: novoPrazo,\\n      indicador_sucesso: novoIndicador.trim(),\\n      progresso_percentual: 0,\\n      status: \'em_andamento\',\\n    };\\n\\n    onAddMeta(newMeta);\\n    setNovaDescricao(\'\');\\n    setNovoIndicador(\'\');\\n    setShowAddForm(false);\\n  };\\n\\n  // Resolve Practical Classroom Guide (from PEI or matched from condition bank)\\n  const fallbackSolucao =\\n    bancoDeSolucoesPedagogicas.find((s) =>\\n      (historico_napne.categoria_neurodivergencia || \'\')\\n        .toLowerCase()\\n        .includes(s.titulo.split(\' \')[0].toLowerCase())\\n    ) || bancoDeSolucoesPedagogicas[0];\\n\\n  const guiaPratico =\\n    planejamento_pei.guia_pratico_sala_de_aula || fallbackSolucao.guiaPratico!;\\n\\n  // Speech text for Teacher View\\n  const textoEstrategiasProfessor = [\\n    `Plano de aula adaptado para ${cabecalho.estudante} na disciplina ${cabecalho.componente_curricular}.`,\\n    `Passo a passo na pr\303\241tica: ${guiaPratico.passo_a_passo_explicacao}`,\\n    `Divis\303\243o da tarefa em 3 etapas: ${guiaPratico.divisao_tarefa_chunking.join(\' \')}`,\\n    `Como avaliar na pr\303\241tica: ${guiaPratico.avaliacao_pratica}`,\\n    `Manejo e acolhimento: ${guiaPratico.manejo_e_acolhimento}`,\\n    `Observa\303\247\303\265es do professor: ${planejamento_pei.observacoes_docente}`,\\n  ].join(\' \');\\n\\n  // Speech text for Student Guide View\\n  const interessesLista = estudo_de_caso.potencialidades.map((p) => p.descricao).join(\'. \');\\n  const metasListaTexto = planejamento_pei.objetivos_e_metas\\n    .map((m, i) => `Meta ${i + 1}: ${m.descricao_meta}.`)\\n    .join(\' \');\\n  const textoGuiaEstudante = `Ol\303\241, ${cabecalho.estudante.split(\' \')[0]}! Este \303\251 o seu Guia de Estudos em ${cabecalho.componente_curricular}. Seus pontos fortes s\303\243o: ${interessesLista}. Suas metas atuais s\303\243o: ${metasListaTexto} Seus recursos de apoio garantidos s\303\243o: ${estudo_de_caso.recursos_ta.join(\', \')}.`;\\n\\n  return (\\n    <div className=\\\"space-y-8\\\">\\n      {/* Top Action Bar: Toggle Student Guide + Listen Aloud + Solution Bank */}\\n      <div className=\\\"bg-white border border-slate-200 rounded-2xl p-4 sm:p-5 flex flex-wrap items-center justify-between gap-3\\\">\\n        <div>\\n          <h2 className=\\\"text-base sm:text-lg font-bold text-slate-900\\\">\\n            {modoGuiaAluno\\n              ? `Guia de Estudos do Estudante (${cabecalho.estudante.split(\' \')[0]})`\\n              : `Plano de Aula (PEI) \342\200\224 ${cabecalho.componente_curricular}`}\\n          </h2>\\n          <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n            {modoGuiaAluno\\n              ? \'Resumo acolhedor em formato de checklist pensado para leitura direta pelo estudante\'\\n              : \'Orienta\303\247\303\265es diretas de sala de aula, divis\303\243o de atividades e avalia\303\247\303\243o adaptada\'}\\n          </p>\\n        </div>\\n\\n        <div className=\\\"flex flex-wrap items-center gap-2\\\">\\n          <ListenButton\\n            text={modoGuiaAluno ? textoGuiaEstudante : textoEstrategiasProfessor}\\n            label={modoGuiaAluno ? \'Ouvir Meu Guia\' : \'Ouvir Estrat\303\251gias\'}\\n          />\\n\\n          <button\\n            type=\\\"button\\\"\\n            onClick={() => setModoGuiaAluno(!modoGuiaAluno)}\\n            className={`inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold transition-all cursor-pointer border ${\\n              modoGuiaAluno\\n                ? \'bg-slate-900 text-white border-slate-900\'\\n                : \'bg-emerald-50 text-emerald-900 border-emerald-300 hover:bg-emerald-100\'\\n            }`}\\n          >\\n            <GraduationCap className=\\\"w-4 h-4\\\" />\\n            <span>{modoGuiaAluno ? \'Voltar \303\240 Vis\303\243o do Professor\' : \'Ver Guia do Aluno\'}</span>\\n          </button>\\n\\n          {!modoGuiaAluno && onOpenSolutionBank && (\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onOpenSolutionBank}\\n              className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-semibold bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 transition-colors cursor-pointer\\\"\\n            >\\n              <Wrench className=\\\"w-3.5 h-3.5 text-emerald-700\\\" />\\n              <span>Outras Metodologias</span>\\n            </button>\\n          )}\\n        </div>\\n      </div>\\n\\n      {/* =================================================================== */}\\n      {/* VIS\303\203O DO ESTUDANTE (APOIO DIRETO AO ALUNO - DELIVERABLE 4)          */}\\n      {/* =================================================================== */}\\n      {modoGuiaAluno ? (\\n        <div className=\\\"space-y-6\\\">\\n          {/* Boas-vindas e Pontos Fortes */}\\n          <div className=\\\"bg-white border border-slate-200 rounded-2xl p-6 space-y-4\\\">\\n            <div className=\\\"flex items-center gap-3\\\">\\n              <div className=\\\"w-10 h-10 rounded-xl bg-emerald-100 text-emerald-800 flex items-center justify-center\\\">\\n                <Sparkles className=\\\"w-5 h-5\\\" />\\n              </div>\\n              <div>\\n                <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n                  Ol\303\241, {cabecalho.estudante.split(\' \')[0]}! Seus Pontos Fortes e Interesses\\n                </h3>\\n                <p className=\\\"text-xs text-slate-500\\\">\\n                  Seu plano na disciplina <strong>{cabecalho.componente_curricular}</strong> foi constru\303\255do valorizando o que voc\303\252 faz de melhor:\\n                </p>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-3 pt-1\\\">\\n              {estudo_de_caso.potencialidades.map((pot) => (\\n                <div\\n                  key={pot.id}\\n                  className=\\\"p-4 rounded-xl bg-slate-50 border border-slate-200\\\"\\n                >\\n                  <span className=\\\"text-xs font-bold text-emerald-800 block mb-1\\\">\\n                    {pot.area}\\n                  </span>\\n                  <p className=\\\"text-sm text-slate-800 leading-relaxed\\\">\\n                    {pot.descricao}\\n                  </p>\\n                </div>\\n              ))}\\n            </div>\\n          </div>\\n\\n          {/* Checklist de Metas do Estudante */}\\n          <div className=\\\"bg-white border border-slate-200 rounded-2xl p-6 space-y-4\\\">\\n            <div className=\\\"flex items-center justify-between\\\">\\n              <div className=\\\"flex items-center gap-2.5\\\">\\n                <CheckSquare className=\\\"w-5 h-5 text-emerald-600\\\" />\\n                <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n                  Meu Checklist de Metas na Disciplina\\n                </h3>\\n              </div>\\n              <span className=\\\"text-xs text-slate-500\\\">\\n                Clique em uma meta quando concluir cada etapa\\n              </span>\\n            </div>\\n\\n            <div className=\\\"space-y-3\\\">\\n              {planejamento_pei.objetivos_e_metas.map((meta) => {\\n                const concluida = meta.status === \'alcancada\' || meta.progresso_percentual >= 100;\\n                return (\\n                  <button\\n                    key={meta.id_meta}\\n                    type=\\\"button\\\"\\n                    onClick={() =>\\n                      onUpdateMetaStatus(\\n                        meta.id_meta,\\n                        concluida ? \'em_andamento\' : \'alcancada\',\\n                        concluida ? 50 : 100\\n                      )\\n                    }\\n                    className={`w-full text-left p-4 rounded-xl border transition-all flex items-start gap-3.5 cursor-pointer ${\\n                      concluida\\n                        ? \'bg-emerald-50/70 border-emerald-300\'\\n                        : \'bg-slate-50 border-slate-200 hover:bg-white\'\\n                    }`}\\n                  >\\n                    <div className=\\\"mt-0.5 text-emerald-700 shrink-0\\\">\\n                      {concluida ? (\\n                        <CheckSquare className=\\\"w-5 h-5\\\" />\\n                      ) : (\\n                        <Square className=\\\"w-5 h-5 text-slate-400\\\" />\\n                      )}\\n                    </div>\\n                    <div className=\\\"flex-1\\\">\\n                      <p\\n                        className={`text-sm font-bold ${\\n                          concluida ? \'line-through text-slate-500\' : \'text-slate-900\'\\n                        }`}\\n                      >\\n                        {meta.descricao_meta}\\n                      </p>\\n                      <p className=\\\"text-xs text-slate-600 mt-1\\\">\\n                        <strong>Como saber que consegui:</strong> {meta.indicador_sucesso} ({meta.prazo})\\n                      </p>\\n                    </div>\\n                  </button>\\n                );\\n              })}\\n            </div>\\n          </div>\\n\\n          {/* Dicas Pr\303\241ticas de Estudo e Direitos em Aula */}\\n          <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-6\\\">\\n            <div className=\\\"bg-white border border-slate-200 rounded-2xl p-6 space-y-3\\\">\\n              <h3 className=\\\"text-sm font-bold text-slate-900 uppercase tracking-wider\\\">\\n                Como dividir suas atividades (Passo a Passo)\\n              </h3>\\n              <ul className=\\\"space-y-2\\\">\\n                {guiaPratico.divisao_tarefa_chunking.map((etapa, idx) => (\\n                  <li\\n                    key={idx}\\n                    className=\\\"text-sm text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200\\\"\\n                  >\\n                    {etapa}\\n                  </li>\\n                ))}\\n              </ul>\\n            </div>\\n\\n            <div className=\\\"bg-white border border-slate-200 rounded-2xl p-6 space-y-3\\\">\\n              <h3 className=\\\"text-sm font-bold text-slate-900 uppercase tracking-wider\\\">\\n                Seus Apoios Garantidos no Laborat\303\263rio e nas Provas\\n              </h3>\\n              <ul className=\\\"space-y-2\\\">\\n                {estudo_de_caso.recursos_ta.map((recurso, idx) => (\\n                  <li\\n                    key={idx}\\n                    className=\\\"text-sm text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-200 flex items-center gap-2\\\"\\n                  >\\n                    <CheckCircle2 className=\\\"w-4 h-4 text-emerald-600 shrink-0\\\" />\\n                    <span>{recurso}</span>\\n                  </li>\\n                ))}\\n              </ul>\\n            </div>\\n          </div>\\n        </div>\\n      ) : (\\n        /* =================================================================== */\\n        /* VIS\303\203O DO PROFESSOR (LIMPA, COM ESPA\303\207O EM BRANCO E GUIA PR\303\201TICO)     */\\n        /* =================================================================== */\\n        <div className=\\\"space-y-8\\\">\\n          {/* BLOCO 1: GUIA PR\303\201TICO DE SALA DE AULA (4 PILARES) */}\\n          <section className=\\\"bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 space-y-6\\\">\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-4\\\">\\n              <div>\\n                <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n                  1. Guia Pr\303\241tico de Sala de Aula\\n                </h3>\\n                <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n                  Como conduzir a aula, fracionar exerc\303\255cios e avaliar o estudante na pr\303\241tica\\n                </p>\\n              </div>\\n              <span className=\\\"text-xs font-semibold text-emerald-800 bg-emerald-50 px-3 py-1 rounded-full\\\">\\n                {historico_napne.categoria_neurodivergencia || \'Atendimento Individualizado\'}\\n              </span>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-2 gap-5\\\">\\n              {/* 1. Passo a Passo na Pr\303\241tica */}\\n              <div className=\\\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\\\">\\n                <div className=\\\"flex items-center gap-2 text-xs font-bold text-slate-900 uppercase tracking-wider\\\">\\n                  <BookOpen className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                  <span>Passo a Passo na Pr\303\241tica (Explica\303\247\303\243o)</span>\\n                </div>\\n                <p className=\\\"text-sm text-slate-700 leading-relaxed\\\">\\n                  {guiaPratico.passo_a_passo_explicacao}\\n                </p>\\n              </div>\\n\\n              {/* 2. Divis\303\243o da Tarefa (Chunking) */}\\n              <div className=\\\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\\\">\\n                <div className=\\\"flex items-center gap-2 text-xs font-bold text-slate-900 uppercase tracking-wider\\\">\\n                  <ListChecks className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                  <span>Divis\303\243o da Tarefa em 3 Etapas (Chunking)</span>\\n                </div>\\n                <ul className=\\\"space-y-1.5\\\">\\n                  {guiaPratico.divisao_tarefa_chunking.map((etapa, i) => (\\n                    <li key={i} className=\\\"text-xs sm:text-sm text-slate-700 leading-relaxed\\\">\\n                      \342\200\242 {etapa}\\n                    </li>\\n                  ))}\\n                </ul>\\n              </div>\\n\\n              {/* 3. Como Avaliar na Pr\303\241tica */}\\n              <div className=\\\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\\\">\\n                <div className=\\\"flex items-center gap-2 text-xs font-bold text-slate-900 uppercase tracking-wider\\\">\\n                  <FileCheck className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                  <span>Como Avaliar na Pr\303\241tica</span>\\n                </div>\\n                <p className=\\\"text-sm text-slate-700 leading-relaxed\\\">\\n                  {guiaPratico.avaliacao_pratica}\\n                </p>\\n              </div>\\n\\n              {/* 4. Manejo e Acolhimento */}\\n              <div className=\\\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\\\">\\n                <div className=\\\"flex items-center gap-2 text-xs font-bold text-slate-900 uppercase tracking-wider\\\">\\n                  <HeartHandshake className=\\\"w-4 h-4 text-emerald-600\\\" />\\n                  <span>Manejo e Acolhimento em Sala</span>\\n                </div>\\n                <p className=\\\"text-sm text-slate-700 leading-relaxed\\\">\\n                  {guiaPratico.manejo_e_acolhimento}\\n                </p>\\n              </div>\\n            </div>\\n          </section>\\n\\n          {/* BLOCO 2: EMENTA E FLEXIBILIZA\303\207\303\203O CURRICULAR */}\\n          <section className=\\\"bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 space-y-5\\\">\\n            <div className=\\\"border-b border-slate-100 pb-4\\\">\\n              <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n                2. Conte\303\272do da Disciplina e Adapta\303\247\303\243o\\n              </h3>\\n              <p className=\\\"text-xs text-slate-500 mt-0.5\\\">\\n                O que a turma est\303\241 estudando e como o conte\303\272do \303\251 flexibilizado sem perda de qualidade\\n              </p>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-5\\\">\\n              <div className=\\\"p-4 bg-slate-50 border border-slate-200 rounded-xl\\\">\\n                <span className=\\\"text-xs font-bold text-slate-800 block mb-1.5\\\">\\n                  Conte\303\272do da Ementa\\n                </span>\\n                <p className=\\\"text-xs sm:text-sm text-slate-600 leading-relaxed\\\">\\n                  {planejamento_pei.conteudo_ementa_oficial}\\n                </p>\\n              </div>\\n\\n              <div className=\\\"p-4 bg-slate-50 border border-slate-200 rounded-xl\\\">\\n                <span className=\\\"text-xs font-bold text-slate-800 block mb-1.5\\\">\\n                  Habilidades Esperadas\\n                </span>\\n                <p className=\\\"text-xs sm:text-sm text-slate-600 leading-relaxed\\\">\\n                  {planejamento_pei.competencias_habilidades_ementa}\\n                </p>\\n              </div>\\n\\n              <div className=\\\"p-4 bg-slate-50 border border-slate-200 rounded-xl\\\">\\n                <span className=\\\"text-xs font-bold text-emerald-800 block mb-1.5\\\">\\n                  Como Adaptar na Disciplina\\n                </span>\\n                <p className=\\\"text-xs sm:text-sm text-slate-700 leading-relaxed\\\">\\n                  {planejamento_pei.adaptacao_flexibilizacao_curricular}\\n                </p>\\n              </div>\\n            </div>\\n          </section>\\n\\n          {/* BLOCO 3: ESTRAT\303\211GIAS DUA (ENGAJAMENTO, REPRESENTA\303\207\303\203O E A\303\207\303\203O) */}\\n          <section className=\\\"bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 space-y-5\\\">\\n            <div className=\\\"flex items-center gap-2 border-b border-slate-100 pb-4\\\">\\n              <Layers className=\\\"w-5 h-5 text-emerald-600\\\" />\\n              <div>\\n                <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n                  3. Estrat\303\251gias de Ensino (Desenho Universal)\\n                </h3>\\n                <p className=\\\"text-xs text-slate-500\\\">\\n                  Formas de motivar, apresentar o material e permitir que o estudante demonstre o que aprendeu\\n                </p>\\n              </div>\\n            </div>\\n\\n            <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-5\\\">\\n              <div className=\\\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2.5\\\">\\n                <h4 className=\\\"text-xs font-bold text-slate-900 uppercase tracking-wider\\\">\\n                  Como Engajar e Motivar\\n                </h4>\\n                <ul className=\\\"space-y-2\\\">\\n                  {planejamento_pei.flexibilizacao_metodologica_dua.engajamento.map((item, i) => (\\n                    <li key={i} className=\\\"text-xs sm:text-sm text-slate-700 leading-relaxed\\\">\\n                      \342\200\242 {item}\\n                    </li>\\n                  ))}\\n                </ul>\\n              </div>\\n\\n              <div className=\\\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2.5\\\">\\n                <h4 className=\\\"text-xs font-bold text-slate-900 uppercase tracking-wider\\\">\\n                  Como Apresentar o Material\\n                </h4>\\n                <ul className=\\\"space-y-2\\\">\\n                  {planejamento_pei.flexibilizacao_metodologica_dua.representacao.map((item, i) => (\\n                    <li key={i} className=\\\"text-xs sm:text-sm text-slate-700 leading-relaxed\\\">\\n                      \342\200\242 {item}\\n                    </li>\\n                  ))}\\n                </ul>\\n              </div>\\n\\n              <div className=\\\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-2.5\\\">\\n                <h4 className=\\\"text-xs font-bold text-slate-900 uppercase tracking-wider\\\">\\n                  Atividades Pr\303\241ticas e Express\303\243o\\n                </h4>\\n                <ul className=\\\"space-y-2\\\">\\n                  {planejamento_pei.flexibilizacao_metodologica_dua.acao_e_expressao.map(\\n                    (item, i) => (\\n                      <li key={i} className=\\\"text-xs sm:text-sm text-slate-700 leading-relaxed\\\">\\n                        \342\200\242 {item}\\n                      </li>\\n                    )\\n                  )}\\n                </ul>\\n              </div>\\n            </div>\\n          </section>\\n\\n          {/* BLOCO 4: METAS DO ESTUDANTE */}\\n          <section className=\\\"bg-white border border-slate-200 rounded-2xl p-6 sm:p-7 space-y-5\\\">\\n            <div className=\\\"flex flex-wrap items-center justify-between gap-3 border-b border-slate-100 pb-4\\\">\\n              <div className=\\\"flex items-center gap-2\\\">\\n                <Target className=\\\"w-5 h-5 text-emerald-600\\\" />\\n                <div>\\n                  <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n                    4. Metas de Aprendizagem ({planejamento_pei.objetivos_e_metas.length})\\n                  </h3>\\n                  <p className=\\\"text-xs text-slate-500\\\">\\n                    Acompanhe a evolu\303\247\303\243o do estudante em cada meta definida para o per\303\255odo\\n                  </p>\\n                </div>\\n              </div>\\n\\n              <button\\n                onClick={() => setShowAddForm(!showAddForm)}\\n                className=\\\"inline-flex items-center gap-1.5 px-3.5 py-2 text-xs font-bold text-emerald-800 bg-emerald-50 hover:bg-emerald-100 border border-emerald-200 rounded-xl transition-colors cursor-pointer\\\"\\n              >\\n                <Plus className=\\\"w-4 h-4\\\" />\\n                <span>Nova Meta</span>\\n              </button>\\n            </div>\\n\\n            {showAddForm && (\\n              <form\\n                onSubmit={handleCreateMeta}\\n                className=\\\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-4\\\"\\n              >\\n                <h4 className=\\\"text-xs font-bold text-slate-900 uppercase\\\">\\n                  Adicionar Nova Meta ao PEI\\n                </h4>\\n                <div className=\\\"grid grid-cols-1 md:grid-cols-3 gap-4\\\">\\n                  <div className=\\\"md:col-span-2\\\">\\n                    <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                      Objetivo / Meta\\n                    </label>\\n                    <input\\n                      type=\\\"text\\\"\\n                      value={novaDescricao}\\n                      onChange={(e) => setNovaDescricao(e.target.value)}\\n                      placeholder=\\\"Ex: Implementar consultas SQL com apoio de script guia...\\\"\\n                      className=\\\"w-full p-2.5 text-xs bg-white border border-slate-300 rounded-lg\\\"\\n                      required\\n                    />\\n                  </div>\\n                  <div>\\n                    <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                      Prazo\\n                    </label>\\n                    <select\\n                      value={novoPrazo}\\n                      onChange={(e) => setNovoPrazo(e.target.value)}\\n                      className=\\\"w-full p-2.5 text-xs bg-white border border-slate-300 rounded-lg\\\"\\n                    >\\n                      <option value=\\\"Curto Prazo (2 semanas)\\\">Curto Prazo (2 semanas)</option>\\n                      <option value=\\\"Mensal (4 semanas)\\\">Mensal (4 semanas)</option>\\n                      <option value=\\\"Bimestral (8 semanas)\\\">Bimestral (8 semanas)</option>\\n                      <option value=\\\"Semestral (12 semanas)\\\">Semestral (12 semanas)</option>\\n                    </select>\\n                  </div>\\n                </div>\\n                <div>\\n                  <label className=\\\"block text-xs font-semibold text-slate-700 mb-1\\\">\\n                    Indicador de Sucesso\\n                  </label>\\n                  <input\\n                    type=\\\"text\\\"\\n                    value={novoIndicador}\\n                    onChange={(e) => setNovoIndicador(e.target.value)}\\n                    placeholder=\\\"Ex: Entrega do script validado em laborat\303\263rio\\\"\\n                    className=\\\"w-full p-2.5 text-xs bg-white border border-slate-300 rounded-lg\\\"\\n                    required\\n                  />\\n                </div>\\n                <div className=\\\"flex justify-end gap-2\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setShowAddForm(false)}\\n                    className=\\\"px-3.5 py-1.5 text-xs text-slate-600 hover:bg-slate-200 rounded-lg cursor-pointer\\\"\\n                  >\\n                    Cancelar\\n                  </button>\\n                  <button\\n                    type=\\\"submit\\\"\\n                    className=\\\"px-4 py-1.5 text-xs font-bold bg-emerald-700 text-white rounded-lg hover:bg-emerald-800 cursor-pointer\\\"\\n                  >\\n                    Salvar Meta\\n                  </button>\\n                </div>\\n              </form>\\n            )}\\n\\n            <div className=\\\"space-y-4\\\">\\n              {planejamento_pei.objetivos_e_metas.map((meta) => (\\n                <div\\n                  key={meta.id_meta}\\n                  className=\\\"p-5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\\\"\\n                >\\n                  <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\\\">\\n                    <div className=\\\"flex items-center gap-2\\\">\\n                      <span className=\\\"text-xs font-mono font-bold px-2 py-0.5 bg-white border border-slate-200 text-slate-800 rounded\\\">\\n                        {meta.id_meta}\\n                      </span>\\n                      <span className=\\\"inline-flex items-center gap-1 text-xs text-slate-500\\\">\\n                        <Clock className=\\\"w-3.5 h-3.5\\\" />\\n                        {meta.prazo}\\n                      </span>\\n                    </div>\\n\\n                    <div className=\\\"flex items-center gap-2\\\">\\n                      <select\\n                        value={meta.status}\\n                        onChange={(e) =>\\n                          onUpdateMetaStatus(\\n                            meta.id_meta,\\n                            e.target.value as MetaPEI[\'status\'],\\n                            e.target.value === \'alcancada\' ? 100 : meta.progresso_percentual\\n                          )\\n                        }\\n                        className=\\\"text-xs font-semibold border border-slate-300 rounded-lg px-2.5 py-1 bg-white text-slate-700 cursor-pointer\\\"\\n                      >\\n                        <option value=\\\"em_andamento\\\">Em Andamento</option>\\n                        <option value=\\\"alcancada\\\">Conclu\303\255da</option>\\n                        <option value=\\\"superada\\\">Superada</option>\\n                        <option value=\\\"em_revisao\\\">Em Revis\303\243o</option>\\n                      </select>\\n\\n                      <span className=\\\"text-xs font-mono font-bold text-emerald-700 min-w-[3rem] text-right\\\">\\n                        {meta.progresso_percentual}%\\n                      </span>\\n                    </div>\\n                  </div>\\n\\n                  <p className=\\\"text-sm font-bold text-slate-900\\\">{meta.descricao_meta}</p>\\n\\n                  <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1\\\">\\n                    <p className=\\\"text-xs text-slate-600 flex items-center gap-1.5\\\">\\n                      <CheckCircle2 className=\\\"w-3.5 h-3.5 text-emerald-600 shrink-0\\\" />\\n                      <span>\\n                        <strong>Evid\303\252ncia:</strong> {meta.indicador_sucesso}\\n                      </span>\\n                    </p>\\n\\n                    <div className=\\\"flex items-center gap-2 shrink-0\\\">\\n                      <span className=\\\"text-[11px] text-slate-500\\\">Progresso:</span>\\n                      <input\\n                        type=\\\"range\\\"\\n                        min={0}\\n                        max={100}\\n                        step={5}\\n                        value={meta.progresso_percentual}\\n                        onChange={(e) => {\\n                          const val = Number(e.target.value);\\n                          onUpdateMetaStatus(\\n                            meta.id_meta,\\n                            val === 100 ? \'alcancada\' : \'em_andamento\',\\n                            val\\n                          );\\n                        }}\\n                        className=\\\"w-28 accent-emerald-600 cursor-pointer\\\"\\n                      />\\n                    </div>\\n                  </div>\\n                </div>\\n              ))}\\n            </div>\\n          </section>\\n\\n          {/* BLOCO 5: AVALIA\303\207\303\203O E OBSERVA\303\207\303\225ES DO PROFESSOR (COM DITADO POR VOZ) */}\\n          <section className=\\\"grid grid-cols-1 lg:grid-cols-2 gap-6\\\">\\n            <div className=\\\"bg-white border border-slate-200 rounded-2xl p-6 space-y-4\\\">\\n              <div className=\\\"flex items-center gap-2 border-b border-slate-100 pb-3\\\">\\n                <Award className=\\\"w-5 h-5 text-emerald-600\\\" />\\n                <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n                  5. Condi\303\247\303\265es de Avalia\303\247\303\243o\\n                </h3>\\n              </div>\\n\\n              <div className=\\\"space-y-3 text-sm\\\">\\n                <div>\\n                  <span className=\\\"text-xs font-bold text-slate-500 uppercase block\\\">\\n                    Formato da Prova / Trabalho\\n                  </span>\\n                  <p className=\\\"text-slate-800 mt-0.5\\\">\\n                    {planejamento_pei.estrategias_avaliacao.formato_acessivel}\\n                  </p>\\n                </div>\\n                <div>\\n                  <span className=\\\"text-xs font-bold text-slate-500 uppercase block\\\">\\n                    Tempo e Local\\n                  </span>\\n                  <p className=\\\"text-slate-800 mt-0.5\\\">\\n                    {planejamento_pei.estrategias_avaliacao.tempo_e_espaco}\\n                  </p>\\n                </div>\\n                <div>\\n                  <span className=\\\"text-xs font-bold text-slate-500 uppercase block mb-1\\\">\\n                    Recursos Permitidos\\n                  </span>\\n                  <div className=\\\"flex flex-wrap gap-1.5\\\">\\n                    {planejamento_pei.estrategias_avaliacao.recursos_utilizados.map((rec, i) => (\\n                      <span\\n                        key={i}\\n                        className=\\\"text-xs bg-slate-100 text-slate-800 px-2.5 py-1 rounded-lg font-medium\\\"\\n                      >\\n                        {rec}\\n                      </span>\\n                    ))}\\n                  </div>\\n                </div>\\n              </div>\\n            </div>\\n\\n            {/* Observa\303\247\303\265es do Professor com Ditado por Voz */}\\n            <div className=\\\"bg-white border border-slate-200 rounded-2xl p-6 space-y-4\\\">\\n              <div className=\\\"flex items-center justify-between border-b border-slate-100 pb-3\\\">\\n                <h3 className=\\\"text-base font-bold text-slate-900\\\">\\n                  6. Observa\303\247\303\265es do Professor\\n                </h3>\\n                <VoiceDictationButton\\n                  label=\\\"Ditar por Voz\\\"\\n                  onTranscript={(spoken) => {\\n                    const atual = planejamento_pei.observacoes_docente || \'\';\\n                    const novoTexto = atual ? `${atual} ${spoken}` : spoken;\\n                    onUpdateObservacoes?.(novoTexto);\\n                  }}\\n                />\\n              </div>\\n\\n              <textarea\\n                value={planejamento_pei.observacoes_docente}\\n                onChange={(e) => onUpdateObservacoes?.(e.target.value)}\\n                rows={5}\\n                placeholder=\\\"Registre observa\303\247\303\265es sobre a participa\303\247\303\243o do estudante ou clique em \'Ditar por Voz\'...\\\"\\n                className=\\\"w-full p-3.5 bg-slate-50 border border-slate-200 rounded-xl text-sm text-slate-800 focus:bg-white focus:ring-2 focus:ring-emerald-600 focus:outline-none leading-relaxed\\\"\\n              />\\n            </div>\\n          </section>\\n        </div>\\n      )}\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Refactor PeiView.tsx with clean whitespace, Guia Pr\303\241tico de Sala de Aula, Ver Guia do Aluno toggle, ListenButton, and VoiceDictationButton\", \"Overwrite\":true, \"TargetFile\":\"/src/components/PeiView.tsx\", \"toolAction\":\"Refactoring PeiView.tsx\", \"toolSummary\":\"Refactor PeiView.tsx\"}"
      thinking_signature: "\022\371\021\n\366\021\001i\024}\023^\330\322G/\'re\303\374\017\262`\020\336\3133\004\304\306]M\343\357\221\217\344\363\001\301^,<^Z\017|n\233\277/\374K\231m\345\r\344\222\000\365|\3555v\245h\361\036\315\b\274\016o\2653\r\312\251\322\313\0308.\275\037K77u#\275\221\314\033\323\211\265\030\031\270\374[.y\356G\271n\310,&\236\v\220t\314\361\362\240\003\033\261\223`\002\253\243\276\"\250\031\020\a\202\003Q\262HLGnu\252\320\354\200\234\206\357\022`\017b\277N\353\231{5L\0039\277s\\\000)\356\300~\024.T\002)\337\311\354hJ\324\341\a\031.\036;Xq\016N\250\367\250/Rw\375\236\350\303\361\376#\003R\354\025bD\017\332\255\245\b;\020\350\376\215\231\303]\307yPH\367\336\355WSP8\031\020\300\333\340\260\313\'\016\316\310\243\226\256y\326\240\332\276\027\210\2050\362\201\274\212$]\271;E\201\177\031\246\025\032\275\264\377\334\324\332N\200\316aW\033\201\204\034=Mq\251JX\320&-0J\\\340HY,\333YQz_l2\352~\024\302-\255\203V\265r];Ws\035\2771Q\276\363\025\246\357\v\317%\006\277R(\377%\211\267#jbz\231\302\006<\376\027\204\345\204|\003P7,\241pf\210~\3300\244V{\024\003W%t\347\261-\330\316\364\344\270\375\236\270\253\263\212ty\0177\211\277Ae\307X\225+\034\243\240x\255\337\362\036\304\300\304\235\237S\364i\266\237]\223\322\330\220A\215\331\201\254!X\222\367o\334\223\325R\2131\2460C\210\355\2753K\263\206\330\rd\253\230\232\373\tMnzI\242s\335#\202\362l\232\305\352\254J3r\254|XC\222n:T3\337\326C\2161\023CX\035Wq\245T.w\311\243\363\237\022\247\350\203EsvK\001b<\245\212\334\356\366\205SLM\006-\276\314z\227\325%d\325<u.b\'\305\320\256\266\375p\034l?u@\024\213\023\v*Sm\267\003L-\225\242\355\246\332\375\301\005g\215c\351\3245V\231\233\344L\'\237(\370\001\276\372d\251F0\206{\317 Z\270\202\220\335\002o\315\335\272cE\320B\200\266E\224G;\243\303\205\314}\302w\205\340-m\313(ec\263\254#\344\3526.\223\204Z\331\f7\205\261\262~\322\367\t\0335\351\242\022q\000\331\226\033;FQ\270\203\376\224\305\'`\330\241\373\243\215\226\3743\224~\262\307\322\r-4\220\250L\005\352\022\326>\306\227B\037\214E\