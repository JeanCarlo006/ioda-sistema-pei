      name: "multi_replace_file_content"
      arguments_json: "{\"Description\":\"Update AddStudentModal.tsx to support multi-selection of neurodivergences and co-occurring conditions (e.g. TEA + TDAH)\", \"Instruction\":\"Replace single solucaoId selection with multi-select selectedSolucoes array and update Step 3 UI and PEI generation payload\", \"ReplacementChunks\":[{\"AllowMultiple\":false, \"EndLine\":78, \"ReplacementContent\":\"  const [selectedSolucoes, setSelectedSolucoes] = useState<string[]>([\'sol-tdah\']);\", \"StartLine\":77, \"TargetContent\":\"  const [solucaoId, setSolucaoId] = useState(\'sol-tdah\');\"}, {\"AllowMultiple\":false, \"EndLine\":222, \"ReplacementContent\":\"    if (perfil === \'superior_ti\') {\\n      setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\');\\n      setModulo(\'4\302\272 Per\303\255odo / Noturno\');\\n      setDisciplina(\'BAC.0406 - Engenharia de Software II\');\\n      setDocenteRegente(\'Prof. Alexandre Santos\');\\n      setIdade(\'21 anos\');\\n      syncSelectedConditions([\'sol-tdah\'], \'BAC.0406 - Engenharia de Software II\');\\n    } else {\\n      setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\\n      setModulo(\'2\302\272 Ano / Diurno\');\\n      setDisciplina(\'Programa\303\247\303\243o Web e Algoritmos\');\\n      setDocenteRegente(\'Prof. Docente da Disciplina\');\\n      setIdade(\'17 anos\');\\n      syncSelectedConditions([\'sol-tea\'], \'Programa\303\247\303\243o Web e Algoritmos\');\\n    }\\n  };\\n\\n  // Synchronize form fields whenever the multi-selected neurodivergences change\\n  const syncSelectedConditions = (ids: string[], discOverride?: string) => {\\n    const finalIds = ids.length > 0 ? ids : [\'sol-tdah\'];\\n    setSelectedSolucoes(finalIds);\\n\\n    const solucoesObjs = finalIds\\n      .map((sid) => bancoDeSolucoesPedagogicas.find((s) => s.id === sid))\\n      .filter(Boolean);\\n\\n    if (solucoesObjs.length > 0) {\\n      const titulosCombinados = solucoesObjs.map((s) => s!.titulo).join(\' + \');\\n      setCategoriaNeurodivergencia(titulosCombinados);\\n\\n      const currentDisc = discOverride ?? disciplina;\\n      const isEngSoft =\\n        currentDisc.toLowerCase().includes(\'engenharia de software\') ||\\n        currentDisc.includes(\'BAC.0406\');\\n\\n      const descricoesCombinadas = solucoesObjs\\n        .map((s) => `\342\200\242 ${s!.titulo}: ${s!.descricaoProblema}`)\\n        .join(\'\\\\n\');\\n\\n      let customCondicao = descricoesCombinadas;\\n      if (isEngSoft) {\\n        customCondicao += `\\\\n\\\\n[Contextualiza\303\247\303\243o na disciplina BAC.0406 - Engenharia de Software II: acomoda\303\247\303\265es integradas para testes unit\303\241rios TDD em JUnit/Selenium, relat\303\263rios de defeitos no Jira e normas de qualidade ISO/IEC 25010].`;\\n      }\\n      setCondicao(customCondicao);\\n\\n      const taUnificada = Array.from(\\n        new Set(solucoesObjs.flatMap((s) => s!.remediosSugeridos.recursosTA))\\n      );\\n      setAssistiveTech(taUnificada.join(\', \'));\\n\\n      const mapPotencial: Record<string, string> = {\\n        \'sol-tdah\':\\n          \'Racioc\303\255nio \303\241gil, resolu\303\247\303\243o criativa de bugs l\303\263gicos e hiperfoco em desafios t\303\251cnicos de codifica\303\247\303\243o quando apoiado por micro-sprints\',\\n        \'sol-tea\':\\n          \'Aten\303\247\303\243o meticulosa aos detalhes, racioc\303\255nio l\303\263gico met\303\263dico e facilidade para identificar anomalias em c\303\263digo e testes automatizados\',\\n        \'sol-ansiedade\':\\n          \'Rigor conceitual, comprometimento com entregas de qualidade e excelente desempenho em projetos pr\303\241ticos desenvolvidos com tranquilidade\',\\n        \'sol-aprendizagem\':\\n          \'Pensamento computacional visual, vis\303\243o de arquitetura de software desacoplada e excelente racioc\303\255nio algor\303\255tmico\',\\n        \'sol-def-intelectual\':\\n          \'Dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o, colabora\303\247\303\243o em duplas estruturadas e boa reten\303\247\303\243o com instru\303\247\303\265es objetivas\',\\n        \'sol-toc\':\\n          \'Elevada precis\303\243o t\303\251cnica, meticulosidade na cobertura de testes e ader\303\252ncia a padr\303\265es arquiteturais limpos\',\\n        \'sol-misto-ansioso-depressivo\':\\n          \'Comprometimento com projetos significativos e foco t\303\251cnico consistente quando amparado por metas graduais\',\\n        \'sol-depressao\':\\n          \'Capacidade anal\303\255tica e engajamento construtivo em projetos pr\303\241ticos em ambiente acolhedor e ass\303\255ncrono\',\\n        \'sol-epilepsia\':\\n          \'Racioc\303\255nio l\303\263gico estruturado e consist\303\252ncia t\303\251cnica em ambiente de laborat\303\263rio visualmente seguro\',\\n      };\\n\\n      const potList = finalIds.map(\\n        (id) =>\\n          mapPotencial[id] ||\\n          \'Dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o, racioc\303\255nio l\303\263gico e colabora\303\247\303\243o t\303\251cnica\'\\n      );\\n      setPotentialidades(Array.from(new Set(potList)).join(\'; \') + \'.\');\\n\\n      if (finalIds.includes(\'sol-hipotese-sem-laudo\')) {\\n        setStatusDiagnostico(\'em_investigacao_hipotese\');\\n      }\\n    }\\n  };\\n\\n  // Toggle selection of one or more neurodivergences (supports TEA + TDAH, etc.)\\n  const handleTogglePredefinedSolution = (id: string) => {\\n    const exists = selectedSolucoes.includes(id);\\n    let nextIds: string[];\\n    if (exists) {\\n      // Keep at least 1 selected or replace if only 1\\n      nextIds = selectedSolucoes.length > 1 ? selectedSolucoes.filter((item) => item !== id) : [id];\\n    } else {\\n      nextIds = [...selectedSolucoes, id];\\n    }\\n    syncSelectedConditions(nextIds);\\n  };\", \"StartLine\":162, \"TargetContent\":\"    if (perfil === \'superior_ti\') {\\n      setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (Campus Para\303\255so do Tocantins)\');\\n      setModulo(\'4\302\272 Per\303\255odo / Noturno\');\\n      setDisciplina(\'BAC.0406 - Engenharia de Software II\');\\n      setDocenteRegente(\'Prof. Alexandre Santos\');\\n      setIdade(\'21 anos\');\\n      setSolucaoId(\'sol-tdah\');\\n      setCondicao(\'Acomoda\303\247\303\265es para rotinas de testes automatizados (TDD), acompanhamento no Jira e laborat\303\263rio de software (LADES/LABIN).\');\\n      setAssistiveTech(\'Quadro Kanban/Jira integrado, t\303\251cnica Pomodoro, linters no VS Code e tempo ampliado (+50%).\');\\n      setPotentialidades(\'Racioc\303\255nio \303\241gil, resolu\303\247\303\243o r\303\241pida de defeitos l\303\263gicos e interesse em automa\303\247\303\243o de testes e arquitetura de software.\');\\n    } else {\\n      setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\\n      setModulo(\'2\302\272 Ano / Diurno\');\\n      setDisciplina(\'Programa\303\247\303\243o Web e Algoritmos\');\\n      setDocenteRegente(\'Prof. Docente da Disciplina\');\\n      setIdade(\'17 anos\');\\n      setSolucaoId(\'sol-tea\');\\n      setCondicao(\'Acomoda\303\247\303\265es metodol\303\263gicas no laborat\303\263rio de programa\303\247\303\243o, previsibilidade de rotina e recursos sensoriais.\');\\n      setAssistiveTech(\'Abafadores de ru\303\255do no LABIN, perfil com linter na IDE e tempo ampliado (+50%).\');\\n      setPotentialidades(\'Aten\303\247\303\243o a detalhes, capacidade l\303\263gica e dedica\303\247\303\243o a projetos de programa\303\247\303\243o.\');\\n    }\\n  };\\n\\n  // Select one of the 9 Neurodivergences or other conditions\\n  const handleSelectPredefinedSolution = (id: string) => {\\n    setSolucaoId(id);\\n    const sol = bancoDeSolucoesPedagogicas.find((s) => s.id === id);\\n    if (sol) {\\n      setCategoriaNeurodivergencia(sol.titulo);\\n\\n      const isEngSoft =\\n        disciplina.toLowerCase().includes(\'engenharia de software\') ||\\n        disciplina.includes(\'BAC.0406\');\\n\\n      let customCondicao = `${sol.condicao}: ${sol.descricaoProblema}`;\\n      if (isEngSoft) {\\n        customCondicao += ` [Contextualiza\303\247\303\243o na disciplina BAC.0406 - Engenharia de Software II: acomoda\303\247\303\265es para testes unit\303\241rios TDD em JUnit/Selenium, relat\303\263rios de defeitos no Jira e normas de qualidade ISO/IEC 25010].`;\\n      }\\n\\n      setCondicao(customCondicao);\\n      setAssistiveTech(sol.remediosSugeridos.recursosTA.join(\', \'));\\n      setPotentialidades(\\n        id === \'sol-tdah\'\\n          ? \'Racioc\303\255nio \303\241gil, resolu\303\247\303\243o criativa de bugs l\303\263gicos, hiperfoco em desafios t\303\251cnicos de codifica\303\247\303\243o quando apoiado por micro-sprints.\'\\n          : id === \'sol-tea\'\\n          ? \'Aten\303\247\303\243o aos detalhes, racioc\303\255nio l\303\263gico met\303\263dico, facilidade para identificar anomalias em c\303\263digo e testes automatizados.\'\\n          : id === \'sol-ansiedade\'\\n          ? \'Rigor conceitual, comprometimento com entregas de qualidade e excelente desempenho em projetos pr\303\241ticos desenvolvidos com tranquilidade.\'\\n          : id === \'sol-aprendizagem\'\\n          ? \'Pensamento computacional visual, vis\303\243o de arquitetura de software desacoplada e excelente racioc\303\255nio algor\303\255tmico.\'\\n          : id === \'sol-toc\'\\n          ? \'Elevada precis\303\243o t\303\251cnica, meticulosidade na cobertura de testes e ader\303\252ncia a padr\303\265es arquiteturais limpos.\'\\n          : \'Dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o, racioc\303\255nio l\303\263gico e colabora\303\247\303\243o com a equipe t\303\251cnica.\'\\n      );\\n\\n      if (id === \'sol-hipotese-sem-laudo\') {\\n        setStatusDiagnostico(\'em_investigacao_hipotese\');\\n      }\\n    }\\n  };\"}, {\"AllowMultiple\":false, \"EndLine\":268, \"ReplacementContent\":\"            perfilModalidade,\\n            statusDiagnostico,\\n            campus: \'Campus Para\303\255so\',\\n            selectedIds: selectedSolucoes,\\n            selectedNeurodivergences: selectedSolucoes\\n              .map((sid) => bancoDeSolucoesPedagogicas.find((s) => s.id === sid)?.titulo)\\n              .filter(Boolean),\\n          }),\\n        });\", \"StartLine\":263, \"TargetContent\":\"            perfilModalidade,\\n            statusDiagnostico,\\n            campus: \'Campus Para\303\255so\',\\n          }),\\n        });\"}, {\"AllowMultiple\":false, \"EndLine\":312, \"ReplacementContent\":\"              historico_napne: {\\n                status_diagnostico: statusDiagnostico,\\n                categoria_neurodivergencia:\\n                  statusDiagnostico === \'em_investigacao_hipotese\'\\n                    ? `Hip\303\263tese Diagn\303\263stica (${categoriaNeurodivergencia}) \302\267 Portaria MEC n\302\272 421/2026`\\n                    : categoriaNeurodivergencia || \'Diagn\303\263stico Confirmado em Prontu\303\241rio NAPNE\',\\n                cid_ou_hipotese:\\n                  statusDiagnostico === \'em_investigacao_hipotese\'\\n                    ? \'Em investiga\303\247\303\243o pedag\303\263gica multiprofissional pelo NAPNE Campus Para\303\255so\'\\n                    : \'Laudo pericial m\303\251dico arquivado no prontu\303\241rio do NAPNE\',\", \"StartLine\":302, \"TargetContent\":\"              historico_napne: {\\n                status_diagnostico: statusDiagnostico,\\n                categoria_neurodivergencia:\\n                  statusDiagnostico === \'em_investigacao_hipotese\'\\n                    ? \'Hip\303\263tese Diagn\303\263stica / Sem Laudo Fechado (Portaria MEC n\302\272 421/2026)\'\\n                    : \'Diagn\303\263stico Confirmado em Prontu\303\241rio NAPNE\',\\n                cid_ou_hipotese:\\n                  statusDiagnostico === \'em_investigacao_hipotese\'\\n                    ? \'Em investiga\303\247\303\243o pedag\303\263gica multiprofissional pelo NAPNE Campus Para\303\255so\'\\n                    : \'Laudo pericial m\303\251dico arquivado no prontu\303\241rio do NAPNE\',\"}, {\"AllowMultiple\":false, \"EndLine\":466, \"ReplacementContent\":\"          docenteRegente: docenteRegente.trim(),\\n          docenteAee: docenteAee.trim(),\\n          solucaoBaseId: selectedSolucoes[0] || \'sol-tdah\',\\n          solucaoBaseIds: selectedSolucoes,\\n          statusDiagnostico,\\n          categoriaNeurodivergencia,\\n        });\\n      }\", \"StartLine\":459, \"TargetContent\":\"          docenteRegente: docenteRegente.trim(),\\n          docenteAee: docenteAee.trim(),\\n          solucaoBaseId: solucaoId,\\n          statusDiagnostico,\\n          categoriaNeurodivergencia,\\n        });\\n      }\"}, {\"AllowMultiple\":false, \"EndLine\":1143, \"ReplacementContent\":\"              {/* LISTAGEM DAS 9 NEURODIVERG\303\212NCIAS (M\303\232LTIPLA SELE\303\207\303\203O) */}\\n              <div className=\\\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\\\">\\n                <div className=\\\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\\\">\\n                  <div>\\n                    <label className=\\\"text-xs font-bold text-slate-800 uppercase tracking-wider block\\\">\\n                      Neurodiverg\303\252ncias no Contexto de TI & Laborat\303\263rio (M\303\272ltipla Sele\303\247\303\243o):\\n                    </label>\\n                    <span className=\\\"text-[11px] text-slate-600\\\">\\n                      Voc\303\252 pode selecionar <strong>uma ou mais neurodiverg\303\252ncias</strong> (ex: TEA + TDAH). O PEI ser\303\241 adaptado para todas em conjunto:\\n                    </span>\\n                  </div>\\n                  <span className=\\\"text-[10px] bg-emerald-700 text-white font-bold px-2.5 py-1 rounded-full font-mono self-start sm:self-auto shrink-0\\\">\\n                    {selectedSolucoes.length} selecionada(s)\\n                  </span>\\n                </div>\\n\\n                {/* Quick Comorbidity Shortcuts */}\\n                <div className=\\\"flex flex-wrap items-center gap-1.5 pt-0.5\\\">\\n                  <span className=\\\"text-[10px] font-bold text-slate-500 uppercase mr-1\\\">\\n                    Combina\303\247\303\265es Frequentes:\\n                  </span>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => syncSelectedConditions([\'sol-tea\', \'sol-tdah\'])}\\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\\n                      selectedSolucoes.includes(\'sol-tea\') &&\\n                      selectedSolucoes.includes(\'sol-tdah\') &&\\n                      selectedSolucoes.length === 2\\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\\n                    }`}\\n                  >\\n                    + TEA + TDAH (Dupla Condi\303\247\303\243o)\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => syncSelectedConditions([\'sol-tdah\', \'sol-ansiedade\'])}\\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\\n                      selectedSolucoes.includes(\'sol-tdah\') &&\\n                      selectedSolucoes.includes(\'sol-ansiedade\') &&\\n                      selectedSolucoes.length === 2\\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\\n                    }`}\\n                  >\\n                    + TDAH + Ansiedade\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => syncSelectedConditions([\'sol-tea\', \'sol-ansiedade\'])}\\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\\n                      selectedSolucoes.includes(\'sol-tea\') &&\\n                      selectedSolucoes.includes(\'sol-ansiedade\') &&\\n                      selectedSolucoes.length === 2\\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\\n                    }`}\\n                  >\\n                    + TEA + Ansiedade\\n                  </button>\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => syncSelectedConditions([\'sol-tdah\', \'sol-aprendizagem\'])}\\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\\n                      selectedSolucoes.includes(\'sol-tdah\') &&\\n                      selectedSolucoes.includes(\'sol-aprendizagem\') &&\\n                      selectedSolucoes.length === 2\\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\\n                    }`}\\n                  >\\n                    + TDAH + Dislexia/Discalculia\\n                  </button>\\n                </div>\\n\\n                {/* Active Selection Pills */}\\n                {selectedSolucoes.length > 0 && (\\n                  <div className=\\\"p-2 bg-emerald-50/90 border border-emerald-200 rounded-lg flex flex-wrap items-center gap-1.5\\\">\\n                    <span className=\\\"text-[10px] font-bold text-emerald-950 uppercase mr-1\\\">\\n                      Ativas no PEI:\\n                    </span>\\n                    {selectedSolucoes.map((sid) => {\\n                      const sObj = bancoDeSolucoesPedagogicas.find((item) => item.id === sid);\\n                      if (!sObj) return null;\\n                      return (\\n                        <span\\n                          key={sid}\\n                          className=\\\"inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-700 text-white shadow-2xs\\\"\\n                        >\\n                          <span>{sObj.titulo}</span>\\n                          {selectedSolucoes.length > 1 && (\\n                            <button\\n                              type=\\\"button\\\"\\n                              onClick={(e) => {\\n                                e.stopPropagation();\\n                                handleTogglePredefinedSolution(sid);\\n                              }}\\n                              className=\\\"hover:text-emerald-200 ml-0.5 cursor-pointer\\\"\\n                              title=\\\"Remover esta condi\303\247\303\243o\\\"\\n                            >\\n                              <X className=\\\"w-3 h-3\\\" />\\n                            </button>\\n                          )}\\n                        </span>\\n                      );\\n                    })}\\n                  </div>\\n                )}\\n\\n                <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-60 overflow-y-auto pr-1\\\">\\n                  {[\\n                    {\\n                      id: \'sol-tdah\',\\n                      titulo: \'Transtorno do D\303\251ficit de Aten\303\247\303\243o com Hiperatividade (TDAH)\',\\n                      sigla: \'TDAH\',\\n                      icone: Brain,\\n                      resumo: \'Micro-sprints \303\241geis (Jira/Kanban), Pomodoro, linters no VS Code e TDD em etapas.\',\\n                    },\\n                    {\\n                      id: \'sol-tea\',\\n                      titulo: \'Transtorno do Espectro Autista (TEA)\',\\n                      sigla: \'TEA\',\\n                      icone: Sparkles,\\n                      resumo: \'Previsibilidade, roteiros de testes estruturados, abafador no LABIN e enunciados literais.\',\\n                    },\\n                    {\\n                      id: \'sol-ansiedade\',\\n                      titulo: \'Transtornos de ansiedade (generalizada, f\303\263bico-ansiosos, p\303\242nico, outros)\',\\n                      sigla: \'Ansiedade\',\\n                      icone: HeartPulse,\\n                      resumo: \'Apresenta\303\247\303\243o em v\303\255deo (Loom) ou reservada, rubricas antecipadas, pausas e tempo estendido (+50%).\',\\n                    },\\n                    {\\n                      id: \'sol-aprendizagem\',\\n                      titulo: \'Transtorno espec\303\255fico de aprendizagem (dislexia, disgrafia, discalculia)\',\\n                      sigla: \'Dislexia / Disgrafia\',\\n                      icone: BookOpen,\\n                      resumo: \'Fontes OpenDyslexic, linters visuais de erro e foco na l\303\263gica sem puni\303\247\303\243o sint\303\241tica.\',\\n                    },\\n                    {\\n                      id: \'sol-def-intelectual\',\\n                      titulo: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',\\n                      sigla: \'Def. Intelectual\',\\n                      icone: Users,\\n                      resumo: \'Instru\303\247\303\265es fracionadas em 2-3 passos, media\303\247\303\243o assistida de monitor e avalia\303\247\303\243o concreta.\',\\n                    },\\n                    {\\n                      id: \'sol-toc\',\\n                      titulo: \'Transtorno obsessivo-compulsivo (TOC)\',\\n                      sigla: \'TOC\',\\n                      icone: CheckSquare,\\n                      resumo: \'Crit\303\251rios expl\303\255citos de aceite (Definition of Done), pipelines CI/CD e limites saud\303\241veis de refatora\303\247\303\243o.\',\\n                    },\\n                    {\\n                      id: \'sol-misto-ansioso-depressivo\',\\n                      titulo: \'Transtorno misto ansioso e depressivo\',\\n                      sigla: \'Misto Ansioso/Depressivo\',\\n                      icone: Activity,\\n                      resumo: \'Metas graduais de recomposi\303\247\303\243o de autoefic\303\241cia, entregas semanais fracionadas e apoio cont\303\255nuo.\',\\n                    },\\n                    {\\n                      id: \'sol-depressao\',\\n                      titulo: \'Transtornos depressivos\',\\n                      sigla: \'Depress\303\243o\',\\n                      icone: Moon,\\n                      resumo: \'Regime de Atividades Acompanhadas (ODP-IFTO), acesso ass\303\255ncrono ao Moodle e duplas acolhedoras.\',\\n                    },\\n                    {\\n                      id: \'sol-epilepsia\',\\n                      titulo: \'Epilepsia e crises convulsivas\',\\n                      sigla: \'Epilepsia\',\\n                      icone: ShieldAlert,\\n                      resumo: \'Monitores com taxa est\303\241vel (60Hz+), tema de IDE sem flashes, pausas a cada 45min e protocolo de seguran\303\247a.\',\\n                    },\\n                  ].map((item) => {\\n                    const isSelected = selectedSolucoes.includes(item.id);\\n                    const IconComponent = item.icone;\\n                    return (\\n                      <button\\n                        key={item.id}\\n                        type=\\\"button\\\"\\n                        onClick={() => handleTogglePredefinedSolution(item.id)}\\n                        className={`p-2.5 text-left text-xs rounded-xl border transition-all cursor-pointer relative ${\\n                          isSelected\\n                            ? \'bg-emerald-50 border-emerald-600 text-emerald-950 font-medium shadow-xs ring-1 ring-emerald-600\'\\n                            : \'bg-white border-slate-200 text-slate-700 hover:border-slate-300 hover:bg-slate-50/50\'\\n                        }`}\\n                      >\\n                        <div className=\\\"flex items-start justify-between gap-1.5 mb-1\\\">\\n                          <div className=\\\"flex items-center gap-1.5 min-w-0\\\">\\n                            <div className={`p-1 rounded-md shrink-0 ${isSelected ? \'bg-emerald-700 text-white\' : \'bg-slate-100 text-slate-600\'}`}>\\n                              <IconComponent className=\\\"w-3.5 h-3.5\\\" />\\n                            </div>\\n                            <span className=\\\"font-bold text-slate-900 truncate text-[11px] leading-tight\\\">\\n                              {item.titulo}\\n                            </span>\\n                          </div>\\n                          <div\\n                            className={`w-4 h-4 rounded flex items-center justify-center border shrink-0 mt-0.5 ${\\n                              isSelected\\n                                ? \'bg-emerald-700 border-emerald-700 text-white\'\\n                                : \'border-slate-300 bg-white\'\\n                            }`}\\n                          >\\n                            {isSelected && <Check className=\\\"w-3 h-3\\\" />}\\n                          </div>\\n                        </div>\\n                        <p className=\\\"text-[10px] text-slate-500 leading-snug line-clamp-2 pl-6\\\">\\n                          {item.resumo}\\n                        </p>\\n                      </button>\\n                    );\\n                  })}\\n                </div>\\n\\n                {/* Secondary toggle for Sensory/Physical conditions */}\\n                <div className=\\\"pt-1 border-t border-slate-200\\\">\\n                  <button\\n                    type=\\\"button\\\"\\n                    onClick={() => setMostrarOutrasCondicoes(!mostrarOutrasCondicoes)}\\n                    className=\\\"text-[11px] font-semibold text-emerald-800 hover:text-emerald-950 flex items-center gap-1 cursor-pointer\\\"\\n                  >\\n                    <span>{mostrarOutrasCondicoes ? \'\342\210\222 Ocultar\' : \'+ Exibir\'} Outras Condi\303\247\303\265es (Defici\303\252ncia Visual, Motora, Surdez, Sem Laudo)</span>\\n                  </button>\\n\\n                  {mostrarOutrasCondicoes && (\\n                    <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-2\\\">\\n                      {bancoDeSolucoesPedagogicas\\n                        .filter(\\n                          (s) =>\\n                            ![\\n                              \'sol-tdah\',\\n                              \'sol-tea\',\\n                              \'sol-ansiedade\',\\n                              \'sol-aprendizagem\',\\n                              \'sol-def-intelectual\',\\n                              \'sol-toc\',\\n                              \'sol-misto-ansioso-depressivo\',\\n                              \'sol-depressao\',\\n                              \'sol-epilepsia\',\\n                            ].includes(s.id)\\n                        )\\n                        .map((sol) => {\\n                          const isOtherSelected = selectedSolucoes.includes(sol.id);\\n                          return (\\n                            <button\\n                              key={sol.id}\\n                              type=\\\"button\\\"\\n                              onClick={() => handleTogglePredefinedSolution(sol.id)}\\n                              className={`p-2 text-left text-xs rounded-lg border transition-all cursor-pointer flex item