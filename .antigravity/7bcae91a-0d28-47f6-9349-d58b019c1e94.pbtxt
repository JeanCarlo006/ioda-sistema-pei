dentificadas pela equipe pedag\303\263gica.\',\n    descricao_condicao_especifica:\n      \'Apresenta grande dificuldade na decodifica\303\247\303\243o e digita\303\247\303\243o de sintaxes textuais r\303\255gidas de c\303\263digo (troca de caracteres como ponto-e-v\303\255rgula, chaves, par\303\252nteses e indenta\303\247\303\243o), fadiga r\303\241pida na leitura de enunciados prolixos e lentid\303\243o para transcrever algoritmos do quadro para a IDE. Em contrapartida, demonstra excelente racioc\303\255nio l\303\263gico-matem\303\241tico quando resolve problemas por meio de blocos visuais, diagramas ou explica oralmente o racioc\303\255nio.\',\n    informacoes_dos_pais:\n      \'A fam\303\255lia foi acolhida pelo NAPNE do Campus Para\303\255so e relata hist\303\263rico de dificuldades com leitura e escrita desde os anos finais do ensino fundamental, sem acesso anterior a avalia\303\247\303\243o neuropsicol\303\263gica por car\303\252ncia de especialistas na regi\303\243o. A fam\303\255lia apoia integralmente o plano de atendimento pedag\303\263gico inclusivo enquanto aguarda encaminhamento \303\240 rede p\303\272blica de sa\303\272de.\',\n  },"
          replacement_content: "export const casoCauaSemLaudo: PEICompleto = {\n  id: \'MED-INF-05-HIP\',\n  cabecalho: {\n    estudante: \'Estudante INF-05 (Hip\303\263tese s/ Laudo)\',\n    codigo_matricula: \'2026.1.INF.058\',\n    idade: \'15 anos\',\n    curso: \'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\',\n    componente_curricular: \'L\303\263gica de Programa\303\247\303\243o e Algoritmos\',\n    modulo_periodo: \'1\302\272 Ano / 2\302\272 Semestre\',\n    data_elaboracao: \'2026-10-27\',\n    docente_regente: \'Prof. Marcos Vin\303\255cius Toledo (Docente de Algoritmos e L\303\263gica)\',\n    docente_aee: \'Prof\302\252. Renata Cavalcanti (Especialista em Educa\303\247\303\243o Especial / NAPNE)\',\n    profissional_apoio: \'Monitor de Acessibilidade Digital e Laborat\303\263rio\',\n    coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n  },\n  historico_napne: {\n    status_diagnostico: \'em_investigacao_hipotese\',\n    categoria_neurodivergencia: \'Hip\303\263tese Diagn\303\263stica em Investiga\303\247\303\243o Pedag\303\263gica (Sem Laudo)\',\n    cid_ou_hipotese: \'Em investiga\303\247\303\243o pedag\303\263gica pelo NAPNE (Portaria MEC n\302\272 421/2026)\',\n    breve_historico_clinico_familiar:\n      \'Estudante do 1\302\272 Ano do Curso T\303\251cnico Integrado em Inform\303\241tica no Campus Para\303\255so. Integra o grupo dos 5 estudantes acompanhados pelo NAPNE que n\303\243o possuem diagn\303\263stico m\303\251dico formal. Conforme preconizado pela Portaria MEC n\302\272 421/2026 e pelo Decreto n\302\272 12.686/2025, a aus\303\252ncia de laudo m\303\251dico N\303\203O impede a elabora\303\247\303\243o do PEI nem a concess\303\243o de apoios e Tecnologias Assistivas no laborat\303\263rio de TI.\',\n    descricao_condicao_especifica:\n      \'Apresenta grande dificuldade na decodifica\303\247\303\243o e digita\303\247\303\243o de sintaxes textuais r\303\255gidas de c\303\263digo (troca de caracteres como ponto-e-v\303\255rgula, chaves e par\303\252nteses) e fadiga na leitura de enunciados densos. Demonstra excelente racioc\303\255nio algor\303\255tmico quando apoiado por linters visuais e enunciados fracionados.\',\n    informacoes_dos_pais:\n      \'Fam\303\255lia acolhida pelo NAPNE Campus Para\303\255so, com alinhamento cont\303\255nuo sobre os apoios pedag\303\263gicos em sala de aula.\',\n  },"
