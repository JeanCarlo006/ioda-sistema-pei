    content: "import React, { useState } from \'react\';\nimport { PEICompleto } from \'../types/pei\';\nimport {\n  Sparkles,\n  FileText,\n  Search,\n  BookOpen,\n  Wrench,\n  LayoutDashboard,\n  ShieldCheck,\n  BarChart3,\n  Printer,\n  UserPlus,\n  ChevronDown,\n  ArrowRight,\n  Sliders,\n  CheckCircle,\n  HelpCircle,\n  Laptop,\n  GraduationCap,\n} from \'lucide-react\';\n\ninterface ILovePeiHubProps {\n  activePei: PEICompleto;\n  allStudents: PEICompleto[];\n  onSelectStudent: (student: PEICompleto) => void;\n  onNavigate: (tabId: string) => void;\n  onOpenAddStudent: () => void;\n  onOpenSolutionBank: () => void;\n  onOpenCampusStats: () => void;\n  onPrint: () => void;\n}\n\nexport const ILovePeiHub: React.FC<ILovePeiHubProps> = ({\n  activePei,\n  allStudents,\n  onSelectStudent,\n  onNavigate,\n  onOpenAddStudent,\n  onOpenSolutionBank,\n  onOpenCampusStats,\n  onPrint,\n}) => {\n  const [activeCategory, setActiveCategory] = useState<string>(\'todas\');\n  const [isStudentDropdownOpen, setIsStudentDropdownOpen] = useState<boolean>(false);\n\n  // Categories matching iLovePDF pill style\n  const categories = [\n    { id: \'todas\', label: \'Todas\' },\n    { id: \'elaboracao\', label: \'Elabora\303\247\303\243o do PEI\' },\n    { id: \'dua\', label: \'DUA 3.0 & Acessibilidade\' },\n    { id: \'estudo_caso\', label: \'Estudo de Caso\' },\n    { id: \'oficial\', label: \'Documento Oficial\' },\n    { id: \'metas\', label: \'Acompanhamento & Metas\' },\n  ];\n\n  // Tool cards list in iLovePDF layout\n  const toolCards = [\n    {\n      id: \'novo_pei\',\n      category: \'elaboracao\',\n      title: \'Novo PEI com Ioda AI\',\n      description: \'Elaborar um novo Plano de Ensino Individualizado via assistente por etapas com DUA 3.0.\',\n      iconBg: \'bg-emerald-600 text-white\',\n      badge: \'IA Integrada\',\n      icon: Sparkles,\n      action: onOpenAddStudent,\n    },\n    {\n      id: \'plano_pei\',\n      category: \'elaboracao\',\n      title: \'Plano de Ensino (PEI)\',\n      description: \'Consultar flexibiliza\303\247\303\265es curriculares, metas de aprendizagem e estrat\303\251gias de laborat\303\263rio.\',\n      iconBg: \'bg-emerald-700 text-white\',\n      badge: null,\n      icon: FileText,\n      action: () => onNavigate(\'pei\'),\n    },\n    {\n      id: \'estudo_caso\',\n      category: \'estudo_caso\',\n      title: \'Estudo de Caso & Barreiras\',\n      description: \'An\303\241lise biopsicossocial em 4 etapas: barreiras escolares, potencialidades e recursos de TA.\',\n      iconBg: \'bg-teal-700 text-white\',\n      badge: \'Art. 11 PNEEI\',\n      icon: Search,\n      action: () => onNavigate(\'estudo_caso\'),\n    },\n    {\n      id: \'modelo_oficial\',\n      category: \'oficial\',\n      title: \'Modelo Oficial NAPNE / MEC\',\n      description: \'Documento formatado nos 8 blocos oficiais do IFTO para valida\303\247\303\243o e processo SEI.\',\n      iconBg: \'bg-emerald-900 text-white\',\n      badge: \'Oficial IFTO\',\n      icon: BookOpen,\n      action: () => onNavigate(\'documento_oficial\'),\n    },\n    {\n      id: \'banco_solucoes\',\n      category: \'dua\',\n      title: \'Banco de Solu\303\247\303\265es DUA 3.0\',\n      description: \'Cat\303\241logo de tecnologias assistivas e solu\303\247\303\265es pedag\303\263gicas para laborat\303\263rios de TI.\',\n      iconBg: \'bg-emerald-600 text-white\',\n      badge: \'DUA 3.0\',\n      icon: Wrench,\n      action: onOpenSolutionBank,\n    },\n    {\n      id: \'painel_metas\',\n      category: \'metas\',\n      title: \'Painel de Acompanhamento\',\n      description: \'Gerenciar ciclo de reavalia\303\247\303\243o cont\303\255nua, percentual de metas e notas em post-its da equipe.\',\n      iconBg: \'bg-slate-900 text-white\',\n      badge: null,\n      icon: LayoutDashboard,\n      action: () => onNavigate(\'painel\'),\n    },\n    {\n      id: \'portaria_mec_421\',\n      category: \'dua\',\n      title: \'Garantia Sem Laudo (MEC 421)\',\n      description: \'Apoio pedag\303\263gico e Tecnologias Assistivas garantidos para alunos em investiga\303\247\303\243o sem laudo.\',\n      iconBg: \'bg-amber-600 text-white\',\n      badge: \'Portaria 421/2026\',\n      icon: ShieldCheck,\n      action: () => {\n        // Find anonymous student with hypothesis or open solution\n        const semLaudoStudent = allStudents.find(\n          (s) => s.historico_napne.status_diagnostico === \'em_investigacao_hipotese\'\n        );\n        if (semLaudoStudent) {\n          onSelectStudent(semLaudoStudent);\n          onNavigate(\'pei\');\n        } else {\n          onOpenSolutionBank();\n        }\n      },\n    },\n    {\n      id: \'censo_campus\',\n      category: \'metas\',\n      title: \'Censo do Campus Para\303\255so\',\n      description: \'Painel demogr\303\241fico dos 29 estudantes acompanhados: 15 M\303\251dio T\303\251cnico e 14 Superior em TI.\',\n      iconBg: \'bg-teal-800 text-white\',\n      badge: \'29 Alunos\',\n      icon: BarChart3,\n      action: onOpenCampusStats,\n    },\n    {\n      id: \'imprimir_exportar\',\n      category: \'oficial\',\n      title: \'Imprimir / Exportar PDF\',\n      description: \'Gerar vers\303\243o para impress\303\243o oficial ou salvar em PDF para anexar ao prontu\303\241rio escolar.\',\n      iconBg: \'bg-black text-white\',\n      badge: \'PDF / Print\',\n      icon: Printer,\n      action: onPrint,\n    },\n  ];\n\n  // Filter tool cards based on active pill\n  const filteredCards = toolCards.filter((card) => {\n    if (activeCategory === \'todas\') return true;\n    return card.category === activeCategory;\n  });\n\n  return (\n    <div className=\"space-y-8 animate-fadeIn\">\n      {/* 1. HERO SECTION (iLovePDF visual style) */}\n      <div className=\"text-center pt-3 pb-2 max-w-4xl mx-auto px-4\">\n        <h1 className=\"text-3xl sm:text-4xl md:text-5xl font-black text-slate-900 tracking-tight\">\n          Ol\303\241, Jean Carlo, vamos come\303\247ar\n        </h1>\n        <p className=\"mt-2.5 text-sm sm:text-base text-slate-600 font-normal max-w-2xl mx-auto leading-relaxed\">\n          Plataforma Ioda \302\267 Ferramentas inteligentes para elabora\303\247\303\243o, flexibiliza\303\247\303\243o curricular (DUA 3.0) e acompanhamento do PEI no IFTO.\n        </p>\n\n        {/* Active Student Selector Bar */}\n        <div className=\"mt-5 max-w-2xl mx-auto\">"
    num_lines: 357
    num_bytes: 14435
    line_range_bytes: 5856
  }
}
