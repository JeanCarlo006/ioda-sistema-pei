            }
            lines {
              text: "    cid_ou_hipotese: \'Em investiga\303\247\303\243o pedag\303\263gica e multiprofissional pelo NAPNE (sem CID m\303\251dico conclusivo)\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    breve_historico_clinico_familiar:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Estudante do 1\302\272 Ano do Curso T\303\251cnico Integrado em Inform\303\241tica no Campus Para\303\255so. Integra o grupo dos 5 estudantes acompanhados pelo NAPNE que n\303\243o possuem diagn\303\263stico m\303\251dico formal (casos com hip\303\263tese diagn\303\263stica ou suspeita de neurodiverg\303\252ncia). Conforme expressamente preconizado pela Portaria MEC n\302\272 421/2026 e pelo Decreto n\302\272 12.686/2025, a aus\303\252ncia de laudo m\303\251dico N\303\203O impede a elabora\303\247\303\243o do PEI nem a concess\303\243o de apoios e Tecnologias Assistivas, uma vez que o direito \303\240 acessibilidade fundamenta-se nas barreiras escolares identificadas pela equipe pedag\303\263gica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    descricao_condicao_especifica:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'Apresenta grande dificuldade na decodifica\303\247\303\243o e digita\303\247\303\243o de sintaxes textuais r\303\255gidas de c\303\263digo (troca de caracteres como ponto-e-v\303\255rgula, chaves, par\303\252nteses e indenta\303\247\303\243o), fadiga r\303\241pida na leitura de enunciados prolixos e lentid\303\243o para transcrever algoritmos do quadro para a IDE. Em contrapartida, demonstra excelente racioc\303\255nio l\303\263gico-matem\303\241tico quando resolve problemas por meio de blocos visuais, diagramas ou explica oralmente o racioc\303\255nio.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "    informacoes_dos_pais:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      \'A fam\303\255lia foi acolhida pelo NAPNE do Campus Para\303\255so e relata hist\303\263rico de dificuldades com leitura e escrita desde os anos finais do ensino fundamental, sem acesso anterior a avalia\303\247\303\243o neuropsicol\303\263gica por car\303\252ncia de especialistas na regi\303\243o. A fam\303\255lia apoia integralmente o plano de atendimento pedag\303\263gico inclusivo enquanto aguarda encaminhamento \303\240 rede p\303\272blica de sa\303\272de.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
