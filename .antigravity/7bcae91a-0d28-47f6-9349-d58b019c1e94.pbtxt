            lines {
              text: "        impacto: \'A fadiga muscular nas m\303\243os impede a finaliza\303\247\303\243o do c\303\263digo, gerando notas que n\303\243o refletem sua real capacidade l\303\263gica.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
