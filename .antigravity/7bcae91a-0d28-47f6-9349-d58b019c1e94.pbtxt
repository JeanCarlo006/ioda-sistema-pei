            }
            lines {
              text: "    id: \'sol-toc\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    titulo: \'Transtorno obsessivo-compulsivo (TOC)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    condicao: \'Transtorno obsessivo-compulsivo (TOC)\',"
              type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
            }
            lines {
              text: "    nivelSugerido: \'Ambos\',"
