  planner_response {
    thinking: "**Integrating Gemini API**\n\nI\'m currently focused on integrating the Gemini API into `src/components/AddStudentModal.tsx`. My goal is to enable automatic PEI generation when student data is entered, as requested. The primary focus right now is to understand how best to structure the interaction with the Gemini API to streamline the PEI generation process within the modal\'s workflow.\n\n\n**Designing PEI Generation**\n\nI\'m now designing the `AddStudentModal.tsx` component. I\'m focusing on data collection for student information, including full name, education level, course, IT subject, module/period, student condition, and existing assistive technologies (optional). I\'m also planning the interactive generation engine, which will call the Gemini API on button click, with a loading state indicating visual progress steps. I\'m considering using quick-fill buttons for common barriers and including suggestions for technologies.\n\n\n"
    tool_calls {
      id: "call_3702017"
      name: "write_to_file"
      arguments_json: "{\"CodeContent\":\"import React, { useState } from \'react\';\\nimport { PEICompleto } from \'../types/pei\';\\nimport { gerarNovoPeiCompleto, bancoDeSolucoesPedagogicas } from \'../data/initialCases\';\\nimport {\\n  UserPlus,\\n  X,\\n  Sparkles,\\n  GraduationCap,\\n  Loader2,\\n  CheckCircle,\\n  Cpu,\\n  Layers,\\n  Wrench,\\n} from \'lucide-react\';\\n\\ninterface AddStudentModalProps {\\n  isOpen: boolean;\\n  onClose: () => void;\\n  onAddStudent: (newStudent: PEICompleto) => void;\\n}\\n\\nexport const AddStudentModal: React.FC<AddStudentModalProps> = ({\\n  isOpen,\\n  onClose,\\n  onAddStudent,\\n}) => {\\n  const [nivelEducacional, setNivelEducacional] = useState<\'medio\' | \'superior\'>(\'medio\');\\n  const [nome, setNome] = useState(\'\');\\n  const [matricula, setMatricula] = useState(\'\');\\n  const [idade, setIdade] = useState(\'17 anos\');\\n  const [curso, setCurso] = useState(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\\n  const [disciplina, setDisciplina] = useState(\'Programa\303\247\303\243o Web e Algoritmos\');\\n  const [modulo, setModulo] = useState(\'2\302\272 Ano / 1\302\272 Semestre\');\\n  const [condicao, setCondicao] = useState(\'\');\\n  const [potencialidades, setPotentialidades] = useState(\'\');\\n  const [assistiveTech, setAssistiveTech] = useState(\'\');\\n  const [solucaoId, setSolucaoId] = useState(\'sol-motor-programacao\');\\n  const [docenteRegente, setDocenteRegente] = useState(\'Prof. Docente da Disciplina\');\\n  const [docenteAee, setDocenteAee] = useState(\'Prof\302\252. Especialista NAPNE / AEE\');\\n\\n  // Loading state with dynamic progress\\n  const [isGenerating, setIsGenerating] = useState(false);\\n  const [stepMessage, setStepMessage] = useState(\'\');\\n\\n  if (!isOpen) return null;\\n\\n  const handleToggleNivel = (nivel: \'medio\' | \'superior\') => {\\n    setNivelEducacional(nivel);\\n    if (nivel === \'superior\') {\\n      setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\');\\n      setModulo(\'4\302\272 Semestre / Noturno\');\\n      setDisciplina(\'Banco de Dados Relacional e SQL\');\\n      setIdade(\'21 anos\');\\n    } else {\\n      setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\\n      setModulo(\'2\302\272 Ano / Diurno\');\\n      setDisciplina(\'Programa\303\247\303\243o Web e Algoritmos\');\\n      setIdade(\'17 anos\');\\n    }\\n  };\\n\\n  const handleSelectPredefinedSolution = (id: string) => {\\n    setSolucaoId(id);\\n    const sol = bancoDeSolucoesPedagogicas.find((s) => s.id === id);\\n    if (sol) {\\n      setCondicao(`${sol.condicao}: ${sol.descricaoProblema}`);\\n      setAssistiveTech(sol.remediosSugeridos.recursosTA.join(\', \'));\\n      setPotentialidades(\\n        \'Racioc\303\255nio l\303\263gico, boa capacidade de abstra\303\247\303\243o e dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o.\'\\n      );\\n\\n      if (sol.nivelSugerido === \'Superior TI\') {\\n        handleToggleNivel(\'superior\');\\n      } else if (sol.nivelSugerido === \'M\303\251dio T\303\251cnico\') {\\n        handleToggleNivel(\'medio\');\\n      }\\n    }\\n  };\\n\\n  const handleSubmit = async (e: React.FormEvent) => {\\n    e.preventDefault();\\n    if (!nome.trim() || !disciplina.trim()) return;\\n\\n    setIsGenerating(true);\\n    setStepMessage(\'1/3: Ioda AI consultando diretrizes PNEEI e DUA 3.0 para TI...\');\\n\\n    try {\\n      let finalPei: PEICompleto | null = null;\\n\\n      // Call Gemini API on backend with timeout\\n      try {\\n        const timeoutPromise = new Promise((_, reject) =>\\n          setTimeout(() => reject(new Error(\'Timeout\')), 7000)\\n        );\\n\\n        const fetchPromise = fetch(\'/api/gemini/generate-pei\', {\\n          method: \'POST\',\\n          headers: {\\n            \'Content-Type\': \'application/json\',\\n            Accept: \'application/json\',\\n          },\\n          body: JSON.stringify({\\n            studentName: nome.trim(),\\n            grade: modulo.trim(),\\n            course: curso.trim(),\\n            subject: disciplina.trim(),\\n            barriers: condicao.trim(),\\n            potentialities: potencialidades.trim(),\\n            assistiveTech: assistiveTech.trim(),\\n            docenteRegente: docenteRegente.trim(),\\n            docenteAee: docenteAee.trim(),\\n            age: idade.trim(),\\n          }),\\n        });\\n\\n        setStepMessage(\'2/3: Mapeando Tecnologias Assistivas e acomoda\303\247\303\265es de laborat\303\263rio...\');\\n\\n        const response: any = await Promise.race([fetchPromise, timeoutPromise]);\\n        const contentType = response.headers?.get(\'content-type\') || \'\';\\n\\n        if (contentType.includes(\'application/json\')) {\\n          const resData = await response.json();\\n          if (resData.success && resData.data) {\\n            const gen = resData.data;\\n\\n            setStepMessage(\'3/3: Estruturando Metas SMART e flexibiliza\303\247\303\265es curriculares...\');\\n\\n            finalPei = {\\n              id: `PEI-${Date.now().toString().slice(-4)}`,\\n              cabecalho: {\\n                estudante: gen.cabecalho?.estudante || nome.trim(),\\n                codigo_matricula: gen.cabecalho?.codigo_matricula || matricula.trim() || `TI-${Math.floor(1000 + Math.random() * 9000)}`,\\n                idade: idade.trim(),\\n                curso: gen.cabecalho?.curso || curso.trim(),\\n                componente_curricular: gen.cabecalho?.componente_curricular || disciplina.trim(),\\n                modulo_periodo: gen.cabecalho?.modulo_periodo || modulo.trim(),\\n                data_elaboracao: new Date().toISOString().split(\'T\')[0],\\n                docente_regente: docenteRegente.trim(),\\n                docente_aee: docenteAee.trim(),\\n                profissional_apoio: \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\\n                coordenacao_napne: \'Coordena\303\247\303\243o NAPNE / Diretoria de Acessibilidade\',\\n              },\\n              historico_napne: {\\n                breve_historico_clinico_familiar:\\n                  gen.historico_e_condicao_napne?.breve_historico_clinico_familiar ||\\n                  `Estudante matriculado no ${curso.trim()}. Acompanhamento pedag\303\263gico individualizado nos termos do Decreto n\302\272 12.686/2025.`,\\n                descricao_condicao_especifica:\\n                  gen.historico_e_condicao_napne?.descricao_condicao_especifica || condicao.trim(),\\n                informacoes_dos_pais:\\n                  gen.historico_e_condicao_napne?.informacoes_dos_pais ||\\n                  \'Estudante e respons\303\241veis em contato constante com o NAPNE e coordena\303\247\303\243o do curso.\',\\n              },\\n              estudo_de_caso: {\\n                barreiras: (gen.estudo_de_caso_sintese?.barreiras_identificadas || []).map(\\n                  (bText: string, i: number) => ({\\n                    id: `B${i + 1}`,\\n                    categoria: \'metodologica\',\\n                    descricao: bText,\\n                    impacto: \'Dificuldade de participa\303\247\303\243o equ\303\242nime na aus\303\252ncia de recursos adaptados.\',\\n                    estrategia_enfrentamento: \'Elimina\303\247\303\243o da barreira atrav\303\251s do DUA 3.0 e Tecnologias Assistivas.\',\\n                  })\\n                ),\\n                potencialidades: (gen.estudo_de_caso_sintese?.potencialidades_interesses || []).map(\\n                  (pText: string, i: number) => ({\\n                    id: `P${i + 1}`,\\n                    area: \'\303\201rea T\303\251cnica e L\303\263gica\',\\n                    descricao: pText,\\n                    apoio_demandado: \'Mobiliza\303\247\303\243o pedag\303\263gica nas aulas te\303\263ricas e pr\303\241ticas de laborat\303\263rio.\',\\n                  })\\n                ),\\n                recursos_ta: gen.estudo_de_caso_sintese?.recursos_tecnologia_assistiva || [\\n                  assistiveTech.trim() || \'Recursos de Tecnologia Assistiva e tempo ampliado\',\\n                ],\\n                sintese_observacao: {\\n                  interacao_professores: \'Participativo e reflexivo nas discuss\303\265es conceituais.\',\\n                  interacao_colegas: \'Excelente integra\303\247\303\243o em metodologias ativas e pareamento.\',\\n                  tarefas_coletivas: \'Contribui de forma ativa na arquitetura e documenta\303\247\303\243o de projetos.\',\\n                  interesses_centrais: disciplina.trim(),\\n                  habilidades_tecnicas: \'Pensamento computacional e capacidade l\303\263gica.\',\\n                  autonomia_rotina: \'Autonomia com suporte das acomoda\303\247\303\265es recomendadas.\',\\n                },\\n              },\\n              planejamento_pei: {\\n                conteudo_ementa_oficial:\\n                  gen.planejamento_pedagogico_pei?.conteudo_ementa_oficial ||\\n                  `Ementa Oficial: ${disciplina.trim()}. Fundamentos te\303\263ricos e pr\303\241ticas de laborat\303\263rio.`,\\n                competencias_habilidades_ementa:\\n                  gen.planejamento_pedagogico_pei?.competencias_habilidades_ementa ||\\n                  `Desenvolver compet\303\252ncias de an\303\241lise, modelagem e codifica\303\247\303\243o em ${disciplina.trim()}.`,\\n                adaptacao_flexibilizacao_curricular:\\n                  gen.planejamento_pedagogico_pei?.adaptacao_flexibilizacao_curricular ||\\n                  \'Curr\303\255culo integral sem redu\303\247\303\265es de conte\303\272do. Acessibilidade metodol\303\263gica garantida pelo DUA 3.0.\',\\n                objetivos_e_metas: (gen.planejamento_pedagogico_pei?.objetivos_e_metas_adaptadas || []).map(\\n                  (m: any) => ({\\n                    id_meta: m.id_meta || \'M1\',\\n                    descricao_meta: m.descricao_meta,\\n                    prazo: m.prazo || \'Mensal (4 semanas)\',\\n                    indicador_sucesso: m.indicador_sucesso,\\n                    progresso_percentual: 50,\\n                    status: \'em_andamento\',\\n                  })\\n                ),\\n                flexibilizacao_metodologica_dua: {\\n                  engajamento: gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.engajamento || [\\n                    \'Projetos pr\303\241ticos aplicados e metodologia \303\241gil adaptada.\',\\n                  ],\\n                  representacao: gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.representacao || [\\n                    \'Disponibiliza\303\247\303\243o antecipada de roteiros em Markdown e tutoriais.\',\\n                  ],\\n                  acao_e_expressao: gen.planejamento_pedagogico_pei?.flexibilizacao_metodologica_dua?.acao_e_expressao || [\\n                    \'Tempo estendido (+50%) e entrega cont\303\255nua em reposit\303\263rio Git.\',\\n                  ],\\n                },\\n                gestao_sala_de_aula: {\\n                  organizacao_espacial:\\n                    \'Bancada de laborat\303\263rio acess\303\255vel com layout ergon\303\264mico e espa\303\247o amplo para circula\303\247\303\243o.\',\\n                  rotina_e_pausas:\\n                    \'Pausas programadas a cada 45-60 minutos para preven\303\247\303\243o de fadiga f\303\255sica e sensorial.\',\\n                  agrupamentos_e_tutoria:\\n                    \'Trabalho em duplas colaborativas (Pair Programming) e tutoria orientada.\',\\n                  suporte_docente_semanal:\\n                    \'Sess\303\243o semanal de alinhamento pedag\303\263gico entre o docente de TI e o NAPNE.\',\\n                },\\n                estrategias_avaliacao: {\\n                  formato_acessivel:\\n                    gen.planejamento_pedagogico_pei?.estrategias_de_avaliacao?.formato_acessivel ||\\n                    \'Avalia\303\247\303\243o processual formativa com projetos em etapas e tempo estendido.\',\\n                  criterio_de_sucesso:\\n                    gen.planejamento_pedagogico_pei?.estrategias_de_avaliacao?.criterio_de_sucesso ||\\n                    \'Compreens\303\243o substantiva da l\303\263gica e dos conceitos t\303\251cnicos exigidos.\',\\n                  grau_mediacao: \'pouca_mediacao\',\\n                  tempo_e_espaco: \'Tempo estendido (+50%) em laborat\303\263rio com recursos de TA.\',\\n                  recursos_utilizados:\\n                    gen.estudo_de_caso_sintese?.recursos_tecnologia_assistiva || [\\n                      \'Perfil de acessibilidade na IDE\',\\n                      \'Tempo estendido\',\\n                    ],\\n                },\\n                observacoes_docente: `PEI gerado pelo agente Ioda para ${nome.trim()} com fundamenta\303\247\303\243o nas diretrizes da Portaria MEC n\302\272 421/2026.`,\\n              },\\n              painel_notas: [\\n                {\\n                  id: `N_auto_${Date.now()}`,\\n                  autor: docenteRegente.trim(),\\n                  papel: \'Regente\',\\n                  categoria: \'objetivos\',\\n                  conteudo: `In\303\255cio do acompanhamento pedag\303\263gico inclusivo com Ioda AI para ${disciplina.trim()}.`,\\n                  data: new Date().toLocaleDateString(\'pt-BR\'),\\n                  cor: \'green\',\\n                },\\n              ],\\n              metricas: {\\n                percentual_metas_alcancadas: 45,\\n                nivel_autonomia: 4,\\n                engajamento: 5,\\n                sessoes_semanais_realizadas: 4,\\n                status_geral: \'EM_ANDAMENTO\',\\n              },\\n              parecer_pedagogico: `PEI estruturado pelo agente Ioda em conson\303\242ncia com a Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.`,\\n              sugestoes_proximo_ciclo: [\\n                \'Manter as sess\303\265es semanais de suporte pedag\303\263gico com o NAPNE.\',\\n                \'Avan\303\247ar para projeto pr\303\241tico integrador no per\303\255odo seguinte.\',\\n              ],\\n            };\\n          }\\n        }\\n      } catch (err) {\\n        console.warn(\'API fetch did not return within threshold, generating via Ioda Pedagogical Engine:\', err);\\n      }\\n\\n      // If remote call failed or timed out, synthesize with zero latency via local Ioda engine\\n      if (!finalPei) {\\n        finalPei = gerarNovoPeiCompleto({\\n          nome: nome.trim(),\\n          matricula: matricula.trim(),\\n          idade: idade.trim(),\\n          curso: curso.trim(),\\n          disciplina: disciplina.trim(),\\n          modulo: modulo.trim(),\\n          condicao: condicao.trim() || \'Barreiras observadas no laborat\303\263rio de inform\303\241tica.\',\\n          docenteRegente: docenteRegente.trim(),\\n          docenteAee: docenteAee.trim(),\\n          solucaoBaseId: solucaoId,\\n        });\\n      }\\n\\n      onAddStudent(finalPei);\\n      onClose();\\n    } finally {\\n      setIsGenerating(false);\\n    }\\n  };\\n\\n  return (\\n    <div className=\\\"fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs overflow-y-auto\\\">\\n      <div className=\\\"bg-white rounded-2xl max-w-2xl w-full p-6 sm:p-8 shadow-2xl border border-slate-200 my-8\\\">\\n        {/* Header */}\\n        <div className=\\\"flex items-center justify-between pb-4 border-b border-slate-100 mb-5\\\">\\n          <div className=\\\"flex items-center gap-2\\\">\\n            <div className=\\\"w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center text-emerald-800\\\">\\n              <UserPlus className=\\\"w-4 h-4\\\" />\\n            </div>\\n            <div>\\n              <h3 className=\\\"text-base sm:text-lg font-bold text-slate-900\\\">\\n                Cadastrar Estudante & Gerar PEI com Ioda (Gemini API)\\n              </h3>\\n              <span className=\\\"text-xs text-slate-500\\\">\\n                Gera\303\247\303\243o autom\303\241tica com sugest\303\265es de TA, flexibiliza\303\247\303\243o DUA 3.0 e metas SMART para TI\\n              </span>\\n            </div>\\n          </div>\\n          <button\\n            onClick={onClose}\\n            disabled={isGenerating}\\n            className=\\\"p-1 text-slate-400 hover:text-slate-600 rounded-lg cursor-pointer disabled:opacity-50\\\"\\n          >\\n            <X className=\\\"w-5 h-5\\\" />\\n          </button>\\n        </div>\\n\\n        {/* Level Switcher (Ensino M\303\251dio T\303\251cnico vs Ensino Superior TI) */}\\n        <div className=\\\"mb-5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\\\">\\n          <label className=\\\"text-xs font-bold text-slate-700 uppercase tracking-wider block\\\">\\n            1. Selecione o N\303\255vel de Ensino:\\n          </label>\\n          <div className=\\\"grid grid-cols-2 gap-2\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleToggleNivel(\'medio\')}\\n              className={`p-2.5 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer ${\\n                nivelEducacional === \'medio\'\\n                  ? \'bg-emerald-800 text-white border-emerald-900 shadow-xs\'\\n                  : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-100\'\\n              }`}\\n            >\\n              Ensino M\303\251dio T\303\251cnico (Inform\303\241tica / Redes)\\n            </button>\\n\\n            <button\\n              type=\\\"button\\\"\\n              onClick={() => handleToggleNivel(\'superior\')}\\n              className={`p-2.5 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer ${\\n                nivelEducacional === \'superior\'\\n                  ? \'bg-emerald-800 text-white border-emerald-900 shadow-xs\'\\n                  : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-100\'\\n              }`}\\n            >\\n              Ensino Superior em TI (Sistemas / Computa\303\247\303\243o)\\n            </button>\\n          </div>\\n        </div>\\n\\n        {/* Quick condition presets */}\\n        <div className=\\\"mb-5 p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\\\">\\n          <div className=\\\"flex items-center justify-between\\\">\\n            <label className=\\\"text-xs font-bold text-slate-700 uppercase tracking-wider block\\\">\\n              2. Preencher Automaticamente por Condi\303\247\303\243o / Barreira de TI:\\n            </label>\\n            <span className=\\\"text-[10px] text-slate-500 font-mono\\\">DUA 3.0 & TA</span>\\n          </div>\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-2\\\">\\n            {bancoDeSolucoesPedagogicas.map((sol) => (\\n              <button\\n                key={sol.id}\\n                type=\\\"button\\\"\\n                onClick={() => handleSelectPredefinedSolution(sol.id)}\\n                className={`p-2.5 text-left text-xs rounded-lg border transition-all cursor-pointer ${\\n                  solucaoId === sol.id\\n                    ? \'bg-emerald-50 border-emerald-500 text-emerald-950 font-semibold shadow-xs\'\\n                    : \'bg-white border-slate-300 text-slate-700 hover:border-slate-400\'\\n                }`}\\n              >\\n                <div className=\\\"flex items-center justify-between\\\">\\n                  <span className=\\\"font-bold text-slate-900\\\">{sol.titulo.split(\'/\')[0]}</span>\\n                  <span className=\\\"text-[10px] text-slate-500 font-mono\\\">\\n                    {sol.nivelSugerido}\\n                  </span>\\n                </div>\\n                <p className=\\\"text-[11px] text-slate-500 mt-0.5 line-clamp-1\\\">\\n                  {sol.condicao}\\n                </p>\\n              </button>\\n            ))}\\n          </div>\\n        </div>\\n\\n        <form onSubmit={handleSubmit} className=\\\"space-y-4 text-xs\\\">\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-3 gap-3\\\">\\n            <div className=\\\"sm:col-span-2\\\">\\n              <label className=\\\"block font-bold text-slate-700 uppercase tracking-wider mb-1\\\">\\n                Nome Completo do Estudante\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={nome}\\n                onChange={(e) => setNome(e.target.value)}\\n                placeholder=\\\"Ex: Gabriel Moreira Silva\\\"\\n                className=\\\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\\\"\\n                required\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block font-bold text-slate-700 uppercase tracking-wider mb-1\\\">\\n                Matr\303\255cula\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={matricula}\\n                onChange={(e) => setMatricula(e.target.value)}\\n                placeholder=\\\"Ex: 2026.1.TI.088\\\"\\n                className=\\\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n            <div>\\n              <label className=\\\"block font-bold text-slate-700 uppercase tracking-wider mb-1\\\">\\n                Curso\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={curso}\\n                onChange={(e) => setCurso(e.target.value)}\\n                className=\\\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\\\"\\n                required\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block font-bold text-slate-700 uppercase tracking-wider mb-1\\\">\\n                M\303\263dulo / Per\303\255odo / Ano\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={modulo}\\n                onChange={(e) => setModulo(e.target.value)}\\n                className=\\\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\\\"\\n                required\\n              />\\n            </div>\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block font-bold text-slate-700 uppercase tracking-wider mb-1\\\">\\n              Componente Curricular / Disciplina de TI\\n            </label>\\n            <input\\n              type=\\\"text\\\"\\n              value={disciplina}\\n              onChange={(e) => setDisciplina(e.target.value)}\\n              placeholder=\\\"Ex: Programa\303\247\303\243o Web, Banco de Dados SQL, Redes de Computadores\\\"\\n              className=\\\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\\\"\\n              required\\n            />\\n          </div>\\n\\n          <div>\\n            <label className=\\\"block font-bold text-slate-700 uppercase tracking-wider mb-1\\\">\\n              Barreiras Observadas no Contexto de Sala de Aula & Laborat\303\263rio\\n            </label>\\n            <textarea\\n              value={condicao}\\n              onChange={(e) => setCondicao(e.target.value)}\\n              rows={2}\\n              placeholder=\\\"Ex: Limita\303\247\303\243o motora para digita\303\247\303\243o r\303\241pida, baixa vis\303\243o em diagramas, hipersensibilidade a ru\303\255dos...\\\"\\n              className=\\\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\\\"\\n              required\\n            />\\n          </div>\\n\\n          <div className=\\\"grid grid-cols-1 sm:grid-cols-2 gap-3\\\">\\n            <div>\\n              <label className=\\\"block font-bold text-slate-700 uppercase tracking-wider mb-1\\\">\\n                Potencialidades & Interesses em TI\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={potencialidades}\\n                onChange={(e) => setPotentialidades(e.target.value)}\\n                placeholder=\\\"Ex: Racioc\303\255nio l\303\263gico, interesse por banco de dados e APIs...\\\"\\n                className=\\\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\\\"\\n              />\\n            </div>\\n\\n            <div>\\n              <label className=\\\"block font-bold text-slate-700 uppercase tracking-wider mb-1\\\">\\n                Tecnologias Assistivas Pr\303\251-identificadas\\n              </label>\\n              <input\\n                type=\\\"text\\\"\\n                value={assistiveTech}\\n                onChange={(e) => setAssistiveTech(e.target.value)}\\n                placeholder=\\\"Ex: Leitor NVDA, teclado de toque leve, abafador concha...\\\"\\n                className=\\\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none\\\"\\n              />\\n            </div>\\n          </div>\\n\\n          {/* Real-time generation feedback block */}\\n          {isGenerating && (\\n            <div className=\\\"p-3 bg-emerald-50 border border-emerald-300 rounded-xl flex items-center gap-3 text-xs text-emerald-950 animate-pulse\\\">\\n              <Loader2 className=\\\"w-5 h-5 animate-spin text-emerald-700 shrink-0\\\" />\\n              <div>\\n                <strong className=\\\"block font-bold\\\">Ioda AI em execu\303\247\303\243o:</strong>\\n                <span>{stepMessage}</span>\\n              </div>\\n            </div>\\n          )}\\n\\n          <div className=\\\"flex items-center justify-end gap-3 pt-4 border-t border-slate-100\\\">\\n            <button\\n              type=\\\"button\\\"\\n              onClick={onClose}\\n              disabled={isGenerating}\\n              className=\\\"px-4 py-2 text-xs text-slate-600 hover:text-slate-800 cursor-pointer disabled:opacity-50\\\"\\n            >\\n              Cancelar\\n            </button>\\n            <button\\n              type=\\\"submit\\\"\\n              disabled={isGenerating}\\n              className=\\\"inline-flex items-center gap-2 px-5 py-2.5 text-xs font-semibold text-white bg-emerald-700 hover:bg-emerald-800 rounded-lg transition-colors cursor-pointer shadow-xs disabled:opacity-50\\\"\\n            >\\n              {isGenerating ? (\\n                <>\\n                  <Loader2 className=\\\"w-4 h-4 animate-spin\\\" />\\n                  Gerando PEI com Ioda...\\n                </>\\n              ) : (\\n                <>\\n                  <Sparkles className=\\\"w-4 h-4 text-emerald-200\\\" />\\n                  Gerar PEI Completo com Ioda\\n                </>\\n              )}\\n            </button>\\n          </div>\\n        </form>\\n      </div>\\n    </div>\\n  );\\n};\\n\", \"Description\":\"Update AddStudentModal with Gemini API and Ioda AI integration for automatic PEI generation with TA suggestions, DUA 3.0 and vocational/higher-ed goals\", \"Overwrite\":true, \"TargetFile\":\"/src/components/AddStudentModal.tsx\", \"toolAction\":\"Updating AddStudentModal\", \"toolSummary\":\"Update AddStudentModal with Gemini API Ioda integration\"}"
