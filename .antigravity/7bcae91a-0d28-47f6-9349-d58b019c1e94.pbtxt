            }
            lines {
              text: "      passo_a_passo_explicacao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Disponibilize roteiros autoexplicativos e c\303\263digos comentados no Moodle para que o estudante n\303\243o perca o fio condutor caso tenha tido dificuldade de concentra\303\247\303\243o na explica\303\247\303\243o oral.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
