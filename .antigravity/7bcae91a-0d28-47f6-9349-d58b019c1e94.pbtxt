    end_line: 1495
    content: "                  </span>\n                </div>\n\n                {/* Quick Presets from PPC do BSI and Plano de Ensino in attachment */}\n                <div className=\"p-2.5 bg-white border border-slate-200 rounded-lg space-y-1.5\">\n                  <span className=\"text-[11px] font-bold text-slate-700 block\">\n                    Sugest\303\265es R\303\241pidas de Disciplinas do Campus Para\303\255so (PPC / Anexo):\n                  </span>\n                  <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-1.5\">\n                    {presetsPpcEPlano.map((p) => {\n                      const isCurrent = disciplina === p.titulo;\n                      return (\n                        <button\n                          key={p.id}\n                          type=\"button\"\n                          onClick={() => handleApplyCoursePreset(p)}\n                          className={`p-2 rounded-lg border text-left transition-all cursor-pointer ${\n                            isCurrent\n                              ? \'bg-emerald-50 border-emerald-600 shadow-xs ring-1 ring-emerald-600\'\n                              : \'bg-slate-50/70 border-slate-200 hover:border-slate-300 hover:bg-white\'\n                          }`}\n                        >\n                          <div className=\"flex items-center justify-between\">\n                            <span className=\"text-xs font-bold text-slate-900 truncate\">{p.titulo}</span>\n                            <span className=\"text-[9px] px-1.5 py-0.2 rounded font-mono font-medium bg-emerald-100 text-emerald-900 shrink-0 ml-1\">\n                              {p.tag}\n                            </span>\n                          </div>\n                          <span className=\"text-[10px] text-slate-500 block truncate mt-0.5\">\n                            {p.docente} \302\267 {p.modulo}\n                          </span>\n                        </button>\n                      );\n                    })}\n                  </div>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-3 gap-3\">\n                  <div className=\"sm:col-span-2\">\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      Curso de TI <span className=\"text-red-500\">*</span>\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={curso}\n                      onChange={(e) => setCurso(e.target.value)}\n                      className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                      required\n                    />\n                  </div>\n\n                  <div>\n                    <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                      M\303\263dulo / Per\303\255odo / Ano\n                    </label>\n                    <input\n                      type=\"text\"\n                      value={modulo}\n                      onChange={(e) => setModulo(e.target.value)}\n                      className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                      required\n                    />\n                  </div>\n                </div>\n\n                <div>\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Disciplina / Componente Curricular de Computa\303\247\303\243o <span className=\"text-red-500\">*</span>\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={disciplina}\n                    onChange={(e) => setDisciplina(e.target.value)}\n                    placeholder=\"Ex: BAC.0406 - Engenharia de Software II\"\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs font-medium\"\n                    required\n                  />\n                </div>\n              </div>\n\n              {/* Card C: Doc\303\252ncia e AEE */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Docente Regente da Disciplina\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={docenteRegente}\n                    onChange={(e) => setDocenteRegente(e.target.value)}\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                  />\n                </div>\n\n                <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                  <label className=\"block text-xs font-semibold text-slate-700 mb-1\">\n                    Coordena\303\247\303\243o NAPNE (Campus Para\303\255so)\n                  </label>\n                  <input\n                    type=\"text\"\n                    value={docenteAee}\n                    disabled\n                    className=\"w-full p-2.5 border border-slate-200 bg-slate-100 text-slate-600 rounded-lg text-xs\"\n                  />\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* ============================================================== */}\n          {/* ETAPA 3: ESTUDO DE CASO, BARREIRAS & DUA 3.0                   */}\n          {/* ============================================================== */}\n          {currentStep === 3 && (\n            <div className=\"space-y-4 animate-fadeIn\">\n              {/* Contexto do Curso e da Disciplina */}\n              <div className=\"p-3 bg-emerald-50/70 border border-emerald-200 rounded-xl flex items-center justify-between text-xs\">\n                <div className=\"flex items-center gap-2\">\n                  <Laptop className=\"w-4 h-4 text-emerald-800 shrink-0\" />\n                  <div>\n                    <span className=\"text-slate-600\">Planejamento para: </span>\n                    <strong className=\"text-emerald-950\">{disciplina}</strong>\n                    <span className=\"text-slate-500 text-[11px] block\">{curso} ({modulo})</span>\n                  </div>\n                </div>\n                <span className=\"text-[10px] font-mono bg-white px-2 py-0.5 rounded border border-emerald-200 text-emerald-900 font-semibold\">\n                  {perfilModalidade === \'superior_ti\' ? \'Superior BSI\' : \'M\303\251dio T\303\251cnico\'}\n                </span>\n              </div>\n\n              {/* Situa\303\247\303\243o Diagn\303\263stica (Portaria MEC n\302\272 421/2026) */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2\">\n                <label className=\"text-xs font-bold text-slate-800 uppercase tracking-wider block\">\n                  Situa\303\247\303\243o Diagn\303\263stica (Portaria MEC n\302\272 421/2026):\n                </label>\n                <div className=\"grid grid-cols-2 gap-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setStatusDiagnostico(\'confirmado\')}\n                    className={`p-2.5 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer flex items-center justify-center gap-1.5 ${\n                      statusDiagnostico === \'confirmado\'\n                        ? \'bg-blue-800 text-white border-blue-900 shadow-xs\'\n                        : \'bg-white text-slate-700 border-slate-300 hover:bg-slate-100\'\n                    }`}\n                  >\n                    <FileCheck2 className=\"w-3.5 h-3.5\" />\n                    <span>Diagn\303\263stico Confirmado (24 no campus)</span>\n                  </button>\n\n                  <button\n                    type=\"button\"\n                    onClick={() => setStatusDiagnostico(\'em_investigacao_hipotese\')}\n                    className={`p-2.5 rounded-lg border text-xs font-semibold text-center transition-all cursor-pointer flex items-center justify-center gap-1.5 ${\n                      statusDiagnostico === \'em_investigacao_hipotese\'\n                        ? \'bg-amber-600 text-white border-amber-700 shadow-xs\'\n                        : \'bg-white text-amber-900 border-amber-300 hover:bg-amber-50\'\n                    }`}\n                  >\n                    <HelpCircle className=\"w-3.5 h-3.5\" />\n                    <span>Sem Laudo / Em Investiga\303\247\303\243o (5 no campus)</span>\n                  </button>\n                </div>\n\n                {statusDiagnostico === \'em_investigacao_hipotese\' && (\n                  <div className=\"p-2.5 bg-amber-50 border border-amber-200 rounded-lg text-xs text-amber-900 leading-relaxed flex items-start gap-2 mt-2\">\n                    <ShieldCheck className=\"w-4 h-4 text-amber-700 shrink-0 mt-0.5\" />\n                    <span>\n                      <strong>Garantia Legal Portaria MEC n\302\272 421/2026:</strong> O direito ao PEI e \303\240 Tecnologia Assistiva independe de laudo m\303\251dico pr\303\251vio. A atua\303\247\303\243o docente apoia-se na elimina\303\247\303\243o das barreiras pedag\303\263gicas observadas no laborat\303\263rio de TI.\n                    </span>\n                  </div>\n                )}\n              </div>\n\n              {/* LISTAGEM DAS 9 NEURODIVERG\303\212NCIAS (M\303\232LTIPLA SELE\303\207\303\203O) */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\">\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                  <div>\n                    <label className=\"text-xs font-bold text-slate-800 uppercase tracking-wider block\">\n                      Neurodiverg\303\252ncias no Contexto de TI & Laborat\303\263rio (M\303\272ltipla Sele\303\247\303\243o):\n                    </label>\n                    <span className=\"text-[11px] text-slate-600\">\n                      Voc\303\252 pode selecionar <strong>uma ou mais neurodiverg\303\252ncias</strong> (ex: TEA + TDAH). O PEI ser\303\241 adaptado para todas em conjunto:\n                    </span>\n                  </div>\n                  <span className=\"text-[10px] bg-emerald-700 text-white font-bold px-2.5 py-1 rounded-full font-mono self-start sm:self-auto shrink-0\">\n                    {selectedSolucoes.length} selecionada(s)\n                  </span>\n                </div>\n\n                {/* Quick Comorbidity Shortcuts */}\n                <div className=\"flex flex-wrap items-center gap-1.5 pt-0.5\">\n                  <span className=\"text-[10px] font-bold text-slate-500 uppercase mr-1\">\n                    Combina\303\247\303\265es Frequentes:\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() => syncSelectedConditions([\'sol-tea\', \'sol-tdah\'])}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\n                      selectedSolucoes.includes(\'sol-tea\') &&\n                      selectedSolucoes.includes(\'sol-tdah\') &&\n                      selectedSolucoes.length === 2\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\n                    }`}\n                  >\n                    + TEA + TDAH (Dupla Condi\303\247\303\243o)\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => syncSelectedConditions([\'sol-tdah\', \'sol-ansiedade\'])}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\n                      selectedSolucoes.includes(\'sol-tdah\') &&\n                      selectedSolucoes.includes(\'sol-ansiedade\') &&\n                      selectedSolucoes.length === 2\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\n                    }`}\n                  >\n                    + TDAH + Ansiedade\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => syncSelectedConditions([\'sol-tea\', \'sol-ansiedade\'])}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\n                      selectedSolucoes.includes(\'sol-tea\') &&\n                      selectedSolucoes.includes(\'sol-ansiedade\') &&\n                      selectedSolucoes.length === 2\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\n                    }`}\n                  >\n                    + TEA + Ansiedade\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => syncSelectedConditions([\'sol-tdah\', \'sol-aprendizagem\'])}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\n                      selectedSolucoes.includes(\'sol-tdah\') &&\n                      selectedSolucoes.includes(\'sol-aprendizagem\') &&\n                      selectedSolucoes.length === 2\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\n                    }`}\n                  >\n                    + TDAH + Dislexia/Discalculia\n                  </button>\n                </div>\n\n                {/* Active Selection Pills */}\n                {selectedSolucoes.length > 0 && (\n                  <div className=\"p-2 bg-emerald-50/90 border border-emerald-200 rounded-lg flex flex-wrap items-center gap-1.5\">\n                    <span className=\"text-[10px] font-bold text-emerald-950 uppercase mr-1\">\n                      Ativas no PEI:\n                    </span>\n                    {selectedSolucoes.map((sid) => {\n                      const sObj = bancoDeSolucoesPedagogicas.find((item) => item.id === sid);\n                      if (!sObj) return null;\n                      return (\n                        <span\n                          key={sid}\n                          className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-700 text-white shadow-2xs\"\n                        >\n                          <span>{sObj.titulo}</span>\n                          {selectedSolucoes.length > 1 && (\n                            <button\n                              type=\"button\"\n                              onClick={(e) => {\n                                e.stopPropagation();\n                                handleTogglePredefinedSolution(sid);\n                              }}\n                              className=\"hover:text-emerald-200 ml-0.5 cursor-pointer\"\n                              title=\"Remover esta condi\303\247\303\243o\"\n                            >\n                              <X className=\"w-3 h-3\" />\n                            </button>\n                          )}\n                        </span>\n                      );\n                    })}\n                  </div>\n                )}\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-60 overflow-y-auto pr-1\">\n                  {[\n                    {\n                      id: \'sol-tdah\',\n                      titulo: \'Transtorno do D\303\251ficit de Aten\303\247\303\243o com Hiperatividade (TDAH)\',\n                      sigla: \'TDAH\',\n                      icone: Brain,\n                      resumo: \'Micro-sprints \303\241geis (Jira/Kanban), Pomodoro, linters no VS Code e TDD em etapas.\',\n                    },\n                    {\n                      id: \'sol-tea\',\n                      titulo: \'Transtorno do Espectro Autista (TEA)\',\n                      sigla: \'TEA\',\n                      icone: Sparkles,\n                      resumo: \'Previsibilidade, roteiros de testes estruturados, abafador no LABIN e enunciados literais.\',\n                    },\n                    {\n                      id: \'sol-ansiedade\',\n                      titulo: \'Transtornos de ansiedade (generalizada, f\303\263bico-ansiosos, p\303\242nico, outros)\',\n                      sigla: \'Ansiedade\',\n                      icone: HeartPulse,\n                      resumo: \'Apresenta\303\247\303\243o em v\303\255deo (Loom) ou reservada, rubricas antecipadas, pausas e tempo estendido (+50%).\',\n                    },\n                    {\n                      id: \'sol-aprendizagem\',\n                      titulo: \'Transtorno espec\303\255fico de aprendizagem (dislexia, disgrafia, discalculia)\',\n                      sigla: \'Dislexia / Disgrafia\',\n                      icone: BookOpen,\n                      resumo: \'Fontes OpenDyslexic, linters visuais de erro e foco na l\303\263gica sem puni\303\247\303\243o sint\303\241tica.\',\n                    },\n                    {\n                      id: \'sol-def-intelectual\',\n                      titulo: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',\n                      sigla: \'Def. Intelectual\',\n                      icone: Users,\n                      resumo: \'Instru\303\247\303\265es fracionadas em 2-3 passos, media\303\247\303\243o assistida de monitor e avalia\303\247\303\243o concreta.\',\n                    },\n                    {\n                      id: \'sol-toc\',\n                      titulo: \'Transtorno obsessivo-compulsivo (TOC)\',\n                      sigla: \'TOC\',\n                      icone: CheckSquare,\n                      resumo: \'Crit\303\251rios expl\303\255citos de aceite (Definition of Done), pipelines CI/CD e limites saud\303\241veis de refatora\303\247\303\243o.\',\n                    },\n                    {\n                      id: \'sol-misto-ansioso-depressivo\',\n                      titulo: \'Transtorno misto ansioso e depressivo\',\n                      sigla: \'Misto Ansioso/Depressivo\',\n                      icone: Activity,\n                      resumo: \'Metas graduais de recomposi\303\247\303\243o de autoefic\303\241cia, entregas semanais fracionadas e apoio cont\303\255nuo.\',\n                    },\n                    {\n                      id: \'sol-depressao\',\n                      titulo: \'Transtornos depressivos\',\n                      sigla: \'Depress\303\243o\',\n                      icone: Moon,\n                      resumo: \'Regime de Atividades Acompanhadas (ODP-IFTO), acesso ass\303\255ncrono ao Moodle e duplas acolhedoras.\',\n                    },\n                    {\n                      id: \'sol-epilepsia\',\n                      titulo: \'Epilepsia e crises convulsivas\',\n                      sigla: \'Epilepsia\',\n                      icone: ShieldAlert,\n                      resumo: \'Monitores com taxa est\303\241vel (60Hz+), tema de IDE sem flashes, pausas a cada 45min e protocolo de seguran\303\247a.\',\n                    },\n                  ].map((item) => {\n                    const isSelected = selectedSolucoes.includes(item.id);\n                    const IconComponent = item.icone;\n                    return (\n                      <button\n                        key={item.id}\n                        type=\"button\"\n                        onClick={() => handleTogglePredefinedSolution(item.id)}\n                        className={`p-2.5 text-left text-xs rounded-xl border transition-all cursor-pointer relative ${\n                          isSelected\n                            ? \'bg-emerald-50 border-emerald-600 text-emerald-950 font-medium shadow-xs ring-1 ring-emerald-600\'\n                            : \'bg-white border-slate-200 text-slate-700 hover:border-slate-300 hover:bg-slate-50/50\'\n                        }`}\n                      >\n                        <div className=\"flex items-start justify-between gap-1.5 mb-1\">\n                          <div className=\"flex items-center gap-1.5 min-w-0\">\n                            <div className={`p-1 rounded-md shrink-0 ${isSelected ? \'bg-emerald-700 text-white\' : \'bg-slate-100 text-slate-600\'}`}>\n                              <IconComponent className=\"w-3.5 h-3.5\" />\n                            </div>\n                            <span className=\"font-bold text-slate-900 truncate text-[11px] leading-tight\">\n                              {item.titulo}\n                            </span>\n                          </div>\n                          <div\n                            className={`w-4 h-4 rounded flex items-center justify-center border shrink-0 mt-0.5 ${\n                              isSelected\n                                ? \'bg-emerald-700 border-emerald-700 text-white\'\n                                : \'border-slate-300 bg-white\'\n                            }`}\n                          >\n                            {isSelected && <Check className=\"w-3 h-3\" />}\n                          </div>\n                        </div>\n                        <p className=\"text-[10px] text-slate-500 leading-snug line-clamp-2 pl-6\">\n                          {item.resumo}\n                        </p>\n                      </button>\n                    );\n                  })}\n                </div>\n\n                {/* Secondary toggle for Sensory/Physical conditions */}\n                <div className=\"pt-1 border-t border-slate-200\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setMostrarOutrasCondicoes(!mostrarOutrasCondicoes)}\n                    className=\"text-[11px] font-semibold text-emerald-800 hover:text-emerald-950 flex items-center gap-1 cursor-pointer\"\n                  >\n                    <span>{mostrarOutrasCondicoes ? \'\342\210\222 Ocultar\' : \'+ Exibir\'} Outras Condi\303\247\303\265es (Defici\303\252ncia Visual, Motora, Surdez, Sem Laudo)</span>\n                  </button>\n\n                  {mostrarOutrasCondicoes && (\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-2\">\n                      {bancoDeSolucoesPedagogicas\n                        .filter(\n                          (s) =>\n                            ![\n                              \'sol-tdah\',\n                              \'sol-tea\',\n                              \'sol-ansiedade\',\n                              \'sol-aprendizagem\',\n                              \'sol-def-intelectual\',\n                              \'sol-toc\',\n                              \'sol-misto-ansioso-depressivo\',\n                              \'sol-depressao\',\n                              \'sol-epilepsia\',\n                            ].includes(s.id)\n                        )\n                        .map((sol) => {\n                          const isOtherSelected = selectedSolucoes.includes(sol.id);\n                          return (\n                            <button\n                              key={sol.id}\n                              type=\"button\"\n                              onClick={() => handleTogglePredefinedSolution(sol.id)}\n                              className={`p-2 text-left text-xs rounded-lg border transition-all cursor-pointer flex items-center justify-between gap-2 ${\n                                isOtherSelected\n                                  ? \'bg-emerald-50 border-emerald-500 text-emerald-950 font-semibold shadow-xs\'\n                                  : \'bg-white border-slate-200 text-slate-700 hover:border-slate-300\'\n                              }`}\n                            >\n                              <div className=\"min-w-0\">\n                                <span className=\"font-bold text-slate-900 truncate block text-[11px]\">{sol.titulo}</span>\n                                <span className=\"text-[10px] text-slate-500 block truncate mt-0.5\">{sol.condicao}</span>\n                              </div>\n                              <div\n                                className={`w-4 h-4 rounded flex items-center justify-center border shrink-0 ${\n                                  isOtherSelected\n                                    ? \'bg-emerald-700 border-emerald-700 text-white\'\n                                    : \'border-slate-300 bg-white\'\n                                }`}\n                              >\n                                {isOtherSelected && <Check className=\"w-3 h-3\" />}\n                              </div>\n                            </button>\n                          );\n                        })}\n                    </div>\n                  )}\n                </div>\n              </div>\n\n              {/* Barreiras no Laborat\303\263rio de TI */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl\">\n                <label className=\"block text-xs font-bold text-slate-800 uppercase tracking-wider mb-1\">\n                  Barreiras Observadas no Laborat\303\263rio de TI / Contexto Escolar\n                </label>\n                <textarea\n                  value={condicao}\n                  onChange={(e) => setCondicao(e.target.value)}\n                  rows={2}\n                  placeholder=\"Descreva as barreiras metodol\303\263gicas, comunicacionais ou tecnol\303\263gicas observadas em aula pr\303\241tica\"\n                  className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                />\n              </div>\n\n              {/* Potencialidades e Recursos de TA */}\n              <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3\">\n                <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                  <label className=\"block text-xs font-bold text-slate-800 uppercase tracking-wider mb-1\">\n                    Potencialidades & Interesses em TI\n                  </label>\n                  <textarea\n                    value={potencialidades}\n                    onChange={(e) => setPotentialidades(e.target.value)}\n                    rows={2}\n                    placeholder=\"Racioc\303\255nio l\303\263gico, capacidade de abstra\303\247\303\243o, interesse em linguagens de programa\303\247\303\243o, jogos\"\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                  />\n                </div>\n\n                <div className=\"p-3 bg-slate-50 border border-slate-200 rounded-xl\">\n                  <label className=\"block text-xs font-bold text-slate-800 uppercase tracking-wider mb-1\">\n                    Recursos de Tecnologia Assistiva / Acomoda\303\247\303\265es\n                  </label>\n                  <textarea\n                    value={assistiveTech}\n                    onChange={(e) => setAssistiveTech(e.target.value)}\n                    rows={2}\n                    placeholder=\"Ex: Teclado ergon\303\264mico, tempo estendido (+50%), fonte OpenDyslexic, leitor NVDA, abafadores\"\n                    className=\"w-full p-2.5 border border-slate-300 rounded-lg focus:ring-2 focus:ring-emerald-600 focus:outline-none bg-white text-xs\"\n                  />\n                </div>\n              </div>\n            </div>\n          )}\n\n          {/* ============================================================== */}\n          {/* ETAPA 4: REVIS\303\203O SINT\303\211TICA & GERA\303\207\303\203O IODA AI                   */}\n          {/* ============================================================== */}\n          {currentStep === 4 && (\n            <div className=\"space-y-4 animate-fadeIn\">\n              <div className=\"p-3 bg-emerald-50 border border-emerald-200 rounded-xl flex items-start gap-2.5\">\n                <Sparkles className=\"w-4 h-4 text-emerald-800 shrink-0 mt-0.5\" />\n                <div className=\"text-xs text-emerald-950\">\n                  <strong>Etapa 4 de 4 \302\267 Revis\303\243o e Gera\303\247\303\243o Inteligente:</strong> Confira os dados sintetizados abaixo. O agente Ioda ir\303\241 estruturar o PEI oficial completo com 8 blocos, flexibiliza\303\247\303\243o DUA 3.0 e metas SMART para computa\303\247\303\243o.\n                </div>\n              </div>\n\n              {/* Review Card */}\n              <div className=\"bg-slate-50 border border-slate-200 rounded-xl p-4 space-y-3\">\n                <div className=\"flex items-center justify-between pb-2 border-b border-slate-200\">\n                  <div>\n                    <h4 className=\"text-sm font-bold text-slate-900\">{nome || \'Nome do Estudante\'}</h4>\n                    <span className=\"text-xs text-slate-500 font-mono\">\n                      Matr\303\255cula: {matricula || \'Gerada pelo sistema\'} \302\267 Idade: {idade}\n                    </span>\n                  </div>\n                  <span className=\"text-xs font-bold bg-emerald-100 text-emerald-900 px-2.5 py-1 rounded-full\">\n                    {perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\'}\n                  </span>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs\">\n                  <div>\n                    <span className=\"text-slate-500 font-medium block\">Curso & Per\303\255odo:</span>\n                    <span className=\"text-slate-900 font-bold\">{curso} ({modulo})</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 font-medium block\">Disciplina de TI:</span>\n                    <span className=\"text-slate-900 font-bold text-emerald-800\">{disciplina}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 font-medium block\">Situa\303\247\303\243o Diagn\303\263stica:</span>\n                    <span className=\"font-semibold text-slate-800\">\n                      {statusDiagnostico === \'em_investigacao_hipotese\'\n                        ? \'Sem Laudo / Hip\303\263tese em Investiga\303\247\303\243o (Portaria MEC 421/2026)\'\n                        : \'Diagn\303\263stico Confirmado em Prontu\303\241rio\'}\n                    </span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 font-medium block\">Docente Respons\303\241vel:</span>\n                    <span className=\"text-slate-900 font-semibold\">{docenteRegente}</span>\n                  </div>\n                </div>\n\n                <div className=\"pt-2 border-t border-slate-200 text-xs space-y-1.5\">\n                  <div>\n                    <span className=\"text-slate-500 font-medium\">Barreiras Mapeadas: </span>\n                    <span className=\"text-slate-800\">{condicao || \'Barreiras de laborat\303\263rio a serem amenizadas com DUA 3.0.\'}</span>\n                  </div>\n                  <div>\n                    <span className=\"text-slate-500 font-medium\">Recursos de Tecnologia Assistiva: </span>\n                    <span className=\"text-slate-800 font-medium\">{assistiveTech || \'Tempo ampliado (+50%) e acessibilidade na IDE.\'}</span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Pedagogical Guarantee Callout */}\n              <div className=\"p-3 bg-blue-50/60 border border-blue-200 rounded-xl text-xs text-blue-950 flex items-start gap-2.5\">\n                <ShieldCheck className=\"w-4 h-4 text-blue-700 shrink-0 mt-0.5\" />\n                <span>\n                  <strong>R\303\251gua de Coer\303\252ncia Curricular:</strong> A compet\303\252ncia t\303\251cnica essencial da ementa de {disciplina} ser\303\241 mantida na \303\255ntegra. O agente Ioda flexibilizar\303\241 os formatos de representa\303\247\303\243o, engajamento e vias de avalia\303\247\303\243o (DUA 3.0) sem rebaixamento cognitivo.\n                </span>\n              </div>\n\n              {/* Generation Progress Display */}\n              {isGenerating && (\n                <div className=\"p-4 bg-emerald-50 border-2 border-emerald-300 rounded-xl flex items-center gap-3 animate-pulse\">\n                  <Loader2 className=\"w-5 h-5 text-emerald-800 animate-spin shrink-0\" />\n                  <div className=\"text-xs\">\n                    <span className=\"font-bold text-emerald-950 block text-sm\">\n                      Agente Ioda sintetizando PEI para {perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico\'}...\n                    </span>\n                    <span className=\"text-emerald-800 font-medium mt-0.5 block\">{stepMessage}</span>\n                  </div>\n                </div>\n              )}\n            </div>\n          )}\n        </div>\n\n        {/* FOOTER ACTIONS (Wizard Navigation) */}\n        <div className=\"pt-3 border-t border-slate-100 flex items-center justify-between shrink-0 bg-white\">\n          {/* Back button or step indicator */}\n          <div>\n            {currentStep > 1 && (\n              <button\n                type=\"button\"\n                onClick={() => setCurrentStep((prev) => (prev > 1 ? ((prev - 1) as any) : prev))}\n                disabled={isGenerating}\n                className=\"inline-flex items-center gap-1.5 px-3.5 py-2 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 text-xs transition-colors cursor-pointer disabled:opacity-50\"\n              >\n                <ArrowLeft className=\"w-3.5 h-3.5\" />\n                <span>Voltar</span>\n              </button>\n            )}\n            {currentStep === 1 && (\n              <button\n                type=\"button\"\n                onClick={onClose}\n                disabled={isGenerating}\n                className=\"px-3.5 py-2 border border-slate-300 text-slate-700 font-semibold rounded-lg hover:bg-slate-50 text-xs transition-colors cursor-pointer disabled:opacity-50\"\n              >\n                Cancelar\n              </button>\n            )}\n          </div>\n\n          {/* Forward / Generate Buttons */}\n          <div className=\"flex items-center gap-2\">\n            {currentStep < 4 ? (\n              <button\n                type=\"button\"\n                onClick={() => {\n                  if (currentStep === 2 && !isStep2Valid) return;\n                  setCurrentStep((prev) => (prev < 4 ? ((prev + 1) as any) : prev));\n                }}\n                disabled={currentStep === 2 && !isStep2Valid}\n                className=\"inline-flex items-center gap-1.5 px-4 py-2 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg text-xs transition-colors cursor-pointer disabled:opacity-50 shadow-xs\"\n              >\n                <span>Avan\303\247ar</span>\n                <ArrowRight className=\"w-3.5 h-3.5\" />\n              </button>\n            ) : (\n              <button\n                type=\"button\"\n                onClick={handleFinalSubmit}\n                disabled={isGenerating || !nome.trim()}\n                className=\"inline-flex items-center gap-2 px-5 py-2.5 bg-emerald-700 hover:bg-emerald-800 text-white font-bold rounded-lg text-xs transition-colors cursor-pointer disabled:opacity-50 shadow-sm\"\n              >\n                {isGenerating ? (\n                  <>\n                    <Loader2 className=\"w-4 h-4 animate-spin\" />\n                    <span>Gerando PEI Oficial...</span>\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4 text-emerald-200\" />\n                    <span>Gerar PEI Completo com Ioda AI</span>\n                  </>\n                )}\n              </button>\n            )}\n          </div>\n        </div>\n      </div>\n    </div>\n  );\n};\n"
    num_lines: 1496
    num_bytes: 78489
    line_range_bytes: 35125
  }
}
