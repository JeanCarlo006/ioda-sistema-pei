      thinking_signature: "\022\330\f\n\325\f\001i\024}\023\315\370U\033:<%D\b.\354\335\370sju\264z\272s\021\350\023\236\215\322\262\333i\220p3\373b\232\344\334^q\254\243\017 0\305Jm(}`\303\021\321-\352\202F$ :>\371\213\354\310\033\0044\217\022\211%\220$\363\033\341\300\bDx.\342\362\246\200P7}e\353\300\254\vT\274\003b}vd\001\026@/UD\345\371\027[+\263\340X\027\307\330\342_C\231[L\034\355\347\327\000\033<\254\245*\303\364\256\345\307\a\232\311C\251?o\372\177\020\242\3412\020\f#\332s\253\3624\323pT1\3350\203\000\352\330\270a]j\245xle\345\016\366\034m\304\254\177\257\261Rj\210\030\255\213ne\322k\317\310-\021\037\260\n7<!\302B}\245\316\262\301\271\235\v\337\265G\243n\361.\315\317g\342\365\221\277\354-!J\263(\356\320.\036\311\324\230\230\3416\364\337\340w{\371V1\344\2667A\372F3d\377gV9\313\200\244\334\212\231<c\317oa\363\221\253\355z|\340\367\362\203EL[\343\005\237Dekm8d7\237\241\253~P\313\253\233+\241`\3110-P\226\016+\206\025\027Z\026\325\212\236\v\017\250Y\016z\252\275\324\330\035\232\252\371\226\276%42\207\254\000W\006\300\320\263Q,\367pX\221?\305\312-\233.\323\'\265\026{N\251\312\005\224\212\323\252\3252\003\306?i\247\250\v\r\276Y@\301X\236\202\262\320\365c\223\362R\331\260\032c\372\a\005\353<vvS\255&}+\304\317\240\347]I\260Y\302O\300\005\\j\016[Q\271\247\240\366{\334h\207\237T\261G\360\373\277\002\340\017\360\307\245$\240fl\343\257?\300\306\315x\217OM\312\033\224\341G\b\002\321UNs2\"#\273\274\363\317\270\177r\247\037H\351\312N\333\304m\377\377.\334\265\n\001\220-\302\232&\256^h\001\304\273\231\000\366\323ah\315\r\341H\274\334\212r\357B<\302\320\356\363\001\231:\241\244\331\262\2259\203g\250\201t\000g\331\323\034X\324\002\364oo\347d7}uD\306_K\020\275\264\273?U\317D_\005\253\202H\023JV\226\304\277\214\177\250\327]\256\301!\316\350\032@\275<\305\250\203\r\221\f\0215\237\215Go\353vbk\260\027\343\234\262GHU\350\242X\'\351\342u\b\001\351\372O\265\243\244\237\367x\206o\374\022\221\\jU\366\211S6\337\231\202~\371\030\002\335\021\270\320j\f \260j;O\245\206\2566\342\304\323F\33