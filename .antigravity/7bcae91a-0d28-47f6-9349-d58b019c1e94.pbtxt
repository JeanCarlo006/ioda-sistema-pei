  code_action {
    action_spec {
      create_file {
        instruction: "import express, { Request, Response } from \'express\';\nimport { GoogleGenAI, Type } from \'@google/genai\';\nimport path from \'path\';\nimport { fileURLToPath } from \'url\';\nimport dotenv from \'dotenv\';\n\ndotenv.config();\n\nconst __filename = fileURLToPath(import.meta.url);\nconst __dirname = path.dirname(__filename);\n\nconst app = express();\nconst port = process.env.PORT || 3000;\n\napp.use(express.json({ limit: \'10mb\' }));\n\n// Initialize Google GenAI client (Server-Side only)\nconst ai = new GoogleGenAI({\n  apiKey: process.env.GEMINI_API_KEY || \'\',\n  httpOptions: {\n    headers: {\n      \'User-Agent\': \'aistudio-build\',\n    },\n  },\n});\n\n// API Route: Generate or Refine PEI & PAEE using Gemini 3.8 Flash\napp.post(\'/api/gemini/generate-pei\', async (req: Request, res: Response) => {\n  try {\n    const {\n      studentName,\n      age,\n      subject,\n      grade,\n      syllabus,\n      essentialObjectives,\n      barriers,\n      potentialities,\n      assistiveTech,\n      familyContext,\n      actionType,\n    } = req.body;\n\n    const systemPrompt = `Voc\303\252 \303\251 um especialista s\303\252nior em Educa\303\247\303\243o Especial Inclusiva do Brasil, com dom\303\255nio aprofundado da legisla\303\247\303\243o vigente:\n- Decreto Presidencial n\302\272 12.686/2025 e Decreto n\302\272 12.773/2025 (Pol\303\255tica Nacional de Educa\303\247\303\243o Especial Inclusiva - PNEEI)\n- Portaria MEC n\302\272 421/2026 (arts. 7\302\272, 10 e 11)\n- Lei Brasileira de Inclus\303\243o (Lei n\302\272 13.146/2015) e Lei n\302\272 15.249/2025 (Comunica\303\247\303\243o Aumentativa e Alternativa - CAA)\n- Cadernos Pedag\303\263gicos n\302\272 3 e n\302\272 4 da SECADI/MEC e UFC (Estudo de Caso em 4 Etapas, PAEE, PEI, PEI-Painel, \303\211tica do Cuidado e DUA 3.0 do CAST 2024).\n\nDiretrizes fundamentais inegoci\303\241veis:\n1. \"Curr\303\255culo n\303\243o se adapta, nem se flexibiliza: curr\303\255culo deve ser acess\303\255vel!\"\n2. O estudante p\303\272blico da Educa\303\247\303\243o Especial tem direito ao curr\303\255culo comum da BNCC sem empobrecimento ou infantiliza\303\247\303\243o.\n3. Eliminar barreiras (arquitet\303\264nicas, urban\303\255sticas, de transporte, comunicacionais, metodol\303\263gicas, tecnol\303\263gicas e atitudinais).\n4. O DUA 3.0 deve orientar o planejamento pelos 3 princ\303\255pios: M\303\272ltiplos Meios de Engajamento, M\303\272ltiplos Meios de Representa\303\247\303\243o e M\303\272ltiplos Meios de A\303\247\303\243o e Express\303\243o.\n5. Indicar a\303\247\303\265es intersetoriais (sa\303\272de, assist\303\252ncia social) e planejamento colaborativo semanal entre professor da sala comum, professor do AEE e profissional de apoio.\n6. A avalia\303\247\303\243o deve ser processual e acess\303\255vel (com media\303\247\303\243o, tempo ampliado, suportes de CAA).\n\nGere um documento t\303\251cnico pedag\303\263gico completo e estruturado em formato JSON rigoroso.`;\n\n    const userPrompt = `A\303\207\303\203O: ${actionType || \'CRIA\303\207\303\203O_INICIAL\'}\n[DADOS DO COMPONENTE CURRICULAR]\n- Disciplina: ${subject || \'Matem\303\241tica\'}\n- Ano/M\303\263dulo: ${grade || \'5\302\272 Ano do Ensino Fundamental\'}\n- Ementa / Conte\303\272do Program\303\241tico: ${syllabus || \'Habilidade BNCC EF05MA09 - Problemas de contagem e princ\303\255pio multiplicativo\'}\n- Objetivos Essenciais da Turma: ${essentialObjectives || \'Compreender e operacionalizar o conceito de multiplica\303\247\303\243o a partir de agrupamentos e resolu\303\247\303\243o de problemas\'}\n\n[ESTUDO DE CASO DO ESTUDANTE]\n- Nome do Aluno: ${studentName || \'Gabriel Ramos Rodrigues\'}\n- Idade: ${age || \'11 anos\'}\n- Barreiras Observadas: ${barriers || \'Barreiras comunicacionais (oralidade em desenvolvimento, fala monossil\303\241bica), metodol\303\263gicas (falta de materiais concretos), tecnol\303\263gicas (sem prancha CAA regularizada) e atitudinais (baixas expectativas). Cadeira de rodas.\'}\n- Potencialidades e Interesses: ${potentialities || \'Interesse genu\303\255no em futebol (figurinhas de jogadores, uniformes), muito receptivo, realiza adi\303\247\303\243o e subtra\303\247\303\243o com materiais concretos.\'}\n- Necessidades de Apoio / TA: ${assistiveTech || \'Prancha tem\303\241tica de CAA, plano inclinado na mesa, materiais concretos/t\303\241teis (material dourado, \303\241baco de pinos largos), profissional de apoio escolar.\'}\n- Contexto Familiar / NAPNE: ${familyContext || \'M\303\243e participativa e dedicada, m\303\243e realiza apoio em casa mas necessita de suporte intersetorial (reabilita\303\247\303\243o fonoaudiol\303\263gica e fisioter\303\241pica).\'}\n\nRetorne uma estrutura JSON completa seguindo o esquema solicitado.`;\n\n    const response = await ai.models.generateContent({\n      model: \'gemini-3.8-flash\',\n      contents: userPrompt,\n      config: {\n        systemInstruction: systemPrompt,\n        responseMimeType: \'application/json\',\n        responseSchema: {\n          type: Type.OBJECT,\n          properties: {\n            cabecalho: {\n              type: Type.OBJECT,\n              properties: {\n                estudante: { type: Type.STRING },\n                matricula: { type: Type.STRING },\n                componente_curricular: { type: Type.STRING },\n                modulo_periodo: { type: Type.STRING },\n                data_elaboracao: { type: Type.STRING },\n                docente_regente: { type: Type.STRING },\n                docente_aee: { type: Type.STRING },\n                profissional_apoio: { type: Type.STRING },\n              },\n              required: [\'estudante\', \'componente_curricular\', \'modulo_periodo\'],\n            },\n            historico_e_condicao_napne: {\n              type: Type.OBJECT,\n              properties: {\n                breve_historico_clinico_familiar: { type: Type.STRING },\n                descricao_condicao_especifica: { type: Type.STRING },\n                informacoes_dos_pais: { type: Type.STRING },\n              },\n              required: [\'breve_historico_clinico_familiar\', \'descricao_condicao_especifica\', \'informacoes_dos_pais\'],\n            },\n            estudo_de_caso_sintese: {\n              type: Type.OBJECT,\n              properties: {\n                barreiras_identificadas: {\n                  type: Type.ARRAY,\n                  items: { type: Type.STRING },\n                },\n                potencialidades_interesses: {\n                  type: Type.ARRAY,\n                  items: { type: Type.STRING },\n                },\n                recursos_tecnologia_assistiva: {\n                  type: Type.ARRAY,\n                  items: { type: Type.STRING },\n                },\n              },\n              required: [\'barreiras_identificadas\', \'potencialidades_interesses\', \'recursos_tecnologia_assistiva\'],\n            },\n            planejamento_pedagogico_pei: {\n              type: Type.OBJECT,\n              properties: {\n                conteudo_ementa_oficial: { type: Type.STRING },\n                competencias_habilidades_ementa: { type: Type.STRING },\n                objetivos_e_metas_adaptadas: {\n                  type: Type.ARRAY,\n                  items: {\n                    type: Type.OBJECT,\n                    properties: {\n                      id_meta: { type: Type.STRING },\n                      descricao_meta: { type: Type.STRING },\n                      prazo: { type: Type.STRING },\n                      indicador_sucesso: { type: Type.STRING },\n                    },\n                    required: [\'id_meta\', \'descricao_meta\', \'prazo\', \'indicador_sucesso\'],\n                  },\n                },\n                flexibilizacao_metodologica_dua: {\n                  type: Type.OBJECT,\n                  properties: {\n                    engajamento: {\n                      type: Type.ARRAY,\n                      items: { type: Type.STRING },\n                    },\n                    representacao: {\n                      type: Type.ARRAY,\n                      items: { type: Type.STRING },\n                    },\n                    acao_e_expressao: {\n                      type: Type.ARRAY,\n                      items: { type: Type.STRING },\n                    },\n                  },\n                  required: [\'engajamento\', \'representacao\', \'acao_e_expressao\'],\n                },\n                gestao_sala_de_aula: {\n                  type: Type.ARRAY,\n                  items: { type: Type.STRING },\n                },\n                estrategias_de_avaliacao: {\n                  type: Type.OBJECT,\n                  properties: {\n                    formato_acessivel: { type: Type.STRING },\n                    criterio_de_sucesso: { type: Type.STRING },\n                  },\n                  required: [\'formato_acessivel\', \'criterio_de_sucesso\'],\n                },\n              },\n              required: [\'conteudo_ementa_oficial\', \'objetivos_e_metas_adaptadas\', \'flexibilizacao_metodologica_dua\', \'estrategias_de_avaliacao\'],\n            },\n            plano_aee: {\n              type: Type.OBJECT,\n              properties: {\n                organizacao_srm: { type: Type.STRING },\n                materiais_a_produzir: {\n                  type: Type.ARRAY,\n                  items: { type: Type.STRING },\n                },\n                articulacoes_ensino_comum: { type: Type.STRING },\n                articulacoes_intersetoriais: { type: Type.STRING },\n              },\n              required: [\'organizacao_srm\', \'materiais_a_produzir\', \'articulacoes_ensino_comum\'],\n            },\n            painel_de_acompanhamento: {\n              type: Type.OBJECT,\n              properties: {\n                status_periodo: { type: Type.STRING },\n                metricas_grafico: {\n                  type: Type.OBJECT,\n                  properties: {\n                    percentual_metas_alcancadas: { type: Type.NUMBER },\n                    nivel_autonomia_1_a_5: { type: Type.NUMBER },\n                    engajamento_nas_atividades_1_a_5: { type: Type.NUMBER },\n                  },\n                  required: [\'percentual_metas_alcancadas\', \'nivel_autonomia_1_a_5\', \'engajamento_nas_atividades_1_a_5\'],\n                },\n                parecer_pedagogico: { type: Type.STRING },\n                sugestoes_proximo_ciclo: {\n                  type: Type.ARRAY,\n                  items: { type: Type.STRING },\n                },\n              },\n              required: [\'status_periodo\', \'metricas_grafico\', \'parecer_pedagogico\', \'sugestoes_proximo_ciclo\'],\n            },\n          },\n          required: [\n            \'cabecalho\',\n            \'historico_e_condicao_napne\',\n            \'estudo_de_caso_sintese\',\n            \'planejamento_pedagogico_pei\',\n            \'painel_de_acompanhamento\',\n          ],\n        },\n      },\n    });\n\n    const outputText = response.text || \'{}\';\n    const parsedData = JSON.parse(outputText);\n    return res.json({ success: true, data: parsedData });\n  } catch (error: any) {\n    console.error(\'Error generating PEI via Gemini:\', error);\n    return res.status(500).json({\n      success: false,\n      error: error?.message || \'Falha ao processar solicita\303\247\303\243o com Gemini AI.\',\n    });\n  }\n});\n\n// Setup Vite middleware in dev or serve static files in production\nasync function startServer() {\n  if (process.env.NODE_ENV !== \'production\') {\n    const { createServer } = await import(\'vite\');\n    const vite = await createServer({\n      server: { middlewareMode: true },\n      appType: \'spa\',\n    });\n    app.use(vite.middlewares);\n  } else {\n    app.use(express.static(path.join(__dirname, \'dist\')));\n    app.get(\'*\', (_req, res) => {\n      res.sendFile(path.join(__dirname, \'dist\', \'index.html\'));\n    });\n  }\n\n  app.listen(port, () => {\n    console.log(`Server running on port ${port}`);\n  });\n}\n\nstartServer();\n"
        path {
          absolute_uri: "file:///server.ts"
        }
        overwrite: true
      }
    }
