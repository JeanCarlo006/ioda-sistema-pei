      thinking_signature: "\022\262\024\n\257\024\001i\024}\023\260;\217\177C-k\b`\232\035\260\3726\355\276\"\244\355\243\016\024\324\362O&Gc3\021\302r\'\217\020*uVO\257\206\2263\264@\f\352I7AZ`\003\276\001Y-\374\257:%\2616B\000\215\251Yq\024$%\233\366\205\331\252]\323\262\321y\213\272\260A\212/\372\372\226\317\006\026\236\241\200\2351\tl\026\215\367:\305\025\3519r\301\373<?\235\354\250\264;hb\272\231\330YT\370\274\325\302\']\347\352O4\326\233;\344\354\304\026\367\323,z\210s\'~\351SDT\265~AbG\270\330\334\227Yf\367\333v\347\210Yp\2505~\231H\342)u\230\236\216;\227\255\226\310\257\215\035,i\033[0\2331\2310\234\302\020\327B\002\253\030\302#\232-\342\247\3472\306\252\315\230\267U\312E\370\307\022 \227\346M\372_(\331\330\213vuj\340`\332\032\016\257Y60\222\025\'\243\270\203\214\347f\"\023\023\342\363\242W<\021\332Q+\377\236\364\211\001\344\366\266\2402N\365_V\025\026\231h\203f\366(\273\022]\364cn\310a0\264K%v2\350\301\3769\034\276\277\373\240\334(\022\033\002\357YB\343\b\333=\320$\254~*_Xb\3369vC\276\346\322\274\375{2\370\367\325\316\332\031\336t\257\334\312\233~\356\347\020\274\021\215\346\177/H\355v\377\227\225\370\312|\270T\371\373\273\361\3040\206~b(yBB96\t$,\360\257\354q\310*\203|\016J}A\005\376\372k\316[\r\034\031\221\305\002)U\356\276xFR\264\364\360\274E\301-\315\267_\227\337\316\3435e\236\330kV\234{%@\003\022\024A\220\350\203\321]\253\256\264\331\353\3470\212\tI\254L\301H\n\373/\332>\336\344\316\376\276\246\244\313{\365\227\305\274\363M\245-\025 \254\361s\226vZ8[C\v\362b\376BE\301\335w\f/\340\300\322\215d\370P\271\215\303)\370\204\236\305\026\311\231.\016n.\2307/\205p\262\202\fH)\037\367\005\255%F\034\274\365a?\323\242~\270\315Q\025\362\005\aqM\256B\025ohZ\017\220\236\2059(\312(.\272\372\274\266N\317\360\357\346\346\360/\214\017W\261*\236\v %\354)\244[w\rL\026l\323>\350pr\354>;\244\364M\354\370\342\205(\310\201\022\225\247\351\356\024\376j\023\025j\352>\275\273]p\326\177\023\203c\321\363S\265\022\270\355\210\265Z|7\377z\3767\337\251bU\036*\361Y\373\345\236\366\337\