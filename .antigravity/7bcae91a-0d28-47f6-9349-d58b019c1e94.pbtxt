  view_file {
    absolute_path_uri: "file:///src/App.tsx"
    start_line: 189
    end_line: 283
    content: "  return (\n    <div className=\"min-h-screen bg-slate-50 flex flex-col font-sans\">\n      {/* Top Bar Navigation */}\n      <Navbar\n        activeTab={activeTab}\n        setActiveTab={setActiveTab}\n        onOpenAddStudent={() => setIsAddStudentOpen(true)}\n        onOpenSolutionBank={() => setIsSolutionBankOpen(true)}\n        onOpenCampusStats={() => setIsCampusStatsOpen(true)}\n        onPrint={handlePrint}\n      />\n\n      {/* Student Profile Header & Case Switcher */}\n      <div className=\"no-print\">\n        <StudentHeader\n          pei={activePei}\n          allStudents={studentsList}\n          onSelectCase={handleSelectStudent}\n          onOpenAddStudent={() => setIsAddStudentOpen(true)}\n          onOpenCampusStats={() => setIsCampusStatsOpen(true)}\n        />\n      </div>\n\n      {/* Main Content Area */}\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8\">\n        {activeTab === \'pei\' && (\n          <PeiView\n            pei={activePei}\n            onUpdateMetaStatus={handleUpdateMetaStatus}\n            onAddMeta={handleAddMeta}\n            onOpenSolutionBank={() => setIsSolutionBankOpen(true)}\n          />\n        )}\n\n        {activeTab === \'estudo_caso\' && <CaseStudyView pei={activePei} />}\n\n        {activeTab === \'documento_oficial\' && (\n          <OfficialTemplateView\n            pei={activePei}\n            onPrint={handlePrint}\n            onUpdatePei={handleUpdatePei}\n          />\n        )}\n\n        {activeTab === \'painel\' && (\n          <PeiPainelView\n            pei={activePei}\n            onAddPostIt={handleAddPostIt}\n            onDeletePostIt={handleDeletePostIt}\n          />\n        )}\n      </main>\n\n      {/* Institutional Legal Footer */}\n      <footer className=\"bg-white border-t border-slate-200 py-6 text-xs text-slate-500 no-print mt-auto\">\n        <div className=\"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"font-bold text-slate-700\">Ioda \302\267 Inclusion on Diversity Agent</span>\n            <span>\302\267 NAPNE Campus Para\303\255so (29 Estudantes \302\267 15 M\303\251dio \302\267 14 Superior)</span>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-4 text-[11px] text-slate-500\">\n            <span>Decreto n\302\272 12.686/2025</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>Portaria MEC n\302\272 421/2026 (PEI s/ Laudo)</span>\n            <span aria-hidden=\"true\">\302\267</span>\n            <span>NAPNE & DUA 3.0</span>\n          </div>\n        </div>\n      </footer>\n\n      {/* Modal: Adicionar Novo Aluno e Gerar PEI */}\n      <AddStudentModal\n        isOpen={isAddStudentOpen}\n        onClose={() => setIsAddStudentOpen(false)}\n        onAddStudent={handleAddNewStudent}\n      />\n\n      {/* Modal: Banco de Solu\303\247\303\265es Pedag\303\263gicas para Condi\303\247\303\265es */}\n      <SolutionBankModal\n        isOpen={isSolutionBankOpen}\n        onClose={() => setIsSolutionBankOpen(false)}\n        activePei={activePei}\n        onApplySolution={handleApplySolution}\n      />\n\n      {/* Modal: Estat\303\255sticas e Censo NAPNE Campus Para\303\255so */}\n      <CampusStatsModal\n        isOpen={isCampusStatsOpen}\n        onClose={() => setIsCampusStatsOpen(false)}\n      />\n    </div>\n  );\n}\n"
    num_lines: 284
    num_bytes: 9497
    line_range_bytes: 3284
  }
}
