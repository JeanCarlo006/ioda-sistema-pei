      name: "replace_file_content"
      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Update gerarNovoPeiCompleto with Campus Para\303\255so and diagnostic status handling\", \"EndLine\":1175, \"Instruction\":\"Update gerarNovoPeiCompleto signature and historico_napne initialization\", \"ReplacementContent\":\"export function gerarNovoPeiCompleto(dados: {\\n  nome: string;\\n  matricula: string;\\n  idade: string;\\n  curso: string;\\n  disciplina: string;\\n  modulo: string;\\n  condicao: string;\\n  docenteRegente: string;\\n  docenteAee: string;\\n  solucaoBaseId?: string;\\n  statusDiagnostico?: \'confirmado\' | \'em_investigacao_hipotese\';\\n  categoriaNeurodivergencia?: string;\\n}): PEICompleto {\\n  const solucao =\\n    bancoDeSolucoesPedagogicas.find((s) => s.id === dados.solucaoBaseId) ||\\n    bancoDeSolucoesPedagogicas[0];\\n\\n  const id = `PEI-${Date.now().toString().slice(-4)}`;\\n\\n  return {\\n    id,\\n    cabecalho: {\\n      estudante: dados.nome,\\n      codigo_matricula: dados.matricula || `TI-${Math.floor(1000 + Math.random() * 9000)}`,\\n      idade: dados.idade || \'18 anos\',\\n      curso: dados.curso || \'Curso T\303\251cnico em Inform\303\241tica / Bacharelado em TI\',\\n      componente_curricular: dados.disciplina || \'Tecnologia da Informa\303\247\303\243o\',\\n      modulo_periodo: dados.modulo || \'2\302\272 Semestre / 2026\',\\n      data_elaboracao: new Date().toISOString().split(\'T\')[0],\\n      docente_regente: dados.docenteRegente || \'Prof. Respons\303\241vel pela Disciplina\',\\n      docente_aee: dados.docenteAee || \'Prof\302\252. Especialista do NAPNE\',\\n      profissional_apoio: \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\\n      coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\\n    },\\n    historico_napne: {\\n      status_diagnostico: dados.statusDiagnostico || \'confirmado\',\\n      categoria_neurodivergencia:\\n        dados.categoriaNeurodivergencia ||\\n        (dados.statusDiagnostico === \'em_investigacao_hipotese\'\\n          ? \'Hip\303\263tese Diagn\303\263stica / Em Investiga\303\247\303\243o pelo NAPNE\'\\n          : \'Neurodiverg\303\252ncia / Condi\303\247\303\243o Acompanhada\'),\\n      cid_ou_hipotese:\\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\\n          ? \'Em investiga\303\247\303\243o pedag\303\263gica multiprofissional (Portaria MEC n\302\272 421/2026)\'\\n          : \'Diagn\303\263stico confirmado em prontu\303\241rio NAPNE\',\\n      breve_historico_clinico_familiar: `Estudante do ${dados.curso} no Campus Para\303\255so. Acompanhado pelo NAPNE com foco na garantia do direito \303\240 educa\303\247\303\243o inclusiva e acessibilidade curricular nos termos da Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.${\\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\\n          ? \' Atendimento pedag\303\263gico iniciado com base nas barreiras escolares observadas, sem depend\303\252ncia de laudo pericial pr\303\251vio.\'\\n          : \'\'\\n      }`,\\n      descricao_condicao_especifica: dados.condicao || solucao.descricaoProblema,\\n      informacoes_dos_pais: \'Estudante e fam\303\255lia em alinhamento constante com o NAPNE Campus Para\303\255so e coordena\303\247\303\243o de curso.\',\\n    },\\n\", \"StartLine\":1135, \"TargetContent\":\"export function gerarNovoPeiCompleto(dados: {\\n  nome: string;\\n  matricula: string;\\n  idade: string;\\n  curso: string;\\n  disciplina: string;\\n  modulo: string;\\n  condicao: string;\\n  docenteRegente: string;\\n  docenteAee: string;\\n  solucaoBaseId?: string;\\n}): PEICompleto {\\n  const solucao =\\n    bancoDeSolucoesPedagogicas.find((s) => s.id === dados.solucaoBaseId) ||\\n    bancoDeSolucoesPedagogicas[0];\\n\\n  const id = `PEI-${Date.now().toString().slice(-4)}`;\\n\\n  return {\\n    id,\\n    cabecalho: {\\n      estudante: dados.nome,\\n      codigo_matricula: dados.matricula || `TI-${Math.floor(1000 + Math.random() * 9000)}`,\\n      idade: dados.idade || \'18 anos\',\\n      curso: dados.curso || \'Curso T\303\251cnico em Inform\303\241tica / Bacharelado em TI\',\\n      componente_curricular: dados.disciplina || \'Tecnologia da Informa\303\247\303\243o\',\\n      modulo_periodo: dados.modulo || \'2\302\272 Semestre / 2026\',\\n      data_elaboracao: new Date().toISOString().split(\'T\')[0],\\n      docente_regente: dados.docenteRegente || \'Prof. Respons\303\241vel pela Disciplina\',\\n      docente_aee: dados.docenteAee || \'Prof\302\252. Especialista do NAPNE\',\\n      profissional_apoio: \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\\n      coordenacao_napne: \'Coordena\303\247\303\243o NAPNE / Diretoria de Acessibilidade\',\\n    },\\n    historico_napne: {\\n      breve_historico_clinico_familiar: `Estudante regularmente matriculado no ${dados.curso}. Hist\303\263rico escolar acompanhado pelo NAPNE com foco na garantia do direito \303\240 educa\303\247\303\243o inclusiva e acessibilidade curricular nos termos do Decreto n\302\272 12.686/2025.`,\\n      descricao_condicao_especifica: dados.condicao || solucao.descricaoProblema,\\n      informacoes_dos_pais: \'Estudante e fam\303\255lia em alinhamento constante com o NAPNE e coordena\303\247\303\243o de curso.\',\\n    },\\n\", \"TargetFile\":\"/src/data/initialCases.ts\", \"toolAction\":\"Updating gerarNovoPeiCompleto\", \"toolSummary\":\"Update gerarNovoPeiCompleto for campus paraiso\"}"
      thinking_signature: "\022\312\021\n\307\021\001i\024}\023f\235b\317\310>\304?L\376\270e\211\201\367\000}C\262\264\302[[YB\320\275\255\202JW\3772\344\351\260\363\363\232\r\262y\237\226\245\347\023\357\337\267\356\325\300,\224m\321\220j\023\261\031$\357x\277\035\"\002|\261+\344\000\r\213\v\331AyJ\aD\272\313\n{\214\255\247w\331a\241\343L\212\267\311\343\304\214\237\030\264\336k\310\202\321\3123\215[Q2\261\247)2r\373\320\363V\021\262\215\372o}\220~\246o\t1\303\324\347\367\327\033\364\300\242h\034y\200R\336\204\240\017\374\263\251_K\267^(u@\376\206\332\310\032\0320\311\357\240\036\312w\aZq\373-\3745\rz\n\275Z\220\036\257\264\367\036sem\352\031\210%N\000\331\307D\"X\337M D\314%\242\375\232\237~\000\"\207\035\"\366\222~\324\\\220&\313\213\257,\347\225o\341\212\304\302\312\334\020f[\032Ma!\246g\217Z\2739a\016\322u\210\375\223+\202!|N$\\\022\260\312\246\330\024\377\003\332:\001.Y\332\324\303\334@C\r\242\005l\301\2725\2761\210\264/\333\236\224>A:\177\a\030!\317Z\210\035\353\226\'5 \203\020\025i\374\347\241?\276\030B\343\335\004-<(X\230\021\207\260A\267}\272\312\363XZ\340\355\321L\254\263\037\340\273W3\024ebK\371\002\316\035\2450\000:$\fl\226\213\224\222\'5\033\262{\250\306g\205\356C8\034\314F\r\275\223\036\241\376\330\256V\220\372\314\343\023^\361\3158\v\321\027\337Kt3q\264\267\271\312\217\361\261\307--\200\251A\365\247*Ou\002#\377@\'\006\002\022\316\215\026\036g\271<\016\311\210\312n\347\327s\213\a\223\243\265\203\300\223\371\327;h\304\361\312\244\241\301\235\216v0%\254*R\005\215;\274\317\330\310\356\a\200 \345\333\366\342\340>\212\2645\257\025\240\345\335\315\v\233\035\234\220r:\307N\337\237\345\312\356\223\305Vvd\240\224\266Z\311\325\273t\251KO$\220\242\336\023\231\233\367l\033\332\241\256\0314\212\302\020\352\371D\033\300\362fYF\':\035\023ln\a\020\342\351\b)\346Yd\336c\256\337\177\250\347\234\3666\231\322\n\003\3276\031/\177\365\374T\235(b\031\016/\025c\'\331\301\377\243\204[\233\356\364>\tu\a\204\3152\334\267\311o\nv\025R9\344\355b\242\371\027\232\232\316B\371\0208