      arguments_json: "{\"AllowMultiple\":false, \"Description\":\"Add unified Suporte & Diretrizes dropdown menu in Navbar\", \"EndLine\":45, \"Instruction\":\"Import useState, ChevronDown, ShieldCheck, HelpCircle, BookOpen, and add isSupportOpen state\", \"ReplacementContent\":\"import React, { useState } from \'react\';\\nimport {\\n  UserPlus,\\n  Printer,\\n  Wrench,\\n  BarChart2,\\n  Type,\\n  Eye,\\n  Sun,\\n  Moon,\\n  ChevronDown,\\n  ShieldCheck,\\n  HelpCircle,\\n  BookOpen,\\n  Settings,\\n} from \'lucide-react\';\\nimport { estatisticasCampusParaiso } from \'../data/initialCases\';\\nimport { EscalaFonte, ModoContraste } from \'../types/pei\';\\n\\ninterface NavbarProps {\\n  activeTab: string;\\n  setActiveTab: (tab: string) => void;\\n  onOpenAddStudent: () => void;\\n  onOpenSolutionBank: () => void;\\n  onOpenCampusStats?: () => void;\\n  onPrint: () => void;\\n  escalaFonte?: EscalaFonte;\\n  onMudarFonte?: (escala: EscalaFonte) => void;\\n  modoContraste?: ModoContraste;\\n  onMudarContraste?: (modo: ModoContraste) => void;\\n}\\n\\nexport const Navbar: React.FC<NavbarProps> = ({\\n  activeTab,\\n  setActiveTab,\\n  onOpenAddStudent,\\n  onOpenSolutionBank,\\n  onOpenCampusStats,\\n  onPrint,\\n  escalaFonte = \'normal\',\\n  onMudarFonte,\\n  modoContraste = \'padrao\',\\n  onMudarContraste,\\n}) => {\\n  const [isSupportOpen, setIsSupportOpen] = useState(false);\\n  const stats = estatisticasCampusParaiso;\\n  const navItems = [\\n    { id: \'hub\', label: \'Hub do PEI\' },\\n    { id: \'pei\', label: \'Plano de Ensino (PEI)\' },\\n    { id: \'estudo_caso\', label: \'Estudo de Caso & DUA\' },\\n    { id: \'documento_oficial\', label: \'Modelo Oficial IFTO\' },\\n    { id: \'painel\', label: \'Acompanhamento & Metas\' },\\n  ];\", \"StartLine\":1, \"TargetContent\":\"import React from \'react\';\\nimport { UserPlus, Printer, Wrench, BarChart2, Type, Eye, Sun, Moon } from \'lucide-react\';\\nimport { estatisticasCampusParaiso } from \'../data/initialCases\';\\nimport { EscalaFonte, ModoContraste } from \'../types/pei\';\\n\\ninterface NavbarProps {\\n  activeTab: string;\\n  setActiveTab: (tab: string) => void;\\n  onOpenAddStudent: () => void;\\n  onOpenSolutionBank: () => void;\\n  onOpenCampusStats?: () => void;\\n  onPrint: () => void;\\n  escalaFonte?: EscalaFonte;\\n  onMudarFonte?: (escala: EscalaFonte) => void;\\n  modoContraste?: ModoContraste;\\n  onMudarContraste?: (modo: ModoContraste) => void;\\n}\\n\\nexport const Navbar: React.FC<NavbarProps> = ({\\n  activeTab,\\n  setActiveTab,\\n  onOpenAddStudent,\\n  onOpenSolutionBank,\\n  onOpenCampusStats,\\n  onPrint,\\n  escalaFonte = \'normal\',\\n  onMudarFonte,\\n  modoContraste = \'padrao\',\\n  onMudarContraste,\\n}) => {\\n  const stats = estatisticasCampusParaiso;\\n  const navItems = [\\n    { id: \'hub\', label: \'Hub de Ferramentas\' },\\n    { id: \'pei\', label: \'Plano de Ensino (PEI)\' },\\n    { id: \'estudo_caso\', label: \'Estudo de Caso & DUA\' },\\n    { id: \'documento_oficial\', label: \'Modelo Oficial IFTO\' },\\n    { id: \'painel\', label: \'Painel & Metas\' },\\n  ];\", \"TargetFile\":\"/src/components/Navbar.tsx\", \"toolAction\":\"Adding support menu state and imports to Navbar\", \"toolSummary\":\"Update Navbar imports and state\"}"
