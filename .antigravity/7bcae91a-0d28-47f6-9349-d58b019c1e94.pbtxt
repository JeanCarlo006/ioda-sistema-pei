      original_chunk {
        target_content: "              {/* LISTAGEM DAS 9 NEURODIVERG\303\212NCIAS (SOLICITA\303\207\303\203O OFICIAL) */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-2.5\">\n                <div className=\"flex items-center justify-between\">\n                  <div>\n                    <label className=\"text-xs font-bold text-slate-800 uppercase tracking-wider block\">\n                      Neurodiverg\303\252ncias no Contexto de TI & Laborat\303\263rio (DUA 3.0):\n                    </label>\n                    <span className=\"text-[11px] text-slate-500\">\n                      Selecione uma das 9 neurodiverg\303\252ncias para calibrar barreiras, TA e metas:\n                    </span>\n                  </div>\n                  <span className=\"text-[10px] bg-emerald-100 text-emerald-900 font-semibold px-2 py-0.5 rounded font-mono\">\n                    9 Neurodiverg\303\252ncias\n                  </span>\n                </div>\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-56 overflow-y-auto pr-1\">\n                  {[\n                    {\n                      id: \'sol-tdah\',\n                      titulo: \'Transtorno do D\303\251ficit de Aten\303\247\303\243o com Hiperatividade (TDAH)\',\n                      sigla: \'TDAH\',\n                      icone: Brain,\n                      resumo: \'Micro-sprints \303\241geis (Jira/Kanban), Pomodoro, linters no VS Code e TDD em etapas.\',\n                    },\n                    {\n                      id: \'sol-tea\',\n                      titulo: \'Transtorno do Espectro Autista (TEA)\',\n                      sigla: \'TEA\',\n                      icone: Sparkles,\n                      resumo: \'Previsibilidade, roteiros de testes estruturados, abafador no LABIN e enunciados literais.\',\n                    },\n                    {\n                      id: \'sol-ansiedade\',\n                      titulo: \'Transtornos de ansiedade (generalizada, f\303\263bico-ansiosos, p\303\242nico, outros)\',\n                      sigla: \'Ansiedade\',\n                      icone: HeartPulse,\n                      resumo: \'Apresenta\303\247\303\243o em v\303\255deo (Loom) ou reservada, rubricas antecipadas, pausas e tempo estendido (+50%).\',\n                    },\n                    {\n                      id: \'sol-aprendizagem\',\n                      titulo: \'Transtorno espec\303\255fico de aprendizagem (dislexia, disgrafia, discalculia)\',\n                      sigla: \'Dislexia / Disgrafia\',\n                      icone: BookOpen,\n                      resumo: \'Fontes OpenDyslexic, linters visuais de erro e foco na l\303\263gica sem puni\303\247\303\243o sint\303\241tica.\',\n                    },\n                    {\n                      id: \'sol-def-intelectual\',\n                      titulo: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',\n                      sigla: \'Def. Intelectual\',\n                      icone: Users,\n                      resumo: \'Instru\303\247\303\265es fracionadas em 2-3 passos, media\303\247\303\243o assistida de monitor e avalia\303\247\303\243o concreta.\',\n                    },\n                    {\n                      id: \'sol-toc\',\n                      titulo: \'Transtorno obsessivo-compulsivo (TOC)\',\n                      sigla: \'TOC\',\n                      icone: CheckSquare,\n                      resumo: \'Crit\303\251rios expl\303\255citos de aceite (Definition of Done), pipelines CI/CD e limites saud\303\241veis de refatora\303\247\303\243o.\',\n                    },\n                    {\n                      id: \'sol-misto-ansioso-depressivo\',\n                      titulo: \'Transtorno misto ansioso e depressivo\',\n                      sigla: \'Misto Ansioso/Depressivo\',\n                      icone: Activity,\n                      resumo: \'Metas graduais de recomposi\303\247\303\243o de autoefic\303\241cia, entregas semanais fracionadas e apoio cont\303\255nuo.\',\n                    },\n                    {\n                      id: \'sol-depressao\',\n                      titulo: \'Transtornos depressivos\',\n                      sigla: \'Depress\303\243o\',\n                      icone: Moon,\n                      resumo: \'Regime de Atividades Acompanhadas (ODP-IFTO), acesso ass\303\255ncrono ao Moodle e duplas acolhedoras.\',\n                    },\n                    {\n                      id: \'sol-epilepsia\',\n                      titulo: \'Epilepsia e crises convulsivas\',\n                      sigla: \'Epilepsia\',\n                      icone: ShieldAlert,\n                      resumo: \'Monitores com taxa est\303\241vel (60Hz+), tema de IDE sem flashes, pausas a cada 45min e protocolo de seguran\303\247a.\',\n                    },\n                  ].map((item) => {\n                    const isSelected = solucaoId === item.id;\n                    const IconComponent = item.icone;\n                    return (\n                      <button\n                        key={item.id}\n                        type=\"button\"\n                        onClick={() => handleSelectPredefinedSolution(item.id)}\n                        className={`p-2.5 text-left text-xs rounded-xl border transition-all cursor-pointer relative ${\n                          isSelected\n                            ? \'bg-emerald-50 border-emerald-600 text-emerald-950 font-medium shadow-xs ring-1 ring-emerald-600\'\n                            : \'bg-white border-slate-200 text-slate-700 hover:border-slate-300 hover:bg-slate-50/50\'\n                        }`}\n                      >\n                        <div className=\"flex items-start justify-between gap-1.5 mb-1\">\n                          <div className=\"flex items-center gap-1.5 min-w-0\">\n                            <div className={`p-1 rounded-md shrink-0 ${isSelected ? \'bg-emerald-700 text-white\' : \'bg-slate-100 text-slate-600\'}`}>\n                              <IconComponent className=\"w-3.5 h-3.5\" />\n                            </div>\n                            <span className=\"font-bold text-slate-900 truncate text-[11px] leading-tight\">\n                              {item.titulo}\n                            </span>\n                          </div>\n                          {isSelected && (\n                            <Check className=\"w-3.5 h-3.5 text-emerald-700 shrink-0 mt-0.5\" />\n                          )}\n                        </div>\n                        <p className=\"text-[10px] text-slate-500 leading-snug line-clamp-2 pl-6\">\n                          {item.resumo}\n                        </p>\n                      </button>\n                    );\n                  })}\n                </div>\n\n                {/* Secondary toggle for Sensory/Physical conditions */}\n                <div className=\"pt-1 border-t border-slate-200\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setMostrarOutrasCondicoes(!mostrarOutrasCondicoes)}\n                    className=\"text-[11px] font-semibold text-emerald-800 hover:text-emerald-950 flex items-center gap-1 cursor-pointer\"\n                  >\n                    <span>{mostrarOutrasCondicoes ? \'\342\210\222 Ocultar\' : \'+ Exibir\'} Outras Condi\303\247\303\265es (Defici\303\252ncia Visual, Motora, Surdez, Sem Laudo)</span>\n                  </button>\n\n                  {mostrarOutrasCondicoes && (\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-2\">\n                      {bancoDeSolucoesPedagogicas\n                        .filter(\n                          (s) =>\n                            ![\n                              \'sol-tdah\',\n                              \'sol-tea\',\n                              \'sol-ansiedade\',\n                              \'sol-aprendizagem\',\n                              \'sol-def-intelectual\',\n                              \'sol-toc\',\n                              \'sol-misto-ansioso-depressivo\',\n                              \'sol-depressao\',\n                              \'sol-epilepsia\',\n                            ].includes(s.id)\n                        )\n                        .map((sol) => (\n                          <button\n                            key={sol.id}\n                            type=\"button\"\n                            onClick={() => handleSelectPredefinedSolution(sol.id)}\n                            className={`p-2 text-left text-xs rounded-lg border transition-all cursor-pointer ${\n                              solucaoId === sol.id\n                                ? \'bg-emerald-50 border-emerald-500 text-emerald-950 font-semibold shadow-xs\'\n                                : \'bg-white border-slate-200 text-slate-700 hover:border-slate-300\'\n                            }`}\n                          >\n                            <span className=\"font-bold text-slate-900 truncate block text-[11px]\">{sol.titulo}</span>\n                            <span className=\"text-[10px] text-slate-500 block truncate mt-0.5\">{sol.condicao}</span>\n                          </button>\n                        ))}\n                    </div>\n                  )}\n                </div>\n              </div>"
        replacement_content: "              {/* LISTAGEM DAS 9 NEURODIVERG\303\212NCIAS (M\303\232LTIPLA SELE\303\207\303\203O) */}\n              <div className=\"p-3.5 bg-slate-50 border border-slate-200 rounded-xl space-y-3\">\n                <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-2\">\n                  <div>\n                    <label className=\"text-xs font-bold text-slate-800 uppercase tracking-wider block\">\n                      Neurodiverg\303\252ncias no Contexto de TI & Laborat\303\263rio (M\303\272ltipla Sele\303\247\303\243o):\n                    </label>\n                    <span className=\"text-[11px] text-slate-600\">\n                      Voc\303\252 pode selecionar <strong>uma ou mais neurodiverg\303\252ncias</strong> (ex: TEA + TDAH). O PEI ser\303\241 adaptado para todas em conjunto:\n                    </span>\n                  </div>\n                  <span className=\"text-[10px] bg-emerald-700 text-white font-bold px-2.5 py-1 rounded-full font-mono self-start sm:self-auto shrink-0\">\n                    {selectedSolucoes.length} selecionada(s)\n                  </span>\n                </div>\n\n                {/* Quick Comorbidity Shortcuts */}\n                <div className=\"flex flex-wrap items-center gap-1.5 pt-0.5\">\n                  <span className=\"text-[10px] font-bold text-slate-500 uppercase mr-1\">\n                    Combina\303\247\303\265es Frequentes:\n                  </span>\n                  <button\n                    type=\"button\"\n                    onClick={() => syncSelectedConditions([\'sol-tea\', \'sol-tdah\'])}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\n                      selectedSolucoes.includes(\'sol-tea\') &&\n                      selectedSolucoes.includes(\'sol-tdah\') &&\n                      selectedSolucoes.length === 2\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\n                    }`}\n                  >\n                    + TEA + TDAH (Dupla Condi\303\247\303\243o)\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => syncSelectedConditions([\'sol-tdah\', \'sol-ansiedade\'])}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\n                      selectedSolucoes.includes(\'sol-tdah\') &&\n                      selectedSolucoes.includes(\'sol-ansiedade\') &&\n                      selectedSolucoes.length === 2\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\n                    }`}\n                  >\n                    + TDAH + Ansiedade\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => syncSelectedConditions([\'sol-tea\', \'sol-ansiedade\'])}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\n                      selectedSolucoes.includes(\'sol-tea\') &&\n                      selectedSolucoes.includes(\'sol-ansiedade\') &&\n                      selectedSolucoes.length === 2\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\n                    }`}\n                  >\n                    + TEA + Ansiedade\n                  </button>\n                  <button\n                    type=\"button\"\n                    onClick={() => syncSelectedConditions([\'sol-tdah\', \'sol-aprendizagem\'])}\n                    className={`px-2.5 py-1 rounded-lg text-[11px] font-semibold border transition-all cursor-pointer ${\n                      selectedSolucoes.includes(\'sol-tdah\') &&\n                      selectedSolucoes.includes(\'sol-aprendizagem\') &&\n                      selectedSolucoes.length === 2\n                        ? \'bg-emerald-800 text-white border-emerald-900 shadow-2xs\'\n                        : \'bg-white text-emerald-900 border-emerald-300 hover:bg-emerald-50\'\n                    }`}\n                  >\n                    + TDAH + Dislexia/Discalculia\n                  </button>\n                </div>\n\n                {/* Active Selection Pills */}\n                {selectedSolucoes.length > 0 && (\n                  <div className=\"p-2 bg-emerald-50/90 border border-emerald-200 rounded-lg flex flex-wrap items-center gap-1.5\">\n                    <span className=\"text-[10px] font-bold text-emerald-950 uppercase mr-1\">\n                      Ativas no PEI:\n                    </span>\n                    {selectedSolucoes.map((sid) => {\n                      const sObj = bancoDeSolucoesPedagogicas.find((item) => item.id === sid);\n                      if (!sObj) return null;\n                      return (\n                        <span\n                          key={sid}\n                          className=\"inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-700 text-white shadow-2xs\"\n                        >\n                          <span>{sObj.titulo}</span>\n                          {selectedSolucoes.length > 1 && (\n                            <button\n                              type=\"button\"\n                              onClick={(e) => {\n                                e.stopPropagation();\n                                handleTogglePredefinedSolution(sid);\n                              }}\n                              className=\"hover:text-emerald-200 ml-0.5 cursor-pointer\"\n                              title=\"Remover esta condi\303\247\303\243o\"\n                            >\n                              <X className=\"w-3 h-3\" />\n                            </button>\n                          )}\n                        </span>\n                      );\n                    })}\n                  </div>\n                )}\n\n                <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-2 max-h-60 overflow-y-auto pr-1\">\n                  {[\n                    {\n                      id: \'sol-tdah\',\n                      titulo: \'Transtorno do D\303\251ficit de Aten\303\247\303\243o com Hiperatividade (TDAH)\',\n                      sigla: \'TDAH\',\n                      icone: Brain,\n                      resumo: \'Micro-sprints \303\241geis (Jira/Kanban), Pomodoro, linters no VS Code e TDD em etapas.\',\n                    },\n                    {\n                      id: \'sol-tea\',\n                      titulo: \'Transtorno do Espectro Autista (TEA)\',\n                      sigla: \'TEA\',\n                      icone: Sparkles,\n                      resumo: \'Previsibilidade, roteiros de testes estruturados, abafador no LABIN e enunciados literais.\',\n                    },\n                    {\n                      id: \'sol-ansiedade\',\n                      titulo: \'Transtornos de ansiedade (generalizada, f\303\263bico-ansiosos, p\303\242nico, outros)\',\n                      sigla: \'Ansiedade\',\n                      icone: HeartPulse,\n                      resumo: \'Apresenta\303\247\303\243o em v\303\255deo (Loom) ou reservada, rubricas antecipadas, pausas e tempo estendido (+50%).\',\n                    },\n                    {\n                      id: \'sol-aprendizagem\',\n                      titulo: \'Transtorno espec\303\255fico de aprendizagem (dislexia, disgrafia, discalculia)\',\n                      sigla: \'Dislexia / Disgrafia\',\n                      icone: BookOpen,\n                      resumo: \'Fontes OpenDyslexic, linters visuais de erro e foco na l\303\263gica sem puni\303\247\303\243o sint\303\241tica.\',\n                    },\n                    {\n                      id: \'sol-def-intelectual\',\n                      titulo: \'Defici\303\252ncia intelectual / Transtorno do desenvolvimento intelectual\',\n                      sigla: \'Def. Intelectual\',\n                      icone: Users,\n                      resumo: \'Instru\303\247\303\265es fracionadas em 2-3 passos, media\303\247\303\243o assistida de monitor e avalia\303\247\303\243o concreta.\',\n                    },\n                    {\n                      id: \'sol-toc\',\n                      titulo: \'Transtorno obsessivo-compulsivo (TOC)\',\n                      sigla: \'TOC\',\n                      icone: CheckSquare,\n                      resumo: \'Crit\303\251rios expl\303\255citos de aceite (Definition of Done), pipelines CI/CD e limites saud\303\241veis de refatora\303\247\303\243o.\',\n                    },\n                    {\n                      id: \'sol-misto-ansioso-depressivo\',\n                      titulo: \'Transtorno misto ansioso e depressivo\',\n                      sigla: \'Misto Ansioso/Depressivo\',\n                      icone: Activity,\n                      resumo: \'Metas graduais de recomposi\303\247\303\243o de autoefic\303\241cia, entregas semanais fracionadas e apoio cont\303\255nuo.\',\n                    },\n                    {\n                      id: \'sol-depressao\',\n                      titulo: \'Transtornos depressivos\',\n                      sigla: \'Depress\303\243o\',\n                      icone: Moon,\n                      resumo: \'Regime de Atividades Acompanhadas (ODP-IFTO), acesso ass\303\255ncrono ao Moodle e duplas acolhedoras.\',\n                    },\n                    {\n                      id: \'sol-epilepsia\',\n                      titulo: \'Epilepsia e crises convulsivas\',\n                      sigla: \'Epilepsia\',\n                      icone: ShieldAlert,\n                      resumo: \'Monitores com taxa est\303\241vel (60Hz+), tema de IDE sem flashes, pausas a cada 45min e protocolo de seguran\303\247a.\',\n                    },\n                  ].map((item) => {\n                    const isSelected = selectedSolucoes.includes(item.id);\n                    const IconComponent = item.icone;\n                    return (\n                      <button\n                        key={item.id}\n                        type=\"button\"\n                        onClick={() => handleTogglePredefinedSolution(item.id)}\n                        className={`p-2.5 text-left text-xs rounded-xl border transition-all cursor-pointer relative ${\n                          isSelected\n                            ? \'bg-emerald-50 border-emerald-600 text-emerald-950 font-medium shadow-xs ring-1 ring-emerald-600\'\n                            : \'bg-white border-slate-200 text-slate-700 hover:border-slate-300 hover:bg-slate-50/50\'\n                        }`}\n                      >\n                        <div className=\"flex items-start justify-between gap-1.5 mb-1\">\n                          <div className=\"flex items-center gap-1.5 min-w-0\">\n                            <div className={`p-1 rounded-md shrink-0 ${isSelected ? \'bg-emerald-700 text-white\' : \'bg-slate-100 text-slate-600\'}`}>\n                              <IconComponent className=\"w-3.5 h-3.5\" />\n                            </div>\n                            <span className=\"font-bold text-slate-900 truncate text-[11px] leading-tight\">\n                              {item.titulo}\n                            </span>\n                          </div>\n                          <div\n                            className={`w-4 h-4 rounded flex items-center justify-center border shrink-0 mt-0.5 ${\n                              isSelected\n                                ? \'bg-emerald-700 border-emerald-700 text-white\'\n                                : \'border-slate-300 bg-white\'\n                            }`}\n                          >\n                            {isSelected && <Check className=\"w-3 h-3\" />}\n                          </div>\n                        </div>\n                        <p className=\"text-[10px] text-slate-500 leading-snug line-clamp-2 pl-6\">\n                          {item.resumo}\n                        </p>\n                      </button>\n                    );\n                  })}\n                </div>\n\n                {/* Secondary toggle for Sensory/Physical conditions */}\n                <div className=\"pt-1 border-t border-slate-200\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setMostrarOutrasCondicoes(!mostrarOutrasCondicoes)}\n                    className=\"text-[11px] font-semibold text-emerald-800 hover:text-emerald-950 flex items-center gap-1 cursor-pointer\"\n                  >\n                    <span>{mostrarOutrasCondicoes ? \'\342\210\222 Ocultar\' : \'+ Exibir\'} Outras Condi\303\247\303\265es (Defici\303\252ncia Visual, Motora, Surdez, Sem Laudo)</span>\n                  </button>\n\n                  {mostrarOutrasCondicoes && (\n                    <div className=\"grid grid-cols-1 sm:grid-cols-2 gap-1.5 mt-2\">\n                      {bancoDeSolucoesPedagogicas\n                        .filter(\n                          (s) =>\n                            ![\n                              \'sol-tdah\',\n                              \'sol-tea\',\n                              \'sol-ansiedade\',\n                              \'sol-aprendizagem\',\n                              \'sol-def-intelectual\',\n                              \'sol-toc\',\n                              \'sol-misto-ansioso-depressivo\',\n                              \'sol-depressao\',\n                              \'sol-epilepsia\',\n                            ].includes(s.id)\n                        )\n                        .map((sol) => {\n                          const isOtherSelected = selectedSolucoes.includes(sol.id);\n                          return (\n                            <button\n                              key={sol.id}\n                              type=\"button\"\n                              onClick={() => handleTogglePredefinedSolution(sol.id)}\n                              className={`p-2 text-left text-xs rounded-lg border transition-all cursor-pointer flex items-center justify-between gap-2 ${\n                                isOtherSelected\n                                  ? \'bg-emerald-50 border-emerald-500 text-emerald-950 font-semibold shadow-xs\'\n                                  : \'bg-white border-slate-200 text-slate-700 hover:border-slate-300\'\n                              }`}\n                            >\n                              <div className=\"min-w-0\">\n                                <span className=\"font-bold text-slate-900 truncate block text-[11px]\">{sol.titulo}</span>\n                                <span className=\"text-[10px] text-slate-500 block truncate mt-0.5\">{sol.condicao}</span>\n                              </div>\n                              <div\n                                className={`w-4 h-4 rounded flex items-center justify-center border shrink-0 ${\n                                  isOtherSelected\n                                    ? \'bg-emerald-700 border-emerald-700 text-white\'\n                                    : \'border-slate-300 bg-white\'\n                                }`}\n                              >\n                                {isOtherSelected && <Check className=\"w-3 h-3\" />}\n                              </div>\n                            </button>\n                          );\n                        })}\n                    </div>\n                  )}\n                </div>\n              </div>"
        start_line: 981
