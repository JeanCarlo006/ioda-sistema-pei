        use_fast_apply: true
        replacement_chunks {
          target_content: "// Gerador R\303\241pido de Novo PEI Completo para Aluno Cadastrado\nexport function gerarNovoPeiCompleto(dados: {\n  nome: string;\n  matricula: string;\n  idade: string;\n  curso: string;\n  disciplina: string;\n  modulo: string;\n  condicao: string;\n  docenteRegente: string;\n  docenteAee: string;\n  solucaoBaseId?: string;\n  statusDiagnostico?: \'confirmado\' | \'em_investigacao_hipotese\';\n  categoriaNeurodivergencia?: string;\n}): PEICompleto {\n  const solucao =\n    bancoDeSolucoesPedagogicas.find((s) => s.id === dados.solucaoBaseId) ||\n    bancoDeSolucoesPedagogicas[0];\n\n  const id = `PEI-${Date.now().toString().slice(-4)}`;\n\n  return {\n    id,\n    cabecalho: {\n      estudante: dados.nome,\n      codigo_matricula: dados.matricula || `TI-${Math.floor(1000 + Math.random() * 9000)}`,\n      idade: dados.idade || \'18 anos\',\n      curso: dados.curso || \'Curso T\303\251cnico em Inform\303\241tica / Bacharelado em TI\',\n      componente_curricular: dados.disciplina || \'Tecnologia da Informa\303\247\303\243o\',\n      modulo_periodo: dados.modulo || \'2\302\272 Semestre / 2026\',\n      data_elaboracao: new Date().toISOString().split(\'T\')[0],\n      docente_regente: dados.docenteRegente || \'Prof. Respons\303\241vel pela Disciplina\',\n      docente_aee: dados.docenteAee || \'Prof\302\252. Especialista do NAPNE\',\n      profissional_apoio: \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\n      coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n    },\n    historico_napne: {\n      status_diagnostico: dados.statusDiagnostico || \'confirmado\',\n      categoria_neurodivergencia:\n        dados.categoriaNeurodivergencia ||\n        (dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \'Hip\303\263tese Diagn\303\263stica / Em Investiga\303\247\303\243o pelo NAPNE\'\n          : \'Neurodiverg\303\252ncia / Condi\303\247\303\243o Acompanhada\'),\n      cid_ou_hipotese:\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \'Em investiga\303\247\303\243o pedag\303\263gica multiprofissional (Portaria MEC n\302\272 421/2026)\'\n          : \'Diagn\303\263stico confirmado em prontu\303\241rio NAPNE\',\n      breve_historico_clinico_familiar: `Estudante do ${dados.curso} no Campus Para\303\255so. Acompanhado pelo NAPNE com foco na garantia do direito \303\240 educa\303\247\303\243o inclusiva e acessibilidade curricular nos termos da Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.${\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \' Atendimento pedag\303\263gico iniciado com base nas barreiras escolares observadas, sem depend\303\252ncia de laudo pericial pr\303\251vio.\'\n          : \'\'\n      }`,\n      descricao_condicao_especifica: dados.condicao || solucao.descricaoProblema,\n      informacoes_dos_pais: \'Estudante e fam\303\255lia em alinhamento constante com o NAPNE Campus Para\303\255so e coordena\303\247\303\243o de curso.\',\n    },\n    estudo_de_caso: {\n      barreiras: [\n        {\n          id: \'B1\',\n          categoria: \'metodologica\',\n          descricao: `Metodologia de ensino em ${dados.disciplina} focada exclusivamente em formato \303\272nico sem op\303\247\303\265es acess\303\255veis.`,\n          impacto: \'Dificuldade de demonstra\303\247\303\243o plena da capacidade t\303\251cnica na aus\303\252ncia de recursos adaptados.\',\n          estrategia_enfrentamento: solucao.remediosSugeridos.acaoExpressao,\n        },\n        {\n          id: \'B2\',\n          categoria: \'tecnologica\',\n          descricao: \'Ambientes de desenvolvimento e computadores de laborat\303\263rio sem configura\303\247\303\243o pr\303\251via de acessibilidade.\',\n          impacto: \'Sobrecarga visual e muscular durante atividades pr\303\241ticas prolongadas.\',\n          estrategia_enfrentamento: `Instala\303\247\303\243o e configura\303\247\303\243o de: ${solucao.remediosSugeridos.recursosTA.join(\', \')}.`,\n        },\n        {\n          id: \'B3\',\n          categoria: \'atitudinal\',\n          descricao: \'Risco de expectativas rebaixadas ou desconhecimento das potencialidades t\303\251cnicas do aluno pela turma.\',\n          impacto: \'Isolamento em trabalhos pr\303\241ticos de equipe.\',\n          estrategia_enfrentamento: \'Planejamento docente com metodologias ativas e valoriza\303\247\303\243o das contribui\303\247\303\265es do estudante.\',\n        },\n      ],\n      potencialidades: [\n        {\n          id: \'P1\',\n          area: \'Capacidade Anal\303\255tica & Computacional\',\n          descricao: \'Motiva\303\247\303\243o para resolu\303\247\303\243o de problemas e aprendizado pr\303\241tico de ferramentas de TI.\',\n          apoio_demandado: \'Orienta\303\247\303\243o personalizada em projetos de desenvolvimento.\',\n        },\n        {\n          id: \'P2\',\n          area: \'Trabalho Colaborativo\',\n          descricao: \'Excelente coopera\303\247\303\243o em duplas estruturadas com objetivos transparentes.\',\n          apoio_demandado: \'Incentivo cont\303\255nuo ao trabalho compartilhado.\',\n        },\n      ],\n      recursos_ta: solucao.remediosSugeridos.recursosTA,\n      sintese_observacao: {\n        interacao_professores: \'Receptivo e proativo nas orienta\303\247\303\265es pedag\303\263gicas.\',\n        interacao_colegas: \'Excelente entrosamento em equipes de desenvolvimento.\',\n        tarefas_coletivas: \'Participa com responsabilidade nas etapas atribu\303\255das.\',\n        interesses_centrais: dados.disciplina,\n        habilidades_tecnicas: \'Pensamento computacional e capacidade l\303\263gica.\',\n        autonomia_rotina: \'Aut\303\264nomo com suporte dos recursos de acessibilidade recomendados.\',\n      },\n    },\n    planejamento_pei: {\n      conteudo_ementa_oficial: `Ementa Oficial do Componente Curricular: ${dados.disciplina}. Abordagem dos conceitos fundamentais te\303\263ricos e pr\303\241ticos de desenvolvimento e aplica\303\247\303\243o.`,\n      competencias_habilidades_ementa: `Desenvolver compet\303\252ncias t\303\251cnicas, operacionais e de racioc\303\255nio l\303\263gico em ${dados.disciplina}, aplicando boas pr\303\241ticas da profiss\303\243o.`,\n      adaptacao_flexibilizacao_curricular:\n        \'Curr\303\255culo mantido na \303\255ntegra sem rebaixamento conceitual. Acessibilidade promovida nas formas de representa\303\247\303\243o dos conte\303\272dos e nos canais de express\303\243o t\303\251cnica.\',\n      objetivos_e_metas: [\n        {\n          id_meta: \'M1\',\n          descricao_meta: `Compreender e aplicar os fundamentos centrais de ${dados.disciplina} atrav\303\251s de atividades estruturadas com DUA 3.0.`,\n          prazo: \'Mensal (4 semanas)\',\n          indicador_sucesso: \'Execu\303\247\303\243o aut\303\264noma de projeto pr\303\241tico documentado e com funcionamento validado.\',\n          progresso_percentual: 60,\n          status: \'em_andamento\',\n        },\n        {\n          id_meta: \'M2\',\n          descricao_meta: \'Desenvolver projeto integrador em equipe utilizando boas pr\303\241ticas e recursos de acessibilidade configurados.\',\n          prazo: \'Bimestral (8 semanas)\',\n          indicador_sucesso: \'Apresenta\303\247\303\243o t\303\251cnica com valida\303\247\303\243o entre pares e feedback formativo do docente.\',\n          progresso_percentual: 30,\n          status: \'em_andamento\',\n        },\n      ],\n      flexibilizacao_metodologica_dua: {\n        engajamento: [\n          solucao.remediosSugeridos.engajamento,\n          \'Acompanhamento cont\303\255nuo dos marcos parciais do projeto.\',\n          \'Reconhecimento das habilidades do estudante perante a turma.\',\n        ],\n        representacao: [\n          solucao.remediosSugeridos.representacao,\n          \'Disponibiliza\303\247\303\243o antecipada de guias e roteiros de laborat\303\263rio.\',\n          \'Suporte multissensorial com materiais textuais, diagramas e tutoriais.\',\n        ],\n        acao_e_expressao: [\n          solucao.remediosSugeridos.acaoExpressao,\n          \'Tempo ampliado (+50%) em atividades avaliativas de laborat\303\263rio.\',\n          \'M\303\272ltiplas formas de demonstra\303\247\303\243o t\303\251cnica (c\303\263digo, documenta\303\247\303\243o, defesa oral).\',\n        ],\n      },\n      gestao_sala_de_aula: {\n        organizacao_espacial: \'Bancada de laborat\303\263rio acess\303\255vel com layout ergon\303\264mico e espa\303\247o para circula\303\247\303\243o.\',\n        rotina_e_pausas: \'Pausas programadas a cada 45-60 minutos para preven\303\247\303\243o de fadiga f\303\255sica e sensorial.\',\n        agrupamentos_e_tutoria: \'Trabalho em duplas colaborativas com pap\303\251is t\303\251cnicos definidos.\',\n        suporte_docente_semanal: \'Sess\303\243o semanal de alinhamento pedag\303\263gico entre docente t\303\251cnico e NAPNE.\',\n      },\n      estrategias_avaliacao: {\n        formato_acessivel: solucao.remediosSugeridos.avaliacaoAcessivel,\n        criterio_de_sucesso: \'Compreens\303\243o t\303\251cnica, corretude l\303\263gica e aplica\303\247\303\243o pr\303\241tica dos conceitos da ementa.\',\n        grau_mediacao: \'pouca_mediacao\',\n        tempo_e_espaco: \'Tempo estendido (+50%) em ambiente de laborat\303\263rio com recursos de TA dispon\303\255veis.\',\n        recursos_utilizados: solucao.remediosSugeridos.recursosTA,\n      },\n      observacoes_docente: `O PEI foi estruturado de forma personalizada para ${dados.nome}, integrando as acomoda\303\247\303\265es recomendadas para sua condi\303\247\303\243o com foco no desenvolvimento de autonomia e excel\303\252ncia t\303\251cnica.`,"
          replacement_content: "// Gerador R\303\241pido de Novo PEI Completo para Aluno Cadastrado (Suporta m\303\272ltiplas neurodiverg\303\252ncias combinadas)\nexport function gerarNovoPeiCompleto(dados: {\n  nome: string;\n  matricula: string;\n  idade: string;\n  curso: string;\n  disciplina: string;\n  modulo: string;\n  condicao: string;\n  docenteRegente: string;\n  docenteAee: string;\n  solucaoBaseId?: string;\n  solucaoBaseIds?: string[];\n  statusDiagnostico?: \'confirmado\' | \'em_investigacao_hipotese\';\n  categoriaNeurodivergencia?: string;\n}): PEICompleto {\n  const idsList =\n    dados.solucaoBaseIds && dados.solucaoBaseIds.length > 0\n      ? dados.solucaoBaseIds\n      : dados.solucaoBaseId\n      ? [dados.solucaoBaseId]\n      : [\'sol-tdah\'];\n\n  const solucoesSelecionadas = idsList\n    .map((sid) => bancoDeSolucoesPedagogicas.find((s) => s.id === sid))\n    .filter(Boolean) as SolucaoCondicao[];\n\n  const solucaoPrimaria = solucoesSelecionadas[0] || bancoDeSolucoesPedagogicas[0];\n\n  const recursosTaCombinados = Array.from(\n    new Set(solucoesSelecionadas.flatMap((s) => s.remediosSugeridos.recursosTA))\n  );\n\n  const engajamentoCombinado = Array.from(\n    new Set([\n      ...solucoesSelecionadas.map((s) => `[${s.titulo}]: ${s.remediosSugeridos.engajamento}`),\n      \'Acompanhamento cont\303\255nuo dos marcos parciais do projeto.\',\n      \'Reconhecimento das habilidades do estudante perante a turma.\',\n    ])\n  );\n\n  const representacaoCombinada = Array.from(\n    new Set([\n      ...solucoesSelecionadas.map((s) => `[${s.titulo}]: ${s.remediosSugeridos.representacao}`),\n      \'Disponibiliza\303\247\303\243o antecipada de guias e roteiros de laborat\303\263rio.\',\n      \'Suporte multissensorial com materiais textuais, diagramas e tutoriais.\',\n    ])\n  );\n\n  const acaoExpressaoCombinada = Array.from(\n    new Set([\n      ...solucoesSelecionadas.map((s) => `[${s.titulo}]: ${s.remediosSugeridos.acaoExpressao}`),\n      \'Tempo ampliado (+50%) em atividades avaliativas de laborat\303\263rio.\',\n      \'M\303\272ltiplas formas de demonstra\303\247\303\243o t\303\251cnica (c\303\263digo, documenta\303\247\303\243o, defesa oral).\',\n    ])\n  );\n\n  const avaliacaoCombinada = solucoesSelecionadas\n    .map((s) => s.remediosSugeridos.avaliacaoAcessivel)\n    .join(\' \');\n\n  const id = `PEI-${Date.now().toString().slice(-4)}`;\n\n  return {\n    id,\n    cabecalho: {\n      estudante: dados.nome,\n      codigo_matricula: dados.matricula || `TI-${Math.floor(1000 + Math.random() * 9000)}`,\n      idade: dados.idade || \'18 anos\',\n      curso: dados.curso || \'Curso T\303\251cnico em Inform\303\241tica / Bacharelado em TI\',\n      componente_curricular: dados.disciplina || \'Tecnologia da Informa\303\247\303\243o\',\n      modulo_periodo: dados.modulo || \'2\302\272 Semestre / 2026\',\n      data_elaboracao: new Date().toISOString().split(\'T\')[0],\n      docente_regente: dados.docenteRegente || \'Prof. Respons\303\241vel pela Disciplina\',\n      docente_aee: dados.docenteAee || \'Prof\302\252. Especialista do NAPNE\',\n      profissional_apoio: \'Monitor de Tecnologia Assistiva / Apoio Escolar\',\n      coordenacao_napne: \'Coordena\303\247\303\243o NAPNE \302\267 Campus Para\303\255so\',\n    },\n    historico_napne: {\n      status_diagnostico: dados.statusDiagnostico || \'confirmado\',\n      categoria_neurodivergencia:\n        dados.categoriaNeurodivergencia ||\n        solucoesSelecionadas.map((s) => s.titulo).join(\' + \') ||\n        (dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \'Hip\303\263tese Diagn\303\263stica / Em Investiga\303\247\303\243o pelo NAPNE\'\n          : \'Neurodiverg\303\252ncia / Condi\303\247\303\243o Acompanhada\'),\n      cid_ou_hipotese:\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \'Em investiga\303\247\303\243o pedag\303\263gica multiprofissional (Portaria MEC n\302\272 421/2026)\'\n          : \'Diagn\303\263stico confirmado em prontu\303\241rio NAPNE\',\n      breve_historico_clinico_familiar: `Estudante do ${dados.curso} no Campus Para\303\255so. Acompanhado pelo NAPNE com foco na garantia do direito \303\240 educa\303\247\303\243o inclusiva e acessibilidade curricular nos termos da Portaria MEC n\302\272 421/2026 e Decreto n\302\272 12.686/2025.${\n        dados.statusDiagnostico === \'em_investigacao_hipotese\'\n          ? \' Atendimento pedag\303\263gico iniciado com base nas barreiras escolares observadas, sem depend\303\252ncia de laudo pericial pr\303\251vio.\'\n          : \'\'\n      }`,\n      descricao_condicao_especifica: dados.condicao || solucaoPrimaria.descricaoProblema,\n      informacoes_dos_pais: \'Estudante e fam\303\255lia em alinhamento constante com o NAPNE Campus Para\303\255so e coordena\303\247\303\243o de curso.\',\n    },\n    estudo_de_caso: {\n      barreiras: [\n        {\n          id: \'B1\',\n          categoria: \'metodologica\',\n          descricao: `Metodologia de ensino em ${dados.disciplina} focada exclusivamente em formato \303\272nico sem op\303\247\303\265es acess\303\255veis para ${solucoesSelecionadas.map((s) => s.titulo).join(\' + \')}.`,\n          impacto: \'Dificuldade de demonstra\303\247\303\243o plena da capacidade t\303\251cnica na aus\303\252ncia de recursos adaptados.\',\n          estrategia_enfrentamento: solucoesSelecionadas.map((s) => s.remediosSugeridos.acaoExpressao).join(\' \'),\n        },\n        {\n          id: \'B2\',\n          categoria: \'tecnologica\',\n          descricao: \'Ambientes de desenvolvimento e computadores de laborat\303\263rio sem configura\303\247\303\243o pr\303\251via de acessibilidade.\',\n          impacto: \'Sobrecarga visual, sensorial ou executiva durante atividades pr\303\241ticas prolongadas.\',\n          estrategia_enfrentamento: `Instala\303\247\303\243o e configura\303\247\303\243o de: ${recursosTaCombinados.join(\', \')}.`,\n        },\n        {\n          id: \'B3\',\n          categoria: \'atitudinal\',\n          descricao: \'Risco de expectativas rebaixadas ou desconhecimento das potencialidades t\303\251cnicas do aluno pela turma.\',\n          impacto: \'Isolamento em trabalhos pr\303\241ticos de equipe.\',\n          estrategia_enfrentamento: \'Planejamento docente com metodologias ativas e valoriza\303\247\303\243o das contribui\303\247\303\265es do estudante.\',\n        },\n      ],\n      potencialidades: [\n        {\n          id: \'P1\',\n          area: \'Capacidade Anal\303\255tica & Computacional\',\n          descricao: \'Motiva\303\247\303\243o para resolu\303\247\303\243o de problemas e aprendizado pr\303\241tico de ferramentas de TI.\',\n          apoio_demandado: \'Orienta\303\247\303\243o personalizada em projetos de desenvolvimento.\',\n        },\n        {\n          id: \'P2\',\n          area: \'Trabalho Colaborativo\',\n          descricao: \'Excelente coopera\303\247\303\243o em duplas estruturadas com objetivos transparentes.\',\n          apoio_demandado: \'Incentivo cont\303\255nuo ao trabalho compartilhado.\',\n        },\n      ],\n      recursos_ta: recursosTaCombinados,\n      sintese_observacao: {\n        interacao_professores: \'Receptivo e proativo nas orienta\303\247\303\265es pedag\303\263gicas.\',\n        interacao_colegas: \'Excelente entrosamento em equipes de desenvolvimento.\',\n        tarefas_coletivas: \'Participa com responsabilidade nas etapas atribu\303\255das.\',\n        interesses_centrais: dados.disciplina,\n        habilidades_tecnicas: \'Pensamento computacional e capacidade l\303\263gica.\',\n        autonomia_rotina: \'Aut\303\264nomo com suporte dos recursos de acessibilidade recomendados.\',\n      },\n    },\n    planejamento_pei: {\n      conteudo_ementa_oficial: `Ementa Oficial do Componente Curricular: ${dados.disciplina}. Abordagem dos conceitos fundamentais te\303\263ricos e pr\303\241ticos de desenvolvimento e aplica\303\247\303\243o.`,\n      competencias_habilidades_ementa: `Desenvolver compet\303\252ncias t\303\251cnicas, operacionais e de racioc\303\255nio l\303\263gico em ${dados.disciplina}, aplicando boas pr\303\241ticas da profiss\303\243o.`,\n      adaptacao_flexibilizacao_curricular:\n        \'Curr\303\255culo mantido na \303\255ntegra sem rebaixamento conceitual. Acessibilidade promovida nas formas de representa\303\247\303\243o dos conte\303\272dos e nos canais de express\303\243o t\303\251cnica.\',\n      objetivos_e_metas: [\n        {\n          id_meta: \'M1\',\n          descricao_meta: `Compreender e aplicar os fundamentos centrais de ${dados.disciplina} atrav\303\251s de atividades estruturadas com DUA 3.0.`,\n          prazo: \'Mensal (4 semanas)\',\n          indicador_sucesso: \'Execu\303\247\303\243o aut\303\264noma de projeto pr\303\241tico documentado e com funcionamento validado.\',\n          progresso_percentual: 60,\n          status: \'em_andamento\',\n        },\n        {\n          id_meta: \'M2\',\n          descricao_meta: `Integrar os apoios de Tecnologia Assistiva e flexibiliza\303\247\303\265es de laborat\303\263rio para atender simultaneamente a: ${solucoesSelecionadas.map((s) => s.titulo).join(\' + \')}.`,\n          prazo: \'Bimestral (8 semanas)\',\n          indicador_sucesso: \'Apresenta\303\247\303\243o t\303\251cnica com valida\303\247\303\243o entre pares e feedback formativo do docente.\',\n          progresso_percentual: 35,\n          status: \'em_andamento\',\n        },\n      ],\n      flexibilizacao_metodologica_dua: {\n        engajamento: engajamentoCombinado,\n        representacao: representacaoCombinada,\n        acao_e_expressao: acaoExpressaoCombinada,\n      },\n      gestao_sala_de_aula: {\n        organizacao_espacial: \'Bancada de laborat\303\263rio acess\303\255vel com layout ergon\303\264mico e espa\303\247o para circula\303\247\303\243o.\',\n        rotina_e_pausas: \'Pausas programadas a cada 45-60 minutos para preven\303\247\303\243o de fadiga f\303\255sica e sensorial.\',\n        agrupamentos_e_tutoria: \'Trabalho em duplas colaborativas com pap\303\251is t\303\251cnicos definidos.\',\n        suporte_docente_semanal: \'Sess\303\243o semanal de alinhamento pedag\303\263gico entre docente t\303\251cnico e NAPNE.\',\n      },\n      estrategias_avaliacao: {\n        formato_acessivel: avaliacaoCombinada,\n        criterio_de_sucesso: \'Compreens\303\243o t\303\251cnica, corretude l\303\263gica e aplica\303\247\303\243o pr\303\241tica dos conceitos da ementa.\',\n        grau_mediacao: \'pouca_mediacao\',\n        tempo_e_espaco: \'Tempo estendido (+50%) em ambiente de laborat\303\263rio com recursos de TA dispon\303\255veis.\',\n        recursos_utilizados: recursosTaCombinados,\n      },\n      observacoes_docente: `O PEI foi estruturado de forma personalizada para ${dados.nome}, integrando as acomoda\303\247\303\265es recomendadas para ${solucoesSelecionadas.map((s) => s.titulo).join(\' + \')} com foco no desenvolvimento de autonomia e excel\303\252ncia t\303\251cnica.`,"
          start_line: 1252
          end_line: 1408
        }
      }
    }
