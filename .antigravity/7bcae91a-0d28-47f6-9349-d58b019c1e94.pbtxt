    content: "  const [stepMessage, setStepMessage] = useState(\'\');\n\n  if (!isOpen) return null;\n\n  // Handle Profile Switcher\n  const handleSelectProfile = (perfil: \'medio_tecnico\' | \'superior_ti\') => {\n    setPerfilModalidade(perfil);\n    setBenchmarkFeedback(null);\n\n    if (perfil === \'superior_ti\') {\n      setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\');\n      setModulo(\'4\302\272 Semestre / Noturno\');\n      setDisciplina(\'Banco de Dados Relacional e SQL\');\n      setIdade(\'21 anos\');\n      setSolucaoId(\'sol-baixa-visao-sql\');\n      setCondicao(\'Acomoda\303\247\303\265es para laborat\303\263rio de inform\303\241tica e modelagem conceitual.\');\n      setAssistiveTech(\'Recursos de acessibilidade digital e tempo estendido (+50%).\');\n      setPotentialidades(\'Racioc\303\255nio dedutivo, capacidade de abstra\303\247\303\243o e pensamento computacional.\');\n    } else {\n      setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n      setModulo(\'2\302\272 Ano / Diurno\');\n      setDisciplina(\'Programa\303\247\303\243o Web e Algoritmos\');\n      setIdade(\'17 anos\');\n      setSolucaoId(\'sol-motor-programacao\');\n      setCondicao(\'Acomoda\303\247\303\265es ergon\303\264micas e metodol\303\263gicas no laborat\303\263rio de programa\303\247\303\243o.\');\n      setAssistiveTech(\'Perfil de acessibilidade na IDE, atalhos de teclado e tempo ampliado (+50%).\');\n      setPotentialidades(\'Racioc\303\255nio l\303\263gico, interesse em desenvolvimento e coopera\303\247\303\243o t\303\251cnica.\');\n    }\n  };\n\n  const handleSelectPredefinedSolution = (id: string) => {\n    setSolucaoId(id);\n    const sol = bancoDeSolucoesPedagogicas.find((s) => s.id === id);\n    if (sol) {\n      setCondicao(`${sol.condicao}: ${sol.descricaoProblema}`);\n      setAssistiveTech(sol.remediosSugeridos.recursosTA.join(\', \'));\n      setPotentialidades(\n        \'Racioc\303\255nio l\303\263gico, boa capacidade de abstra\303\247\303\243o e dedica\303\247\303\243o ao aprendizado pr\303\241tico de computa\303\247\303\243o.\'\n      );\n\n      if (id === \'sol-hipotese-sem-laudo\') {\n        setStatusDiagnostico(\'em_investigacao_hipotese\');\n      } else {\n        setStatusDiagnostico(\'confirmado\');\n      }\n\n      if (sol.nivelSugerido === \'Superior TI\') {\n        setPerfilModalidade(\'superior_ti\');\n        setCurso(\'Bacharelado em Sistemas de Informa\303\247\303\243o (TI)\');\n        setModulo(\'4\302\272 Semestre / Noturno\');\n      } else if (sol.nivelSugerido === \'M\303\251dio T\303\251cnico\') {\n        setPerfilModalidade(\'medio_tecnico\');\n        setCurso(\'Curso T\303\251cnico Integrado ao Ensino M\303\251dio em Inform\303\241tica\');\n        setModulo(\'2\302\272 Ano / Diurno\');\n      }\n    }\n  };\n\n  // Step 2 validation check\n  const isStep2Valid = nome.trim().length > 0 && disciplina.trim().length > 0;\n\n  // Final submit to generate with Ioda AI\n  const handleFinalSubmit = async () => {\n    if (!nome.trim() || !disciplina.trim()) {\n      setCurrentStep(2);\n      return;\n    }\n\n    setIsGenerating(true);\n    const modalidadeDesc = perfilModalidade === \'superior_ti\' ? \'Superior em TI\' : \'M\303\251dio T\303\251cnico em TI\';\n    setStepMessage(`1/3: Ioda AI consultando refer\303\252ncias do perfil [${modalidadeDesc}] e normas do NAPNE...`);"
    num_lines: 1068
    num_bytes: 56228
    line_range_bytes: 2987
  }
}
