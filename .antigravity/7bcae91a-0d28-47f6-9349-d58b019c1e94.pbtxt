            }
            lines {
              text: "        descricao: \'Ensino da multiplica\303\247\303\243o e divis\303\243o ministrado prioritariamente de forma expositiva e abstrata no quadro.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
