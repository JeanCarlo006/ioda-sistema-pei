              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      engajamento:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Acolhimento pedag\303\263gico seguro com escuta pelo professor e pelo NAPNE; pactua\303\247\303\243o de metas de pequeno porte para recomposi\303\247\303\243o gradual da autoefic\303\241cia acad\303\252mica; flexibilidade em situa\303\247\303\265es de crise.\',"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "      representacao:"
              type: UNIFIED_DIFF_LINE_TYPE_INSERT
            }
            lines {
              text: "        \'Materiais did\303\241ticos sintetizados e organizados no AVA Moodle; roteiros objetivos que evitam a sensa\303\247\303\243o de sobrecarga cognitiva ou volume inating\303\255vel de tarefas.\',"
