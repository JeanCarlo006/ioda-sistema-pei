    content: "export const todosOsCasos: PEICompleto[] = [\n  casoLucasTecnico,\n  casoBeatrizSuperior,\n  casoMatheusRedes,\n];\n\n// BANCO DE SOLU\303\207\303\225ES PEDAG\303\223GICAS PARA CONDI\303\207\303\225ES ESPEC\303\215FICAS EM TI / COMPUTA\303\207\303\203O\nexport const bancoDeSolucoesPedagogicas: SolucaoCondicao[] = [\n  {\n    id: \'sol-motor-programacao\',\n    titulo: \'Dificuldade Motora / Digita\303\247\303\243o Manual em C\303\263digo e Algoritmos\',\n    condicao: \'Paralisia Cerebral, Espasticidade, Tetraparesia, LER/DORT ou Tremores\',\n    nivelSugerido: \'Ambos\',\n    descricaoProblema:\n      \'A lentid\303\243o ou dor na digita\303\247\303\243o em teclado convencional prejudica a realiza\303\247\303\243o de avalia\303\247\303\265es cronometradas em laborat\303\263rio e gera fadiga muscular intensa.\',\n    remediosSugeridos: {\n      engajamento:\n        \'Ado\303\247\303\243o da metodologia de Pair Programming (programa\303\247\303\243o em pares) com divis\303\243o de pap\303\251is: o aluno atua como copiloto e arquiteto da l\303\263gica.\',\n      representacao:\n        \'Roteiros de laborat\303\263rio diagramados com diagramas de fluxo de dados (Mermaid/UML) e snippets de c\303\263digo comentados dispon\303\255veis antecipadamente.\',\n      acaoExpressao:"
    num_lines: 890
    num_bytes: 55255
